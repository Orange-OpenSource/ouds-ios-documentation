{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"WhiteLabelTheme"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The White Label theme is based on the Wireframe theme which is dedicated to mockups and prototypes."},{"type":"text","text":" "},{"type":"text","text":"However is is possible to override the semantic tokens of colors, change the tuning and choose the font family to apply."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To get it:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    @Environment(\\.theme) var theme"]},{"anchor":"Integration","level":2,"type":"heading","text":"Integration"},{"inlineContent":[{"text":"To use this theme, inject it to your view using ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" and get it through environment variable."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    @main","    struct YourApp: App {","        var body: some Scene {","            WindowGroup {","                OUDSThemeableView(theme: WhiteLabelTheme()) {","                    \/\/ Your root view","                }","            }","        }","    }"]},{"anchor":"Theme-tuning","level":1,"type":"heading","text":"Theme tuning"},{"inlineContent":[{"type":"text","text":"By default the theme uses "},{"type":"codeVoice","code":"Tuning.Wireframe"},{"type":"text","text":", but it can be changed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To apply the tuning:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Define your theme tuning, here everything rounded","    let tuning = Tuning(hasRoundedButtons: true,","                        hasRoundedTextInputs: true,","                        hasRoundedAlertMessages: true,","                        hasRoundedProgressIndicators: true,","                        hasRoundedListItems: true)","","    \/\/ Apply it to your theme","    let theme = WhiteLabelTheme(tuning: tuning)"]},{"inlineContent":[{"type":"text","text":"Note the "},{"type":"codeVoice","code":"Tuning"},{"type":"text","text":" only defines flags the components will read. But in the end the rounded corners are defined in tokens."},{"text":" ","type":"text"},{"text":"Thus even if the rounded corners are enabled in ","type":"text"},{"type":"codeVoice","code":"Tuning"},{"text":", it the same radius values are used in the components for both rounded and not rounded","type":"text"},{"text":" ","type":"text"},{"text":"cases the component may not change.","type":"text"}],"type":"paragraph"},{"anchor":"Tokens-versions","level":2,"type":"heading","text":"Tokens versions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the tokens version from "},{"type":"codeVoice","code":"WireframeTheme"},{"text":".","type":"text"}]},{"name":"Since","type":"aside","content":[{"inlineContent":[{"text":"3.1.0","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/oudsthemeswhitelabel\/whitelabeltheme"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme\/init(colors:colorsCharts:colorsDecorative:name:fontFamily:tuning:)"],"generated":true}],"sections":[],"kind":"symbol","relationshipsSections":[{"identifie