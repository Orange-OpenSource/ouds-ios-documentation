c://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorMultipleSemanticTokens":{"kind":"symbol","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"colors","type":"text"}]},{"type":"text","text":" but using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorMultipleSemanticTokens","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"title":"ColorMultipleSemanticTokens","url":"\/documentation\/oudstokenssemantic\/colormultiplesemantictokens"},"doc://OUDSThemesWireframe/documentation/OUDSThemesWireframe/WireframeThemeColorSemanticTokensProvider":{"kind":"symbol","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"text":"color semantic tokens","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users."}],"navigatorTitle":[{"kind":"identifier","text":"WireframeThemeColorSemanticTokensProvider"}],"type":"topic","identifier":"doc:\/\/OUDSThemesWireframe\/documentation\/OUDSThemesWireframe\/WireframeThemeColorSemanticTokensProvider","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"