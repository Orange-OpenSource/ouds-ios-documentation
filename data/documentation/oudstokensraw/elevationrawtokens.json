ext":"SwiftUI"}],"type":"emphasis"},{"type":"text","text":" types which are not compatible with "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" and are heavier than primitive types."},{"type":"text","text":" "},{"type":"text","text":"In addition, if new styles are defined in design team side (such as kind of composite styles) and need to be processed differently"},{"type":"text","text":" "},{"type":"text","text":"(because not available with "},{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"emphasis"},{"type":"text","text":" because are composed of several styles),"},{"type":"text","text":" "},{"type":"text","text":"such  "},{"code":"String","type":"codeVoice"},{"type":"text","text":" values could be processed later without any API breaks."},{"type":"text","text":" "},{"type":"text","text":"Keeps grammar clean and clear with design system grammar."}],"navigatorTitle":[{"text":"BorderStyleRawToken","kind":"identifier"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/BorderRadiusRawToken":{"type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/BorderRadiusRawToken","kind":"symbol","title":"BorderRadiusRawToken","url":"\/documentation\/oudstokensraw\/borderradiusrawtoken","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BorderRadiusRawToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Type alias precising "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" value are used (because of multiplier factors) for a "},{"inlineContent":[{"type":"text","text":"border radius raw token"}],"type":"strong"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"navigatorTitle":[{"text":"BorderRadiusRawToken","kind":"identifier"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/EffectRawTokens":{"role":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/EffectRawTokens","title":"EffectRawTokens","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EffectRawTokens"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Defined as the group of all "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"strong"},{"type":"text","text":" related to "},{"inlineContent":[{"type":"text","text":"effects"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/EffectRawTokens"},{"type":"text","text":" are tokens to use to define "},{"inlineContent":[{"type":"text","text":"effects"}],"type":"emphasis"},{"type":"text","text":" for some components like navigation bars."}],"url":"\/documentation\/oudstokensraw\/effectrawtokens","navigatorTitle":[{"kind":"identifier","text":"EffectRawTokens"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/y400":{"type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens\/y400","kind":"symbol","title":"y400","url":"\/documentation\/oudstokensraw\/elevationrawtokens\/y400","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"y400"},{"text":": ","kind":"text"},{"text":"ElevationRawToken","kind":"typeIdentifier","preciseIdentifier":"s:13OUDSTokensRaw09ElevationB5Tokena"}],"abstract":[{"type":"text","text":"Has for value 8"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens":{"type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","kind":"symbol","title":"ElevationRawTokens","url":"\/documentation\/oudstokensraw\/elevationrawtokens","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawTokens","kind":"identifier"}],"abstract":[{"type":"text",