ed through "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" with extensions and protocols within modules."}],"navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/BorderWidthRawToken":{"type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/BorderWidthRawToken","kind":"symbol","title":"BorderWidthRawToken","url":"\/documentation\/oudstokensraw\/borderwidthrawtoken","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BorderWidthRawToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Type alias precising "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" value are used (because of multiplier factors) for a "},{"inlineContent":[{"type":"text","text":"border width raw token"}],"type":"strong"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"navigatorTitle":[{"text":"BorderWidthRawToken","kind":"identifier"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/y0":{"type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens\/y0","kind":"symbol","title":"y0","url":"\/documentation\/oudstokensraw\/elevationrawtokens\/y0","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"y0","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationRawToken","preciseIdentifier":"s:13OUDSTokensRaw09ElevationB5Tokena","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Has for value 0"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/blur300":{"role":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens\/blur300","title":"blur300","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","t