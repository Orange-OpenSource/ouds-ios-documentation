text","text":"."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","type":"reference","isActive":true},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"blur"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X offset"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Y offset"}]},{"type":"text","text":", all of them being "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken","isActive":true,"type":"reference"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","type":"reference","isActive":true},{"type":"text","text":" i.e. "},{"inlineContent":[{"type":"text","text":"composite tokens"}],"type":"emphasis"},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw":{"images":[{"type":"icon","identifier":"ic_design_token_figma_raw.png"}],"kind":"symbol","navigatorTitle":[{"kind":"text","text":"Tokens with raw values"}],"url":"\/documentation\/oudstokensraw","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw","type":"topic","abstract":[{"inlineContent":[{"type":"text","text":"Raw tokens"}],"type":"emphasis"},{"type":"text","text":" are smallest "},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"type":"text","text":" possible. They are associated to raw values and will be finaly the values assigned to the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" properties."}],"title":"Tokens with raw values","role":"collection"},"ic_design_token_figma_raw.png":{"type":"image","identifier":"ic_design_token_figma_raw.png","alt":null,"variants":[{"url":"\/images\/OUDSTokensRaw\/ic_design_token_figma_raw.png","traits":["1x","light"]}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationCompositeRawToken":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X and Y offsets"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"title":"ElevationCompositeRawToken","role":"symbol","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","type":"topic","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"}}}