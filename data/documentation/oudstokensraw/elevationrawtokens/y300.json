]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/y300":{"url":"\/documentation\/oudstokensraw\/elevationrawtokens\/y300","type":"topic","abstract":[{"type":"text","text":"Has for value 4"}],"title":"y300","kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens\/y300","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"y300","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationRawToken","kind":"typeIdentifier","preciseIdentifier":"s:13OUDSTokensRaw09ElevationB5Tokena"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens":{"url":"\/documentation\/oudstokensraw\/elevationrawtokens","type":"topic","abstract":[{"type":"text","text":"Defined as the group of all "},{"type":"strong","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":" related to "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens"},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"text":"blur","type":"text"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"text":"X offset","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"Y offset","type":"text"}]},{"type":"text","text":", all of them being "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"},{"type":"text","text":" i.e. "},{"type":"emphasis","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}],"title":"ElevationRawTokens","kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","navigatorTitle":[{"text":"ElevationRawTokens","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawTokens","kind":"identifier"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw":{"type":"topic","kind":"symbol","url":"\/documentation\/oudstokensraw","images":[{"type":"icon","identifier":"ic_design_token_figma_raw.png"}],"title":"Tokens with raw values","role":"collection","abstract":[{"type":"emphasis","inlineContent":[{"text":"Raw tokens","type":"text"}]},{"type":"text","text":" are smallest "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" possible. They are associated to raw values and will be finaly the values assigned to the "},{"inlineContent":[{"type":"text","text":"components"}],"type":"emphasis"},{"type":"text","text":" properties."}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw"},"ic_design_token_figma_raw.png":{"type":"image","identifier":"ic_design_token_figma_raw.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensRaw\/ic_design_token_figma_raw.png"}]}}}