gether define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"elevation","type":"text"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"title":"ElevationCompositeRawToken","type":"topic"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationRawTokens"}],"url":"\/documentation\/oudstokensraw\/elevationrawtokens","abstract":[{"type":"text","text":"Defined as the group of all "},{"type":"strong","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":" related to "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens"},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"text":"blur","type":"text"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"text":"X offset","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"Y offset","type":"text"}]},{"type":"text","text":", all of them being "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"},{"type":"text","text":" i.e. "},{"type":"emphasis","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","navigatorTitle":[{"kind":"identifier","text":"ElevationRawTokens"}],"title":"ElevationRawTokens","type":"topic"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/blur100":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Has for value 1"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blur100","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationRawToken","preciseIdentifier":"s:13OUDSTokensRaw09ElevationB5Tokena","kind":"typeIdentifier"}],"title":"blur100","url":"\/documentation\/oudstokensraw\/elevationrawtokens\/blur100","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens\/blur100","kind":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw":{"role":"collection","url":"\/documentation\/oudstokensraw","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Raw tokens"}]},{"type":"text","text":" are smallest "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" possible. They a