ontent":[{"text":"elevations","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens"},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"text":"blur","type":"text"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"text":"X offset","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"Y offset","type":"text"}]},{"type":"text","text":", all of them being "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"},{"type":"text","text":" i.e. "},{"type":"emphasis","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}],"title":"ElevationRawTokens","kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","navigatorTitle":[{"text":"ElevationRawTokens","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawTokens","kind":"identifier"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawToken":{"title":"ElevationRawToken","type":"topic","url":"\/documentation\/oudstokensraw\/elevationrawtoken","kind":"symbol","abstract":[{"type":"text","text":"Type aliases precising "},{"type":"codeVoice","code":"CGFloat"},{"type":"text","text":" values are used (because used in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiftUI"}]},{"type":"text","text":" API) for each "},{"type":"strong","inlineContent":[{"type":"text","text":"elevation raw token"}]},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationRawToken"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationRawToken"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationCompositeRawToken":{"title":"ElevationCompositeRawToken","type":"topic","url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","kind":"symbol","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X and Y offsets"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}],"role":"symbol"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw":{"type":"topic","kind":"symbol","url":"\/documentation\/oudstokensraw","images":[{"type":"icon","identifier":"ic_design_token_figma_raw.png"}],"title":"Tokens with raw values","role":"collection","abstract":[{"type":"emphasis","inlineContent":[{"text":"Raw tokens","type":"text"}]},{"type":"text","text":" are smallest "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" possible. They are associated to raw values and will be finaly the values assigned to the "},{"inlineContent":[{"type":"text","text":"components"}],"type":"emphasis"},{"type":"text","text":" properties."}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw"},"ic_design_token_figma_raw.png":{"type":"image","identifier":"ic_design_token_figma_raw.png","alt":null,"variants":[{"url":"\/images\/OUDSTokensRaw\/ic_design_token_figma_raw.png","traits":["1x","light"]}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens/blur200