entation/OUDSTokensRaw/ElevationRawTokens":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawTokens","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","title":"ElevationRawTokens","abstract":[{"type":"text","text":"Defined as the group of all "},{"type":"strong","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":" related to "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","type":"reference","isActive":true},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"text":"blur","type":"text"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"text":"X offset","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"Y offset","type":"text"}]},{"type":"text","text":", all of them being "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawToken","type":"reference","isActive":true},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","type":"reference","isActive":true},{"type":"text","text":" i.e. "},{"type":"emphasis","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}],"kind":"symbol","url":"\/documentation\/oudstokensraw\/elevationrawtokens","role":"symbol","navigatorTitle":[{"text":"ElevationRawTokens","kind":"identifier"}]},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationCompositeRawToken":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","title":"ElevationCompositeRawToken","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"text":"elevation","type":"text"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"text":"X and Y offsets","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"radius","type":"text"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"text":"color","type":"text"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"elevation","type":"text"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NSObject","type":"codeVoice"},{"type":"text","text":" so as to be shared through "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" with extensions and protocols within modules."}],"kind":"symbol","url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","role":"symbol","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}]},"ic_design_token_figma_raw.png":{"type":"image","identifier":"ic_design_token_figma_raw.png","variants":[{"url":"\/images\/OUDSTokensRaw\/ic_design_token_figma_raw.png","traits":["1x","light"]}],"alt":null}}}