STokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"kind":"symbol","title":"MultipleElevationCompositeRawToken"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationCompositeRawToken":{"navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"type":"topic","role":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","abstract":[{"text":"In the ","type":"text"},{"inlineContent":[{"text":"Figma","type":"text"}],"type":"emphasis"},{"text":" global design system, composite tokens are defined for elevation effects.","type":"text"},{"text":" ","type":"text"},{"text":"Composite tokens are tokens defined in ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" by other tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Here an ","type":"text"},{"inlineContent":[{"type":"text","text":"elevation"}],"type":"emphasis"},{"text":" is caracterized by ","type":"text"},{"inlineContent":[{"type":"text","text":"X and Y offsets"}],"type":"emphasis"},{"text":", a ","type":"text"},{"inlineContent":[{"type":"text","text":"radius"}],"type":"emphasis"},{"text":" for the shadow and a ","type":"text"},{"inlineContent":[{"text":"color","type":"text"}],"type":"emphasis"},{"text":" to apply on that shadow.","type":"text"},{"text":" ","type":"text"},{"text":"All these elements are ","type":"text"},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"text":", and together define a ","type":"text"},{"inlineContent":[{"text":"composite raw token","type":"text"}],"type":"emphasis"},{"text":" for ","type":"text"},{"inlineContent":[{"type":"text","text":"elevation"}],"type":"emphasis"},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}],"kind":"symbol","title":"ElevationCompositeRawToken"}}}