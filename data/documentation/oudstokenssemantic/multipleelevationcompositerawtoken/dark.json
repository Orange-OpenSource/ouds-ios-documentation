pe":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"text":"elevation","type":"text"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"text":"X and Y offsets","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"radius","type":"text"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"text":"color","type":"text"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"elevation","type":"text"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken"},"ic_design_token_figma_sem