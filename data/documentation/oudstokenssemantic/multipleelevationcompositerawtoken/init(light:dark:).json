ensions and protocols within modules."}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"role":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","title":"MultipleElevationCompositeRawToken","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken/init(light:dark:)":{"title":"init(light:dark:)","role":"symbol","abstract":[{"text":"Initializes a new elevation composite raw token with two values","type":"text"}],"url":"\/documentation\/oudstokenssemantic\/multipleeleva