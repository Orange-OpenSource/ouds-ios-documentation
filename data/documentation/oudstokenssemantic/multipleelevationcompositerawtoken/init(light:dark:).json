xt":"Composite tokens are tokens defined in ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" by other tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Here an ","type":"text"},{"inlineContent":[{"text":"elevation","type":"text"}],"type":"emphasis"},{"text":" is caracterized by ","type":"text"},{"inlineContent":[{"text":"X and Y offsets","type":"text"}],"type":"emphasis"},{"text":", a ","type":"text"},{"inlineContent":[{"type":"text","text":"radius"}],"type":"emphasis"},{"text":" for the shadow and a ","type":"text"},{"inlineContent":[{"type":"text","text":"color"}],"type":"emphasis"},{"text":" to apply on that shadow.","type":"text"},{"text":" ","type":"text"},{"text":"All these elements are ","type":"text"},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"text":", and together define a ","type":"text"},{"inlineContent":[{"type":"text","text":"composite raw token"}],"type":"emphasis"},{"text":" for ","type":"text"},{"inlineContent":[{"text":"elevation","type":"text"}],"type":"emphasis"},{"text":" effect.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken/init(light:dark:)":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken\/init(light:dark:)","type":"topic","title":"init(light:dark:)","url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken\/init(light:dark:)","kind":"symbol","abstract":[{"type":"text","text":"Initializes a new elevation composite raw token with two values"}],"role":"symbol","fragment