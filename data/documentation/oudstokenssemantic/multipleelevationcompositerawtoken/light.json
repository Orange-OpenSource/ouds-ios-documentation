[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"identifier"}],"title":"ElevationCompositeRawToken","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken"},"ic_design_token_figma_semantic.png":{"identifier":"ic_design_token_figma_semantic.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"type":"image"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","navigatorTitle":[{"text":"Tokens for semantics","kind":"text"}],"role":"collection","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]}