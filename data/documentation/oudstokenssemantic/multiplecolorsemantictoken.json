{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"c:@M@OUDSTokensSemantic@objc(cs)MultipleColorSemanticToken","title":"MultipleColorSemanticToken","navigatorTitle":[{"text":"MultipleColorSemanticToken","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}],"role":"symbol","roleHeading":"Class","modules":[{"name":"Tokens for semantics"}],"symbolKind":"class"},"abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","type":"reference","isActive":true},{"text":" depending to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"color scheme"}]},{"text":" (i.e. ligh mode or dark mode).","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`","type":"text"}],"identifier":{"url":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken\/init(_:)","doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken\/init(light:dark:)"],"title":"Initializers","anchor":"Initialize