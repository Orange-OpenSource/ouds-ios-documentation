paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"true","type":"codeVoice"},{"type":"text","text":" if light an dark colors pass tests, false otherwise or if flag not set"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ Assuming you use a color from a theme","@Environment(\\.theme) var theme","\/\/ Assuming a component is used on a colored surface, get the surface color","@Environment(\\.oudsSurfaceColor) var surfaceColor","","\/\/ Supposing tou want to apply \"someColor\" on a component on the colored surface","let colorToApply = theme.colors.someColor","","\/\/ If you want to check for textual component","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor)","","\/\/ If you want to check for non-textual component (i.e. images, chevrons, indicators, ...)","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ If you want to check the AAA requirements instead of AA (by default)","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/debugContrastRatio(_:_:_:_:_:)"},"kind":"symbol","abstract":[{"text":"Checks the contrast ratio between two tokens of color (","type":"text"},{"code":"MultipleColorSemanticToken","type":"codeVoice"},{"text":") by comparing their ","type":"text"},{"inlineContent":[{"type":"text","text":"light"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"inlineContent":[{"text":"dark","type":"text"}],"type":"emphasis"},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Checks are done if end only if the "},{"type":"codeVoice","code":"OUDSWCAG21Ratios.oudsDebugWCAG21Colors"},{"type":"text","text":" flag is set to true."}]},{"type":"text","text":" "},{"type":"text","text":"Otherwise nothing is done."},{"type":"text","text":" "},{"type":"text","text":"If some ratios are not reached, displays a warning in logs."}],"references":{"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/Criteria":{"title":"OUDSWCAG21Ratio.Criteria","abstract":[{"text":"The type of WCAG 2.1 requirements to consider","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Criteria"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/Criteria","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Criteria"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/criteria"},"ic_design_token_figma_semantic.png":{"alt":null,"type":"image","identifier":"ic_design_token_figma_semantic.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"title":"OUDSWCAG21Ratio","abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"type":"topic","url":"\/documentation\/oudsfoundations\/oudswcag21ratio"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"kind":"symbol","url":"\/documentation\/oudstokenssemantic","role":"collection","type":"topic","title":"Tokens for semantics","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","images":[{"identifier":"ic_design_token_figma_semantic.png","type":"icon"}],"abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"components","type":"text"}],"type":"emphasis"},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/Target":{"title":"OUDSWCAG21Ratio.Target","abstract":[{"type":"text","text":"Lists the type of elements under tests for constrat ratio check."},{"type":"text","text":" "},{"type":"text","text":"Textual elements should have higher contrasts than non-textual ones."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Target"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/Target","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Target"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/target"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations":{"role":"collection","title":"OUDSFoundations","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations","url":"\/documentation\/oudstokenssemantic\/oudsfoundations","abstract":[],"type":"topic","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio":{"title":"OUDSWCAG21Ratio","abstract":[],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV","text":"OUDSWCAG21Ratio","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio","kind":"symbol","navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleColorSemanticToken":{"title":"MultipleColorSemanticToken","abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination o