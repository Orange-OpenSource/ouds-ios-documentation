"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV18OUDSTokensSemanticE6TargetO","kind":"typeIdentifier","text":"Target"},{"kind":"text","text":", "},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV","kind":"typeIdentifier","text":"OUDSWCAG21Ratio"},{"kind":"text","text":"."},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV18OUDSTokensSemanticE8CriteriaO","kind":"typeIdentifier","text":"Criteria"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/debugContrastRatio(_:_:_:_:_:)","role":"symbol","kind":"symbol","title":"debugContrastRatio(_:_:_:_:_:)"},"ic_design_token_figma_semantic.png":{"alt":null,"identifier":"ic_design_token_figma_semantic.png","variants":[{"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"url":"\/documentation\/oudsfoundations\/oudswcag21ratio","abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However, a AAA level is highly recommended for mobile devices because of screen size and luminosity issues; this means a 7:1 ratio for text."},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","role":"symbol","kind":"symbol","title":"OUDSWCAG21Ratio","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleColorSemanticToken":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","type":"topic","title":"MultipleColorSemanticToken","kind":"symbol","url":"\/documentation\/oudstokenssemantic\/multiplecolorsemantictoken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"MultipleColorSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"MultipleColorSemanticToken","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A semantic token that wraps a combination of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken"},{"type":"text","text":" values based on the color scheme (light or dark mode)."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlin