n-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However, a AAA level is highly recommended for mobile devices because of screen size and luminosity issues; this means a 7:1 ratio for text.","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"text":" ","type":"text"},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true,"type":"reference"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"title":"OUDSWCAG21Ratio","type":"topic","url":"\/documentation\/oudsfoundations\/oudswcag21ratio"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/Criteria":{"abstract":[{"text":"The type of WCAG 2.1 requirements to consider","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/Criteria","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Criteria","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Criteria","kind":"identifier"}],"title":"OUDSWCAG21Ratio.Criteria","type":"topic","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/criteria"},"ic_design_token_figma_semantic.png":{"identifier":"ic_design_token_figma_semantic.png","type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}]},"doc://OUDSTokensSemantic/docu