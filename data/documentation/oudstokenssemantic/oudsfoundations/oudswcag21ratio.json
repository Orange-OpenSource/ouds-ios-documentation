":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","title":"oudsDebugWCAG21Colors","abstract":[{"text":"Flag to rise so as to display in logs some warnings if there are troubles","type":"text"},{"text":" ","type":"text"},{"text":"with contrast ratios between colors. Default set to ","type":"text"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Consider rising this falge in DBUG mode.","type":"text"}],"url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/oudsdebugwcag21colors","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/oudsDebugWCAG21Colors"},"ic_design_token_figma_semantic.png":{"variants":[{"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png","traits":["1x","light"]}],"identifier":"ic_design_token_figma_semantic.png","alt":null,"type":"image"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"type":"topic","url":"\/documentation\/oudstokenssemantic","abstract":[{"text":"These ","type":"text"},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"text":" can be used mainly for ","type":"text"},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" to apply some style and configuration values ; today ","type":"text"},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"type":"text","text":"components"}],"type":"emphasis"},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}],"kind":"symbol","role":"collection","title":"Tokens for semantics","images":[{"identifier":"ic_design_token_figma_semantic.png","type":"icon"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV","text":"OUDSWCAG21Ratio"}],"role":"symbol","type":"topic","abstract":[],"title":"OUDSWCAG21Ratio","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"role":"symbol","type":"topic","title":"OUDSWCAG21Ratio","abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","identifier":"https:\/\/accessibilite.numerique.gouv.fr","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However, a AAA level is highly recommended for mobile devices because of screen size and luminosity issues; this means a 7:1 ratio for text."},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true}],"navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"url":"\/documentation\/oudsfoundations\/oudswcag21ratio","kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/debugContrastRatio(_:_:_:_:_:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"debugContrastRatio","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleColorSemanticToken","text":"MultipleColorSemanticToken","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleColorSemanticToken","text":"MultipleColorSemanticToken","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV","text":"OUDSWCAG21Ratio","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV18OUDSTokensSemanticE6TargetO","text":"Target","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV","text":"OUDSWCAG21Ratio","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations15OUDSWCAG21RatioV18OUDSTokensSemanticE8CriteriaO","text":"Criteria","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","type":"topic","title":"debugContrastRatio(_:_:_:_:_:)","abstract":[{"type":"text","text":"Checks the contrast ratio between two tokens of color ("},{"type":"codeVoice","code":"MultipleColorSemanticToken"},{"type":"text","text":") by comparing their "},{"type":"emphasis","inlineContent":[{"type":"text","text":"light"}]},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dark"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Checks are done if end only if the "},{"code":"OUDSWCAG21Ratios.oudsDebugWCAG21Colors","type":"codeVoice"},{"type":"text","text":" flag is set to true."}]},{"type":"text","text":" "},{"type":"text","text":"Otherwise nothing is done."},{"type":"text","text":" "},{"type":"text","text":"If some ratios are not reached, displays a warning in logs."}],"url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/debugcontrastratio(_:_:_:_:_:)","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/debugContrastRatio(_:_:_:_:_:)"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations":{"role":"collection","type":"topic","abstract":[],"title":"OUDSFoundations","url":"\/documentation\/oudstokenssemantic\/oudsfoundations","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations"}}}