":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However, a AAA level is highly recommended for mobile devices because of screen size and luminosity issues; this means a 7:1 ratio for text."},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","role":"symbol","kind":"symbol","title":"OUDSWCAG21Ratio","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/Criteria":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Criteria","kind":"identifier"}],"navigatorTitle":[{"text":"Criteria","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","title":"OUDSWCAG21Ratio.Criteria","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/criteria","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/Criteria","abstract":[{"type":"text","text":"The type of WCAG 2.1 requirements to consider"}]},"https://accessibilite.numerique.gouv.fr":{"type":"link","url":"https:\/\/accessibilite.numerique.gouv.fr","identifier":"https:\/\/ac