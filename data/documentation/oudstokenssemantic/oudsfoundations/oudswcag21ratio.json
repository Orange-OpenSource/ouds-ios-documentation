his utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"type":"topic","url":"\/documentation\/oudsfoundations\/oudswcag21ratio"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/Criteria":{"title":"OUDSWCAG21Ratio.Criteria","abstract":[{"text":"The type of WCAG 2.1 requirements to consider","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Criteria"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations\/OUDSWCAG21Ratio\/Criteria","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Criteria"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/oudsfoundations\/oudswcag21ratio\/criteria"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations":{"role":"collection","title":"OUDSFoundations","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/OUDSFoundations","url":"\/documentation\/oudstokenssemantic\/oudsfoundations","abstract":[],"type":"topic","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/OUDSFoundations/OUDSWCAG21Ratio/debugContrastRatio(_:_:_:_:_:)":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"debugContrastRatio","kind":"identifier"},{"text":"(","kind":"text