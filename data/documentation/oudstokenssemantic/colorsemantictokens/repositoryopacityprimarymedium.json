c  token is a "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"type":"topic","title":"ColorSemanticToken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","kind":"symbol","role":"symbol"},"ic_design_token_figma_semantic.png":{"type":"image","alt":null,"identifier":"ic_design_token_figma_semantic.png","variants":[{"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png","traits":["1x","light"]}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","navigatorTitle":[{"text":"Tokens for semantics","kind":"text"}],"role":"collection","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticTokens":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColorSemanticTokens","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ColorSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/colorsemantictokens","type":"topic","abstr