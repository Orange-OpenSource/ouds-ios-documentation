d is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a color token has a value that depends on the color scheme, it must be packed in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken"},{"type":"text","text":"."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticTokens":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColorSemanticTokens","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ColorSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/colorsemantictokens","type":"topic","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"colors"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","type":"reference","isActive":true},{"type":"text","text":"  a theme must have."},{"type":"text","text":" "},{"type":"text","text":"These tokens are then gathered inside "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","type":"reference","isActive":true},{"type":"text","text":" objects defined in "},{"isActive":true,"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorMultipleSemanticTokens","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If it possible a theme won’t have such semantic tokens of colors defined as not specified nor used in Figma."},{"type":"text","text":" "},{"type":"text","text":"Thus the value for these tokens will be “ouds-forbidden-color-value” as returned by the tokenator."},{"type":"text","text":" "},{"type":"text","text":"Thus if the token is still used, even if explained in the documentation it should not,"},{"type":"text","text":" "},{"type":"text","text":"this special value won’t be successfully parsed as color and the app will crash like expected."}],"title":"ColorSemanticTokens","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticTokens","kind":"symbol","role":"symbol"},"ic_design_token_figma_semantic.png":{"identifier":"ic_design_token_figma_semantic.png","type":"image","alt":null,"variants":[{"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png","traits":["1x","light"]}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorMultipleSemanticTokens":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColorMultipleSemanticTokens","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/colormultiplesemantictokens","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"colors"}]},{"type":"text","text":" but using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken"},{"type":"text","text":"."}],"type":"topic","title":"ColorMultipleSemanticTokens","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorMultipleSemanticTokens","kind":"symbol","role":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","navigatorTitle":[{"text":"Tokens for semantics","kind":"text"}],"role":"collection","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticToken":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorSemanticToken"}],"navigatorTitle":[{"kind":"identifier","text":"ColorSemanticToken"}],"url":"\/documentation\/oudstokenssemantic\/colorsemantictoken","abstract":[{"type":"text","text":"Basically a color semantic  token is a "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"type":"topic","title":"ColorSemanticToken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","kind":"symbol","role":"symbol"}}}