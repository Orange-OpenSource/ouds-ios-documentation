s-forbidden-color-value” as returned by the tokenator."},{"type":"text","text":" "},{"type":"text","text":"Thus if the token is still used, even if explained in the documentation it should not,"},{"type":"text","text":" "},{"type":"text","text":"this special value won’t be successfully parsed as color and the app will crash like expected."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorMultipleSemanticTokens":{"title":"ColorMultipleSemanticTokens","navigatorTitle":[{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/colormultiplesemantictokens","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorMultipleSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"colors","type":"text"}]},{"type":"text","text":" but using "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","isActive":true},{"type":"text","text":"."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticToken":{"title":"ColorSemanticToken","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/colorsemantictoken","navigatorTitle":[{"kind":"identifier","text":"ColorSemanticToken"}],"abstract":[{"type":"text","text":"Basically a color semantic  token is a "},{"code":"ColorRawToken","type":"codeVoice"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}]},"ic_design_token_figma_semantic.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"identifier":"ic_design_token_figma_semantic.png","alt":null,"type":"image"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleColorSemanticToken":{"title":"MultipleColorSemanticToken","navigatorTitle":[{"kind":"identifier","text":"MultipleColorSemanticToken"}],"url":"\/documentation\/oudstokenssemantic\/multiplecolorsemantictoken","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}],"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","isActive":true},{"type":"text","text":" depending to "},{"type":"emphasis","inlineContent":[{"text":"color scheme","type":"text"}]},{"type":"text","text":" (i.e. ligh mode or dark mode)."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`"}]}}}