     var sizeBodySmallTablet: FontSizeSemanticToken { FontRawTokens.size150 }","","        \/\/ Then the development team declares a higher-level font size semantic token for sizeBodySmall","        \/\/ inside FontMultipleSemanticTokens protocol,","        \/\/ and defined inside OUDSTheme+FontMultipleSemanticTokens extension","        var sizeBodySmall: MultipleFontSizeSemanticToken { MultipleFontSizeSemanticToken(compact: sizeBodySmallMobile, regular: sizeBodySmallTablet) }","","        \/\/ If the same value is used whatever the size class is","        var sizeBodySmall: MultipleFontSizeSemanticToken { MultipleFontSizeSemanticToken(sizeBodySmallMobile) }","","        \/\/ The theme exposes both generated font size semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"0.8.0","type":"text"}]}],"name":"Since","type":"aside","style":"note"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontSizeSemanticToken"},"abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSizeSemanticToken","isActive":true,"type":"reference"},{"text":" depending to size classes.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from Figma inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a font size exists with its value depending to the size class, it must be packed in such ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontSizeSemanticToken","isActive"