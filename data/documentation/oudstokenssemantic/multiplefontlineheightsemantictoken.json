red in protocol FontSemanticTokens,","        \/\/ and defined automaticaly in OUDSTheme+FontSemanticTokens extension","        var lineHeightLabelXLargeMobile: FontLineHeightSemanticToken { FontRawTokens.lineHeight450 }","        var lineHeightLabelXLargeTablet: FontLineHeightSemanticToken { FontRawTokens.lineHeight450 }","","        \/\/ Then the develoment team declares an \"higher\" level line height semantic token for lineHeightLabelXLarge","        \/\/ inside FontMultipleSemanticTokens protocol,","        \/\/ and defined inside OUDSTheme+FontMultipleSemanticTokens extension","        var lineHeightLabelXLarge: MultipleFontLineHeightSemanticToken {","            MultipleFontLineHeightSemanticToken(compact: lineHeightLabelXLargeMobile, regular: lineHeightLabelXLargeTablet)","        }","","        \/\/ If the same value is used whatever the size class is","        var lineHeightLabelXLarge: MultipleFontLineHeightSemanticToken { MultipleFontLineHeightSemanticToken(lineHeightLabelXLargeMobile) }","","        \/\/ The theme exposes both generated font line height semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"0.8.0"}]}],"type":"aside","name":"Since"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudstokenssemantic\/multiplefontlineheightsemantictoken"]}],"hierarchy":{"paths":[["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic"]]},"topicSections":[{"anchor":"Operators","identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontLineHeightSemanticToken\/_(_:_:)"],"title":"Operators","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontLineHeightSemanti