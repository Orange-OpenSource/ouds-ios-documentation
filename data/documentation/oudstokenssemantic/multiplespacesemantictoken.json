{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleSpaceSemanticToken"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"syntax":"swift","code":["        \/\/ Assuming in Figma with have a space semantic token scaled2xs,","        \/\/ two semantic size tokens will be defined in Figma and generated by tokenator because","        \/\/ its value can vary if compact or regular modes.","        \/\/ They can be declared in protocol SpaceSemanticTokens,","        \/\/ and defined automaticaly in OUDSTheme+SpaceSemanticTokens extension","        @objc open var scaled2xsMobile: SpaceSemanticToken { DimensionRawTokens._50 }","        @objc open var scaled2xsTablet: SpaceSemanticToken { DimensionRawTokens._100 }","","        \/\/ Then the develoment team declares an \"higher\" level space semantic token for scaled2xs","        \/\/ inside SpaceMultipleSemanticTokens protocol,","        \/\/ and defined inside OUDSTheme+SpaceMultipleSemanticTokens extension","        var scaled2xs: MultipleSpaceSemanticToken { MultipleSpaceSemanticToken(compact: scaled2xsMobile, regular: scaled2xsTablet) }","","        \/\/ If the same value is used whatever the size class is","        var scaled2xs: MultipleSpaceSemanticToken { MultipleSpaceSemanticToken(scaled2xsTabley) }","","        \/\/ The theme exposes both generated font space semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"0.8.0"}],"type":"paragraph"}],"style":"note","name":"Since","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSTokensSeman