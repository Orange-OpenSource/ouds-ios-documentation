k color scheme the monochrome light mode","        var onStatusNeutralEmphasizedLight: ColorModeSemanticToken { ColorModeRawTokens.monochromeDark }","        var onStatusNeutralEmphasizedDark: ColorModeSemanticToken { ColorModeRawTokens.monochromeLight }","        var onStatusNeutralEmphasized: MultipleColorModeSemanticToken {","            MultipleColorModeSemanticToken(\"some unique name\",","                                            light: onStatusNeutralEmphasizedLight,","                                            dark: onStatusNeutralEmphasizedDark)","        }"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"text":"0.13.0","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic"]]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/init(_:_:)","doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/init(_:light:dark:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/dark","doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/light","doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/name"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/hasUndefinedValue()","doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorModeSemanticToken\/isEqual(_:)"]}],"kind":"symbol","references":{"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleCo