 system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing is caracterized by a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font size"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"line height"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font weight"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"letter spacing"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing."}],"url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","kind":"symbol","type":"topic"},"ic_design_token_figma_semantic.png":{"identifier":"ic_design_token_figma_semantic.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"type":"image"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleFontCompositeSemanticToken":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"identifier":"doc:\/\/