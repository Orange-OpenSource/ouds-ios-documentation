:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken\/regular","title":"regular","abstract":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"regular"}],"type":"strong"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"medium"}],"type":"strong"},{"type":"text","text":" viewports"}],"type":"topic","kind":"symbol","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken\/regular"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","role":"collection","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"text":"tokens","type":"text"}],"type":"emphasis"},{"text":" can be used mainly for ","type":"text"},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" to apply some style and configuration values ; today ","type":"text"},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"components","type":"text"}],"type":"emphasis"},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"type":"topic","title":"Tokens for semantics","kind":"symbol","url":"\/documentation\/oudstokenssemantic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticToken":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FontCompositeSemanticToken","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticToken","title":"FontCompositeSemanticToken","navigatorTitle":[{"text":"FontCompositeSemanticToken","kind":"identifier"}],"abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing is caracterized by a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font size"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"line height"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font weight"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"letter spacing"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing."}],"type":"topic","kind":"symbol","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken"}}}