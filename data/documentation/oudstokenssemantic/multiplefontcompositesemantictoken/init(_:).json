kens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing."}],"url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","kind":"symbol","type":"topic"}}}