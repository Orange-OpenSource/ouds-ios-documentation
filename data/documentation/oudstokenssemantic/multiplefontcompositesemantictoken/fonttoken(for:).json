emantic\/MultipleFontCompositeSemanticToken\/fontToken(for:)","type":"topic","abstract":[{"type":"text","text":"Returns the composite raw token of font to use according to the "},{"type":"codeVoice","code":"userInterfaceSizeClass"},{"type":"text","text":" (i.e. "},{"type":"codeVoice","code":"compact"},{"type":"text","text":" or "},{"type":"codeVoice","code":"regular"},{"type":"text","text":")"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"role":"collection","kind":"symbol","url":"\/documentation\/oudstokenssemantic","title":"Tokens for semantics","images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"text":" can be used mainly for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticToken":{"role":"symbol","kind":"symbol","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","navigatorTitle":[{"kind":"identifier","text":"FontCompositeSemanticToken"}],"title":"FontCompositeSemanticToken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticToken","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FontCompositeSemanticToken"}],"abstract":[{"type":"text","text":"In the "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"type":"text","text":" global design system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"inlineContent":[{"type":"text","text":"font"}],"type":"emphasis"},{"type":"text","text":" thing is caracterized by a "},{"inlineContent":[{"type":"text","text":"font size"}],"type":"emphasis"},{"type":"text","text":", a "},{"inlineContent":[{"type":"text","text":"line height"}],"type":"emphasis"},{"type":"text","text":", a "},{"inlineContent":[{"type":"text","text":"font weight"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"letter spacing"}],"type":"emphasis"},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"type":"text","text":", and together define a "},{"inlineContent":[{"type":"text","text":"composite raw token"}],"type":"emphasis"},{"type":"text","text":" for "},{"inlineContent":[{"type":"text","text":"font"}],"type":"emphasis"},{"type":"text","text":" thing."}],"type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleFontCompositeSemanticToken":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"FontCompositeSemanticToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"type":"topic","title":"MultipleFontCompositeSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken"}}}