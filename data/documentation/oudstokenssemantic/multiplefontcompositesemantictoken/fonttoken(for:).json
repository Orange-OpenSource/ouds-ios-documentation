xt":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticToken":{"kind":"symbol","title":"FontCompositeSemanticToken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticToken","navigatorTitle":[{"kind":"identifier","text":"FontCompositeSemanticToken"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"FontCompositeSemanticToken"}],"abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing is caracterized by a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font size"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"line height"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font weight"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"letter spacing"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing."}]}}}