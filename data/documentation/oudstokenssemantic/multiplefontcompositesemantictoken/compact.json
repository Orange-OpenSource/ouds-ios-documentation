UDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleFontCompositeSemanticToken":{"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"FontCompositeSemanticToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true},{"type":"text","text":"."}],"role":"symbol","title":"MultipleFontCompositeSemanticToken","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticToken":{"abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" global design system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"type":"emphasis","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":" thing is caracterized by a "},{"type":"emphasis","inlineContent":[{"text":"font size","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"line height","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"font weight","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"letter spacing","type":"text"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":" thing."}],"kind":"symbol","type":"topic","title":"FontCompositeSemanticToken","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","navigatorTitle":[{"text":"FontCompositeSemanticToken","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticToken","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FontCompositeSemanticToken","kind":"identifier"}]}}}