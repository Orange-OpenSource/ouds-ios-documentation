{"abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/SizeSemanticToken","isActive":true},{"text":" depending to viewports \/ size classes.","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from Figma inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a size token exists with its value depending to the size class, it must be packed in such ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSizeSemanticToken","isActive":true},{"text":".","type":"text"}],"metadata":{"roleHeading":"Class","title":"MultipleSizeSemanticToken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleSizeSemanticToken"}],"externalID":"c:@M@OUDSTokensSemantic@objc(cs)MultipleSizeSemanticToken","navigatorTitle":[{"text":"MultipleSizeSemanticToken","kind":"identifier"}],"modules":[{"name":"Tokens for semantics"}],"symbolKind":"class","role":"symbol"},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/OUDSTokensSemantic\/objc(cs)NSObject"]},{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OUDSTokensSemantic\/objc(pl)NSObject","doc:\/\/OUDSTokensSemantic\/s7CVarArgP","doc:\/\/OUDSTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/OUDSTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/OUDSTokensSemantic\/SQ","doc:\/\/OUDSTokensSemantic\/SH","doc:\/\/OUDSTokensSemantic\/s8SendableP","doc:\/\/OUDSTokensSemantic\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/OUDSToken