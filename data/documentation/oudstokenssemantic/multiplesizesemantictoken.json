ocol SizeSemanticTokens,","        \/\/ and defined automaticaly in OUDSTheme+SizeSemanticTokens extension","        var iconWithHeadingXLargeTallMobile: SizeSemanticToken { DimensionRawTokens._650 }","        var iconWithHeadingXLargeTallTablet: SizeSemanticToken { DimensionRawTokens._800 }","","        \/\/ Then the develoment team declares an \"higher\" level size semantic token for iconWithHeadingXLargeTall","        \/\/ inside SizeMultipleSemanticTokens protocol,","        \/\/ and defined inside OUDSTheme+SizeMultipleSemanticTokens extension","        var iconWithHeadingXLargeTall: MultipleSizeSemanticToken {","            MultipleSizeSemanticToken(compact: iconWithHeadingXLargeTallMobile, regular: iconWithHeadingXLargeTallTablet)","        }","","        \/\/ If the same value is used whatever the size class is","        var iconWithHeadingXLargeTall: MultipleSizeSemanticToken { MultipleSizeSemanticToken(iconWithHeadingXLargeTallTablet) }","","        \/\/ The theme exposes both generated font size semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"syntax":"swift","type":"codeListing"},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"0.8.0"}]}]}],"kind":"content"}],"references":{"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleSizeSemanticToken/init(_:)":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSizeSemanticToken\/init(_:)","url":"\/documentation\/oudstokenssemantic\/multiplesizesemantictoken\/init(_:)","kind":"symbol","type":"topic","title":"init(_:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SizeSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic04SizeB5Tokena","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Initia