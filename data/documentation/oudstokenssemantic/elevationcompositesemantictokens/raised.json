en","kind":"identifier"}],"abstract":[{"type":"text","text":"Basically an elevationcomposite  semantic token, used mainly for box shadow, is a pair of elevation composite raw tokens used depending to the color scheme."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","isActive":true},{"type":"text","text":" contains "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" objects for light and dark modes, which contains "},{"type":"codeVoice","code":"ElevationRawToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":" values."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictoken","title":"ElevationCompositeSemanticToken","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationSemanticTokens":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ElevationSemanticTokens"}],"abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It defines all elevation semantic tokens a theme must have (","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationXSemanticToken","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationYSemanticToken","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationBlurSemanticToken","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationColorSemanticToken","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"However the composite tokens (here for box shadows) are defined in ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":" because the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"text":" ","type":"text"},{"text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted.","type":"text"},{"text":" ","type":"text"},{"text":"Any elevation semantic token must be declared there (except ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":")","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/elevationsemantictokens","title":"ElevationSemanticTokens","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"url":"\/documentation\/oudstokenssemantic","title":"Tokens for semantics","abstract":[{"text":"These ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"text":" can be used mainly for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"text":" to apply some style and configuration values ; today ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"text":" or ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}],"abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"text":", but only ","type":"text"},{"type":"strong","inlineContent":[{"text":"composite tokens","type":"text"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"There are splitted and not declared in ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","isActive":true,"type":"reference"},{"text":" as the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"text":" tool parsing ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"text":" JSON to Swift code is not able to manage them.","type":"text"},{"text":" ","type":"text"},{"text":"Thus we need to declare them in another file to prevent them to be erased.","type":"text"},{"text":" ","type":"text"},{"text":"It declares in fact box shadows effects.","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}],"