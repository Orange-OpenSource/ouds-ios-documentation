OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationYSemanticToken","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationBlurSemanticToken","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationColorSemanticToken","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"However the composite tokens (here for box shadows) are defined in ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":" because the ","type":"text"},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted.","type":"text"},{"text":" ","type":"text"},{"text":"Any elevation semantic token must be declared there (except ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":")","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationSemanticTokens","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ElevationSemanticTokens","kind":"identifier"}],"title":"ElevationSemanticTokens"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens","abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"elevations"}],"type":"strong"},{"text":", but only ","type":"text"},{"inlineContent":[{"type":"text","text":"composite tokens"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"There are splitted and not declared in ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","isActive":true,"type":"reference"},{"text":" as the ","type":"text"},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"text":" tool parsing ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" JSON to Swift code is not able to manage them.","type":"text"},{"text":" ","type":"text"},{"text":"Thus we need to declare them in another file to prevent them to be erased.","type":"text"},{"text":" ","type":"text"},{"text":"It declares in fact box shadows effects.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"title":"ElevationCompositeSemanticTokens"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"url":"\/documentation\/oudstokenssemantic","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"text":"tokens","type":"text"}],"type":"emphasis"},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","kind":"symbol","type":"topic","role":"collection","images":[{"identifier":"ic_design_token_figma_semantic.png","type":"icon"}],"title":"Tokens for semantics"}}}