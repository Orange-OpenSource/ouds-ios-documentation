ce","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":")"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/elevationsemantictokens","title":"ElevationSemanticTokens","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}],"kind":"symbol","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens","abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"inlineContent":[{"text":"elevations","type":"text"}],"type":"strong"},{"text":", but only ","type":"text"},{"inlineContent":[{"text":"composite tokens","type":"text"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"There are splitted and not declared in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens"},{"text":" as the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"text":" tool parsing ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" JSON to Swift code is not able to manage them.","type":"text"},{"text":" ","type":"text"},{"text":"Thus we need to declare them in another file to prevent them to be erased.","type":"text"},{"text":" ","type":"text"},{"text":"It declares in fact box shadows effects.","type":"text"}],"type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","title":"ElevationCompositeSemanticTokens","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticToken