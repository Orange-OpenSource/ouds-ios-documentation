s "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" objects for light and dark modes, which contains "},{"type":"codeVoice","code":"ElevationRawToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":" values."}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationSemanticTokens":{"role":"symbol","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all elevation semantic tokens a theme must have ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationXSemanticToken"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationYSemanticToken"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationBlurSemanticToken"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationColorSemanticToken"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"However the composite tokens (here for box shadows) are defined in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any elevation semantic token must be declared there (except "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":")"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ElevationSemanticTokens"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationSemanticTokens"}],"url":"\/documentation\/oudstokenssemantic\/elevationsemantictokens","title":"ElevationSemanticTokens","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"role":"symbol","abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"title":"MultipleElevationCompositeRawToken","navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"kind":"symbol","type":"topic","u