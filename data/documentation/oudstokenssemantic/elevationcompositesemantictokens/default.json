posite raw tokens used depending to the color scheme."},{"type":"text","text":" "},{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken"},{"type":"text","text":" contains "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" objects for light and dark modes, which contains "},{"type":"codeVoice","code":"ElevationRawToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":" values."}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken","kind":"symbol","navigatorTitle":[{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictoken"},"ic_design_token_figma_semantic.png":{"type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"identifier":"ic_design_token_figma_semantic.png"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens/default":{"title":"default","abstract":[],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens\/default","type":"topic","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens\/default","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`default`","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSTokensSemantic018ElevationCompositeB5Tokena","text":"ElevationCompositeSemanticToken","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationSemanticTokens":{"role":"symbol","navigatorTitle":[{"text":"ElevationSemanticTokens","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationSemanticTokens"}],"title":"ElevationSemanticTokens","url":"\/documentation\/oudstokenssemantic\/elevationsemantictokens","abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"elevations"}],"type":"strong"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"It defines all elevation semantic tokens a theme must have (","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationXSemanticToken","type":"reference","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationYSemanticToken","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationBlurSemanticToken","type":"reference","isActive":true},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationColorSemanticToken"},{"type":"text","text":")."},{"text":" ","type":"text"},{"type":"text","text":"However the composite tokens (here for box shadows) are defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":" because the "},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any elevation semantic token must be declared there (except "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens"},{"text":")","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"kind":"symbol","url":"\/documentation\/oudstokenssemantic","role":"collection","type":"topic","title":"Tokens for semantics","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","images":[{"identifier":"ic_design_token_figma_semantic.png","type":"icon"}],"abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"components","type":"text"}],"type":"emphasis"},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"title":"MultipleElevationCompositeRawToken","abstract":[{"text":"Semantic tokens which will wrap a combination of ","type":"text"},{"code":"ElevationCompositeRawToken","type":"codeVoice"},{"text":" depending to color scheme (i.e. light mode or dark mode)","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","type":"topic","url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","navigatorTitle":[{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"role":"symbol","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"title":"ElevationCompositeSemanticTokens","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"inlineContent":[{"text":"elevations","type":"text"}],"type":"strong"},{"type":"text","text":", but only "},{"inlineContent":[{"type":"text","text":"composite tokens"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","isActive":true},{"type":"text","text":" as the "},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"type":"text","text":" tool parsing "},{"inlineContent":[{"text":"Figma","type":"text"}],"type":"emphasis"},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."},{"type":"text","text":" "},{"type":"text","text":"It declares in fact box shadows effects."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","type":"topic","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens","navigatorTitle":[{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"role":"symbol","kind":"symbol"}}}