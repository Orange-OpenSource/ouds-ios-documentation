ens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken"},{"type":"text","text":"."}],"title":"MultipleFontCompositeSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken"},"ic_design_token_figma_semantic.png":{"type":"image","alt":null,"identifier":"ic_design_token_figma_semantic.png","variants":[{"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png","traits":["1x","light"]}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","navigatorTitle":[{"text":"Tokens for semantics","kind":"text"}],"role":"collection","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}]}}}