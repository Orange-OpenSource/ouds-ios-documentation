tifier","text":"FontSemanticTokens"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSemanticTokens","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/fontsemantictokens","navigatorTitle":[{"kind":"identifier","text":"FontSemanticTokens"}],"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all font semantic tokens a theme must have"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontFamilySemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontWeightSemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSizeSemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontLineHeightSemanticToken","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"However the composite tokens (here the ones gathering each type of semantic token here) are defined in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","isActive":true},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any font semantic token must be declared there (except "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","isActive":true},{"type":"text","text":")."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticTokens/bodyDefaultMedium":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bodyDefaultMedium"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MultipleFontCompositeSemanticToken","preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleFontCompositeSemanticToken"}],"abstract":[],"kind":"symbol","title":"bodyDefaultMedium","required":true,"role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens\/bodyDefaultMedium","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictokens\/bodydefaultmedium","type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticTokens":{"title":"FontCompositeSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FontCompositeSemanticTokens"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictokens","navigatorTitle":[{"kind":"identifier","text":"FontCompositeSemanticTokens"}],"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"fonts","type":"text"}]},{"type":"text","text":", but only "},{"type":"strong","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":" in the end."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSemanticTokens","isActive":true},{"type":"text","text":" as the "},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"type":"text","text":" tool parsing "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleFontCompositeSemanticToken":{"title":"MultipleFontCompositeSemanticToken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken","navigatorTitle":[{"kind":"identifier","text":"MultipleFontCompositeSemanticToken"}],"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"FontCompositeSemanticToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true},{"type":"text","text":"."}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"title":"Tokens for semantics","url":"\/documentation\/oudstokenssemantic","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","abstract":[{"type":"text","text":"These "},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}]},"ic_design_token_figma_semantic.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"identifier":"ic_design_token_figma_semantic.png","type":"image","alt":null}}}