{"sections":[],"abstract":[{"text":"Radio button is a UI element that allows to select a single option from a set of mutually exclusive choices.","type":"text"},{"text":" ","type":"text"},{"text":"Radio button that does not show icon or text, provides greater flexibility when creating other components that require a Radio button to be displayed.","type":"text"}],"metadata":{"modules":[{"name":"Components"}],"roleHeading":"Structure","title":"OUDSRadio","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSRadio","kind":"identifier"}],"role":"symbol","externalID":"s:14OUDSComponents9OUDSRadioV","platforms":[{"beta":false,"unavailable":false,"deprecated":false,"name":"iOS","introducedAt":"15.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"macOS","introducedAt":"13.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"tvOS","introducedAt":"16.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"watchOS","introducedAt":"11.0"}],"navigatorTitle":[{"text":"OUDSRadio","kind":"identifier"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/oudscomponents\/oudsradio"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio\/init(isOn:accessibilityLabel:isError:isReadOnly:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio\/init(isOn:accessibilityLabel:tableName:bundle:isError:isReadOnly:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio\/body"],"anchor":"Instance-Properties"},