{"sections":[],"kind":"symbol","metadata":{"title":"OUDSRadio","modules":[{"name":"Components"}],"roleHeading":"Structure","platforms":[{"name":"iOS","deprecated":false,"beta":false,"introducedAt":"15.0","unavailable":false},{"name":"macOS","deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false},{"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0","unavailable":false},{"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"11.0","unavailable":false}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSRadio","kind":"identifier"}],"externalID":"s:14OUDSComponents9OUDSRadioV","symbolKind":"struct","navigatorTitle":[{"text":"OUDSRadio","kind":"identifier"}],"role":"symbol"},"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsradio"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSRadio"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"]},{"content":[{"level":2,"anchor":"Particular-cases","text":"Particular cases","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio","isActive":true,"type":"reference"},{"text":" can be related to an error situation, for example troubles for a formular.","type":"text"},{"text":" ","type":"text"},{"text":"A dedicated look-and-feel is implemented for that if the ","type":"text"},{"code":"isError","type":"codeVoice"},{"text":" flag is risen.","type":"text"}]},{"anchor":"Accessibility-considerations","type":"heading","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note also the component must be instanciated with a string parameter used as accessibility label."},{"text":" ","type":"text"},{"type":"text","text":"It is a good pratice (at least) to define a label for a component without text for accessibility reasons. This label will be vocalized by "},{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The vocalization tool will also use, after the label, a description of the component (if disabled, if error context), and a fake trait for radio."},{"type":"text","text":" "},{"type":"text","text":"No accessibility identifier is defined in OUDS side as this value remains in the users hands."}]},{"anchor":"Cases-forbidden-by-design","type":"heading","level":2,"text":"Cases forbidden by design"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The design system does not allow to have both an error or read only situation and a disabled component.","type":"text"}],"type":"strong"}]},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ Supposing we have an unselected state","    @Published var selection: Bool = false","","    \/\/ A simple radio, no error, not in read only mode","    OUDSRadio(isOn: $selection, accessibilityLabel: \"The cake is a lie\")","","    \/\/ A simple radio, but is an error context","    OUDSRadio(isOn: $selection, accessibilityLabel: \"The cake is a lie\", isError: true)","","    \/\/ Never disable an error-related radio button as it will crash","    \/\/ This is forbidden by design!","    OUDSRadio(isOn: $selection, accessibilityLabel: \"The cake is a lie\", isError: true).disabled(true) \/\/ fatal error"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Design documentation","anchor":"Design-documentation"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-radio-button","isActive":true,"type":"reference"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Themes rendering","anchor":"Themes-rendering"},{"level":3,"type":"heading","text":"Orange","anchor":"Orange"},{"inlineContent":[{"identifier":"component_radio_Orange","type":"image"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Orange Compact","anchor":"Orange-Compact"},{"inlineContent":[{"identifier":"component_radio_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Sosh","anchor":"Sosh"},{"inlineContent":[{"type":"image","identifier":"component_radio_Sosh"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Wireframe","anchor":"Wireframe"},{"inlineContent":[{"type":"image","identifier":"component_radio_Wireframe"}],"type":"paragraph"},{"style":"note","name":"Version","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.4.0 (Figma component design version)"}]}]},{"style":"note","name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"0.12.0","type":"text"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadio","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Radio button is a UI element that allows to select a single option from a set of mutually exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Radio button that does not show icon or text, provides greater flexibility when creating other compo