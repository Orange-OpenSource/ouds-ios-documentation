{"kind":"text","text":" "},{"kind":"identifier","text":"Helperlink"}],"role":"symbol","navigatorTitle":[{"text":"Helperlink","kind":"identifier"}],"type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","title":"Components","role":"collection","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","kind":"symbol","url":"\/documentation\/oudscomponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-926rh":{"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-926rh","abstract":[{"type":"text","text":"Creates a text input with a localized label, looking up the key in the given bundle."}],"title":"init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)","url":"\/documentation\/oudscomponents\/oudstextinput\/init(_:tablename:bundle:text:placeholder:prefix:suffix:leadingimage:trailingaction:helpertext:helperlink:isoutlined:constrainedmaxwidth:status:)-926rh","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"LocalizedStringKey","preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":