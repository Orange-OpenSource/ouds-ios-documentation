:[{"text":"Used to describe the helper link above the helper text.","type":"text"}],"type":"topic","kind":"symbol","title":"OUDSTextInput.Helperlink"},"component_textInput_OrangeCompact":{"type":"image","alt":"A text input component in light and dark modes with Orange Compact theme","identifier":"component_textInput_OrangeCompact","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textInput_OrangeCompact.png"}]},"component_textInput_Wireframe":{"type":"image","alt":"A text input component in light and dark modes with Wireframe theme","identifier":"component_textInput_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textInput_Wireframe.png"}]},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"component_textInput_Orange":{"alt":"A text input component in light and dark modes with Orange theme","type":"image","identifier":"component_textInput_Orange","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_Orange.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput":{"role":"symbol","abstract":[{"type":"text","text":"Text input is a UI element that allows to enter, edit, or select single-line textual data."},{"type":"text","text":" "},{"type":"text","text":"Text input is one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries."},{"type":"text","text":" "},{"type":"text","text":"It provides a visual and interactive affordance for text entry while supporting labels, placeholders, icons, descriptions, and validation feedback."}],"url":"\/documentation\/oudscomponents\/oudstextinput","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTextInput"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComp