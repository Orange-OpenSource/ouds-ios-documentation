"text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","title":"Components","kind":"symbol","url":"\/documentation\/oudscomponents","role":"collection","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSImage":{"url":"\/documentation\/oudscomponents\/oudsimage","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSImage","kind":"identifier"}],"kind":"symbol","title":"OUDSImage","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSImage","type":"topic","role":"symbol","navigatorTitle":[{"text":"OUDSImage","kind":"identifier"}],"abstract":[{"type":"text","text":"Use to provide an asset to ouds in order to be added in some components."},{"type":"text","text":" "},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"type":"codeVoice","code":"acessibilityLabel"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/View-Implementations":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/View-Implementations","url":"\/documentation\/oudscomponents\/oudstextinput\/view-implementations","kind":"article","abstract":[],"title":"View Implementations","type":"topic","role":"collectionGroup"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Status":{"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Status