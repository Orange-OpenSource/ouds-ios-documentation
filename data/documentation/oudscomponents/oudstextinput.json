,{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14OUDSComponents13OUDSTextInputV","kind":"typeIdentifier","text":"OUDSTextInput"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14OUDSComponents13OUDSTextInputV6StatusO","kind":"typeIdentifier","text":"Status"},{"kind":"text","text":")"}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/init(label:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-2tesf","abstract":[{"type":"text","text":"Creates a text input with a rich attributed helper text."}]},"doc://OUDSComponents/documentation/OUDSComponents/Controls":{"role":"article","kind":"article","type":"topic","title":"Controls","url":"\/documentation\/oudscomponents\/controls","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"controls"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/TrailingAction":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/TrailingAction","url":"\/documentation\/oudscomponents\/oudstextinput\/trailingaction","title":"OUDSTextInput.TrailingAction","role":"symbol","abstract":[{"text":"Used to describe the trailing action of the text input","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrailingAction","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"TrailingAction","kind":"identifier"}]},"ic_folder_categories.png":{"type":"image","identifier":"