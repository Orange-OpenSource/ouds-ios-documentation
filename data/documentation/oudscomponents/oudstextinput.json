tInput","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14OUDSComponents13OUDSTextInputV6StatusO","text":"Status","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-6fxq4","url":"\/documentation\/oudscomponents\/oudstextinput\/init(_:tablename:bundle:text:placeholder:prefix:suffix:leadingimage:trailingaction:helpertext:helperlink:isoutlined:constrainedmaxwidth:status:)-6fxq4","title":"init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)"},"doc://OUDSComponents/documentation/OUDSComponents/Controls":{"kind":"article","url":"\/documentation\/oudscomponents\/controls","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"title":"Controls","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"controls"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":"."}],"role":"article"},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/OUDSComponents\/s8SendableP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/TrailingAction":{"role":"symbol","title":"OUDSTextInput.TrailingAction","url":"\/documentation\/oudscomponents\/oudstextinput\/trailingaction","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrailingAction"}],"abstract":[{"type":"text","text":"Used to describe the trai