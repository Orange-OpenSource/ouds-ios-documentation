te","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"],"kind":"mentions"},{"content":[{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: richDescription)","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"type":"codeListing"},{"level":2,"text":"Rich text","anchor":"Rich-text","type":"heading"},{"inlineContent":[{"text":"Only the alert message description and bullet list can use rich text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it like Orange brand.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Design documentation","anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","type":"reference"}],"type":"paragraph"},{"level":2,"text":"Themes rendering","anchor":"Themes-rendering","type":"heading"},{"level":3,"text":"Orange","anchor":"Orange","type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_Orange","type":"image"}],"type":"paragraph"},{"level":3,"text":"Orange Compact","anchor":"Orange-Compact","type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"text":"Sosh","