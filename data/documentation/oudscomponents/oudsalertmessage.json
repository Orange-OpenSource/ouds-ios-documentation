{"sections":[],"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"metadata":{"modules":[{"name":"Components"}],"platforms":[{"beta":false,"name":"iOS","deprecated":false,"unavailable":false,"introducedAt":"15.0"},{"beta":false,"name":"macOS","deprecated":false,"unavailable":false,"introducedAt":"13.0"},{"beta":false,"name":"tvOS","deprecated":false,"unavailable":false,"introducedAt":"16.0"},{"beta":false,"name":"visionOS","deprecated":false,"unavailable":false,"introducedAt":"1.0"}],"role":"symbol","navigatorTitle":[{"text":"OUDSAlertMessage","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:14OUDSComponents16OUDSAlertMessageV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"title":"OUDSAlertMessage"},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link"],"title":"Structures","generated":true,"anchor":"Structures"},{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-1p0x5","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-1uwaa","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-3cyay","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-8hxrc","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-3cw9f","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-69guh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-8ddeg","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-8e668"]},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/body"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/View-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"]},{"kind":"content","content":[{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: richDescription)","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"type":"codeListing","syntax":"swift"},{"anchor":"Rich-text","text":"Rich text","level":2,"type":"heading"},{"inlineContent":[{"text":"Only the alert message description and bullet list can use rich text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it like Orange brand.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}],"type":"paragraph"},{"anchor":"Accessibility-considerations","text":"Accessibility considerations","level":2,"type":"heading"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","isActive":true}],"type":"paragraph"},{"anchor":"Themes-rendering","text":"Themes rendering","level":2,"type":"heading"},{"anchor":"Orange","text":"Orange","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Orange"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_OrangeCompact"}],"type":"paragraph"},{"anchor":"Sosh","text":"Sosh","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Sosh"}],"type":"paragraph"},{"anchor":"Wireframe","text":"Wireframe","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Wireframe"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.1.1 (Figma component design version)","type":"text"}]}],"type":"aside","name":"Version"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.3.0","type":"text"}]}],"type":"aside","name":"Since"}]}],"identifier":{"url":"d