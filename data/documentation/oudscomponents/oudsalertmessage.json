{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"]},{"kind":"content","content":[{"text":"Code samples","anchor":"Code-samples","level":2,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: .rich(richDescription))","","        \/\/ With a localized description and a bullet list mixing raw, localized and rich texts","        OUDSAlertMessage(label: \"Label\",","                         description: .localized(\"description_wording\", bundle: Bundle.module),","                         bulletList: [","                            \"First thing\", \/\/ Same as .raw(\"First thing\")","                            .localized(\"second_thing_wording\", bundle: Bundle.module),","                            .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                         ])","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"]},{"level":2,"anchor":"Rich-text","type":"heading","text":"Rich text"},{"inlineContent":[{"type":"text","text":"Only the alert message description and bullet list can use rich text."},{"type":"text","text":" "},{"type":"text","text":"They are "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":" values: a raw "},{"code":"String","type":"codeVoice"},{"type":"text","text":" (a string literal is enough), a localized string"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"type":"text","text":" or a rich text with "},{"type":"codeVoice","code":".rich(_:)"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With the initializer taking a "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":", prefer "},{"type":"codeVoice","code":".raw(_:)"},{"type":"text","text":" to a bare string literal for the "},{"type":"codeVoice","code":"description"},{"text":" ","type":"text"},{"text":"to avoid a deprecation warning.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}],"type":"paragraph"},{"text":"Accessibility considerations","type":"heading","level":2,"anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"text":"Design documentation","type":"heading","level":2,"anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","isActive":true}]},{"text":"Themes rendering","type":"heading","level":2,"anchor":"Themes-rendering"},{"text":"Orange","type":"heading","level":3,"anchor":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_alertMessage_Orange","type":"image"}]},{"text":"Orange Compact","type":"heading","level":3,"anchor":"Orange-Compact"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_alertMessage_OrangeCompact"}]},{"text":"Sosh","type":"