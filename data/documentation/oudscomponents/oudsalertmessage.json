{"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"kind":"symbol","metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"roleHeading":"Structure","title":"OUDSAlertMessage","externalID":"s:14OUDSComponents16OUDSAlertMessageV","navigatorTitle":[{"text":"OUDSAlertMessage","kind":"identifier"}],"platforms":[{"beta":false,"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false},{"beta":false,"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false},{"introducedAt":"16.0","name":"tvOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"1.0","unavailable":false,"deprecated":false,"name":"visionOS","beta":false}],"role":"symbol","modules":[{"name":"Components"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"]},{"kind":"content","content":[{"text":"Code samples","type":"heading","anchor":"Code-samples","level":2},{"type":"codeListing","code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: richDescription)","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"syntax":"swift"},{"level":2,"anchor":"Rich-text","type":"heading","text":"Rich text"},{"inlineContent":[{"text":"Only the alert message description and bullet list can use rich text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}],"type":"paragraph"},{"text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations","type":"heading"},{"inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}],"type":"paragraph"},{"text":"Design documentation","level":2,"anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","isActive":true,"type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","level":2,"anchor":"Themes-rendering","type":"heading"},{"text":"Orange","level":3,"anchor":"Orange","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Orange"}],"type":"paragraph"},{"text":"Orange Compact","level":3,"anchor":"Orange-Compact","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_OrangeCompact"}],"type":"paragraph"},{"text":"Sosh","level":3,"anchor":"Sosh","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Sosh"}],"type":"paragraph"},{"level":3,"anchor":"Wireframe","type":"heading","text":"Wireframe"},{"inlineContent":[{"type":"image","identifier":"component_alertMessage_Wireframe"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.1.1 (Figma component design version)"}]}],"type":"aside","name":"Version"},{"style":"note","content":[{"inlineContent":[{"text":"1.3.0","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Since"}]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsalertmessage"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSCom