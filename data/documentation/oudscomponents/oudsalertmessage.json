        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Rich text","anchor":"Rich-text","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the alert message description and bullet list can use rich text."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"type":"heading","text":"Design documentation","anchor":"Design-documentation","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","type":"reference","isActive":true}]},{"type":"heading","text":"Themes rendering","anchor":"Themes-rendering","level":2},{"type":"heading","text":"Orange","anchor":"Orange","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_alertMessage_Orange","type":"image"}]},{"type":"heading","text":"Orange Compact","anchor":"Orange-Compact","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_alertMessage_OrangeCompact","type":"image"}]},{"type":"heading","level":3,"text":"Sosh","anchor":"Sosh"},{"type":"paragraph","inlineConten