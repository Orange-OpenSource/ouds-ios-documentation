itle":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: .rich(richDescription))","","        \/\/ With a localized description and a bullet list mixing raw, localized and rich texts","        OUDSAlertMessage(label: \"Label\",","                         description: .localized(\"description_wording\", bundle: Bundle.module),","                         bulletList: [","                            \"First thing\", \/\/ Same as .raw(\"First thing\")","                            .localized(\"second_thing_wording\", bundle: Bundle.module),","                            .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                         ])","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Rich text","anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the alert message description and bullet list can use rich text."},{"type":"text","text":" "},{"type":"text","text":"They are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"type":"text","text":" values: a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":" (a string literal is enough), a localized string"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"type":"text","text":" or a rich text with "},{"type":"codeVoice","code":".rich(_:)"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With the initializer taking a "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":", prefer "},{"type":"codeVoice","code":".raw(_:)"},{"type":"text","text":" to a bare string literal for the "},{"type":"codeVoice","code":"description"},{"type":"text","text":" "},{"type":"text","text":"to avoid a deprecation warning."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"type":"heading","level":2,"text":"Design documentation","anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message"}]},{"type":"heading","level":2,"text":"Themes rendering","anchor":"Themes-rendering"},{"type":"heading","level":3,"text":"Orange","anchor":"Orange"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_alertMessage_Orange"}]},{"type":"heading","level":3,"text":"Orange Compact","anchor":"Orange-Compact"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_alertMessage_OrangeCompact"}]},{"type":"heading","level":3,"text":"Sosh","anchor":"Sosh"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_alertMessage_Sosh"}]},{"type":"heading","level":3,"text":"Wireframe","anchor":"Wireframe"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_alertMessage_Wireframe"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"style":"note","name":"Version"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"1.3.0"}],"type":"paragraph"}],"style":"note","name":"Since"}]}],"sections":[],"kind":"symbol","metadata":{"title":"OUDSAlertMessage","navigatorTitle":[{"text":"OUDSAlertMessage","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertMessage","kind":"identifier"}],"role":"symbol","symbolKind":"struct","externalID":"s:14OUDSComponents16OUDSAlertMessageV",