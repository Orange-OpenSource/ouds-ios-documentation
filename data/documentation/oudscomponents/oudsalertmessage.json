{"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","interfaceLanguage":"swift"},"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Dialogs"],"kind":"mentions"},{"content":[{"text":"Code samples","anchor":"Code-samples","level":2,"type":"heading"},{"syntax":"swift","code":["        \/\/ A basic positive alert message with text and description","        OUDSAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        OUDSAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        OUDSAlertMessage(label: \"Label\", description: .rich(richDescription))","","        \/\/ With a localized description and a bullet list mixing raw, localized and rich texts","        OUDSAlertMessage(label: \"Label\",","                         description: .localized(\"description_wording\", bundle: Bundle.module),","                         bulletList: [","                            \"First thing\", \/\/ Same as .raw(\"First thing\")","                            .localized(\"second_thing_wording\", bundle: Bundle.module),","                            .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                         ])","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        OUDSAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        OUDSAlertMessage(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_heart\"))))","        OUDSAlertMessage(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = OUDSAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        OUDSAlertMessage(label: \"Label\", link: link)"],"type":"codeListing"},{"text":"Rich text","anchor":"Rich-text","level":2,"type":"heading"},{"inlineContent":[{"text":"Only the alert message description and bullet list can use rich text.","type":"text"},{"text":" ","type":"text"},{"text":"They are ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" (a string literal is enough), a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"With the initializer taking a ","type":"text"},{"code":"LocalizedStringKey","type":"codeVoice"},{"text":", prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for the ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to avoid a deprecation warning.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it like Orange brand.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}],"type":"paragraph"},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2,"type":"heading"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"text":"Design documentation","anchor":"Design-documentation","level":2,"type":"heading"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-alert-message","isActive":true,"type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","anchor":"Themes-rendering","level":2,"type":"heading"},{"text":"Orange","anchor":"Orange","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_Orange","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","anchor":"Orange-Compact","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_OrangeCompact","type":"image"}],"type":"paragraph"},{"text":"Sosh","anchor":"Sosh","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_Sosh","type":"image"}],"type":"paragraph"},{"text":"Wireframe","anchor":"Wireframe","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_alertMessage_Wireframe","type":"image"}],"type":"paragraph"},{"style":"note","name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"1.3.0"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage"]}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Components"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSAlertMessage"}],"role":"symbol","externalID":"s:14OUDSComponents16OUDSAlertMessageV","platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable"