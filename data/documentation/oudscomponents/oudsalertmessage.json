{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage"]}],"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link"],"title":"Structures","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-1p0x5","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-1uwaa","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-3cyay","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-8hxrc","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-3cw9f","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-69guh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-8ddeg","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMes