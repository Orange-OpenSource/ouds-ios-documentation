n."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier"},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}],"type":"paragraph"},{"inlineContent":[{"text":"**You must use this ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" with care, and only if you are using Xcode 26 and  ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}],"type":"strong"}],"type":"paragraph"},{"name":"Since","style":"note","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier/body(content:)":{"type":"topic","title":"body(content:)","kind":"symbol","role":"symbol","abstract":[{"text":"Defines environment variable to precise the legacy tab bar must be forced","type":"text"}],"url":"\/documentation\/oudscomponents\/oudslegacylayoutmodifier\/body(content:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"}