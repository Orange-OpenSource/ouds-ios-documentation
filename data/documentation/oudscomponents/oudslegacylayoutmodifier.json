{"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","interfaceLanguage":"swift"},"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslegacylayoutmodifier"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSLegacyLayoutModifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by OUDS."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 26, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" flag is read and OUDS considers wether or not Liquid Glass is enabled."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The edge case is when the OS version is 27, the flag "},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and OUDS cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","type":"reference","isActive":true},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"type":"codeListing","code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"],"syntax":"swift"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}]}],"type":"paragraph"},{"name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"style":"note"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"kind":"relationships"}],"kind":"symbol","metadata":{"externalID":"s:14OUDSComponents24OUDSLegacyLayoutModifierV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLegacyLayoutModifier"}],"role":"symbol","title":"OUDSLegacyLayoutModifier","navigatorTitle":[{"text":"OUDSLegacyLayoutModifier","kind"