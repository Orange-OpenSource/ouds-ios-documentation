"text":" and displays error messages in the standard output","type":"text"}],"url":"\/documentation\/oudscomponents\/oudslegacylayoutmodifier\/init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"role":"symbol"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP","type":"unresolvable"},"doc://OUDSComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image","identifier":"ic_folder_categories.png","alt":null}}}