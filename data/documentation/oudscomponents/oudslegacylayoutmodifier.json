{"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslegacylayoutmodifier"]}],"kind":"symbol","metadata":{"externalID":"s:14OUDSComponents24OUDSLegacyLayoutModifierV","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"modules":[{"name":"Components"}],"title":"OUDSLegacyLayoutModifier","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSLegacyLayoutModifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/init()"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/body(content:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/ViewModifier-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" flag is read and OUDS considers wether or not Liquid Glass is enabled."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled."}]},{"type":"paragraph","inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and OUDS cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","isActive":true},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}]},{"inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"syntax":"swift","code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars","type":"text"}]}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}],"name":"Since","type":"aside"}],"kind":"content"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier/body(content:)":{"kind":"symbol","type":"topic","url":"\/documentation\/oudscomponents\/oudslegacylayoutmodifier\/body(content:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/body(content:)","title":"body(content:)","abstract":[{"text":"Defines environment variable to precise the legacy tab bar must be forced","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":"("},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents24OUDSLegacyLayoutModifierV"},{"text":".","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier":{"role":"symbol","abstract