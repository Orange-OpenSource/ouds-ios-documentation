{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/init()"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/body(content:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/ViewModifier-Implementations"],"generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" flag is read and OUDS considers wether or not Liquid Glass is enabled.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" stils exists but the app is compiled with Xcode 26.","type":"text"},{"text":" ","type":"text"},{"text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and OUDS cannot only rely on the OS version.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, this ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","type":"reference","isActive":true},{"text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"**You must use this ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" with care, and only if you are using Xcode 26 and  ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" to YES **.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer build with Xcode 27 without the ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":"  flag.","type":"text"}],"type":"paragraph"},{"code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}],"type":"strong"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside","name":"Since"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscompone