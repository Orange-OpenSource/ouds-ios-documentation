{"sections":[],"abstract":[{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLegacyLayoutModifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by OUDS."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 26, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" flag is read and OUDS considers wether or not Liquid Glass is enabled."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The edge case is when the OS version is 27, the flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and OUDS cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier"},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":"  flag."}]},{"type":"codeListing","syntax":"swift","code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}]}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"name":"Since"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/init()"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/body(content:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/docum