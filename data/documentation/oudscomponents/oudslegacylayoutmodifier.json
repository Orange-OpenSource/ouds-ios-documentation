{"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" flag is read and OUDS considers wether or not Liquid Glass is enabled.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" stils exists but the app is compiled with Xcode 26.","type":"text"},{"text":" ","type":"text"},{"text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and OUDS cannot only rely on the OS version.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, this ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","isActive":true,"type":"reference"},{"text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"**You must use this ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" with care, and only if you are using Xcode 26 and  ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" to YES **.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer build with Xcode 27 without the ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":"  flag.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["  OUDSTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(OUDSLegacyLayoutModifier())"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars","type":"text"}],"type":"strong"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}],"name":"Since"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudslegacylayoutmodifier"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/init()"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/body(content:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/ViewModifier-Implementations"]}],"schemaV