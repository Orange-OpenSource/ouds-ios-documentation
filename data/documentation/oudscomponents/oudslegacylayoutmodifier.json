\/oudscomponents","kind":"symbol","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection","title":"Components"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier":{"type":"topic","role":"symbol","abstract":[{"code":"ViewModifier","type":"codeVoice"},{"text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.","type":"text"}],"url":"\/documentation\/oudscomponents\/oudslegacylayoutmodifier","navigatorTitle":[{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLegacyLayoutModifier","kind":"identifier"}],"title":"OUDSLegacyLayoutModifier"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier/ViewModifier-Implementations":{"type":"topic","role":"collectionGroup","abstract":[],"url":"\/documentation\/oudscomponents\/oudslegacylayoutmodifier\/viewmodifier-implementations","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLegacyLayoutModifier\/ViewModifier-Implementations","kind":"article","title":"ViewModifier Implementations"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLegacyLayoutModifier/body(content:)":{"type":"topic","role":"symbol","abstract":[{"type