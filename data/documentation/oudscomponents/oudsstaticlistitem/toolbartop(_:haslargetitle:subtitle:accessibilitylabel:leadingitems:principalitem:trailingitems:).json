xt","text":"] = { [] }) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"title","content":[{"type":"paragraph","inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}]}]},{"name":"hasLargeTitle","content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":".","type":"text"}]}]}],"name":"subtitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" and the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":" by default, used if no large title nor principal item.","type":"text"}]}],"name":"accessibilityLabel"},{"content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"type":"text","text":" by default."}],"type":"paragraph"}],"name":"leadingItems"},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If set, the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is never displayed."}]}]},{"name":"trailingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the trailing side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"otherwise the top toolbar won’t appear..","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There must be only one "},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}],"kind":"content"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSStaticListItem/toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)":{"kind":"symbol","url":"\/documentation\/ou