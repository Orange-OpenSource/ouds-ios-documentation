[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"inlineContent":[{"type":"text","text":"false"}],"type":"emphasis"},{"text":" by default. If large mode, the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"type":"text","text":" is not displayed for iOS < 26."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Never displayed if "},{"code":"principalItem","type":"codeVoice"},{"type":"text","text":" is not "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":"."}]}]}],"name":"subtitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}],"name":"leadingItems"},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is never displayed."}],"type":"paragraph"}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}],"name":"trailingItems"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The view which contains this ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":" must be placed inside a ","type":"text"},{"type":"codeVoice","code":"NavigationView"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}]},{"inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"code":".navigationSubtitle()","type":"codeVoice"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"text":" ","type":"text"},{"text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead.","type":"text"},{"text":" ","type":"text"},{"text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbar\/toolbartop(_:haslargetitle:subtitle:accessibilitylabel:leadingitems:principalitem:trailingitems:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"kind":"symbol","type":"topic","url":"\/documentation\/oudscomponents\/oudstabbar","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text