e the profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    OUDSActionListItem(","        data: OUDSListItemData(label: .textual(\"SMS credit\")),","        trailing: .slot {","            OUDSCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Refill the credit","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    OUDSActionListItem(","        data: OUDSListItemData(","            label: \"Settings\",","            textSlot: .init { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Perform the action","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    OUDSActionListItem(","        data: OUDSListItemData(","            label: \"Profile\",","            bottomSlot: .init { Text(\"Additional info\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Perform the action","    }"],"syntax":"swift"},{"type":"heading","anchor":"Leading-elements","level":2,"text":"Leading elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The leading position (before the texts) accepts one optional element via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemLeading","isActive":true},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(OUDSListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".image(OUDSListItemImage)","type":"codeVoice"},{"type":"text","text":": A static image asset"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".flag(OUDSListItemFlag)"},{"type":"text","text":": A country flag image"}