S"]}],"kind":"declarations"},{"parameters":[{"name":"title","content":[{"inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" must be displayed in large mode or not, ","type":"text"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}],"name":"hasLargeTitle"},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" if iOS 26+, "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default. "},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":".","type":"text"}],"type":"strong"}]}]},{"name":"accessibilityLabel","content":[{"inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" and the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},