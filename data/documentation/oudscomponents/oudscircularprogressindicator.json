{"sections":[],"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"modules":[{"name":"Components"}],"role":"symbol","externalID":"s:14OUDSComponents29OUDSCircularProgressIndicatorV","navigatorTitle":[{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"platforms":[{"name":"iOS","deprecated":false,"beta":false,"introducedAt":"15.0","unavailable":false},{"name":"macOS","deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false},{"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0","unavailable":false},{"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"11.0","unavailable":false}],"title":"OUDSCircularProgressIndicator","symbolKind":"struct"},"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body"],"generated":true},{"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscircularprogressindicator"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Variants","type":"heading","anchor":"Variants"},{"type":"paragraph","inlineContent":[{"text":"Two variants are provided:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"text":": the caller provides a ","type":"text"},{"type":"codeVoice","code":"progress"},{"text":" value in ","type":"text"},{"type":"codeVoice","code":"[0, 1]"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%.","type":"text"},{"text":" ","type":"text"},{"text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty.","type":"text"},{"text":" ","type":"text"},{"text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g.","type":"text"},{"text":" ","type":"text"},{"text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"},{"text":" ","type":"text"},{"text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Statuses","text":"Statuses","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Neutral"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Positive","type":"text"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Gap-size","type":"heading","text":"Gap size"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"type":"text","text":": standard gap between the indicator and the track (about 14° of arc)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}]},{"text":"Track","level":2,"anchor":"Track","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear"},{"type":"text","text":" "},{"type":"text","text":"structure. The track helps define the full range of progress and makes the value easier to read."}]}]},{"content":[{"inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Animation (determinate mode only)","level":2,"anchor":"Animation-determinate-mode-only","type":"heading"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the determinate indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" to the target","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display, and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":". When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" flag."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode.","type":"text"}]},{"text":"Code samples","level":2,"anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    OUDSCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    OUDSCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    OUDSCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    OUDSCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Indeterminate","    OUDSCircularProgressIndicator()","    OUDSCircularProgressIndicator(status: .info)"],"type":"codeListing"},{"anchor":"Accessibility-considerations","level":2,"type":"heading","text":"Accessibility considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"text":" mode, the view exposes the current progress as an accessibility value (percentage) so that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"type":"emphasis","inlineContent":[{"text":"“75 percent”","type":"text"}]},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that assistive"},{"type":"text","text":" "},{"type":"text","text":"technologies know the value is changing."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"text":"Full Keyboard Access","type":"text"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"type":"codeVoice","code":".isStaticText"},{"text":" ","type":"text"},{"text":"trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"text":") — and therefore","type":"text"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Colored surfaces","anchor":"Colored-surfaces"},{"inlineContent":[{"type":"text","text":"When placed on an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":", the indicator switches to a "},{"inlineContent":[{"text":"monochrome","type":"text"}],"type":"strong"},{"type":"text","text":" rendering, the "},{"code":"status","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Design-documentation","text":"Design documentation"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/unified-design-system.orange.com"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Themes-rendering","text":"Themes rendering"},{"type":"heading","level":3,"anchor":"Orange","text":"Orange"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Orange"}],"type":"paragraph"},{"anchor":"Orange-Compact","type":"heading","level":3,"text":"Orange Compact"},{"inlineContent":[{"identifier":"component_progress_indicator_circular_OrangeCompact","type":"image"}],"type":"paragraph"},{"anchor":"Sosh","type":"heading","level":3,"text":"Sosh"},{"inlineContent":[{"identifier":"component_progress_indicator_circular_Sosh","type":"image"}],"type":"paragraph"},{"anchor":"Wireframe","type":"heading","level":3,"text":"Wireframe"},{"inlineContent":[{"identifier":"component_progress_indicator_circular_Wireframe","type":"image"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.0.0 (Figma component design version)"}]}],"style":"note","type":"aside","name":"Version"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"type":"aside","style":"note"}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"kind":"symbol","title":"OUDSColoredSurface","navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","role":"symbol","url":"\/documentation\/oudscomponents\/oudscoloredsurface","type":"topic","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSColoredSurface"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator