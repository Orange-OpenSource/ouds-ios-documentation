{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"]}],"sections":[],"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Useful when you need more visual focus or when space is limited."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscircularprogressindicator"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"]},{"kind":"content","content":[{"anchor":"Variants","text":"Variants","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two variants are provided:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Determinate","type":"text"}],"type":"strong"},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"type":"text","text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive."}]}]}]},{"anchor":"Statuses","text":"Statuses","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Neutral","type":"text"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Accent","type":"text"}],"type":"strong"},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Info","type":"text"}],"type":"strong"},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}]}]}]},{"anchor":"Gap-size","text":"Gap size","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"type":"text","text":": standard gap between the indicator and the track (about 14° of arc)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"small","type":"text"}],"type":"strong"},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}]},{"anchor":"Track","text":"Track","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear"},{"type":"text","text":" "},{"type":"text","text":"structure. The track helps define the full range of progress and makes the value easier to read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}]}]}]},{"anchor":"Animation-determinate-mode-only","text":"Animation (determinate mode only)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (default), the determinate indicator progressively fills from "},{"code":"0","type":"codeVoice"},{"type":"text","text":" to the target"},{"type":"text","text":" "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" on first display, and animates any subsequent change of "},{"code":"progress","type":"codeVoice"},{"type":"text","text":". When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" flag."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}]},{"anchor":"Helper-text","text":"Helper text","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional text displayed below the circular indicator to provide context or additional information."},{"type":"text","text":" "},{"type":"text","text":"The helper text is always centered under the indicator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType"},{"type":"text","text":" which offers two variants:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".description(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Displays a simple description text without the progress percentage."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".percent(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Displays the progress percentage with an optional description. The percentage"},{"type":"text","text":" "},{"type":"text","text":"value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" parameter is a simple "},{"code":"String?","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    OUDSCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    OUDSCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    OUDSCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    OUDSCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    OUDSCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    OUDSCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    OUDSCircularProgressIndicator()","    OUDSCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    OUDSCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Accessibility-considerations","text":"Accessibility considerations","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}],"type":"strong"},{"type":"text","text":". Example: "},{"inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage) so that"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that assistive"},{"type":"text","text":" "},{"type":"text","text":"technologies know the value is changing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator never captures "},{"inlineContent":[{"text":"Full Keyboard Access","type":"text"}],"type":"strong"},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"type":"codeVoice","code":".isStaticText"},{"type":"text","text":" "},{"type":"text","text":"trait is used."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}]}]}]},{"anchor":"Colored-surfaces","text":"Colored surfaces","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When placed on an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface"},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"text":"monochrome","type":"text"}]},{"type":"text","text":" rendering, the "},{"code":"status","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-circular-progress-indicator"}]},{"anchor":"Themes-rendering","text":"Themes rendering","type":"heading","level":2},{"anchor":"Orange","text":"Orange","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Orange"}]},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_OrangeCompact"}]},{"anchor":"Sosh","text":"Sosh","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Sosh"}]},{"anchor":"Wireframe","text":"Wireframe","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Wireframe"}]},{"style":"note","type":"aside","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}]}]},{"style":"note","type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}]}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"Components"}],"role":"symbol","platforms":[{"unavailable":false,"introducedAt":"15.0","name":"iOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"15.0","name":"iPadOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"15.0","name":"Mac Catalyst","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"13.0","name":"macOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"16.0","name":"tvOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"11.0","name":"watchOS","beta":false,"deprecated":false}],"symbolKind":"struct","externalID":"s:14OUDSComponents29OUDSCircularProgressIndicatorV","title":"OUDSCircularProgressIndicator","navigatorTitle":[{"text":"OUDSCircularProgressIndicator","kind":"identifier"}]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSCom