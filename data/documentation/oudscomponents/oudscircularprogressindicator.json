nd":"text"},{"text":"accessibility","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSAccessibilityConfiguration","preciseIdentifier":"s:14OUDSComponents30OUDSAccessibilityConfigurationV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"title":"init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","abstract":[{"text":"Creates a ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" circular progress indicator.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/init(progress:status:track:gapsize:animated:size:helpertext:accessibility:)"},"component_progress_indicator_circular_Sosh":{"type":"image","identifier":"component_progress_indicator_circular_Sosh","variants":[{"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_Sosh.png","traits":["1x","light"]}],"alt":"A circular progress indicator component in light and dark modes with Sosh theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"type":"topic","role":"symbol","title":"OUDSColoredSurface","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSColoredSurface"}],"abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudscoloredsurface"},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/body":{"url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/body","abstract":[],"type":"topic","fragments":[{"text":"var","kind":"key