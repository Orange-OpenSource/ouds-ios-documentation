{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator"},"sections":[],"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"externalID":"s:14OUDSComponents29OUDSCircularProgressIndicatorV","symbolKind":"struct","roleHeading":"Structure","title":"OUDSCircularProgressIndicator","modules":[{"name":"Components"}],"navigatorTitle":[{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"15.0","beta":false},{"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"13.0","beta":false},{"introducedAt":"16.0","name":"tvOS","beta":false,"deprecated":false,"unavailable":false},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"11.0","beta":false}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"],"anchor":"Type-Properties","title":"Type Properties","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType"],"anchor":"Enumerations","title":"Enumerations","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Variants","anchor":"Variants"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"text":": the caller provides a ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" value in ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%.","type":"text"},{"text":" ","type":"text"},{"text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty.","type":"text"},{"text":" ","type":"text"},{"text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g.","type":"text"},{"text":" ","type":"text"},{"text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"text":": no ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"text":" ","type":"text"},{"text":"Used when the system cannot determine how long the task will take.","type":"text"},{"text":" ","type":"text"},{"text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"},{"text":" ","type":"text"},{"text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Statuses","level":2,"type":"heading","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Neutral","type":"text"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Accent","type":"text"}],"type":"strong"},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Positive","type":"text"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Negative","type":"text"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}]}]}]},{"anchor":"Gap-size","text":"Gap size","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"text":": standard gap between the indicator and the track (about 14° of arc).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"small"}],"type":"strong"},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Track","text":"Track","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear","type":"text"},{"text":" ","type":"text"},{"text":"structure. The track helps define the full range of progress and makes the value easier to read.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Animation-determinate-mode-only","text":"Animation (determinate mode only)","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the determinate indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" to the target","type":"text"},{"type":"text","text":" "},{"code":"progress","type":"codeVoice"},{"text":" on first display, and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the indicator is displayed instantly at its target value with no animation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Animations are always disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled,","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" flag.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Helper text","anchor":"Helper-text"},{"inlineContent":[{"text":"An optional text displayed below the circular indicator to provide context or additional information.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text is always centered under the indicator.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType","isActive":true,"type":"reference"},{"text":" which offers two variants:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".description(_:)"}]},{"text":": Displays a simple description text without the progress percentage.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".percent(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays the progress percentage with an optional description. The percentage"},{"type":"text","text":" "},{"type":"text","text":"value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"text":" mode, the ","type":"text"},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" parameter is a simple "},{"code":"String?","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    OUDSCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    OUDSCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    OUDSCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    OUDSCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    OUDSCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    OUDSCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    OUDSCircularProgressIndicator()","    OUDSCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    OUDSCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"text":". Example: ","type":"text"},{"inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}],"type":"emphasis"}]}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage) so that","type":"text"},{"text":" ","type":"text"},{"text":"VoiceOver reads e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that assistive","type":"text"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The indicator never captures ","type":"text"},{"type":"strong","inlineContent":[{"text":"Full Keyboard Access","type":"text"}]},{"text":" focus, as no interaction is possible on a progress","type":"text"},{"text":" ","type":"text"},{"text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via","type":"text"},{"text":" ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" ","type":"text"},{"text":"trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode, the view is hidden from VoiceOver (","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore","type":"text"},{"text":" ","type":"text"},{"text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the","type":"text"},{"text":" ","type":"text"},{"text":"element focusable would only pollute navigation.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}],"type":"paragraph"}]}]},{"text":"Colored surfaces","level":2,"type":"heading","anchor":"Colored-surfaces"},{"inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"text":"monochrome","type":"text"}],"type":"strong"},{"text":" rendering, the ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","level":2,"type":"heading"},{"inlineContent":[{"identifier":"https:\/\/unified-design-system.orange.com","type":"reference","isActive":true}],"type":"paragraph"},{"level":2,"type":"heading","text":"Themes rendering","anchor":"Themes-rendering"},{"level":3,"type":"heading","text":"Orange","anchor":"Orange"},{"inlineContent":[{"identifier":"component_progress_indicator_circular_Orange","type":"image"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_circular_OrangeCompact","type":"image"}],"type":"paragraph"},{"text":"Sosh","level":3,"anchor":"Sosh","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Sosh"}],"type":"paragraph"},{"text":"Wireframe","level":3,"anchor":"Wireframe","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Wireframe"}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}]}],"name":"Version"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"name":"Since"}]}],"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscircularprogressindicator"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relation