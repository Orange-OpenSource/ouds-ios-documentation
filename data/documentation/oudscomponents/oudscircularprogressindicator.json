"],"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_Orange.png"}],"identifier":"component_progress_indicator_circular_Orange","alt":"A circular progress indicator component in light and dark modes with Orange theme","type":"image"},"component_progress_indicator_circular_OrangeCompact":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_OrangeCompact.png"}],"identifier":"component_progress_indicator_circular_OrangeCompact","alt":"A circular progress indicator component in light and dark modes with Orange Compact theme","type":"image"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"identifier":"ic_folder_categories.png","alt":null,"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/HelperTextType":{"type":"topic","title":"OUDSCircularProgressIndicator.HelperTextType","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperTextType"}],"abstract":[{"text":"The helper text can be added in ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" indicator"}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/helpertexttype","navigatorTitle":[{"kind":"identifier","text":"HelperTextType"}],"role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/init(progress:status:track:gapSize:animated:size:helperText:)":{"role":"symbol","kind":"symbol","abstract":[{"text":"Creates a ","type":"text"},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"text":" circular progress indicator.","type":"text"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/init(progress:status:track:gapsize:animated:size:helpertext:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:)","title":"init(progress:status:track:gapSize:animated:size:helperText:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"progress","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSProgressIndicatorStatus","preciseIdentifier":"s:14OUDSComponents27OUDSProgressIndicatorStatusO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"track","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"gapSize","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSProgressIndicatorGapSize","preciseIdentifier":"s:14OUDSComponents28OUDSProgressIndicatorGapSizeO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"animated","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"helperText"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"OUDSCircularProgressIndicator","preciseIdentifier":"s:14OUDSComponents29OUDSCircularProgressIndicatorV"},{"text":".","kind":"text"},{"kind":"typeIdentifier","text":"HelperTextType","preciseIdentifier":"s:14OUDSComponents29OUDSCircularProgressIndicatorV14HelperTextTypeO"},{"text":"?)","kind":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"title":"OUDSCircularProgressIndicator","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator","type":"topic","abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"kind":"symbol"},"doc://OUDSComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"https://unified-design-system.orange.com":{"titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"identifier":"https:\/\/unified-design-system.orange.com","url":"https:\/\/unified-design-system.orange.com","type":"link","title":"unified-design-system.orange.com"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/body":{"title":"body","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"kind":"symbol","type":"topic","abstract":[],"role":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/body"}}}