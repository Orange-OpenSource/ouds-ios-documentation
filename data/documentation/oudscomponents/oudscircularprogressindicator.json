{"sections":[],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body"],"anchor":"Instance-Properties"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"],"anchor":"Type-Properties"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType"],"anchor":"Enumerations"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","interfaceLanguage":"swift"},"abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"anchor":"Variants","level":2,"text":"Variants","type":"heading"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"type":"text","text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive."}]}]}],"type":"unorderedList"},{"anchor":"Statuses","level":2,"text":"Statuses","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Neutral"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Negative"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}]}]}],"type":"unorderedList"},{"anchor":"Gap-size","level":2,"text":"Gap size","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":": standard gap between the indicator and the track (about 14° of arc)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"small"}]},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}],"type":"unorderedList"},{"anchor":"Track","level":2,"text":"Track","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear"},{"type":"text","text":" "},{"type":"text","text":"structure. The track helps define the full range of progress and makes the value easier to read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}]}]}],"type":"unorderedList"},{"anchor":"Animation-determinate-mode-only","level":2,"text":"Animation (determinate mode only)","type":"heading"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the determinate indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" to the target","type":"text"},{"text":" ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" on first display, and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the indicator is displayed instantly at its target value with no animation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" flag."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}],"type":"paragraph"},{"anchor":"Helper-text","level":2,"text":"Helper text","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the circular indicator to provide context or additional information.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text is always centered under the indicator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType","isActive":true,"type":"reference"},{"type":"text","text":" which offers two variants:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".description(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".percent(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays the progress percentage with an optional description. The percentage"},{"type":"text","text":" "},{"type":"text","text":"value and its "},{"code":"%","type":"codeVoice"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"code":"\"٪75\"","type":"codeVoice"},{"type":"text","text":" in Arabic)."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Code-samples","level":2,"text":"Code samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    OUDSCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    OUDSCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    OUDSCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    OUDSCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    OUDSCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    OUDSCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    OUDSCircularProgressIndicator()","    OUDSCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    OUDSCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"type":"codeListing"},{"anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}]}]},{"content":[{"inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"type":"strong","inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}]},{"type":"text","text":". Example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage) so that"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"type":"text","text":", and is marked with the "},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that assistive","type":"text"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"type":"text","text":"Full Keyboard Access"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"code":".isStaticText","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"trait is used."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode, the view is hidden from VoiceOver (","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}]},{"anchor":"Colored-surfaces","type":"heading","level":2,"text":"Colored surfaces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When placed on an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":", the indicator switches to a "},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"text":" rendering, the ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]},{"anchor":"Design-documentation","type":"heading","level":2,"text":"Design documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/unified-design-system.orange.com","type":"reference"}]},{"text":"Themes rendering","anchor":"Themes-rendering","type":"heading","level":2},{"text":"Orange","anchor":"Orange","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_circular_Orange","type":"image"}]},{"text":"Orange Compact","anchor":"Orange-Compact","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_circular_OrangeCompact","type":"image"}]},{"text":"Sosh","anchor":"Sosh","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_circular_Sosh","type":"image"}]},{"level":3,"anchor":"Wireframe","type":"heading","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_circular_Wireframe","type":"image"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}]}],"name":"Version","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"style":"note","name":"Since","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscircularprogressindicator"]}],"metadata":{"externalID":"s:14OUDSComponents29OUDSCircularProgressIndicatorV","modules":[{"name":"Components"}],"title":"OUDSCircularProgressIndicator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"symbolKind":"struct","role":"symbol","platforms":[{"name":"iOS","beta":false,"introducedAt":"15.0","deprecated":false,"unavailable":false},{"name":"macOS","beta":false,"introducedAt":"13.0","deprecated":false,"unavailable":false},{"name":"tvOS","beta":false,"introducedAt":"16.0","deprecated":false,"unavailable":false},{"name":"visionOS","beta":false,"introducedAt":"1.0","deprecated":false,"unavailable":false},{"name":"watchOS","beta":false,"introducedAt":"11.0","deprecated":false,"unavailable":false}],"navigatorTitle":[{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"roleHeading":"Structure"},"kind":