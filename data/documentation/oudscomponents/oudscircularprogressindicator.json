iewP"]}],"references":{"component_progress_indicator_circular_Orange":{"identifier":"component_progress_indicator_circular_Orange","type":"image","alt":"A circular progress indicator component in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_Orange.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/defaultSize":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/defaultsize","abstract":[{"text":"The default component size (matches the Android reference implementation and Material 3 defaults).","type":"text"}],"type":"topic","title":"defaultSize","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultSize"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier","text":"CGFloat"}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","type":"image","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents":{"role":"collection","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/oudscomponents","title":"Components","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/body":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/body","abstract":[],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body","title":"body","role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator":{"kind":"symbol","role":"symbol","title":"OUDSCircularProgressIndicator","type":"topic","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator","navigatorTitle":[{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Useful when you need more visual focus or when space is limited."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/View-Implementations":{"url":"\/documentation\/oudscomponents\/oudscircularprogressindicator\/view-implementations","type":"topic","abstract":[],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations","kind":"article","role":"collectionGroup","title":"View Implementations"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator/init(status:track:gapSize:size:helperText:accessibility:)":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"status"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents27OUDSProgressIndicatorStatusO","text":"OUDSProgressIndicatorStatus"},{"kind":"text","text":", "},{"kind":"externalParam","text":"track"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"gapSize","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14OUDSComponents28OUDSProgressIndicatorGapSizeO","text":"OUDSProgressIndicatorGapSize","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat"},{"text":", ","kind":"text"},{"text":"helperText","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"accessibility"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents30OUDSAccessibilityConfigurationV","text":"OUDSAccessibilityConfiguration"},{"kind":"text","text":"?)"}],"role":"symbol","abstract":[{"text":"Creates an ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" circular progress indicator.","type":"text"}],"type":"topic","kind":"symbol","title":"init(status:track:gapSize:size:helperText:accessibility:)","url":"\/d