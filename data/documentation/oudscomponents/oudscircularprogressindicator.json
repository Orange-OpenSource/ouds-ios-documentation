e is limited.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","kind":"symbol","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCircularProgressIndicator"}],"title":"OUDSCircularProgressIndicator"},"https://unified-design-system.orange.com":{"type":"link","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}],"identifier":"https:\/\/unified-design-system.orange.com","title":"unified-design-system.orange.com","url":"https:\/\/unified-design-system.orange.com"},"component_progress_indicator_circular_OrangeCompact":{"type":"image","alt":"A circular progress indicator component in light and dark modes with Orange Compact theme","identifier":"component_progress_indicator_circular_OrangeCompact","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_OrangeCompact.png"}]},"component_progress_indicator_circular_Orange":{"identifier":"component_progress_indicator_circular_Orange","alt":"A circular progress indicator component in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_progress_indicator_circular_Orange.png","traits":["1x","light"]}],"type":"image"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"alt":null,"type":"image"}}}