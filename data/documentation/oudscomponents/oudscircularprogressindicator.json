{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscircularprogressindicator"]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"generated":true},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/body"]},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/defaultSize"],"generated":true},{"generated":true,"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/View-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"languages":["swift"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Variants","anchor":"Variants"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": no ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"text":" ","type":"text"},{"text":"Used when the system cannot determine how long the task will take.","type":"text"},{"text":" ","type":"text"},{"text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"},{"text":" ","type":"text"},{"text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Neutral","type":"text"}]},{"text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,","type":"text"},{"text":" ","type":"text"},{"text":"processing, synchronization or background tasks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Positive","type":"text"}]},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"text":": indicates informational or system-related processes (background synchronization, data retrieval).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"text":": indicates progress related to an operation that requires user attention or should be monitored.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Negative","type":"text"}]},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Gap size","anchor":"Gap-size"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"text":": standard gap between the indicator and the track (about 14° of arc).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Track","anchor":"Track"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear","type":"text"},{"text":" ","type":"text"},{"text":"structure. The track helps define the full range of progress and makes the value easier to read.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Animation (determinate mode only)","anchor":"Animation-determinate-mode-only"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the determinate indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to the target"},{"type":"text","text":" "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display, and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":". When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" flag."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Helper text","anchor":"Helper-text"},{"inlineContent":[{"type":"text","text":"An optional text displayed below the circular indicator to provide context or additional information."},{"type":"text","text":" "},{"type":"text","text":"The helper text is always centered under the indicator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator\/HelperTextType","isActive":true},{"type":"text","text":" which offers two variants:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".description(_:)","type":"codeVoice"}]},{"text":": Displays a simple description text without the progress percentage.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".percent(_:)","type":"codeVoice"}]},{"text":": Displays the progress percentage with an optional description. The percentage","type":"text"},{"text":" ","type":"text"},{"text":"value and its ","type":"text"},{"code":"%","type":"codeVoice"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"code":"\"75%\"","type":"codeVoice"},{"text":" in English, ","type":"text"},{"code":"\"75 %\"","type":"codeVoice"},{"text":" in French, ","type":"text"},{"code":"\"٪75\"","type":"codeVoice"},{"text":" in Arabic).","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    OUDSCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    OUDSCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    OUDSCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    OUDSCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    OUDSCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    OUDSCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    OUDSCircularProgressIndicator()","    OUDSCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    OUDSCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}],"type":"strong"},{"text":". Example: ","type":"text"},{"inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage) so that","type":"text"},{"text":" ","type":"text"},{"text":"VoiceOver reads e.g. ","type":"text"},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that assistive","type":"text"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"text":"Full Keyboard Access","type":"text"}],"type":"strong"},{"text":" focus, as no interaction is possible on a progress","type":"text"},{"text":" ","type":"text"},{"text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via","type":"text"},{"text":" ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" ","type":"text"},{"text":"trait is used.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"text":" mode, the view is hidden from VoiceOver (","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore","type":"text"},{"text":" ","type":"text"},{"text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the","type":"text"},{"text":" ","type":"text"},{"text":"element focusable would only pollute navigation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Colored surfaces","anchor":"Colored-surfaces"},{"inlineContent":[{"type":"text","text":"When placed on an "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"type":"text","text":"monochrome"}]},{"type":"text","text":" rendering, the "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Design documentation","anchor":"Design-documentation"},{"inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-circular-progress-indicator","isActive":true}],"type":"paragraph"},{"level":2,"type":"heading","text":"Themes rendering","anchor":"Themes-rendering"},{"level":3,"type":"heading","text":"Orange","anchor":"Orange"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Orange"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Orange Compact","anchor":"Orange-Compact"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_OrangeCompact"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Sosh","anchor":"Sosh"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Sosh"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Wireframe","anchor":"Wireframe"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_circular_Wireframe"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}]}],"type":"aside","name":"Version"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"type":"aside","name":"Since"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"metadata":{"modules":[{"name":"Components"}],"title":"OUDSCircularProgressIndicator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"externalID":"s:14OUDSComponents29OUDSCircularProgressIndicatorV","platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"15.0","beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"introducedAt":"15.0","beta":false,"name":"iPadOS"},{"deprecated":false,"unavailable":false,"introducedAt":"15.0","beta":false,"name":"Mac Catalyst"},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","beta":false,"name":"macOS"},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS"}