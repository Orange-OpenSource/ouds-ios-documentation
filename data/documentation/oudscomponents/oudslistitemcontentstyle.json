umentation\/OUDSComponents\/OUDSListItemContentStyle\/card(_:)","type":"reference","isActive":true},{"type":"text","text":". Cards can be outlined, have a background,"},{"type":"text","text":" "},{"type":"text","text":"or combine these effects only on interaction."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".item(_:)"}],"type":"strong"},{"text":": A standard list item appearance with an optional background and divider,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"defined by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/item(divider:background:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Known-limitation","text":"Known limitation"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"onlyOnInteraction","type":"codeVoice"},{"text":" flag of the ","type":"text"},{"code":"outlined","type":"codeVoice"},{"type":"text","text":" decoration of a card has no action on "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"text":", because","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the item does not propose interaction (e.g. pressed or hover state)"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Code-samples","text":"Code samples"},{"code":["    \/\/ Card style with outline only on interaction","    OUDSNavigationListItem(data: OUDSListItemData(label: .textual(\"Label\")))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: true))","","    \/\/ Card style with an outlined border on all states","    OUDSNavigationListItem(data: OUDSListItemData(label: .textual(\"Label\")))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: false))","","    \/\/ Card style with divider, background","    OUDSNavigationListItem(data