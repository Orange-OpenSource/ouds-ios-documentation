:"text","text":"or combine these effects only on interaction."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".item(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A standard list item appearance with an optional background and divider,"},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/item(divider:background:)","type":"reference","isActive":true},{"text":".","type":"text"}]}]}]},{"anchor":"Known-limitation","type":"heading","level":2,"text":"Known limitation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"onlyOnInteraction","type":"codeVoice"},{"type":"text","text":" flag of the "},{"code":"outlined","type":"codeVoice"},{"type":"text","text":" decoration of a card has no action on "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":", because"},{"type":"text","text":" "},{"type":"text","text":"the item does not propose interaction (e.g. pressed or hover state)"}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Card style with outline only on interaction","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: true))","","    \/\/ Card style with an outlined border on all states","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: false))","","    \/\/ Card style with divider, background","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .standard(divider: true, background: true))","","    \/\/ Card style divider and without background","    OUDS