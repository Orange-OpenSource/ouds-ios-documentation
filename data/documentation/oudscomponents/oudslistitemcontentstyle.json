{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Defines the visual style of a list item such as "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true,"type":"reference"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemContentStyle","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The style controls the border, divider, and background appearance of list items."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListContentStyle(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemStyle(divider:background:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListCardStyle(_:)"},{"type":"text","text":" view modifiers to apply the style on list items."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Cases","anchor":"Cases"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".card(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A card-like appearance with various sub-styles (decoration) defined by","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/card(_:)","type":"reference"},{"text":". Cards can be outlined, have a background,","type":"text"},{"text":" ","type":"text"},{"text":"or combine these effects only on interaction.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".item(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A standard list item appearance with an optional background and divider,","type":"text"},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/item(divider:background:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Known limitation","anchor":"Known-limitation"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"onlyOnInteraction"},{"type":"text","text":" flag of the "},{"type":"codeVoice","code":"outlined"},{"type":"text","text":" decoration of a card has no action on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":", because"},{"type":"text","text":" "},{"type":"text","text":"the item does not propose interaction (e.g. pressed or hover state)"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Card style with outline only on interaction","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: true))","","    \/\/ Card style with an outlined border on all states","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .outlined(onInteractionOnly: false))","","    \/\/ Card style with divider, background","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .standard(divider: true, background: true))","","    \/\/ Card style divider and without background","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListCardStyle(decoration: .standard(divider: true, background: false))","","    \/\/ Item style with background and divider","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListItemStyle(divider: true, .background: true)","","    \/\/ Item style with divider and without background","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListItemStyle(divider: true, .background: false)","","    \/\/ Using global modifier","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListContentStyle(.card(.outlined))","","    OUDSNavigationListItem(data: OUDSListItemData(label: \"Label\"))","        .oudsListContentStyle(.item(divider: true, background: false))"]},{"name":"Since","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"type":"aside"}]}],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/card(_:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/item(divider:background:)"],"anchor":"Enumeration-Cases","generated":true},{"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/CardDecoration"],"anchor":"Enumerations","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle"},"kind":"symbol","sections":[],"variants":[{"traits":