pe":"paragraph"}]},{"name":"hasLargeTitle","content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"false"}]},{"text":" by default. If large mode, the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" is not displayed for iOS < 26.","type":"text"}]}]},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"type":"text","text":"Never displayed if "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}]}]}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" and the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default, used if no large title nor principal item."}]}]},{"name":"leadingItems","content":[{"inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{