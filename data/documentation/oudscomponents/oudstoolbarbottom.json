{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstoolbarbottom"]}],"abstract":[{"type":"text","text":"The bottom toolbar is a kind of navigation bar component used to display leading and trailing actions"},{"type":"text","text":" "},{"type":"text","text":"at the bottom of the screen when supported."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarBottom","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"toolBarBottom"},{"type":"text","text":" View helper applies a SwiftUI toolbar configuration."}]},{"level":2,"text":"Platform considerations","anchor":"Platform-considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Not available on watchOS, tvOS and macOS","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Guidelines","level":2,"anchor":"Guidelines"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Test the use of the ","type":"text"},{"code":"toolBarBottom","type":"codeVoice"},{"text":" for both iOS with Liquid Glass and not Liquid Glass","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If you use both an  ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"toolBarBottom"},{"text":", the toolbar will be above the tabbar for iOS l