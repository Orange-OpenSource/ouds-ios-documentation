{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The bottom toolbar is a kind of navigation bar component used to display leading and trailing actions"},{"type":"text","text":" "},{"type":"text","text":"at the bottom of the screen when supported."}],"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarBottom\/init(groupedItems:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarBottom\/init(leadingItems:trailingItems:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarBottom\/body(content:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarBottom\/ViewModifier-Implementations"]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarBottom","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarBottom","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"code":"toolBarBottom","type":"codeVoice"},{"text":" View helper applies a SwiftUI toolbar configuration.","type":"text"}],"type":"paragraph"},{"text":"Platform considerations","type":"heading","anchor":"Platform-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent"