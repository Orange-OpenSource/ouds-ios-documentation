{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"text":"The bottom toolbar is a kind of navigation bar component used to display leading and trailing actions","type":"text"},{"text":" ","type":"text"},{"text":"at the bottom of the screen when supported.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarBottom","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"codeVoice","code":"toolBarBottom"},{"type":"text","text":" View helper applies a SwiftUI toolbar configuration."}],"type":"paragraph"},{"text":"Platform considerations","level":2,"type":"heading","anchor":"Platform-considerations"},{"items":[{"content":[{"inlineContent":[{"text":"Available on iOS, iPadOS, and visionOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Not available on watchOS, tvOS and macOS","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Guidelines","level":2,"type":"heading","anchor":"Guidelines"},{"items":[{"content":[{"inlineContent":[{"text":"Test the use of the ","type":"text"},{"code":"toolBarBottom","type":"codeVoice"},{"text":" for both iOS with Liquid Glass and not Liquid Glass","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If you use both an  ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference"},{"text":" with the ","type":"text"},{"code":"toolBarBottom","type":"codeVoice"},{"text":", the toolbar will be above the tabbar for iOS lower than 26, ","type":"text"},{"inlineContent":[{"text":"not recommended","ty