{ [] }) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The toolbar title. Prefer a non-empty string."}],"type":"paragraph"}],"name":"title"},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":" is not displayed for iOS < 26.","type":"text"}]}],"name":"hasLargeTitle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"strong"}]}],"name":"subtitle"},{"content":[{"inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"text":" and the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default, used if no large title nor princip