{"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Item"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/init(type:textStyle:isBold:items:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/body"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/TextStyle","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Type","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/UnorderedAsset"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSBulletList"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBulletList"}],"roleHeading":"Structure","externalID":"s:14OUDSComponents14OUDSBulletListV","modules":[{"name":"Components"}],"platforms":[{"unavailable":false,"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"13.0","name":"macOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"16.0","name":"tvOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"11.0","name":"watchOS","deprecated":false,"beta":false}],"role":"symbol","title":"OUDSBulletList"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet."},{"type":"text","text":" "},{"type":"text","text":"Bullet list is also known as "},{"type":"emphasis","inlineContent":[{"text":"Unordered list","type":"text"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"Ordered list","type":"text"}]},{"type":"text","text":" and is not an interactive element by default."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBulletList","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/ContentDisplay"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"paragraph","inlineContent":[{"text":"Three types are proposed:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unordered (by default)"}],"type":"strong"},{"text":": Collects related items that don’t need to be in a specific order or sequence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ordered"}],"type":"strong"},{"text":": Collects related items with numeric order or sequence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Bare"}],"type":"strong"},{"text":": An unordered list without any bullets or alphanumeric sequence.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Types can be mixed in list, but must be identical for the same ","type":"text"},{"type":"codeVoice","code":"OUDSBulletList.NestedLevel"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Levels","level":2,"text":"Levels"},{"type":"paragraph","inlineContent":[{"text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level.","type":"text"},{"text":" ","type":"text"},{"text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order.","type":"text"},{"text":" ","type":"text"},{"text":"Three levels are maximum.","type":"text"}]},{"type":"heading","anchor":"Text-Style","level":2,"text":"Text Style"},{"type":"paragraph","inlineContent":[{"text":"List can be used with different font sizes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Body Large"}],"type":"strong"},{"text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Body Medium"}],"type":"strong"},{"text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Cases-forbidden-by-design","level":2,"text":"Cases forbidden by design"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"it is not allowed to have a depth of items greater than 3","type":"text"}]}]},{"type":"heading","anchor":"Internationalisation-considerations","level":2,"text":"Internationalisation considerations"},{"type":"paragraph","inlineContent":[{"text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth","type":"text"},{"text":" ","type":"text"},{"text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used","type":"text"},{"text":" ","type":"text"},{"text":"in middle-east arabic countries and for official documents.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the OUDS ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels.","type":"text"}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"type":"codeListing","code":["       \/\/ 1. Unordered list with bullets","       OUDSBulletList {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       OUDSBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       OUDSBulletList(type: .bare) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\") {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 4. Items with localized or rich texts, through `OUDSTextualContent`","       OUDSBulletList {","           OUDSBulletList.Item(\"Raw text\") \/\/ Same as .raw(\"Raw text\")","           OUDSBulletList.Item(.localized(\"item_label\", bundle: Bundle.module))","           OUDSBulletList.Item(.rich(AttributedString(markdown: \"A **rich** text\"))) \/\/ Manage in your side errors for init","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }"],"syntax":"swift"},{"type":"heading","anchor":"Rich-text-recommendations","level":2,"text":"Rich text recommendations"},{"type":"paragraph","inlineContent":[{"text":"The text of an item is an ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"text":": a raw ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" (a string literal is enough), a localized","type":"text"},{"text":" ","type":"text"},{"text":"string with ","type":"text"},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"text":" or a rich text with ","type":"text"},{"type":"codeVoice","code":".rich(_:)"},{"text":" and an ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Rich text can be applied for bullet list whatever the ","type":"text"},{"type":"codeVoice","code":"isBold"},{"text":" flag is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined links must be bold.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it like Orange brand.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}]},{"type":"heading","anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}]},{"type":"heading","anchor":"Design-documentation","level":2,"text":"Design documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-bullet-list","isActive":true}]},{"type":"heading","anchor":"Themes-rendering","level":2,"text":"Themes rendering"},{"type":"heading","anchor":"Orange","level":3,"text":"Orange"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Orange"}]},{"type":"heading","anchor":"Orange-Compact","level":3,"text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_OrangeCompact"}]},{"type":"heading","anchor":"Sosh","level":3,"text":"Sosh"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Sosh"}]},{"type":"heading","anchor":"Wireframe","level":3,"text":"Wireframe"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Wireframe"}]},{"type":"aside","style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.1.0 (Figma component design version)","type":"text"}]}]},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsbulletlist"]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextualContent":{"abstract":[{"type":"text","text":"A textual value that can be either a plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a styled "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","title":"OUDSTextualContent","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSC