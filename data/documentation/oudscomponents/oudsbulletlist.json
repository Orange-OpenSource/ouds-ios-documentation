{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","title":"OUDSBulletList","platforms":[{"deprecated":false,"name":"iOS","beta":false,"unavailable":false,"introducedAt":"15.0"},{"deprecated":false,"name":"iPadOS","beta":false,"unavailable":false,"introducedAt":"15.0"},{"deprecated":false,"name":"Mac Catalyst","beta":false,"unavailable":false,"introducedAt":"15.0"},{"deprecated":false,"name":"macOS","beta":false,"unavailable":false,"introducedAt":"13.0"},{"deprecated":false,"name":"tvOS","beta":false,"unavailable":false,"introducedAt":"16.0"},{"deprecated":false,"name":"visionOS","beta":false,"unavailable":false,"introducedAt":"1.0"},{"deprecated":false,"name":"watchOS","beta":false,"unavailable":false,"introducedAt":"11.0"}],"modules":[{"name":"Components"}],"symbolKind":"struct","externalID":"s:14OUDSComponents14OUDSBulletListV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBulletList"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSBulletList"}]},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships"}],"kind":"symbol","identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList","interfaceLanguage":"swift"},"abstract":[{"text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Bullet list is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Unordered list"}]},{"type":"text","text":" or "},{"inlineContent":[{"type":"text","text":"Ordered list"}],"type":"emphasis"},{"type":"text","text":" and is not an interactive element by default."}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsbulletlist"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBulletList","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/ContentDisplay"],"kind":"mentions"},{"content":[{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three types are proposed:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unordered (by default)"}],"type":"strong"},{"text":": Collects related items that don’t need to be in a specific order or sequence.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ordered"}],"type":"strong"},{"text":": Collects related items with numeric order or sequence.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Bare","type":"text"}]},{"text":": An unordered list without any bullets or alphanumeric sequence.","type":"text"}]}]}]},{"inlineContent":[{"text":"Types can be mixed in list, but must be identical for the same ","type":"text"},{"code":"OUDSBulletList.NestedLevel","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Levels","anchor":"Levels","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level.","type":"text"},{"text":" ","type":"text"},{"text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Three levels are maximum."}]},{"type":"heading","level":2,"text":"Text Style","anchor":"Text-Style"},{"type":"paragraph","inlineContent":[{"text":"List can be used with different font sizes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Body Large","type":"text"}],"type":"strong"},{"text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Body Medium","type":"text"}],"type":"strong"},{"type":"text","text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences."}]}]}],"type":"unorderedList"},{"level":2,"text":"Cases forbidden by design","type":"heading","anchor":"Cases-forbidden-by-design"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"it is not allowed to have a depth of items greater than 3","type":"text"}]}],"type":"paragraph"},{"level":2,"text":"Internationalisation considerations","type":"heading","anchor":"Internationalisation-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth"},{"type":"text","text":" "},{"type":"text","text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values."}]},{"type":"paragraph","inlineContent":[{"text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used","type":"text"},{"text":" ","type":"text"},{"text":"in middle-east arabic countries and for official documents.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the OUDS ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels.","type":"text"}]},{"type":"heading","anchor":"Code-samples","text":"Code samples","level":2},{"type":"codeListing","syntax":"swift","code":["       \/\/ 1. Unordered list with bullets","       OUDSBulletList {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       OUDSBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       OUDSBulletList(type: .bare) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\") {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 4. Items with localized or rich texts, through `OUDSTextualContent`","       OUDSBulletList {","           OUDSBulletList.Item(\"Raw text\") \/\/ Same as .raw(\"Raw text\")","           OUDSBulletList.Item(.localized(\"item_label\", bundle: Bundle.module))","           OUDSBulletList.Item(.rich(AttributedString(markdown: \"A **rich** text\"))) \/\/ Manage in your side errors for init","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }"]},{"type":"heading","anchor":"Rich-text-recommendations","text":"Rich text recommendations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text of an item is an "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":": a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":" (a string literal is enough), a localized"},{"type":"text","text":" "},{"type":"text","text":"string with "},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"type":"text","text":" or a rich text with "},{"type":"codeVoice","code":".rich(_:)"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Rich text can be applied for bullet list whatever the "},{"type":"codeVoice","code":"isBold"},{"type":"text","text":" flag is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"Underlined links must be bold."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations","type":"heading"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Design-documentation","text":"Design documentation","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-bullet-list","type":"reference"}],"type":"paragraph"},{"level":2,"anchor":"Themes-rendering","text":"Themes rendering","type":"heading"},{"level":3,"anchor":"Orange","text":"Orange","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_bullet_list_Orange"}],"type":"paragraph"},{"level":3,"anchor":"Orange-Compact","text":"Orange Compact","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_bullet_list_OrangeCompact"}],"type":"paragraph"},{"level":3,"anchor":"Sosh","text":"Sosh","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_bullet_list_Sosh"}],"type":"paragraph"},{"level":3,"anchor":"Wireframe","tex