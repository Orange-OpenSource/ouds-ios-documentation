{"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Item"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/init(type:textStyle:isBold:items:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/body"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/TextStyle","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Type","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/UnorderedAsset"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations"],"generated":true}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet.","type":"text"},{"type":"text","text":" "},{"text":"Bullet list is also known as ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Unordered list"}]},{"text":" or ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Ordered list","type":"text"}]},{"text":" and is not an interactive element by default.","type":"text"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsbulletlist"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBulletList"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/ContentDisplay"],"kind":"mentions"},{"content":[{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"inlineContent":[{"text":"Three types are proposed:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Unordered (by default)","type":"text"}]},{"type":"text","text":": Collects related items that don’t need to be in a specific order or sequence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ordered"}]},{"type":"text","text":": Collects related items with numeric order or sequence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Bare","type":"text"}]},{"type":"text","text":": An unordered list without any bullets or alphanumeric sequence."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Types can be mixed in list, but must be identical for the same ","type":"text"},{"type":"codeVoice","code":"OUDSBulletList.NestedLevel"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Levels","anchor":"Levels","type":"heading","level":2},{"inlineContent":[{"text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level.","type":"text"},{"text":" ","type":"text"},{"text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order.","type":"text"},{"text":" ","type":"text"},{"text":"Three levels are maximum.","type":"text"}],"type":"paragraph"},{"text":"Text Style","anchor":"Text-Style","type":"heading","level":2},{"inlineContent":[{"text":"List can be used with different font sizes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Body Large","type":"text"}]},{"type":"text","text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Body Medium","type":"text"}]},{"type":"text","text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences."}]}]}],"type":"unorderedList"},{"text":"Cases forbidden by design","anchor":"Cases-forbidden-by-design","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"it is not allowed to have a depth of items greater than 3"}],"type":"strong"}],"type":"paragraph"},{"text":"Internationalisation considerations","anchor":"Internationalisation-considerations","type":"heading","level":2},{"inlineContent":[{"text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth","type":"text"},{"text":" ","type":"text"},{"text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used","type":"text"},{"text":" ","type":"text"},{"text":"in middle-east arabic countries and for official documents.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the OUDS ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels.","type":"text"}],"type":"paragraph"},{"text":"Code samples","anchor":"Code-samples","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["       \/\/ 1. Unordered list with bullets","       OUDSBulletList {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       OUDSBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       OUDSBulletList(type: .bare) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\") {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 4. Items with localized or rich texts, through `OUDSTextualContent`","       OUDSBulletList {","           OUDSBulletList.Item(\"Raw text\") \/\/ Same as .raw(\"Raw text\")","           OUDSBulletList.Item(.localized(\"item_label\", bundle: Bundle.module))","           OUDSBulletList.Item(.rich(AttributedString(markdown: \"A **rich** text\"))) \/\/ Manage in your side errors for init","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }"]},{"text":"Rich text recommendations","anchor":"Rich-text-recommendations","type":"heading","level":2},{"inlineContent":[{"text":"The text of an item is an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference","isActive":true},{"text":": a raw ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" (a string literal is enough), a localized","type":"text"},{"text":" ","type":"text"},{"text":"string with ","type":"text"},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"text":" or a rich text with ","type":"text"},{"type":"codeVoice","code":".rich(_:)"},{"text":" and an ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Rich text can be applied for bullet list whatever the ","type":"text"},{"type":"codeVoice","code":"isBold"},{"text":" flag is.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined links must be bold.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it like Orange brand.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}],"type":"paragraph"},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading","level":2},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"text":"Design documentation","anchor":"Design-documentation","type":"heading","level":2},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-bullet-list","type":"reference","isActive":true}],"type":"paragraph"},{"text":"Themes rendering","anchor":"Themes-rendering","type":"heading","level":2},{"text":"Orange","anchor":"Orange","type":"heading","level":3},{"inlineContent":[{"identifier":"component_bullet_list_Orange","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","anchor":"Orange-Compact","type":"heading","level":3},{"inlineContent":[{"identifier":"component_bullet_list_OrangeCompact","type":"image"}],"type":"paragraph"},{"text":"Sosh","anchor":"Sosh","type":"heading","level":3},{"inlineContent":[{"identifier":