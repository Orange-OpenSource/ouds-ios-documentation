{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Item"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/init(type:textStyle:isBold:items:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/body"],"generated":true},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/TextStyle","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/Type","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/UnorderedAsset"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBulletList\/View-Implementations"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBulletList"}],"platforms":["macOS"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/ContentDisplay"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Types","text":"Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three types are proposed:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unordered (by default)"}]},{"type":"text","text":": Collects related items that don’t need to be in a specific order or sequence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ordered"}]},{"type":"text","text":": Collects related items with numeric order or sequence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bare"}]},{"type":"text","text":": An unordered list without any bullets or alphanumeric sequence."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types can be mixed in list, but must be identical for the same "},{"type":"codeVoice","code":"OUDSBulletList.NestedLevel"},{"type":"text","text":"."}]},{"level":2,"type":"heading","anchor":"Levels","text":"Levels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level."},{"type":"text","text":" "},{"type":"text","text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order."},{"type":"text","text":" "},{"type":"text","text":"Three levels are maximum."}]},{"level":2,"type":"heading","anchor":"Text-Style","text":"Text Style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List can be used with different font sizes:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body Large"}]},{"type":"text","text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body Medium"}]},{"type":"text","text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Cases-forbidden-by-design","text":"Cases forbidden by design"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"it is not allowed to have a depth of items greater than 3","type":"text"}]}]},{"level":2,"type":"heading","anchor":"Internationalisation-considerations","text":"Internationalisation considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth"},{"type":"text","text":" "},{"type":"text","text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet."},{"type":"text","text":" "},{"type":"text","text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used"},{"type":"text","text":" "},{"type":"text","text":"in middle-east arabic countries and for official documents."},{"type":"text","text":" "},{"type":"text","text":"Thus the OUDS ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels."}]},{"level":2,"type":"heading","anchor":"Code-samples","text":"Code samples"},{"syntax":"swift","code":["       \/\/ 1. Unordered list with bullets","       OUDSBulletList {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       OUDSBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       OUDSBulletList(type: .bare) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\")","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\") {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       OUDSBulletList(type: .ordered) {","           OUDSBulletList.Item(\"Label 1\") {","               OUDSBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   OUDSBulletList.Item(\"Label 1.1.1\")","                   OUDSBulletList.Item(\"Label 1.1.2\")","               }","           }","           OUDSBulletList.Item(\"Label 2\")","           OUDSBulletList.Item(\"Label 3\")","       }"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Rich-text-recommendations","text":"Rich text recommendations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be applied for bullet list whatever the "},{"type":"codeVoice","code":"isBold"},{"type":"text","text":" flag is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"Underlined links must be bold."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it like Orange brand."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"level":2,"type":"heading","anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"level":2,"type":"heading","anchor":"Design-documentation","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-bullet-list"}]},{"level":2,"type":"heading","anchor":"Themes-rendering","text":"Themes rendering"},{"level":3,"type":"heading","anchor":"Orange","text":"Orange"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Orange"}]},{"level":3,"type":"heading","anchor":"Orange-Compact","text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_OrangeCompact"}]},{"level":3,"type":"heading","anchor":"Sosh","text":"Sosh"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Sosh"}]},{"level":3,"type":"heading","anchor":"Wireframe","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_bullet_list_Wireframe"}]},{"name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.1.0 (Figma component design version)","type":"text"}]}],"type":"aside","style":"note"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0","type":"text"}]}],"type":"aside","style":"note"}]}],"metadata":{"platforms":[{"beta":false,"unavailable":false,"introducedAt":"15.0","deprecated":false,"name":"iOS"},{"beta":false,"unavailable":false,"introducedAt":"13.0","deprecated":false,"name":"macOS"},{"beta":false,"unavailable":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS"},{"beta":false,"unavailable":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS"},{"beta":false,"unavailable":false,"introducedAt":"11.0","deprecated":false,"name":"watchOS"}],"externalID":"s:14OUDSComponents14OUDSBulletListV","roleHeading":"Structure","symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSBulletList"}],"modules":[{"name":"Components"}],"title":"OUDSBulletList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBulletList"}]},"variants":[{"paths":["\/documentation\/oudscomponents\/oudsbulletlist"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet."},{"type":"text","text":" "},{"type":"text","text":"Bullet list is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Unordered list"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Ordered list"}]},{"type":"text","text":" and is not an inter