{"abstract":[{"text":"Represents the main content displayed within a list item component such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference"},{"text":".","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},"kind":"symbol","topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Slot"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-5cmua","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-8krhc","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Label"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemdata"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemData"}]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","isActive":true},{"text":" groups all the text-based information that a list item can display:","type":"text"},{"text":" ","type":"text"},{"text":"a mandatory label (an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" or a custom ","type":"text"},{"code":"View","type":"codeVoice"},{"text":") and optional","type":"text"},{"text":" ","type":"text"},{"text":"description, overline, extra label and helper text. Every textual field accepts a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"a localized string or an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" through ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":", plus optional slots.","type":"text"}]},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Minimal: label only (string literal is implicitly converted to .textual(.raw))","    let data = OUDSListItemData(label: .textual(\"Label\"))","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: .textual(\"Label\", isBold: true))","","    \/\/ Localized label","    let data = OUDSListItemData(label: .textual(.localized(\"label.key\")))","","    \/\/ Styled rich label (user-controlled font, color, markdown…)","    let data = OUDSListItemData(","        label: .textual(.rich(AttributedString.from(text: \"Label\",","                                                        foregroundColor: .orange,","                                                        font: .headline)))","    )","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content (string literals auto-convert to .raw OUDSTextualContent)","    let data = OUDSListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Mixed raw \/ rich text per field — any textual field can be styled","    let data = OUDSListItemData(","        label: \"Label\",","        description: .rich(myStyledDescription),","        overline: \"Plain overline\",","        helperText: .rich(myStyledHelper)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"]},{"anchor":"Custom-view-label","text":"Custom view label","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When providing a custom view as label:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Bold styling is not applicable; all styling is controlled by the provided view."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must provide an "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"type":"codeVoice","code":"accessibilityLabel"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}]}]}]},{"text":"Small size behavior","type":"heading","level":2,"anchor":"Small-size-behavior"},{"inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"type":"codeVoice","code":".oudsListItemSize(.small)"},{"type":"text","text":" modifier),"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"overline"},{"type":"text","text":" and "},{"type":"codeVoice","code":"extraLabel"},{"type":"text","text":" properties are "},{"type":"strong","inlineContent":[{"type":"text","text":"automatically hidden"}]},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"type":"codeVoice","code":"label"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":", and "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" remain visible."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"type":"strong","inlineContent":[{"type":"text","text":"automatically hidden"}]},{"text":", but the ","type":"text"},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"]},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"platforms":[{"unavailable":false,"deprecated":false,"name":"iOS","introducedAt":"15.0","beta":false},{"unavailable":false,"deprecated":false,"name":"iPadOS","introducedAt":"15.0","beta":false},{"unavailable":false,"deprecated":false,"name":"Mac Catalyst","introducedAt":"15.0","beta":false},{"unavailable":false,"deprecated":false,"name":"macOS","introducedAt":"13.0","beta":false},{"unavailable":false,"deprecated":false,"name":"tvOS","intro