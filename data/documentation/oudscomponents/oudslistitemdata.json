{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemdata"]}],"metadata":{"navigatorTitle":[{"text":"OUDSListItemData","kind":"identifier"}],"modules":[{"name":"Components"}],"externalID":"s:14OUDSComponents16OUDSListItemDataV","title":"OUDSListItemData","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemData","kind":"identifier"}],"symbolKind":"struct","platforms":[{"unavailable":false,"beta":false,"name":"iOS","deprecated":false,"introducedAt":"15.0"},{"unavailable":false,"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"15.0"},{"unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"15.0"},{"unavailable":false,"beta":false,"name":"macOS","deprecated":false,"introducedAt":"13.0"},{"unavailable":false,"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"beta":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0"},{"unavailable":false,"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"11.0"}]},"abstract":[{"type":"text","text":"Represents the main content displayed within a list item component such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Slot"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-5cmua","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-8krhc","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"]},{"generated":true,"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Label"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemData","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},{"type":"text","text":" groups all the text-based information that a list item can display:"},{"type":"text","text":" "},{"type":"text","text":"a mandatory label (an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"type":"text","text":" or a custom "},{"type":"codeVoice","code":"View"},{"type":"text","text":") and optional"},{"type":"text","text":" "},{"type":"text","text":"description, overline, extra label and helper text. Every textual field accepts a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"a localized string or an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"type":"text","text":", plus optional slots."}]},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Minimal: label only (string literal is implicitly converted to .textual(.raw))","    let data = OUDSListItemData(label: .textual(\"Label\"))","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: .textual(\"Label\", isBold: true))","","    \/\/ Localized label","    let data = OUDSListItemData(label: .textual(.localized(\"label.key\")))","","    \/\/ Styled rich label (user-controlled font, color, markdown…)","    let data = OUDSListItemData(","        label: .textual(.rich(AttributedString.from(text: \"Label\",","                                                        foregroundColor: .orange,","                                                        font: .headline)))","    )","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content (string literals auto-convert to .raw OUDSTextualContent)","    let data = OUDSListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Mixed raw \/ rich text per field — any textual field can be styled","    let data = OUDSListItemData(","        label: \"Label\",","        description: .rich(myStyledDescription),","        overline: \"Plain overline\",","        helperText: .rich(myStyledHelper)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"]},{"type":"heading","text":"Custom view label","level":2,"anchor":"Custom-view-label"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing a custom view as label:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Bold styling is not applicable; all styling is controlled by the provided view."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You must provide an "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}],"type":"paragraph"}]}]},{"type":"heading","text":"Small size behavior","level":2,"anchor":"Small-size-behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"type":"codeVoice","code":".oudsListItemSize(.small)"},{"type":"text","text":" modifier),"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"overline"},{"type":"text","text":" and "},{"type":"codeVoice","code":"extraLabel"},{"type":"text","text":" properties are "},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"type":"codeVoice","code":"label"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":", and "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" remain visible."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"type":"text","text":", but the "},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"]},{"style":"note","type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"title":"Navigations","kind":"article","role":"article","type":"topic","url":"\/documentation\/oudscomponents\/navigations","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"strong"},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/oudscomponents","role":"collection","type":"topic","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","navigatorTitle":[{"kind":"text","text":"Components"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSListItemData/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot: