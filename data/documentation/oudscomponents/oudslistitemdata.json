{"abstract":[{"text":"Represents the main content displayed within a list item component such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"text":".","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemData"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","type":"reference"},{"type":"text","text":" groups all the text-based information that a list item can display:"},{"type":"text","text":" "},{"type":"text","text":"a mandatory label (an "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"type":"text","text":" or a custom "},{"type":"codeVoice","code":"View"},{"type":"text","text":") and optional"},{"type":"text","text":" "},{"type":"text","text":"description, overline, extra label and helper text. Every textual field accepts a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"a localized string or an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" through "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"type":"text","text":", plus optional slots."}],"type":"paragraph"},{"level":2,"text":"Code samples","type":"heading","anchor":"Code-samples"},{"code":["    \/\/ Minimal: label only (string literal is implicitly converted to .textual(.raw))","    let data = OUDSListItemData(label: .textual(\"Label\"))","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: .textual(\"Label\", isBold: true))","","    \/\/ Localized label","    let data = OUDSListItemData(label: .textual(.localized(\"label.key\")))","","    \/\/ Styled rich label (user-controlled font, color, markdown…)","    let data = OUDSListItemData(","        label: .textual(.rich(AttributedString.from(text: \"Label\",","                                                        foregroundColor: .orange,","                                                        font: .headline)))","    )","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content (string literals auto-convert to .raw OUDSTextualContent)","    let data = OUDSListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Mixed raw \/ rich text per field — any textual field can be styled","    let data = OUDSListItemData(","        label: \"Label\",","        description: .rich(myStyledDescription),","        overline: \"Plain overline\",","        helperText: .rich(myStyledHelper)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Custom view label","type":"heading","anchor":"Custom-view-label"},{"inlineContent":[{"type":"text","text":"When providing a custom view as label:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bold styling is not applicable; all styling is controlled by the provided view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must provide an "},{"type":"codeVoice","code":"accessibilityLabel"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"type":"codeVoice","code":"accessibilityLabel"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}]}]}]},{"level":2,"text":"Small size behavior","type":"heading","anchor":"Small-size-behavior"},{"inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"type":"codeVoice","code":".oudsListItemSize(.small)"},{"type":"text","text":" modifier),"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"overline"},{"type":"text","text":" and "},{"type":"codeVoice","code":"extraLabel"},{"type":"text","text":" properties are "},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"type":"codeVoice","code":"label"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":", and "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" remain visible."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"type":"text","text":", but the "},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}],"type":"paragraph"},{"code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"],"syntax":"swift","type":"codeListing"},{"style":"note","type":"aside","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemdata"]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"OUDSListItemData","kind":"identifier"}],"title":"OUDSListItemData","platforms":[{"introducedAt":"15.0","deprecated":false,"beta":false,"name":"iOS","unavailable":false},{"introducedAt":"13.0","deprecated":false,"beta":false,"name":"macOS","unavailable":false},{"introducedAt":"16.0","deprecated":false,"beta":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS","unavailable":false},{"intr