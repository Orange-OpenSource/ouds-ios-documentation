{"kind":"symbol","metadata":{"modules":[{"name":"Components"}],"externalID":"s:14OUDSComponents16OUDSListItemDataV","navigatorTitle":[{"text":"OUDSListItemData","kind":"identifier"}],"title":"OUDSListItemData","platforms":[{"unavailable":false,"deprecated":false,"name":"iOS","beta":false,"introducedAt":"15.0"},{"introducedAt":"13.0","deprecated":false,"name":"macOS","unavailable":false,"beta":false},{"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"16.0","deprecated":false},{"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0","deprecated":false},{"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"11.0","deprecated":false}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemData","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemdata"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemData","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","type":"reference","isActive":true},{"text":" groups all the text-based information that a list item can display:","type":"text"},{"text":" ","type":"text"},{"text":"a mandatory label (either a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" or a custom ","type":"text"},{"type":"codeVoice","code":"View"},{"text":"), and optional description, overline,","type":"text"},{"text":" ","type":"text"},{"text":"extra label, and helper text, and slots.","type":"text"}],"type":"paragraph"},{"text":"Code samples","anchor":"Code-samples","type":"heading","level":2},{"code":["    \/\/ Minimal: label only (String)","    let data = OUDSListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = OUDSListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = OUDSListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = OUDSListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"type":"codeListing","syntax":"swift"},{"text":"Custom view label","anchor":"Custom-view-label","type":"heading","level":2},{"inlineContent":[{"text":"When providing a custom view as label:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"hasBoldLabel","type":"codeVoice"},{"text":" property is not applicable; all styling is controlled by the provided view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You must provide an ","type":"text"},{"code":"accessibilityLabel","type":"codeVoice"},{"text":" parameter so that Voice Over can vocalize the label.","type":"text"},{"text":" ","type":"text"},{"text":"This ","type":"text"},{"code":"accessibilityLabel","type":"codeVoice"},{"text":" is used in the combined accessibility label of the list item text container.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)","type":"text"}],"type":"paragraph"}]}]},{"text":"Small size behavior","anchor":"Small-size-behavior","type":"heading","level":2},{"inlineContent":[{"text":"When the list item is displayed in small size (via the ","type":"text"},{"code":".oudsListItemSize(.small)","type":"codeVoice"},{"text":" modifier),","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"overline","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"extraLabel","type":"codeVoice"},{"text":" properties are ","type":"text"},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"text":" to ensure a compact layout.","type":"text"},{"text":" ","type":"text"},{"text":"Only the ","type":"text"},{"code":"label","type":"codeVoice"},{"text":", ","type":"text"},{"code":"description","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" remain visible.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"bottomSlot","type":"codeVoice"},{"text":" is also ","type":"text"},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"text":", but the ","type":"text"},{"code":"textSlot","type":"codeVoice"},{"text":" remains displayed.","type":"text"}],"type":"paragraph"},{"code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"name":"Since"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Represents the main content displayed within a list item component such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/docum