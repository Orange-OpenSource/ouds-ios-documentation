{"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Represents the main content displayed within a list item component such as"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"text":".","type":"text"}],"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Slot"],"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-5cmua","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)-8krhc","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Label"],"generated":true,"title":"Enumerations","anchor":"Enumerations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemData","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","type":"reference","isActive":true},{"text":" groups all the text-based information that a list item can display:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a mandatory label (an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"text":" or a custom ","type":"text"},{"code":"View","type":"codeVoice"},{"text":") and optional","type":"text"},{"text":" ","type":"text"},{"text":"description, overline, extra label and helper text. Every textual field accepts a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a localized string or an "},{"code":"AttributedString","type":"codeVoice"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":", plus optional slots."}],"type":"paragraph"},{"anchor":"Code-samples","level":2,"type":"heading","text":"Code samples"},{"code":["    \/\/ Minimal: label only (string literal is implicitly converted to .textual(.raw))","    let data = OUDSListItemData(label: .textual(\"Label\"))","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: .textual(\"Label\", isBold: true))","","    \/\/ Localized label","    let data = OUDSListItemData(label: .textual(.localized(\"label.key\")))","","    \/\/ Styled rich label (user-controlled font, color, markdown…)","    let data = OUDSListItemData(","        label: .textual(.rich(AttributedString.from(text: \"Label\",","                                                        foregroundColor: .orange,","                                                        font: .headline)))","    )","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content (string literals auto-convert to .raw OUDSTextualContent)","    let data = OUDSListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Mixed raw \/ rich text per field — any textual field can be styled","    let data = OUDSListItemData(","        label: \"Label\",","        description: .rich(myStyledDescription),","        overline: \"Plain overline\",","        helperText: .rich(myStyledHelper)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-view-label","type":"heading","text":"Custom view label","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing a custom view as label:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Bold styling is not applicable; all styling is controlled by the provided view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You must provide an ","type":"text"},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"code":"accessibilityLabel","type":"codeVoice"},{"text":" is used in the combined accessibility label of the list item text container.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Small size behavior","level":2,"anchor":"Small-size-behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"code":".oudsListItemSize(.small)","type":"codeVoice"},{"text":" modifier),","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"overline","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"extraLabel","type":"codeVoice"},{"text":" properties are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"automatically hidden"}]},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"type":"codeVoice","code":"label"},{"text":", ","type":"text"},{"type":"codeVoice","code":"description"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" remain visible."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"bottomSlot","type":"codeVoice"},{"text":" is also ","type":"text"},{"inlineContent":[{"text":"automatically hidden","type":"text"}],"type":"strong"},{"text":", but the ","type":"text"},{"code":"textSlot","type":"codeVoice"},{"text":" remains displayed.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"]},{"name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"text":"OUDSListItemData","kind":"identifier"}],"title":"OUDSListItemData","symbolKind":"struct","externalID":"s:14OUDSComponents16OUDSListItemDataV","platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"15.0","beta":false},{"name":"iPadOS","beta":false,"unavailable":false,"introducedAt":"15.0","deprecated":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"15.0","unavailable":false},{"unavailable":false,"beta":false,"introducedAt":"13.0","deprecated":false,"name":"macOS"},{"unavailable":false,"introducedAt":"16.0","name":"tvOS","beta":false,"de