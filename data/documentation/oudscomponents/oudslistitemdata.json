{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"Represents the main content displayed within a list item component such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemData"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","isActive":true,"type":"reference"},{"type":"text","text":" groups all the text-based information that a list item can display:"},{"type":"text","text":" "},{"type":"text","text":"a mandatory label (either a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a custom "},{"type":"codeVoice","code":"View"},{"type":"text","text":"), and optional description, overline,"},{"type":"text","text":" "},{"type":"text","text":"extra label, and helper text, and slots."}],"type":"paragraph"},{"text":"Code samples","level":2,"type":"heading","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Minimal: label only (String)","    let data = OUDSListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = OUDSListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = OUDSListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = OUDSListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = OUDSListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = OUDSListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    OUDSStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    OUDSNavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = OUDSListItemData(","        label: \"Label\",","        textSlot: OUDSListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: OUDSListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"]},{"text":"Custom view label","level":2,"type":"heading","anchor":"Custom-view-label"},{"inlineContent":[{"type":"text","text":"When providing a custom view as label:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"hasBoldLabel","type":"codeVoice"},{"type":"text","text":" property is not applicable; all styling is controlled by the provided view."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You must provide an "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}],"type":"paragraph"}]}]},{"text":"Small size behavior","level":2,"type":"heading","anchor":"Small-size-behavior"},{"inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"type":"codeVoice","code":".oudsListItemSize(.small)"},{"type":"text","text":" modifier),"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"overline"},{"type":"text","text":" and "},{"type":"codeVoice","code":"extraLabel"},{"type":"text","text":" properties are "},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"type":"codeVoice","code":"label"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":", and "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" remain visible."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"type":"text","text":", but the "},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    OUDSStaticListItem(data: OUDSListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .oudsListItemSize(.small)"]},{"name":"Since","type":"aside","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"style":"note"}]}],"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/Slot"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:hel