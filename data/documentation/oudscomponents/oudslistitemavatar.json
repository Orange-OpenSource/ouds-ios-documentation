stItemAvatar\/AvatarType","isActive":true,"type":"reference"},{"text":" enum defines the content displayed inside the avatar:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".icon","type":"codeVoice"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".image(_:)","type":"codeVoice"}]},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".initials(_:)","type":"codeVoice"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Sizes","text":"Sizes","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true,"type":"reference"},{"text":" enum defines the available sizes for the avatar:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".medium","type":"codeVoice"}]},{"type":"text","text":": The default size, suited for standard list items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".large","type":"codeVoice"}]},{"type":"text","text":": A larger variant for increased visual prominence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".extraLarge","type":"codeVoice"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true,"type":"reference"},{"text":"), the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter is ","type":"text"},{"inlineContent":[{"type":"text","text":"ignored"}],"type":"strong"},{"text":" ","type":"text"},{"text":"and the avatar is always rendered at its smallest available size.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Badge","text":"Badge","type":"heading"},{"inlineContent":[{"text":"An optional badge ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true,"type":"reference"},{"text":" can be placed at the","type":"text"},{"text":" ","type":"text"},{"text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count).","type":"text"},{"text":" ","type":"text"},{"text":"The badge is rendered with a safety-area border matching the theme’s ","type":"text"},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The recommended badge sizes per avatar size are:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".medium"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".extraSmall"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".large"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".small"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".medium"},{"type":"text","text":" badge"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Code-samples","text":"Code samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Contact\"),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"],"type":"codeListing"},{"level":2,"anchor":"Containers-alignment","text":"Containers alignment","type":"heading"},{"inlineContent":[{"text":"The avatar, along with other leading\/trailing elements and the text container, can be","type":"text"},{"text":" ","type":"text"},{"text":"vertically aligned using the ","type":"text"},{"identifier":"doc:\/\/OUDSCompone