{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"An avatar element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"type":"text","text":"."}],"metadata":{"symbolKind":"struct","modules":[{"name":"Components"}],"roleHeading":"Structure","navigatorTitle":[{"text":"OUDSListItemAvatar","kind":"identifier"}],"platforms":[{"introducedAt":"15.0","unavailable":false,"name":"iOS","deprecated":false,"beta":false},{"introducedAt":"13.0","unavailable":false,"name":"macOS","deprecated":false,"beta":false},{"introducedAt":"16.0","unavailable":false,"name":"tvOS","deprecated":false,"beta":false},{"introducedAt":"1.0","unavailable":false,"name":"visionOS","deprecated":false,"beta":false},{"introducedAt":"11.0","unavailable":false,"name":"watchOS","deprecated":false,"beta":false}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemAvatar","kind":"identifier"}],"title":"OUDSListItemAvatar","role":"symbol","externalID":"s:14OUDSComponents18OUDSListItemAvatarV"},"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/init(type:size:badgeType:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/body"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/BadgeType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar"},{"text":" displays a circular visual identifier that can represent a user, a contact,","type":"text"},{"text":" ","type":"text"},{"text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials.","type":"text"},{"text":" ","type":"text"},{"text":"An optional ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"text":" can be attached at the bottom-trailing corner to indicate status.","type":"text"}]},{"text":"Avatar types","level":2,"type":"heading","anchor":"Avatar-types"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType"},{"type":"text","text":" enum defines the content displayed inside the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".icon","type":"codeVoice"}],"type":"strong"},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".image(_:)","type":"codeVoice"}]},{"text":": A custom ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" asset that fills the avatar circle.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".initials(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Sizes","level":2,"type":"heading","anchor":"Sizes"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","type":"reference"},{"type":"text","text":" enum defines the available sizes for the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".medium","type":"codeVoice"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": A larger variant for increased visual prominence."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"}],"type":"strong"},{"type":"text","text":": The largest variant, typically used for profile-like displays."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"inlineContent":[{"type":"text","text":"ignored"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"anchor":"Badge","level":2,"type":"heading","text":"Badge"},{"inlineContent":[{"text":"An optional badge ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The recommended badge sizes per avatar size are:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".medium"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".extraSmall"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".large"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".small"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".medium"},{"type":"text","text":" badge"}]}]}]},{"level":2,"anchor":"Code-samples","type":"heading","text":"Code samples"},{"syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Contact\"),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"],"type":"codeListing"},{"level":2,"anchor":"Containers-alignment","type":"heading","text":"Containers alignment"},{"inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"text":"vertically aligned using the ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/docume