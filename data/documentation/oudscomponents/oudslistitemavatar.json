{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/init(type:size:badgeType:accessibilityLabel:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/body"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/BadgeType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","isActive":true},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"type":"text","text":" "},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"anchor":"Avatar-types","text":"Avatar types","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".icon","type":"codeVoice"}],"type":"strong"},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".image(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A custom ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset that fills the avatar circle.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".initials(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Sizes","text":"Sizes","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".medium","type":"codeVoice"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".large","type":"codeVoice"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".extraLarge","type":"codeVoice"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"type":"strong","inlineContent":[{"type":"text","text":"ignored"}]},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}]},{"anchor":"Badge","text":"Badge","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional badge "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}]},{"items":[{"content":[{"inlineContent":[{"code":".medium","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".extraSmall","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".large","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".small","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".extraLarge","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".medium","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Contact\")),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"]},{"anchor":"Containers-alignment","text":"Containers alignment","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"type":"text","text":"vertically aligned using the "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemContainerAlignment(_:)","isActive":true},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".center"},{"type":"text","text":" by default, or "},{"type":"codeVoice","code":".top"},{"type":"text","text":")."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"name":"Since","type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","interfaceLanguage":"swift"},"metadata":{"title":"OUDSListItemAvatar","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}],"navigatorTitle":[{"text":"OUDSListItemAvatar","kind":"identifier"}],"externalID":"s:14OUDSComponents18OUDSListItemAvatarV","platforms":[{"name":"iOS","introducedAt":"15.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introdu