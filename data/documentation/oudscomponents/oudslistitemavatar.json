UDSBadgeStandard","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"text":" can be attached at the bottom-trailing corner to indicate status.","type":"text"}]},{"type":"heading","anchor":"Avatar-types","level":2,"text":"Avatar types"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","type":"reference","isActive":true},{"text":" enum defines the content displayed inside the avatar:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".icon"}]},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".image(_:)"}],"type":"strong"},{"text":": A custom ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" asset that fills the avatar circle.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".initials(_:)"}],"type":"strong"},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}]}]}]},{"type":"heading","anchor":"Sizes","level":2,"text":"Sizes"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"},{"text":" enum defines the available sizes for the avatar:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)"},{"text":"), the ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" parameter is ","type":"text"},{"type":"strong","inlineContent":[{"text":"ignored","type":"text"}]},{"text":" ","type":"text"},{"text":"and the avatar is always rendered at its smallest available size.","type":"text"}]},{"type":"heading","anchor":"Badge","level":2,"text":"Badge"},{"type":"paragraph","inlineContent":[{"text":"An optional badge ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"text":" can be placed at the","type":"text"},{"text":" ","type":"text"},{"text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count).","type":"text"},{"text":" ","type":"text"},{"text":"The badge is rendered with a safety-area border matching the theme’s ","type":"text"},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The recommended badge sizes per avatar size are:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".medium"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".extraSmall"},{"text":" badge","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".large"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".small"},{"text":" badge","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".medium"},{"text":" badge","type":"text"}]}]}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemDa