/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"anchor":"Avatar-types","type":"heading","level":2,"text":"Avatar types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType"},{"type":"text","text":" enum defines the content displayed inside the avatar:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".icon"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".image(_:)"}],"type":"strong"},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".initials(_:)"}],"type":"strong"},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}]},{"anchor":"Sizes","type":"heading","level":2,"text":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"type":"text","text":": The default size, suited for standard list items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"type":"text","text":": A larger variant for increased visual prominence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".extraLarge"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true,"type":"reference"},{"text":"), the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"ignored"}]},{"text":" ","type":"text"},{"text":"and the avatar is always rendered at its smallest available size.","type":"text"}]},{"anchor":"Badge","type":"heading","level":2,"text":"Badge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional badge "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true,"type":"reference"},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}]},{"type":"paragraph","inlineC