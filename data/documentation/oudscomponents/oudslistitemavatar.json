code":"Image"},{"text":" asset that fills the avatar circle.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}],"type":"paragraph"}]}]},{"text":"Sizes","level":2,"type":"heading","anchor":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"text":": The default size, suited for standard list items.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".large","type":"codeVoice"}]},{"type":"text","text":": A larger variant for increased visual prominence."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".extraLarge"}]},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)"},{"text":"), the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"ignored"}]},{"text":" ","type":"text"},{"text":"and the avatar is always rendered at its smallest available size.","type":