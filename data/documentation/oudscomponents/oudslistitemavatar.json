{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemAvatar","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar"},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"type":"text","text":" "},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"anchor":"Avatar-types","level":2,"type":"heading","text":"Avatar types"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType"},{"text":" enum defines the content displayed inside the avatar:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".icon","type":"codeVoice"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".image(_:)"}]},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}]},{"anchor":"Sizes","level":2,"type":"heading","text":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","type":"reference"},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".medium","type":"codeVoice"}]},{"text":": The default size, suited for standard list items.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".large","type":"codeVoice"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"}],"type":"strong"},{"type":"text","text":": The largest variant, typically used for profile-like displays."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true,"type":"reference"},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"inlineContent":[{"text":"ignored","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"anchor":"Badge","level":2,"type":"heading","text":"Badge"},{"inlineContent":[{"text":"An optional badge ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"text":" can be placed at the","type":"text"},{"text":" ","type":"text"},{"text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count).","type":"text"},{"text":" ","type":"text"},{"text":"The badge is rendered with a safety-area border matching the theme’s ","type":"text"},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".medium"},{"text":" avatar → ","type":"text"},{"code":".extraSmall","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".large","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".small","type":"codeVoice"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".medium"},{"type":"text","text":" badge"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvata