{"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships","title":"Conforms To"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","isActive":true},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"type":"text","text":" "},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"type":"heading","level":2,"text":"Avatar types","anchor":"Avatar-types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".icon","type":"codeVoice"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".image(_:)","type":"codeVoice"}]},{"type":"text","text":": A custom "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}]},{"type":"heading","level":2,"text":"Sizes","anchor":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, suited for standard list items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": A larger variant for increased visual prominence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".extraLarge"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}]}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"type":"strong","inlineContent":[{"type":"text","text":"ignored"}]},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Badge","anchor":"Badge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional badge "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".medium"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".extraSmall"},{"type":"text","text":" badge"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".large"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".small"},{"type":"text","text":" badge"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".medium"},{"type":"text","text":" badge"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Contact\"),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"]},{"type":"heading","level":2,"text":"Containers alignment","anchor":"Containers-alignment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"type":"text","text":"vertically aligned using the "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemContainerAlignment(_:)","isActive":true},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".center"},{"type":"text","text":" by default, or "},{"type":"codeVoice","code":".top"},{"type":"text","text":")."}]},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"An avatar element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/init(type:size:badgeType:accessibilityLabel:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/BadgeType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"],"anchor":"Enumerations","title":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"kind":"sym