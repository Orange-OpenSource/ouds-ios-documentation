{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"An avatar element that can be used at the leading or trailing position of a list item","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true,"type":"reference"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudslistitemavatar"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/init(type:size:badgeType:accessibilityLabel:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/BadgeType","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"],"generated":true,"anchor":"Enumerations"},{"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","interfaceLanguage":"swift"},"metadata":{"role":"symbol","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"beta":false},{"deprecated":false,"name":"macOS","introducedAt":"13.0","unavailable":false,"beta":false},{"deprecated":false,"name":"tvOS","introducedAt":"16.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false},{"deprecated":false,"name":"watchOS","introducedAt":"11.0","unavailable":false,"beta":false}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemAvatar","kind":"identifier"}],"externalID":"s:14OUDSComponents18OUDSListItemAvatarV","title":"OUDSListItemAvatar","modules":[{"name":"Components"}],"roleHeading":"Structure","navigatorTitle":[{"text":"OUDSListItemAvatar","kind":"identifier"}]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","isActive":true},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"type":"text","text":" "},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}],"type":"paragraph"},{"anchor":"Avatar-types","text":"Avatar types","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".icon"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".image(_:)"}]},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Sizes","text":"Sizes","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, suited for standard list items."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": A larger variant for increased visual prominence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".extraLarge"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true},{"type":"text","text":"), the "},{"code":"size","type":"codeVoice"},{"type":"text","text":" parameter is "},{"inlineContent":[{"type":"text","text":"ignored"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"anchor":"Badge","text":"Badge","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An optional badge "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".medium"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".extraSmall"},{"type":"text","text":" badge"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".large"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".small"},{"type":"text","text":" badge"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".medium"},{"type":"text","text":" badge"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Contact\"),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"],"type":"codeListing"},{"anchor":"Containers-alignment","text":"Containers alignment","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"type":"text","text":"vertically aligned using the "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemContainerAlignment(_:)","isActive":true},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":".center","type":"codeVoice"},{"type":"text","text":" by default, or "},{"code":".top","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships"}],"references":{"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OU