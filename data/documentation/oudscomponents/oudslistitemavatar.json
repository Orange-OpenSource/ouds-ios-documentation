kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSListItemAvatar"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar","isActive":true},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"text":" ","type":"text"},{"text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials.","type":"text"},{"text":" ","type":"text"},{"text":"An optional ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"text":" can be attached at the bottom-trailing corner to indicate status.","type":"text"}]},{"type":"heading","text":"Avatar types","anchor":"Avatar-types","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType","type":"reference","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".icon"}],"type":"strong"},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".image(_:)"}],"type":"strong"},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Sizes","type":"heading","level":2,"anchor":"Sizes"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"},{"text":" enum defines the available sizes for the avatar:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".large","type":"codeVoice"}]},{"type":"text","text":": A larger variant for increased visual prominence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)"},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"inlineContent":[{"text":"ignored","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"level":2,"text":"Badge","anchor":"Badge","type":"heading"},{"inlineContent":[{"type":"text","text":"An optional badge "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".medium"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".extraSmall"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".large"},{"type":"text","text":" avatar → "},{"type":"codeVoice","code":".small"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".extraLarge"},{"text":" avatar → ","type":"text"},{"type":"codeVoice","code":".medium"},{"text":" badge","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Code-samples","type":"heading","text":"Code samples"},{"syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    OUDSListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    OUDSListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    OUDSListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    OUDSListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    OUDSListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(OUDSListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Contact\")),","        trailing: .avatar(OUDSListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"],"type":"codeListing"},{"text":"Containers alignment","level":2,"anchor":"Containers-alignment","type":"heading"},{"inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"type":"text","text":"vertically aligned using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemContainerAlignment(_:)"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".center"},{"type":"text","text":" by default, or "},{"type":"codeVoice","code":".top"},{"type":"text","text":")."}],"type":"paragraph"},{"name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"