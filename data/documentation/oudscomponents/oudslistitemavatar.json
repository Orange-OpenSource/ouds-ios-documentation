{"kind":"symbol","abstract":[{"text":"An avatar element that can be used at the leading or trailing position of a list item","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemAvatar","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar"},{"text":" displays a circular visual identifier that can represent a user, a contact,","type":"text"},{"text":" ","type":"text"},{"text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials.","type":"text"},{"text":" ","type":"text"},{"text":"An optional ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"text":" can be attached at the bottom-trailing corner to indicate status.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Avatar-types","text":"Avatar types"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/AvatarType"},{"text":" enum defines the content displayed inside the avatar:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".icon"}],"type":"strong"},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".image(_:)"}],"type":"strong"},{"text":": A custom ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset that fills the avatar circle.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".initials(_:)"}],"type":"strong"},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Sizes","text":"Sizes"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemAvatar\/Size"},{"text":" enum defines the available sizes for the avatar:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".extraLarge"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)"},{"text":"), the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter is ","type":"text"},{"inlineContent":[{"text":"ignored","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"and the avatar is always rendered at its smallest available size.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Badge","text":"Badge"},{"inlineContent":[{"text":"An optional badge ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"text":" can be placed at the","type":"text"},{"text":" ","type":"text"},{"text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count).","type":"text"},{"text":" ","type":"text"},{"text":"The badge is rendered with a safety-area border matching the theme’s ","type":"text"},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The recommended badge sizes per avatar size are:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".medium","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".extraSmall","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".large","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".small","type":"codeVoice"},{"text":" badge","type":"text"}],"type":"paragraph"}