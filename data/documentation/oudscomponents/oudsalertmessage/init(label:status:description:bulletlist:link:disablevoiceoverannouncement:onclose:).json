ineContent":[{"type":"text","text":"An optional link to be displayed in the alert message. It can be used to trigger an action."}]}]},{"name":"disableVoiceOverAnnouncement","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disables the automatic VoiceOver announcement of the alert message when it appears. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]},{"name":"onClose","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional callback invoked when the close button is clicked. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"View\/disabled(_:)"},{"type":"text","text":" method to have component in disabled state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"description"},{"type":"text","text":" and the elements of the "},{"type":"codeVoice","code":"bulletList"},{"type":"text","text":" are "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"type":"text","text":" values: a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"(a st