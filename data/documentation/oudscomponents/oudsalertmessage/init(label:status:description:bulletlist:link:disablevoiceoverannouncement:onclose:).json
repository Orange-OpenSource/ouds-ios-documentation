{"text":": [","kind":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","preciseIdentifier":"s:14OUDSComponents18OUDSTextualContentO","text":"OUDSTextualContent","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"link","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","preciseIdentifier":"s:14OUDSComponents16OUDSAlertMessageV","text":"OUDSAlertMessage","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link","preciseIdentifier":"s:14OUDSComponents16OUDSAlertMessageV4LinkV","text":"Link","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"disableVoiceOverAnnouncement","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"onClose","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")? = nil)","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"label","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label displayed in the alert message. Main message that should be short, clear, and readable at a glance."}]}]},{"name":"status","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The status of the alert message. Its background color and its icon color are based on this status. There are two types of statuses (see "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","type":"reference","isActive":true},{"type":"text","text":")"}]}]},{"name":"description","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional supplementary text in an alert message, raw, localized or rich. Use only when additional detail or guidance is needed beyond the label."},{"type":"text","text":" "},{"type":"text","text":"It should remain short, clear and scannable, helping the user to understand what happened and what he can do next."}]}]},{"name":"bulletList","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional list of bullet points, each one raw, localized or rich, to be displayed in the alert message following the label or the optional "},{"type":"codeVoice","code":"description"},{"type":"text","text":"."}]}]},{"name":"link","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional link to be displayed in the alert message. It can be used to trigger an action."}]}]},{"name":"disableVoiceOverAnnouncement","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disables the automatic VoiceOver announcement of the alert message when it appears. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]},{"name":"onClose","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional callback invoked when the close button is clicked. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"View\/disabled(_:)"},{"type":"text","text":" method to have component in disabled state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"description"},{"type":"text","text":" and the elements of the "},{"type":"codeVoice","code":"bulletList"},{"type":"text","text":" are "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":" values: a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"(a string literal is enough), a localized string or a rich "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."}]},{"code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\", status: .positive)","","    OUDSAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     description: .rich(AttributedString(markdown: \"This is **an important notice**\")), \/\/ Manage in your side errors for init","                     bulletList: [","                        \"First thing\",","                        .localized(\"second_thing_wording\", bundle: Bundle.module),","                        .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                     ])"],"syntax":"swift","type":"codeListing"},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.2.0"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage\/init(label:status:description:bulletlist:link:disablevoiceoverannouncement:onclose:)"]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage/Link":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Link"}],"abstract":[{"text":"Used to describe the link display in the ","