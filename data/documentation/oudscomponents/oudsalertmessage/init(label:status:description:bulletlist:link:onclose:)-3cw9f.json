t message. It can be used to trigger an action."}]}]},{"name":"onClose","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional callback invoked when the close button is clicked. If "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"View\/disabled(_:)"},{"type":"text","text":" method to have component in disabled state."}],"type":"paragraph"},{"syntax":"swift","code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     description: AttributedString(markdown: \"This is **an important notice**\") \/\/ Manage in your side errors for init","                     bulletList: [","                        AttributedString(\"First thing\"),","                        AttributedString(markdown: \"One **more thing**\"), \/\/ Manage in your side errors for init","                     ])"],"type":"codeListing"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Creates an alert message with description and bullet list containing rich texts.","type":"text"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"abstract"