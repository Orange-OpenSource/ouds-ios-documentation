lose button is clicked. If "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}]}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"View\/disabled(_:)"},{"text":" method to have component in disabled state.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     description: AttributedString(markdown: \"This is **an important notice**\") \/\/ Manage in your side errors for init","                     bulletList: [","                        AttributedString(\"First thing\"),","                        AttributedString(markdown: \"One **more thing**\"), \/\/ Manage in your side errors for init","                     ])"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsalertmessage\/init(label:status:description:bulletlist:link:onclose:)-3cw9f"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"]]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus":{"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","ki