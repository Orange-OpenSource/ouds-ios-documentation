ional callback invoked when the close button is clicked. If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the close button is not displayed and the alert message","type":"text"},{"text":" ","type":"text"},{"text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and","type":"text"},{"text":" ","type":"text"},{"text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"View\/disabled(_:)"},{"text":" method to have component in disabled state.","type":"text"}],"type":"paragraph"},{"code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     bulletList: [","                        AttributedString(\"First thing\"),","                        AttributedString(markdown: \"One **more thing**\"), \/\/ Manage in your side errors for init","                     ])"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"text":"Creates an alert message with bullet list containing rich text.","type":"text"}],"metadata":{"role":"symbol","externalID":"s:14OUDSComponents16OUDSAlertMessageV5label6status11description10bulletList4link7onCloseACSS_AA0B6StatusOSSSgSay10Foundation16AttributedStringVGAC4LinkVSgyycSgtcfc","modules":[{"name":"Components"}],"symbolKind":"init","title":"init(label:status:description:bulletList:link:onClose:)","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name