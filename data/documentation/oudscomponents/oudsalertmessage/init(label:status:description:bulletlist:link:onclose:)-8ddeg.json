n is refreshed). Otherwise, the alert message is dismissable and","type":"text"},{"text":" ","type":"text"},{"text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}]}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"View\/disabled(_:)"},{"text":" method to have component in disabled state.","type":"text"}]},{"type":"codeListing","code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\", status: .positive)"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage\/init(label:status:description:bulletlist:link:onclose:)-8ddeg"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage":{"kind":"symbol","role":"symbol","title":"OUDSAlertMessage","type":"topic","url":"\/documentation\/oudscomponents\/oudsalertmessage","navigatorTitle":[{"kind":"identifier","text":"OUDSAlertMessage"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"kind":"symbol","role":"symbol","title":"OUDSInlineAlert","type":"topic","url":"\/documentation\/oudscomponents\/oudsinlinealert","navigatorTitle":[{"text":"OUDSInlineAlert","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInlineAlert","kind":"identifier"}],"abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage/Link":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link","abstract":[{"type":"text","text":"Used to describe the link display in the "},{"type":"codeVoice","code":"OUDSAlertMessage"}],"navigatorTitle":[{"text":"Link","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertmessage\/link","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Link","kind":"identifier"}],"title":"OUDSAlertMessage.Link"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage/init(label:status:description:bulletList:link:onClose:)-8ddeg":{"url":