en the close button is clicked. If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the close button is not displayed and the alert message","type":"text"},{"text":" ","type":"text"},{"text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and","type":"text"},{"text":" ","type":"text"},{"text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"View\/disabled(_:)","type":"codeVoice"},{"text":" method to have component in disabled state.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\", status: .positive)"]}]}],"kind":"symbol","abstract":[{"type":"text","text":"Creates an alert message."}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage/Link":{"url":"\/documentation\/oudscomponents\/oudsalertmessage\/link","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Link"}],"title":"OUDSAlertMessage.Link","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Link"}],"abstract":[{"text":"Used to describe the link display in the ","type":"text"},{"code":"OUDSAlertMessage","type":"codeVoice"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"url":"\/documentation\/oudscomponents\/oudsinlinealert","fragments":[{"kind":