rs":[{"content":[{"inlineContent":[{"text":"Label displayed in the alert message. Main message that should be short, clear, and readable at a glance.","type":"text"}],"type":"paragraph"}],"name":"label"},{"content":[{"inlineContent":[{"text":"The status of the alert message. Its background color and its icon color are based on this status. There are two types of statuses (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus"},{"text":")","type":"text"}],"type":"paragraph"}],"name":"status"},{"content":[{"inlineContent":[{"text":"An optional supplementary text in an alert message. Use only when additional detail or guidance is needed beyond the label. It should remain","type":"text"},{"text":" ","type":"text"},{"text":"short, clear and scannable, helping the user to understand what happened and what he can do next.","type":"text"}],"type":"paragraph"}],"name":"description"},{"content":[{"inlineContent":[{"text":"An optional list of bullet points to be displayed in the alert message following the label or the optional ","type":"text"},{"type":"codeVoice","code":"description"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"bulletList"},{"content":[{"inlineContent":[{"text":"An optional link to be displayed in the alert message. It can be used to trigger an action.","type":"text"}],"type":"paragraph"}],"name":"link"},{"content":[{"inlineContent":[{"text":"An optional callback invoked when the close button is clicked. If ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the close button is not displayed and the alert message","type":"text"},{"text":" ","type":"text"},{"text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and","type":"text"},{"text":" ","type":"text"},{"text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}],"type":"paragraph"}],"name":"onClose"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"View\/disabled(_:)","type":"codeVoice"},{"type":"text","text":" method to have component in disabled state."}],"type":"paragraph"},{"code":["    OUDSAlertMessage(label: \"Success! Your form was submitted.\", status: .positive)"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/init(label:status:description:bulletList:link:onClose:)-8ddeg","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertmessage\/init(label:status:description:bulletlist:link:onclose:)-8ddeg"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"]]},"kind":"symbol","references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSAlertMessage"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudsalertmessage","abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"kind":"symbol","role":"symbol","title":"OUDSAlertMessage"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSInlineAlert"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSInlineAlert"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudsinlinealert","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"kind":"symbol","role":"symbol","title":"OUDSInlineAlert"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage/Link":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Link"}],"navigatorTitle":[{"kind":"identifier","text":"Link"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudsalertmessage\/link","abstract":[{"type":"text","text":"Used to describe the link display in the "},{"type":"codeVoice","code":"OUDSAlertMessage"}],"kind":"symbol","role":"symbol","title":"OUDSAlertMessage.Link"},"doc://OUDSComponents/documentation/OUDSComponents":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","images":[{"iden