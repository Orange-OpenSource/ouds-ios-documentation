},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bundle","preciseIdentifier":"c:objc(cs)NSBundle"},{"kind":"text","text":" = .main, "},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","kind":"typeIdentifier","text":"OUDSAlertStatus","preciseIdentifier":"s:14OUDSComponents15OUDSAlertStatusO"},{"kind":"text","text":" = .positive, "},{"kind":"externalParam","text":"description"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","kind":"typeIdentifier","text":"OUDSTextualContent","preciseIdentifier":"s:14OUDSComponents18OUDSTextualContentO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bulletList"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","kind":"typeIdentifier","text":"OUDSTextualContent","preciseIdentifier":"s:14OUDSComponents18OUDSTextualContentO"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"link"},{"kind":"text","text":": `Self`"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link","kind":"typeIdentifier","text":"Link","preciseIdentifier":"s:14OUDSComponents16OUDSAlertMessageV4LinkV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"disableVoiceOverAnnouncement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"onClose"},{"kind":"text","text":": (() -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")? = nil)"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"LocalizedStringKey","type":"codeVoice"},{"type":"text","text":" used to look up the label in the given bundle"}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the "},{"code":".strings","type":"codeVoice"},{"type":"text","text":" file, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for the default"}]}],"name":"tableName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle in which to look up the localized string. Defaults to "},{"code":"Bundle.main","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"bundle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The status of the alert message. Its background color and its icon color are based on this status. There are two types of statuses (see "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","isActive":true},{"type":"text","text":")"}]}],"name":"status"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional supplementary text in an alert message, raw, localized or rich. Use only when additional detail or guidance is needed beyond the label."},{"type":"text","text":" "},{"type":"text","text":"It should remain short, clear and scannable, helping the user to understand what happened and what he can do next."}]}],"name":"description"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional list of bullet points, each one raw, localized or rich, to be displayed in the alert message following the label or the optional "},{"code":"description","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"bulletList"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional link to be displayed in the alert message. It can be used to trigger an action."}]}],"name":"link"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disables the automatic VoiceOver announcement of the alert message when it appears. Default is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"disableVoiceOverAnnouncement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional callback invoked when the close button is clicked. If "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}]}],"name":"onClose"}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"description","type":"codeVoice"},{"type":"text","text":" and the elements of the "},{"code":"bulletList","type":"codeVoice"},{"type":"text","text":" are "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"type":"text","text":" values: a raw "},{"code":"String","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"a localized string or a rich "},{"code":"AttributedString","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For this initializer, prefer "},{"code":".raw(_:)","type":"codeVoice"},{"type":"text","text":" to a bare string literal for the "},{"code":"description","type":"codeVoice"},{"type":"text","text":", so the compiler selects without any doubt"},{"type":"text","text":" "},{"type":"text","text":"the initializer taking an "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"type":"text","text":" and does not emit a deprecation warning."}]},{"type":"codeListing","syntax":"swift","code":["    OUDSAlertMessage(LocalizedStringKey(\"error_message\"), bundle: Bundle.module, status: .negative)","","    OUDSAlertMessage(LocalizedStringKey(\"error_message\"),","                     bundle: Bundle.module,","                     status: .negative,","                     description: .rich(AttributedString(markdown: \"This is **an important notice**\")), \/\/ Manage in your side errors for init","                     bulletList: [","                        \"First thing\",","                        .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                     ])"]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.2.0"}]}],"name":"Since"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"]]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"OUDSAlertStatus","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsalertstatus","title":"OUDSAlertStatus","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","role":"symbol","abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/O