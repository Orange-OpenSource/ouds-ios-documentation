},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSBundle","text":"Bundle"},{"kind":"text","text":" = .main, "},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents15OUDSAlertStatusO","text":"OUDSAlertStatus","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus"},{"kind":"text","text":" = .positive, "},{"kind":"externalParam","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents18OUDSTextualContentO","text":"OUDSTextualContent","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bulletList"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents18OUDSTextualContentO","text":"OUDSTextualContent","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"link"},{"kind":"text","text":": `Self`"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents16OUDSAlertMessageV4LinkV","text":"Link","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage\/Link"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"disableVoiceOverAnnouncement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"onClose"},{"kind":"text","text":": (() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":" used to look up the label in the given bundle"}]}],"name":"key"},{"content":[{"inlineContent":[{"type":"text","text":"The name of the "},{"type":"codeVoice","code":".strings"},{"type":"text","text":" file, or "},{"code":"nil","type":"codeVoice"},{"text":" for the default","type":"text"}],"type":"paragraph"}],"name":"tableName"},{"content":[{"inlineContent":[{"type":"text","text":"The bundle in which to look up the localized string. Defaults to "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"bundle"},{"content":[{"inlineContent":[{"type":"text","text":"The status of the alert message. Its background color and its icon color are based on this status. There are two types of statuses (see "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}],"name":"status"},{"content":[{"inlineContent":[{"type":"text","text":"An optional supplementary text in an alert message, raw, localized or rich. Use only when additional detail or guidance is needed beyond the label."},{"type":"text","text":" "},{"type":"text","text":"It should remain short, clear and scannable, helping the user to understand what happened and what he can do next."}],"type":"paragraph"}],"name":"description"},{"content":[{"inlineContent":[{"type":"text","text":"An optional list of bullet points, each one raw, localized or rich, to be displayed in the alert message following the label or the optional "},{"type":"codeVoice","code":"description"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"bulletList"},{"content":[{"inlineContent":[{"type":"text","text":"An optional link to be displayed in the alert message. It can be used to trigger an action."}],"type":"paragraph"}],"name":"link"},{"content":[{"inlineContent":[{"type":"text","text":"Disables the automatic VoiceOver announcement of the alert message when it appears. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"disableVoiceOverAnnouncement"},{"content":[{"inlineContent":[{"type":"text","text":"An optional callback invoked when the close button is clicked. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the close button is not displayed and the alert message"},{"type":"text","text":" "},{"type":"text","text":"remains visible until the context changes (e.g., the issue is resolved, the screen is refreshed). Otherwise, the alert message is dismissable and"},{"type":"text","text":" "},{"type":"text","text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure"},{"type":"text","text":" "},{"type":"text","text":"user is aware of important information; others can be closed to reduce visual clutter."}],"type":"paragraph"}],"name":"onClose"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" and the elements of the ","type":"text"},{"code":"bulletList","type":"codeVoice"},{"text":" are ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"a localized string or a rich ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For this initializer, prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for the ","type":"text"},{"code":"description","type":"codeVoice"},{"text":", so the compiler selects without any doubt","type":"text"},{"text":" ","type":"text"},{"text":"the initializer taking an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    OUDSAlertMessage(LocalizedStringKey(\"error_message\"), bundle: Bundle.module, status: .negative)","","    OUDSAlertMessage(LocalizedStringKey(\"error_message\"),","                     bundle: Bundle.module,","                     status: .negative,","                     description: .rich(AttributedString(markdown: \"This is **an important notice**\")), \/\/ Manage in your side errors for init","                     bulletList: [","                        \"First thing\",","                        .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                     ])"]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"3.2.0"}],"type":"paragraph"}],"style":"note","name":"Since"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"]]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"type":"topic","role":"symbol","title":"OUDSInlineAlert","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","navigatorTitle":[{"text":"OUDSInlineAlert","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInlineAlert","kind":"identifier"}],"abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsinlinealert"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage":{"type":"topic","role":"symbol","title":"OUDSAlertMessage","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","navigatorTitle":[{"kind":"identifier","text":"OUDSAlertMessage"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"url":"\/documentation\/oudscomponents\/oudsalertmessage","kind":"symbol","abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextualContent":{"type":"topic","role":"symbol","title":"OUDSTextualContent","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","navigatorTitle":[{"kind":"identifier","text":"OUDSTextualContent"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTextualContent"}],"url":"\/documentation\/oudscomponents\/oudstextualcontent","kind":"symbol","abstract":[{"type":"text","text