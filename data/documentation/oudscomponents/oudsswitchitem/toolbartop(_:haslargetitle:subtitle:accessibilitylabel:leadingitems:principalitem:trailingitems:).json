le"}],"type":"emphasis"},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" is never displayed.","type":"text"}]}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emphasis"},{"type":"text","text":" by default."}]}],"name":"trailingItems"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view which contains this "},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There must be only one "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"text":" ","type":"text"},{"text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead.","type":"text"},{"text":" ","type":"text"},{"text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsswitchitem\/toolbartop(_:haslargetitle:subtitle:accessibilitylabel:leadingitems:principalitem:trailingitems:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toolBarTop","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hasLargeTitle","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"subtitle","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"accessibilityLabel","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","k