","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with loader with rounded shape in small size","OUDSTag(loadingLabel: \"Label\", shape: .rounded, size: .small)"],"type":"codeListing","syntax":"swift"},{"text":"Input Tag","type":"heading","anchor":"Input-Tag","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_OrangeCompact","type":"image"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}]}]}]},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag"},{"text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSInputTag":{"url":"\/documentation\/oudscomponents\/oudsinputtag","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"OUDSInputTag","kind":"identifier"}],"title":"OUDSInputTag","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInputTag","kind":"identifier"}],"abstract":[{"type":"text","text":"Input tag is a UI element that allows to enter multiple values, each represented as a tag."},{"type":"text","text":" "},{"type":"text","text":"As users type and submit values (usually by pressing enter, comma, or tab), each value is transformed into a tag."},{"type":"text","text":" "},{"type":"text","text":"Input tag is often used for adding labels, categories, or participants."}]},"component_badge_standard_Sosh":{"variants":[{"url":"\/images\/OUDSComponents\/component_badge_standard_Sosh.png","traits":["1x","light"]}],"type":"image","identifier":"component_badge_standard_Sosh","alt":"A standard badge component in light and dark modes with Sosh theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSCompo