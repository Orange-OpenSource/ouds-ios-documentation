{"sections":[],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"anchor":"Badge","text":"Badge","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface.","type":"text"}]},{"anchor":"Badge-Count","text":"Badge Count","level":4,"type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_badge_count_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_badge_count_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_badge_count_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_badge_count_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true,"type":"reference"},{"text":" displays an integer value.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift","type":"codeListing"},{"anchor":"Badge-Icon","text":"Badge Icon","level":4,"type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"identifier":"component_badge_icon_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_badge_icon_Wireframe","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","isActive":true,"type":"reference"},{"text":" displays only an icon and has specific colors.","type":"text"}]},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"level":4,"text":"Badge Standard","anchor":"Badge-Standard","type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Orange"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_OrangeCompact"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Sosh"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Wireframe"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"text":" is an empty badge like a coloured pastille.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"],"type":"codeListing"},{"level":3,"text":"Progress Indicators","anchor":"Progress-Indicators","type":"heading"},{"level":4,"text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator","type":"heading"},{"tabs":[{"content":[{"type":"video","identifier":"component_progress_indicator_circular_Orange.video"}],"title":"Orange"},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_circular_OrangeCompact.video","type":"video"}]},{"title":"Sosh","content":[{"identifier":"component_progress_indicator_circular_Sosh.video","type":"video"}]},{"title":"Wireframe","content":[{"identifier":"component_progress_indicator_circular_Wireframe.video","type":"video"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"],"type":"codeListing"},{"anchor":"Linear-Progress-Indicator","level":4,"text":"Linear Progress Indicator","type":"heading"},{"tabs":[{"content":[{"identifier":"component_progress_indicator_linear_Orange.video","type":"video"}],"title":"Orange"},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_linear_OrangeCompact.video","type":"video"}]},{"content":[{"type":"video","identifier":"component_progress_indicator_linear_Sosh.video"}],"title":"Sosh"},{"content":[{"type":"video","identifier":"component_progress_indicator_linear_Wireframe.video"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","type":"reference"},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}],"type":"paragraph"},{"code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","OUDSLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift","type":"codeListing"},{"anchor":"Skeletons","level":3,"text":"Skeletons","type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_skeleton_Orange.video","type":"video"}]},{"title":"Orange Compact","content":[{"type":"video","identifier":"component_skeleton_OrangeCompact.video"}]},{"content":[{"identifier":"component_skeleton_Sosh.video","type":"video"}],"title":"Sosh"},{"content":[{"type":"video","identifier":"component_skeleton_Wireframe.video"}],"title":"Wireframe"}]},{"inlineContent":[{"type":"text","text":"A skeleton is a UI element that indicates when content is loading. The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","isActive":true},{"text":" enhances user experience by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming content."}],"type":"paragraph"},{"text":"Activate skeleton for OUDS components","level":4,"anchor":"Activate-skeleton-for-OUDS-components","type":"heading"},{"inlineContent":[{"type":"text","text":"Lot of components in OUDS library propose their own skeleton representation according to skeleton state set in the SwiftUI environment."},{"text":" ","type":"text"},{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"showSkeleton(isVisible:isAnimated:)"},{"text":" to update the state on the view and its children","type":"text"},{"text":" ","type":"text"},{"text":"to inform all components in the hierarchy to be displayed in skeleton.","type":"text"}],"type":"paragraph"},{"code":["    @State var isLoading = false","","    var body: some View {","        VStack {","            OUDSHeading(\"My header\")","            OUDSAlertMessage(label: \"Some text here\", description: \"You should read this text\")","            OUDSButton(text: \"Do some action\") { isLoading = true }","        }","        .showSkeleton(isVisible: isLoading) ","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Draw-skeletons","text":"Draw skeletons","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is possible to define a skeleton using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","type":"reference"},{"text":" and a frame.","type":"text"}]},{"code":["    VStack {","        \/\/ Heading skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 48)","","        \/\/ Body skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 300, height: 150)","","        \/\/ Footer skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 54)","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Prepare-Views-for-skeleton-layout","text":"Prepare Views for skeleton layout","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"skeleton","type":"codeVoice"},{"text":" helper applies skeleton on top of a View; the skeleton layout will be rendered with ","type":"text"},{"code":"showSkeleton(isVisible:)","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["    var body: some View {","        VStack(spacing: 20) {","            Text(\"The title\")","                .skeleton()","            ","            Button {    ","            } label: {","                VStack {","                    Text(\"Title\")","                    Label(\"Subtitle\", systemImage: \"phone\")","                }","            }","            .skeleton()","        }","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Tag","text":"Tag","type":"heading","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_tag_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","type":"reference"},{"text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Categorical Tag","anchor":"Categorical-Tag","type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_categoricalTag_OrangeCompact"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_categoricalTag_Wireframe","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","isActive":true},{"type":"text","text":" is like an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","isActive":true,"type":"reference"},{"text":" but without appearance notion and with categories instead of statuses.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["     \/\/ Text only with category 1, rounded shape, default size","     OUDSCategoricalTag(label: \"Label\", category: .category1)","","     \/\/ Text with category 2 and bullet","     OUDSCategoricalTag(label: \"Label\", category: .category2, leading: .bullet)","","     \/\/ Text with category 3 and custom icon","     OUDSCategoricalTag(label: \"Label\", category: .category3, leading: .icon(OUDSImage(asset: Image(decorative: \"ic_heart\"))))","","     \/\/ Small size, square shape","     OUDSCategoricalTag(label: \"Label\", category: .category4, shape: .square, size: .small)"],"type":"codeListing"},{"level":3,"text":"Input Tag","anchor":"Input-Tag","type":"heading"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_inputTag_Orange"}],"type":"paragraph"}],"title":"Orange"},{"title":"Orange Compact","content":[{"inlineContent":[{"type":"image","identifier":"component_inputTag_OrangeCompact"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","type":"reference","isActive":true},{"text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"title":"Indicators","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/indicators"]}],"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeIcon":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeIcon"}],"title":"OUDSBadgeIcon","kind":"symbol","url":"\/documentation\/oudscomponents\/oudsbadgeicon","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeIcon"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"topic","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"type":"text","text":" displays an image."}]},"component_badge_standard_Sosh":{"identifier":"component_badge_standard_Sosh","alt":"A standard badge component in light and dark modes with Sosh theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_badge_standard_Sosh.png"}]},"component_inputTag_Orange":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_inputTag_Orange.png"}],"identifier":"component_inputTag_Orange","alt":"An input tag component in light and dark modes with Orange theme"},"component_categoricalTag_OrangeCompact":{"alt":"A categorical tag component in light and dark modes with Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_categoricalTag_OrangeCompact.png"}],"identifier":"component_categoricalTag_OrangeCompact","type":"image"},"ic_folder_categories.png":{"type":"image","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","alt":null},"component_badge_icon_Orange":{"alt":"An icon badge component in light and dark modes with Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_badge_icon_Orange.png"}],"identifier":"component_badge_icon_Orange","type":"image"},"component_tag_OrangeCompact":{"type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tag_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_tag_OrangeCompact","alt":"A tag component in light and dark modes with Orange Compact theme"},"component_skeleton_Sosh.video":{"variants":[{"url":"\/videos\/OUDSComponents\/component_skeleton_Sosh.video.mp4","traits":["1x","light"]}],"al