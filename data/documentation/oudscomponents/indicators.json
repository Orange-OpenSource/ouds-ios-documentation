{"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"indicators"}]},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"text":"Badge","anchor":"Badge","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}]},{"text":"Badge Count","anchor":"Badge-Count","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_badge_count_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_badge_count_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_badge_count_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_badge_count_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","type":"reference","isActive":true},{"type":"text","text":" displays an integer value."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"]},{"text":"Badge Icon","anchor":"Badge-Icon","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_badge_icon_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_badge_icon_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_badge_icon_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_badge_icon_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"type":"text","text":" displays only an icon and has specific colors."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"]},{"text":"Badge Standard","anchor":"Badge-Standard","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_badge_standard_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_badge_standard_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_badge_standard_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_badge_standard_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" is an empty badge like a coloured pastille."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"]},{"text":"Progress Indicators","anchor":"Progress-Indicators","type":"heading","level":3},{"text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_progress_indicator_circular_Orange.video","type":"video"}]},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_circular_OrangeCompact.video","type":"video"}]},{"title":"Sosh","content":[{"identifier":"component_progress_indicator_circular_Sosh.video","type":"video"}]},{"title":"Wireframe","content":[{"identifier":"component_progress_indicator_circular_Wireframe.video","type":"video"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","type":"reference","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"]},{"text":"Linear Progress Indicator","anchor":"Linear-Progress-Indicator","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_progress_indicator_linear_Orange.video","type":"video"}]},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_linear_OrangeCompact.video","type":"video"}]},{"title":"Sosh","content":[{"identifier":"component_progress_indicator_linear_Sosh.video","type":"video"}]},{"title":"Wireframe","content":[{"identifier":"component_progress_indicator_linear_Wireframe.video","type":"video"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","type":"reference","isActive":true},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","OUDSLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"]},{"text":"Tag","anchor":"Tag","type":"heading","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_tag_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","type":"reference","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"]},{"text":"Input Tag","anchor":"Input-Tag","type":"heading","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_inputTag_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","type":"reference","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"]}]}],"sections":[],"metadata":{"role":"article","title":"Indicators","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"roleHeading":"Article","modules":[{"name":"Components"}]},"variants":[{"paths":["\/documentation\/oudscomponents\/indicators"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"references":{"doc://OUDSComponents/documentation/