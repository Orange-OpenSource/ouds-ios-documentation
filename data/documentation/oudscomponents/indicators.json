h rounded shape in small size","OUDSTag(loadingLabel: \"Label\", shape: .rounded, size: .small)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Input-Tag","text":"Input Tag"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}],"type":"paragraph"}],"title":"Orange"},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_OrangeCompact"}]}]},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_Wireframe"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","type":"reference"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}],"type":"paragraph"},{"code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","metadata":{"modules":[{"name":"Components"}],"roleHeading":"Article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","title":"Indicators"},"abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"text":"indicators"