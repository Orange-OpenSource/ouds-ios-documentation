","text":" displays an integer value."}]},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"type":"heading","level":4,"text":"Badge Icon","anchor":"Badge-Icon"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_badge_icon_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_Sosh","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_badge_icon_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"type":"text","text":" displays only an icon and has specific colors."}]},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"type":"heading","level":4,"text":"Badge Standard","anchor":"Badge-Standard"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_badge_standard_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_Sosh","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_badge_standard_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}]},{"type":"codeListing","code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"],"syntax":"swift"},{"type":"heading","level":3,"text":"Progress Indicators","anchor":"Progress-Indicators"},{"type":"heading","level":4,"text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_progress_indicator_circular_Orange.video","type":"video"}]},{"content":[{"identifier":"component_progress_indicator_circular_OrangeCompact.video","type":"video"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"identifier":"component_progress_indicator_circular_Sosh.video","type":"video"}]},{"content":[{"identifier":"component_progress_indicator_circular_Wireframe.video","type":"video"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator"},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}]},{"type":"codeListing","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"],"syntax":"swift"},{"type":"heading","level":4,"text":"Linear Progress Indicator","anchor":"Linear-Progress-Indicator"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_progress_indicator_linear_Orange.video","type":"video"}]},{"content":[{"identifier":"component_progress_indicator_linear_OrangeCompact.video","type":"video"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"identifier":"component_progress_indicator_linear_Sosh.video","type":"video"}]},{"content":[{"identifier":"component_progress_indicator_linear_Wireframe.video","type":"video"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}]},{"type":"codeListing","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","OUDSLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift"},{"type":"heading","level":3,"text":"Skeletons","anchor":"Skeletons"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"identifier":"component_skeleton_Orange.video","type":"video"}]},{"content":[{"identifier":"component_skeleton_OrangeCompact.video","type":"video"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"identifier":"component_skeleton_Sosh.video","type":"video"}]},{"content":[{"identifier":"component_skeleton_Wireframe.video","type":"video"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A skeleton is a UI element that indicates when content is loading. The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton"},{"type":"text","text":" enhances user experience by"},{"type":"text","text":" "},{"type":"text","text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming content."}]},{"type":"heading","level":4,"text":"Activate skeleton for OUDS components","anchor":"Activate-skeleton-for-OUDS-components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lot of components in OUDS library propose their own skeleton representation according to skeleton state set in the SwiftUI environment."},{"type":"text","text":" "},{"type":"text","text":"Apply "},{"type":"codeVoice","code":"showSkeleton(isVisible:isAnimated:)"},{"type":"text","text":" to update the state on the view and its children"},{"type":"text","text":" "},{"type":"text","text":"to inform all components in the hierarchy to be displayed in skeleton."}]},{"type":"codeListing","code":["    @State var isLoading = false","","    var body: some View {","        VStack {","            OUDSHeading(\"My header\")","            OUDSAlertMessage(label: \"Some text here\", description: \"You should read this text\")","            OUDSButton(text: \"Do some action\") { isLoading = true }","        }","        .showSkeleton(isVisible: isLoading) ","    }"],"syntax":"swift"},{"type":"heading","level":3,"text":"Draw skeletons","anchor":"Draw-skeletons"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to define a skeleton using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton"},{"type":"text","text":" and a frame."}]},{"type":"codeListing","code":["    VStack {","        \/\/ Heading skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 48)","","        \/\/ Body skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 300, height: 150)","","        \/\/ Footer skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 54)","    }"],"syntax":"swift"},{"type":"heading","level":3,"text":"Prepare Views for skeleton layout","anchor":"Prepare-Views-for-skeleton-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"skeleton"},{"type":"text","text":" helper applies skeleton on top of a View; the skeleton layout will be rendered with "},{"type":"codeVoice","code":"showSkeleton(isVisible:)"},{"type":"text","text":"."}]},{"type":"codeListing","code":["    var body: some View {","        VStack(spacing: 20) {","            Text(\"The title\")","                .skeleton()","            ","            Button {    ","            } label: {","                VStack {","                    Text(\"Title\")","                    Label(\"Subtitle\", systemImage: \"phone\")","                }","            }","            .skeleton()","        }","    }"],"syntax":"swift"},{"type":"heading","level":3,"text":"Tag","anchor":"Tag"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}]},{"type":"codeListing","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift"},{"type":"heading","level":3,"text":"Categorical Tag","anchor":"Categorical-Tag"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_categoricalTag_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Wireframe","type":"image"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","isActive":true,"type":"reference"},{"type":"text","text":" is like an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","isActive":true,"type":"reference"},{"type":"text","text":" but without appearance notion and with categories instead of statuses."}]},{"type":"codeListing","code":["     \/\/ Text only with category 1, rounded shape, default size","     OUDSCategoricalTag(label: \"Label\", category: .category1)","","     \/\/ Text with category 2 and bullet","     OUDSCategoricalTag(label: \"Label\", category: .category2, leading: .bullet)","","     \/\/ Text with category 3 and custom icon","     OUDSCategoricalTag(label: \"Label\", category: .category3, leading: .icon(OUDSImage(asset: Image(decorative: \"ic_heart\"))))","","     \/\/ Small size, square shape","     OUDSCategoricalTag(label: \"Label\", category: .category4, shape: .square, size: .small)"],"syntax":"swift"},{"type":"heading","level":3,"text":"Input Tag","anchor":"Input-Tag"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_inputTag_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"type":"codeListing","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"syntax":"swift"}]}],"references":{"component_badge_standard_Sosh":{"type":"image","identifier":"component_badge_standard_Sosh","alt":"A standard badge component in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_badge_standard_Sosh.png","traits":["1x","light"]}]},"component_progress_indicator_circular_Sosh.video":{"type":"video","identifier":"component_progress_indicator_circular_Sosh.video","alt":null,"variants":[{"url":"\/videos\/OUDSComponents\/component_progress_indicator_circular_Sosh.video.mp4","traits":["1x","light"]}],"poster":null},"component_badge_standard_OrangeCompact":{"type":"image","identifier":"component_badge_standard_OrangeCompact","alt":"A standard badge component in light and dark modes with Orange Compact theme","varia