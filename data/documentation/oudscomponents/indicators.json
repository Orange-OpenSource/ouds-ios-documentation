],"alt":"An input tag component in light and dark modes with Sosh theme","identifier":"component_inputTag_Sosh","type":"image"},"component_badge_standard_OrangeCompact":{"alt":"A standard badge component in light and dark modes with Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_badge_standard_OrangeCompact.png"}],"identifier":"component_badge_standard_OrangeCompact","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInputTag":{"type":"topic","role":"symbol","title":"OUDSInputTag","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","navigatorTitle":[{"text":"OUDSInputTag","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInputTag","kind":"identifier"}],"abstract":[{"text":"Input tag is a UI element that allows to enter multiple values, each represented as a tag.","type":"text"},{"text":" ","type":"text"},{"text":"As users type and submit values (usually by pressing enter, comma, or tab), each value is transformed into a tag.","type":"text"},{"text":" ","type":"text"},{"text":"Input tag is often used for adding labels, categories, or participants.","type":"text"}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsinputtag"},"component_progress_indicator_circular_OrangeCompact.video":{"alt":null,"type":"video","identifier":"component_progress_indicator_circular_OrangeCompact.video","variants":[{"url":"\/videos\/OUDSComponents\/component_progress_indicator_circular_OrangeCompact.video.mp4","traits":["1x","light"]}],"poster":null},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCategoricalTag":{"type":"topic","role":"symbol","title":"OUDSCategoricalTag","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","navigatorTitle":[{"kind":"identifier","text":"OUDSCategoricalTag"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCategoricalTag"}],"url":"\/documentation\/oudscomponents\/oudscategoricaltag","kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours."},{"type":"text","text":" "},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"OUDSTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}]},"component_categoricalTag_Wireframe":{"alt":"A categorical tag component in light and dark modes with Wireframe theme","type":"image","identifier":"component_categoricalTag_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_categoricalTag_Wireframe.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSkeleton":{"type":"topic","role":"symbol","title":"OUDSSkeleton","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","navigatorTitle":[{"text":"OUDSSkeleton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSkeleton","kind":"identifier"}],"abstract":[{"text":"A skeleton is a UI element that indicates when content is loading. The skeleton enhances user experience by","type":"text"},{"text":" ","type":"text"},{"text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the fo