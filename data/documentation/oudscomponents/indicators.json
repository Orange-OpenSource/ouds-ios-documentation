{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"anchor":"Badge","text":"Badge","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}],"type":"paragraph"},{"anchor":"Badge-Count","text":"Badge Count","type":"heading","level":4},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_Orange"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_OrangeCompact"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_Sosh"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_Wireframe"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount"},{"type":"text","text":" displays an integer value."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"anchor":"Badge-Icon","text":"Badge Icon","type":"heading","level":4},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_Orange"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_OrangeCompact"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_Sosh"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_Wireframe"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon"},{"type":"text","text":" displays only an icon and has specific colors."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"anchor":"Badge-Standard","text":"Badge Standard","type":"heading","level":4},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Orange"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_OrangeCompact"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Sosh"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_Wireframe"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"],"type":"codeListing"},{"anchor":"Progress-Indicators","text":"Progress Indicators","type":"heading","level":3},{"anchor":"Circular-Progress-Indicator","text":"Circular Progress Indicator","type":"heading","level":4},{"tabs":[{"content":[{"identifier":"component_progress_indicator_circular_Orange.video","type":"video"}],"title":"Orange"},{"content":[{"identifier":"component_progress_indicator_circular_OrangeCompact.video","type":"video"}],"title":"Orange Compact"},{"content":[{"identifier":"component_progress_indicator_circular_Sosh.video","type":"video"}],"title":"Sosh"},{"content":[{"identifier":"component_progress_indicator_circular_Wireframe.video","type":"video"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator"},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"],"type":"codeListing"},{"anchor":"Linear-Progress-Indicator","text":"Linear Progress Indicator","type":"heading","level":4},{"tabs":[{"content":[{"identifier":"component_progress_indicator_linear_Orange.video","type":"video"}],"title":"Orange"},{"content":[{"identifier":"component_progress_indicator_linear_OrangeCompact.video","type":"video"}],"title":"Orange Compact"},{"content":[{"identifier":"component_progress_indicator_linear_Sosh.video","type":"video"}],"title":"Sosh"},{"content":[{"identifier":"component_progress_indicator_linear_Wireframe.video","type":"video"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","OUDSLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"type":"codeListing"},{"anchor":"Skeletons","text":"Skeletons","type":"heading","level":3},{"tabs":[{"title":"Orange","content":[{"type":"video","identifier":"component_skeleton_Orange.video"}]},{"title":"Orange Compact","content":[{"type":"video","identifier":"component_skeleton_OrangeCompact.video"}]},{"title":"Sosh","content":[{"type":"video","identifier":"component_skeleton_Sosh.video"}]},{"title":"Wireframe","content":[{"type":"video","identifier":"component_skeleton_Wireframe.video"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"A skeleton is a UI element that indicates when content is loading. The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","type":"reference"},{"text":" enhances user experience by","type":"text"},{"text":" ","type":"text"},{"text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming content.","type":"text"}],"type":"paragraph"},{"anchor":"Activate-skeleton-for-OUDS-components","text":"Activate skeleton for OUDS components","type":"heading","level":4},{"inlineContent":[{"text":"Lot of components in OUDS library propose their own skeleton representation according to skeleton state set in the SwiftUI environment.","type":"text"},{"text":" ","type":"text"},{"text":"Apply ","type":"text"},{"code":"showSkeleton(isVisible:isAnimated:)","type":"codeVoice"},{"text":" to update the state on the view and its children","type":"text"},{"text":" ","type":"text"},{"text":"to inform all components in the hierarchy to be displayed in skeleton.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    @State var isLoading = false","","    var body: some View {","        VStack {","            OUDSHeading(\"My header\")","            OUDSAlertMessage(label: \"Some text here\", description: \"You should read this text\")","            OUDSButton(text: \"Do some action\") { isLoading = true }","        }","        .showSkeleton(isVisible: isLoading) ","    }"],"type":"codeListing"},{"anchor":"Draw-skeletons","text":"Draw skeletons","type":"heading","level":3},{"inlineContent":[{"text":"It is possible to define a skeleton using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","type":"reference"},{"text":" and a frame.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    VStack {","        \/\/ Heading skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 48)","","        \/\/ Body skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 300, height: 150)","","        \/\/ Footer skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 54)","    }"],"type":"codeListing"},{"anchor":"Prepare-Views-for-skeleton-layout","text":"Prepare Views for skeleton layout","type":"heading","level":3},{"inlineContent":[{"text":"The ","type":"text"},{"code":"skeleton","type":"codeVoice"},{"text":" helper applies skeleton on top of a View; the skeleton layout will be rendered with ","type":"text"},{"code":"showSkeleton(isVisible:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    var body: some View {","        VStack(spacing: 20) {","            Text(\"The title\")","                .skeleton()","            ","            Button {    ","            } label: {","                VStack {","                    Text(\"Title\")","                    Label(\"Subtitle\", systemImage: \"phone\")","                }","            }","            .skeleton()","        }","    }"],"type":"codeListing"},{"anchor":"Tag","text":"Tag","type":"heading","level":3},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}]}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"],"type":"codeListing"},{"anchor":"Categorical-Tag","text":"Categorical Tag","type":"heading","level":3},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Wireframe","type":"image"}]}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","isActive":true},{"type":"text","text":" is like an "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","isActive":true},{"type":"text","text":" but without appearance notion and with categories instead of statuses."}],"type":"paragraph"},{"syntax":"swift","code":["     \/\/ Text only with category 1, rounded shape, default size","     OUDSCategoricalTag(label: \"Label\", category: .category1)","","     \/\/ Text with category 2 and bullet","     OUDSCategoricalTag(label: \"Label\", category: .category2, leading: .bullet)","","     \/\/ Text with category 3 and custom icon","     OUDSCategoricalTag(label: \"Label\", category: .category3, leading: .icon(OUDSImage(asset: Image(decorative: \"ic_heart\"))))","","     \/\/ Small size, square shape","     OUDSCategoricalTag(label: \"Label\", category: .category4, shape: .square, size: .small)"],"type":"codeListing"},{"anchor":"Input-Tag","text":"Input Tag","type":"heading","level":3},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}]}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Components"}],"title":"Indicators","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators","interfaceLanguage":"swift"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"strong"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/indicators"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTag":{"kind":"symbol","title":"OUDSTag","type":"topic","role":"symbol","abstract":[{"text":"Tag is a UI element that allows to display short info like a label, keyword, or category.","type":"text"},{"text":" ","type":"text"},{"text":"Tag helps users quickly find, group, or understand content.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSTag"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","url":"\/documentation\/oudscomponents\/oudstag","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTag"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"url":"\/documentation\/ou