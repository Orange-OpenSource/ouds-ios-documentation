ndard","type":"reference","isActive":true},{"text":" is an empty badge like a coloured pastille.","type":"text"}]},{"type":"codeListing","code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"],"syntax":"swift"},{"text":"Progress Indicators","type":"heading","anchor":"Progress-Indicators","level":3},{"text":"Circular Progress Indicator","type":"heading","anchor":"Circular-Progress-Indicator","level":4},{"tabs":[{"title":"Orange","content":[{"type":"video","identifier":"component_progress_indicator_circular_Orange.video"}]},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_circular_OrangeCompact.video","type":"video"}]},{"title":"Sosh","content":[{"type":"video","identifier":"component_progress_indicator_circular_Sosh.video"}]},{"title":"Wireframe","content":[{"type":"video","identifier":"component_progress_indicator_circular_Wireframe.video"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"]},{"type":"heading","level":4,"anchor":"Linear-Progress-Indicator","text":"Linear Progress Indicator"},{"tabs":[{"title":"Orange","content":[{"type":"video","identifier":"component_progress_indicator_linear_Orange.video"}]},{"title":"Orange Compact","content":[{"type":"video","identifier":"component_progress_indicator_linear_OrangeCompact.video"}]},{"title":"Sosh","content":[{"type":"video","identifier":"component_progress_indicator_linear_Sosh.video"}]},{"title":"Wireframe","content":[{"type":"video","identifier":"component_progress_indicator_linear_Wireframe.video"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","type":"reference"},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: \"Uploading…\", animated: false)","","\/\/ An indeterminate horizontal bar with a helper text","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\")"]},{"type":"heading","level":3,"anchor":"Tag","text":"Tag"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}]}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with loader with rounded shape in small size","OUDSTag(loadingLabel: \"Label\", shape: .rounded, size: .small)"],"syntax":"swift","type":"codeListing"},{"anchor":"Input-Tag","level":3,"text":"Input Tag","type":"heading"},{"tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_OrangeCompact"}]}]},{"title":"Sosh","content":[{"inlineContent":[{"type":