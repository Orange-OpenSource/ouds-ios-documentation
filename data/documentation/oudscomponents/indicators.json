"type":"image","identifier":"component_badge_icon_OrangeCompact"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_icon_Sosh"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_icon_Wireframe"}]}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeIcon","type":"reference","isActive":true},{"text":" displays only an icon and has specific colors.","type":"text"}]},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","OUDSBadgeIcon(status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"type":"heading","text":"Badge Standard","anchor":"Badge-Standard","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_standard_OrangeCompact"}]}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_badge_standard_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_Wireframe","type":"image"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}]},{"code":["\/\/ Info badge in medium size without information","OUDSBadgeStandard(status: .info, size: .medium)"],"syntax":"swift","type":"codeListing"},{"anchor":"Progress-Indicators","text":"Progress Indicators","type":"heading","level":3},{"anchor":"Circular-Progress-Indicator","text":"Circular Progress Indicator","type":"heading","level":4},{"tabs":[{"content":[{"identifier":"component_progress_indicator_circular_Orange.video","type":"video"}],"title":"Orange"},{"content":[{"type":"video","identifier":"component_progress_indicator_circular_OrangeCompact.video"}],"title":"Orange Compact"},{"content":[{"identifier":"component_progress_indicator_circular_Sosh.video","type":"video"}],"title":"Sosh"},{"content":[{"type":"video","identifier":"component_progress_indicator_circular_Wireframe.video"}],"title":"Wireframe"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","type":"reference","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}]},{"code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","OUDSCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","OUDSCircularProgressIndicator(status: .accent)"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Linear Progress Indicator","type":"heading","anchor":"Linear-Progress-Indicator"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"video","identifier":"component_progress_indicator_linear_Orange.video"}]},{"title":"Orange Compact","content":[{"identifier":"component_progress_indicator_linear_OrangeCompact.video","type":"video"}]},{"title":"Sosh","content":[{"type":"video","identifier":"component_progress_indicator_linear_Sosh.video"}]},{"title":"Wireframe","content":[{"type":"video","identifier":"component_progress_indicator_linear_Wireframe.video"}]}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","isActive":true,"type":"reference"},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","OUDSLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","OUDSLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","OUDSLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","OUDSLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","OUDSLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"]},{"type":"heading","level":3,"text":"Skeletons","anchor":"Skeletons"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"video","identifier":"component_skeleton_Orange.video"}]},{"title":"Orange Compact","content":[{"type":"video","identifier":"component_skeleton_OrangeCompact.video"}]},{"title":"Sosh","content":[{"type":"video","identifier":"component_skeleton_Sosh.video"}]},{"title":"Wireframe","content":[{"type":"video","identifier":"component_skeleton_Wireframe.video"}]}]},{"type":"paragraph","inlineContent":[{"text":"A skeleton is a UI element that indicates when content is loading. The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","type":"reference","isActive":true},{"text":" enhances user experience by","type":"text"},{"text":" ","type":"text"},{"text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming content.","type":"text"}]},{"type":"heading","level":4,"text":"Activate skeleton for OUDS components","anchor":"Activate-skeleton-for-OUDS-components"},{"type":"paragraph","inlineContent":[{"text":"Lot of components in OUDS library propose their own skeleton representation according to skeleton state set in the SwiftUI environment.","type":"text"},{"text":" ","type":"text"},{"text":"Apply ","type":"text"},{"code":"showSkeleton(isVisible:isAnimated:)","type":"codeVoice"},{"text":" to update the state on the view and its children","type":"text"},{"text":" ","type":"text"},{"text":"to inform all components in the hierarchy to be displayed in skeleton.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    @State var isLoading = false","","    var body: some View {","        VStack {","            OUDSHeading(\"My header\")","            OUDSAlertMessage(label: \"Some text here\", description: \"You should read this text\")","            OUDSButton(text: \"Do some action\") { isLoading = true }","        }","        .showSkeleton(isVisible: isLoading) ","    }"]},{"type":"heading","level":3,"text":"Draw skeletons","anchor":"Draw-skeletons"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to define a skeleton using "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton","isActive":true},{"type":"text","text":" and a frame."}]},{"type":"codeListing","syntax":"swift","code":["    VStack {","        \/\/ Heading skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 48)","","        \/\/ Body skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 300, height: 150)","","        \/\/ Footer skeleton","        OUDSSkeleton(securityMargin: true).frame(width: 180, height: 54)","    }"]},{"type":"heading","level":3,"text":"Prepare Views for skeleton layout","anchor":"Prepare-Views-for-skeleton-layout"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"skeleton"},{"text":" helper applies skeleton on top of a View; the skeleton layout will be rendered with ","type":"text"},{"type":"codeVoice","code":"showSkeleton(isVisible:)"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["    var body: some View {","        VStack(spacing: 20) {","            Text(\"The title\")","                .skeleton()","            ","            Button {    ","            } label: {","                VStack {","                    Text(\"Title\")","                    Label(\"Subtitle\", systemImage: \"phone\")","                }","            }","            .skeleton()","        }","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"Tag","anchor":"Tag"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_Orange"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}]}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}]}]}]},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using OUDSImage.flipped","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","OUDSTag(label: \"Label\", status: .accent(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"Categorical Tag","anchor":"Categorical-Tag"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_categoricalTag_OrangeCompact"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_categoricalTag_Wireframe","type":"image"}]}]}]},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag"},{"type":"text","text":" is like an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag"},{"type":"text","text":" but without appearance notion and with categories instead of statuses."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["     \/\/ Text only with category 1, rounded shape, default size","     OUDSCategoricalTag(label: \"Label\", category: .category1)","","     \/\/ Text with category 2 and bullet","     OUDSCategoricalTag(label: \"Label\", category: .category2, leading: .bullet)","","     \/\/ Text with category 3 and custom icon","     OUDSCategoricalTag(label: \"Label\", category: .category3, leading: .icon(OUDSImage(asset: Image(decorative: \"ic_heart\"))))","","     \/\/ Small size, square shape","     OUDSCategoricalTag(label: \"Label\", category: .category4, shape: .square, size: .small)"]},{"type":"heading","text":"Input Tag","level":3,"anchor":"Input-Tag"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_Orange"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}]}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag"},{"text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"]}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/indicators"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"text":"indicators","type":"text"}]},{"type":"text","text":"."}],"references":{"component_progress_indicator_circular_Orange.video":{"identifier":"component_progress_indicator_circular_Orange.video","poster":null,"alt":null,"variants":[{"url":"\/videos\/OUDSComponents\/component_progress_indicator_circular_Orange.video.mp4","traits":["1x","light"]}],"type":"video"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","role