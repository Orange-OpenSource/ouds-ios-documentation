udscomponents\/oudsbadgestandard","role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInputTag":{"abstract":[{"text":"Input tag is a UI element that allows to enter multiple values, each represented as a tag.","type":"text"},{"text":" ","type":"text"},{"text":"As users type and submit values (usually by pressing enter, comma, or tab), each value is transformed into a tag.","type":"text"},{"text":" ","type":"text"},{"text":"Input tag is often used for adding labels, categories, or participants.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInputTag","kind":"identifier"}],"title":"OUDSInputTag","navigatorTitle":[{"text":"OUDSInputTag","kind":"identifier"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudsinputtag"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCircularProgressIndicator":{"navigatorTitle":[{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCircularProgressIndicator","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCircularProgressIndicator","kind":"identifier"}],"title":"OUDSCircularProgressIndicator","url":"\/documentation\/oudscomponents\/oudscircularprogressindicator","abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSkeleton":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudsskeleton","abstract":[{"text":"A skeleton is a UI element that indicates when content is loading. The skeleton enhances user experience by","type":"text"},{"text":" ","type":"text"},{"text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming","type":"text"},{"text":" ","type":"text"},{"text":"content.","type":"text"}],"navigatorTitle":[{"text":"OUDSSkeleton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSkeleton","kind":"identifier"}],"type":"topic","kind":"symbol","title":"OUDSSkeleton","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSkeleton"},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"component_badge_count_Orange":{"alt":"A count badge component in light and dark modes with Orange theme","type":"image","identifier":"component_badge_count_Orange","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_badge_count_Orange.png"}]},"component_badge_standard_Wireframe":{"alt":"A standard badge component in light and dark modes with Wireframe theme","type":"image","identifier":"component_badge_standard_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_badge_standard_Wireframe.png"}]},"component_tag_Sosh":{"alt":"A tag component in light and dark modes wit