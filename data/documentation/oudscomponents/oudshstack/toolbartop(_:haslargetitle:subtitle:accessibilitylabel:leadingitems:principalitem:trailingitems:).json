ge title nor principal item.","type":"text"}],"type":"paragraph"}]},{"name":"leadingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"type":"text","text":" by default."}],"type":"paragraph"}]},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" is never displayed."}]}]},{"name":"trailingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the trailing side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"type":"text","text":" by default."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There must be only one "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"code":".navigationSubtitle()","type":"codeVoice"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}],"kind":"content"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSToolBarItemsBuilder":{"abstract":[{"type":"text","text":"A result builder to group "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents