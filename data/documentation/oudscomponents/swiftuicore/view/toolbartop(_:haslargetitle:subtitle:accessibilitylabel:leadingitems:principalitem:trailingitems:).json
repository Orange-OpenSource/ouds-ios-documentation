ind":"typeIdentifier"},{"kind":"text","text":"] = { [] }) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}],"type":"paragraph"}],"name":"title"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"false"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}],"name":"hasLargeTitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"type":"codeVoice","code":"principalItem"},{"text":" is not ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":".","type":"text"}]}]}],"name":"subtitle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is never displayed."}],"type":"paragraph"}],"name":"principalItem"},{"name":"trailingItems","content":[{"inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"text":" must be placed inside a ","type":"text"},{"type":"codeVoice","code":"NavigationView"},{"text":" or ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There must be only one ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":"."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}],"type":"paragraph"}],"kind":"content"}],"references":{"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image","identifier":"ic_folder_categories.png","alt":null},"doc://