{"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCheckboxItem"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSCheckboxItem"}],"roleHeading":"Structure","platforms":[{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"15.0","name":"iOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"15.0","name":"iPadOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"15.0","name":"Mac Catalyst"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"13.0","name":"macOS"},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"16.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"11.0"}],"externalID":"s:14OUDSComponents16OUDSCheckboxItemV","role":"symbol","title":"OUDSCheckboxItem","modules":[{"name":"Components"}],"symbolKind":"struct"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"OUDSCheckboxItem","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"]},{"kind":"content","content":[{"type":"heading","text":"Layouts","anchor":"Layouts","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component can be rendered as two different layouts:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":": the component has a leading indicator, a label and optional helper texts, and an optional trailing decorative icon"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"reversed","type":"text"}],"type":"strong"},{"text":": like the ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"type":"text","text":" layout but with a trailing checkbox indicator and a leading optional image"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Indicator states","anchor":"Indicator-states","type":"heading"},{"inlineContent":[{"text":"The checkbox indicator has three available states:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"selected","type":"text"}],"type":"strong"},{"text":": the checkbox is filled with a tick, the user has made the action to select the checkbox","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"unselected","type":"text"}]},{"type":"text","text":": the checkbox is empty, does not contain a tick, the user has made the action to unselect or did not select yet the checkbox"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"If you are looking for a checkbox component with three states, use instead ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItemIndeterminate","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Particular cases","level":2,"type":"heading","anchor":"Particular-cases"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","type":"reference"},{"type":"text","text":" can be related to an error situation, for example troubles for a form."},{"type":"text","text":" "},{"type":"text","text":"A dedicated look and feel is implemented for that if the "},{"type":"codeVoice","code":"isError"},{"type":"text","text":" flag is risen."},{"type":"text","text":" "},{"type":"text","text":"In that case if the component displayed an icon, this icon will be replaced automatically by an error icon."}],"type":"paragraph"},{"inlineContent":[{"text":"In addition, the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem"},{"text":" can be in read only mode, i.e. the user cannot interact with the component yet but this component must not be considered","type":"text"},{"text":" ","type":"text"},{"text":"as disabled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The component does not follow the right-to-left (RTL) \/ left-to-right (LTR) mode returned by the system as it could have some meaning","type":"text"},{"text":" ","type":"text"},{"text":"to have for example the indicator in trailing position for LTR mode and vice versa.","type":"text"},{"text":" ","type":"text"},{"text":"However, if the component has an icon in leading position (RTL mode) or in trailing position (LTR), the content of the icon is never changed.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It could lead to a loss of meaning or semantics in the icon. Thus the "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSImage","isActive":true},{"type":"text","text":" "},{"code":"flipped","type":"codeVoice"},{"text":" property can be used to flip the icon content","type":"text"},{"type":"text","text":" "},{"type":"text","text":"whatever the layout direction is, preventing the user from implementing their own rules to flip or not the image."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Rich text","anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can only be used for error messages."},{"type":"text","text":" "},{"type":"text","text":"The error message is an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference","isActive":true},{"type":"text","text":": a raw "},{"code":"String","type":"codeVoice"},{"type":"text","text":", a localized string with "},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or a rich text with "},{"code":".rich(_:)","type":"codeVoice"},{"type":"text","text":" and an "},{"code":"AttributedString","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Prefer "},{"code":".raw(_:)","type":"codeVoice"},{"type":"text","text":" to a bare string literal for a raw message, so the compiler selects without any doubt the initializer"},{"type":"text","text":" "},{"type":"text","text":"taking an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference","isActive":true},{"type":"text","text":" and does not emit a deprecation warning."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Voice Over"}]},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a custom checkbox trait.","type":"text"},{"text":" ","type":"text"},{"text":"No accessibility identifier is defined in OUDS side as this value remains in the users hands.","type":"text"}]},{"level":2,"text":"Forbidden by design","type":"heading","anchor":"Forbidden-by-design"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both an error situation and a read only component.","type":"text"}]},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both an error situation and a disabled component.","type":"text"}]},{"text":" ","type":"text"},{"inlineContent":[{"text":"The design system does not allow to have both a read only and a disabled component.","type":"text"}],"type":"strong"}],"type":"paragraph"},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Supposing we have an unselected checkbox","    @Published var isOn: Bool = false","","    \/\/ A leading checkbox with a label.","    OUDSCheckboxItem(\"Hello world\", isOn: $isOn)","","    \/\/ Localizable from bundle can also be used","    OUDSCheckboxItem(LocalizedStringKey(\"agree_terms\"), bundle: Bundle.module, isOn: $isOn)","","    \/\/ A leading checkbox with a label, but in read only mode (user cannot interact yet, but not disabled).","    OUDSCheckboxItem(\"Hello world\", isOn: $isOn, isReadOnly: true)","","    \/\/ A leading checkbox with a label and a description as helper text.","    OUDSCheckboxItem(\"Bazinga!\", isOn: $isOn, description: \"Doll-Dagga Buzz-Buzz Ziggety-Zag\")","","    \/\/ A trailing checkbox with a label, a description and an icon (tinted, default rendering).","    OUDSCheckboxItem(\"We live in a fabled world\",","                     isOn: $isOn,","                     description: \"Of dreaming boys and wide-eyed girls\",","                     image: OUDSImage(asset: Image(decorative: \"ic_heart\")),","                     isReversed: true)","","    \/\/ A trailing checkbox with a raw (non-tinted) image.","    OUDSCheckboxItem(\"We live in a fabled world\",","                     isOn: $isOn,","                     description: \"Of dreaming boys and wide-eyed girls\",","                     image: OUDSImage(asset: Image(decorative: \"il_someImage\"), renderingMode: .original),","                     isReversed: true)","","    \/\/ Flip the icon for RTL layouts using OUDSImage.","    OUDSCheckboxItem(\"Cocorico !\",","                     isOn: $isOn,","                     image: OUDSImage(asset: Image(systemName: \"figure.handball\"),","                                     flipped: layoutDirection == .rightToLeft),","                     isReversed: layoutDirection == .rightToLeft)","","    \/\/ If on error, add an error message can help user to understand error context","    OUDSCheckboxItem(\"We live in a fabled world\",","                     isOn: $isOn,","                     isError: true,","                     errorText: .raw(\"Something wrong\"),","                     hasDivider: true)","","    \/\/ The error message is an OUDSTextualContent: raw, localized or rich text","    OUDSCheckboxItem(\"We live in a fabled world\",","                     isOn: $isOn,","                     isError: true,","                     errorText: .localized(\"error_wording\", bundle: Bundle.module))","    OUDSCheckboxItem(\"We live in a fabled world\",","                     isOn: $isOn,","                     isError: true,","                     errorText: .rich(AttributedString(markdown: \"You **must** accept the ToS\"))) \/\/ Manage in your side errors for init","","    \/\/ A leading checkbox with a label, but disabled.","    OUDSCheckboxItem(\"Hello world\", isOn: $isOn)","        .disabled(true)","","    \/\/ Never disable a read only or an error-related checkbox as it will crash","    \/\/ This is forbidden by design!","    OUDSCheckboxItem(\"Hello world\", isOn: $isOn, isError: true).disabled(true) \/\/ fatal error","    OUDSCheckboxItem(\"Hello world\", isOn: $isOn, isReadOnly: true).disabled(true) \/\/ fatal error"]},{"text":"Suggestions","type":"heading","level":2,"anchor":"Suggestions"},{"inlineContent":[{"type":"text","text":"According to the "},{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-checkbox","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the checkbox by default must be used in unselected state."}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-checkbox","overridingTitleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"type":"reference","overridingTitle":"unified-design-system.orange.com","isActive":true}],"type":"paragraph"},{"level":2,"text":"Themes rendering","anchor":"Themes-rendering","type":"heading"},{"type":"heading","text":"Orange","level":3,"anchor":"Orange"},{"inlineContent":[{"type":"image","identifier":"component_checkboxItem_Orange"}],"type":"paragraph"},{"type":"heading","text":"Orange Compact","level":3,"anchor":"Orange-Compact"},{"type":"paragraph","inlineContent":[{"identifier":"component_checkboxItem_OrangeCompact","type":"image"}]},{"anchor":"Sosh","type":"heading","text":"Sosh","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_checkboxItem_Sosh"}]},{"anchor":"Wireframe","type":"heading","text":"Wireframe","level":3},{"inlineContent":[{"type":"image","identifier":"component_checkboxItem_Wireframe"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Version","content":[{"inlineContent":[{"text":"2.4.0 (Figma component design version)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"0.12.0"}],"type":"paragraph"}],"name":"Since","type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","interfaceLanguage":"swift"},"hierarchy":{"paths