:"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"lock icon"}],"type":"strong"},{"type":"text","text":": it helps to reinforce the security context."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Helper text"}],"type":"strong"},{"type":"text","text":":  A supporting text conveys additional information about the password field."}]}]}]},{"type":"heading","level":2,"text":"Outlined style","anchor":"Outlined-style"},{"type":"paragraph","inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look.","type":"text"}]},{"type":"codeListing","code":["   \/\/ An outlined text input","   OUDSPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   OUDSPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"syntax":"swift"},{"type":"heading","level":3,"text":"Rounded layout","anchor":"Rounded-layout"},{"type":"paragraph","inlineContent":[{"text":"As the","type":"text"},{"code":" OUDSTextInput","type":"codeVoice"},{"text":", rounded corners can be enabled or disabled using the ","type":"text"},{"code":"hasRoundedTextInputs","type":"codeVoice"},{"text":" values of the ","type":"text"},{"code":"Tuning","type":"codeVoice"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration.","type":"text"}]},{"type":"heading","level":2,"text":"Status","anchor":"Status"},{"type":"paragraph","inlineContent":[{"text":"As ","type":"text"},{"code":"OUDSPasswordInput","type":"codeVoice"},{"text":" is based on the","type":"text"},{"code":" OUDSTextInput","type":