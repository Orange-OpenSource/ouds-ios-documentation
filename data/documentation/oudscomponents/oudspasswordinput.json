{"abstract":[{"type":"text","text":"Password input is a UI element that allows to securely and confidentially capture a user’s password."},{"type":"text","text":" "},{"type":"text","text":"As it is based on the "},{"type":"codeVoice","code":"OUDSTextInput"},{"type":"text","text":",  it offers same layout and the same elements of configuration."}],"kind":"symbol","sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"OUDSPasswordInput"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPasswordInput"}],"modules":[{"name":"Components"}],"platforms":[{"beta":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"deprecated":false},{"beta":false,"name":"macOS","introducedAt":"13.0","unavailable":false,"deprecated":false},{"beta":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false}],"role":"symbol","title":"OUDSPasswordInput","externalID":"s:14OUDSComponents17OUDSPasswordInputV","roleHeading":"Structure","symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPasswordInput"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","text":"Layout","level":2,"anchor":"Layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Passwords input is based on several configurable UI elements:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"text":": It is used to describe the purpose of the input.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"placeholder"}]},{"text":":  A prefix is not common and is discouraged in a Password Input component. In very specific cases, it can provide","type":"text"},{"text":" ","type":"text"},{"text":"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"lock icon"}]},{"text":": it helps to reinforce the security context.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text"}]},{"text":":  A supporting text conveys additional information about the password field.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Outlined style","level":2,"anchor":"Outlined-style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By "},{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look."}]},{"type":"codeListing","code":["   \/\/ An outlined text input","   OUDSPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   OUDSPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"syntax":"swift"},{"type":"heading","text":"Rounded layout","level":3,"anchor":"Rounded-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As the"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", rounded corners can be enabled or disabled using the "},{"type":"codeVoice","code":"hasRoundedTextInputs"},{"type":"text","text":" values of the "},{"type":"codeVoice","code":"Tuning"},{"type":"text","text":" object"},{"type":"text","text":" "},{"type":"text","text":"in your theme configuration."}]},{"type":"heading","text":"Status","level":2,"anchor":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As "},{"type":"codeVoice","code":"OUDSPasswordInput"},{"type":"text","text":" is based on the"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", all the status are the same and have the same behavior available here "},{"type":"codeVoice","code":"OUDSTextInput.Status"}]},{"type":"heading","text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics"},{"type":"text","text":"."}]},{"type":"heading","text":"Rich text","level":2,"anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    OUDSPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and