{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPasswordInput"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"Layout","type":"heading","level":2,"text":"Layout"},{"type":"paragraph","inlineContent":[{"text":"Passwords input is based on several configurable UI elements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"label","type":"text"}],"type":"strong"},{"text":": It is used to describe the purpose of the input.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"placeholder"}],"type":"strong"},{"text":":  A prefix is not common and is discouraged in a Password Input component. In very specific cases, it can provide","type":"text"},{"text":" ","type":"text"},{"text":"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"lock icon","type":"text"}]},{"type":"text","text":": it helps to reinforce the security context."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text"}]},{"type":"text","text":":  A supporting text conveys additional information about the password field."}],"type":"paragraph"}]}]},{"anchor":"Outlined-style","type":"heading","level":2,"text":"Outlined style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By "},{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"type":"text","text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look."}]},{"type":"codeListing","syntax":"swift","code":["   \/\/ An outlined text input","   OUDSPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   OUDSPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"]},{"anchor":"Rounded-layout","type":"heading","level":3,"text":"Rounded layout"},{"type":"paragraph","inlineContent":[{"text":"As the","type":"text"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", rounded corners can be enabled or disabled using the "},{"type":"codeVoice","code":"hasRoundedInputs"},{"type":"text","text":" values of the "},{"type":"codeVoice","code":"Tuning"},{"type":"text","text":" object"},{"type":"text","text":" "},{"type":"text","text":"in your theme configuration."}]},{"anchor":"Status","type":"heading","level":2,"text":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As "},{"type":"codeVoice","code":"OUDSPasswordInput"},{"type":"text","text":" is based on the"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", all the status are the same and have the same behavior available here "},{"type":"codeVoice","code":"OUDSTextInput.Status"}]},{"anchor":"Accessibility-considerations","type":"heading","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics"},{"type":"text","text":"."}]},{"anchor":"Rich-text","type":"heading","level":2,"text":"Rich text"},{"type":"paragraph","inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text and the error message are ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"},{"text":" ","type":"text"},{"text":"The error message is defined with ","type":"text"},{"code":"OUDSTextInput.Status.textualError(message:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"type":"heading","anchor":"Code-samples","text":"Code samples","level":2},{"type":"codeListing","syntax":"swift","code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    OUDSPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    OUDSPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ The helper text can be localized or rich, the error message too","    OUDSPasswordInput(label: \"Password\", password: $password, helperText: .localized(\"password_helper\", bundle: Bundle.module))","    OUDSPasswordInput(label: \"Password\",","                      password: $password,","                      helperText: .rich(AttributedString(markdown: \"You should use a **strong password**\"))) \/\/ Manage in your side errors for init","    OUDSPasswordInput(label: \"Password\", password: $password, status: .textualError(message: \"The password is too weak\"))","","    \/\/ Password with prefix","    OUDSPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    OUDSPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"]},{"type":"heading","anchor":"Design-documentation","text":"Design documentation","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-password-input"}]},{"type":"heading","anchor":"Themes-rendering","text":"Themes rendering","level":2},{"type":"heading","anchor":"Orange","text":"Orange","level":3},{"type":"paragraph","inlineContent":[{"type":"image","ident