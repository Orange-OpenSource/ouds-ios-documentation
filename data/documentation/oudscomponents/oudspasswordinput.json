ype":"text","text":"Helper text"}],"type":"strong"},{"text":":  A supporting text conveys additional information about the password field.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Outlined style","anchor":"Outlined-style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By "},{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look."}]},{"code":["   \/\/ An outlined text input","   OUDSPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   OUDSPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Rounded layout","anchor":"Rounded-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As the"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", rounded corners can be enabled or disabled using the "},{"type":"codeVoice","code":"hasRoundedTextInputs"},{"type":"text","text":" values of the "},{"type":"codeVoice","code":"Tuning"},{"type":"text","text":" object"},{"type":"text","text":" "},{"type":"text","text":"in your theme configuration."}]},{"level":2,"type":"heading","text":"Status","anchor":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As "},{"type":"codeVoice","code":"OUDSPasswordInput"},{"type":"text","text":" is based on the"},{"type":"codeVoice","code":" OUDSTextInput"},{"type":"text","text":", all the status are the same and have the same behavior available here "},{"type":"codeVoice","code":"OUDSTextInput.Status"}]},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Rich text","anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."},{"type":"text","text":" "},{"type":"text","text":"The helper text and the error message are "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":" values: a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":", a localized string"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"type":"text","text":" or a rich text with "},{"type":"codeVoice","code":".rich(_:)"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Prefer "},{"type":"codeVoice","code":".raw(_:)"},{"type":"text","text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer"},{"type":"text","text":" "},{"type":"text","text":"taking an "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true},{"type":"text","text":" and does not emit a deprecation warning."},{"type":"text","text":" "},{"type":"text","text":"The error message is defined with "},{"type":"codeVoice","code":"OUDSTextInput.Status.textualError(message:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    OUDSPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    OUDSPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ The helper text can be localized or rich, the error message too","    OUDSPasswordInput(label: \"Password\", password: $password, helperText: .localized(\"password_helper\", bundle: Bundle.module))","    OUDSPasswordInput(label: \"Password\",","                      password: $password,","                      helperText: .rich(AttributedString(markdown: \"You should use a **strong password**\"))) \/\/ Manage in your side errors for init","    OUDSPasswordInput(label: \"Password\", password: $password, status: .textualError(message: \"The password is too weak\"))","","    \/\/ Password with prefix","    OUDSPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    OUDSPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Design documentation","anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-password-input","isActive":true}]},{"level":2,"type":"heading","text":"Themes 