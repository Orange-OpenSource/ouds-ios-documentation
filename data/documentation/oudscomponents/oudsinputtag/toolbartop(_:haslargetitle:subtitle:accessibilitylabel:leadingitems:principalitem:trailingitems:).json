t","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"type":"text","text":" is not "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":"."}]}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default, used if no large title nor principal item."}],"type":"paragraph"}]},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}]}]},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" is displayed only if ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", and the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" is never displayed.","type":"text"}]}]},{"name":"trailingItems","content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emp