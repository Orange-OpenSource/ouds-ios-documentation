   \/\/ A simple checkbox, no error, not in read only mode","    OUDSCheckboxIndeterminate(selection: $selection, accessibilityLabel: \"The cake is a lie\")","","    \/\/ A simple checkbox, but is an error context","    OUDSCheckboxIndeterminate(selection: $selection, accessibilityLabel: \"The cake is a lie\"), isError: true)","","    \/\/ Never disable an error-related checkbox as it will crash","    \/\/ This is forbidden by design!","    OUDSCheckboxIndeterminate(selection: $selection, accessibilityLabel: \"The cake is a lie\"), isError: true).disabled(true) \/\/ fatal error"],"syntax":"swift"},{"type":"heading","text":"Suggestions","level":2,"anchor":"Suggestions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"According to the "},{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-checkbox","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the checkbox by default must be used in unselected state."}]},{"type":"heading","text":"Design documentation","level":2,"anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-checkbox","overridingTitleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"isActive":true,"overridingTitle":"unified-design-system.orange.com","type":"reference"}]},{"type":"heading","level":2,"anchor":"Themes-rendering","text":"Themes rendering"},{"type":"heading","level":3,"anchor":"Orange","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_checkbox_Orange","type":"image"}]},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_checkbox_OrangeCompact"}]},{"anchor":"Sosh","text":"Sosh","type":"heading","level":3},{"inlineContent":[{"type":"image","identifier":"component_checkbox_Sosh"}],"type":"paragraph"},{"type":"heading","text":"Wireframe","level":3,"ancho