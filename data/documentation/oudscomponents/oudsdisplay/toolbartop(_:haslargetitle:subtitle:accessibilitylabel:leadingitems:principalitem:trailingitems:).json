ns"},{"kind":"parameters","parameters":[{"name":"title","content":[{"inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}],"type":"paragraph"}]},{"name":"hasLargeTitle","content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"false"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is not displayed for iOS < 26."}],"type":"paragraph"}]},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]}]}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}]},{"name":"leadingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{