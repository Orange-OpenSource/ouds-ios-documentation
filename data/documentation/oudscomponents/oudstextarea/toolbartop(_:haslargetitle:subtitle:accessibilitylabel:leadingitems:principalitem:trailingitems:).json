:"text"},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"type":"codeVoice","code":"principalItem"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"strong"}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}]},{"name":"leadingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"text":" by default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" is never displayed.","type":"text"}]}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}],"name":"trailingItems"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The view which contains this ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":" must be placed inside a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}]},{"inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"