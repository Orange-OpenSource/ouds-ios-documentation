arations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}]}],"name":"title"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"type":"text","text":" by default. If large mode, the "},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"type":"text","text":" is not displayed for iOS < 26."}]}],"name":"hasLargeTitle"},{"name":"subtitle","content":[{"inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}]}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"type":"text","text":" and the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default, used if no large title nor principal item."}]}]},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}]},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is never displayed."}]}]},{"name":"trailingItems","content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The view which contains this "},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":" must be placed inside a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There must be only one "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text