t":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default. "},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"type":"text","text":" is not "},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"strong"}]}],"name":"subtitle"},{"content":[{"inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}],"type":"paragraph"}],"name":"accessibilityLabel"},{"name":"leadingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"text":", and the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is never displayed."}]}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the trailing side, "},{"type":"emphasis","