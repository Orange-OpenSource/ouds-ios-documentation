{"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsswitchitem"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSwitchItem","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","anchor":"Layouts","text":"Layouts","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component can be rendered as two different layouts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":": the component has a leading indicator, a label and optional texts, and an optional trailing decorative icon"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"inverse"}]},{"type":"text","text":": like the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" layout but with a trailing switch indicator and a leading optional decorative icon"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Edge-To-Edge","text":"Edge To Edge","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The item can be used as edge to edge, means it is designed to span the full width of the screen so a default horizontal padding equal to margin is added."},{"type":"text","text":" "},{"type":"text","text":"In other case it is adapted for use within constrained layouts or containers with their own padding."},{"type":"text","text":" "},{"type":"text","text":"To control the edge to edge usage, call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/isEdgeToEdge(_:)"},{"type":"text","text":" on top of view containing the items."}]},{"type":"heading","text":"Indicator states","anchor":"Indicator-states","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch indicator has two available states set as a boolean property that determines whether the toggle is on or off."}]},{"type":"heading","text":"Particular cases","anchor":"Particular-cases","level":2},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem","type":"reference","isActive":true},{"text":" can be related to an error situation, for example troubles for a form.","type":"text"},{"text":" ","type":"text"},{"text":"A dedicated look and feel is implemented for that if the ","type":"text"},{"code":"isError","type":"codeVoice"},{"text":" flag is risen.","type":"text"},{"text":" ","type":"text"},{"text":"In that case if the component displayed an icon, this icon will be replaced automatically by an error icon.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In addition, the ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem","type":"reference","isActive":true},{"text":" can be in read only mode, i.e. the user cannot interact with the component yet but this component must not be considered","type":"text"},{"text":" ","type":"text"},{"text":"as disabled.","type":"text"}]},{"anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations","type":"heading"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Voice Over","type":"text"}]},{"type":"text","text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and optional texts and a custom switch trait."}],"type":"paragraph"},{"type":"heading","text":"Forbidden by design","anchor":"Forbidden-by-design","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both an error situation and a read only component.","type":"text"}]},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both an error situation and a disabled component.","type":"text"}]},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both a read only and a disabled component.","type":"text"}]}],"type":"paragraph"},{"type":"heading","text":"Code samples","anchor":"Code-samples","level":2},{"syntax":"swift","code":["    \/\/ Supposing we have an unselected state","    @Published var isOn: Bool = false","","    \/\/ A leading switch with a label.","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn)","","    \/\/ Localizable from bundle can also be used","    OUDSSwitchItem(LocalizedStringKey(\"notifications_setting\"), bundle: Bundle.module, isOn: $isOn)","","    \/\/ A leading switch with a label, but in read only mode (user cannot interact yet, but not disabled).","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn, isReadOnly: true)","","    \/\/ A leading switch with a label and a description text.","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn, description: \"The Beatles\")","","    \/\/ A trailing switch with a label, a description and a tinted icon.","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   description: \"The Beatles\",","                   image: OUDSImage(asset: Image(decorative: \"ic_heart\")),","                   isReversed: true)","","    \/\/ A trailing switch with a raw (non-tinted) image.","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   description: \"The Beatles\",","                   image: OUDSImage(asset: Image(decorative: \"il_someImage\"), renderingMode: .original),","                   isReversed: true)","","    \/\/ Flip the icon for RTL layouts using OUDSImage.","    OUDSSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   image: OUDSImage(asset: Image(systemName: \"figure.handball\"),","                                   flipped: layoutDirection == .rightToLeft))","","    \/\/ If on error, add an error message to help user understand the error context","    OUDSSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .raw(\"Something wrong\"),","                   hasDivider: true)","","    \/\/ The error message is an OUDSTextualContent: raw (string literal), localized or rich text","    OUDSSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .localized(\"error_wording\", bundle: Bundle.module))","    OUDSSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .rich(AttributedString(markdown: \"You **must** enable it\"))) \/\/ Manage in your side errors for init","","    \/\/ A leading switch with a label, but disabled.","    OUDSSwitchItem(\"Rescue from this world!\", isOn: $isOn)","        .disabled(true)","","    \/\/ Never disable a read only or an error-related switch as it will crash","    \/\/ This is forbidden by design!","    OUDSSwitchItem(\"Kaboom!\", isOn: $isOn, isError: true).disabled(true) \/\/ fatal error","    OUDSSwitchItem(\"Kaboom!\", isOn: $isOn, isReadOnly: true).disabled(true) \/\/ fatal error"],"type":"codeListing"},{"level":2,"text":"Rich text","type":"heading","anchor":"Rich-text"},{"inlineContent":[{"text":"Rich text can only be used for error messages.","type":"text"},{"text":" ","type":"text"},{"text":"The error message is an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":": a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" (a string literal is enough), a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for a raw message, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Accessibility considerations","type":"heading","anchor":"Accessibility-considerations"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Design documentation","type":"heading","anchor":"Design-documentation"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-switch","isActive":true,"type":"reference"}],"type":"paragraph"},{"level":2,"text":"Themes rendering","type":"heading","anchor":"Themes-rendering"},{"level":3,"text":"Orange","type":"heading","anchor":"Orange"},{"inlineContent":[{"identifier":"component_switchItem_Orange","type":"image"}],"type":"paragraph"},{"level":3,"text":"Orange Compact","type":"heading","anchor":"Orange-Compact"},{"inlineContent":[{"identifier":"component_switchItem_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"text":"Sosh","type":"heading","anchor":"Sosh"},{"inlineContent":[{"identifier":"component_switchItem_Sosh","type":"image"}],"type":"paragraph"},{"level":3,"text":"Wireframe","type":"heading","anchor":"Wireframe"},{"inlineContent":[{"identifier":"component_switchItem_Wireframe","type":"image"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"1.5.0 (Figma component design version)"}],"type":"paragraph"}],"name":"Version","type":"aside","style":"note"},{"type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"0.14.0","type":"text"}]}],"style":"note"}]}],"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-4yw94","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-8jy7d","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-92mad","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSwitchItem\/in