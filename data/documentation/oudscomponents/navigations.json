:"codeVoice","code":"small"},{"type":"text","text":" or "},{"code":"default","type":"codeVoice"},{"text":" size.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Text in small size, with next indicator","OUDSLink(text: \"Feedback\", indicator: .next, size: .small) { \/* the action to process *\/ }","","\/\/ Text and icon in default size","OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) {}","","\/\/ Text and raw icon (not tinted)","OUDSLink(text: \"Brand\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","OUDSLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"]},{"text":"List items","type":"heading","level":3,"anchor":"List-items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":" displays a non-interactive row of information, while "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"type":"text","text":" adds tap interaction and a navigation affordance indicator (chevron or external link icon)."}]},{"type":"paragraph","inlineContent":[{"text":"Both components use an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","type":"reference"},{"text":" model for their textual content, and accept optional leading and trailing elements.","type":"text"}]},{"text":"Static list item","type":"heading","level":4,"anchor":"Static-list-item"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":" when the row is display-only and should not trigger any action or navigation."}]},{"tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_static_list_item_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_static_list_item_OrangeCompact","type":"image"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_static_list_item_Sosh"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_static_list_item_Wireframe"}]}]}],"type":"tabNavigator"},{"code":["\/\/ Simple list item with a label only","OUDSStaticListItem(data: OUDSListItemData(label: \"Label\"))","","\/\/ List item with full textual content","OUDSStaticListItem(data: OUDSListItemData(","    label: \"Label\",","    hasBoldLabel: true,","    description: \"Description\",","    overline: \"Overline\",","    extraLabel: \"Extra label\",","    helperText: \"Helper text providing guidance\"","))","","\/\/ List item with a leading icon and a trailing badge","let icon = OUDSListItemIcon(type: .info, size: .medium)","","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Notifications\"),","    leading: .icon(icon),","    trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))",")"],"type":"codeListing","syntax":"swift"},{"text":"Navigable list item","type":"heading","level":4,"anchor":"Navigable-list-item"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"type":"text","text":" when tapping the row should trigger an action. The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType"},{"type":"text","text":" defines the visual indicator shown:"}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_navigation_list_item_Orange"}]}],"title":"Orange"},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_navigation_list_item_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"type":"image","identifier":"component_navigation_list_item_Sosh"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_navigation_list_item_Wireframe"}]}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Forward navigation (default)","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Next screen\")",") {","    \/\/ Navigate to next screen","}","","\/\/ External navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Open website\"),","    indicatorType: .external",") {","    openURL(url)","}","","\/\/ Backward navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Go back\"),","    indicatorType: .previous",") {","    \/\/ Navigate back","}","","\/\/ With a leading avatar and a trailing text","let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","    leading: .avatar(avatar),","    trailing: .text(.labelMuted(\"Details\"))",") {","    \/\/ Navigate to profile","}"]},{"level":3,"type":"heading","text":"Tab bars","anchor":"Tab-bars"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark"}]}],"title":"Orange (Liquid Glass)"},{"title":"Orange Compact (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"}]}]},{"title":"Sosh (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}]}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Orange_dark"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_OrangeCompact_dark","type":"image"}]}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Sosh_dark"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}]}],"title":"Wireframe"}]},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"text":" provides a native SwiftUI ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" with use of OUDS effects and styles.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"text":" lets users define their own hierarchy of views associated to tab items.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Use the OUDS tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","OUDSTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside OUDSTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"]},{"anchor":"Tab-views","type":"heading","text":"Tab views","level":3},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","type":"reference","isActive":true},{"type":"text","text":" use the native SwiftUI "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" API with OUDS styles."},{"type":"text","text":" "},{"type":"text","text":"They are complementary to "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView","type":"reference","isActive":true},{"type":"text","text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a "},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" for programmatic selection, requires an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" on every "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true,"type":"reference"},{"text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" without ","type":"text"},{"code":"value:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Tab(role: .search)","type":"codeVoice"},{"text":", selection is managed natively.","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/ OUDSTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","OUDSTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ OUDSLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","OUDSLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Toolbars","anchor":"Toolbars"},{"inlineContent":[{"type":"text","text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose OUDS styles."},{"type":"text","text":" "},{"type":"text","text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older)."}],"type":"paragraph"},{"type":"heading","level":4,"text":"Top toolbar","anchor":"Top-toolbar"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}]}],"title":"Orange (Liquid Glass)"},{"content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}],"title":"Orange Compact (Liquid Glass)"},{"content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Sosh_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_Sosh_dark","type":"image"}],"type":"paragraph"}],"title":"Sosh (Liquid Glass)"},{"content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Wireframe_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}],"title":"Wireframe (Liquid Glass)"}]},{"tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_toolBarTop_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_toolBarTop_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_Sosh_dark","type":"image"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_Wireframe_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_Wireframe_dark","type":"image"}]}]}],"type":"tabNavigator"},{"syntax":"swift","code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        OUDSToolBarItem(navigation: .back())","                    },","                    trailingItems: {","                        OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".oudsNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"],"type":"codeListing"},{"level":4,"anchor":"Bottom-toolbar","type":"heading","text":"Bottom toolbar"},{"tabs":[{"title":"Orange (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Orange_dark"}]}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_dark"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Wireframe_light","type":"image"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Wireframe_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Orange_light"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_dark"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_Sosh_dark","type":"image"}]}]},{"title":"Wireframe","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_Wireframe_dark"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Leading + trailing split — works on all supported OS versions","SomeView()","    .toolBarBottom(leadingItems: {","        OUDSToolBarItem(label: \"Some label\") { \/* Action to process *\/ }","    }, trailingItems: {","        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","    })","","\/\/ Grouped \/ centered — meaningful on iOS 26+ (Liquid Glass) only","\/\/ On earlier OS versions the system splits the items into leading\/trailing positions.","SomeView()","    .toolBarBottom(groupedItems: {","        OUDSToolBarItem(label: \"Save\") { \/* Action to process *\/ }","        OUDSToolBarItem(icon: Image(decorative: \"ic_delete\"), accessibilityLabel: \"Delete\") { \/* Action to process *\/ }","    })"]}]}],"references":{"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"component_static_list_item_Wireframe":{"identifier":"component_static_list_item_Wireframe","alt":"A list item component in light and dark modes with Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_static_list_item_Wire