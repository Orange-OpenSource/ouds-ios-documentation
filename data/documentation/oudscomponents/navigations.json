{"kind":"article","metadata":{"modules":[{"name":"Components"}],"title":"Navigations","role":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/oudscomponents\/navigations"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"heading","anchor":"Links","level":3,"text":"Links"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_link_Orange"}]}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_link_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_link_Sosh"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_link_Wireframe","type":"image"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","isActive":true,"type":"reference"},{"text":" proposes layout with text only or text with icon.","type":"text"},{"text":" ","type":"text"},{"text":"It also proposes layout to navigate forward, backward and outside the app.","type":"text"},{"text":" ","type":"text"},{"text":"The link can be displayed in ","type":"text"},{"type":"codeVoice","code":"small"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" size.","type":"text"}]},{"type":"codeListing","code":["\/\/ Text in small size, with next indicator","OUDSLink(text: \"Feedback\", indicator: .next, size: .small) { \/* the action to process *\/ }","","\/\/ Text and icon in default size","OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) {}","","\/\/ Text and raw icon (not tinted)","OUDSLink(text: \"Brand\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","OUDSLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"],"syntax":"swift"},{"type":"heading","anchor":"List-items","level":3,"text":"List items"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"text":" displays a non-interactive row of information, while ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true},{"text":" adds tap interaction and a navigation affordance indicator (chevron or external link icon).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both components use an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","isActive":true,"type":"reference"},{"text":" model for their textual content, and accept optional leading and trailing elements.","type":"text"}]},{"level":4,"anchor":"Static-list-item","type":"heading","text":"Static list item"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":" when the row is display-only and should not trigger any action or navigation."}]},{"tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_static_list_item_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"inlineContent":[{"type":"image","identifier":"component_static_list_item_OrangeCompact"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_static_list_item_Sosh","type":"image"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_static_list_item_Wireframe"}]}]}],"type":"tabNavigator"},{"code":["\/\/ Simple list item with a label only","OUDSStaticListItem(data: OUDSListItemData(label: \"Label\"))","","\/\/ List item with full textual content","OUDSStaticListItem(data: OUDSListItemData(","    label: \"Label\",","    hasBoldLabel: true,","    description: \"Description\",","    overline: \"Overline\",","    extraLabel: \"Extra label\",","    helperText: \"Helper text providing guidance\"","))","","\/\/ List item with a leading icon and a trailing badge","let icon = OUDSListItemIcon(status: .info, description: \"\", size: .medium)","","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Notifications\"),","    leading: .icon(icon),","    trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))",")","","\/\/ List item with a leading image (static asset)","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Product\"),","    leading: .image(OUDSListItemImage(asset: Image(\"product_thumb\"), size: .medium))",")","","\/\/ List item with a leading async image (from URL)","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Remote Product\"),","    leading: .image(OUDSListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")), description: \"Product image\", size: .medium))",")","","\/\/ List item with async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Loading Product\"),","    leading: .image(OUDSListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product image\", size: .medium))",")","","\/\/ List item with a trailing image","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Status\"),","    trailing: .image(OUDSListItemImage(asset: Image(\"status_icon\"), size: .small))",")"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"Navigable-list-item","type":"heading","text":"Navigable list item"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"type":"text","text":" when tapping the row should trigger an action. The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType"},{"type":"text","text":" defines the visual indicator shown:"}]},{"tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_navigation_list_item_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_navigation_list_item_OrangeCompact"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_navigation_list_item_Sosh"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_navigation_list_item_Wireframe","type":"image"}]}]}],"type":"tabNavigator"},{"syntax":"swift","type":"codeListing","code":["\/\/ Forward navigation (default)","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Next screen\")",") {","    \/\/ Navigate to next screen","}","","\/\/ External navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Open website\"),","    indicatorType: .external",") {","    openURL(url)","}","","\/\/ Backward navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Go back\"),","    indicatorType: .previous",") {","    \/\/ Navigate back","}","","\/\/ With a leading avatar and a trailing text","let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","    leading: .avatar(avatar),","    trailing: .text(.labelMuted(\"Details\"))",") {","    \/\/ Navigate to profile","}","","\/\/ With a leading async image loaded from URL","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Product\", description: \"View product details\"),","    leading: .image(OUDSListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")), description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ With async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Loading Product\", description: \"View product details\"),","    leading: .image(OUDSListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}"]},{"text":"Tab bars","anchor":"Tab-bars","type":"heading","level":3},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image"}]}],"title":"Orange (Liquid Glass)"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"}]}],"title":"Orange Compact (Liquid Glass)"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}],"type":"paragraph"}],"title":"Sosh (Liquid Glass)"},{"content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Wireframe_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}],"title":"Wireframe (Liquid Glass)"}],"type":"tabNavigator"},{"tabs":[{"title":"Orange","content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Orange_dark"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_OrangeCompact_dark","type":"image"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Sosh_dark"}]}]},{"title":"Wireframe","content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"type":"text","text":" provides a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" with use of OUDS effects and styles."},{"type":"text","text":" "},{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"type":"text","text":" lets users define their own hierarchy of views associated to tab items."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Use the OUDS tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","OUDSTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside OUDSTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"],"type":"codeListing"},{"anchor":"Tab-views","text":"Tab views","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"OUDSTabView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OUDSLiquidGlassTabView","type":"codeVoice"},{"text":" use the native SwiftUI ","type":"text"},{"type":"codeVoice","code":"Tab"},{"text":" API with OUDS styles.","type":"text"},{"text":" ","type":"text"},{"text":"They are complementary to ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"OUDSTabView"},{"type":"text","text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a "},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" for programmatic selection, requires an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" on every "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OUDSLiquidGlassTabView"},{"type":"text","text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" without "},{"type":"codeVoice","code":"value:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":", selection is managed natively."}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["\/\/ OUDSTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","OUDSTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ OUDSLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","OUDSLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"]},{"anchor":"Toolbars","level":3,"type":"heading","text":"Toolbars"},{"inlineContent":[{"text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose OUDS styles.","type":"text"},{"text":" ","type":"text"},{"text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older).","type":"text"}],"type":"paragraph"},{"text":"Top toolbar","type":"heading","level":4,"anchor":"Top-toolbar"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_Orange_dark","type":"image"}]}],"title":"Orange (Liquid Glass)"},{"content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}],"title":"Orange Compact (Liquid Glass)"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_dark"}],"type":"paragraph"}],"title":"Sosh (Liquid Glass)"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_dark"}]}],"title":"Wireframe (Liquid Glass)"}],"type":"tabNavigator"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_toolBarTop_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_Orange_dark","type":"image"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_OrangeCompact_dark"}]}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_Sosh_dark"}],"type":"paragraph"}],"title":"Sosh"},{"title":"Wireframe","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_Wireframe_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"codeListing","syntax":"swift","code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        OUDSToolBarItem(navigation: .back())","                    },","                    trailingItems: {","                        OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".oudsNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"]},{"level":4,"anchor":"Bottom-toolbar","type":"heading","text":"Bottom toolbar"},{"type":"tabNavigator","tabs":[{"title":"Orange (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_LiquidGlass_Orange_dark","type":"image"}]}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_dark"}]}]},{"title":"Wireframe (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Wireframe_dark"}]}]}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_Orange_dark","type":"image"}]}],"title":"Orange"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_dark"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_Sosh_dark"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_Wireframe_dark"}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Leading + trailing split — works on all supported OS versions","SomeView()","    .toolBarBottom(leadingItems: {","        OUDSToolBarItem(label: \"Some label\") { \/* Action to process *\/ }","    }, trailingItems: {","        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","    })","","\/\/ Grouped \/ centered — meaningful on iOS 26+ (Liquid Glass) only","\/\/ On earlier OS versions the system splits the items into leading\/trailing positions.","SomeView()","    .toolBarBottom(groupedItems: {","        OUDSToolBarItem(label: \"Save\") { \/* Action to process *\/ }","        OUDSToolBarItem(icon: Image(decorative: \"ic_delete\"), accessibilityLabel: \"Delete\") { \/* Action to process *\/ }","    })"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":"."}],"references":{"component_static_list_item_Sosh":{"identifier":"component_static_list_item_Sosh","alt":"A list item component in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_static_list_item_Sosh.png","traits":["1x","light"]}],"type":"image"},"component_toolBarBottom_Sosh_light":{"alt":"A toolbar bottom component with Liquid Glass in light mode with Sosh theme","identifier":"component_toolBarBottom_Sosh_light","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_toolBarBottom_Sosh_light.png","traits":["1x","light"]}]},"component_toolBarBottom_Orange_light":{"identifier":"component_toolBar