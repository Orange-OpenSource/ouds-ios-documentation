nt":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Orange_dark"}]}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_OrangeCompact_dark"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_Sosh_dark","type":"image"}]}]},{"content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"text":" provides a native SwiftUI ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" with use of OUDS effects and styles.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"text":" lets users define their own hierarchy of views associated to tab items.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Use the OUDS tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","OUDSTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside OUDSTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Tab views","anchor":"Tab-views"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true,"type":"reference"},{"type":"text","text":" use the native SwiftUI "},{"code":"Tab","type":"codeVoice"},{"type":"text","text":" API with OUDS styles."},{"type":"text","text":" "},{"type":"text","text":"They are complementary to "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView"},{"type":"text","text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a "},{"type":"codeVoice","code":"Binding<Int>"},{"text":" for programmatic selection, requires an explicit ","type":"text"},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" on every "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true,"type":"reference"},{"text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" without ","type":"text"},{"code":"value:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Tab(role: .search)","type":"codeVoice"},{"text":", selection is managed natively.","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["\/\/ OUDSTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","OUDSTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"]},{"type":"codeListing","code":["\/\/ OUDSLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","OUDSLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Toolbars","anchor":"Toolbars"},{"type":"paragraph","inlineContent":[{"text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose OUDS styles.","type":"text"},{"text":" ","type":"text"},{"text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions.","type":"text"}]},{"inlineContent":[{"text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older).","type":"text"}],"type":"paragraph"},{"anchor":"Top-toolbar","level":4,"text":"Top toolbar","type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Orange (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_Orange_dark","type":"image"}]}]},{"title":"Orange Compact 