rand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","OUDSLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"]},{"anchor":"Tab-bars","type":"heading","level":3,"text":"Tab bars"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark"}]}],"title":"Orange (Liquid Glass)"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"}]}],"title":"Orange Compact (Liquid Glass)"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}]}],"title":"Sosh (Liquid Glass)"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_dark"}]}],"title":"Wireframe (Liquid Glass)"}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Orange_dark"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_OrangeCompact_dark"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Sosh_dark"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}]}],"title":"Wireframe"}]},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"type":"text","text":" provides a native SwiftUI "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" with use of OUDS effects and styles."},{"type":"text","text":" "},{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"type":"text","text":" lets users define their own hierarchy of views associated to tab items."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Use the OUDS tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","OUDSTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside OUDSTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"]},{"anchor":"Tab-views","type":"heading","level":3,"text":"Tab views"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView"},{"text":" use the native SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" API with OUDS styles.","type":"text"},{"text":" ","type":"text"},{"text":"They are complementary to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView","isActive":true},{"text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a ","type":"text"},{"type":"codeVoice","code":"Binding<Int>"},{"text":" for programmatic selection, requires an explicit ","type":"text"},{"type":"codeVoice","code":"value: Int"},{"text":" on every ","type":"text"},{"type":"codeVoice","code":"Tab"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true,"type":"reference"},{"text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" without ","type":"text"},{"code":"value:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Tab(role: .search)","type":"codeVoice"},{"text":", selection is managed natively.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ OUDSTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","OUDSTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ OUDSLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","OUDSLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"]},{"anchor":"Toolbars","type":"heading","level":3,"text":"Toolbars"},{"inlineContent":[{"text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose OUDS styles.","type":"text"},{"text":" ","type":"text"},{"text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older).","type":"text"}],"type":"paragraph"},{"anchor":"Top-toolbar","text":"Top toolbar","type":"heading","level":4},{"tabs":[{"title":"Orange (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}],"type":"paragraph"}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_dark"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_Orange_dark","type":"image"}]}],"title":"Orange"},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_OrangeCompact_dark"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_Sosh_dark"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_Wireframe_dark"}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        OUDSToolBarItem(navigation: .back())","                    },","                    trailingItems: {","                        OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".oudsNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"]},{"anchor":"Bottom-toolbar","type":"heading","level":4,"text":"Bottom toolbar"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Orange_dark"}],"type":"paragraph"}],"title":"Orange (Liquid Glass)"},{"title":"Orange Compact (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_dark"}]}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Sosh_dark"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_Wireframe_dark"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_Orange_dark"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_OrangeCompact_dark"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_Sosh_dark"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_Wireframe_dark"}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Leading + trailing split — works on all supported OS versions","SomeView()","    .toolBarBottom(leadingItems: {","        OUDSToolBarItem(label: \"Some label\") { \/* Action to process *\/ }","    }, trailingItems: {","        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","    })","","\/\/ Grouped \/ centered — meaningful on iOS 26+ (Liquid Glass) only","\/\/ On earlier OS versions the system splits the items into leading\/trailing positions.","SomeView()","    .toolBarBottom(groupedItems: {","        OUDSToolBarItem(label: \"Save\") { \/* Action to process *\/ }","        OUDSToolBarItem(icon: Image(decorative: \"ic_delete\"), accessibilityLabel: \"Delete\") { \/* Action to process *\/ }","    })"]}]}],"sections":[],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/navigations"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"strong"},{"type":"text","text":"."}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabView":{"type":"topic","abstract":[{"text":"A tab view component that accepts native SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" items (iOS 18+) while applying the full OUDS","type":"text"},{"text":" ","type":"text"},{"text":"tab bar appearance — colors, typography, top divider and selected-tab indicator — just like ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabView","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTabView","kind":"identifier"}],"title":"OUDSTabView","url":"\/documentation\/oudscomponents\/oudstabview","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabView","kind":"symbol","role":"symbol"},"component_tabBar_OrangeCompact_dark":{"type":"image","alt":"A tab bar component without Liquid Glass in dark mode with Orange Compact theme","identifier":"component_tabBar_OrangeCompact_dark","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_dark.png"}