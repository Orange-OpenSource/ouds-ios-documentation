{"variants":[{"paths":["\/documentation\/oudscomponents\/navigations"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"roleHeading":"Article","title":"Navigations"},"kind":"article","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"navigation"}]},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"text":"Links","type":"heading","level":3,"anchor":"Links"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_link_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_link_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_link_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_link_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","type":"reference","isActive":true},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward, backward and outside the app."},{"type":"text","text":" "},{"type":"text","text":"The link can be displayed in "},{"type":"codeVoice","code":"small"},{"type":"text","text":" or "},{"type":"codeVoice","code":"default"},{"type":"text","text":" size."}]},{"code":["\/\/ Text in small size, with next indicator","OUDSLink(text: \"Feedback\", indicator: .next, size: .small) { \/* the action to process *\/ }","","\/\/ Text and icon in default size","OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) {}","","\/\/ Text and raw icon (not tinted)","OUDSLink(text: \"Brand\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","OUDSLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"List items","anchor":"List-items","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"type":"text","text":" displays a non-interactive row of information, while "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"type":"text","text":" adds tap interaction and a navigation affordance indicator (chevron or external link icon)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both components use an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","type":"reference","isActive":true},{"type":"text","text":" model for their textual content, and accept optional leading and trailing elements."}]},{"type":"heading","text":"Static list item","anchor":"Static-list-item","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"type":"text","text":" when the row is display-only and should not trigger any action or navigation."}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_static_list_item_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_static_list_item_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_static_list_item_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_static_list_item_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"code":["\/\/ Simple list item with a label only","OUDSStaticListItem(data: OUDSListItemData(label: \"Label\"))","","\/\/ List item with full textual content","OUDSStaticListItem(data: OUDSListItemData(","    label: \"Label\",","    hasBoldLabel: true,","    description: \"Description\",","    overline: \"Overline\",","    extraLabel: \"Extra label\",","    helperText: \"Helper text providing guidance\"","))","","\/\/ List item with a leading icon and a trailing badge","let icon = OUDSListItemIcon(status: .info, description: \"\", size: .medium)","","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Notifications\"),","    leading: .icon(icon),","    trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))",")","","\/\/ List item with a leading image (static asset)","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Product\"),","    leading: .image(OUDSListItemImage(asset: Image(\"product_thumb\"), size: .medium))",")","","\/\/ List item with a leading async image (from URL)","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Remote Product\"),","    leading: .image(OUDSListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")), description: \"Product image\", size: .medium))",")","","\/\/ List item with async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Loading Product\"),","    leading: .image(OUDSListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product image\", size: .medium))",")","","\/\/ List item with a trailing image","OUDSStaticListItem(","    data: OUDSListItemData(label: \"Status\"),","    trailing: .image(OUDSListItemImage(asset: Image(\"status_icon\"), size: .small))",")","","\/\/ List item with slot (displayed under texts, before helper text)","OUDSStaticListItem(","    data: OUDSListItemData(","        label: \"With slot\",","        textSlot: .init { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with bottom slot (displayed under main content, before helper text)","OUDSStaticListItem(","    data: OUDSListItemData(","        label: \"With bottom slot\",","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with both slot and bottomSlot","OUDSStaticListItem(","    data: OUDSListItemData(","        label: \"Label\",","        textSlot: .init { Text(\"Slot content\") },","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Navigable list item","anchor":"Navigable-list-item","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"type":"text","text":" when tapping the row should trigger an action. The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType","type":"reference","isActive":true},{"type":"text","text":" defines the visual indicator shown:"}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_navigation_list_item_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_navigation_list_item_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_navigation_list_item_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_navigation_list_item_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"code":["\/\/ Forward navigation (default)","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Next screen\")",") {","    \/\/ Navigate to next screen","}","","\/\/ External navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Open website\"),","    indicatorType: .external",") {","    openURL(url)","}","","\/\/ Backward navigation","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Go back\"),","    indicatorType: .previous",") {","    \/\/ Navigate back","}","","\/\/ With a leading avatar and a trailing text","let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","    leading: .avatar(avatar),","    trailing: .text(.labelMuted(\"Details\"))",") {","    \/\/ Navigate to profile","}","","\/\/ With a leading async image loaded from URL","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Product\", description: \"View product details\"),","    leading: .image(OUDSListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")), description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ With async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","OUDSNavigationListItem(","    data: OUDSListItemData(label: \"Loading Product\", description: \"View product details\"),","    leading: .image(OUDSListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ List item with slot (displayed under texts, before helper text)","OUDSNavigationListItem(","    data: OUDSListItemData(","        label: \"Settings\",","        textSlot: .init { Text(\"Configure options\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}","","\/\/ List item with bottomSlot (displayed under main content, before helper text)","OUDSNavigationListItem(","    data: OUDSListItemData(","        label: \"Profile\",","        bottomSlot: .init { Text(\"Additional info\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to profile","}","","\/\/ List item with both slot and bottomSlot","OUDSNavigationListItem(","    data: OUDSListItemData(","        label: \"Settings\",","        textSlot: { Text(\"Slot content\") },","        bottomSlot: { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Tab bars","anchor":"Tab-bars","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_LiquidGlass_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_tabBar_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_tabBar_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_tabBar_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_tabBar_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_Wireframe_dark","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"type":"text","text":" provides a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" with use of OUDS effects and styles."},{"type":"text","text":" "},{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"type":"text","text":" lets users define their own hierarchy of views associated to tab items."}]},{"code":["\/\/ Use the OUDS tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","OUDSTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside OUDSTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Tab views","anchor":"Tab-views","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSTabView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OUDSLiquidGlassTabView"},{"type":"text","text":" use the native SwiftUI "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" API with OUDS styles."},{"type":"text","text":" "},{"type":"text","text":"They are complementary to "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"OUDSTabView"},{"type":"text","text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a "},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" for programmatic selection, requires an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" on every "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"OUDSLiquidGlassTabView"},{"type":"text","text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" without "},{"type":"codeVoice","code":"value:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":", selection is managed natively."}],"type":"paragraph"}]}]},{"code":["\/\/ OUDSTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","OUDSTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ OUDSLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","OUDSLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Toolbars","anchor":"Toolbars","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose OUDS styles."},{"type":"text","text":" "},{"type":"text","text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older)."}]},{"type":"heading","text":"Top toolbar","anchor":"Top-toolbar","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_toolBarTop_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_toolBarTop_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_toolBarTop_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_toolBarTop_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_Wireframe_dark","type":"image"}],"type":"paragraph"}]}]},{"code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        OUDSToolBarItem(navigation: .back())","                    },","                    trailingItems: {","                        OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".oudsNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    OUDSToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Bottom toolbar","anchor":"Bottom-toolbar","level":4},{"type":"tabNavigator","tabs":[{"title":"Orange (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_LiquidGlass_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_LiquidGlass_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_Wireframe_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_LiquidGlass_Wireframe_dark","type":"image"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_Orange_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_Orange_dark","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_OrangeCompact_dark","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarBottom_Sosh_dark","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineConte