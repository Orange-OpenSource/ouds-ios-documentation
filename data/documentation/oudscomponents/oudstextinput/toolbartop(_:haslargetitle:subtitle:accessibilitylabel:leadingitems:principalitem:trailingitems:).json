e","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"false"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" is not displayed for iOS < 26.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":" displayed below the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Never displayed if "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}]}]}],"name":"subtitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"type":"text","text":" by default."}]}],"name":"leadingItems"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" is never displayed.","type":"text"}]}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"text":" by default.","type":"text"}]}],"name":"trailingItems"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}]},{"type":"paragraph","inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput":{"abstract":[{"type":"text","text":"Text input is a UI element that allows to enter, edit, or select single-line textual data."},{"type":"text","text":" "},{"type":"t