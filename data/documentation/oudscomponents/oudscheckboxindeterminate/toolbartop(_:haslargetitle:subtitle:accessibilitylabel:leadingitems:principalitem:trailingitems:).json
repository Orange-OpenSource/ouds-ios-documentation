rong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"text":" ","type":"text"},{"text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxIndeterminate"]]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSToolBarItemsBuilder":{"abstract":[{"type":"text","text":"A result builder to group "},{"isActive":true,"type":"reference","identi