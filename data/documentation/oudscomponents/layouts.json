d link in light and dark modes with Sosh theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Sosh.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSVerticalDivider":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSVerticalDivider"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","isActive":true},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."}],"url":"\/documentation\/oudscomponents\/oudsverticaldivider","navigatorTitle":[{"kind":"identifier","text":"OUDSVerticalDivider"}],"title":"OUDSVerticalDivider","kind":"symbol","type":"topic"},"component_coloredSurface_Wireframe":{"identifier":"component_coloredSurface_Wireframe","alt":"A colored surface with text, button and link in light and dark modes with Wireframe theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Wireframe.png","traits":["1x","light"]}]},"component_coloredSurface_Orange":{"identifier":"component_coloredSurface_Orange","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_coloredSurface_Orange.png"}],"alt":"A colored surface with text, button and link in light and dark modes with Orange theme","type":"image"},"component_verticalDivider_Orange":{"identifier":"component_verticalDivider_Orange","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_verticalDivider_Orange.png"}],"alt":"An vertical divider in light and dark modes with Orange theme","type":"image"},"https://accessibilite.numerique.gouv.fr/":{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","url":"https:\/\/accessibilite.numerique.gouv.fr\/","titleInlineContent":[{"type":"text","text":"Référentiel Général d’Amélioration de l’Accessibilité"}],"type":"link"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"type":"topic","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"code":"OUDSHorizontalDivider","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSVerticalDivider","type":"codeVoice"},{"type":"text","text":")"}],"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsdividercolor","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","title":"OUDSDividerColor","navigatorTitle":[{"text":"OUDSDividerColor","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSDividerColor","kind":"identifier"}]},"ic_folder_categories.png":{"alt":null,"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"url":"\/documentation\/oudscomponents\/oudsbutton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"title":"OUDSButton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","role":"symbol","navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"type":"topic","kind":"symbol"},"component_horizontalDivider_Sosh":{"identifier":"component_horizontalDivider_Sosh","alt":"An horizontal divider in light and dark modes with Sosh theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_Sosh.png","traits":["1x","light"]}]},"component_verticalDivider_OrangeCompact":{"identifier":"component_verticalDivider_OrangeCompact","alt":"An vertical divider in light and dark modes with Orange Compact theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_verticalDivider_OrangeCompact.png","traits":["1x","light"]}]},"component_horizontalDivider_Wireframe":{"identifier":"component_horizontalDivider_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_horizontalDivider_Wireframe.png"}],"alt":"An horizontal divider in light and dark modes with Wireframe theme","type":"image"},"component_horizontalDivider_OrangeCompact":{"alt":"An horizontal divider in light and dark modes with Orange Compact theme","type":"image","identifier":"component_horizontalDivider_OrangeCompact","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_OrangeCompact.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSHorizontalDivider":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSHorizontalDivider","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSHorizontalDivider","kind":"identifier"}],"kind":"symbol","type":"topic","title":"OUDSHorizontalDivider","abstract":[{"text":"Divider is a UI element that allows to structure the content by visually separating the content zones.","type":"text"},{"text":" ","type":"text"},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A horizontal Divider is used to separate content laid out one under the other (","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","type":"reference"},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (height) is fixed by dedicated token from ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider","url":"\/documentation\/oudscomponents\/oudshorizontaldivider","role":"symbol"},"component_verticalDivider_Wireframe":{"alt":"An vertical divider in light and dark modes with Wireframe theme","type":"image","identifier":"component_verticalDivider_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_verticalDivider_Wireframe.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLink":{"type":"topic","title":"OUDSLink","kind":"symbol","navigatorTitle":[{"text":"OUDSLink","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"url":"\/documentation\/oudscomponents\/oudslink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink"},"component_coloredSurface_OrangeCompact":{"type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_coloredSurface_OrangeCompact","alt":"A colored surface with text, button and link in light and dark modes with Orange Compact theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"url":"\/documentation\/oudscomponents\/oudscoloredsurface","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSColoredSurface"}],"title":"OUDSColoredSurface","abstract":[{"text":"Used to define if a content is used on a colored surface.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}],"type":"topic","kind":"symbol"}}}