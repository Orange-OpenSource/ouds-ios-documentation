e":{"type":"image","identifier":"component_horizontalDivider_Orange","alt":"An horizontal divider in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_Orange.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSVerticalDivider":{"kind":"symbol","title":"OUDSVerticalDivider","navigatorTitle":[{"text":"OUDSVerticalDivider","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider","role":"symbol","url":"\/documentation\/oudscomponents\/oudsverticaldivider","type":"topic","abstract":[{"text":"Divider is a UI element that allows to structure the content by visually separating the content zones.","type":"text"},{"text":" ","type":"text"},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A vertical Divider is used to separate content laid out side by side (","type":"text"},{"code":"HStack","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor"},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (width) is fixed by dedicated token from ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSVerticalDivider","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"kind":"symbol","title":"OUDSColoredSurface","navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","role":"symbol","url":"