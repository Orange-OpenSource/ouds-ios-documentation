g","traits":["1x","light"]}],"alt":"An vertical divider in light and dark modes with Orange Compact theme","identifier":"component_verticalDivider_OrangeCompact","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSHorizontalDivider":{"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudshorizontaldivider","navigatorTitle":[{"text":"OUDSHorizontalDivider","kind":"identifier"}],"abstract":[{"text":"Divider is a UI element that allows to structure the content by visually separating the content zones.","type":"text"},{"text":" ","type":"text"},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A horizontal Divider is used to separate content laid out one under the other (","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","isActive":true,"type":"reference"},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (height) is fixed by dedicated token from ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"OUDSHorizontalDivider","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSHorizontalDivider","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider"},"doc://OUDSComponents/documentation/OUDSComponents":{"role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","url":"\/documentation\/oudscomponents","title":"Components"},"component_coloredSurface_OrangeCompact":{"variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_OrangeCompact.png","traits":["1x","light"]}],"alt":"A colored surface with text, button and link in light and dark modes with Orange Compact theme","identifier":"component_coloredSurface_OrangeCompact","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"role":"symbol","navigatorTitle":[{"text":"OUDSDividerColor","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"OUDSHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OUDSVerticalDivider"},{"type":"text","text":")"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","url":"\/documentation\/oudscomponents\/oudsdividercolor","title":"OUDSDividerColor","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSDividerColor","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLink":{"role":"symbol","navigatorTitle":[{"text":"OUDSLink","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,"},{"type":"text","text":" "},{"type":"text","text":"or to an external resource."},{"type":"text","text":" "},{"type":"text","text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","title":"OUDSLink","url":"\/documentation\/oudscomponents\/oudslink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","url":"\/documentation\/oudscomponents\/oudsbutton","title":"OUDSButton","role":"symbol","navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}]},"component_horizontalDivider_Sosh":{"alt":"An horizontal divider in light and dark modes with Sosh theme","type":"image","identifier":"component_horizontalDivider_Sosh","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_Sosh.png","traits":["1x","light"]}]}}}