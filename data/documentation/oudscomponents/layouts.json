{"kind":"article","metadata":{"modules":[{"name":"Components"}],"role":"article","roleHeading":"Article","title":"Layouts","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}]},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"layouts"}]},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/oudscomponents\/layouts"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"anchor":"Colored-Surface","text":"Colored Surface","level":3,"type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_coloredSurface_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_coloredSurface_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_coloredSurface_Sosh","type":"image"}]}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_coloredSurface_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Colored backgrounds use surface colors to maximize the contrast with content."},{"type":"text","text":" "},{"type":"text","text":"The colors of several OUDS components (for instance "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","isActive":true,"type":"reference"},{"type":"text","text":") are automatically adjusted if they are placed on "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To do so, some tokens associated with these specific colors can be customized and are identified with the "},{"inlineContent":[{"text":"Mono","type":"text"}],"type":"emphasis"},{"type":"text","text":" suffix (for instance "},{"inlineContent":[{"text":"colorBgDefaultEnabledMono","type":"text"}],"type":"emphasis"},{"type":"text","text":" of "},{"inlineContent":[{"text":"OrangeThemeButtonComponentTokensProvider","type":"text"}],"type":"emphasis"},{"type":"text","text":")."}]},{"text":"How it works","anchor":"How-it-works","type":"heading","level":4},{"inlineContent":[{"text":"According to the color, the ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":" component adds in SwiftUI environment two flags:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"oudsUseMonochrome","type":"codeVoice"},{"text":": to inform a component that needs to use mono version of tokens","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"oudsOnColoredSurface","type":"codeVoice"},{"text":": to inform a component it is placed on colored surface even if the mono is off","type":"text"}]}]}]},{"text":"How to use","anchor":"How-to-use","type":"heading","level":4},{"syntax":"swift","code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    OUDSColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            OUDSButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        OUDSButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing"},{"text":"Debuging contrast ratios","anchor":"Debuging-contrast-ratios","type":"heading","level":4},{"inlineContent":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"text":" ","type":"text"},{"text":"This is for example the case for France with the ","type":"text"},{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","type":"reference","isActive":true},{"text":", also named “RGAA”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Some components like ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","type":"reference","isActive":true},{"text":" can be used on ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","type":"reference","isActive":true},{"text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To do that, some steps must be followed in your component implementation:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Get the environment variable defined by the colored surface containing the applied color"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the component implementation, add a line of code comparing the color to test and that surface","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call"}],"type":"paragraph"}]}]},{"syntax":"swift","code":["\/\/ Rise the flag","#if DEBUG","OUDSWCAG21Ratios.oudsDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.oudsSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"type":"codeListing"},{"text":"Divider","anchor":"Divider","type":"heading","level":3},{"text":"How it works","anchor":"How-it-works","type":"heading","level":4},{"inlineContent":[{"text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider","type":"reference"},{"text":": to separate elements stacked vertically (e.g. in ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider","type":"reference"},{"text":": to separate elements stacked horizontally (e.g. in `HStack)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A divider can be colored using color enumerated in the ","type":"text"},{"code":"OUDSDividerColor","type":"codeVoice"},{"text":".","type":"text"}]},{"level":5,"text":"Horizontal","anchor":"Horizontal","type":"heading"},{"tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_horizontalDivider_Orange","type":"image"}]}]},{"title":"Orange Compact","content":[{"inlineContent":[{"type":"image","identifier":"component_horizontalDivider_OrangeCompact"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_horizontalDivider_Wireframe","type":"image"}]}]}],"type":"tabNavigator"},{"text":"Vertical","anchor":"Vertical","type":"heading","level":5},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_verticalDivider_Orange","type":"image"}]}]},{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"title":"Sosh","content":[{"inlineContent":[{"type":"image","identifier":"component_verticalDivider_Sosh"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"type":"image","identifier":"component_verticalDivider_Wireframe"}],"type":"paragraph"}]}]},{"type":"heading","level":4,"text":"How to use","anchor":"How-to-use"},{"syntax":"swift","code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    OUDSVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    OUDSHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"],"type":"codeListing"}],"kind":"content"}],"references":{"component_horizontalDivider_Sosh":{"alt":"An horizontal divider in light and dark modes with Sosh theme","identifier":"component_horizontalDivider_Sosh","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_Sosh.png","traits":["1x","light"]}],"type":"image"},"component_coloredSurface_Wireframe":{"alt":"A colored surface with text, button and link in light and dark modes with Wireframe theme","identifier":"component_coloredSurface_Wireframe","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_coloredSurface_Wireframe.png"}],"type":"image"},"component_coloredSurface_Orange":{"alt":"A colored surface with text, button and link in light and dark modes with Orange theme","identifier":"component_coloredSurface_Orange","variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Orange.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSColoredSurface"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}],"role":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"url":"\/documentation\/oudscomponents\/oudscoloredsurface","title":"OUDSColoredSurface","kind":"symbol"},"component_coloredSurface_OrangeCompact":{"identifier":"component_coloredSurface_OrangeCompact","type":"image","alt":"A colored surface with text, button and link in light and dark modes with Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_coloredSurface_OrangeCompact.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSHorizontalDivider":{"title":"OUDSHorizontalDivider","url":"\/documentation\/oudscomponents\/oudshorizontaldivider","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider","type":"topic","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (height) is fixed by dedicated token from "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSHorizontalDivider","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"OUDSHorizontalDivider","kind":"identifier"}]},"component_horizontalDivider_Wireframe":{"identifier":"component_horiz