{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"anchor":"Colored-Surface","text":"Colored Surface","type":"heading","level":3},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"identifier":"component_coloredSurface_Orange","type":"image"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"inlineContent":[{"identifier":"component_coloredSurface_OrangeCompact","type":"image"}],"type":"paragraph"}]},{"title":"Sosh","content":[{"inlineContent":[{"identifier":"component_coloredSurface_Sosh","type":"image"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"inlineContent":[{"identifier":"component_coloredSurface_Wireframe","type":"image"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Colored backgrounds use surface colors to maximize the contrast with content."},{"type":"text","text":" "},{"type":"text","text":"The colors of several OUDS components (for instance "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","isActive":true,"type":"reference"},{"type":"text","text":") are automatically adjusted if they are placed on "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To do so, some tokens associated with these specific colors can be customized and are identified with the "},{"inlineContent":[{"type":"text","text":"Mono"}],"type":"emphasis"},{"type":"text","text":" suffix (for instance "},{"inlineContent":[{"type":"text","text":"colorBgDefaultEnabledMono"}],"type":"emphasis"},{"type":"text","text":" of "},{"inlineContent":[{"type":"text","text":"OrangeThemeButtonComponentTokensProvider"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"How-it-works","text":"How it works","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"According to the color, the "},{"code":"OUDSColoredSurface","type":"codeVoice"},{"type":"text","text":" component adds in SwiftUI environment two flags:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"oudsUseMonochrome","type":"codeVoice"},{"type":"text","text":": to inform a component that needs to use mono version of tokens"}]}]},{"content":[{"inlineContent":[{"code":"oudsOnColoredSurface","type":"codeVoice"},{"type":"text","text":": to inform a component it is placed on colored surface even if the mono is off"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"How to use","type":"heading","level":4,"anchor":"How-to-use"},{"code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    OUDSColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            OUDSButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        OUDSButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing","syntax":"swift"},{"anchor":"Debuging-contrast-ratios","type":"heading","text":"Debuging contrast ratios","level":4},{"inlineContent":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","isActive":true},{"type":"text","text":", also named “RGAA”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Some components like "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","isActive":true},{"type":"text","text":" can be used on "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true},{"type":"text","text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To do that, some steps must be followed in your component implementation:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Get the environment variable defined by the colored surface containing the applied color"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In the component implementation, add a line of code comparing the color to test and that surface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call"}],"type":"paragraph"}]}]},{"code":["\/\/ Rise the flag","#if DEBUG","OUDSWCAG21Ratios.oudsDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.oudsSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","OUDSWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"type":"codeListing","syntax":"swift"},{"text":"Divider","type":"heading","level":3,"anchor":"Divider"},{"text":"How it works","type":"heading","level":4,"anchor":"How-it-works"},{"inlineContent":[{"type":"text","text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider","isActive":true,"type":"reference"},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider","isActive":true,"type":"reference"},{"type":"text","text":": to separate elements stacked horizontally (e.g. in `HStack)"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A divider can be colored using color enumerated in the "},{"code":"OUDSDividerColor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Horizontal","type":"heading","level":5,"anchor":"Horizontal"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_Orange","type":"image"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"text":"Vertical","type":"heading","level":5,"anchor":"Vertical"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_Orange","type":"image"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"text":"How to use","type":"heading","level":4,"anchor":"How-to-use"},{"code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    OUDSVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    OUDSHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"variants":[{"paths":["\/documentation\/oudscomponents\/layouts"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Layouts","roleHeading":"Article","modules":[{"name":"Components"}],"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}]},"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"layouts"}]},{"type":"text","text":"."}],"references":{"component_horizontalDivider_OrangeCompact":{"identifier":"component_horizontalDivider_OrangeCompact","type":"image","alt":"An horizontal divider in light and dark modes with Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_horizontalDivider_OrangeCompact.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"title":"OUDSColoredSurface","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","kind":"symbol","url":"\/documentation\/oudscomponents\/oudscoloredsurface","type":"topic","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSColoredSurface"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSColoredSurface"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSHorizontalDivider":{"title":"OUDSHorizontalDivider","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSHorizontalDivider","kind":"symbol","url":"\/documentation\/oudscomponents\/oudshorizontaldivider","type":"topic","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"code":"VStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","type":"reference","isActive":true},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (height) is fixed by dedicated token from "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSHorizontalDivider"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSHorizontalDivider"}]},"component_verticalDivider_Orange":{"identifier":"component_verticalDivider_Orange","type":"image","alt":"An vertical divider in light and dark modes with Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_verticalDivider_Orange.png"}]},"component_verticalDivider_Sosh":{"alt":"An vertical divider in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_verticalDivider_Sosh.png","traits":["1x","light"]}],"type":"image","identifier":"component_verticalDivider_Sosh"},"https://accessibilite.numerique.gouv.fr/":{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","type":"link","title":"Référentiel Général d’Amélioration de l’Accessibilité","url":"https:\/\/accessibilite.numerique.gouv.fr\/","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSVerticalDivider":{"title":"OUDSVerticalDivider","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider","kind":"symbol","url":"\/documentation\/oudscomponents\/oudsverticaldivider","type":"topic","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"code":"HStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","type":"reference","isActive":true},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSVerticalDivider"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSVerticalDivider"}]},"component_coloredSurface_Sosh":{"variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Sosh.png","traits":["1x","light"]}],"type":"image","identifier":"component_coloredSurface_Sosh","alt":"A colored surface with text, button and link in light and dark modes with Sosh theme"},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","role":"collection","url":"\/documentation\/oudscomponents","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"title":"Components","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLink":{"title":"OUDSLink","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","kind":"symbol","url":"\/documentation\/oudscomponents\/oudslink","type":"topic","abstract":[{"type":"text","text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,"},{"type":"text","text":" "},{"type":"text","text":"or to an external resource."},{"type":"text","text":" "},{"type":"text","text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLink"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSLink"}]},"component_coloredSurface_Wireframe":{"variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Wireframe.png","traits":["1x","light"]}],"type":"image","identifier":"component_coloredSurface_Wireframe","alt":"A colored surface with text, button and link in light and dark modes with Wireframe theme"},"component_horizontalDivider_Sosh":{"identifier":"component_horizontalDivider_Sosh","type":"image","alt":"An horizontal divider in light and dark modes with Sosh theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_horizontalDivider_Sosh.png"}]},"component_horizontalDivider_Orange":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_horizontalDivider_Orange.png"}],"type":"image","identifier":"component_horizontalDivider_Orange","alt":"An horizontal divider in light and dark modes with Orange theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"kind":"symbol","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","role":"symbol","url":"\/documentation\/oudscomponents\/oudsbutton","title":"OUDSButton","type":"topic"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image","identifier":"ic_folder_categories.png","alt":null},"component_coloredSurface_Orange":{"variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Orange.png","traits":["1x","light"]}],"type":"image","identifier":"component_coloredSurface_Orange","alt":"A colored surface with text, button and link in light and dark modes with Orange theme"},"component_verticalDivider_OrangeCompact":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_verticalDivider_OrangeCompact.png"}],"type":"image","identifier":"component_verticalDivider_OrangeCompact","alt":"An vertical divider in light and dark modes with Orange Compact theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"title":"OUDSDividerColor","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor","kind":"symbol","url":"\/documentation\/oudscomponents\/oudsdividercolor","type":"topic","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"code":"OUDSHorizontalDivider","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSVerticalDivider","type":"codeVoice"},{"type":"text","text":")"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSDividerColor"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSDividerColor"}]},"component_verticalDivider_Wireframe":{"variants":[{"url":"\/images\/OUDSComponents\/component_verticalDivider_Wireframe.png","traits":["1x","light"]}],"type":"image","identifier":"component_verticalDivider_Wireframe","alt":"An vertical divider in light and dark modes with Wireframe theme"},"component_horizontalDivider_Wireframe":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_horizontalDivider_Wireframe.png"}],"type":"image","identifier":"component_horizontalDivider_Wireframe","alt":"An horizontal divider in light and dark modes with Wireframe theme"},"component_coloredSurface_OrangeCompact":{"variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_OrangeCompact.png","traits":["1x","light"]}],"type":"image","identifier":"component_coloredSurface_OrangeCompact","alt":"A colored surface with text, button and link in light and dark modes with Orange Compact theme"}}}