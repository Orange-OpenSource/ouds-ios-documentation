{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSVerticalDivider"}],"title":"OUDSVerticalDivider","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSVerticalDivider"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLink":{"title":"OUDSLink","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","kind":"symbol","url":"\/documentation\/oudscomponents\/oudslink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLink"}],"role":"symbol","abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"OUDSLink"}]},"component_verticalDivider_OrangeCompact":{"type":"image","identifier":"component_verticalDivider_OrangeCompact","alt":"An vertical divider in light and dark modes with Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/ima