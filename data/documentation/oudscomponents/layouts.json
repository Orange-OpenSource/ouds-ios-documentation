":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image"},"component_coloredSurface_Sosh":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_coloredSurface_Sosh.png"}],"alt":"A colored surface with text, button and link in light and dark modes with Sosh theme","identifier":"component_coloredSurface_Sosh"},"doc://OUDSComponents/documentation/OUDSComponents":{"title":"Components","url":"\/documentation\/oudscomponents","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection","kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLink":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSLink"}],"role":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"url":"\/documentation\/oudscomponents\/oudslink","title":"OUDSLink","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"fragments":[{"kind":"keyword","text":"enum"},{"kin