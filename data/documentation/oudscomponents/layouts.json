h.png","traits":["1x","light"]}]},"component_coloredSurface_Sosh":{"identifier":"component_coloredSurface_Sosh","type":"image","alt":"A colored surface with text, button and link in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_coloredSurface_Sosh.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"kind":"symbol","role":"symbol","title":"OUDSColoredSurface","type":"topic","url":"\/documentation\/oudscomponents\/oudscoloredsurface","navigatorTitle":[{"text":"OUDSColoredSurface","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSColoredSurface","kind":"identifier"}],"abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface"},"component_verticalDivider_Orange":{"identifier":"component_verticalDivider_Orange","type":"image","alt":"An vertical divider in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_verticalDivider_Orange.png","traits":["1x","light"]}]}}}