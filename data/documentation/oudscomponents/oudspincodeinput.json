{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7brty","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7czhh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/body"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Length","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Status"],"title":"Enumerations","generated":true,"anchor":"Enumerations"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"metadata":{"role":"symbol","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSPinCodeInput"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPinCodeInput"}],"title":"OUDSPinCodeInput","modules":[{"name":"Components"}],"roleHeading":"Structure","externalID":"s:14OUDSComponents16OUDSPinCodeInputV"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPinCodeInput"}]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"]},{"content":[{"anchor":"Layouts","type":"heading","level":2,"text":"Layouts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component can be rendered as two different layouts:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"outlined"}],"type":"emphasis"},{"type":"text","text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field."},{"type":"text","text":" "},{"type":"text","text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,"},{"type":"text","text":" "},{"type":"text","text":"in a header (search field), or in a selection\/filtering feature in a product catalog"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"not outlined"}],"type":"emphasis"},{"type":"text","text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look."},{"type":"text","text":" "},{"type":"text","text":"Best suited for dense layouts or to enhance visibility."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used."},{"type":"text","text":" "},{"type":"text","text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus."}]},{"anchor":"Error-status","type":"heading","level":2,"text":"Error status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Error status indicates that the user input does not meet validation rules or expected formatting."},{"type":"text","text":" "},{"type":"text","text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory)."},{"type":"text","text":" "},{"type":"text","text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it."},{"type":"text","text":" "},{"type":"text","text":"The input remains editable, encouraging users to revise their input without starting over."},{"type":"text","text":" "},{"type":"text","text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke."},{"type":"text","text":" "},{"type":"text","text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,"},{"type":"text","text":" "},{"type":"text","text":"or finally if the maximum number of attempts has been exceeded."}]},{"anchor":"Specific-design-guidelines","type":"heading","level":2,"text":"Specific design guidelines"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component"},{"type":"text","text":" "},{"type":"text","text":"(also in its “Error” status) in the interface."}]},{"anchor":"Particular-cases","type":"heading","level":2,"text":"Particular cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput","type":"reference","isActive":true},{"type":"text","text":" component supports autofill feature of values like OTP code."},{"type":"text","text":" "},{"type":"text","text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it."},{"type":"text","text":" "},{"type":"text","text":"If the digits fits the component, it will be filled."},{"type":"text","text":" "},{"type":"text","text":"If the digits are longer, they will be truncated."},{"type":"text","text":" "},{"type":"text","text":"If the digits are shorter, they will be filled, letting other fields empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The copy\/paste feature is also available and has the same behavior."}]},{"anchor":"Technical-considerations","type":"heading","level":2,"text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a "},{"code":"ScrollView","type":"codeVoice"},{"type":"text","text":" to embed the component and let user move it."}]},{"syntax":"swift","type":"codeListing","code":["ScrollView(.horizontal) {","    OUDSPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Note also the exposed ","type":"text"},{"inlineContent":[{"type":"text","text":"value"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" will be updated when all digits are written.","type":"text"}]}]},{"anchor":"Accessibility-considerations","type":"heading","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter","type":"reference","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"are not vocalized to let users know what they wrote."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component gets only numeric values, not letters or symbols, only numbers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered."},{"type":"text","text":" "},{"type":"text","text":"For example if Voice Over is enavled, the autoficus is disabled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component and its digit fields are vocalized with internal wording."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it"},{"text":" ","type":"text"},{"type":"text","text":"(for example: "},{"inlineContent":[{"type":"text","text":"“The code you entered is invalid. Try again.”"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use helper text to communicate additional guidance (for example: "},{"inlineContent":[{"type":"text","text":"“Check the 6‑digit code sent by SMS”"}],"type":"emphasis"},{"type":"text","text":"), and keep this text short so it remains easy to vocalize"},{"type":"text","text":" "},{"type":"text","text":"and understand."}]},{"anchor":"Rich-text","type":"heading","level":2,"text":"Rich text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"text":"Code samples","level":2,"anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    OUDSPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    OUDSPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    OUDSPinCodeInput($pinCode, length: .six, status: .error(message: \"The OTP code you entered is not correct\"))"],"type":"codeListing"},{"anchor":"Design-documentation","type":"heading","level":2,"text":"Design documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-pin-code-input","type":"reference"}]},{"anchor":"Themes-rendering","type":"heading","level":2,"text":"Themes rendering"},{"anchor":"Orange","type":"heading","level":3,"text":"Orange"},{"inlineContent":[{"identifier":"component_pinCodeInput_Orange","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","level":3,"anchor":"Orange-Compact","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_pinCodeInput_OrangeCompact"}]},{"anchor":"Sosh","type":"heading","level":3,"text":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Sosh","type":"image"}]},{"anchor":"Wireframe","type":"heading","level":3,"text":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Wireframe","type":"image"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.3.0 (Figma component design version)","type":"text"}]}],"name":"Version","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.4.0","type":"text"}]}],"name":"Since","type":"aside","style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudspincodeinput"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput"},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSPinCodeInput/View-Implementations":{"kind":"article","role":"collectionGroup","url":"\/do