{"text":"OUDSTextualContent","kind":"identifier"}],"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextualContent","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudstextualcontent","abstract":[{"text":"A textual value that can be either a plain ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" or a styled ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSPinCodeInput/Status":{"role":"symbol","abstract":[{"type":"text","text":"Define all available status for the PIN code input"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Status","kind":"symbol","title":"OUDSPinCodeInput.Status","url":"\/documentation\/oudscomponents\/oudspincodeinput\/status","navigatorTitle":[{"text":"Status","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"component_pinCodeInput_Sosh":{"alt":"A PIN code input  component in light and dark modes with Sosh theme","variants":[{"traits":["1x","light"],"