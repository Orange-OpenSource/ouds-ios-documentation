{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudspincodeinput"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSPinCodeInput","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Layouts","anchor":"Layouts","level":2},{"type":"paragraph","inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"outlined","type":"text"}]},{"text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field.","type":"text"},{"text":" ","type":"text"},{"text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,","type":"text"},{"text":" ","type":"text"},{"text":"in a header (search field), or in a selection\/filtering feature in a product catalog","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"not outlined"}],"type":"emphasis"},{"text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for dense layouts or to enhance visibility.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used.","type":"text"},{"text":" ","type":"text"},{"text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Error status","anchor":"Error-status","type":"heading"},{"inlineContent":[{"type":"text","text":"The Error status indicates that the user input does not meet validation rules or expected formatting."},{"type":"text","text":" "},{"type":"text","text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory)."},{"type":"text","text":" "},{"type":"text","text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it."},{"type":"text","text":" "},{"type":"text","text":"The input remains editable, encouraging users to revise their input without starting over."},{"type":"text","text":" "},{"type":"text","text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke."},{"type":"text","text":" "},{"type":"text","text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,"},{"type":"text","text":" "},{"type":"text","text":"or finally if the maximum number of attempts has been exceeded."}],"type":"paragraph"},{"level":2,"anchor":"Specific-design-guidelines","text":"Specific design guidelines","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(also in its “Error” status) in the interface."}]},{"text":"Particular cases","anchor":"Particular-cases","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput","isActive":true,"type":"reference"},{"type":"text","text":" component supports autofill feature of values like OTP code."},{"type":"text","text":" "},{"type":"text","text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it."},{"type":"text","text":" "},{"type":"text","text":"If the digits fits the component, it will be filled."},{"text":" ","type":"text"},{"text":"If the digits are longer, they will be truncated.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits are shorter, they will be filled, letting other fields empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The copy\/paste feature is also available and has the same behavior."}]},{"level":2,"anchor":"Technical-considerations","type":"heading","text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a "},{"code":"ScrollView","type":"codeVoice"},{"type":"text","text":" to embed the component and let user move it."}]},{"syntax":"swift","type":"codeListing","code":["ScrollView(.horizontal) {","    OUDSPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note also the exposed ","type":"text"},{"inlineContent":[{"type":"text","text":"value"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" will be updated when all digits are written.","type":"text"}],"type":"strong"}]},{"level":2,"anchor":"Accessibility-considerations","type":"heading","text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter"},{"type":"text","text":")"},{"type":"text","text":" "},{"text":"are not vocalized to let users know what they wrote.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component gets only numeric values, not letters or symbols, only numbers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered."},{"text":" ","type":"text"},{"text":"For example if Voice Over is enavled, the autoficus is disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component and its digit fields are vocalized with internal wording."}]},{"inlineContent":[{"type":"text","text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it"},{"type":"text","text":" "},{"type":"text","text":"(for example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“The code you entered is invalid. Try again.”"}]},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use helper text to communicate additional guidance (for example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Check the 6‑digit code sent by SMS”"}]},{"type":"text","text":"), and keep this text short so it remains easy to vocalize"},{"type":"text","text":" "},{"type":"text","text":"and understand."}],"type":"paragraph"},{"text":"Rich text","level":2,"type":"heading","anchor":"Rich-text"},{"inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text and the error message are ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","isActive":true,"type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    OUDSPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    OUDSPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    OUDSPinCodeInput($pinCode, length: .six, status: .textualError(message: \"The OTP code you entered is not correct\"))","","    \/\/ The helper text and the error message can be localized or rich texts","    OUDSPinCodeInput($pinCode, helperText: .localized(\"pin_helper\", bundle: Bundle.module))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     helperText: .rich(AttributedString(markdown: \"Enter the **one-time code** sent to your device\")))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     status: .textualError(message: .rich(AttributedString(markdown: \"The code is **not correct**\"))))","","    \/\/ Show the written characters","    OUDSPinCodeInput($pinCode, hiddenCharacters: false)"]},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-pin-code-input","type":"reference","isActive":true}]},{"anchor":"Themes-rendering","text":"Themes rendering","type":"heading","level":2},{"anchor":"Orange","text":"Orange","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_pinCodeInput_Orange"}]},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_OrangeCompact","type":"image"}]},{"anchor":"Sosh","text":"Sosh","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Sosh","type":"image"}]},{"anchor":"Wireframe","text":"Wireframe","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Wireframe","type":"image"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.4.0 (Figma component design version)"}],"type":"paragraph"}],"name":"Version"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.4.0"}],"type":"paragraph"}],"name":"Since"}]}],"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7brty","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7czhh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:hiddenCharacters:helperText:isOutlined:status:autofocus:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/body"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Length","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Status"],"anchor":"Enumerations","generated":true,"title":"Enumerations"},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput"},"abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"kind":"symbol","metadata":{"modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSPinCodeInput","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"OUDSPinCodeInput","kind":"identifier"}],"roleHeading":"Structure","platforms":[{"beta":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"deprecated":false},{"beta":false,"name":"iPadOS","introducedAt":"15.0","unavailable":false,"deprecated":false},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","beta":false}],"externalID":"s:14OUDSComponents16OUDSPinCodeInputV","title":"OUDSPinCodeInput","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSPinCodeInput/body":{"titl