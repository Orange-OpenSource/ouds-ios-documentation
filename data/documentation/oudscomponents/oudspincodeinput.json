{"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput"},"kind":"symbol","abstract":[{"text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,","type":"text"},{"text":" ","type":"text"},{"text":"such as a four, six or eight-digit personal identification number (PIN).","type":"text"},{"text":" ","type":"text"},{"text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,","type":"text"},{"text":" ","type":"text"},{"text":"while supporting smooth keyboard navigation and secured input masking if needed.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudspincodeinput"]}],"metadata":{"roleHeading":"Structure","title":"OUDSPinCodeInput","modules":[{"name":"Components"}],"role":"symbol","platforms":[{"name":"iOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"15.0"},{"name":"iPadOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"15.0"},{"name":"Mac Catalyst","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"15.0"},{"name":"visionOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"1.0"}],"externalID":"s:14OUDSComponents16OUDSPinCodeInputV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSPinCodeInput","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSPinCodeInput","kind":"identifier"}],"symbolKind":"struct"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7brty","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7czhh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:hiddenCharacters:helperText:isOutlined:status:autofocus:)"],"anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter"],"anchor":"Type-Properties","title":"Type Properties"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Length","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Status"],"anchor":"Enumerations","title":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPinCodeInput"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Layouts","level":2,"anchor":"Layouts"},{"type":"paragraph","inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"outlined"}]},{"text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field.","type":"text"},{"text":" ","type":"text"},{"text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,","type":"text"},{"text":" ","type":"text"},{"text":"in a header (search field), or in a selection\/filtering feature in a product catalog","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"not outlined"}]},{"text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for dense layouts or to enhance visibility.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used.","type":"text"},{"text":" ","type":"text"},{"text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus.","type":"text"}]},{"type":"heading","text":"Error status","level":2,"anchor":"Error-status"},{"type":"paragraph","inlineContent":[{"text":"The Error status indicates that the user input does not meet validation rules or expected formatting.","type":"text"},{"text":" ","type":"text"},{"text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory).","type":"text"},{"text":" ","type":"text"},{"text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it.","type":"text"},{"text":" ","type":"text"},{"text":"The input remains editable, encouraging users to revise their input without starting over.","type":"text"},{"text":" ","type":"text"},{"text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke.","type":"text"},{"text":" ","type":"text"},{"text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,","type":"text"},{"text":" ","type":"text"},{"text":"or finally if the maximum number of attempts has been exceeded.","type":"text"}]},{"type":"heading","text":"Specific design guidelines","level":2,"anchor":"Specific-design-guidelines"},{"type":"paragraph","inlineContent":[{"text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component","type":"text"},{"text":" ","type":"text"},{"text":"(also in its “Error” status) in the interface.","type":"text"}]},{"type":"heading","text":"Particular cases","level":2,"anchor":"Particular-cases"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput","type":"reference"},{"text":" component supports autofill feature of values like OTP code.","type":"text"},{"text":" ","type":"text"},{"text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits fits the component, it will be filled.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits are longer, they will be truncated.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits are shorter, they will be filled, letting other fields empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The copy\/paste feature is also available and has the same behavior.","type":"text"}]},{"type":"heading","text":"Technical considerations","level":2,"anchor":"Technical-considerations"},{"type":"paragraph","inlineContent":[{"text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":" to embed the component and let user move it.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["ScrollView(.horizontal) {","    OUDSPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note also the exposed "},{"type":"emphasis","inlineContent":[{"text":"value","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" will be updated when all digits are written."}],"type":"strong"}]},{"type":"heading","text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"are not vocalized to let users know what they wrote.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The component gets only numeric values, not letters or symbols, only numbers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered.","type":"text"},{"text":" ","type":"text"},{"text":"For example if Voice Over is enavled, the autoficus is disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The component and its digit fields are vocalized with internal wording.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it","type":"text"},{"text":" ","type":"text"},{"text":"(for example: ","type":"text"},{"inlineContent":[{"type":"text","text":"“The code you entered is invalid. Try again.”"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use helper text to communicate additional guidance (for example: ","type":"text"},{"inlineContent":[{"type":"text","text":"“Check the 6‑digit code sent by SMS”"}],"type":"emphasis"},{"text":"), and keep this text short so it remains easy to vocalize","type":"text"},{"text":" ","type":"text"},{"text":"and understand.","type":"text"}]},{"type":"heading","text":"Rich text","level":2,"anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text and the error message are ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent","type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}]},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    OUDSPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    OUDSPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    OUDSPinCodeInput($pinCode, length: .six, status: .textualError(message: \"The OTP code you entered is not correct\"))","","    \/\/ The helper text and the error message can be localized or rich texts","    OUDSPinCodeInput($pinCode, helperText: .localized(\"pin_helper\", bundle: Bundle.module))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     helperText: .rich(AttributedString(markdown: \"Enter the **one-time code** sent to your device\")))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     status: .textualError(message: .rich(AttributedString(markdown: \"The code is **not correct**\"))))","","    \/\/ Show the written characters","    OUDSPinCodeInput($pinCode, hiddenCharacters: false)"]},{"type":"heading","text":"Design documentation","level":2,"anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-pin-code-input","type":"reference"}]},{"type":"heading","text":"Themes rendering","level":2,"anchor":"Themes-rendering"},{"type":"heading","text":"Orange","level":3,"anchor":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Orange","type":"image"}]},{"type":"heading","text":"Orange Compact","level":3,"anchor":"Orange-Compact"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_OrangeCompact","type":"image"}]},{"type":"heading","text":"Sosh","level":3,"anchor":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Sosh","type":"image"}]},{"type":"heading","text":"Wireframe","level":3,"anchor":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Wireframe","type":"image"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.4.0 (Figma component design version)"}],"type":"paragraph"}],"name":"Version"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.4.0"}],"type":"paragraph"}],"name":"Since"}]}],"references":{"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7Sw