{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSPinCodeInput","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"anchor":"Layouts","text":"Layouts","type":"heading","level":2},{"inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"outlined"}]},{"type":"text","text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field."},{"type":"text","text":" "},{"type":"text","text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,"},{"type":"text","text":" "},{"type":"text","text":"in a header (search field), or in a selection\/filtering feature in a product catalog"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"not outlined","type":"text"}]},{"text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for dense layouts or to enhance visibility.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used.","type":"text"},{"text":" ","type":"text"},{"text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus.","type":"text"}]},{"anchor":"Error-status","text":"Error status","type":"heading","level":2},{"inlineContent":[{"text":"The Error status indicates that the user input does not meet validation rules or expected formatting.","type":"text"},{"text":" ","type":"text"},{"text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory).","type":"text"},{"text":" ","type":"text"},{"text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it.","type":"text"},{"text":" ","type":"text"},{"text":"The input remains editable, encouraging users to revise their input without starting over.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke."},{"type":"text","text":" "},{"type":"text","text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,"},{"type":"text","text":" "},{"type":"text","text":"or finally if the maximum number of attempts has been exceeded."}],"type":"paragraph"},{"type":"heading","text":"Specific design guidelines","anchor":"Specific-design-guidelines","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component"},{"type":"text","text":" "},{"type":"text","text":"(also in its “Error” status) in the interface."}]},{"type":"heading","text":"Particular cases","level":2,"anchor":"Particular-cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput"},{"text":" component supports autofill feature of values like OTP code.","type":"text"},{"text":" ","type":"text"},{"text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits fits the component, it will be filled.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits are longer, they will be truncated.","type":"text"},{"text":" ","type":"text"},{"text":"If the digits are shorter, they will be filled, letting other fields empty.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The copy\/paste feature is also available and has the same behavior."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Technical considerations","anchor":"Technical-considerations"},{"type":"paragraph","inlineContent":[{"text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":" to embed the component and let user move it.","type":"text"}]},{"code":["ScrollView(.horizontal) {","    OUDSPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note also the exposed ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" will be updated when all digits are written."}]}],"type":"paragraph"},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"are not vocalized to let users know what they wrote.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The component gets only numeric values, not letters or symbols, only numbers."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered.","type":"text"},{"text":" ","type":"text"},{"text":"For example if Voice Over is enavled, the autoficus is disabled.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The component and its digit fields are vocalized with internal wording."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it","type":"text"},{"text":" ","type":"text"},{"text":"(for example: ","type":"text"},{"inlineContent":[{"text":"“The code you entered is invalid. Try again.”","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use helper text to communicate additional guidance (for example: "},{"type":"emphasis","inlineContent":[{"text":"“Check the 6‑digit code sent by SMS”","type":"text"}]},{"text":"), and keep this text short so it remains easy to vocalize","type":"text"},{"text":" ","type":"text"},{"text":"and understand.","type":"text"}]},{"anchor":"Rich-text","text":"Rich text","type":"heading","level":2},{"inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text and the error message are ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"text":" values: a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", a localized string","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":".raw(_:)","type":"codeVoice"},{"text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextualContent"},{"text":" and does not emit a deprecation warning.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}]},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    OUDSPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    OUDSPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    OUDSPinCodeInput($pinCode, length: .six, status: .textualError(message: \"The OTP code you entered is not correct\"))","","    \/\/ The helper text and the error message can be localized or rich texts","    OUDSPinCodeInput($pinCode, helperText: .localized(\"pin_helper\", bundle: Bundle.module))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     helperText: .rich(AttributedString(markdown: \"Enter the **one-time code** sent to your device\")))","    OUDSPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     status: .textualError(message: .rich(AttributedString(markdown: \"The code is **not correct**\"))))","","    \/\/ Show the written characters","    OUDSPinCodeInput($pinCode, hiddenCharacters: false)"],"syntax":"swift","type":"codeListing"},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-pin-code-input"}],"type":"paragraph"},{"level":2,"text":"Themes rendering","type":"heading","anchor":"Themes-rendering"},{"level":3,"text":"Orange","type":"heading","anchor":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Orange","type":"image"}]},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":3},{"inlineContent":[{"type":"image","identifier":"component_pinCodeInput_OrangeCompact"}],"type":"paragraph"},{"level":3,"text":"Sosh","type":"heading","anchor":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_pinCodeInput_Sosh","type":"image"}]},{"anchor":"Wireframe","text":"Wireframe","type":"heading","level":3},{"inlineContent":[{"type":"image","identifier":"component_pinCodeInput_Wireframe"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"1.4.0 (Figma component design version)"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Version"},{"type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"1.4.0","type":"text"}]}],"style":"note"}],"kind":"content"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7brty","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7czhh","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/init(_:length:hiddenCharacters:helperText:isOutlined:status:autofocus:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Type Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/obfuscationCharacter","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/placeholderCharacter"],"generated":true,"anchor":"Type-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Length","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/Status"],"generated":true,"anchor":"Enumerations"},{"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudspincodeinput"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPinCodeInput"}],"title":"OUDSPinCodeInput","role":"symbol","modules":[{"name":"Components"}],"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"beta":false,"introducedAt":"15.0"},{"unavailable":false,"name":"iPadOS","deprecated":false,"beta":false,"introducedAt":"15.0"},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"beta":false,"introducedAt":"15.0"},{"unavailable":false,"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSPinCodeInput"}],"externalID":"s:14OUDSComponents16OUDSPinCodeInputV","roleHeading":"Structure"},"references":{"component_pinCodeInput_Sosh":{"type":"image","alt":"A PIN code input  component