er","text":"Marker","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Some themes (like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Compact"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Wireframe"}]},{"type":"text","text":") declare that a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"large"}]},{"type":"text","text":" heading is decorated with a small"},{"type":"text","text":" "},{"type":"text","text":"coloured rectangle below the text, i.e. the "},{"type":"strong","inlineContent":[{"type":"text","text":"marker"}]},{"type":"text","text":". Other themes (like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sosh"}]},{"type":"text","text":") do not use a marker at all but something else."}],"type":"paragraph"},{"anchor":"Coloring-a-substring","text":"Coloring a substring","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A dedicated initializer accepts a "},{"type":"codeVoice","code":"coloredText"},{"type":"text","text":" sub-string instead of a marker."},{"type":"text","text":" "},{"type":"text","text":"This is useful to emphasize a specific word inside a heading (for example a brand name). This feature is only"},{"type":"text","text":" "},{"type":"text","text":"meaningful for "},{"type":"codeVoice","code":"size == .large"},{"type":"text","text":"; on other sizes a warning is logged and the text is rendered plain."}],"type":"paragraph"},{"name":"Warning","type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not all themes provide a valid "},{"code":"theme.colors.contentBrandSecondary","type":"codeVoice"},{"type":"text","text":" (e.g. "},{"inlineContent":[{"type":"text","text":"Orange"}],"type":"emphasis"},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Compact"}]},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"the token is marked as forbidden). When the token is forbidden the coloring is skipped.","type":"text"}]}]},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["    \/\/ Simple raw string","    OUDSHeading(text: \"Title\")","","    \/\/ Large heading with a marker (rendered only when the theme supports it)","    OUDSHeading(text: \"Section title\", size: .large, hasMarker: true)","","    \/\/ Smaller heading (marker parameter would be ignored here)","    OUDSHeading(text: \"Sub-section\", size: .medium)","","    \/\/ Heading with a brand-coloured word","    OUDSHeading(text: \"Welcome to Orange\", coloredText: \"Orange\")","","    \/\/ Combined: coloured word","    OUDSHeading(text: \"Welcome to Sosh\", coloredText: \"Sosh\")","","    \/\/ Localizable from a bundle","    OUDSHeading(LocalizedStringKey(\"section_title\"), bundle: Bundle.module, size: .large)"]},{"type":"heading","level":2,"anchor":"Accessibility","text":"Accessibility"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component adds the "},{"type":"codeVoice","code":".isHeader"},{"type":"text","text":" accessibility trait so that assistive technologies (like "},{"type":"emphasis","inlineContent":[{"text":"VoiceOver","type":"text"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"announce the text as a header. When a marker is drawn, it is hidden from assistive technologies (decorative)."}]},{"type":"heading","level":2,"anchor":"Design-documentation","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/unified-design-system.orange.com\/"}]},{"type":"heading","anchor":"Themes-rendering","level":2,"text":"Themes rendering"},{"type":"heading","anchor":"Orange","level":3,"text":"Orange"},{"inlineContent":[{"identifier":"com