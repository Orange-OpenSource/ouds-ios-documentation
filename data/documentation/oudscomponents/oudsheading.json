"type":"text","text":"Wireframe"}]},{"text":") declare that a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"large"}]},{"text":" heading is decorated with a small","type":"text"},{"text":" ","type":"text"},{"text":"coloured rectangle below the text, i.e. the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"marker"}]},{"text":". Other themes (like ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sosh"}]},{"text":") do not use a marker at all but something else.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Coloring a substring","anchor":"Coloring-a-substring","type":"heading"},{"inlineContent":[{"text":"A dedicated initializer accepts a ","type":"text"},{"code":"coloredText","type":"codeVoice"},{"text":" sub-string instead of a marker.","type":"text"},{"text":" ","type":"text"},{"text":"This is useful to emphasize a specific word inside a heading (for example a brand name). This feature is only","type":"text"},{"text":" ","type":"text"},{"text":"meaningful for ","type":"text"},{"code":"size == .large","type":"codeVoice"},{"text":"; on other sizes a warning is logged and the text is rendered plain.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not all themes provide a valid "},{"type":"codeVoice","code":"theme.colors.contentBrandSecondary"},{"type":"text","text":" (e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Compact"}]},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"the token is marked as forbidden). When the token is forbidden the coloring is skipped."}]}],"style":"warning","name":"Warning","type":"aside"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Simple raw string","    OUDSHeading(te