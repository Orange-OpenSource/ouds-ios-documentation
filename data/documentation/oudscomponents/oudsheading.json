{"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"Text component used to structure the hierarchy of a screen.","type":"text"},{"text":" ","type":"text"},{"text":"Four sizes are available; the largest (","type":"text"},{"type":"codeVoice","code":".large"},{"text":") can optionally display a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"marker"}]},{"text":", i.e. a small brand-coloured","type":"text"},{"text":" ","type":"text"},{"text":"rectangle rendered below the text (when the current theme declares it supports one).","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSHeading","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Foundations"],"kind":"mentions"},{"content":[{"text":"Sizes","type":"heading","anchor":"Sizes","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"XLarge","type":"text"}],"type":"strong"},{"text":": The largest heading, useful for page titles.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large (by default)","type":"text"}],"type":"strong"},{"text":": The default heading. Only this size supports the marker and the ","type":"text"},{"inlineContent":[{"text":"colored substring","type":"text"}],"type":"emphasis"},{"text":" feature.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"strong"},{"text":": A medium heading, typically used for section titles.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Sm