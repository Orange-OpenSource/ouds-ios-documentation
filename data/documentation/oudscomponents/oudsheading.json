{"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"Text component used to structure the hierarchy of a screen.","type":"text"},{"text":" ","type":"text"},{"text":"Four sizes are available; the largest (","type":"text"},{"code":".large","type":"codeVoice"},{"text":") can optionally display a ","type":"text"},{"inlineContent":[{"type":"text","text":"marker"}],"type":"strong"},{"text":", i.e. a small brand-coloured","type":"text"},{"text":" ","type":"text"},{"text":"rectangle rendered below the text (when the current theme declares it supports one).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSHeading"}],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Foundations"]},{"kind":"content","content":[{"text":"Sizes","level":2,"anchor":"Sizes","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"XLarge"}],"type":"strong"},{"text":": The largest heading, useful for page titles.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Large (by default)"}],"type":"strong"},{"text":": The default heading. Only this size supports the marker and the ","type":"text"},{"inlineContent":[{"type":"text","text":"colored substring"}],"type":"emphasis"},{"text":" feature.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"strong"},{"text":": A medium heading, typically used for section titles.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Small"}],"type":"strong"},{"text":": The smallest heading, used for subsection titles.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Marker","level":2,"anchor":"Marker","type":"heading"},{"inlineContent":[{"type":"text","text":"Some themes (like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Compact"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Wireframe"}]},{"type":"text","text":") declare that a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"large"}]},{"type":"text","text":" heading is decorated with a small"},{"type":"text","text":" "},{"type":"text","text":"coloured rectangle below the text, i.e. the "},{"type":"strong","inlineContent":[{"type":"text","text":"marker"}]},{"type":"text","text":". Other themes (like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sosh"}]},{"type":"text","text":") do not use a marker at all but something else."}],"type":"paragraph"},{"text":"Coloring a substring","level":2,"anchor":"Coloring-a-substring","type":"heading"},{"inlineContent":[{"type":"text","text":"A dedicated initializer accepts a "},{"type":"codeVoice","code":"coloredText"},{"type":"text","text":" sub-string instead of a marker."},{"type":"text","text":" "},{"type":"text","text":"This is useful to emphasize a specific word inside a heading (for example a brand name). This feature is only"},{"type":"text","text":" "},{"type":"text","text":"meaningful for "},{"type":"codeVoice","code":"size == .large"},{"type":"text","text":"; on other sizes a warning is logged and the text is rendere