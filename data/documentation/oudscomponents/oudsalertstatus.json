ents\/documentation\/OUDSComponents\/OUDSAlertStatus\/info","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/negative","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/neutral(image:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/warning"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"OUDSAlertStatus","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsalertstatus","title":"OUDSAlertStatus","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","role":"symbol","abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","isActive":true},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","isActive":true},{"type":"text","text":" icon and text color are based on this status."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSAlertStatus","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"type":"topic","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","title":"OUDSInlineAlert","role":"symbol","navigatorTitle":[{"text":"OUDSInlineAlert","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsinlinealert","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInlineAlert","kind":"identifier"}]},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/info":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"info"}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/info","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/info","role":"symbol","abstract":[{"type":"text","text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status"},{"type":"text","text":" "},{"type":"text","text":"messages where users simply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"kind":"symbol","title":"OUDSAlertStatus.info"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/positive":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"positive"}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/positive","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","role":"symbol","abstract":[{"type":"text","text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed."