e"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents9OUDSImageV","text":"OUDSImage"},{"kind":"text","text":"?)"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/accent(image:)","type":"topic","title":"OUDSAlertStatus.accent(image:)"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/warning":{"abstract":[{"type":"text","text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"type":"text","text":" "},{"type":"text","text":"typically do not block actions."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/warning","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"warning"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/warning","type":"topic","title":"OUDSAlertStatus.warning"},"ic_folder_categories.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"alt":null,"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"}}}