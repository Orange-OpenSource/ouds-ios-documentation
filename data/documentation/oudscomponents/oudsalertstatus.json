OUDSAlertStatus"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two types of statuses:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Non-functional statuses used for informational or decorative alert messages."},{"type":"text","text":" "},{"type":"text","text":"They provide context or highlight content without implying a specific state, system event, or user action."},{"type":"text","text":" "},{"type":"text","text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Functional statuses communicate specific system statuses, results, or user feedback:"},{"type":"text","text":" "},{"type":"text","text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility."},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"type":"text","text":" "},{"type":"text","text":"These messages carry functional meaning and help guide user response or acknowledgment."}],"type":"paragraph"}]}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudsalertstatus"]}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP"],"type":"conformsTo"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/neutral(image:)":{"type":"topic","kind":"symbol","title":