e":"topic","title":"OUDSAlertStatus.negative","abstract":[{"text":"Negative status communicates a critical issue or error that prevents the user from proceeding until it is resolved. These alerts remain visible until","type":"text"},{"text":" ","type":"text"},{"text":"the problem is fixed or dismissed by the user.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"negative"}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/negative"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/positive":{"type":"topic","title":"OUDSAlertStatus.positive","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"positive"}],"abstract":[{"type":"text","text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","url":"\/documentation\/oudscomponents\/oudsalertstatus\/positive","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/accent(image:)":{"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/accent(image:)","title":"OUDSAlertStatus.accent(image:)","abstract":[{"text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,","type":"text"},{"text":" ","type":"text"},{"text":"announcements, or fea