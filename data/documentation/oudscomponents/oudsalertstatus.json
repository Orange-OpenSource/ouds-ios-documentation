ext","text":"There are two types of statuses:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Non-functional statuses used for informational or decorative alert messages."},{"type":"text","text":" "},{"type":"text","text":"They provide context or highlight content without implying a specific state, system event, or user action."},{"type":"text","text":" "},{"type":"text","text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Functional statuses communicate specific system statuses, results, or user feedback:"},{"type":"text","text":" "},{"type":"text","text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility."},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"type":"text","text":" "},{"type":"text","text":"These messages carry functional meaning and help guide user response or acknowledgment."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/oudscomponents\/oudsalertstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/warning":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/warning","abstract":[{"text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but","type":"text"},{"text":" ","type":"text"},{"text":"typically do not block actions.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/warning","title":"OUDSAlertStatus.warning","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"warning","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertMessage":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertMessage"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSAlertMessage"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudsalertmessage","abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"kind":"symbol","role":"symbol","title":"OUDSAlertMessage"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/info":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/info","abstract":[{"text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status","type":"text"},{"text":" ","type":"text"},{"text":"messages where users simply need to stay informed.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/info","title":"OUDSAlertStatus.info","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"info","kind":"identifier"}],"kind":"symbol","type":"topic"},"ic_folder_categories.png":{"alt":null,"type":"image","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/positive":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"positive"}],"type":"topic","role":"symbol","title":"OUDSAlertStatus.positive","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","kind":"symbol","abstract":[{"type":"text","text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/positive"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus":{"navigatorTitle":[{"kind":"identifier","text":"OUDSAlertStatus"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertStatus"}],"abstract":[{"text":"The status of the alerts.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"},{"text":" background color and its icon color are based on this status.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert"},{"text":" icon and text color are based on this status.","type":"text"}],"title":"OUDSAlertStatus","kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/negative":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"negative","kind":"identifier"}],"type":"topic","role":"symbol","title":"OUDSAlertStatus.negative","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/negative","kind":"symbol","abstract":[{"type":"text","text":"Negative status communicates a critical issue or error that prevents the user from proceeding until it is resolved. These alerts remain visible until"},{"text":" ","type":"text"},{"type":"text","text":"the problem is fixed or dismissed by the user."},{"text":" ","type":"text"},{"type":"text","text":"This status displays a dedicated default icon."}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/negative"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/neutral(image:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neutral","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSImage","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents9OUDSImageV"},{"text":"?)","kind":"text"}],"type":"topic","role":"symbol","title":"OUDSAlertStatus.neutral(image:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/neutral(image:)","kind":"symbol","abstract":[{"type":"text","text":"Neutral status can be used as a generic informative alert without semantic meaning or colour association."},{"type":"text","text":" "},{"text":"Suitable for a wide range of contexts — such as tips, general information, or descriptive labels — where","type":"text"},{"type":"text","text":" "},{"type":"text","text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows."}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/neutral(image:)"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/accent(image:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accent","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSImage","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents9OUDSImageV"},{"kind":"text","text":"?)"}],"type":"topic","role":"symbol","title":"OUDSAlertStatus.accent(image:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/accent(image:)","kind":"symbol","abstract":[{"type":"text","text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"type":"text","text":" "},{"type":"text","text":"product updates, or customer engagement moments."}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/accent(image:)"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSInlineAlert"}],"navigatorTi