r from proceeding until it is resolved. These alerts remain visible until"},{"type":"text","text":" "},{"type":"text","text":"the problem is fixed or dismissed by the user."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"type":"topic","title":"OUDSAlertStatus.negative","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/negative","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/negative","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"negative","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/positive":{"role":"symbol","kind":"symbol","title":"OUDSAlertStatus.positive","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"positive"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","type":"topic","abstract":[{"type":"text","text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"url":"\/documentation\/oudscomponents\/oudsalertstatus\/positive"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/warning":{"kind":"symbol","type":"topic","title":"OUDSAlertStatus.warning","abstract":[{"type":"text","text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"text":" ","type":"text"},{"type":"text","text":"typically do not block actions."},{"text":" ","type":"text"},{"type":"text","text":"This status displays a dedicated default icon."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"warning"}],"identifie