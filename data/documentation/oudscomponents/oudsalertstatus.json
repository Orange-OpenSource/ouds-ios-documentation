{"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/accent(image:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/info","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/negative","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/neutral(image:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/warning"],"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertStatus"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"There are two types of statuses:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Non-functional statuses used for informational or decorative alert messages.","type":"text"},{"text":" ","type":"text"},{"text":"They provide context or highlight content without implying a specific state, system event, or user action.","type":"text"},{"text":" ","type":"text"},{"text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Functional statuses communicate specific system statuses, results, or user feedback:"},{"type":"text","text":" "},{"type":"text","text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility."},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"type":"text","text":" "},{"type":"text","text":"These messages carry functional meaning and help guide user response or acknowledgment."}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"variants":[{"paths":["\/documentation\/oudscomponents\/oudsalertstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:14OUDSComponents15OUDSAlertStatusO","modules":[{"name":"Components"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertStatus"}],"symbolKind":"enum","title":"OUDSAlertStatus","roleHeading":"Enumeration","role":"symbol","navigatorTitle":[{"text":"OUDSAlertStatus","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertMessage"},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert"},{"type":"text","text":" icon and text color are based on this status."}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/info":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"info"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/info","url":"\/documentation\/oudscomponents\/oudsalertstatus\/info","title":"OUDSAlertStatus.info","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status"},{"type":"text","text":" "},{"type":"text","text":"messages where users simply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/negative":{"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/negative","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"negative"}],"abstract":[{"type":"text","text":"Negative status communicates a critical issue or error that prevents the user from proceeding until it is resolved. These alerts remain visible until"},{"type":"text","text":" "},{"type":"text","text":"the problem is fixed or dismissed by the user."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"title":"OUDSAlertStatus.negative","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/negative"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/neutral(image:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/neutral(image:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"neutral"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents9OUDSImageV","text":"OUDSImage"},{"kind":"text","text":"?)"}],"abstract":[{"type":"text","text":"Neutral status can be used as a generic informative alert without semantic meaning or colour association."},{"type":"text","text":" "},{"type":"text","text":"Suitable for a wide range of contexts — such as tips, general information, or descriptive labels — where"},{"type":"text","text":" "},{"type":"text","text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows."}],"title":"OUDSAlertStatus.neutral(image:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/neutral(image:)"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInlineAlert","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","title":"OUDSInlineAlert","url":"\/documentation\/oudscomponents\/oudsinlinealert","role":"symbol","navigatorTitle":[{"text":"OUDSInlineAlert","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/positive":{"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudsalertstatus\/positive","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"positive"}],"abstract":[{"type":"text","text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"title":"OUDSAlertStatus.positive","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/positive"},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus/accent(image:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents9OUDSImageV","text":"OUDSImage"},{"kind":"text","text":"?)"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatus\/accent(image:)","url":"\/documentation\/oudscomponents\/oudsalertstatus\/accent(image:)","title":"OUDSAlertStatus.accent(image:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"type":"text","text":" "},{"type":"text","text":"product updates, or customer engagement moments."}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSAlertStatus":{"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSAlertStatus"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSAlertStatu