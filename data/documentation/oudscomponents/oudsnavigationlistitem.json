"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view (e.g. a gauge)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Trailing-elements","text":"Trailing elements","type":"heading"},{"inlineContent":[{"type":"text","text":"The trailing position (after the texts) accepts one optional element via "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemTrailing","isActive":true},{"type":"text","text":", like:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.label(String))"},{"type":"text","text":": A default-styled label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelMuted(String))"},{"type":"text","text":": A muted (secondary) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelAndExtraLabel(String, String))"},{"type":"text","text":": A label with an additional extra label below"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge(.count(OUDSBadgeCount)"},{"type":"text","text":": A badge with count"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge(.standard(OUDSBadgeStandard)"},{"type":"text","text":": A badge with standard status"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".tag(OUDSTag)"},{"type":"text","text":": A tag for categorization"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(OUDSListItemIcon)"},{"type":"text","text":": A status or custom icon"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(OUDSListItemImage)"},{"type":"text","text":":  A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".flag(OUDSListItemFlag)"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(OUDSListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"View-modifiers","text":"View modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"Several view modifiers can be applied to customize the appearance and layout of list items:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemSize(_:)","isActive":true},{"type":"text","text":" — Sets the size of the item ("},{"type":"codeVoice","code":".standard"},{"type":"text","text":" or "},{"type":"codeVoice","code":".small"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemContainerAlignment(_:)","isActive":true},{"type":"text","text":" — Aligns leading, trailing, and text containers ("},{"type":"codeVoice","code":".top"},{"type":"text","text":" or "},{"type":"codeVoice","code":".center"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/SwiftUICore\/View\/oudsListItemStyle(divider:background:)","isActive":true},{"type":"text","text":" — Applies a item style with optional divider and background."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"refer