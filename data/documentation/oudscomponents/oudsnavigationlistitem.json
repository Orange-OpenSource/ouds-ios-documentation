":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It can also include an optional leading element (such as an icon, image, avatar, or flag)","type":"text"},{"text":" ","type":"text"},{"text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar or flag)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For non-interactive, display-only list items, see ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Indicator types","level":2,"anchor":"Indicator-types","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType","type":"reference","isActive":true},{"text":" enum defines the visual indicator and semantic meaning of the navigation:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".next","type":"codeVoice"}],"type":"strong"},{"text":" (default): A forward chevron indicating in-app navigation to a next screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".previous","type":"codeVoice"}],"type":"strong"},{"text":": A backward chevron indicating in-app navigation to a previous screen.","type":"text"},{"text":" ","type":"text"},{"text":"When using ","type":"text"},{"type":"codeVoice","code":".previous"},{"text":", the leading element is automatically hidden.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".external","type":"codeVoice"}],"type":"strong"},{"text":": An external link icon indicating that the action opens content outside the app","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. a URL in a browser or an external viewer).","type":"text"}],"type":"paragraph"}]}]