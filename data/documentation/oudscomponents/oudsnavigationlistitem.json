{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},"metadata":{"symbolKind":"struct","platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0"},{"name":"iPadOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0"},{"name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0"},{"name":"macOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0"},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"16.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"11.0"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSNavigationListItem"}],"title":"OUDSNavigationListItem","navigatorTitle":[{"kind":"identifier","text":"OUDSNavigationListItem"}],"modules":[{"name":"Components"}],"externalID":"s:14OUDSComponents22OUDSNavigationListItemV","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"text":"A list item component used to display a row of interactive, navigable content within a list.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSNavigationListItem","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"text":" is an interactive variant of the list item that triggers an action when tapped.","type":"text"},{"text":" ","type":"text"},{"text":"It displays a navigation indicator (chevron for next\/previous, or an external link icon)","type":"text"},{"text":" ","type":"text"},{"text":"to communicate the type of navigation to the user.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The item typically contains a label, and optionally a description, an overline, an extra label,","type":"text"},{"text":" ","type":"text"},{"text":"a text slot, a bottom slot, and a helper text — all provided through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)","type":"text"},{"text":" ","type":"text"},{"text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For non-interactive, display-only list items, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Indicator types","anchor":"Indicator-types","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType"},{"text":" enum defines the visual indicator and semantic meaning of the navigation:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".next"}]},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".previous"}]},{"type":"text","text":": A backward chevron indicating in-app navigation to a previous screen."},{"type":"text","text":" "},{"type":"text","text":"When using "},{"type":"codeVoice","code":".previous"},{"type":"text","text":", the leading element is automatically hidden."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".external"}]},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Simple navigable list item with forward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Next screen\"))","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Open website\")),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Go back\")),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"SMS credit\")),","        trailing: .slot {","            OUDSCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    OUDSNavigationListItem(","        data: OUDSListItemData(","            label: \"Settings\",","            textSlot: .init { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to settings","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    OUDSNavigationListItem(","        data: OUDSListItemData(","            label: \"Profile\",","            bottomSlot: .init { Text(\"Additional info\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to profile","    }"],"type":"codeListing"},{"level":2,"text":"Leading elements","anchor":"Leading-elements","type":"heading"},{"inlineContent":[{"text":"The leading position (before the texts) accepts one optional element via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemLeading"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(OUDSListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(OUDSListItemImage)"},{"type":"text","text":": A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".flag(OUDSListItemFlag)"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(OUDSListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view (e.g. a gauge)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Trailing elements","anchor":"Trailing-elements","type":"heading"},{"inlineContent":[{"text":"The trailing position (after the texts) accepts one optional element via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemTrailing"},{"text":", like:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.label(String))"},{"type":"text","text":": A default-styled label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelMuted(String))"},{"type":"text","text":": A muted (secondary) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".text(.labelAndExtraLabel(String, String))","type":"codeVoice"},{"text":": A label with an additional extra label below","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".badge(.count(OUDSBadgeCount)","type":"codeVoice"},{"text":": A badge with count","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge(.standard(OU