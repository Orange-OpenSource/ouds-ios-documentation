{"sections":[],"abstract":[{"text":"A list item component used to display a row of interactive, navigable content within a list.","type":"text"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudsnavigationlistitem"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSNavigationListItem"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"type":"text","text":" is an interactive variant of the list item that triggers an action when tapped."},{"type":"text","text":" "},{"type":"text","text":"It displays a navigation indicator (chevron for next\/previous, or an external link icon)"},{"type":"text","text":" "},{"type":"text","text":"to communicate the type of navigation to the user."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The item typically contains a label, and optionally a description, an overline, an extra label,"},{"type":"text","text":" "},{"type":"text","text":"a text slot, a bottom slot, and a helper text — all provided through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)"},{"type":"text","text":" "},{"type":"text","text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For non-interactive, display-only list items, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Indicator types","anchor":"Indicator-types","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType"},{"type":"text","text":" enum defines the visual indicator and semantic meaning of the navigation:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".next","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".previous","type":"codeVoice"}]},{"type":"text","text":": A backward chevron indicating in-app navigation to a previous screen."},{"type":"text","text":" "},{"type":"text","text":"When using "},{"code":".previous","type":"codeVoice"},{"type":"text","text":", the leading element is automatically hidden."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".external","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"syntax":"swift","code":["    \/\/ Simple navigable list item with forward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Next screen\")","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Open website\"),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Go back\"),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"SMS credit\"),","        trailing: .custom {","            OUDSCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    OUDSNavigationListItem(","        data: OUDSListItemData(","            label: \"Settings\",","            textSlot: { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to settings","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    OUDSNavigationListItem(","        data: OUDSListItemData("," 