},{"type":"text","text":" "},{"type":"text","text":"It displays a navigation indicator (chevron for next\/previous, or an external link icon)"},{"type":"text","text":" "},{"type":"text","text":"to communicate the type of navigation to the user."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The item typically contains a label, and optionally a description, an overline, an extra label,"},{"type":"text","text":" "},{"type":"text","text":"a text slot, a bottom slot, and a helper text — all provided through "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemData","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)"},{"type":"text","text":" "},{"type":"text","text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For non-interactive, display-only list items, see "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Indicator types","level":2,"anchor":"Indicator-types","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItemIndicatorType","isActive":true},{"type":"text","text":" enum defines the visual indicator and semantic meaning of the navigation:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".next"}]},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".previous"}]},{"type":"text","text":": A backward chevron indicating in-app navigation to a previous screen."},{"type":"text","text":" "},{"type":"text","text":"When using "},{"type":"codeVoice","code":".previous"},{"type":"text","text":", the leading element is automatically hidden."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".external"}]},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Code-samples","text":"Code samples","type":"heading"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Simple navigable list item with forward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Next screen\"))","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Open website\")),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    OUDSNavigationListItem(","        data: OUDSListItemData(label: .textual(\"Go back\")),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = OUDSListItemAvatar(type: .icon, size: .medium)","","    OUDSNavigationListItem(","        data: OUDSListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    OUDSNavigationLis