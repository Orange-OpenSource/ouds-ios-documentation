{"kind":"symbol","abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Best used inside layouts to show progress."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"type":"heading","text":"Variants","anchor":"Variants","level":2},{"type":"paragraph","inlineContent":[{"text":"Two variants are provided:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}]}]}]},{"type":"heading","text":"Statuses","anchor":"Statuses","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Accent"}],"type":"strong"},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Positive"}],"type":"strong"},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Info"}],"type":"strong"},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"type":"text","text":"monitored."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}]}]}]},{"type":"heading","text":"Gap size","anchor":"Gap-size","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"small"}],"type":"strong"},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}]},{"type":"heading","text":"Track","anchor":"Track","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}]}]}]},{"type":"heading","text":"Stop indicator (determinate only)","anchor":"Stop-indicator-determinate-only","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}]},{"type":"heading","text":"Helper text","anchor":"Helper-text","level":2},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the progress bar to provide context or additional information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, use "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType","isActive":true,"type":"reference"},{"type":"text","text":" which offers two variants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".description(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"code":"alignment","type":"codeVoice"},{"type":"text","text":" parameter controls horizontal alignment ("},{"type":"codeVoice","code":".center"},{"type":"text","text":", "},{"code":".start","type":"codeVoice"},{"type":"text","text":", or "},{"code":".end","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".percent(description:alignment:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Displays the progress percentage with an optional description."},{"type":"text","text":" "},{"type":"text","text":"The percentage value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"code":"\"75%\"","type":"codeVoice"},{"type":"text","text":" in English, "},{"code":"\"75 %\"","type":"codeVoice"},{"type":"text","text":" in French, "},{"code":"\"٪75\"","type":"codeVoice"},{"type":"text","text":" in Arabic)."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".center","type":"codeVoice"},{"text":" (default), only the percentage is shown, centered.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", the percentage is at the leading edge and the description (if provided) at the trailing edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".end","type":"codeVoice"},{"text":", the description (if provided) is at the leading edge and the percentage at the trailing edge.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":" with a separate "},{"type":"codeVoice","code":"helperTextAlignment"},{"type":"text","text":" parameter:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".center"}],"type":"strong"},{"type":"text","text":" (default): The text is centered under the progress bar."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".start"}],"type":"strong"},{"type":"text","text":": The text is aligned to the leading edge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".end"}],"type":"strong"},{"type":"text","text":": The text is aligned to the trailing edge."}],"type":"paragraph"}]}]},{"type":"heading","text":"Animation","anchor":"Animation","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"type":"text","text":": when "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (default), the indicator progressively fills from "},{"code":"0","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" on first display and animates any subsequent change of "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(based on Android Material 3 specifications). When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"parameter on the indeterminate initializer."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"type":"heading","text":"Code samples","anchor":"Code-samples","level":2},{"type":"heading","text":"Determinate — Basic usage","anchor":"Determinate-Basic-usage","level":3},{"code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"text":". Example: ","type":"text"},{"inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage)","type":"text"},{"text":" ","type":"text"},{"text":"so that Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that","type":"text"},{"text":" ","type":"text"},{"text":"assistive technologies know the value is changing. If a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, it is exposed as the","type":"text"},{"text":" ","type":"text"},{"text":"accessibility label (Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}],"type":"emphasis"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" trait is used.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode without helper text, the view is hidden from Voice Over","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore also excluded from Full Keyboard Access navigation:","type":"text"},{"text":" ","type":"text"},{"text":"there is no readable value to expose. When a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, the helper text is exposed","type":"text"},{"text":" ","type":"text"},{"text":"as accessibility label so the user still understands the context.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}]},{"type":"heading","text":"Colored surfaces","anchor":"Colored-surfaces","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When placed on an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":", the indicator switches to a "},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}]},{"type":"heading","text":"Design documentation","anchor":"Design-documentation","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/unified-design-system.orange.com","isActive":true,"type":"reference"}]},{"type":"heading","text":"Themes rendering","anchor":"Themes-rendering","level":2},{"type":"heading","text":"Orange","anchor":"Orange","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Orange","type":"image"}]},{"type":"heading","text":"Orange Compact","anchor":"Orange-Compact","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_OrangeCompact","type":"image"}]},{"type":"heading","text":"Sosh","anchor":"Sosh","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Sosh","type":"image"}]},{"type":"heading","text":"Wireframe","anchor":"Wireframe","level":3},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Wireframe","type":"image"}]},{"style":"note","type":"aside","name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"title":"Initializers","