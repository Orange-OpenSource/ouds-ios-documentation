{"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/body"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Variants","text":"Variants"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two variants are provided:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"type":"text","text":": the caller provides a "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" value in "},{"code":"[0, 1]","type":"codeVoice"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"type":"text","text":": no "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Statuses","text":"Statuses"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Accent"}],"type":"strong"},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Positive"}],"type":"strong"},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Info"}],"type":"strong"},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"type":"text","text":"monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Gap-size","text":"Gap size"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"small"}],"type":"strong"},{"type":"text","text":": reduced gap for a more compact appearance."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Track","text":"Track"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"false","type":"codeVoice"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Stop-indicator-determinate-only","text":"Stop indicator (determinate only)"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"false","type":"codeVoice"},{"type":"text","text":" (default): no stop indicator is drawn."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stop indicator is only available on the determinate variant, matching the Android Material 3"},{"type":"text","text":" "},{"type":"text","text":"specification: the indeterminate variant has no meaningful end position for it."}]},{"type":"heading","level":2,"anchor":"Helper-text","text":"Helper text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional text displayed below the progress bar to provide context or additional information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"},{"type":"text","text":" which offers two variants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".description(_:)"}],"type":"strong"},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"code":"alignment","type":"codeVoice"},{"type":"text","text":" parameter controls horizontal alignment ("},{"code":".center","type":"codeVoice"},{"type":"text","text":", "},{"code":".start","type":"codeVoice"},{"type":"text","text":", or "},{"code":".end","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".percent(description:alignment:)"}],"type":"strong"},{"type":"text","text":": Displays the progress percentage with an optional description."},{"type":"text","text":" "},{"type":"text","text":"The percentage value and its "},{"code":"%","type":"codeVoice"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"code":"\"75%\"","type":"codeVoice"},{"type":"text","text":" in English, "},{"code":"\"75 %\"","type":"codeVoice"},{"type":"text","text":" in French, "},{"code":"\"٪75\"","type":"codeVoice"},{"type":"text","text":" in Arabic)."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".center"},{"type":"text","text":" (default), only the percentage is shown, centered."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".start"},{"type":"text","text":", the percentage is at the leading edge and the description (if provided) at the trailing edge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".end"},{"type":"text","text":", the description (if provided) is at the leading edge and the percentage at the trailing edge."}],"type":"paragraph"}]}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":" with a separate "},{"type":"codeVoice","code":"helperTextAlignment"},{"type":"text","text":" parameter:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".center"}],"type":"strong"},{"type":"text","text":" (default): The text is centered under the progress bar."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".start"}],"type":"strong"},{"type":"text","text":": The text is aligned to the leading edge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".end"}],"type":"strong"},{"type":"text","text":": The text is aligned to the trailing edge."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Animation","text":"Animation"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"type":"text","text":": when "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (default), the indicator progressively fills from "},{"code":"0","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" on first display and animates any subsequent change of "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(based on Android Material 3 specifications). When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"type":"text","text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"parameter on the indeterminate initializer."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"type":"heading","level":2,"anchor":"Code-samples","text":"Code samples"},{"type":"heading","level":3,"anchor":"Determinate-Basic-usage","text":"Determinate — Basic usage"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"]},{"type":"heading","level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use the "},{"code":"accessibility","type":"codeVoice"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"type":"text","text":". Example: "},{"inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"code":"accessibility","type":"codeVoice"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage)"},{"type":"text","text":" "},{"type":"text","text":"so that Voice Over reads e.g. "},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"type":"text","text":", and is marked with the "},{"code":".updatesFrequently","type":"codeVoice"},{"type":"text","text":" trait so that"},{"type":"text","text":" "},{"type":"text","text":"assistive technologies know the value is changing. If a "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" is provided, it is exposed as the"},{"type":"text","text":" "},{"type":"text","text":"accessibility label (Voice Over reads e.g. "},{"inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"type":"text","text":" focus, as no interaction is possible on a"},{"type":"text","text":" "},{"type":"text","text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced"},{"type":"text","text":" "},{"type":"text","text":"via "},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"type":"text","text":"; on earlier OS versions, the semantic"},{"type":"text","text":" "},{"code":".isStaticText","type":"codeVoice"},{"type":"text","text":" trait is used."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or when Low Power Mode is enabled."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Colored-surfaces","text":"Colored surfaces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When placed on an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface"},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"text":"monochrome","type":"text"}]},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}]},{"type":"heading","level":2,"anchor":"Design-documentation","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/unified-design-system.orange.com"}]},{"type":"heading","level":2,"anchor":"Themes-rendering","text":"Themes rendering"},{"type":"heading","level":3,"anchor":"Orange","text":"Orange"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Orange"}]},{"type":"heading","level":3,"anchor":"Orange-Compact","text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_OrangeCompact"}]},{"type":"heading","level":3,"anchor":"Sosh","text":"Sosh"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Sosh"}]},{"type":"heading","level":3,"anchor":"Wireframe","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Wireframe"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}]}],"name":"Version"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}],"name":"Since"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"symbolKind":"struct","role":"symbol","modules":[{"name":"Components"}],"title":"OUDSLinearProgressIndicator","navigatorTitle":[{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"roleHeading":"Structure","platforms":[{"introducedAt":"15.0","unavailable":false,"deprecated":false,"beta":false,"name":"iOS"},{"introducedAt":"13.0","unavailable":false,"deprecated":false,"beta":false,"name":"macOS"},{"introducedAt":"16.0","unavailable":false,"deprecated":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","unavailable":false,"deprecated":false,"beta":false,"name":"visionOS"},{"introducedAt":"11.0","unavailable":false,"deprecated":false,"beta":false,"name":"watchOS"}],"externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},"kind":"symbol","abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Best used inside layouts to show progress."}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"references":{"component_progress_indicator_linear_Wireframe":{"identifier":"component_progress_indicator_linear_Wireframe","alt":"A linear progress indicator component in light and dark modes with Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_progress_indicator_linear_Wireframe.png"}],"type":"image"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSProgressIndicatorStatus","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents27OUDSProgressIndicatorStatusO"},{"text":", ","kind":"text"},{"text":"track","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"helperText","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"helperTextAlignment","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents27OUDSLinearProgressIndicatorV"},{"text":".","kind":"text"},{"text":"HelperTextAlignment","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents27OUDSLinearProgres