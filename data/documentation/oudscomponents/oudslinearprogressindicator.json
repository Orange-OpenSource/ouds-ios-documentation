"Best used inside layouts to show progress."}],"type":"topic","navigatorTitle":[{"text":"OUDSLinearProgressIndicator","kind":"identifier"}]},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"doc://OUDSComponents/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"title":"OUDSColoredSurface","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","url":"\/documentation\/oudscomponents\/oudscoloredsurface","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSColoredSurface","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSColoredSurface","kind":"identifier"}]},"component_progress_indicator_linear_Orange":{"type":"image","alt":"A linear progress indicator component in light and dark modes with Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_progress_indicator_linear_Orange.png"}],"identifier":"component_progress_indicator_linear_Orange"},"doc://OUDSComponents/documentation/OUDSComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/oudscomponents","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"title":"Components","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents"},"component_progress_indicator_linear_Wireframe":{"alt":"A linear progress indicator component in light and dark modes with Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_progress_indicator_linear_Wireframe.png","traits":["1x","light"]}],"identifier":"component_progress_indicator_linear_Wireframe","type":"image"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/View-Implementations":{"abstract":[],"title":"View Implementations","kind":"article","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","url":"\/documentation\/oudscomponents\/oudslinearprogressindicator\/view-implementations","role":"collectionGroup","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/Indicators":{"title":"Indicators","kind":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","type":"topic","url":"\/documentation\/oudscomponents\/indicators","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"}}}