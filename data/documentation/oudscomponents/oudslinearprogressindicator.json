{"metadata":{"externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"role":"symbol","platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"15.0","beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","beta":false,"name":"macOS"},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS"},{"deprecated":false,"beta":false,"name":"watchOS","unavailable":false,"introducedAt":"11.0"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"modules":[{"name":"Components"}],"title":"OUDSLinearProgressIndicator"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"anchor":"Variants","type":"heading","text":"Variants","level":2},{"type":"paragraph","inlineContent":[{"text":"Two variants are provided:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Indeterminate","type":"text"}]},{"type":"text","text":": no "},{"code":"progress","type":"codeVoice"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"text":"the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Statuses","type":"heading","text":"Statuses","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Neutral","type":"text"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"text":": indicates progress related to an operation that requires user attention or should be","type":"text"},{"text":" ","type":"text"},{"text":"monitored.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Negative"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}]}]}],"type":"unorderedList"},{"anchor":"Gap-size","type":"heading","text":"Gap size","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"text":": standard gap between the bar and the track (base Android Material 3 specification).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"small"}]},{"text":": reduced gap for a more compact appearance.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Track","level":2,"type":"heading","text":"Track"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}]}]}],"type":"unorderedList"},{"anchor":"Stop-indicator-determinate-only","level":2,"type":"heading","text":"Stop indicator (determinate only)"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}]},{"anchor":"Helper-text","level":2,"type":"heading","text":"Helper text"},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the progress bar to provide context or additional information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType","type":"reference"},{"text":" which offers two variants:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".description(_:)"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" parameter controls horizontal alignment ("},{"type":"codeVoice","code":".center"},{"type":"text","text":", "},{"type":"codeVoice","code":".start"},{"type":"text","text":", or "},{"type":"codeVoice","code":".end"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".percent(description:alignment:)"}]},{"text":": Displays the progress percentage with an optional description.","type":"text"},{"text":" ","type":"text"},{"text":"The percentage value and its ","type":"text"},{"type":"codeVoice","code":"%"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"type":"codeVoice","code":"\"75%\""},{"text":" in English, ","type":"text"},{"type":"codeVoice","code":"\"75 %\""},{"text":" in French, ","type":"text"},{"type":"codeVoice","code":"\"٪75\""},{"text":" in Arabic).","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".center","type":"codeVoice"},{"text":" (default), only the percentage is shown, centered.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", the percentage is at the leading edge and the description (if provided) at the trailing edge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".end","type":"codeVoice"},{"text":", the description (if provided) is at the leading edge and the percentage at the trailing edge.","type":"text"}]}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"text":" mode, the ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" parameter is a simple ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":" with a separate ","type":"text"},{"code":"helperTextAlignment","type":"codeVoice"},{"text":" parameter:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".center"}]},{"text":" (default): The text is centered under the progress bar.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".start"}]},{"text":": The text is aligned to the leading edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".end"}]},{"text":": The text is aligned to the trailing edge.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Animation","level":2,"type":"heading","text":"Animation"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": when "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" "},{"type":"text","text":"(based on Android Material 3 specifications). When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no ","type":"text"},{"type":"codeVoice","code":"animated"},{"text":" ","type":"text"},{"text":"parameter on the indeterminate initializer.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Animations are always disabled and a static bar filled at 70% is displayed when either","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or Low Power Mode is enabled.","type":"text"}]},{"anchor":"Code-samples","level":2,"type":"heading","text":"Code samples"},{"anchor":"Determinate-Basic-usage","level":3,"type":"heading","text":"Determinate — Basic usage"},{"type":"codeListing","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"],"syntax":"swift"},{"anchor":"Accessibility-considerations","level":2,"type":"heading","text":"Accessibility considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"type":"strong","inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}]},{"type":"text","text":". Example: "},{"inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage)"},{"type":"text","text":" "},{"type":"text","text":"so that Voice Over reads e.g. "},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that"},{"type":"text","text":" "},{"type":"text","text":"assistive technologies know the value is changing. If a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, it is exposed as the"},{"type":"text","text":" "},{"type":"text","text":"accessibility label (Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}]},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"text":"The indicator never captures ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Full Keyboard Access"}]},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".isStaticText"},{"text":" trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}]}]},{"content":[{"inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or when Low Power Mode is enabled.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Colored-surfaces","level":2,"type":"heading","text":"Colored surfaces"},{"type":"paragraph","inlineContent":[{"text":"When placed on an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}]},{"anchor":"Design-documentation","level":2,"type":"heading","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/unified-design-system.orange.com","isActive":true}]},{"anchor":"Themes-rendering","type":"heading","text":"Themes rendering","level":2},{"anchor":"Orange","level":3,"type":"heading","text":"Orange"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Orange"}]},{"anchor":"Orange-Compact","type":"headi