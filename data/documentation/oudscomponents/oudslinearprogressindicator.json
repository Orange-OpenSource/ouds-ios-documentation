{"abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Best used inside layouts to show progress."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(status:track:helperText:gapSize:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"kind":"relationships","type":"conformsTo"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"platforms":[{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"13.0","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS","unavailable":false},{"beta":false,"introducedAt":"11.0","deprecated":false,"name":"watchOS","unavailable":false}],"externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV","modules":[{"name":"Components"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"title":"OUDSLinearProgressIndicator","role":"symbol","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"text":"Variants","level":2,"type":"heading","anchor":"Variants"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"text":": no ","type":"text"},{"code":"progress","type":"codeVoice"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Statuses","level":2,"type":"heading","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"text":": default status used when progress has no specific semantic meaning. Suitable for generic","type":"text"},{"text":" ","type":"text"},{"text":"loading, processing, synchronization or background tasks.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"text":": indicates informational or system-related processes (background synchronization, data","type":"text"},{"text":" ","type":"text"},{"text":"retrieval).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"type":"text","text":"monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}]},{"anchor":"Gap-size","type":"heading","level":2,"text":"Gap size"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"small"}]},{"text":": reduced gap for a more compact appearance.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Track","type":"heading","anchor":"Track","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}]}]}]},{"anchor":"Stop-indicator-determinate-only","type":"heading","level":2,"text":"Stop indicator (determinate only)"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}]}]},{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}],"type":"paragraph"},{"anchor":"Helper-text","level":2,"type":"heading","text":"Helper text"},{"inlineContent":[{"type":"text","text":"An optional string displayed centered below the bar. It can provide context about the process or show"},{"type":"text","text":" "},{"type":"text","text":"the current progress value (e.g. "},{"type":"codeVoice","code":"\"Uploading...\""},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"Animation","level":2,"type":"heading","text":"Animation"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"type":"text","text":": when "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (default), the indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"code":"progress","type":"codeVoice"},{"text":" on first display and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(based on Android Material 3 specifications). When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the indicator is displayed instantly at its target value with no animation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no ","type":"text"},{"type":"codeVoice","code":"animated"},{"text":" ","type":"text"},{"type":"text","text":"parameter on the indeterminate initializer."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"text":" ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: \"Uploading…\")","","    \/\/ Determinate with a warning status, a small gap, a stop indicator and no animation","    OUDSLinearProgressIndicator(progress: 0.3,","                                status: .warning,","                                stopIndicator: true,","                                gapSize: .small,","                                animated: false)","","    \/\/ Indeterminate (always animated — Android Material 3 two-line race)","    OUDSLinearProgressIndicator()","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Accessibility considerations","type":"heading","anchor":"Accessibility-considerations"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage)"},{"type":"text","text":" "},{"type":"text","text":"so that Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"text":"“75 percent”","type":"text"}]},{"type":"text","text":", and is marked with the "},{"code":".updatesFrequently","type":"codeVoice"},{"type":"text","text":" trait so that"},{"type":"text","text":" "},{"type":"text","text":"assistive technologies know the value is changing. If a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, it is exposed as the"},{"text":" ","type":"text"},{"text":"accessibility label (Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".isStaticText"},{"text":" trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Colored surfaces","type":"heading","level":2,"anchor":"Colored-surfaces"},{"inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","type":"reference","isActive":true},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"type":"text","text":"monochrome"}]},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/unified-design-system.orange.com"}],"type":"paragraph"},{"anchor":"Themes-rendering","text":"Themes rendering","type":"heading","level":2},{"anchor":"Orange","text":"Orange","type":"heading","level":3},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Orange"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":3},{"inlineContent":[{"identifier":"component_progress_indicator_linear_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Sosh","text":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Sosh","type":"image"}]},{"level":3,"type":"heading","anchor":"Wireframe","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Wireframe","type":"image"}]},{"type":"aside","name":"Version","style":"note","content":[{"inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}],"type":"paragraph"}]},{"type":"aside","name":"Since","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}]}],"kind":"content"}],"references":{"component_progress_indicator_linear_Sosh":{"identifier":"component_progress_indicator_linear_Sosh","alt":"A linear progress indicator component in 