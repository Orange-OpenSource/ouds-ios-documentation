{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"sections":[],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/body"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Variants","anchor":"Variants"},{"type":"paragraph","inlineContent":[{"text":"Two variants are provided:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Determinate","type":"text"}],"type":"strong"},{"text":": the caller provides a ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" value in ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%.","type":"text"},{"text":" ","type":"text"},{"text":"Provides clear and measurable feedback, helping users understand how long the task will take and","type":"text"},{"text":" ","type":"text"},{"text":"reducing uncertainty.","type":"text"},{"text":" ","type":"text"},{"text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g.","type":"text"},{"text":" ","type":"text"},{"text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate","type":"text"},{"text":" ","type":"text"},{"text":"completion time or percentage.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": no ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"text":" ","type":"text"},{"text":"Used when the system cannot determine how long the task will take.","type":"text"},{"text":" ","type":"text"},{"text":"Communicates that the system is working, even without precise data, and prevents users from thinking","type":"text"},{"text":" ","type":"text"},{"text":"the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Neutral","type":"text"}],"type":"strong"},{"text":": default status used when progress has no specific semantic meaning. Suitable for generic","type":"text"},{"text":" ","type":"text"},{"text":"loading, processing, synchronization or background tasks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Accent","type":"text"}],"type":"strong"},{"text":": used to highlight primary or brand-related actions (uploads, downloads, installations,","type":"text"},{"text":" ","type":"text"},{"text":"onboarding).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Info","type":"text"}],"type":"strong"},{"text":": indicates informational or system-related processes (background synchronization, data","type":"text"},{"text":" ","type":"text"},{"text":"retrieval).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"text":": indicates progress related to an operation that requires user attention or should be","type":"text"},{"text":" ","type":"text"},{"text":"monitored.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Gap size","anchor":"Gap-size"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":": standard gap between the bar and the track (base Android Material 3 specification).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"small","type":"text"}],"type":"strong"},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Track","anchor":"Track"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs","type":"text"},{"text":" ","type":"text"},{"text":"a clear structure. The track helps define the full range of progress and makes the value easier to","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Stop indicator (determinate only)","anchor":"Stop-indicator-determinate-only"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":" (default): no stop indicator is drawn.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to","type":"text"},{"text":" ","type":"text"},{"text":"identify the end of the range easily. Required by accessibility criteria when the track has a","type":"text"},{"text":" ","type":"text"},{"text":"contrast below 3:1 with its container or the surface behind the container.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}]},{"type":"heading","level":2,"text":"Helper text","anchor":"Helper-text"},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the progress bar to provide context or additional information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType","isActive":true,"type":"reference"},{"text":" which offers two variants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".description(_:)"}],"type":"strong"},{"text":": Displays a simple description text without the progress percentage.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" parameter controls horizontal alignment (","type":"text"},{"code":".center","type":"codeVoice"},{"text":", ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".end","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".percent(description:alignment:)"}],"type":"strong"},{"text":": Displays the progress percentage with an optional description.","type":"text"},{"text":" ","type":"text"},{"text":"The percentage value and its ","type":"text"},{"code":"%","type":"codeVoice"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"code":"\"75%\"","type":"codeVoice"},{"text":" in English, ","type":"text"},{"code":"\"75 %\"","type":"codeVoice"},{"text":" in French, ","type":"text"},{"code":"\"٪75\"","type":"codeVoice"},{"text":" in Arabic).","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".center","type":"codeVoice"},{"text":" (default), only the percentage is shown, centered.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", the percentage is at the leading edge and the description (if provided) at the trailing edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".end","type":"codeVoice"},{"text":", the description (if provided) is at the leading edge and the percentage at the trailing edge.","type":"text"}],"type":"paragraph"}]}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode, the ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" parameter is a simple ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":" with a separate ","type":"text"},{"code":"helperTextAlignment","type":"codeVoice"},{"text":" parameter:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".center","type":"codeVoice"}],"type":"strong"},{"text":" (default): The text is centered under the progress bar.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".start","type":"codeVoice"}],"type":"strong"},{"text":": The text is aligned to the leading edge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".end","type":"codeVoice"}],"type":"strong"},{"text":": The text is aligned to the trailing edge.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Animation","anchor":"Animation"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Determinate","type":"text"}],"type":"strong"},{"text":": when ","type":"text"},{"type":"codeVoice","code":"animated"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" (default), the indicator progressively fills from ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" ","type":"text"},{"text":"to the target ","type":"text"},{"type":"codeVoice","code":"progress"},{"text":" on first display and animates any subsequent change of ","type":"text"},{"type":"codeVoice","code":"progress"},{"text":" ","type":"text"},{"text":"(based on Android Material 3 specifications). When ","type":"text"},{"type":"codeVoice","code":"animated"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", the indicator is displayed instantly at its target value with no animation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no ","type":"text"},{"type":"codeVoice","code":"animated"},{"text":" ","type":"text"},{"text":"parameter on the indeterminate initializer.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Animations are always disabled and a static bar filled at 70% is displayed when either","type":"text"},{"text":" ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or Low Power Mode is enabled.","type":"text"}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"heading","level":3,"text":"Determinate — Basic usage","anchor":"Determinate-Basic-usage"},{"type":"codeListing","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"],"syntax":"swift"},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"accessibility"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}],"type":"strong"},{"text":". Example: ","type":"text"},{"inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"accessibility"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage)","type":"text"},{"text":" ","type":"text"},{"text":"so that Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"type":"codeVoice","code":".updatesFrequently"},{"text":" trait so that","type":"text"},{"text":" ","type":"text"},{"text":"assistive technologies know the value is changing. If a ","type":"text"},{"type":"codeVoice","code":"helperText"},{"text":" is provided, it is exposed as the","type":"text"},{"text":" ","type":"text"},{"text":"accessibility label (Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"text":"“Uploading. 75 percent”","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"text":"Full Keyboard Access","type":"text"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" trait is used.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"text":" mode without helper text, the view is hidden from Voice Over","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore also excluded from Full Keyboard Access navigation:","type":"text"},{"text":" ","type":"text"},{"text":"there is no readable value to expose. When a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, the helper text is exposed","type":"text"},{"text":" ","type":"text"},{"text":"as accessibility label so the user still understands the context.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Colored surfaces","anchor":"Colored-surfaces"},{"type":"paragraph","inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"text":" rendering, the","type":"text"},{"text":" ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is ignored.","type":"text"}]},{"type":"heading","level":2,"text":"Design documentation","anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-linear-progress-indicator","isActive":true,"type":"reference"}]},{"type":"heading","level":2,"text":"Themes rendering","anchor":"Themes-rendering"},{"type":"heading","level":3,"text":"Orange","anchor":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Orange","type":"image"}]},{"type":"heading","level":3,"text":"Orange Compact","anchor":"Orange-Compact"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_OrangeCompact","type":"image"}]},{"type":"heading","level":3,"text":"Sosh","anchor":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Sosh","type":"image"}]},{"type":"heading","level":3,"text":"Wireframe","anchor":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Wireframe","type":"image"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside","name":"Version"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside","name":"Since"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"metadata":{"externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"title":"OUDSLinearProgressIndicator","platforms":[{"introducedAt":"15.0","unavailable":false,"deprecated":false,"name":"iOS","beta":false},{"introducedAt":"15.0","unavailable":false,"deprecated":false,"name":"iPadOS","beta":false},{"introducedAt":"15.0","unavailable":false,"deprecated":false,"name":"Mac Catalyst","beta":false},{"introducedAt":"13.0","unavailable":false,"deprecated":false,"name":"macOS","beta":false},{"introducedAt":"16.0","unavailable":false,"deprecated":false,"name":"tvOS","beta":false},{"introducedAt":"1.0","unavailable":false,"deprecated":false,"name":"visionOS","beta":false},{"introducedAt":"11.0","unavailable":false,"deprecated":false,"name":"watchOS","beta":false}],"symbolKind":"struct","modules":[{"name":"Components"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"OUDSLinearProgressIndicator"}]},"kind":"symbol","references":{"https://r.orange.fr/r/S-ouds-doc-linear-progress-indicator":{"url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-linear-progress-indicator","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-linear-progress-indicator","title":"unified-design-system.orange.com","type":"link","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)":{"url":"\/documentation\/oudscomponents\/oudslinearprogressindicator\/init(progress:status:track:stopindicator:helpertext:gapsize:animated:accessibility:)","kind":"symbol","type":"topic","abstract":[{"text":"Creates a ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" linear progress indicator.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"progress","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14OUDSComponents27OUDSProgressIndicatorStatusO","text":"OUDSProgressIndicatorStatus","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"track","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"tex