{"sections":[],"abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Structure","role":"symbol","modules":[{"name":"Components"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV","platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"16.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"11.0","deprecated":false,"unavailable":false,"beta":false}],"title":"OUDSLinearProgressIndicator","navigatorTitle":[{"text":"OUDSLinearProgressIndicator","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"],"generated":true,"anchor":"Enumerations"},{"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Variants","anchor":"Variants","type":"heading"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}],"type":"paragraph"}]}]},{"level":2,"text":"Statuses","anchor":"Statuses","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Neutral"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"type":"text","text":"monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Negative"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}]},{"level":2,"text":"Gap size","anchor":"Gap-size","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"small"}]},{"type":"text","text":": reduced gap for a more compact appearance."}],"type":"paragraph"}]}]},{"level":2,"text":"Track","anchor":"Track","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}]},{"level":2,"text":"Stop indicator (determinate only)","anchor":"Stop-indicator-determinate-only","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Helper text","anchor":"Helper-text","type":"heading"},{"inlineContent":[{"text":"An optional text displayed below the progress bar to provide context or additional information.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType","isActive":true,"type":"reference"},{"text":" which offers two variants:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".description(_:)"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" parameter controls horizontal alignment ("},{"type":"codeVoice","code":".center"},{"type":"text","text":", "},{"type":"codeVoice","code":".start"},{"type":"text","text":", or "},{"type":"codeVoice","code":".end"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".percent(description:alignment:)"}]},{"type":"text","text":": Displays the progress percentage with an optional description."},{"type":"text","text":" "},{"type":"text","text":"The percentage value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".center","type":"codeVoice"},{"text":" (default), only the percentage is shown, centered.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", the percentage is at the leading edge and the description (if provided) at the trailing edge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".end","type":"codeVoice"},{"text":", the description (if provided) is at the leading edge and the percentage at the trailing edge.","type":"text"}]}]}]}]}]},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode, the ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" parameter is a simple ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":" with a separate ","type":"text"},{"code":"helperTextAlignment","type":"codeVoice"},{"text":" parameter:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".center"}]},{"type":"text","text":" (default): The text is centered under the progress bar."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".start"}]},{"type":"text","text":": The text is aligned to the leading edge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".end"}]},{"type":"text","text":": The text is aligned to the trailing edge."}],"type":"paragraph"}]}]},{"level":2,"text":"Animation","anchor":"Animation","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": when "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" "},{"type":"text","text":"(based on Android Material 3 specifications). When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"type":"text","text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" "},{"type":"text","text":"parameter on the indeterminate initializer."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Animations are always disabled and a static bar filled at 70% is displayed when either","type":"text"},{"text":" ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or Low Power Mode is enabled.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"level":3,"text":"Determinate — Basic usage","anchor":"Determinate-Basic-usage","type":"heading"},{"code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"type":"strong","inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}]},{"type":"text","text":". Example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage)"},{"type":"text","text":" "},{"type":"text","text":"so that Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“75 percent”"}]},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that"},{"type":"text","text":" "},{"type":"text","text":"assistive technologies know the value is changing. If a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, it is exposed as the"},{"type":"text","text":" "},{"type":"text","text":"accessibility label (Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}]},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"type":"text","text":"Full Keyboard Access"}]},{"type":"text","text":" focus, as no interaction is possible on a"},{"type":"text","text":" "},{"type":"text","text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic"},{"type":"text","text":" "},{"type":"codeVoice","code":".isStaticText"},{"type":"text","text":" trait is used."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}],"type":"paragraph"}]}]},{"level":2,"text":"Colored surfaces","anchor":"Colored-surfaces","type":"heading"},{"inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","isActive":true,"type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"text":" rendering, the","type":"text"},{"text":" ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is ignored.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Design documentation","anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"identifier":"https:\/\/unified-design-system.orange.com","isActive":true,"type":"reference"}],"type":"paragraph"},{"level":2,"text":"Themes rendering","anchor":"Themes-rendering","type":"heading"},{"level":3,"text":"Orange","anchor":"Orange","type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_linear_Orange","type":"image"}],"type":"paragraph"},{"level":3,"text":"Orange Compact","anchor":"Orange-Compact","type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_linear_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"text":"Sosh","anchor":"Sosh","type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_linear_Sosh","type":"image"}],"type":"paragraph"},{"level":3,"text":"Wireframe","anchor":"Wireframe","type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_linear_Wireframe","type":"image"}],"type":"paragraph"},{"name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"role":"collection","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/oudscomponents","title":"Components","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSColoredSurface":{"kind":"symbol","role":"symbol","title":"OUDSColoredSurface","type":"topic","url":"\/documentation\/oudscomponents\/oudscoloredsurface","navigatorTitle":[{"text":"OUDSColoredSurface","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSColoredSurface","kind":"identifier"}],"abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)":{"abstract":[{"text":"Creates an ","type":"text"},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"text":" linear progress indicator.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"status","kind":"externalPar