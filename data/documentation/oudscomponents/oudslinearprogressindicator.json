{"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"],"generated":true,"anchor":"Enumerations"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"title":"Default Implementations","generated":true}],"metadata":{"roleHeading":"Structure","externalID":"s:14OUDSComponents27OUDSLinearProgressIndicatorV","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLinearProgressIndicator"}],"title":"OUDSLinearProgressIndicator","platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"macOS","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"16.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"11.0"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslinearprogressindicator"]}],"abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"text":"Best used inside layouts to show progress.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLinearProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"]},{"kind":"content","content":[{"text":"Variants","anchor":"Variants","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Two variants are provided:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"text":": no ","type":"text"},{"type":"codeVoice","code":"progress"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}]}]}]},{"type":"heading","level":2,"text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Neutral"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"text":" ","type":"text"},{"type":"text","text":"loading, processing, synchronization or background tasks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Accent"}],"type":"strong"},{"text":": used to highlight primary or brand-related actions (uploads, downloads, installations,","type":"text"},{"text":" ","type":"text"},{"text":"onboarding).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"text":" ","type":"text"},{"text":"retrieval).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"text":"monitored.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}]},{"type":"heading","text":"Gap size","anchor":"Gap-size","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}]},{"type":"heading","text":"Track","anchor":"Track","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs"},{"type":"text","text":" "},{"type":"text","text":"a clear structure. The track helps define the full range of progress and makes the value easier to"},{"type":"text","text":" "},{"type":"text","text":"read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}]}]}]},{"level":2,"text":"Stop indicator (determinate only)","anchor":"Stop-indicator-determinate-only","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to","type":"text"},{"text":" ","type":"text"},{"text":"identify the end of the range easily. Required by accessibility criteria when the track has a","type":"text"},{"text":" ","type":"text"},{"text":"contrast below 3:1 with its container or the surface behind the container.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stop indicator is only available on the determinate variant, matching the Android Material 3"},{"type":"text","text":" "},{"type":"text","text":"specification: the indeterminate variant has no meaningful end position for it."}]},{"level":2,"text":"Helper text","anchor":"Helper-text","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional text displayed below the progress bar to provide context or additional information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextType"},{"type":"text","text":" which offers two variants:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".description(_:)"}],"type":"strong"},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" parameter controls horizontal alignment ("},{"type":"codeVoice","code":".center"},{"type":"text","text":", "},{"type":"codeVoice","code":".start"},{"type":"text","text":", or "},{"type":"codeVoice","code":".end"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".percent(description:alignment:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Displays the progress percentage with an optional description."},{"type":"text","text":" "},{"type":"text","text":"The percentage value and its "},{"code":"%","type":"codeVoice"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"alignment"},{"text":" is ","type":"text"},{"type":"codeVoice","code":".center"},{"text":" (default), only the percentage is shown, centered.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".start"},{"type":"text","text":", the percentage is at the leading edge and the description (if provided) at the trailing edge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"alignment","type":"codeVoice"},{"type":"text","text":" is "},{"code":".end","type":"codeVoice"},{"type":"text","text":", the description (if provided) is at the leading edge and the percentage at the trailing edge."}]}]}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"code":"String?","type":"codeVoice"},{"text":" with a separate ","type":"text"},{"code":"helperTextAlignment","type":"codeVoice"},{"text":" parameter:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".center"}]},{"text":" (default): The text is centered under the progress bar.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".start","type":"codeVoice"}]},{"type":"text","text":": The text is aligned to the leading edge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".end"}]},{"text":": The text is aligned to the trailing edge.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Animation","text":"Animation","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"text":": when ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"to the target "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display and animates any subsequent change of "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" "},{"text":"(based on Android Material 3 specifications). When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter on the indeterminate initializer.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"anchor":"Code-samples","level":2,"text":"Code samples","type":"heading"},{"type":"heading","level":3,"text":"Determinate — Basic usage","anchor":"Determinate-Basic-usage"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    OUDSLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    OUDSLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    OUDSLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    OUDSLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    OUDSLinearProgressIndicator(status: .info)","    OUDSLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    OUDSLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    OUDSLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    OUDSLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    OUDSLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"]},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"text":". Example: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage)","type":"text"},{"text":" ","type":"text"},{"text":"so that Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"“75 percent”"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that","type":"text"},{"text":" ","type":"text"},{"text":"assistive technologies know the value is changing. If a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, it is exposed as the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"accessibility label (Voice Over reads e.g. "},{"inlineContent":[{"text":"“Uploading. 75 percent”","type":"text"}],"type":"emphasis"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode without helper text, the view is hidden from Voice Over","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"text":") — and therefore also excluded from Full Keyboard Access navigation:","type":"text"},{"text":" ","type":"text"},{"text":"there is no readable value to expose. When a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, the helper text is exposed","type":"text"},{"text":" ","type":"text"},{"text":"as accessibility label so the user still understands the context.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Colored surfaces","level":2,"type":"heading","anchor":"Colored-surfaces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When placed on an "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSColoredSurface","type":"reference","isActive":true},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"text":"monochrome","type":"text"}]},{"text":" rendering, the","type":"text"},{"type":"text","text":" "},{"code":"status","type":"codeVoice"},{"text":" is ignored.","type":"text"}]},{"text":"Design documentation","level":2,"type":"heading","anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-linear-progress-indicator"}]},{"level":2,"type":"heading","text":"Themes rendering","anchor":"Themes-rendering"},{"type":"heading","level":3,"anchor":"Orange","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_progress_indicator_linear_Orange","type":"image"}]},{"level":3,"anchor":"Orange-Compact","text":"Orange Compact","type":"heading"},{"inlineContent":[{"identifier":"component_progress_indicator_linear_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Sosh","text":"Sosh","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Sosh"}],"type":"paragraph"},{"level":3,"anchor":"Wireframe","text":"Wireframe","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_progress_indicator_linear_Wireframe"}],"type":"paragraph"},{"style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}]}],"type":"aside"},{"style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside"}]}],"references":{"component_progress_indicator_linear_Orange":{"alt":"A linear progress indicator component in light and dark modes with Orange theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_progress_indicator_linear_Orange.png"}],"identifier":"component_progress_indicator_linear_Orange"},"doc://OUDSComponents/7SwiftUI4ViewP":{"title":"SwiftUICore.View","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/HelperTextAlignment":{"url":"\/documentation\/oudscomponents\/oudslinearprogressindicator\/helpertextalignment","role":"symbol","title":"OUDSLinearProgressIndicator.HelperTextAlignment","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HelperTextAlignment"}],"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperTextAlignment"}],"abstract":[{"text":"The alignment of the helper text for the linear progress indicator.","type":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"progress"},{"kind":"text","text":": "},{"kind":"typeIdenti