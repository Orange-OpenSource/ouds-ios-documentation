onents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/View-Implementations"],"generated":true}],"abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/HelperTextAlignment":{"url":"\/documentation\/oudscomponents\/oudslinearprogressindicator\/helpertextalignment","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLinearProgressIndicator\/HelperTextAlignment","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HelperTextAlignment","kind":"identifier"}],"navigatorTitle":[{"text":"HelperTextAlignment","kind":"identifier"}],"role":"symbol","title":"OUDSLinearProgressIndicator.HelperTextAlignment","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The alignment of the helper text for the linear progress indicator."}]},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLinearProgressIndicator/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)":{"abstract":[{"text":"Creates a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"text":" linear progress indicator.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"progress","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OUDSP