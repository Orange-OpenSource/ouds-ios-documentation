{"text":"OUDSPinCodeInput","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudspincodeinput","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,","type":"text"},{"text":" ","type":"text"},{"text":"such as a four, six or eight-digit personal identification number (PIN).","type":"text"},{"text":" ","type":"text"},{"text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,","type":"text"},{"text":" ","type":"text"},{"text":"while supporting smooth keyboard navigation and secured input masking if needed.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSPinCodeInput","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"}}}