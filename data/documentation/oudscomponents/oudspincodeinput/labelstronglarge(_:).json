UDSComponents/OUDSPinCodeInput":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSPinCodeInput","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSPinCodeInput"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSPinCodeInput"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudspincodeinput","abstract":[{"text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,","type":"text"},{"text":" ","type":"text"},{"text":"such as a four, six or eight-digit personal identification number (PIN).","type":"text"},{"text":" ","type":"text"},{"text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,","type":"text"},{"text":" ","type":"text"},{"text":"while supporting smooth keyboard navigation and secured input masking if needed.","type":"text"}],"kind":"symbol","role":"symbol","title":"OUDSPinCodeInput"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSTheme":{"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTheme"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSTheme"}],"type":"topic","url":"\/documentation\/oudsthemescontract\/oudstheme","abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":