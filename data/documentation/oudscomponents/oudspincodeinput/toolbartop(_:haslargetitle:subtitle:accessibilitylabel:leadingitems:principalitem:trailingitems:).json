lse","type":"text"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}]},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":"."}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" and the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}],"name":"leadingItems"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"text":" is displayed only if ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is never displayed."}]}],"name":"principalItem"},{"content":[{"inlineContent":[{"type":"text","text":"The items displayed on the trailing side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"type":"text","text":" by default."}],"type":"paragraph"}],"name":"trailingItems"}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"text":" must be placed inside a ","type":"text"},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There must be only one "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","tex