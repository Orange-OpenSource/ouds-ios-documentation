},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"navigatorTitle":[{"text":"OUDSSuggestionChip","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSSuggestionChip"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","role":"symbol","url":"\/documentation\/oudscomponents\/oudssuggestionchip","type":"topic","title":"OUDSSuggestionChip"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSImage":{"title":"OUDSImage","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSImage","kind":"symbol","url":"\/documentation\/oudscomponents\/oudsimage","type":"topic","abstract":[{"type":"text","text":"Use to provide an asset to ouds in order to be added in some components."},{"type":"text","text":" "},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"code":"acessibilityLabel","type":"codeVoice"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSImage"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSImage"}]}}}