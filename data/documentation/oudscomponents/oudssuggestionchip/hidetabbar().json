t"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"inlineContent":[{"text":"A view that hides the tab bar and propagates the hidden state to ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" overlay items.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Use this modifier instead of ","type":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"whenever a view inside a ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" embedded in an ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" needs to hide","type":"text"},{"text":" ","type":"text"},{"text":"the tab bar. Without this modifier, ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" cannot detect the visibility change","type":"text"},{"text":" ","type":"text"},{"text":"and its overlay elements remain visible on top of the content. This helper must be used for","type":"text"},{"text":" ","type":"text"},{"text":"apps with nested views and tab bars.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Otherwise for simple app ","type":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" is enough.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}]}],"references":{"ic_folder_categories.png":{"type":"image","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","alt":null},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/hideTabBar()":{"abstract":[{"type":"text","text":"Hides the native tab bar "},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" signals "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"title":"hideTabBar()","url":"\/documentation\/oudscomponents\/oudssuggestionchip\/hidetabbar()","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/hideTabBar()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip","kind":"symbol","fragments":[{"kind":"k