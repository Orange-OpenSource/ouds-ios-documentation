mple app ","type":"text"},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"text":" is enough.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hideTabBar","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"extendedModule":"SwiftUICore","modules":[{"name":"Components","relatedModules":["SwiftUICore"]}],"role":"symbol","symbolKind":"method","platforms":[{"name":"iOS","unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false}],"title":"hideTabBar()","externalID":"s:7SwiftUI4ViewP14OUDSComponentsE10hideTabBarQryF::SYNTHESIZED::s:14OUDSComponents18OUDSSuggestionChipV","roleHeading":"Instance Method"},"abstract":[{"text":"Hides the native tab bar ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" signals ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" to hide its overlay elements","type":"text"},{"text":" ","type":"text"},{"text":"(selected tab indicator and top divider) in sync.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudssuggestionchip\/hidetabbar()"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/hideTabBar()"},"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","url":"\/documentation\/oudscomponents","title":"Components"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/hideTabBar()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip\/hidetabbar()","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"title":"hideTabBar()","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/hideTabBar()"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"type":"image","identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSSuggestionChip"}],"kind":"symbol","type":"topic","abstract":[{"text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","url":"\/documentation\/oudscomponents\/oudssuggestionchip","title":"OUDSSuggestionChip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSSuggestionChip"}]}}}