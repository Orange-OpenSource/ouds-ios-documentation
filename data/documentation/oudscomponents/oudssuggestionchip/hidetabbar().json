OUDSTabBar"},{"type":"text","text":" overlay items."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" "},{"type":"text","text":"whenever a view inside a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" embedded in an "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise for simple app "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" is enough."}]},{"type":"codeListing","syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}]}],"kind":"symbol","abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"references":{"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","title":"Components","kind":"symbol","url":"\/documentation\/oudscomponents","role":"collection","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip":{"url":"\/documentation\/oudscomponents\/oudssuggestionchip","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSuggestionChip","kind":"identifier"}],"kind":"symbol","title":"OUDSSuggestionChip","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","type":"topic","role":"symbol","navigatorTitle":[{"text":"OUDSSuggestionChip","kind":"identifier"}],"abstract":[{"text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/hideTabBar()":{"title":"hideTabBar()","url":"\/documentation\/oudscomponents\/oudssuggestionchip\/hidetabbar()","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/hideTabBar()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}]}}}