bBar"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise for simple app "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" is enough."}]},{"type":"codeListing","syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudssuggestionchip\/hidetabbar()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","title":"hideTabBar()","modules":[{"name":"Components","relatedModules":["SwiftUICore"]}],"roleHeading":"Instance Method","symbolKind":"method","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"16.0"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"extendedModule":"SwiftUICore","externalID":"s:7SwiftUI4ViewP14OUDSComponentsE10hideTabBarQryF::SYNTHESIZED::s:14OUDSComponents18OUDSSuggestionChipV"},"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"url":"\/documentation\/oudscomponents","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","title":"Components","abstract":[{"type":"text","text":"The c