omponents\/OUDSSuggestionChip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSSuggestionChip"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudssuggestionchip","abstract":[{"text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"kind":"symbol","role":"symbol","title":"OUDSSuggestionChip"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/accentColor(_:)":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudssuggestionchip\/accentcolor(_:)","abstract":[{"text":"Applies an ","type":"text"},{"inlineContent":[{"type":"text","text":"accent color"}],"type":"strong"},{"text":" on the current view by using the given tokens of colors.","type":"text"},{"text":" ","type":"text"},{"text":"Uses the current color scheme so as to load the suitable color to apply in the end","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/accentColor(_:)","title":"accentColor(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accentColor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MultipleColorSemanticToken