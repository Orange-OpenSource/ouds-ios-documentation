ow multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"navigatorTitle":[{"text":"OUDSSuggestionChip","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip","type":"topic","kind":"symbol","title":"OUDSSuggestionChip","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSuggestionChip","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSListItemContentStyle/item(divider:background:)":{"url":"\/documentation\/oudscomponents\/oudslistitemcontentstyle\/item(divider:background:)","role":"symbol","title":"OUDSListItemContentStyle.item(divider:background:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemContentStyle\/item(divider:background:)","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"item","kind":"identifier"},{"text":"(","kind":"text"},{"text":"divider","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"background"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"The item style of the "},{"type":"codeVoice","code":"OUDSNavigationListItem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OUDSStaticListItem"},{"type":"text","text":". It controls how"},{"type":"text","text":" "},{"type":"text","text":"the background and divider behave for regular list items, including whether these visual effects are always visible or"},{"type":"text","text":" "},{"type":"text","text":"only appear during interaction. (e.g. press, hover)."}]}}}