entation\/OUDSComponents\/OUDSSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSSuggestionChip"}],"type":"topic","title":"OUDSSuggestionChip","role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSImage":{"abstract":[{"type":"text","text":"Use to provide an asset to ouds in order to be added in some components."},{"type":"text","text":" "},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"type":"codeVoice","code":"acessibilityLabel"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}],"url":"\/documentation\/oudscomponents\/oudsimage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSImage"}],"title":"OUDSImage","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSImage"}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSCo