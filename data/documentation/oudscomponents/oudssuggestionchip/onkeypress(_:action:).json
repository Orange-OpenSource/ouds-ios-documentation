 a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"kind":"symbol","title":"OUDSSuggestionChip","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSuggestionChip","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/onKeyPress(_:action:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onKeyPress"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"action"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier","text":"KeyPress"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7SwiftUI8KeyPressV6ResultO","kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"type":"topic","title":"onKeyPress(_:action:)","identifier":"doc:\/