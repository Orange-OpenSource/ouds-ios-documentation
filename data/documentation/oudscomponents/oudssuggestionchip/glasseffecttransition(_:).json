/OUDSComponents\/OUDSSuggestionChip","type":"topic","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"navigatorTitle":[{"kind":"identifier","text":"OUDSSuggestionChip"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/glassEffectTransition(_:)":{"abstract":[],"role":"symbol","url":"\/documentation\/oudscomponents\/oudssuggestionchip\/glasseffecttransition(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"glassEffectTransition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"GlassEffectTransition","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI21GlassEffectTransitionV"},{"text":") -> ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/glassEffectTransition(_:)","title":"glassEffectTransition(_:)","kind":"symbol","type":"topic"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png"}}}