:"symbol","url":"\/documentation\/oudscomponents\/oudssuggestionchip","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","type":"topic","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"navigatorTitle":[{"kind":"identifier","text":"OUDSSuggestionChip"}]},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"identifier":"ic_folder_categories.png","type":"image","alt":null},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/foregroundStyle(_:)":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip\/foregroundStyle(_:)","url":"\/documentation\/oudscomponents\/oudssuggestionchip\/foregroundstyle(_:)","title":"foregroundStyle(_:)","abstract":[{"text":"Applies a ","type":"text"},{"inlineContent":[{"text":"foreground style","type":"text"}],"type":"strong"},{"text":" on the current view by using the given tokens of colors.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Uses the current color scheme so as to load the suitable color to apply in the end"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":