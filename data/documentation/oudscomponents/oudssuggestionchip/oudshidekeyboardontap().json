 affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea","title":"OUDSTextArea","url":"\/documentation\/oudscomponents\/oudstextarea","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextArea","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput":{"kind":"symbol","role":"symbol","url":"\/documentation\/oudscomponents\/oudstextinput","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextInput","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTextInput","kind":"identifier"}],"abstract":[{"type":"text","text":"Text input is a UI element that allows to enter, edit, or select single-line textual data."},{"type":"text","text":" "},{"type":"text","text":"Text input is one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries."},{"type":"text","text":" "},{"type":"text","text":"It provides a visual and interactive affordance for text entry while supporting labels, placeholders, icons, descriptions, and validation feedback."}],"title":"OUDSTextInput","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput"},"ic_folder_categories.png":{"alt":null,"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}]}}}