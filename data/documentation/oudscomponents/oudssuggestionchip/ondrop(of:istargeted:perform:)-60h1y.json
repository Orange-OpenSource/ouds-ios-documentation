"}],"languages":["swift"]}]}],"kind":"symbol","references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip":{"abstract":[{"text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"navigatorTitle":[{"text":"OUDSSuggestionChip","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip","type":"topic","kind":"symbol","title":"OUDSSuggestionChip","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSSuggestionChip","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSuggestionChip","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/onDrop(of:isTargeted:perform:)-60h1y":{"title":"onDrop(of:isTargeted:perform:)","abstract":[],"url":"\/documentation\/oudscomponents\/oudssuggestionchip\/ondrop(of:istargeted:perform:)-60h1y","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onDrop","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": ["},{"text":"UTType","kind":"typeIdentifier","preciseIdentifier":"s:22UniformTypeIdentifiers6UTTypeV"},{"kind":"text","text":"], "},{"text":"isTargete