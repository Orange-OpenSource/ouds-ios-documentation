s":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSSuggestionChip","kind":"identifier"}],"abstract":[{"text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,","type":"text"},{"text":" ","type":"text"},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"url":"\/documentation\/oudscomponents\/oudssuggestionchip","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSSuggestionChip/onScrollPhaseChange(_:)-5hiz9":{"url":"\/documentation\/oudscomponents\/oudssuggestionchip\/onscrollphasechange(_:)-5hiz9","title":"onScrollPhaseChange(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onScrollPhaseChange"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"ScrollPhase","preciseIdentifier":"s:7SwiftUI11ScrollPhaseO"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"ScrollPhase","preciseIdentifier":"s:7SwiftUI11ScrollPhaseO"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"ScrollPhaseChangeContext","preciseIdentifier":"s:7SwiftUI24ScrollPhaseChangeContextV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7Sw