nd is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"kind":"symbol","navigatorTitle":[{"text":"OUDSSuggestionChip","kind":"identifier"}],"title":"OUDSSuggestionChip"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSImage":{"kind":"symbol","title":"OUDSImage","navigatorTitle":[{"kind":"identifier","text":"OUDSImage"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSImage","role":"symbol","url":"\/documentation\/oudscomponents\/oudsimage","type":"topic","abstract":[{"type":"text","text":"Use to provide an asset to ouds in order to be added in some components."},{"type":"text","text":" "},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"type":"codeVoice","code":"acessibilityLabel"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSImage"}]},"doc://OUDSComponents/documentation/OUDSComponents":{"abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents