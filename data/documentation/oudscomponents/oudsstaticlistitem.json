omSlot (displayed under main content, before helper text)","    OUDSStaticListItem(","        data: OUDSListItemData(","            label: \"Label\",","            bottomSlot: .init { Text(\"Bottom content\") },","            helperText: \"Helper text\"","        )","    )"],"syntax":"swift"},{"level":2,"type":"heading","text":"Leading elements","anchor":"Leading-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The leading position (before the texts) accepts one optional element via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemLeading"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(OUDSListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(OUDSListItemImage)"},{"type":"text","text":": A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".flag(OUDSListItemFlag)"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(OUDSListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Trailing elements","anchor":"Trailing-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trailing position (after the texts) accepts one optional element via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemTrailing"},{"type":"text","text":", like:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":