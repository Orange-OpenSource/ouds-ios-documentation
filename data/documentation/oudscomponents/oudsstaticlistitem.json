 this component when the list item should only display information without triggering any navigation or action."},{"type":"text","text":" "},{"type":"text","text":"For navigable list items, see "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"text":"Code samples","level":2,"type":"heading","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Simple list item with a label only","    OUDSStaticListItem(data: OUDSListItemData(label: \"Label\"))","","    \/\/ List item with more textual content","    let data = OUDSListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\"","    )","    OUDSStaticListItem(data: data)","","    \/\/ List item with leading icon and trailing badge","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Label\"),","        leading: .icon(.init(type: .info, size: .medium)),","        trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))","    )","","    \/\/ List item with avatar as leading and text as trailing","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Label\", description: \"Description\"),","        leading: .avatar(.init(type: .icon, size: .medium)),","        trailing: .text(.label(\"Info\"))","    )","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"SMS credit\"),","        trailing: .custom {","            OUDSCircularProgressIndicator(progress: 0.75)","        }","    )","","    \/\/ List item with slot (displayed under texts, before helper text)","    OUDSStaticListItem(","        data: OUDSListItemData(","            label: \"Label\",","            textSlot: { Text(\"Additional content\") },","            helperText: \"Helper text\"","        )","    )","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    OUDSStaticListItem(","        data: OUDSListItemData(","            label: \"Label\",","            bottomSlot: { Text(\"Bottom content\") },","            helperText: \"Helper text\"","        )","    )"]},{"text":"Leading elements","level":2,"type":"heading","anchor":"Leading-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The leading position (before the texts) accepts one optional element via "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemLeading","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(OUDSListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(OUDSListItemImage)"},{"type":"text","text":": A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".flag(OUDSListItemFlag)"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(OUDSListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Trailing elements","level":2,"type":"heading","anchor":"Trailing-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trailing position (after the texts) accepts one optional element via "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemTrailing","isActive":true,"type":"reference"},{"type":"text","text":", like:"}]}