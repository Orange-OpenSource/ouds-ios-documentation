,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" must be displayed in large mode or not, "},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"type":"text","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}]}]}],"name":"subtitle"},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" and the "},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}]}]},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"type":"text","text":" by default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. Only one item is supported."},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is never displayed."}]}],"name":"principalItem"},{"name":"trailingItems","content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The view which contains this ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":" must be placed inside a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"t