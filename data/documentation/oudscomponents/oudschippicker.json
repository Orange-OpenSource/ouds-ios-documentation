election case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"],"syntax":"swift"},{"text":"Design documentation","type":"heading","level":2,"anchor":"Design-documentation"},{"inlineContent":[{"text":"There is no online specification as this component is not an official OUDS one.","type":"text"}],"type":"paragraph"},{"text":"Theme rendering","type":"heading","level":2,"anchor":"Theme-rendering"},{"text":"Orange","type":"heading","level":3,"anchor":"Orange"},{"inlineContent":[{"identifier":"component_chipPicker_Orange","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","type":"heading","level":3,"anchor":"Orange-Compact"},{"inlineContent":[{"identifier":"component_chipPicker_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Sosh","text":"Sosh","type":"heading"},{"inlineContent":[{"identifier":"component_chipPicker_Sosh","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Wireframe","text":"Wireframe","type":"heading"},{"inlineContent":[{"identifier":"component_chipPicker_Wireframe","type":"image"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"0.17.0","type":"text"}],"type":"paragraph"}],"name":"Since","type":"aside"}],"kind":"content"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSChipPicker/init(title:tableName:bundle:s