"text"},{"text":" ","type":"text"},{"text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSChipPickerData"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"}],"type":"paragraph"},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Define the elements to display in filter chip using OUDSChipPickerData.","    enum Drink: String, CaseIterable {","        case virginHolyLava, ipaBeer, mineralWater","    }","","    var someDataToPopulate: [OUDSChipPickerData<Drink>] {","        [","            OUDSChipPickerData(tag: Drink.virginHolyLava,","                               layout: .textAndImage(\"Virgin Holy Lava\", image: OUDSImage(asset: Image(systemName: \"flame\")))),","","            OUDSChipPickerData(tag: Drink.ipaBeer,","                               layout: .textAndImage(\"IPA Beer\", image: OUDSImage(asset: Image(systemName: \"dog.fill\")))),","","            OUDSChipPickerData(tag: Drink.mineralWater,","                               layout: .textAndImage(\"Mineral water\", image: OUDSImage(asset: Image(systemName: \"waterbottle.fill\")))),","        ]","    }","","    \/\/\/ Single selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"]},{"text":"Design documentation","type":"heading","level":2,"anchor":"Design-documentation"},{"inlineContent":[{"text":"There is no online specification as this component is not an official OUDS one.","type":"text"}],"type":"paragraph"},{"text":"Theme rendering","type":"heading","level":2,"anchor":"Theme-rendering"},{"text":"Orange","type":"heading","level":3,"anchor":"Orange"},{"inlineContent":[{"type":"image","identifier":"component_chipPicker_Orange"}],"type":"paragraph"},{"text":"Orange Compact","type":"heading","level":3,"anchor":"Orange-Compact"},{"inlineContent":[{"type":"image","identifier":"component_chipPicker_OrangeCompact"}],"type":"paragraph"},{"text":"Sosh","type":"heading","level":3,"anchor":"Sosh"},{"inlineContent":[{"type":"image","identifier":"component_chipPicker_Sosh"}],"type":"paragraph"},{"text":"Wireframe","type":"heading","level":3,"anchor":"Wireframe"},{"inlineContent":[{"type":"image","identifier":"component_chipPicker_Wireframe"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"0.17.0","type":"text"}]}],"type":"aside","name":"Since"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"metadata":{"roleHeading":"Structure","modules":[{"name":"Components"}],"externalID":"s:14OUDSComponents14OUDSChipPickerV","role":"symbol","navigatorTitle":[{"text":"OUDSChipPicker","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSChipPicker","kind":"identifier"}],"title":"OUDSChipPicker","symbolKind":"struct","platforms":[{"deprecated":false,"introducedAt":"15.0","unavailable":false,"name":"iOS","beta":false},{"deprecated":false,"introduce