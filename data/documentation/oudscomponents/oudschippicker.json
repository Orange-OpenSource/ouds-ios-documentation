ine which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSChipPickerData","type":"reference"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"}],"type":"paragraph"},{"anchor":"Code-samples","level":2,"type":"heading","text":"Code samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Define the elements to display in filter chip using OUDSChipPickerData.","    enum Drink: String, CaseIterable {","        case virginHolyLava, ipaBeer, mineralWater","    }","","    var someDataToPopulate: [OUDSChipPickerData<Drink>] {","        [","            OUDSChipPickerData(tag: Drink.virginHolyLava,","                               layout: .textAndImage(\"Virgin Holy Lava\", image: OUDSImage(asset: Image(systemName: \"flame\")))),","","            OUDSChipPickerData(tag: Drink.ipaBeer,","                               layout: .textAndImage(\"IPA Beer\", image: OUDSImage(asset: Image(systemName: \"dog.fill\")))),","","            OUDSChipPickerData(tag: Drink.mineralWater,","                               layout: .textAndImage(\"Mineral water\", image: OUDSImage(asset: Image(systemName: \"waterbottle.fill\")))),","        ]","    }","","    \/\/\/ Single selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    OUDSChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"]},{"anchor":"Design-documentation","level":2,"type":"heading","text":"Design documentation"},{"inlineContent":[{"text":"There is no online specification as this component is not an official OUDS one.","type":"text"}],"type":"paragraph"},{"anchor":"Theme-rendering","level":2,"type":"heading","text":"Theme rendering"},{"anchor":"Orange","level":3,"type":"heading","text":"Orange"},{"inlineContent":[{"identifier":"component_chipPicker_Orange","type":"image"}],"type":"paragraph"},{"anchor":"Orange-Compact","level":3,"type":"heading","text":"Orange Compact"},{"inlineContent":[{"identifier":"component_chipPicker_OrangeCompact","type":"image"}],"type":"paragraph"},{"anchor":"Sosh","level":3,"type":"heading","text":"Sosh"},{"inlineContent":[{"identifier":"component_chipPicker_Sosh","type":"image"}],"type":"paragraph"},{"anchor":"Wireframe","level":3,"type":"heading","text":"Wireframe"},{"inlineContent":[{"identifier":"component_chipPicker_Wireframe","type":"image"}],"type":"paragraph"},{"name":"Since","style":"note","content":[{"inlineContent":[{"text":"0.17.0","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"title":"OUDSChipPicker","modules":[{"name":"Components"}],"symbolKind":"struct","roleHeading":"Structure","platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"15.0","unavailable":false},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"13.0","unavailable":false},{"name":"visionOS","beta":false,"deprecated":false,"introducedAt":"1.0","unavailable":false}],"role":"symbol","externalID":"s:14OUDSComponents14OUDSChipPickerV","navigatorTitle":[{"text":"OUDSChipPicker","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSChipPicker","kind":"identifier"}]},"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSChipPicker/init(title:tableName:bundle:s