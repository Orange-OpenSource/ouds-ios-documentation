{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}]}],"name":"leadingItems"},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"type":"text","text":" is never displayed."}],"type":"paragraph"}],"name":"principalItem"},{"content":[{"type":"paragraph","