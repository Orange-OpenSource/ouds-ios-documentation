text":" by default. If large mode, the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" is not displayed for iOS < 26.","type":"text"}]}]},{"name":"subtitle","content":[{"inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}]}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" and the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"type":"text","text":" by default, used if no large title nor principal item."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}],"type":"paragraph"}],"name":"leadingItems"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", and the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" is never displayed."}]}],"name":"principalItem"},{"content":[{"inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"text":" by default.","type":"text"}],"type":"paragraph"}],"name":"trailingItems"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The view which contains this ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"code":".principal","type":"codeVoice"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"code":".navigationSubtitle()","type":"codeVoice"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstabview\/toolbartop(_:haslargetitle:subtitle:accessibilitylabel:leadingitems:principalitem:trailingitems:)"]}],"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toolBarTop"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hasLargeTitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subtitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"accessibilityLabel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","te