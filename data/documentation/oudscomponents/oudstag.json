{"metadata":{"navigatorTitle":[{"text":"OUDSTag","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","title":"OUDSTag","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTag","kind":"identifier"}],"externalID":"s:14OUDSComponents7OUDSTagV","modules":[{"name":"Components"}],"platforms":[{"unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false,"name":"iOS"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"macOS"},{"unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"11.0","deprecated":false,"beta":false,"name":"watchOS"}],"role":"symbol"},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTag","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators"]},{"content":[{"level":2,"anchor":"Appearances","text":"Appearances","type":"heading"},{"inlineContent":[{"text":"Tags have two appearances so as to highlight or not their content:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"emphasized","type":"text"}],"type":"strong"},{"text":": A tag with a solid, high-contrast background. Used to draw strong attention to important","type":"text"},{"text":" ","type":"text"},{"text":"labels or categories. Emphasized tags stand out prominently against the interface and are ideal for","type":"text"},{"text":" ","type":"text"},{"text":"primary or high-priority information.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"muted","type":"text"}],"type":"strong"},{"text":": A tag with a subtle, light, or semi-transparent background. Used for secondary or","type":"text"},{"text":" ","type":"text"},{"text":"less prominent information. Muted tags blend more with the background, providing a softer visual","type":"text"},{"text":" ","type":"text"},{"text":"emphasis compared to emphasized tags.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Status","text":"Status","type":"heading"},{"inlineContent":[{"text":"Tags have seven status depending on the context of the information they represent. Each state is designed","type":"text"},{"text":" ","type":"text"},{"text":"to convey a specific meaning and ensure clarity in communication.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Neutral","type":"text"}],"type":"strong"},{"text":": Default or inactive state. Used for standard labels, categories, or when no specific","type":"text"},{"text":" ","type":"text"},{"text":"status needs to be communicated.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Accent","type":"text"}],"type":"strong"},{"text":": Used to draw attention to new features, recommendations, or content suggestions.","type":"text"},{"text":" ","type":"text"},{"text":"Invites users to explore and engage with new offerings, creating an exciting and engaging experience.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"text":": Indicates success, confirmation, or a positive status. Commonly used to highlight","type":"text"},{"text":" ","type":"text"},{"text":"completed actions or approved items.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"text":": Signals caution or a potentially risky situation. Used to draw attention to items","type":"text"},{"text":" ","type":"text"},{"text":"requiring user awareness or intervention.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"text":": Represents errors, critical issues, or urgent attention needed. Used to highlight","type":"text"},{"text":" ","type":"text"},{"text":"problems or failed actions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Info","type":"text"}],"type":"strong"},{"text":": Conveys informational messages or supplementary details. Used for neutral, helpful,","type":"text"},{"text":" ","type":"text"},{"text":"or contextual information.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Disabled","type":"text"}],"type":"strong"},{"text":": Shows that the tag is inactive and cannot be interacted with. Appears faded or greyed out. This is not","type":"text"},{"text":" ","type":"text"},{"text":"allowed when loader is activated.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Shape","text":"Shape","type":"heading"},{"inlineContent":[{"text":"Tags can have two shapes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Rounded","type":"text"}],"type":"strong"},{"text":": A tag with fully rounded corners, creating a pill-shaped appearance. Rounded","type":"text"},{"text":" ","type":"text"},{"text":"tags offer a softer and more approachable look, suitable for most modern interfaces.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Square","type":"text"}],"type":"strong"},{"text":": A tag with sharp, square corners. Squared tags provide a more formal, structured, or","type":"text"},{"text":" ","type":"text"},{"text":"technical feel. They are often used in business contexts to label promotions, offers, or important notices.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Size","text":"Size","type":"heading"},{"inlineContent":[{"text":"Tags can have two sizes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Default","type":"text"}],"type":"strong"},{"text":": The standard tag size, suitable for most use cases and offering good readability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Small","type":"text"}],"type":"strong"},{"text":": A compact tag with reduced height and font size. Used when saving space is important or","type":"text"},{"text":" ","type":"text"},{"text":"when grouping elements visually.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Layout","text":"Layout","type":"heading"},{"inlineContent":[{"text":"There are four available layouts for tags:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"-","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Text only"}]},{"text":": A tag that displays only text. Used for simple labels, categories, or keywords without additional visual","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"-","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Text + Bullet"}]},{"text":": A tag with a small indicator (dot) alongside the text. Used to show status, presence, or activity","type":"text"},{"text":" ","type":"text"},{"text":"next to the label.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"-","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Text + Icon"}]},{"text":": A tag that includes an icon before the text. Used to visually reinforce the meaning of the tag,","type":"text"},{"text":" ","type":"text"},{"text":"such as status, type, or action.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Text + Loader","type":"text"}],"type":"strong"},{"text":": A tag that combines a loading spinner (or progress indicator) with text. Used to indicate that","type":"text"},{"text":" ","type":"text"},{"text":"a process or action related to the tag is in progress.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Code-samples","text":"Code samples","type":"heading"},{"code":["    \/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","    OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","    \/\/ Or also","    OUDSTag(label: \"Label\")","    \/\/ Or from a localizale and a bundle","    OUDSTag(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","    \/\/ Tag with neutral status with bullet","    OUDSTag(label: \"Label\", status: .neutral(leading: .bullet)","","    \/\/ Tag with neutral status with a custom decorative icon","    OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"))))","    \/\/ If your layout is in RTL mode but your tag has an icon with another meaning because of bad orientation,","    \/\/ you can flip the icon using OUDSImage.flipped","    OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","    \/\/ If you want to display a raw image (not tinted), use renderingMode: .original","    OUDSTag(label: \"Label\", status: .neutral(image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","    \/\/ Text with neutral status with bullet","    OUDSTag(label: \"Label\", status: .neutral(bullet: true))","","    \/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","    OUDSTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","    \/\/ Tag with determinate circular progress indicator, with rounded shape in default size","    OUDSTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Design-documentation","text":"Design documentation","type":"heading"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-tag","isActive":true,"type":"reference"}],"type":"paragraph"},{"level":2,"anchor":"Themes-rendering","text":"Themes rendering","type":"heading"},{"level":3,"anchor":"Orange","text":"Orange","type":"heading"},{"inlineContent":[{"identifier":"component_tag_Orange","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Orange-Compact","text":"Orange Compact","type":"heading"},{"inlineContent":[{"identifier":"component_tag_OrangeCompact","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Sosh","text":"Sosh","type":"heading"},{"inlineContent":[{"identifier":"component_tag_Sosh","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Wireframe","text":"Wireframe","type":"heading"},{"inlineContent":[{"identifier":"component_tag_Wireframe","type":"image"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.5.0 (Figma component design version)"}]}],"name":"Version","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"0.18.0"}]}],"name":"Since","type":"aside"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"Tag is a UI element that allows to display short info like a label, keyword, or category.","type":"text"},{"text":" ","type":"text"},{"text":"Tag helps users quickly find, group, or understand content.","type":"text"}],"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDS