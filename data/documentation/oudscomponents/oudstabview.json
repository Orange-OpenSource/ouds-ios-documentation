e"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Appearances","text":"Appearances","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass. The same rules as "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true,"type":"reference"},{"type":"text","text":" apply:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Background and unselected item colors are applied for iOS lower than 26."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On iOS 26+ with Liquid Glass enabled, only the selected accent color is applied."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The top divider and selected-tab indicator are shown for iOS 18 (portrait iPhone only for"},{"type":"text","text":" "},{"type":"text","text":"the indicator) and hidden under Liquid Glass."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Platform-considerations","text":"Platform considerations","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Tailored for iOS and iPadOS. Requires iOS 18+."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On macOS 15+ and visionOS 2+: a bare "},{"code":"TabView(selection:)","type":"codeVoice"},{"type":"text","text":" is rendered without UIKit styling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Not available on watchOS or tvOS."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Guidelines","text":"Guidelines","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"OUDS guidelines recommend using tab bar item images at "},{"type":"strong","inlineContent":[{"type":"text","text":"26 × 26 pt"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"code":["\/\/ iOS 18 and 26 without Liqu