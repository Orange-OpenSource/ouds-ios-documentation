":"text","text":" "},{"type":"text","text":"For apps targeting iOS 15–17, use "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference"},{"type":"text","text":" instead."},{"type":"text","text":" "},{"type":"text","text":"When you need "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":" on iOS 26+, "},{"type":"strong","inlineContent":[{"text":"with Liquid Glass enabled","type":"text"}]},{"text":", use ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true,"type":"reference"},{"text":" instead.","type":"text"}]},{"anchor":"Selection-binding","text":"Selection binding","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" is always required and always kept in sync, regardless of the OS version."},{"type":"text","text":" "},{"type":"text","text":"For iOS 18 or iOS 26 without Liquid Glass, also pass "},{"type":"codeVoice","code":"count:"},{"type":"text","text":" (the number of tabs) so the selected-tab indicator can be positioned."},{"type":"text","text":" "},{"type":"text","text":"Each "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" must carry an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" matching the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding."},{"type":"text","text":" "},{"type":"text","text":"For iOS 26+ with Liquid Glass, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Appearances","anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass. The same rules as "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documenta