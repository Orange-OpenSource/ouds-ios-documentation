ce","code":"Tab(\"Label\", image:) { }"},{"type":"text","text":" items with a selection binding or rules like "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For apps targeting iOS 15–17, use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true},{"type":"text","text":" instead."},{"type":"text","text":" "},{"type":"text","text":"When you need "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":" on iOS 26+, "},{"type":"strong","inlineContent":[{"type":"text","text":"with Liquid Glass enabled"}]},{"type":"text","text":", use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"},{"text":"Selection binding","level":2,"anchor":"Selection-binding","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" is always required and always kept in sync, regardless of the OS version."},{"type":"text","text":" "},{"type":"text","text":"For iOS 18 or iOS 26 without Liquid Glass, also pass "},{"type":"codeVoice","code":"count:"},{"type":"text","text":" (the number of tabs) so the selected-tab indicator can be positioned."},{"type":"text","text":" "},{"type":"text","text":"Each "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" must carry an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" matching the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding."},{"type":"text","text":" "},{"type":"text","text":"For iOS 26+ with Liquid Glass, use "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Appearances","level":2,