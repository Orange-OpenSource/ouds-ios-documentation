t","text":" by default. If large mode, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"type":"text","text":"Never displayed if "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]}]}],"name":"subtitle"},{"content":[{"inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}],"type":"paragraph"}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}]}],"name":"leadingItems"},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If set, the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"e