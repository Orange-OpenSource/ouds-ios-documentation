text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}]}],"metadata":{"symbolKind":"method","extendedModule":"SwiftUICore","platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"15.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"15.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"15.0","beta":false},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false}],"roleHeading":"Instance Method","externalID":"s:7SwiftUI4ViewP14OUDSComponentsE10toolBarTop_13hasLargeTitle8subtitle18accessibilityLabel12leadingItems13principalItem08trailingO0QrSS_SbSSSgALSayAD08OUDSToolfQ0VGycANSgAOyctF::SYNTHESIZED::s:14OUDSComponents16OUDSCheckboxItemV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toolBarTop"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kin