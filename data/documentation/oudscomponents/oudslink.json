{"sections":[],"abstract":[{"type":"text","text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,"},{"type":"text","text":" "},{"type":"text","text":"or to an external resource."},{"type":"text","text":" "},{"type":"text","text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","roleHeading":"Structure","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"introducedAt":"15.0","beta":false},{"deprecated":false,"name":"macOS","unavailable":false,"introducedAt":"13.0","beta":false},{"deprecated":false,"name":"tvOS","unavailable":false,"introducedAt":"16.0","beta":false},{"deprecated":false,"name":"visionOS","unavailable":false,"introducedAt":"1.0","beta":false},{"deprecated":false,"name":"watchOS","unavailable":false,"introducedAt":"11.0","beta":false}],"modules":[{"name":"Components"}],"externalID":"s:14OUDSComponents8OUDSLinkV","title":"OUDSLink","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSLink","kind":"identifier"}]},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(_:tableName:bundle:image:size:density:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(_:tableName:bundle:indicator:size:density:isFullWidth:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(text:image:size:density:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(text:indicator:size:density:isFullWidth:action:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/body"]},{"generated":true,"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Density","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Indicator","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Size"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/View-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","isActive":true,"type":"reference"},{"text":" proposes layout with text only or text with icon.","type":"text"},{"text":" ","type":"text"},{"text":"It also proposes layout to navigate forward or backward. The link can be displayed in ","type":"text"},{"code":"small","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" size.","type":"text"}],"type":"paragraph"},{"text":"Text only or Text and icon layout","anchor":"Text-only-or-Text-and-icon-layout","type":"heading","level":2},{"inlineContent":[{"text":"This layout is used to open a link or to display a specific feature (like send feedbacks, show more, …)","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ Text only in small size, in compact density","    OUDSLink(text: \"Feedback\", size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ From a localizable and a bundle","    OUDSLink(LocalizedStringKey(\"feedback_link\"), bundle: Bundle.module, size: .small) { }","","    \/\/ Text and icon in default size","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) { }","","    \/\/ Text and icon with raw image (not tinted)","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"],"type":"codeListing"},{"text":"Navigation layout","anchor":"Navigation-layout","type":"heading","level":2},{"inlineContent":[{"text":"This layout is used to navigate backward, forward and outside the app","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ Navigate to next page with link in a small size","    OUDSLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ The link takes full width but chevron stays just after the last character","    OUDSLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ The link takes full width but indicator stays just after the last character","    OUDSLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }",""],"type":"codeListing"},{"inlineContent":[{"text":"If the text must be to an edge, and the indicator on the other edge, the ","type":"text"},{"code":"OUDSNavigationListItem","type":"codeVoice"},{"text":" should be used instead.","type":"text"}],"type":"p