xt: \"Feedback\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"]},{"type":"heading","text":"Navigation layout","anchor":"Navigation-layout","level":2},{"inlineContent":[{"text":"This layout is used to navigate backward, forward and outside the app","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Navigate to next page with link in a small size","    OUDSLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ The link takes full width but chevron stays just after the last character","    OUDSLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ The link takes full width but indicator stays just after the last character","    OUDSLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }",""]},{"inlineContent":[{"text":"If the text must be to an edge, and the indicator on the other edge, the ","type":"text"},{"code":"OUDSNavigationListItem","type":"codeVoice"},{"type":"text","text":" should be used instead."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Colored Surface","anchor":"Colored-Surface"},{"inlineContent":[{"text":"If link is placed on colored surface using ","type":"text"},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":", the default colors (content text and icon or arrow) are automatically adjusted to switch to monochrom."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Design documentation","anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-link","type":"reference","isActive":true}]},{"type":"heading","level":2,"text":"Theme