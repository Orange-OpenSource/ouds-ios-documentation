{"kind":"symbol","sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink","interfaceLanguage":"swift"},"abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(_:tableName:bundle:image:size:density:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(_:tableName:bundle:indicator:size:density:isFullWidth:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(text:image:size:density:action:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/init(text:indicator:size:density:isFullWidth:action:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/body"],"title":"Instance Properties"},{"generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Density","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Indicator","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/Size"],"title":"Enumerations"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink\/View-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLink","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLink"},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward or backward. The link can be displayed in "},{"code":"small","type":"codeVoice"},{"type":"text","text":" or "},{"code":"default","type":"codeVoice"},{"type":"text","text":" size."}]},{"text":"Text only or Text and icon layout","type":"heading","level":2,"anchor":"Text-only-or-Text-and-icon-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This layout is used to open a link or to display a specific feature (like send feedbacks, show more, …)"}]},{"type":"codeListing","code":["    \/\/ Text only in small size, in compact density","    OUDSLink(text: \"Feedback\", size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ From a localizable and a bundle","    OUDSLink(LocalizedStringKey(\"feedback_link\"), bundle: Bundle.module, size: .small) { }","","    \/\/ Text and icon in default size","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) { }","","    \/\/ Text and icon with raw image (not tinted)","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"],"syntax":"swift"},{"text":"Navigation layout","type":"heading","level":2,"anchor":"Navigation-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This layout is used to navigate backward, forward and outside the app"}]},{"type":"codeListing","code":["    \/\/ Navigate to next page with link in a small size","    OUDSLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ The link takes full width but chevron stays just after the last character","    OUDSLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ The link takes full width but indicator stays just after the last character","    OUDSLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the text must be to an edge, and the indicator on the other edge, the "},{"code":"OUDSNavigationListItem","type":"codeVoice"},{"type":"text","text":" should be used instead."}]},{"text":"Colored Surface","type":"heading","level":2,"anchor":"Colored-Surface"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If link is placed on colored surface using "},{"code":"OUDSColoredSurface","type":"codeVoice"},{"type":"text","text":", the default colors (content text and icon or arrow) are automatically adjusted to switch to monochrom."}]},{"text":"Design documentation","type":"heading","level":2,"anchor":"Design-documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"iden