 to navigate forward or backward. The link can be displayed in "},{"type":"codeVoice","code":"small"},{"type":"text","text":" or "},{"type":"codeVoice","code":"default"},{"type":"text","text":" size."}],"type":"paragraph"},{"anchor":"Text-only-or-Text-and-icon-layout","text":"Text only or Text and icon layout","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This layout is used to open a link or to display a specific feature (like send feedbacks, show more, …)"}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ Text only in small size, in compact density","    OUDSLink(text: \"Feedback\", size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ From a localizable and a bundle","    OUDSLink(LocalizedStringKey(\"feedback_link\"), bundle: Bundle.module, size: .small) { }","","    \/\/ Text and icon in default size","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_heart\")), size: .default) { }","","    \/\/ Text and icon with raw image (not tinted)","    OUDSLink(text: \"Feedback\", image: OUDSImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"],"type":"codeListing"},{"anchor":"Navigation-layout","text":"Navigation layout","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This layout is used to navigate backward, forward and outside the app"}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ Navigate to next page with link in a small size","    OUDSLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    OUDSLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ The link takes full width but chevron stays just after the last character","    OUDSLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ The link takes full width but indicator stays just after the last character","    OUDSLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }",""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the text must be to an edge, and the indicator on the other edge, the "},{"type":"codeVoice","code":"OUDSNavigationListItem"},{"type":"text","text":" should be used instead."}],"type":"paragraph"},{"anchor":"Colored-Surface","text":"Colored Surface","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If link is placed on colored surface using "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":", the default colors (content text and icon or arrow) are automatically adjusted to switch to monochrom."}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-link","isActive":true}],"type":"paragraph"},{"anchor":"Themes-rendering","text":"Themes rendering","level":2,"type":"heading"},{"anchor":"Orange","text":"Orange","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_link_Orange"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_link_OrangeCompact"}],"type":"paragraph"},{"anchor":"Sosh","text":"Sosh","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_link_Sosh"}],"type":"paragraph"},{"anchor":"Wireframe","text":"Wireframe","level":3,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_link_Wireframe"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"2.4.0 (Figma component design version)","type":"text"}]}],"style":"note","name":"Version","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"0.11.0","type":"