{"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbarviewmodifier"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"navigatorTitle":[{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"role":"symbol","modules":[{"name":"Components"}],"roleHeading":"Structure","title":"OUDSTabBarViewModifier","platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"beta":false,"unavailable":false}],"externalID":"s:14OUDSComponents22OUDSTabBarViewModifierV"},"kind":"symbol","topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/body(content:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/ViewModifier-Implementations"],"generated":true,"title":"Default Implementations"}],"abstract":[{"type":"text","text":"Defines the look and feel the tab bar must have by applying the OUDS tokens."},{"type":"text","text":" "},{"type":"text","text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider."},{"type":"text","text":" "},{"type":"text","text":"To use these elements in your tab view, use instead "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference","is