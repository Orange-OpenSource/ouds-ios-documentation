{"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"kind":"symbol","abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"type":"text","text":" "},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"type":"text","text":" "},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true},{"type":"text","text":"."}],"metadata":{"symbolKind":"struct","modules":[{"name":"Components"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"platforms":[{"introducedAt":"15.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"title":"OUDSTabBarViewModifier","role":"symbol","externalID":"s:14OUDSComponents22OUDSTabBarViewModifierV"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/body(content:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/ViewModifier-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBarViewModifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"Rendering","text":"Rendering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}]}]}]},{"inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on OUDS badge components.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Since","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbarviewmodifier"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSection