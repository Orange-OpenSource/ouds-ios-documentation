{"metadata":{"externalID":"s:14OUDSComponents22OUDSTabBarViewModifierV","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"beta":false},{"deprecated":false,"name":"iPadOS","introducedAt":"15.0","unavailable":false,"beta":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"15.0","unavailable":false,"beta":false}],"navigatorTitle":[{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"role":"symbol","title":"OUDSTabBarViewModifier","roleHeading":"Structure"},"kind":"symbol","abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"text":" ","type":"text"},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstabbarviewmodifier"]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\