en definition). These particular badges do not rely on OUDS badge components."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}],"type":"aside","name":"Since","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"kind":"relationships","type":"conformsTo"}],"references":{"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBarViewModifier/init()":{"title":"init()","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[],"role":"symbol","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()","url":"\/documentation\/oudscomponents\/oudstabbarviewmodifier\/init()"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBarViewModifier":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudstabbarviewmodifier","title":"OUDSTabBarViewModifier","kind":"symbol","abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"text":" ","type":"text"},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabB