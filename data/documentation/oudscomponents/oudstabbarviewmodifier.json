":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on OUDS badge components."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://OUDSComponents/7SwiftUI12ViewModifierP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP","title":"SwiftUICore.ViewModifier","type":"unresolvable"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","alt":null,"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBarViewModifier":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier","url":"\/documentation\/oudscomponents\/oudstabbarviewmodifier","kind":"symbol","abstract":[{"type":"text","text":"Defines the look and feel the tab bar must have by applying the OUDS tokens."},{"type":"text","text":" "},{"type":"text","text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider."},{"type":"text","text":" "},{"type":"text","text":"To use these elements in your tab view, use instead "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true,"type":"reference"},{"type":"text","text":"."}],"title":"OUDSTabBarViewModifier","type":"topic","navigatorTitle":[{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBarViewModifier","kind":"identifier"}],"role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/ou