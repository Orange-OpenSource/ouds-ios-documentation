content":[{"level":2,"anchor":"Rendering","type":"heading","text":"Rendering"},{"inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar does not change since iOS 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}]}]}]},{"inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on OUDS badge components.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Since"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbarviewmodifier"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"type":"text","text":" "},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"type":"text","text":" "},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true},{"text":".","type":"text"}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBarViewModifier":{"title":"OUDSTabBarViewModifier","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"text":" ","type":"text"},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},{"text":".","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/oudscomponents\/oudstabbarviewmodifier","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBarViewModifier/init()":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","role":"symbol","title":"init()","url":"\/documentation\/oudscomponents\/oudstabbarviewmodifier\/init()","abstract":[]},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder