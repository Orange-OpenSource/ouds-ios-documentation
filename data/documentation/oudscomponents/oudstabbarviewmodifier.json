dering"},{"inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed","type":"text"},{"text":" ","type":"text"},{"text":"and not the text making theme not readable in dark color scheme","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on OUDS badge components."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}],"type":"aside","style":"note","name":"Since"}]}],"kind":"symbol","sections":[],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/init()"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBarViewModifier\/body(