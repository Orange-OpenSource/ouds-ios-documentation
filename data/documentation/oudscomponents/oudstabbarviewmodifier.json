{"kind":"symbol","abstract":[{"text":"Defines the look and feel the tab bar must have by applying the OUDS tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"To use these elements in your tab view, use instead "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","isActive":true,"type":"reference"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Structure","modules":[{"name":"Components"}],"platforms":[{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"15.0","name":"iOS"}],"symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBarViewModifier"}],"externalID":"s:14OUDSComponents22OUDSTabBarViewModifierV","title":"OUDSTabBarViewModifier"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBarViewModifier","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Rendering","type":"heading","level":2,"anchor":"Rendering"},{"inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent