le","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"},"component_textArea_Wireframe":{"identifier":"component_textArea_Wireframe","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textArea_Wireframe.png"}],"alt":"A text area component in light and dark modes with Wireframe theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/Status":{"abstract":[{"type":"text","text":"Define all available status for the text area"}],"kind":"symbol","navigatorTitle":[{"text":"Status","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudstextarea\/status","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"title":"OUDSTextArea.Status","role":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/Status"},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/Helperlink":{"navigatorTitle":[{"kind":"identifier","text":"Helperlink"}],"type":"topic","role":"symbol","abstract":[{"text":"Used to describe the helper link below the text area.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/Helperlink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Helperlink"}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudstextarea\/helperlink","title":"OUDSTextArea.Helperlink"},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/HelperText":{"kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/HelperText","abstract":[{"type":"text","text":"Describes the content of the helper text displayed below the text area."}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"HelperText","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"HelperText"}],"title":"OUDSTextArea.HelperText","role":"symbol","url":"\/documentation\/oudscomponents\/oudstextarea\/helpertext"},"doc://OUDSComponents/documentation/OUDSComponents/Controls":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"title":"Controls","role":"article","type":"topic","url":"\/documentation\/oudscomponents\/controls","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"controls"}]},{"type":"text","text":" and "},{"inlineContent":[{"text":"inputs","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"},"component_textArea_Orange":{"type":"image","alt":"A text area component in light and dark modes with Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textArea_Orange.png"}],"identifier":"component_textArea_Orange"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png"},"component_textArea_OrangeCompact":{"alt":"A text area component in light and dark modes with Orange Compact theme","identifier":"component_textArea_OrangeCompact","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_textArea_OrangeCompact.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea":{"navigatorTitle":[{"text":"OUDSTextArea","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/OUDSCompone