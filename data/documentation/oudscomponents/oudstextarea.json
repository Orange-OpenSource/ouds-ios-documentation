fier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents12OUDSTextAreaV","text":"OUDSTextArea"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents12OUDSTextAreaV6StatusO","text":"Status"},{"kind":"text","text":")"}],"title":"init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)"},"doc://OUDSComponents/documentation/OUDSComponents/Controls":{"type":"topic","role":"article","title":"Controls","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls","kind":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"controls"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":"."}],"url":"\/documentation\/oudscomponents\/controls"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/Status":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudstextarea\/status","abstract":[{"text":"Define all available status for the text area","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/Status","title":"OUDSTextArea.Status","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Status","kind":"identifier"}]},"component_textArea_OrangeCompact":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textArea_OrangeCompact.png"}],"identifier":"component_textArea_OrangeCompact","alt":"A text area component in light and dark modes with Orange Co