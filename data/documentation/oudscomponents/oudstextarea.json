{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/Helperlink"],"title":"Structures"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/init(_:tableName:bundle:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/body"],"title":"Instance Properties"},{"anchor":"Enumerations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/HelperText","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/Status"],"title":"Enumerations"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/View-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","platforms":[{"beta":false,"introducedAt":"15.0","name":"iOS","unavailable":false,"deprecated":false},{"beta":false,"introducedAt":"13.0","name":"macOS","unavailable":false,"deprecated":false},{"beta":false,"introducedAt":"1.0","name":"visionOS","unavailable":false,"deprecated":false}],"externalID":"s:14OUDSComponents12OUDSTextAreaV","navigatorTitle":[{"text":"OUDSTextArea","kind":"identifier"}],"modules":[{"name":"Components"}],"title":"OUDSTextArea","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextArea","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextArea","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"]},{"content":[{"anchor":"Layout","text":"Layout","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Text area is based on several configurable UI elements:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"type":"text","text":": It is used to describe the purpose of the text area."},{"type":"text","text":" "},{"type":"text","text":"In some UI contexts, especially when space is limited or when the text area is part of a compact layout, the label can be hidden."},{"type":"text","text":" "},{"type":"text","text":"However, hiding the label should only be done if the purpose remains clear thanks to a placeholder or contextual icon"},{"type":"text","text":" "},{"type":"text","text":"and if the label is still accessible to screen readers."},{"type":"text","text":" "},{"type":"text","text":"Hiding a label is a design choice that must balance visual simplicity and clarity of intent, without compromising inclusiveness or form guidance."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"placeholder"}],"type":"strong"},{"text":": If the text of the text area is empty a placeholder provides a hint or guidance inside the field to suggest expected input.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Status","level":2,"type":"heading","text":"Status"},{"inlineContent":[{"text":"Five status are proposed for all layouts:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"enabled (by default)","type":"text"}]},{"text":": Default neutral appearance, whether empty or filled.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to click, focus, and type freely without restrictions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"error","type":"text"}],"type":"strong"},{"text":": The ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" status indicates that the user input does not meet validation rules or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"expected formatting. It provides immediate visual feedback, typically through a red border,"},{"type":"text","text":" "},{"type":"text","text":"an error icon, and a clear, accessible error message positioned below the text area. The error message replaces the helper text."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"loading"}]},{"text":": The ","type":"text"},{"code":"loading","type":"codeVoice"},{"text":" state indicates that the system is processing or retrieving data","type":"text"},{"text":" ","type":"text"},{"text":"related to the text entered. A progress indicator appears to inform the user that an action is in progress.","type":"text"},{"text":" ","type":"text"},{"text":"The field remains editable while loading.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"readOnly"}],"type":"strong"},{"text":": The ","type":"text"},{"code":"readOnly","type":"codeVoice"},{"text":" status lets the text visible but not editable.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"disabled"}]},{"text":": In ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" status, the field is non-interactive and grayed out to indicate it cannot be changed.","type":"text"},{"text":" ","type":"text"},{"text":"Note the SwiftUI ","type":"text"},{"code":"View.disabled()","type":"codeVoice"},{"text":" is ignored.","type":"text"}]}]}]},{"anchor":"Helpers","text":"Helpers","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text (plain)"}]},{"type":"text","text":": A supporting text conveys additional information about the text area,"},{"type":"text","text":" "},{"type":"text","text":"such as how it will be used. It should ideally only take up a single line, though may wrap"},{"type":"text","text":" "},{"type":"text","text":"to multiple lines if required, and be either persistently visible or visible only on focus."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Helper text (characters max count)"}],"type":"strong"},{"text":": Uses an internal message displaying the count of remaining characters depending to the given value.","type":"text"},{"text":" ","type":"text"},{"text":"This is a specific iOS library feature with 1.4.0","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper link"}]},{"type":"text","text":": If the helper text is not sufficient, it’s possible to offer the user"},{"type":"text","text":" "},{"type":"text","text":"an additional help link (the link can be external or open a modal)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default no haptics are done by the component."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases where you will have to make the devices vibrate."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Mandatory-field-indication","level":2,"text":"Mandatory field indication"},{"type":"paragraph","inlineContent":[{"text":"If all fields are mandatory (several fields present): display the message “All fields are mandatory” at the top of your formular.","type":"text"},{"text":" ","type":"text"},{"text":"Do not use an asterisk at the end of each field label, nor the word “mandatory.”","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If not all fields are mandatory (several fields present): display the message “All fields marked with an * are mandatory” at the top of your formular.","type":"text"},{"text":" ","type":"text"},{"text":"Use an asterisk (*) at the end of each mandatory field label, and ensures this is well vocalized.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"UI rendering of the asterisk must be done with "},{"type":"emphasis","inlineContent":[{"text":"bold font weight","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"negative content color"}]},{"type":"text","text":" (red on light backgrounds)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the mention “(optional)” at the end of each optional field label. Note that this rule is not systematic, it remains an option, to be used if needed."}]},{"type":"paragraph","inlineContent":[{"text":"If there is only one field in the formular, or if the mandatory nature is obvious,","type":"text"},{"text":" ","type":"text"},{"text":"no mention is necessary since the fields are essential to the formular’s functionality.","type":"text"}]},{"level":2,"text":"Outlined style","anchor":"Outlined-style","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":", the text area uses a subtle background fill and a bottom border only, creating a softer and more contained look.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"strong","inlineContent":[{"text":"outlined","type":"text"}]},{"type":"text","text":", the text area uses a transparent background and a visible stroke on all four sides."},{"type":"text","text":" "},{"type":"text","text":"This style may be appropriate for contexts where inputs need to feel lightweight and unobtrusive,"},{"type":"text","text":" "},{"type":"text","text":"for example inside a card, a dialog, or a filtering panel."}]},{"syntax":"swift","type":"codeListing","code":["    \/\/ An outlined text area","    OUDSTextArea(label: \"Comments\", text: $text, isOutlined: true)"]},{"level":2,"text":"Fixed height","anchor":"Fixed-height","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":", the text area grows vertically as the user types, up to a maximum height defined by the","type":"text"},{"text":" ","type":"text"},{"text":"design system (token ","type":"text"},{"code":"sizeMaxHeightInput","type":"codeVoice"},{"text":"). Once that height is reached, the content becomes scrollable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"constrainedMaxHeight"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the maximum height is capped to the "},{"type":"strong","inlineContent":[{"text":"minimum","type":"text"}]},{"type":"text","text":" height"},{"type":"text","text":" "},{"type":"text","text":"(token "},{"type":"codeVoice","code":"sizeMinHeightInput"},{"type":"text","text":"), keeping the component at a fixed, compact size at all times."},{"type":"text","text":" "},{"type":"text","text":"The content is immediately scrollable from the first overflow line."}]},{"type":"paragraph","inlineContent":[{"text":"This is useful in dense layouts — forms, filter panels, chat composers — where vertical space is at a premium.","type":"text"}]},{"type":"codeListing","code":["    \/\/ Height is fixed to the minimum (no vertical growth)","    OUDSTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"],"syntax":"swift"},{"text":"Rich text","type":"heading","anchor":"Rich-text","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"text":"Code samples","type":"heading","anchor":"Code-samples","level":2},{"type":"codeListing","code":["    \/\/ The text to display and edit","    @State var text: String = \"\"","","    \/\/ Empty text and no placeholder","    OUDSTextArea(label: \"Comments\", text: $text)","","    \/\/ Empty text with placeholder","    OUDSTextArea(label: \"Comments\", text: $text, placeholder: \"Describe your issue in detail\")","","    \/\/ With a plain helper text","    OUDSTextArea(label: \"Comments\",","                 text: $text,","                 placeholder: \"Describe your issue in detail\",","                 helperText: .plain(\"Maximum 500 characters.\"))","","    \/\/ With a maximum character count — the component shows \"X characters remaining\" (bold)","    \/\/ and switches to an error style when exceeded.","    OUDSTextArea(label: \"Comments\",","                 text: $text,","                 helperText: .charactersMaxCount(500))","","    \/\/ With helper link","    @Environment(\\.openURL) private var openUrl","","    let helperLink = OUDSTextArea.Helperlink(text: \"Helper Link\") {","       openUrl.callAsFunction(url)","    }","","    OUDSTextArea(label: \"Comments\", text: $text, placeholder: \"Placeholder\", helperLink: helperLink)","","    \/\/ With error status","    OUDSTextArea(label: \"Comments\", text: $text, status: .error(message: \"This field can't be empty.\"))","","    \/\/ Outlined style","    OUDSTextArea(label: \"Comments\", text: $text, isOutlined: true)","","    \/\/ Fixed height — no vertical growth","    OUDSTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"],"syntax":"swift"},{"text":"Design documentation","type":"heading","anchor":"Design-documentation","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-text-area","isActive":true,"type":"reference"}]},{"text":"Themes rendering","type":"heading","anchor":"Themes-rendering","level":2},{"text":"Orange","type":"heading","level":3,"anchor":"Orange"},{"inlineContent":[{"identifier":"component_textArea_Orange","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","type":"heading","level":3,"anchor":"Orange-Compact"},{"inlineContent":[{"type":"image","identifier":"component_textArea_OrangeCompact"}],"type":"paragraph"},{"text":"Sosh","type":"heading","level":3,"anchor":"Sosh"},{"inlineContent":[{"identifier":"component_textArea_Sosh","type":"image"}],"type":"paragraph"},{"text":"Wireframe","type":"heading","level":3,"anchor":"Wireframe"},{"inlineContent":[{"identifier":"component_textArea_Wireframe","type":"image"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"1.4.0"}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;"},{"type":"text","text":" "},{"type":"text","text":"by expanding vertically and offering more space to input text."},{"type":"text","text":" "},{"type":"text","text":"It provides a visual and interactive affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstextarea"]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea","interfaceLanguage":"swift"},"sections":[],"references":{"doc://OUDSComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/HelperText":{"url":"\/documentation\/oudscomponents\/oudstextarea\/helpertext","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea\/HelperText","abstract":[{"type":"text","text":"Describes the content of the helper text displayed below the text area."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperText"}],"title":"OUDSTextArea.HelperText","navigatorTitle":[{"kind":"identifier","text":"HelperText"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea":{"title":"OUDSTextArea","url":"\/documentation\/oudscomponents\/oudstextarea","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextArea","role":"symbol","abstract":[{"type":"text","text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;"},{"type":"text","text":" "},{"type":"text","text":"by expanding vertically and offering more space to input text."},{"type":"text","text":" "},{"type":"text","text":"It provides a visual and interactive affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback."}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTextArea"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"OUDSTextArea"}]},"doc://OUDSComponents/documentation/OUDSComponents/Controls":{"role":"article","kind":"article","type":"topic","title":"Controls","url":"\/documentation\/oudscomponents\/controls","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"controls"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextArea/init(_:tableName:bundle:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)":{"kind":"symbol","title":"init(_:tableName:bundle:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","role":"symbol","abstract":[{"type":"text","text":"Creates a text area with a localized label, looking up the key in the given bundle."}],"type":"topic","url":"\/documentation\/oudscompon