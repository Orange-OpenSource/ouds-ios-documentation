lineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" is not displayed for iOS < 26.","type":"text"}]}],"name":"hasLargeTitle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"inlineContent":[{"type":"text","text":"Never displayed if "},{"code":"principalItem","type":"codeVoice"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}],"type":"strong"}]}],"name":"subtitle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"type":"text","text":" by default."}]}]},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":