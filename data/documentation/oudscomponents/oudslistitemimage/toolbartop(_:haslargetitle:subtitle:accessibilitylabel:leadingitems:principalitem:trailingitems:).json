p rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"text":" ","type":"text"},{"text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead.","type":"text"},{"text":" ","type":"text"},{"text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemImage\/toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)","interfaceLanguage":"swift"},"abstract":[{"text":"Creates a top toolbar with a title, optional subtitle (for iOS 26+), leading, principal and trailing items.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemImage"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemimage\/toolbartop(_:haslargetitle:subtitle:accessibilitylabel:leadingitems:principalitem:trailingitems:)"]}],"references":{"ic_folder_categories.png":{"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"type":"image","identifier":"ic_folder_categories.png"},"doc://OUDSComponents/d