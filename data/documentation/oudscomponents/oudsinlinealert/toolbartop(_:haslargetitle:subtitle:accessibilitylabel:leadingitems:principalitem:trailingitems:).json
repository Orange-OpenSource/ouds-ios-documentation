ype":"paragraph","inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}]}]},{"name":"hasLargeTitle","content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" is not displayed for iOS < 26.","type":"text"}]}]},{"name":"subtitle","content":[{"inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"type":"text","text":" by default. "},{"inlineContent":[{"type":"text","text":"Never displayed if "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"inlineContent":[{"text":"empty","type":"text"}],"type":"emphasis"},{"typ