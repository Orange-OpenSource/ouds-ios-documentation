ert":{"title":"OUDSInlineAlert","url":"\/documentation\/oudscomponents\/oudsinlinealert","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","type":"topic","abstract":[{"text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,","type":"text"},{"text":" ","type":"text"},{"text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional","type":"text"},{"text":" ","type":"text"},{"text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSInlineAlert"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSInlineAlert"}]},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSTheme":{"title":"OUDSTheme","url":"\/documentation\/oudsthemescontract\/oudstheme","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","type":"topic","abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"code":"class","type":"codeVoice"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTheme"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSTheme"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert/headingMedium(_:)":{"abstract":[{"type":"text","text":"Modifies the current "},{"code":"View","type":"codeVoice"},{"type":"text","text":" to apply a "},{"inlineContent":[{"text":"heading medium","type":"text"}],"type":"emphasis"},{"type":"text","text":" typography."},{"type":"text","text":" "},{"type":"text","text":"The current "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" must be given in parameter because "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" property cannot be accessed through an extension or inside a method."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"headingMedium"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"OUDSTheme","preciseIdentifier":"s:18OUDSThemesContract9OUDSThemeC"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"headingMedium(_:)"