,"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSInlineAlert":{"type":"topic","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInlineAlert","title":"OUDSInlineAlert","role":"symbol","navigatorTitle":[{"text":"OUDSInlineAlert","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsinlinealert","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSInlineAlert","kind":"identifier"}]},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSTheme":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTheme","kind":"identifier"}],"type":"topic","url":"\/documentation\/oudsthemescontract\/oudstheme","role":"symbol","navigatorTitle":[{"text":"OUDSTheme","kind":"identifier"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","abstract":[{"type":"text","text":"This is the base theme that all themes must inherit from."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text"