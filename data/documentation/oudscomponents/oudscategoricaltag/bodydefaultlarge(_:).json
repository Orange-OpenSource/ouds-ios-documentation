ents","kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCategoricalTag/bodyDefaultLarge(_:)":{"abstract":[{"text":"Modifies the current ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to apply a ","type":"text"},{"inlineContent":[{"type":"text","text":"body default large"}],"type":"emphasis"},{"text":" typography.","type":"text"},{"text":" ","type":"text"},{"text":"The current ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" must be given in parameter because ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" property cannot be accessed through an extension or inside a method.","type":"text"}],"role":"symbol","kind":"symbol","title":"bodyDefaultLarge(_:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag\/bodyDefaultLarge(_:)","type":"topic","url":"\/documentation\/oudscomponents\/oudscategoricaltag\/bodydefaultlarge(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bodyDefaultLarge"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"OUDSTheme","preciseIdentifier":"s:18OUDSThemesContract9OUDSThemeC"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCategoricalTag":{"kind":"symbol","url":"\/documentation\/oudscomponents\/oudscategoricaltag","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","title":"OUDSCategoricalTag","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours."},{"type":"text","text":" "},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"OUDSTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCategoricalTag","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSCategoricalTag","kind":"identifier"}]},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSTheme":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTheme","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"OUDSTheme","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","role":"symbol","abstract":[{"type":"text","text":"This is the base theme that all themes must inherit from."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"text":"object oriented paradigm","type":"text"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"text":"theme contract","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"text":"final","type":"text"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"title":"OUDSTheme","url":"\/documentation\/oudsthemescontract\/oudstheme"},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}]}}}