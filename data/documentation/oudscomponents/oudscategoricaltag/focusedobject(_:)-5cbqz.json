,{"kind":"identifier","text":"OUDSCategoricalTag"}],"abstract":[{"text":"A ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"text":"It can represent information such as promotions, events, benefits or other locally defined categories.","type":"text"},{"text":" ","type":"text"},{"text":"It does not communicate functional status or system feedback.","type":"text"},{"text":" ","type":"text"},{"text":"Use the ","type":"text"},{"code":"OUDSTag","type":"codeVoice"},{"text":" for success, warning, error, availability or other functional states.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"text":" tag only when its colour categories are defined by the product or local market guidelines.","type":"text"}],"url":"\/documentation\/oudscomponents\/oudscategoricaltag","navigatorTitle":[{"kind":"identifier","text":"OUDSCategoricalTag"}],"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","title":"OUDSCategoricalTag","kind":"symbol"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","alt":null,"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","kind":"symbol","url":"\/documentation\/oudscomponents","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"text":"Components","kind":"text"}],"title":"Components","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","typ