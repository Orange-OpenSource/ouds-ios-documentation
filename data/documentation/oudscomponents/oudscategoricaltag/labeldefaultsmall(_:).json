"}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSCategoricalTag":{"url":"\/documentation\/oudscomponents\/oudscategoricaltag","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCategoricalTag"}],"title":"OUDSCategoricalTag","abstract":[{"text":"A ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"text":"It can represent information such as promotions, events, benefits or other locally defined categories.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It does not communicate functional status or system feedback."},{"text":" ","type":"text"},{"text":"Use the ","type":"text"},{"code":"OUDSTag","type":"codeVoice"},{"text":" for success, warning, error, availability or other functional states.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","role":"symbol","navigatorTitle":[{"text":"OUDSCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSTheme":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTheme","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTheme","kind":"identifier"}],"kind":"symbol","title":"OUDSTheme","type":"topic","abstract":[{"text":"This is the base theme that all themes must inherit from.","type":"text"},{"text":" ","type":"text"},{"text":"A Swift ","type":"text"},{"code":"class","type":"codeVoice"},{"text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers","type":"text"},{"text":" ","type":"text"},{"text":"to implement all tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Any properties of an overridable theme should be defined so as to provide defaults values.","type":"text"},{"text":" ","type":"text"},{"text":"We allow this theme to be derivated and be overridden.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","type":"reference","isActive":true},{"text":" can be seen as a kind of “abstract class” in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"text":", or ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","url":"\/documentation\/oudsthemescontract\/oudstheme","role":"symbol"},"ic_folder_categories.png":{"alt":null,"identifier":"ic_folder_categories.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCategoricalTag/labelDefaultSmall(_:)":{"type":"topic","kind":"symbol","url":"\/documentation\/oudscomponents\/oudscategoricaltag\/labeldefaultsmall(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"labelDefaultSmall","kind":"identifier"},{"text":"(","kind":"text"},{"text":"OUDSTheme","kind":"typeIdentifier","preciseIdentifier":"s:18OU