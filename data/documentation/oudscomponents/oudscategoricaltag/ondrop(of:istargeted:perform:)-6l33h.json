,"title":"OUDSCategoricalTag","abstract":[{"text":"A ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"text":"It can represent information such as promotions, events, benefits or other locally defined categories.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It does not communicate functional status or system feedback."},{"text":" ","type":"text"},{"text":"Use the ","type":"text"},{"code":"OUDSTag","type":"codeVoice"},{"text":" for success, warning, error, availability or other functional states.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","role":"symbol","navigatorTitle":[{"text":"OUDSCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/oudscomponents","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","title":"Components","navigatorTitle":[{"text":"Components","kind":"text"}]}}}