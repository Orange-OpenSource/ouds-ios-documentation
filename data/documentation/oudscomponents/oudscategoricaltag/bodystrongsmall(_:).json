mbol","url":"\/documentation\/oudscomponents\/oudscategoricaltag","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","title":"OUDSCategoricalTag","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours."},{"type":"text","text":" "},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"OUDSTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCategoricalTag","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSCategoricalTag","kind":"identifier"}]}}}