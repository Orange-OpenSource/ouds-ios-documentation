rations"},{"kind":"parameters","parameters":[{"name":"title","content":[{"inlineContent":[{"type":"text","text":"The toolbar title. Prefer a non-empty string."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" must be displayed in large mode or not, ","type":"text"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" is not displayed for iOS < 26."}]}],"name":"hasLargeTitle"},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" if iOS 26+, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. ","type":"text"},{"inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" and the "},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"name":"leadingItems","content":[{"inlineContent":[{"type":"text","text":"The items displayed on the leading side,