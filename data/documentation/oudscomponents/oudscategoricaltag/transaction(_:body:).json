,"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"text":"It can represent information such as promotions, events, benefits or other locally defined categories.","type":"text"},{"text":" ","type":"text"},{"text":"It does not communicate functional status or system feedback.","type":"text"},{"text":" ","type":"text"},{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"OUDSTag"},{"text":" for success, warning, error, availability or other functional states.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":"OUDSCategoricalTag"},{"text":" tag only when its colour categories are defined by the product or local market guidelines.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCategoricalTag"}]},"ic_folder_categories.png":{"alt":null,"identifier":"ic_folder_categories.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and hi