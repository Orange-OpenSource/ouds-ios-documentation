ag","abstract":[{"text":"A ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"text":"It can represent information such as promotions, events, benefits or other locally defined categories.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It does not communicate functional status or system feedback."},{"text":" ","type":"text"},{"text":"Use the ","type":"text"},{"code":"OUDSTag","type":"codeVoice"},{"text":" for success, warning, error, availability or other functional states.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"OUDSCategoricalTag","type":"codeVoice"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCategoricalTag","role":"symbol","navigatorTitle":[{"text":"OUDSCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleColorSemanticToken":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A semantic token that wraps a combination of "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","type":"reference","isActive":true},{"type":"text","text":" values based on the color scheme (light or dark mode)."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineConte