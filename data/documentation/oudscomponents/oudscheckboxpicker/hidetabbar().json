ntent"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"whenever a view inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":" embedded in an "},{"code":"OUDSTabBar","type":"codeVoice"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"code":"OUDSTabBar","type":"codeVoice"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Otherwise for simple app "},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"type":"text","text":" is enough."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker\/hideTabBar()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscheckboxpicker\/hidetabbar()"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker"]]},"kind":"symbol","references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSCheckboxPicker/hideTabBar()":{"role":"symbol","url":"\/documentation\/oudscomponents\/oudscheckboxpicker\/hidetabbar()","abstract":[{"type":"text","text":"Hides the native tab bar "},{