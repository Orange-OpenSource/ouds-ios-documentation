ype":"text","text":"A picker allowing to expose several checkboxes and select some of them within the others."},{"type":"text","text":" "},{"type":"text","text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose the choosen values using this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","isActive":true},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"kind":"symbol","role":"symbol","title":"OUDSCheckboxPicker"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCheckboxItem":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCheckboxItem"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSCheckboxItem"}],"type":"topic","url":"\/documentation\/oudscomponents\/oudscheckboxitem","abstract":[{"type":"text","text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Checkbox item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."}],"kind":"symbol","role":"symbol","title":"OUDSCheckboxItem"}}}