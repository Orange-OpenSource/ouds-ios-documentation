":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" must be displayed in large mode or not, ","type":"text"},{"inlineContent":[{"type":"text","text":"false"}],"type":"emphasis"},{"text":" by default. If large mode, the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" is not displayed for iOS < 26.","type":"text"}],"type":"paragraph"}]},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}]}]}]},{"name":"accessibilityLabel","content":[{"inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" and the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}],"type":"paragraph"}]},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"type":"text","text":" by default."}]}]},{"name":"principalItem","content":[{"inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" is displayed only if ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", and the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" is never displayed.","type":"text"}],"type":"paragraph"}]},{"name":"trailingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the trailing side, "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"type":"text","text":" by default."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The view which contains this ","type":"text"},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"text":" must be placed inside a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"type":"text","text":"top toolbar"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},