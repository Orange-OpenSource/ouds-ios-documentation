{"kind":"symbol","metadata":{"externalID":"s:14OUDSComponents14OUDSToolBarTopV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"OUDSToolBarTop","kind":"identifier"}],"platforms":[{"introducedAt":"15.0","deprecated":false,"name":"iOS","unavailable":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"deprecated":false,"beta":false}],"navigatorTitle":[{"text":"OUDSToolBarTop","kind":"identifier"}],"title":"OUDSToolBarTop","symbolKind":"struct","modules":[{"name":"Components"}],"roleHeading":"Structure"},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"code":".navigationSubtitle()","type":"codeVoice"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}],"type":"paragraph"},{"anchor":"Appearances","text":"Appearances","type":"heading","level":2},{"inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can apply another style for the back button"}]}]}]},{"inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"type":"codeVoice","code":"oudsNavigationBarAppearance"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" that must be applyed on the root view of the ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":" for example.","type":"text"}],"type":"paragraph"},{"anchor":"Technical-constraints","text":"Technical constraints","type":"heading","level":2},{"inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}],"type":"paragraph"},{"code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Platform-considerations","text":"Platform considerations","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}]}]}]},{"anchor":"Badges-uses","text":"Badges uses","type":"heading","level":2},{"inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used.","type":"text"}],"type":"paragraph"},{"anchor":"Code-sample","text":"Code sample","type":"heading","level":2},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            principalItem: OUDSToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" helper can also be used to apply a SwiftUI toolbar configuration.","type":"text"}],"type":"paragraph"},{"code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"syntax":"swift","type":"codeListing"},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top"}],"type":"paragraph"},{"anchor":"Themes-rendering","text":"Themes rendering","type":"heading","level":2},{"anchor":"Liquid-Glass","text":"Liquid Glass","type":"heading","level":3},{"anchor":"Orange","text":"Orange","type":"heading","level":4},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","type":"heading","level":4},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark"}],"type":"paragraph"},{"anchor":"Sosh","text":"Sosh","type":"heading","level":4},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_dark"}],"type":"paragraph"},{"anchor":"Wireframe","text":"Wireframe","type":"heading","level":4},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Wireframe_dark"}],"type":"paragraph"},{"anchor":"Without-Liquid-Glass","text":"Without Liquid Glass","type":"heading","level":3},{"anchor":"Orange","text":"Orange","type":"hea