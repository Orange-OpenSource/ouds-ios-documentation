{"kind":"symbol","metadata":{"navigatorTitle":[{"text":"OUDSToolBarTop","kind":"identifier"}],"title":"OUDSToolBarTop","roleHeading":"Structure","externalID":"s:14OUDSComponents14OUDSToolBarTopV","modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"platforms":[{"introducedAt":"15.0","deprecated":false,"beta":false,"unavailable":false,"name":"iOS"},{"introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false,"name":"visionOS"}],"role":"symbol","symbolKind":"struct"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstoolbartop"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:trailingItems:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/body(content:)"],"anchor":"Instance-Methods"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/ViewModifier-Implementations"],"anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"The top toolbar (aka "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation bar"}]},{"type":"text","text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information"},{"type":"text","text":" "},{"type":"text","text":"and controls related to the current view."},{"type":"text","text":" "},{"type":"text","text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions."},{"type":"text","text":" "},{"type":"text","text":"It can contains leading and trailing actions."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSToolBarTop"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"toolBarTop(_:hasLargeTitle:subtitle:leadingItems:trailingItems:)","type":"codeVoice"},{"type":"text","text":"  View helper applies a SwiftUI toolbar configuration."}]},{"anchor":"Appearances","type":"heading","text":"Appearances","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can apply another style for the back button"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Globaly the appearence of the * navigation bar* elements is changed by the "},{"code":"oudsNavigationBarAppearance","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"helper of "},{"code":"View","type":"codeVoice"},{"type":"text","text":" that must be applyed on the root view of the "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":" for example."}]},{"anchor":"Technical-constraints","type":"heading","text":"Technical constraints","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:"}]},{"type":"codeListing","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"syntax":"swift"},{"type":"heading","text":"Platform considerations","anchor":"Platform-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The component is available on iOS, iPadOS, and visionOS","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}]}]}]},{"anchor":"Badges-uses","level":2,"type":"heading","text":"Badges uses"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable"},{"type":"text","text":" "},{"type":"text","text":"rendering with the glassified effect applied on the top toolbar."},{"type":"text","text":" "},{"type":"text","text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used."}]},{"type":"heading","text":"Code sample","anchor":"Code-sample","level":2},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Design documentation","anchor":"Design-documentation","level":2},{"inlineContent":[{"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top","isActive":true}],"type":"paragraph"},{"anchor":"Themes-rendering","level":2,"type":"heading","text":"Themes rendering"},{"type":"heading","level":3,"text":"Liquid Glass","anchor":"Liquid-Glass"},{"type":"heading","level":4,"text":"Orange","anchor":"Orange"},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}],"type":"paragraph"},{"type":"heading","text":"Orange Compact","anchor":"Orange-Compact","level":4},{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark","type":"image"}]},{"anchor":"Sosh","level":4,"type":"heading","text":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_L