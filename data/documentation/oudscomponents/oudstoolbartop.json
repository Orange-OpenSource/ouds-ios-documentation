{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/init(title:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/body(content:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/ViewModifier-Implementations"]}],"abstract":[{"text":"The top toolbar (aka ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation bar"}],"type":"emphasis"},{"text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information","type":"text"},{"text":" ","type":"text"},{"text":"and controls related to the current view.","type":"text"},{"text":" ","type":"text"},{"text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions.","type":"text"},{"text":" ","type":"text"},{"text":"It can contain leading, principal (center, single item only), and trailing actions.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSToolBarTop"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"type":"heading","level":2,"text":"Appearances","anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The appearance of navigation bar elements is changed by the "},{"code":"oudsNavigationBarAppearance","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" helper, which must be applied to the root view of the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Technical constraints","level":2,"anchor":"Technical-constraints","type":"heading"},{"inlineContent":[{"text":"To ensure the back button and text use the correct color on iOS 18 and earlier, apply the following accent color in your main view:","type":"text"}],"type":"paragraph"},{"code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Platform-considerations","level":2,"type":"heading","text":"Platform considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is available on iOS, iPadOS, and visionOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}]}]}]},{"type":"heading","anchor":"Badges-uses","level":2,"text":"Badges uses"},{"inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used."}],"type":"paragraph"},{"type":"heading","anchor":"Code-sample","text":"Code sample","level":2},{"type":"codeListing","code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            principalItem: OUDSToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" helper can also be used to apply a SwiftUI toolbar configuration.","type":"text"}]},{"type":"codeListing","code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"syntax":"swift"},{"type":"heading","anchor":"Design-documentation","text":"Design documentation","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top","isActive":true,"type":"reference"}]},{"type":"heading","anchor":"Themes-rendering","text":"Themes rendering","level":2},{"type":"heading","anchor":"Liquid-Glass","text":"Liquid Glass","level":3},{"type":"heading","anchor":"Orange","text":"Orange","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}]},{"type":"heading","anchor":"Orange-Compact","text":"Orange Compact","level":4},{"type":"paragraph","inlineContent":[{"type":"i