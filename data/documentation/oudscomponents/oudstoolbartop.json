{"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:trailingItems:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/body(content:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/ViewModifier-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"codeVoice","code":"toolBarTop(_:hasLargeTitle:subtitle:leadingItems:trailingItems:)"},{"type":"text","text":"  View helper applies a SwiftUI toolbar configuration."}],"type":"paragraph"},{"level":2,"text":"Appearances","type":"heading","anchor":"Appearances"},{"inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The OS can apply another style for the back button"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"code":"oudsNavigationBarAppearance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" that must be applyed on the root view of the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" for example.","type":"text"}]},{"level":2,"type":"heading","anchor":"Technical-constraints","text":"Technical constraints"},{"type":"paragraph","inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}]},{"type":"codeListing","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Platform-considerations","text":"Platform considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"Badges-uses","text":"Badges uses"},{"type":"paragraph","inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used.","type":"text"}]},{"level":2,"type":"heading","anchor":"Code-sample","text":"Code sample"},{"type":"codeListing","code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Design-documentation","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top","type":"reference"}]},{"level":2,"type":"heading","anchor":"Themes-rendering","text":"Themes rendering"},{"level":3,"type":"heading","anchor":"Liquid-Glass","text":"Liquid Glass"},{"level":4,"type":"heading","anchor":"Orange","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_LiquidGlass_Orange_dark","type":"image"}]},{"level":4,"type":"heading","anchor":"Orange-Compact","text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"identif