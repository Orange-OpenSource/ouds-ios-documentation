{"metadata":{"modules":[{"name":"Components"}],"platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSToolBarTop"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSToolBarTop"}],"roleHeading":"Structure","externalID":"s:14OUDSComponents14OUDSToolBarTopV","title":"OUDSToolBarTop","symbolKind":"struct"},"kind":"symbol","sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"The top toolbar (aka "},{"inlineContent":[{"type":"text","text":"navigation bar"}],"type":"emphasis"},{"type":"text","text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information"},{"type":"text","text":" "},{"type":"text","text":"and controls related to the current view."},{"type":"text","text":" "},{"type":"text","text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions."},{"type":"text","text":" "},{"type":"text","text":"It can contains leading and trailing actions."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:trailingItems:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/body(content:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/ViewModifier-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"code":"toolBarTop(_:hasLargeTitle:subtitle:leadingItems:trailingItems:)","type":"codeVoice"},{"type":"text","text":"  View helper applies a SwiftUI toolbar configuration."}],"type":"paragraph"},{"text":"Appearances","level":2,"anchor":"Appearances","type":"heading"},{"inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"type":"codeVoice","code":"oudsNavigationBarAppearance"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" that must be applyed on the root view of the ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":" for example.","type":"text"}],"type":"paragraph"},{"anchor":"Technical-constraints","level":2,"text":"Technical constraints","type":"heading"},{"inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}],"type":"paragraph"},{"code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"Platform-considerations","level":2,"text":"Platform considerations","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"The component is available on iOS, iPadOS, and visionOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for watchOS, tvOS and macOS","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Badges uses","level":2,"anchor":"Badges-uses","type":"heading"},{"inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable"},{"type":"text","text":" "},{"type":"text","text":"rendering with the glassified effect applied on the top toolbar."},{"type":"text","text":" "},{"type":"text","text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used."}],"type":"paragraph"},{"text":"Code sample","level":2,"anchor":"Code-sample","type":"heading"},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"syntax":"swift","type":"codeListing"},{"text":"Design documentation","level":2,"anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top","type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","level":2,"anchor":"Themes-rendering","type":"heading"},{"text":"Liquid Glass","level":3,"anchor":"Liquid-Glass","type":"heading"},{"text":"Orange","level":4,"anchor":"Orange","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Orange_dark"}],"type":"paragraph"},{"text":"Orange Compact","level":4,"anchor":"Orange-Compact","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_OrangeCompact_dark"}],"type":"paragraph"},{"text":"Sosh","level":4,"anchor":"Sosh","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_Sosh_dark"}],"type":"paragraph"},{"text":"Wireframe","level":4,"anchor":"Wireframe","type":"heading"},{"inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_Wireframe_light","type":"image"},{"text":" ",