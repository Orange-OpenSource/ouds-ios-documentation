{"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"sections":[],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:trailingItems:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/body(content:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarTop\/ViewModifier-Implementations"],"anchor":"Default-Implementations"}],"metadata":{"role":"symbol","platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false}],"symbolKind":"struct","navigatorTitle":[{"text":"OUDSToolBarTop","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"title":"OUDSToolBarTop","externalID":"s:14OUDSComponents14OUDSToolBarTopV","roleHeading":"Structure","modules":[{"name":"Components"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"toolBarTop(_:hasLargeTitle:subtitle:leadingItems:trailingItems:)"},{"type":"text","text":"  View helper applies a SwiftUI toolbar configuration."}]},{"level":2,"anchor":"Appearances","type":"heading","text":"Appearances"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}]}]},{"content":[{"inlineContent":[{"text":"The placement of the title can be leading or centered depending to the length of the text","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Globaly the appearence of the * navigation bar* elements is changed by the "},{"type":"codeVoice","code":"oudsNavigationBarAppearance"},{"type":"text","text":" "},{"type":"text","text":"helper of "},{"type":"codeVoice","code":"View"},{"type":"text","text":" that must be applyed on the root view of the "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" for example."}]},{"level":2,"anchor":"Technical-constraints","type":"heading","text":"Technical constraints"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:"}]},{"syntax":"swift","type":"codeListing","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"]},{"level":2,"anchor":"Platform-considerations","type":"heading","text":"Platform considerations"},{"items":[{"content":[{"inlineContent":[{"text":"The component is available on iOS, iPadOS, and visionOS","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Badges-uses","type":"heading","text":"Badges uses"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable"},{"type":"text","text":" "},{"type":"text","text":"rendering with the glassified effect applied on the top toolbar."},{"type":"text","text":" "},{"type":"text","text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used."}]},{"level":2,"anchor":"Code-sample","type":"heading","text":"Code sample"},{"syntax":"swift","type":"codeListing","code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"]},{"level":2,"anchor":"Design-documentation","type":"heading","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top"}]},{"level":2,"anchor":"Themes-rendering","type":"heading","text":"Themes rendering"},{"level":3,"