{"metadata":{"externalID":"s:14OUDSComponents14OUDSToolBarTopV","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSToolBarTop","kind":"identifier"}],"modules":[{"name":"Components"}],"title":"OUDSToolBarTop","symbolKind":"struct","platforms":[{"introducedAt":"15.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"visionOS","beta":false}],"navigatorTitle":[{"text":"OUDSToolBarTop","kind":"identifier"}]},"abstract":[{"text":"The top toolbar (aka ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"navigation bar","type":"text"}]},{"text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information","type":"text"},{"text":" ","type":"text"},{"text":"and controls related to the current view.","type":"text"},{"text":" ","type":"text"},{"text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It can contains leading and trailing actions."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"text":" ","kind":"text"},{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSToolBarTop"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"toolBarTop(_:hasLargeTitle:subtitle:leadingItems:trailingItems:)"},{"type":"text","text":"  View helper applies a SwiftUI toolbar configuration."}]},{"type":"heading","text":"Appearances","level":2,"anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The text can be truncated if there is not enough remaining space","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}]},{"type":"paragraph","inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"type":"codeVoice","code":"oudsNavigationBarAppearance"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" that must be applyed on the root view of the ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" for example."}]},{"level":2,"text":"Technical constraints","anchor":"Technical-constraints","type":"heading"},{"inlineContent":[{"type":"text","text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:"}],"type":"paragraph"},{"syntax":"swift","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"type":"codeListing"},{"anchor":"Platform-considerations","type":"heading","level":2,"text":"Platform considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is available on iOS, iPadOS, and visionOS","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The component is not available for watchOS, tvOS and macOS","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Badges-uses","type":"heading","level":2,"text":"Badges uses"},{"inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the OUDS badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  OUDS badge component is always used.","type":"text"}],"type":"paragraph"},{"text":"Code sample","anchor":"Code-sample","type":"heading","level":2},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                OUDSToolBarItem(navigation: .back())","            },","            trailingItems: {","                OUDSToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                OUDSToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"syntax":"swift","type":"codeListing"},{"text":"Design documentation","anchor":"Design-documentation","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tool-bar-top"}],"type":"paragraph"},{"text":"Themes rendering","anchor":"Themes-rendering","type":"heading","level":2},{"text":"Liquid Glass","anchor":"Liquid-Glass","type":"heading","level":3},{"text":"Orange","anchor":"Orange","type":"heading","level":4},{"inlineContent":[