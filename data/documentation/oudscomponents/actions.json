{"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"heading","anchor":"Buttons","text":"Buttons","level":3},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_button_Orange","type":"image"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"identifier":"component_button_OrangeCompact","type":"image"}],"type":"paragraph"}],"title":"Orange Compact"},{"content":[{"inlineContent":[{"identifier":"component_button_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_button_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true},{"type":"text","text":" proposes layout with text only, icon only or text and icon."},{"type":"text","text":" "},{"type":"text","text":"Four hierarchies are proposed for all layouts: "},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"strong","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"minimal","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"negative","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two style are available: "},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"loading","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If button is placed on colored surface using "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"OUDSButton.Appearance.Negative"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two sizes are available: "},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}]}]}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/actions"]}],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"roleHeading":"Article","title":"Actions","modules":[{"name":"Components"}]},"references":{"ic_folder_categories.png":{"alt":null,"type":"image","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png"},"component_button_Wireframe":{"alt":"A button component in light and dark modes with Wireframe theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_Wireframe.png","traits":["1x","light"]}],"identifier":"component_button_Wireframe"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"kind":"symbol","role":"symbol","title":"OUDSButton","type":"topic","url":"\/documentation\/oudscomponents\/oudsbutton","navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton"},"component_button_Orange":{"alt":"A button component in light and dark modes with Orange theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"identifie