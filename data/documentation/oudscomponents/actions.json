mponents/OUDSButton":{"url":"\/documentation\/oudscomponents\/oudsbutton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"title":"OUDSButton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","role":"symbol","navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"type":"topic","kind":"symbol"},"component_button_Orange":{"identifier":"component_button_Orange","type":"image","alt":"A button component in light and dark modes with Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_button_Orange.png"}]},"component_button_OrangeCompact":{"type":"image","identifier":"component_button_OrangeCompact","variants":[{"url":"\/images\/OUDSComponents\/component_button_OrangeCompact.png","traits":["1x","light"]}],"alt":"A button component in light and dark modes with Orange Compact theme"}}}