{"kind":"article","metadata":{"modules":[{"name":"Components"}],"roleHeading":"Article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","title":"Actions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/actions"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"actions"}]},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"text":"Buttons","type":"heading","anchor":"Buttons","level":3},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_Orange"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_OrangeCompact"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_Sosh"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_Wireframe"}]}],"title":"Wireframe"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true},{"type":"text","text":" proposes layout with text only, icon only or text and icon."},{"type":"text","text":" "},{"type":"text","text":"Four hierarchies are proposed for all layouts: "},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"strong","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"minimal","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"negative","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two style are available: "},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"loading","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If button is placed on colored surface using "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"OUDSButton.Appearance.Negative"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two sizes are available: "},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"small"}],"type":"emphasis"},{"type":"text","text":"."}]},{"type":"codeListing","code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy.","type":"text"}]}]}],"references":{"component_button_Orange":{"alt":"A button component in light and dark modes with Orange theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"identifier":"component_button_Orange"},"component_button_Wireframe":{"alt":"A button component in light and dark modes with Wireframe theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_button_Wireframe.png"}],"identifier":"component_button_Wireframe"},"component_button_Sosh":{"alt":"A button component in light and dark modes with Sosh theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_Sosh.png","traits":["1x","light"]}],"identifier":"component_button_Sosh"},"ic_folder_categories.png":{"alt":null,"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"kind":"symbol","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","role":"symbol","url":"\/documentation\/oudscomponents\/oudsbutton","title":"OUDSButton","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","role":"collection","url":"\/documentation\/oudscomponents","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"title":"Components","type":"topic"},"component_button_OrangeCompact":{"alt":"A button component in light and dark modes with Orange Compact theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_button_OrangeCompact"}}}