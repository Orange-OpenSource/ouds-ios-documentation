{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"metadata":{"role":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"title":"Actions","modules":[{"name":"Components"}],"roleHeading":"Article"},"sections":[],"kind":"article","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"actions"}],"type":"strong"},{"text":".","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"text":"Buttons","type":"heading","level":3,"anchor":"Buttons"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_Orange","type":"image"}]}],"title":"Orange"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_OrangeCompact","type":"image"}]}],"title":"Orange Compact"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_Sosh","type":"image"}]}],"title":"Sosh"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_Wireframe","type":"image"}]}],"title":"Wireframe"}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton"},{"type":"text","text":" proposes layout with text only, icon only or text and icon."},{"type":"text","text":" "},{"type":"text","text":"Four hierarchies are proposed for all layouts: "},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"strong","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"minimal","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"negative","type":"text"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"loading"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"text":" ","type":"text"},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"OUDSButton.Appearance.Negative"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"small"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/actions"]}],"references":{"component_button_Wireframe":{"alt":"A button component in light and dark modes with Wireframe theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_Wireframe.png","traits":["1x","light"]}],"identifier":"component_button_Wireframe"},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/oudscomponents","role":"collection","type":"topic","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","navigatorTitle":[{"kind":"text","text":"Components"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"type":"topic","role":"symbol","title":"OUDSButton","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsbutton"},"component_button_OrangeCompact":{"alt":"A button component in light and dark modes with Orange Compact theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_button_OrangeCompact"},"component_button_Orange":{"variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"identifier":"component_button_Orange","alt":"A button component in light and dark modes with Orange theme","type":"image"},"ic_folder_categories.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"identifier":"ic_folder_categories.png","alt":null},"component_button_Sosh":{"identifier":"component_button_Sosh","type":"image","alt":"A button component in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_button_Sosh.png","traits":["1x","light"]}]}}}