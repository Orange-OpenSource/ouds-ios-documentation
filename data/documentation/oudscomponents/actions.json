"text":"default","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"loading","type":"text"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"type":"codeVoice","code":"OUDSColoredSurface"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"type":"codeVoice","code":"OUDSButton.Appearance.Negative"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"type":"codeVoice","code":"OUDSColoredSurface"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"small","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}]},{"inlineContent":[{"text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions"},"variants":[{"paths":["\/documentation\/oudscomponents\/actions"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","title":"Components","role":"collection","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","kind":"symbol","url":"\/documentation\/oudscomponents"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"title":"OUDSButton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"type":"topic","role":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","url":"\/documentation\/oudscomponents\/oudsbutton","kind":"symbol"},"ic_folder_categories.png":{"type":"image","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png"},"component_button_OrangeCompact":{"type":"image","alt":"A button component in light and dark modes with Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_button_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_button_OrangeCompact"},"component_button_Wireframe":{"type":"image","alt":"A button component in light and dark modes with Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_button_Wireframe.png","traits":["1x","light"]}],"identifier":"component_button_Wireframe"},"component_button_Sosh":{"type":"image","alt":"A button component in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_button_Sosh.png","traits":["1x","light"]}],"identifier":"component_button_Sosh"},"component_button_Orange":{"type":"image","alt":"A button component in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"identifier":"component_button_Orange"}}}