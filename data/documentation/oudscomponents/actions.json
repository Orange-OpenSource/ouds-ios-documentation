{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"heading","level":3,"text":"Buttons","anchor":"Buttons"},{"type":"tabNavigator","tabs":[{"title":"Orange","content":[{"inlineContent":[{"type":"image","identifier":"component_button_Orange"}],"type":"paragraph"}]},{"title":"Orange Compact","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_OrangeCompact","type":"image"}]}]},{"title":"Sosh","content":[{"inlineContent":[{"type":"image","identifier":"component_button_Sosh"}],"type":"paragraph"}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_Wireframe"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","isActive":true,"type":"reference"},{"text":" proposes layout with text only, icon only or text and icon.","type":"text"},{"text":" ","type":"text"},{"text":"Four hierarchies are proposed for all layouts: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"strong"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"minimal"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"negative","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"loading"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"code":"OUDSButton.Appearance.Negative","type":"codeVoice"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"small","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}]}]}],"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Actions","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"identifier":"ic_folder_categories.png","type":"card"}],"roleHeading":"Article","modules":[{"name":"Components"}]},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"actions"}],"type":"strong"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/actions"]}],"references":{"component_button_Orange":{"identifier":"component_button_Orange","variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"alt":"A button component in light and dark modes with Orange theme","type":"image"},"component_button_Wireframe":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_button_Wireframe.png"}],"type":"image","alt":"A button component in light and dark modes with Wireframe theme","identifier":"component_button_Wireframe"},"component_button_OrangeCompact":{"type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_button_OrangeCompact.png","traits":["1x","light"]}],"identifier":"component_button_OrangeCompact","alt":"A button component in light and dark modes with Orange Compact theme"},"component_button_Sosh":{"identifier":"component_button_Sosh","variants":[{"url":"\/images\/OUDSComponents\/component_button_Sosh.png","traits":["1x","light"]}],"alt":"A button component in light and dark modes with Sosh theme","type":"image"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image","alt":null,"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSButton":{"kind":"symbol","title":"OUDSButton","url":"\/documentation\/oudscomponents\/oudsbutton","type":"topic","role":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","kind":"symbol","url":"\/documentation\/oudscomponents","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"text":"Components","kind":"text"}],"title":"Components","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]}}}