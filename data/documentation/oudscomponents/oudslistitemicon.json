{"abstract":[{"text":"An icon element that can be used at the leading or trailing position of a list item","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"Components"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0","name":"iOS"},{"introducedAt":"13.0","beta":false,"deprecated":false,"unavailable":false,"name":"macOS"},{"introducedAt":"16.0","beta":false,"deprecated":false,"unavailable":false,"name":"tvOS"},{"introducedAt":"1.0","beta":false,"deprecated":false,"unavailable":false,"name":"visionOS"},{"introducedAt":"11.0","beta":false,"deprecated":false,"unavailable":false,"name":"watchOS"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSListItemIcon","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:14OUDSComponents16OUDSListItemIconV","title":"OUDSListItemIcon","symbolKind":"struct"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudslistitemicon"]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/init(status:description:size:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/body"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon"},{"type":"text","text":" displays a status icon (info, warning, positive, negative) with a predefined asset,"},{"type":"text","text":" "},{"type":"text","text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically"},{"type":"text","text":" "},{"type":"text","text":"based on the current theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"type":"heading","level":2,"text":"Status","anchor":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus"},{"type":"text","text":" enum defines the available icon variants:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".neutral(asset:badge:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A custom icon from a provided "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" asset, rendered with the default"},{"type":"text","text":" "},{"type":"text","text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".positive"}]},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".info"}]},{"type":"text","text":": A predefined information icon with an informational (blue) semantic color."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"type":"text","text":": A predefined warning icon with a warning (yellow\/orange) semantic color."},{"type":"text","text":" "},{"type":"text","text":"This icon uses a two-layer rendering with distinct internal and external shape colors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".negative"}]},{"type":"text","text":": A predefined alert\/important icon with a negative (red) semantic color."}],"type":"paragraph"}]}]},{"text":"Sizes","type":"heading","anchor":"Sizes","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".medium","type":"codeVoice"}]},{"type":"text","text":": The default size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetMedium"},{"type":"text","text":" token."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": The largest size, corresponding to the theme’s "},{"code":"controlItem.sizeAssetLarge","type":"codeVoice"},{"type":"text","text":" token."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"text":" When the icon is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"type":"codeVoice","code":"SwiftUI\/View\/oudsListItemSize(_:)"},{"text":"), the icon is always rendered at its smallest size","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter."}]},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ Info icon with medium size (default)","    OUDSListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    OUDSListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    OUDSListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Information\"),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Warning\"),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"],"syntax":"swift"},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}]}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSListItemIcon":{"title":"OUDSListItemIcon","role":"symbol","type":"topic","url":"\/documentation\/oudscomponents\/oudslistitemicon","abstract":[{"type":"text","text":"An icon element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"OUDSListItemIcon","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","role":"collection","abstract":[{"type":"text","text":"The catalog of all comp