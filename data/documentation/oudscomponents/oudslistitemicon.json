paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","type":"reference","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".neutral(asset:badge:)"}]},{"text":": A custom icon from a provided ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset, rendered with the default","type":"text"},{"text":" ","type":"text"},{"text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".positive"}]},{"text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".info"}]},{"text":": A predefined information icon with an informational (blue) semantic color.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"text":": A predefined warning icon with a warning (yellow\/orange) semantic color.","type":"text"},{"text":" ","type":"text"},{"text":"This icon uses a two-layer rendering with distinct internal and external shape colors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".negative"}]},{"text":": A predefined alert\/important icon with a negative (red) semantic color.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Sizes","text":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSCom