{"kind":"symbol","identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An icon element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon"},{"type":"text","text":" displays a status icon (info, warning, positive, negative) with a predefined asset,"},{"type":"text","text":" "},{"type":"text","text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically"},{"type":"text","text":" "},{"type":"text","text":"based on the current theme."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"type":"heading","anchor":"Status","level":2,"text":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","type":"reference","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".neutral(asset:badge:)"}],"type":"strong"},{"type":"text","text":": A custom icon from a provided "},{"code":"Image","type":"codeVoice"},{"text":" asset, rendered with the default","type":"text"},{"type":"text","text":" "},{"text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".positive","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".info","type":"codeVoice"}]},{"text":": A predefined information icon with an informational (blue) semantic color.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".warning"}],"type":"strong"},{"type":"text","text":": A predefined warning icon with a warning (yellow\/orange) semantic color."},{"type":"text","text":" "},{"type":"text","text":"This icon uses a two-layer rendering with distinct internal and external shape colors."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".negative","type":"codeVoice"}],"type":"strong"},{"text":": A predefined alert\/important icon with a negative (red) semantic color.","type":"text"}]}]}]},{"text":"Sizes","level":2,"type":"heading","anchor":"Sizes"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size"},{"type":"text","text":" enum defines the available sizes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, corresponding to the theme’s ","type":"text"},{"type":"codeVoice","code":"controlItem.sizeAssetMedium"},{"text":" token.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": The largest size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetLarge"},{"type":"text","text":" token."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"codeVoice","code":"SwiftUI\/View\/oudsListItemSize(_:)"},{"type":"text","text":"), the icon is always rendered at its smallest size"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter."}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Info icon with medium size (default)","    OUDSListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    OUDSListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    OUDSListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Information\"),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Warning\"),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3.0.0"}]}],"name":"Since"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudslistitemicon"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/init(status:description:size:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/body"]},{"generated":true,"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations"]}],"metadata":{"platforms":[{"name":"iOS","beta":false,"unavailable":false,"introducedAt":"15.0","deprecated":false},{"name":"macOS","beta":false,"unavailable":false,"introducedAt":"13.0","deprecated":false},{"name":"tvOS","beta":false,"unavailable":false,"introducedAt":"16.0","deprecated":false},{"name":"visionOS","beta":false,"unavailable":false,"introd