An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"anchor":"Status","type":"heading","level":2,"text":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".neutral(asset:badge:)","type":"codeVoice"}]},{"text":": A custom icon from a provided ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" asset, rendered with the default","type":"text"},{"text":" ","type":"text"},{"text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".positive"}],"type":"strong"},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".info","type":"codeVoice"}]},{"text":": A predefined information icon with an informational (blue) semantic color.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"type":"text","text":": A predefined warning icon with a warning (yellow\/orange) semantic color."},{"type":"text","text":" "},{"type":"text","text":"This icon uses a two-layer rendering with distinct internal and external shape colors."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".negative"}],"type":"strong"},{"text":": A predefined alert\/important icon with a negative (red) semantic color.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Sizes",