{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon","type":"reference","isActive":true},{"type":"text","text":" displays a status icon (info, warning, positive, negative) with a predefined asset,"},{"type":"text","text":" "},{"type":"text","text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically"},{"type":"text","text":" "},{"type":"text","text":"based on the current theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"text":"Status","type":"heading","level":2,"anchor":"Status"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","isActive":true},{"text":" enum defines the available icon variants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".neutral(asset:badge:)","type":"codeVoice"}]},{"text":": A custom icon from a provided ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset, rendered with the default","type":"text"},{"text":" ","type":"text"},{"text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".positive","type":"codeVoice"}]},{"text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".info","type":"codeVoice"}]},{"type":"text","text":": A predefined information icon with an informational (blue) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"text":": A predefined warning icon with a warning (yellow\/orange) semantic color.","type":"text"},{"text":" ","type":"text"},{"text":"This icon uses a two-layer rendering with distinct internal and external shape colors.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".negative","type":"codeVoice"}]},{"type":"text","text":": A predefined alert\/important icon with a negative (red) semantic color."}]}]}]},{"text":"Sizes","type":"heading","level":2,"anchor":"Sizes"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, corresponding to the theme’s "},{"code":"controlItem.sizeAssetMedium","type":"codeVoice"},{"type":"text","text":" token."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"text":": The largest size, corresponding to the theme’s ","type":"text"},{"code":"controlItem.sizeAssetLarge","type":"codeVoice"},{"text":" token.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"codeVoice","code":"SwiftUI\/View\/oudsListItemSize(_:)"},{"type":"text","text":"), the icon is always rendered at its smallest size"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter."}]},{"level":2,"type":"heading","anchor":"Code-samples","text":"Code samples"},{"code":["    \/\/ Info icon with medium size (default)","    OUDSListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    OUDSListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    OUDSListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Information\")),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Warning\")),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Since","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"symbolKind":"s