{"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/init(status:description:size:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/body"]},{"generated":true,"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size"]},{"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/View-Implementations"],"title":"Default Implementations","generated":true}],"abstract":[{"type":"text","text":"An icon element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSStaticListItem"},{"type":"text","text":" or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSNavigationListItem","type":"reference","isActive":true},{"type":"text","text":"."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSListItemIcon"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon","type":"reference"},{"type":"text","text":" displays a status icon (info, warning, positive, negative) with a predefined asset,"},{"type":"text","text":" "},{"type":"text","text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically"},{"type":"text","text":" "},{"type":"text","text":"based on the current theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"anchor":"Status","type":"heading","level":2,"text":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","type":"reference","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".neutral(asset:badge:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A custom icon from a provided "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset, rendered with the default"},{"text":" ","type":"text"},{"type":"text","text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".positive","type":"codeVoice"}]},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".info","type":"codeVoice"}]},{"type":"text","text":": A predefined information icon with an informational (blue) semantic color."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"text":": A predefined warning icon with a warning (yellow\/orange) semantic color.","type":"text"},{"text":" ","type":"text"},{"text":"This icon uses a two-layer rendering with distinct internal and external shape colors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".negative"}],"type":"strong"},{"type":"text","text":": A predefined alert\/important icon with a negative (red) semantic color."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Sizes","type":"heading","level":2,"text":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size"},{"type":"text","text":" enum defines the available sizes:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".medium","type":"codeVoice"}],"type":"strong"},{"text":": The default size, corresponding to the theme’s ","type":"text"},{"code":"controlItem.sizeAssetMedium","type":"codeVoice"},{"text":" token.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": The largest size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetLarge"},{"type":"text","text":" token."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"code":"SwiftUI\/View\/oudsListItemSize(_:)","type":"codeVoice"},{"type":"text","text":"), the icon is always rendered at its smallest size"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"code":"size","type":"codeVoice"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"code":["    \/\/ Info icon with medium size (default)","    OUDSListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    OUDSListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    OUDSListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Information\"),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Warning\"),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"externalID":"s:14OUDSComponents16OUDSListItemIconV","roleHeading":"Structure","modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"platforms":[{"name":"iOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"15.0"},{"name":"macOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"13.0"},{"name":"tvOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"16.0"},{"name":"visionOS","beta":false,"deprecated":false,"unavailable":false,"intro