{"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSListItemIcon","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon"},{"text":" displays a status icon (info, warning, positive, negative) with a predefined asset,","type":"text"},{"text":" ","type":"text"},{"text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically","type":"text"},{"text":" ","type":"text"},{"text":"based on the current theme.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}],"type":"paragraph"},{"text":"Status","anchor":"Status","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus"},{"type":"text","text":" enum defines the available icon variants:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".neutral(asset:badge:)"}],"type":"strong"},{"type":"text","text":": A custom icon from a provided "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" asset, rendered with the default"},{"type":"text","text":" "},{"type":"text","text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".positive"}]},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".info"}],"type":"strong"},{"text":": A predefined information icon with an informational (blue) semantic color.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".warning","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A predefined warning icon with a warning (yellow\/orange) semantic color."},{"type":"text","text":" "},{"type":"text","text":"This icon uses a two-layer rendering with distinct internal and external shape colors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".negative"}],"type":"strong"},{"type":"text","text":": A predefined alert\/important icon with a negative (red) semantic color."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Sizes","level":2,"anchor":"Sizes"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size","type":"reference"},{"type":"text","text":" enum defines the available sizes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, corresponding to the theme’s ","type":"text"},{"type":"codeVoice","code":"controlItem.sizeAssetMedium"},{"type":"text","text":" token."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"type":"text","text":": The largest size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetLarge"},{"type":"text","text":" token."}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"codeVoice","code":"SwiftUI\/View\/oudsListItemSize(_:)"},{"type":"text","text":"), the icon is always rendered at its smallest size"},{"type":"text","text":" "},{"text":"regardless of the ","type":"text"},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ Info icon with medium size (default)","    OUDSListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    OUDSListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    OUDSListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    OUDSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Information\"),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: \"Warning\"),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"],"syntax":"swift"},{"style":"note","type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"3.0.0","type":"text"}]}]}],"kind":"content"}],"topicSections":[{"title":"Init