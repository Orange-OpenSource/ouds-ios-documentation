ive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon","type":"reference"},{"text":" displays a status icon (info, warning, positive, negative) with a predefined asset,","type":"text"},{"text":" ","type":"text"},{"text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically","type":"text"},{"text":" ","type":"text"},{"text":"based on the current theme.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An optional notification badge can be attached to neutral icons to indicate additional status.","type":"text"}],"type":"paragraph"},{"text":"Status","anchor":"Status","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/IconStatus","type":"reference","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".neutral(asset:badge:)"}]},{"type":"text","text":": A custom icon from a provided "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset, rendered with the default"},{"type":"text","text":" "},{"type":"text","text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".positive"}]},{"type":"text","text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".info"}]},{"type":"text","text":": A predefined information icon with an informational (blue) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".warning"}]},{"type":"text","text":": A predefined warning icon with a warning (yellow\/orange) semantic color."},{"type":"text","text":" "},{"type":"text","text":"This icon uses a two-layer rendering with distinct internal and external shape colors."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".negative","type":"codeVoice"}]},{"type":"text","text":": A predefined alert\/important icon with a negative (red) semantic color."}]}]}],"type":"unorderedList"},{"text":"Sizes","anchor":"Sizes","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListItemIcon\/Size","type":"reference"},{"text":" enum defines the available sizes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetMedium"},{"type":"text","text":" token."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": The largest size, corresponding to the theme’s "},{"type":"codeVoice","code":"controlItem.sizeAssetLarge"},{"type":"text","text":" token."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"text":"(via ","type":"text"},{"code":"SwiftUI\/View\/oudsListItemSize(_:)","type":"codeVoice"},{"text":"), the icon is always rendered at its smallest size","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" parameter.","type":"text"}]},