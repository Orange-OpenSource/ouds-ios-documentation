DSListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Information\")),","        leading: .icon(OUDSListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    OUDSStaticListItem(","        data: OUDSListItemData(label: .textual(\"Warning\")),","        trailing: .icon(OUDSListItemIcon(status: .warning, description: \"\", size: .medium))","    )"],"syntax":"swift"},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"references":{"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/OUDSComponents\/s8SendableP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSListItemIcon/Size":{"kind":"symbol","title":"OUDSListItemIcon.Size","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Size","kind":"identifier"}],"navigatorTitle":[{"text":"Size","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudslistitemicon\/size","type":"topic","abstract":[{"type":"text","text":"Defines the available sizes for the icon."},{"type":"text","text":" "},{"type":"text","text":"When the icon is embedded in a list item with "},{"type":"codeVoice","code":".small"},{"type":"text","text":" size, this parameter is ignored"},{"type":"text","text":" "},{"type":"text","text":"and a smallest size is always used."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSListIte