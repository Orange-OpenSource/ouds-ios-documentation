S < 26."}]}]},{"name":"subtitle","content":[{"inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" if iOS 26+, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. "},{"type":"strong","inlineContent":[{"type":"text","text":"Never displayed if "},{"code":"principalItem","type":"codeVoice"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}]}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}]},{"name":"leadingItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"text":" by default.","type":"text"}]}]},{"name":"principalItem","content":[{"type":"paragraph","inlineContent":[{"text":"The item displayed in the principal (center) position, ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"text":"If set, the ","type":"text"},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"text":" is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is ","type"