":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,","type":"text"},{"text":" ","type":"text"},{"text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead.","type":"text"},{"text":" ","type":"text"},{"text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton\/toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)"},"abstract":[{"text":"Creates a top toolbar with a title, optional subtitle (for iOS 26+), leading, principal and trailing items.","type":"text"}],"kind":"symbol","metadata":{"role":"symbol","platforms":[{"unavailable":false,"beta":false,"deprecated":false,"name":"iOS","introducedAt":"15.0"},{"unavailable":false,"beta":false,"deprecated":false,"name":"iPadOS","introducedAt":"15.0"},{"unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst","introducedAt":"15.0"},{"unavailable":false,"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0"}],"title":"toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toolBarTop","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Str