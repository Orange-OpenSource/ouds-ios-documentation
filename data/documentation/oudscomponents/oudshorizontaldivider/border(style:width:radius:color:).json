"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a color token has a value that depends on the color scheme, it must be packed in a "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","isActive":true},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSDividerColor","kind":"identifier"}],"abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"code":"OUDSHorizontalDivider","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSVerticalDivider","type":"codeVoice"},{"type":"text","text":")"}],"type":"topic","kind":"symbol","title":"OUDSDividerColor","navigatorTitle":[{"text":"OUDSDividerColor","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsdividercolor","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSDividerColor"}}}