xt":"OUDSToolBarItem"},{"kind":"text","text":"] = { [] }) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}]}],"name":"title"},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"false"}]},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":" is not displayed for iOS < 26.","type":"text"}],"type":"paragraph"}],"name":"hasLargeTitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" displayed below the "},{"inlineContent":[{"text":"title","type":"text"}],"type":"emphasis"},{"type":"text","text":" if iOS 26+, "},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"type":"text","text":" by default. "},{"inlineContent":[{"type":"text","text":"Never displayed if "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" is not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":"."}],"type":"strong"}]}],"name":"subtitle"},{"content":[{"inlineContent":[{"text":"Optional label vocalized by VoiceOver instead of the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" and the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}],"type":"paragraph"}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The items displayed on the leading side, "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"emphasis"},{"type":"text","text":" by default."}]}],"name":"leadingItems"},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"type":"text","text":" by default. Only one item is supported."},{"type":"text","text":" "},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and the ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" is never displayed.","type":"text"}],"type":"paragraph"}],"name":"principalItem"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}]}],"name":"trailingItems"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The view which contains this ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"text":" must be placed inside a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"otherwise the top toolbar won’t appear..","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There must be only one "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}]}]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSDividerColor":{"url":"\/documentation\/oudscomponents\/oudsdividercolor","type":"topic","navigatorTitle":[{"text":"OUDSDividerColor","kind":"iden