age","content":[{"inlineContent":[{"text":"An optional ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSImage"},{"text":" encapsulating the asset, its flip flag and its rendering mode.","type":"text"},{"text":" ","type":"text"},{"text":"Default set to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". If defined, its accessibility label will be ignored.","type":"text"}],"type":"paragraph"}]},{"name":"isOutlined","content":[{"inlineContent":[{"text":"Flag to get an outlined radio, default set to ","type":"text"},{"type":"codeVoice","code":"false"}],"type":"paragraph"}]},{"name":"isReversed","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if the radio indicator must be in trailing position, ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" otherwise. Default to ","type":"text"},{"type":"codeVoice","code":"false"}],"type":"paragraph"}]},{"name":"isError","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if the look and feel of the component must reflect an error state, default set to ","type":"text"},{"type":"codeVoice","code":"false"}],"type":"paragraph"}]},{"name":"errorText","content":[{"inlineContent":[{"text":"An optional error message to display at the bottom, raw, localized or rich text. This message is ignored if ","type":"text"},{"type":"codeVoice","code":"isError"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"isReadOnly","content":[{"inlineContent":[{"text":"True if component is in read only, i.e. not really disabled but user cannot interact with it yet, default set to ","type":"text"},{"type":"codeVoice","code":"false"}],"type":"paragraph"}]},{"name":"hasDivider","content":[{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" a divider is add