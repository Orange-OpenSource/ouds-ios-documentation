{"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"content":[{"text":"Appearances","anchor":"Appearances","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."},{"type":"text","text":" "},{"type":"text","text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" "},{"type":"text","text":"or "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true,"type":"reference"},{"text":", the native API is used instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before.","type":"text"},{"text":" ","type":"text"},{"text":"However if an app is built with Xcode 26 and the flag ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" set to ","type":"text"},{"inlineContent":[{"text":"YES","type":"text"}],"type":"emphasis"},{"text":", then Liquid Glass won’t be applied but the alternative layout.","type":"text"},{"text":" ","type":"text"},{"text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you use SF Symbols for images, if they exist their "},{"inlineContent":[{"text":"fill","type":"text"}],"type":"emphasis"},{"type":"text","text":" variant will be automatically used in the tab bar (native behaviour)."}],"type":"paragraph"},{"level":2,"text":"Platform considerations","anchor":"Platform-considerations","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"This component is tailored for iOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On iPadOS the tabs do not apply the fonts since iPadOS 18"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for tvOS","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Guidelines","level":2,"type":"heading","text":"Guidelines"},{"inlineContent":[{"text":"OUDS guidelines recommends to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}]}]},{"content":[{"inlineContent":[{"text":"use badges only when needed to avoid to have heavy tab bar","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if decorative images are used for tab bar item, apply ","type":"text"},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"text":" rendering mode on it to apply color on tabs","type":"text"}]}]}],"type":"unorderedList"},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)"},{"type":"text","text":" "},{"type":"text","text":"by using accessibiltiy value"}]}]}]},{"syntax":"swift","code":["    OUDSTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Selection-of-tabs","text":"Selection of tabs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS lower than 26, a selected tab indicator is displayed in the "},{"code":"OUDSTabBar","type":"codeVoice"},{"type":"text","text":" ; the "},{"code":"count","type":"codeVoice"},{"type":"text","text":" parameter must be defined (to the number of tabs in the component),"},{"type":"text","text":" "},{"type":"text","text":"and if the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding value is equal to a given tag associated to a tab item."},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This rule is only applied if selected tab indicator must be displayed."},{"type":"text","text":" "},{"type":"text","text":"When the user taps a tab, the "},{"code":"selectedTab","type":"codeVoice"},{"type":"text","text":" binding is updated automatically, keeping the parent view in sync."}]},{"level":2,"type":"heading","anchor":"Technical-considerations","text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"text":"In order to improve the Developer eXperience the current ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" implementation lets users define their own tab items."},{"text":" ","type":"text"},{"text":"OUDS applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a ","type":"text"},{"inlineContent":[{"type":"text","text":"picker"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Thus users will need to add their own accessiiblity label if badges are used or also apply "},{"type":"emphasis","inlineContent":[{"text":"template","type":"text"}]},{"type":"text","text":" rendering mode on images if needed."},{"type":"text","text":" "},{"type":"text","text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking."}]},{"inlineContent":[{"type":"text","text":"You must use in your tab bar items images with "},{"inlineContent":[{"type":"text","text":"a size of 26 x 26"}],"type":"strong"},{"type":"text","text":", otherwise rendering could be unaligned with Figma specifications"}],"type":"paragraph"},{"inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"text":" ","type":"text"},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer ","type":"text"},{"type":"codeVoice","code":"hideTabBar()"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" and overlay items) with Liquid Glass is disabled or not available, or also ","type":"text"},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Code-samples","type":"heading","text":"Code samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Use the OUDS tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    OUDSTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside OUDSTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"]},{"level":2,"anchor":"Alternative-components","type":"heading","text":"Alternative components"},{"inlineContent":[{"type":"text","text":"If you want to use SwiftUI "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" View with or without rules, use instead "},{"code":"OUDSTabView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you target apps with Liquid Glass enabled and need "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" or rules, use instead "},{"code":"OUDSLiquidGlassTabView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Design documentation","level":2,"anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","type":"reference","isActive":true}],"type":"paragraph"},{"text":"Themes rendering","level":2,"anchor":"Themes-rendering","type":"heading"},{"text":"Liquid Glass","level":3,"anchor":"Liquid-Glass","type":"heading"},{"text":"Orange","level":4,"anchor":"Orange","type":"heading"},{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image"}],"type":"paragraph"},{"text":"Orange Compact","level":4,"anchor":"Orange-Compact","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark","type":"image"}],"type":"paragraph"},{"level":4,"anchor":"Sosh","type":"heading","text":"Sosh"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}]},{"anchor":"Wireframe","type":"heading","level":4,"text":"Wireframe"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_light"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image"}]},{"type":"heading","level":3,"text":"Without Liquid Glass","anchor":"Without-Liquid-Glass"},{"type":"heading","level":4,"text":"Orange","anchor":"Orange"},{"inlineContent":[{"identifier":"component_tabBar_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_Orange_dark","type":"image"}],"type":"paragraph"},{"level":4,"anchor":"Orange-Compact","type":"heading","text":"Orange Compact"},{"inlineContent":[{"identifier":"component_tabBar_OrangeCompact_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_OrangeCompact_dark","type":"image"}],"type":"paragraph"},{"level":4,"text":"Sosh","type":"heading","anchor":"Sosh"},{"inlineContent":[{"identifier":"component_tabBar_Sosh_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_Sosh_dark","type":"image"}],"type":"paragraph"},{"level":4,"text":"Wireframe","type":"heading","anchor":"Wireframe"},{"inlineContent":[{"identifier":"component_tabBar_Wireframe_light","type":"image"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}],"type":"aside","name":"Version","style":"note"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.0.0"}]}],"type":"aside","name":"Since"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","interfaceLanguage":"swift"},"metadata":{"title":"OUDSTabBar","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTabBar","kind":"identifier"}],"externalID":"s:14OUDSComponents10OUDSTabBarV","roleHeading":"Structure","modules":[{"name":"Components"}],"symbolKind":"struct","platforms":[{"introducedAt":"15.0","unavailable":false,"name":"iOS","beta":false,"deprecated":false},{"introducedAt":"13.0","unavailable":false,"name":"macOS","beta":false,"deprecated":false},{"introducedAt":"1.0","unavailable":false,"name":"visionOS","beta":false,"deprecated":false}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudstabbar"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The Tab bar is a system navigation component with a position which can vary depending to the OS.","type":"text"},{"text":" ","type":"text"},{"text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"text":" ","type":"text"},{"text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body"],"title":"Instance Properties"},{"anchor":"Default-Implementations","generated":true,"identi