{"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},"metadata":{"modules":[{"name":"Components"}],"platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0"},{"name":"macOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}],"roleHeading":"Structure","role":"symbol","title":"OUDSTabBar","externalID":"s:14OUDSComponents10OUDSTabBarV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"content":[{"level":2,"anchor":"Appearances","type":"heading","text":"Appearances"},{"type":"paragraph","inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"},{"text":" ","type":"text"},{"text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed","type":"text"},{"text":" ","type":"text"},{"text":"and not the text making theme not readable in dark color scheme","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true,"type":"reference"},{"text":", the native API is used instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before.","type":"text"},{"text":" ","type":"text"},{"text":"However if an app is built with Xcode 26 and the flag ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" set to ","type":"text"},{"inlineContent":[{"type":"text","text":"YES"}],"type":"emphasis"},{"text":", then Liquid Glass won’t be applied but the alternative layout.","type":"text"},{"text":" ","type":"text"},{"text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you use SF Symbols for images, if they exist their ","type":"text"},{"inlineContent":[{"type":"text","text":"fill"}],"type":"emphasis"},{"text":" variant will be automatically used in the tab bar (native behaviour).","type":"text"}]},{"level":2,"anchor":"Platform-considerations","type":"heading","text":"Platform considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"This component is tailored for iOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On iPadOS the tabs do not apply the fonts since iPadOS 18","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for watchOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for tvOS","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Guidelines","type":"heading","text":"Guidelines"},{"type":"paragraph","inlineContent":[{"text":"OUDS guidelines recommends to:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"limit when possible the number of items to 5","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"use both images and texts in tab bar items","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"use badges only when needed to avoid to have heavy tab bar","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if decorative images are used for tab bar item, apply ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"template","type":"text"}]},{"text":" rendering mode on it to apply color on tabs","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Accessibility-considerations","type":"heading","text":"Accessibility considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar"},{"text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"text":"by using an accessibility value.","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["    OUDSTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""]},{"level":2,"anchor":"Selection-of-tabs","type":"heading","text":"Selection of tabs"},{"type":"paragraph","inlineContent":[{"text":"For iOS lower than 26, a selected tab indicator is displayed in the ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" ; the ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" parameter must be defined (to the number of tabs in the component),","type":"text"},{"text":" ","type":"text"},{"text":"and if the ","type":"text"},{"code":"selectedTab","type":"codeVoice"},{"text":" binding value is equal to a given tag associated to a tab item.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"text":" ","type":"text"},{"text":"This rule is only applied if selected tab indicator must be displayed.","type":"text"},{"text":" ","type":"text"},{"text":"When the user taps a tab, the ","type":"text"},{"code":"selectedTab","type":"codeVoice"},{"text":" binding is updated automatically, keeping the parent view in sync.","type":"text"}]},{"level":2,"anchor":"Technical-considerations","type":"heading","text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"text":"In order to improve the Developer eXperience the current ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" implementation lets users define their own tab items.","type":"text"},{"text":" ","type":"text"},{"text":"OUDS applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a ","type":"text"},{"inlineContent":[{"type":"text","text":"picker"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Thus users will need to add their own accessiiblity label if badges are used or also apply ","type":"text"},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"text":" rendering mode on images if needed.","type":"text"},{"text":" ","type":"text"},{"text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You must use in your tab bar items images with ","type":"text"},{"inlineContent":[{"type":"text","text":"a size of 26 x 26"}],"type":"strong"},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"text":" ","type":"text"},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer ","type":"text"},{"code":"hideTabBar()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" and overlay items) with Liquid Glass is disabled or not available, or also ","type":"text"},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"anchor":"Code-samples","type":"heading","text":"Code samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Use the OUDS tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    OUDSTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside OUDSTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"]},{"level":2,"anchor":"Alternative-components","type":"heading","text":"Alternative components"},{"type":"paragraph","inlineContent":[{"text":"If you want to use SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" View with or without rules, use instead ","type":"text"},{"code":"OUDSTabView","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you target apps with Liquid Glass enabled and need ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" or rules, use instead ","type":"text"},{"code":"OUDSLiquidGlassTabView","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"anchor":"Design-documentation","type":"heading","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","isActive":true,"type":"reference"}]},{"level":2,"anchor":"Themes-rendering","type":"heading","text":"Themes rendering"},{"level":3,"anchor":"Liquid-Glass","type":"heading","text":"Liquid Glass"},{"level":4,"anchor":"Orange","type":"heading","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image"}]},{"level":4,"anchor":"Orange-Compact","type":"heading","text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark","type":"image"}]},{"level":4,"anchor":"Sosh","type":"heading","text":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Sosh_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Sosh_dark","type":"image"}]},{"level":4,"anchor":"Wireframe","type":"heading","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_Wireframe_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image"}]},{"level":3,"anchor":"Without-Liquid-Glass","type":"heading","text":"Without Liquid Glass"},{"level":4,"anchor":"Orange","type":"heading","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_Orange_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_Orange_dark","type":"image"}]},{"level":4,"anchor":"Orange-Compact","type":"heading","text":"Orange Compact"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_OrangeCompact_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_OrangeCompact_dark","type":"image"}]},{"level":4,"anchor":"Sosh","type":"heading","text":"Sosh"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_Sosh_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_Sosh_dark","type":"image"}]},{"level":4,"anchor":"Wireframe","type":"heading","text":"Wireframe"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_Wireframe_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_Wireframe_dark","type":"image"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.0.0 (Figma component design version)"}],"type":"paragraph"}],"name":"Version"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.0.0"}],"type":"paragraph"}],"name":"Since"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations"],"generated":true}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"references":{"component_tabBar_Sosh_dark":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png","traits":["1x","light"]}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","identifier":"component_tabBar_Sosh_dark","type":"image"},"component_tabBar_LiquidGlass_Wireframe_light":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Wireframe theme","identifier":"component_tabBar_LiquidGlass_Wireframe_light","type":"image"},"component_tabBar_LiquidGlass_Sosh_light":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","identifier":"component_tabBar_LiquidGlass_Sosh_light","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"url":"\/documentation\/oudscomponents\/navigations","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"kind":"article","title":"Navigations","role":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":"."}]},"component_tabBar_LiquidGlass_Orange_light":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_light.png","traits":["1x","light"]}],"alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},"component_tabBar_LiquidGlass_Orange_dark":{"alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount"},{"text":" displays a text, as integer, limited to 99.","type":"text"}],"navigatorTitle":[{"text":"OUDSBadgeCount","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsbadgecount","title":"OUDSBadgeCount","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBadgeCount","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(selectedTab:count:content:)":{"url":"\/documentation\/oudscomponents\/oudstabbar\/init(selectedtab:count:content:)","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selectedTab","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt8","kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"init(selectedTab:count:content:)","role":"symbol","abstract":[{"text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index.","type":"text"},{"text":" ","type":"text"},{"text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS 26+ or other platform, prefer instead ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar(content:)"},{"text":".","type":"text"}]},"component_tabBar_LiquidGlass_OrangeCompact_dark":{"alt":"A  tab bar component in dark mode with Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}],"title":"unified-design-system.orange.com","type":"link","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar"},"component_tabBar_LiquidGlass_Sosh_dark":{"alt":"A  tab bar component in dark mode with Liquid Glass effect and Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"init(content:)","role":"symbol","abstract":[{"text":"Defines the tab bar component with given tab bar items.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS lower than 26, prefer instead ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar(selectedTab:count:content:)"}]},"doc://OUDSComponents/7SwiftUI4ViewP":{"title":"SwiftUICore.View","type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"url":"\/documentation\/oudscomponents\/oudstabbar\/view-implementations","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","kind":"article","title":"View Implementations","role":"collectionGroup","abstract":[]},"doc://OUDSComponents/documentation/OUDSComponents":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","url":"\/documentation\/oudscomponents","title":"Components","kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"type":"topic"},"doc://OUDSComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"component_tabBar_LiquidGlass_Wireframe_dark":{"alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_dark"},"component_tabBar_Wireframe_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Wireframe_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSBadgeStandard"}],"navigatorTitle":[{"text":"OUDSBadgeStandard","kind":"identifier"}],"type":"topic","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"url":"\/documentation\/oudscomponents\/oudsbadgestandard","title":"OUDSBadgeStandard","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","role":"symbol","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"role":"symbol","kind":"symbol","title":"OUDSTabBar","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","url":"\/documentation\/oudscomponents\/oudstabbar","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}]},"doc://OUDSComponents/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP"},"component_tabBar_Orange_light":{"alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Orange_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"type":"topic","title":"body","abstract":[{"text":"Uses a native SwiftUI ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" populated with the given content where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab item"}]},{"text":" elements are defined.","type":"text"},{"text":" ","type":"text"},{"text":"Rendering will change depending on the OS version, with a top divider and selected tab indicator for legacy layouts.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"body","kind":"identifier"},{"kind":"text","text":": "},{"text":"some","kind":"keyword"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s: