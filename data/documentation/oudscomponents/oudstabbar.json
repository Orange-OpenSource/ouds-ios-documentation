at the bottom of the screen for iOS. It can vary for iPadOS.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"type":"text","text":" "},{"text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations.","type":"text"}],"references":{"component_tabBar_LiquidGlass_OrangeCompact_dark":{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark","alt":"A  tab bar component in dark mode with Liquid Glass effect and Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_dark.png"}],"type":"image"},"doc://OUDSComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"type":"image"},"component_tabBar_Orange_light":{"identifier":"component_tabBar_Orange_light","alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeCount"}],"title":"OUDSBadgeCount","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","url":"\/documentation\/oudscomponents\/oudsbadgecount","type":"topic","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true,"type":"reference"},{"text":" displays a text, as integer, limited to 99.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeCount"}],"kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/oudscomponents","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","role":"collection","title":"Components","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"url":"\/documentation\/oudscomponents\/oudstabbar","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}],"title":"OUDSTabBar","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"role":"symbol"},"component_tabBar_Wireframe_dark":{"identifier":"component_tabBar_Wireframe_dark","alt":"A  tab bar component in dark mode without Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_dark.png"}],"type":"image"},"component_tabBar_Sosh_light":{"identifier":"component_tabBar_Sosh_light","alt":"A  tab bar component in light mode without Liquid Glass effect and Sosh theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_light.png"}],"type":"image"},"component_tabBar_Orange_dark":{"identifier":"component_tabBar_Orange_dark","alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png"}],"type":"image"},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"title":"unified-design-system.orange.com","url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","type":"link"},"component_tabBar_LiquidGlass_Orange_light":{"identifier":"component_tabBar_LiquidGlass_Orange_light","alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_light.png"}],"type":"image"},"component_tabBar_LiquidGlass_Wireframe_light":{"identifier":"component_tabBar_LiquidGlass_Wireframe_light","alt":"A  tab bar component in light mode with Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png"}],"type":"image"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"component_tabBar_OrangeCompact_light":{"identifier":"component_tabBar_OrangeCompact_light","alt":"A  tab bar component in light mode without Liquid Glass effect and Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png"}],"type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"type":"topic","role":"collectionGroup","url":"\/documentation\/oudscomponents\/oudstabbar\/view-implementations","kind":"article","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","abstract":[],"title":"View Implementations"},"component_tabBar_Wireframe_light":{"identifier":"component_tabBar_Wireframe_light","alt":"A  tab bar component in light mode without Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_light.png"}],"type":"image"},"component_tabBar_LiquidGlass_Wireframe_dark":{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png"}],"type":"image"},"component_tabBar_OrangeCompact_dark":{"identifier":"component_tabBar_OrangeCompact_dark","alt":"A  tab bar component in dark mode without Liquid Glass effect and Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_dark.png"}],"type":"image"},"component_tabBar_Sosh_dark":{"identifier":"component_tabBar_Sosh_dark","alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png"}],"type":"image"},"component_tabBar_LiquidGlass_Sosh_light":{"ident