omponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"text":"tab item","type":"text"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"url":"\/documentation\/oudscomponents\/oudstabbar\/body","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","kind":"symbol","title":"body","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}]},"component_tabBar_Orange_light":{"alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","identifier":"component_tabBar_Orange_light","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"kind":"article","url":"\/documentation\/oudscomponents\/oudstabbar\/view-implementations","role":"collectionGroup","title":"View Implementations","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","type":"topic","abstract":[]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"role":"symbol","title":"OUDSBadgeCount","url":"\/documentation\/oudscomponents\/oudsbadgecount","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"O