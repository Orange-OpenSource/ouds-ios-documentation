mponent in light mode with Liquid Glass effect and Sosh theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"title":"OUDSBadgeStandard","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","kind":"symbol","url":"\/documentation\/oudscomponents\/oudsbadgestandard","type":"topic","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeStandard"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeStandard"}]},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"type":"link","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","title":"unified-design-system.orange.com","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar"},"component_tabBar_LiquidGlass_Orange_dark":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark","alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme"},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"kind":