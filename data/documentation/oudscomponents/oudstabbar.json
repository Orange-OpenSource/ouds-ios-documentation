 component in light mode without Liquid Glass effect and Orange Compact theme","identifier":"component_tabBar_OrangeCompact_light","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png","traits":["1x","light"]}]},"component_tabBar_LiquidGlass_Orange_dark":{"alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme","identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png","traits":["1x","light"]}]},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSLiquidGlassTabView":{"abstract":[{"text":"A tab view component for iOS 26+ that accepts native SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" items including ","type":"text"},{"code":"Tab(role: .search)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"while applying the full OUDS tab bar appearance — colors, typography and top divider.","type":"text"}],"title":"OUDSLiquidGlassTabView","url":"\/documentation\/oudscomponents\/oudsliquidglasstabview","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSLiquidGlassTabView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLiquidGlassTabView"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSLiquidGlassTabView"}],"kind":"symbol"},"component_tabBar_LiquidGlass_Orange_light":{"alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image","variants":[{"url":"\/images\/OUDSC