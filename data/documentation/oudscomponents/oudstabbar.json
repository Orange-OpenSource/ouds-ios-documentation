Sosh_light":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png"}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"url":"\/documentation\/oudscomponents\/oudstabbar\/view-implementations","role":"collectionGroup","type":"topic","title":"View Implementations","abstract":[],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","kind":"article"},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"type":"link","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","title":"unified-design-system.orange.com"},"component_tabBar_Wireframe_light":{"alt":"A  tab bar component in light mode without Liquid Glass effect and Wireframe theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_Wireframe_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"kind":"symbol","role":"symbol","title":"OUDSBadgeStandard","type":"topic","url":"\/documentation\/oudscomponents\/oudsbadgestandard","navigatorTitle":[{"text":"OUDSBadgeStandard","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBadgeStandard","kind":"identifier"}],"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the