ar_LiquidGlass_Orange_light.png"}],"identifier":"component_tabBar_LiquidGlass_Orange_light"},"component_tabBar_Wireframe_light":{"alt":"A  tab bar component in light mode without Liquid Glass effect and Wireframe theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_light.png"}],"identifier":"component_tabBar_Wireframe_light"},"component_tabBar_Sosh_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png"}],"identifier":"component_tabBar_Sosh_dark"},"doc://OUDSComponents/documentation/OUDSComponents":{"abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","url":"\/documentation\/oudscomponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"type":"topic","title":"Components"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"role":"symbol","title":"body","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" populated with the given content where "},{"inlineContent":[{"text":"tab item","type":"text"}],"type":"emphasis"},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","url":"\/documentation\/oudscomponents\/oudstabbar\/body"},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"role":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","type":"topic","kind":"article","title":"Navigations","url":"\/documentation\/oudscomponents\/navigations"},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/OUDSComponents\/s8SendableP"},"component_tabBar_LiquidGlass_Wireframe_dark":{"identifier":"component_tabBar_LiquidGlass_Wireframe_dark","type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"title":"OUDSBadgeStandard","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeStandard"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeStandard"}],"url":"\/documentation\/oudscomponents\/oudsbadgestandard","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"type":"topic"},"component_tabBar_LiquidGlass_OrangeCompact_light":{"alt":"A  tab bar component in light mode with Liquid Glass effect and Orange Compact theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},"component_tabBar_LiquidGlass_Sosh_light":{"alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Sosh_light"},"component_tabBar_Wireframe_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Wireframe theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_dark.png"}],"identifier":"component_tabBar_Wireframe_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}],"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and main