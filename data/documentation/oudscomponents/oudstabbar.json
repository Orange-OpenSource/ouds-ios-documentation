d","isActive":true,"type":"reference"},{"text":" displays only a colored pastille.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","title":"OUDSBadgeStandard","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBadgeStandard","kind":"identifier"}]},"component_tabBar_Orange_light":{"alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Orange_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","kind":"symbol","title":"body","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab item"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"url":"\/documentation\/oudscomponents\/oudstabbar\/body","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","kind":"symbol","title":"init(content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"type":"codeVoice","code":"OUDSTabBar(selectedTab:count:content:)"}],"url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)","type":"topic"},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","title":"unified-design-system.orange.com","type":"link","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar"},"component_tabBar_LiquidGlass_Wireframe_light":{"alt":"A  tab bar component in light mode with Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_light"},"component_tabBar_Orange_dark":{"alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Orange_dark"},"component_tabBar_OrangeCompact_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_OrangeCompact_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"title":"OUDSTabBar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTabBar","kind":"identifier"}],"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","url":"\/documentation\/oudscomponents\/oudstabbar"},"component_tabBar_Wireframe_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Wireframe_dark"},"component_tabBar_OrangeCompact_light":{"alt":"A  tab bar component in light mode without Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_OrangeCompact_light"},"component_tabBar_Sosh_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Sosh_dark"},"component_tabBar_LiquidGlass_Sosh_light":{"alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},"doc://OUDSComponents/documentation/OUDSComponents":{"type":"topic","title":"Components","role":"