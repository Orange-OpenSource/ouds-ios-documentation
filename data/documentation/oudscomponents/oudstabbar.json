"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"]}],"references":{"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"url":"\/documentation\/oudscomponents\/oudsbadgecount","navigatorTitle":[{"text":"OUDSBadgeCount","kind":"identifier"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true},{"type":"text","text":" displays a text, as integer, limited to 99."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSBadgeCount","kind":"identifier"}],"title":"OUDSBadgeCount","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeStandard"}],"title":"OUDSBadgeStandard","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeStandard"}],"url":"\/documentation\/oudscomponents\/oudsbadgestandard","role":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"role":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"identifier":"ic_folder_categories.png","type":"card"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","url":"\/documentation\/oudscomponents\/navigations","type":"topic","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":"."}],"title":"Navigations","kind":"article"},"component_tabBar_LiquidGlass_Wireframe_dark":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png"}],"alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","identifier":"component_tabBar_LiquidGlass_Wireframe_dark"},"component_tabBar_LiquidGlass_OrangeCompact_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_light.png"}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Orange Compact theme","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},"doc://OUDSComponents/documentation/OUDSComponents":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"navigatorTitle":[{"kind":"text","text":"Components"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","kind":"symbol","title":"Components","url":"\/documentation\/oudscomponents","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"component_tabBar_LiquidGlass_Sosh_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png"}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","identifier":"component_tabBar_LiquidGlass_Sosh_light"},"ic_folder_categories.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}],"alt":null,"identifier":"ic_folder_categories.png"},"component_tabBar_LiquidGlass_OrangeCompact_dark":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_dark.png"}],"alt":"A  tab bar component in dark mode with Liquid Glass effect and Orange Compact theme","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"kind":"symbol","title":"init(content:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:14OUDSComponents10OUDSTabBarV7Contentxmfp","text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"code":"OUDSTabBar(selectedTab:count:content:)","type":"codeVoice"}]},"component_tabBar_Orange_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png"}],"alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","identifier":"component_tabBar_Orange_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"title":"OUDSTabBar","abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}],"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","url":"\/documentation\/oudscomponents\/oudstabbar","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}]},"component_tabBar_OrangeCompact_dark":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_dark.png"}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and Orange Compact theme","identifier":"component_tabBar_OrangeCompact_dark"},"component_tabBar_LiquidGlass_Wireframe_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png"}],"alt":"A  tab bar co