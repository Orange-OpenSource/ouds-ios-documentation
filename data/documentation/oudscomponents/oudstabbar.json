he interface size."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","type":"reference"},{"type":"text","text":" displays a text, as integer, limited to 99."}],"role":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","title":"OUDSBadgeCount"},"component_tabBar_LiquidGlass_OrangeCompact_light":{"type":"image","alt":"A  tab bar component in light mode with Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"type":"topic","role":"article","url":"\/documentation\/oudscomponents\/navigations","kind":"article","title":"Navigations","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"},"component_tabBar_LiquidGlass_Wireframe_dark":{"type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Wireframe_dark"},"component_tabBar_LiquidGlass_OrangeCompact_dark":{"type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"},"component_tabBar_OrangeCompact_light":{"type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_OrangeCompact_light"},"component_tabBar_LiquidGlass_Sosh_light":{"type":"image","alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Sosh_light"},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"type":"topic","role":"symbol","title":"init(content:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"type":"codeVoice","code":"OUDSTabBar(selectedTab:count:content:)"}],"url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)"},"ic_folder_categories.png":{"type":"image","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsbadgestandard","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" displays only a colored pastille.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeStandard"}],"role":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","type":"topic","title":"OUDSBadgeStandard","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeStandard"}]},"component_tabBar_Orange_light":{"type":"image","alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_Orange_light"},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"type":"link","title":"unified-design-system.orange.com","url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}],"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar"},"component_tabBar_LiquidGlass_Orange_dark":{"type":"image","alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Orange_dark"},"doc://OUDSComponents/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"abstract":[{"text":"Uses a native SwiftUI ","