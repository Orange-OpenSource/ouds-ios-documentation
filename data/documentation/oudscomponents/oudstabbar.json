{"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To","kind":"relationships"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"text":"Appearances","anchor":"Appearances","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."},{"type":"text","text":" "},{"type":"text","text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar does not change since iOS 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true},{"type":"text","text":", the native API is used instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before."},{"type":"text","text":" "},{"type":"text","text":"However if an app is built with Xcode 26 and the flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"YES"}]},{"type":"text","text":", then Liquid Glass won’t be applied but the alternative layout."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If you use SF Symbols for images, if they exist their ","type":"text"},{"inlineContent":[{"type":"text","text":"fill"}],"type":"emphasis"},{"type":"text","text":" variant will be automatically used in the tab bar (native behaviour)."}]},{"type":"heading","text":"Platform considerations","anchor":"Platform-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"This component is tailored for iOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On iPadOS the tabs do not apply the fonts since iPadOS 18"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for tvOS"}],"type":"paragraph"}]}]},{"type":"heading","text":"Guidelines","anchor":"Guidelines","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS guidelines recommends to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"use badges only when needed to avoid to have heavy tab bar"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if decorative images are used for tab bar item, apply "},{"type":"emphasis","inlineContent":[{"text":"template","type":"text"}]},{"type":"text","text":" rendering mode on it to apply color on tabs"}],"type":"paragraph"}]}]},{"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)"},{"type":"text","text":" "},{"type":"text","text":"by using an accessibility value."}],"type":"paragraph"}]}]},{"type":"codeListing","code":["    OUDSTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"syntax":"swift"},{"type":"heading","text":"Selection of tabs","anchor":"Selection-of-tabs","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS lower than 26, a selected tab indicator is displayed in the "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" ; the "},{"type":"codeVoice","code":"count"},{"type":"text","text":" parameter must be defined (to the number of tabs in the component),"},{"type":"text","text":" "},{"type":"text","text":"and if the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding value is equal to a given tag associated to a tab item."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator."},{"type":"text","text":" "},{"type":"text","text":"This rule is only applied if selected tab indicator must be displayed."},{"type":"text","text":" "},{"type":"text","text":"When the user taps a tab, the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding is updated automatically, keeping the parent view in sync."}]},{"type":"heading","text":"Technical considerations","anchor":"Technical-considerations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to improve the Developer eXperience the current "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" implementation lets users define their own tab items."},{"type":"text","text":" "},{"type":"text","text":"OUDS applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a "},{"type":"emphasis","inlineContent":[{"text":"picker","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Thus users will need to add their own accessiiblity label if badges are used or also apply "},{"type":"emphasis","inlineContent":[{"text":"template","type":"text"}]},{"type":"text","text":" rendering mode on images if needed."},{"type":"text","text":" "},{"type":"text","text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must use in your tab bar items images with "},{"type":"strong","inlineContent":[{"text":"a size of 26 x 26","type":"text"}]},{"type":"text","text":", otherwise rendering could be unaligned with Figma specifications"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,"},{"type":"text","text":" "},{"type":"text","text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer "},{"type":"codeVoice","code":"hideTabBar()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"View"},{"type":"text","text":" to hide the tab bar"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" and overlay items) with Liquid Glass is disabled or not available, or also "},{"type":"codeVoice","code":"tabBar(isHidden:)"},{"type":"text","text":"."}]},{"type":"heading","text":"Code samples","anchor":"Code-samples","level":2},{"type":"codeListing","code":["    \/\/ Use the OUDS tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    OUDSTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside OUDSTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"],"syntax":"swift"},{"type":"heading","text":"Alternative components","anchor":"Alternative-components","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to use SwiftUI "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" View with or without rules, use instead "},{"type":"codeVoice","code":"OUDSTabView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you target apps with Liquid Glass enabled and need "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" or rules, use instead "},{"type":"codeVoice","code":"OUDSLiquidGlassTabView"},{"type":"text","text":"."}]},{"type":"heading","text":"Design documentation","anchor":"Design-documentation","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar"}]},{"type":"heading","text":"Themes rendering","anchor":"Themes-rendering","level":2},{"type":"heading","text":"Liquid Glass","anchor":"Liquid-Glass","level":3},{"type":"heading","text":"Orange","anchor":"Orange","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark"}]},{"type":"heading","text":"Orange Compact","anchor":"Orange-Compact","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"}]},{"type":"heading","text":"Sosh","anchor":"Sosh","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}]},{"type":"heading","text":"Wireframe","anchor":"Wireframe","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_dark"}]},{"type":"heading","text":"Without Liquid Glass","anchor":"Without-Liquid-Glass","level":3},{"type":"heading","text":"Orange","anchor":"Orange","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Orange_dark"}]},{"type":"heading","text":"Orange Compact","anchor":"Orange-Compact","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_OrangeCompact_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_OrangeCompact_dark"}]},{"type":"heading","text":"Sosh","anchor":"Sosh","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Sosh_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Sosh_dark"}]},{"type":"heading","text":"Wireframe","anchor":"Wireframe","level":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_Wireframe_dark"}]},{"type":"aside","style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}]},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"metadata":{"externalID":"s:14OUDSComponents10OUDSTabBarV","roleHeading":"Structure","platforms":[{"unavailable":false,"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"15.0","name":"iPadOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"macOS"},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false}],"navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}],"modules":[{"name":"Components"}],"title":"OUDSTabBar","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}],"role":"symbol"},"references":{"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"title":"Navigations","kind":"article","role":"article","type":"topic","url":"\/documentation\/oudscomponents\/navigations","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"strong"},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"},"component_tabBar_Wireframe_dark":{"type":"image","alt":"A  tab bar component in dark mode without Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_Wireframe_dark"},"ic_folder_categories.png":{"type":"image","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png"},"component_tabBar_OrangeCompact_light":{"type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Orange Compact theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_OrangeCompact_light"},"component_tabBar_Wireframe_light":{"type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_Wireframe_light"},"component_tabBar_LiquidGlass_Orange_dark":{"type":"image","alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Orange_dark"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"type":"topic","role":"symbol","title":"OUDSBadgeStandard","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeStandard"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeStandard"}],"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true,"type":"reference"},{"type":"text","text":" displays only a colored pastille."}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsbadgestandard"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(selectedTab:count:content:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)","role":"symbol","title":"init(selectedTab:count:content:)","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index."},{"type":"text","text":" "},{"type":"text","text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS 26+ or other platform, prefer instead "},{"type":"codeVoice","code":"OUDSTabBar(content:)"},{"type":"text","text":"."}],"url":"\/documentation\/oudscomponents\/oudstabbar\/init(selectedtab:count:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selectedTab","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt8","kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents10OUDSTabBarV7Contentxmfp"},{"text":")","kind":"text"}]},"component_tabBar_LiquidGlass_Orange_light":{"type":"image","alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Orange_light"},"doc://OUDSComponents/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP"},"component_tabBar_LiquidGlass_Wireframe_dark":{"type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_Wireframe_dark"},"component_tabBar_Orange_light":{"type":"image","alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png","traits":["1x","light"]}],"identifier":"component_tabBar_Orange_light"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar":{"type":"topic","role":"symbol","title":"OUDSTabBar","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar","navigatorTitle":[{"kind":"identifier","text":"OUDSTabBar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTabBar"}],"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"url":"\/documentation\/oudscomponents\/oudstabbar","kind":"symbol"},"component_tabBar_LiquidGlass_Wireframe_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png"}],"identifier":"component_tabBar_LiquidGlass_Wireframe_light","alt":"A  tab bar component in light mode with Liquid Glass effect and Wireframe theme"},"component_tabBar_Orange_dark":{"alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme","type":"image","identifier":"component_tabBar_Orange_dark","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png","traits":["1x","light"]}]},"https://r.orange.fr/r/S-ouds-doc-ios-tab-bar":{"titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"title":"unified-design-system.orange.com","type":"link","identifier":"https:\/\/r.