{"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"}],"role":"symbol","modules":[{"name":"Components"}],"navigatorTitle":[{"text":"OUDSTabBar","kind":"identifier"}],"externalID":"s:14OUDSComponents10OUDSTabBarV","roleHeading":"Structure","symbolKind":"struct","platforms":[{"deprecated":false,"introducedAt":"15.0","unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"macOS"},{"deprecated":false,"introducedAt":"1.0","unavailable":false,"beta":false,"name":"visionOS"}],"title":"OUDSTabBar"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTabBar","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations"]},{"content":[{"type":"heading","text":"Appearances","level":2,"anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"},{"text":" ","type":"text"},{"text":"Because today the OUDS tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed","type":"text"},{"text":" ","type":"text"},{"text":"and not the text making theme not readable in dark color scheme","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount"},{"text":", the native API is used instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before.","type":"text"},{"text":" ","type":"text"},{"text":"However if an app is built with Xcode 26 and the flag ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" set to ","type":"text"},{"inlineContent":[{"text":"YES","type":"text"}],"type":"emphasis"},{"text":", then Liquid Glass won’t be applied but the alternative layout.","type":"text"},{"text":" ","type":"text"},{"text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you use SF Symbols for images, if they exist their ","type":"text"},{"inlineContent":[{"text":"fill","type":"text"}],"type":"emphasis"},{"text":" variant will be automatically used in the tab bar (native behaviour).","type":"text"}]},{"type":"heading","text":"Platform considerations","level":2,"anchor":"Platform-considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"This component is tailored for iOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On iPadOS the tabs do not apply the fonts since iPadOS 18","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for watchOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for tvOS","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Guidelines","level":2,"anchor":"Guidelines"},{"type":"paragraph","inlineContent":[{"text":"OUDS guidelines recommends to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"limit when possible the number of items to 5","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"use both images and texts in tab bar items","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"use badges only when needed to avoid to have heavy tab bar","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"if decorative images are used for tab bar item, apply "},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"text":" rendering mode on it to apply color on tabs","type":"text"}],"type":"paragraph"}]}]},{"text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"code":"OUDSTabBar","type":"codeVoice"},{"type":"text","text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"text":"by using accessibiltiy value","type":"text"}]}]}]},{"code":["    OUDSTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"syntax":"swift","type":"codeListing"},{"text":"Selection of tabs","level":2,"anchor":"Selection-of-tabs","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For iOS lower than 26, a selected tab indicator is displayed in the ","type":"text"},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" ; the ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" parameter must be defined (to the number of tabs in the component),","type":"text"},{"text":" ","type":"text"},{"text":"and if the ","type":"text"},{"type":"codeVoice","code":"selectedTab"},{"text":" binding value is equal to a given tag associated to a tab item.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"text":" ","type":"text"},{"text":"This rule is only applied if selected tab indicator must be displayed.","type":"text"},{"text":" ","type":"text"},{"text":"When the user taps a tab, the ","type":"text"},{"type":"codeVoice","code":"selectedTab"},{"text":" binding is updated automatically, keeping the parent view in sync.","type":"text"}]},{"text":"Technical considerations","type":"heading","anchor":"Technical-considerations","level":2},{"inlineContent":[{"type":"text","text":"In order to improve the Developer eXperience the current "},{"code":"OUDSTabBar","type":"codeVoice"},{"text":" implementation lets users define their own tab items.","type":"text"},{"text":" ","type":"text"},{"text":"OUDS applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a ","type":"text"},{"inlineContent":[{"type":"text","text":"picker"}],"type":"emphasis"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Thus users will need to add their own accessiiblity label if badges are used or also apply "},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"text":" rendering mode on images if needed.","type":"text"},{"type":"text","text":" "},{"text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You must use in your tab bar items images with "},{"inlineContent":[{"type":"text","text":"a size of 26 x 26"}],"type":"strong"},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"text":" ","type":"text"},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer "},{"code":"hideTabBar()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" and overlay items) with Liquid Glass is disabled or not available, or also "},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Code samples","type":"heading","anchor":"Code-samples","level":2},{"code":["    \/\/ Use the OUDS tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    OUDSTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside OUDSTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"],"syntax":"swift","type":"codeListing"},{"text":"Alternative components","type":"heading","anchor":"Alternative-components","level":2},{"inlineContent":[{"type":"text","text":"If you want to use SwiftUI "},{"code":"Tab","type":"codeVoice"},{"type":"text","text":" View with or without rules, use instead "},{"code":"OUDSTabView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"If you target apps with Liquid Glass enabled and need ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" or rules, use instead ","type":"text"},{"code":"OUDSLiquidGlassTabView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Design documentation","level":2,"type":"heading","anchor":"Design-documentation"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-ios-tab-bar","type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","type":"heading","anchor":"Themes-rendering","level":2},{"text":"Liquid Glass","type":"heading","anchor":"Liquid-Glass","level":3},{"text":"Orange","type":"heading","anchor":"Orange","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark"}],"type":"paragraph"},{"text":"Orange Compact","type":"heading","anchor":"Orange-Compact","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_dark"}],"type":"paragraph"},{"text":"Sosh","type":"heading","anchor":"Sosh","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Sosh_dark"}],"type":"paragraph"},{"text":"Wireframe","type":"heading","anchor":"Wireframe","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_dark"}],"type":"paragraph"},{"text":"Without Liquid Glass","type":"heading","anchor":"Without-Liquid-Glass","level":3},{"text":"Orange","type":"heading","anchor":"Orange","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_Orange_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Orange_dark"}],"type":"paragraph"},{"text":"Orange Compact","type":"heading","anchor":"Orange-Compact","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_OrangeCompact_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_OrangeCompact_dark"}],"type":"paragraph"},{"text":"Sosh","type":"heading","anchor":"Sosh","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_Sosh_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_Sosh_dark"}],"type":"paragraph"},{"text":"Wireframe","type":"heading","anchor":"Wireframe","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_Wireframe_light"},{"text":" ","type":"text"},{"identifier":"component_tabBar_Wireframe_dark","type":"image"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}],"type":"aside","name":"Version","style":"note"},{"style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0","type":"text"}]}],"type":"aside"}],"kind":"content"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selectedTab:count:content:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations"]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudstabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar"},"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"kind":"symbol","references":{"component_tabBar_Sosh_light":{"type":"image","identifier":"component_tabBar_Sosh_light","alt":"A  tab bar component in light mode without Liquid Glass effect and Sosh theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_light.png"}]},"component_tabBar_LiquidGlass_Wireframe_light":{"type":"image","alt":"A  tab bar component in light mode with Liquid Glass effect and Wireframe theme","identifier":"component_tabBar_LiquidGlass_Wireframe_light","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_light.png"}]},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/View-Implementations","role":"collectionGroup","url":"\/documentation\/oudscomponents\/oudstabbar\/view-implementations","abstract":[],"type":"topic","kind":"article","title":"View Implementations"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"type":"topic","title":"init(content:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"text":"Defines the tab bar component with given tab bar items.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS lower than 26, prefer instead ","type":"text"},{"type":"codeVoice","code":"OUDSTabBar(selectedTab:count:content:)"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","role":"symbol","url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)"},"component_tabBar_Orange_light":{"type":"image","identifier":"component_tabBar_Orange_light","alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png"}]},"component_tabBar_OrangeCompact_light":{"type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Orange Compact theme","identifier":"component_tabBar_OrangeCompact_light","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_light.png"}]},"component_tabBar_LiquidGlass_Wireframe_dark":{"type":"image","identifier":"component_tabBar_LiquidGlass_Wireframe_dark","alt":"A  tab bar component in dark mode with Liquid Glass effect and Wireframe theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Wireframe_dark.png"}]},"component_tabBar_Wireframe_light":{"type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Wireframe theme","identifier":"component_tabBar_Wireframe_light","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Wireframe_light.png"}]},"component_tabBar_LiquidGlass_Orange_light":{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_light","alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_light.png"}]},"component_tabBar_LiquidGlass_Sosh_dark":{"type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and Sosh theme","identifier":"component_tabBar_LiquidGlass_Sosh_dark","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_dark.png"}]},"component_tabBar_LiquidGlass_Orange_dark":{"type":"image","identifier":"component_tabBar_LiquidGlass_Orange_dark","alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png"}]},"component_tabBar_LiquidGlass_Sosh_light":{"type":"image","alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","identifier":"component_tabBar_LiquidGlass_Sosh_light","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png"}]},"component_tabBar_Orange_dark":{"type":"image","identifier":"component_tabBar_Orange_dark","alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png"}]},"component_tabBar_Sosh_dark":{"type":"image","alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","identifier":"component_tabBar_Sosh_dark","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png"}]},"doc://OUDSComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"type":"topic","title":"body","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"kind":"symbol","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"text":"tab item","type":"text"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","role":"symbol","url":"\/documentation\/oudscomponents\/oudstabbar\/body"},"component_tabBar_LiquidGlass_OrangeCompact_light":{"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeCompact_light","alt":"A  tab bar component in light mode with Liquid Glass effect and Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_light.png"}]},"ic_folder_categories.png":{"type":"image","alt":null,"identifier":"ic_folder_categories.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/ic_folder_categories.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/Navigations":{"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":"."}],"type":"topic","kind":"article","role":"article","title":"Navigations","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/oudscomponents\/navigations"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeCount":{"role":"symbol","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","isActive":true},{"type":"text","text":" displays a text, as integer, limited to 99."}],"url":"\/documentation\/oudscomponents\/oudsbadgecount","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSBadgeCount"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeCount","title":"OUDSBadgeCount","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSBadgeCount"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadgeStandard":{"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSBadgeStandard"}],"url":"\/documentation\/oudscomponents\/oudsbadgestandard","title":"OUDSBadgeStandard","navigatorTitle":[{"text":"OUDSBadgeStandard","kind":"identifier"}]},"component_tabBar_OrangeCompact_dark":{"type":"image","identifier":"component_tabBar_OrangeCompact_dark","alt":"A  tab bar component in dark mode without Liquid Glass effect and Orange Compact theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeCompact_dark.png"}]},"component_tabBar_LiquidGlass_OrangeCompact_dark":{"type":"image","