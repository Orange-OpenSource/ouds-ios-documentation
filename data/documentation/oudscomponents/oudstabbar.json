act theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeCompact_dark.png"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"kind":"symbol","title":"body","url":"\/documentation\/oudscomponents\/oudstabbar\/body","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","type":"topic","role":"symbol","abstract":[{"text":"Uses a native SwiftUI ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" populated with the given content where ","type":"text"},{"inlineContent":[{"text":"tab item","type":"text"}],"type":"emphasis"},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}]},"component_tabBar_Sosh_dark":{"identifier":"component_tabBar_Sosh_dark","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png","traits":["1x","light"]}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme","type":"image"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"component_tabBar_Orange_dark":{"identifier":"component_tabBar_Orange_dark","alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme","type":"image","variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png","traits":["1x","light"]}]},"component_tabBar_LiquidGlass_OrangeCompact_light":{"identifier":"component_tabBar_LiquidGlass_OrangeCompact_light","variants":[{"url":"\/images\/OUDSComponents\/c