{"abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/oudscomponents\/oudsradiopicker\/hidetabbar()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioPicker\/hideTabBar()"},"metadata":{"externalID":"s:7SwiftUI4ViewP14OUDSComponentsE10hideTabBarQryF::SYNTHESIZED::s:14OUDSComponents15OUDSRadioPickerV","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","platforms":[{"introducedAt":"16.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false}],"extendedModule":"SwiftUICore","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"hideTabBar()","modules":[{"name":"Components","relatedModules":["SwiftUICore"]}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view that hides the tab bar and propagates the hidden state to "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" overlay items."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" "},{"type":"text","text":"whenever a view inside a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" embedded in an "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"type":"codeVoice","code":"OUDSTabBar"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise for simple app "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" is enough."}]},{"type":"codeListing","syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioPicker"]]},"sections":[],"references":{"doc://OUDSComponents/documentation/OUDSComponents":{"title":"Components","url":"\/documentation\/oudscomponents","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","abstract":[{"type":"text","text":"The catalog of all