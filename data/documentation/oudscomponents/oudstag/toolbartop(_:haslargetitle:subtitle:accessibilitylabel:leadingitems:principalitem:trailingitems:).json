mponents\/documentation\/OUDSComponents\/OUDSToolBarItem"},{"kind":"text","text":"? = nil, "},{"kind":"attribute","text":"@"},{"text":"OUDSToolBarItemsBuilder","kind":"attribute","preciseIdentifier":"s:14OUDSComponents23OUDSToolBarItemsBuilderO","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarItemsBuilder"},{"text":" ","kind":"text"},{"text":"trailingItems","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" () -> [","kind":"text"},{"text":"OUDSToolBarItem","kind":"typeIdentifier","preciseIdentifier":"s:14OUDSComponents15OUDSToolBarItemV","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSToolBarItem"},{"text":"] = { [] }) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"title","content":[{"inlineContent":[{"text":"The toolbar title. Prefer a non-empty string.","type":"text"}],"type":"paragraph"}]},{"name":"hasLargeTitle","content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"false","type":"text"}]},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"text":" is not displayed for iOS < 26.","type":"text"}]}]},{"name":"subtitle","content":[{"type":"paragraph","inlineContent":[{"text":"Optional ","type":"text"},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"text":" displayed below the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"code":"principalItem","type":"codeVoice"},{"text":" is not ","type":"text"},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"type":"text","text":" by default, used if no large title nor principal item."}]}],"name":"accessibilityLabel"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"empty"}]},{"text":" by default.","type":"text"}]}],"name":"leadingItems"},{"content":[{"inlineContent":[{"type":"text","text":"The item displayed in the principal (center) position, "},{"type":"emphasis","inlineContent":[{"text":"nil","type":"text"}]},{"text":" by default. Only one item is supported.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If set, the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":" is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" is never displayed."}],"type":"paragraph"}],"name":"principalItem"},{"name":"trailingItems","content":[{"inlineContent":[{"text":"The items displayed on the trailing side, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"empty","type":"text"}]},{"text":" by default.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view which contains this "},{"type":"emphasis","inlineContent":[{"text":"top toolbar","type":"text"}]},{"type":"text","text":" must be placed inside a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise the top toolbar won’t appear.."}]},{"type":"paragraph","inlineContent":[{"text":"There must be only one ","type":"text"},{"inlineContent":[{"text":"top toolbar","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top toolbar"}]},{"type":"text","text":" can have an optional label vocalized by Voice Over for a particular case. Indeed, if there is no large title, and no element in principal item,"},{"type":"text","text":" "},{"type":"text","text":"the title and the subtitle can be hidden from Voice Over and the given accessibility label can be vocalized instead."},{"type":"text","text":" "},{"type":"text","text":"However it is better to bring meaningfull texts in your navigation instead of tricking the UI with Voice Over dedicated values."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/oudscomponents\/oudstag\/toolbartop(_:haslargetitle:subtitle:accessibilitylabel:leadingitems:principalitem:trailingitems:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Creates a top toolbar with a title, optional subtitle (for iOS 26+), leading, principal and trailing items.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag\/toolBarTop(_:hasLargeTitle:subtitle:accessibilityLabel:leadingItems:principalItem:trailingItems:)"},"metadata":{"role":"symbol","extendedModule":"SwiftUICore","externalID":"s:7SwiftUI4ViewP14OUDSComponentsE10toolBarTop_13hasLargeTitle8subtitle18accessibilityLabel12leadingItems13principalItem08trailingO0QrSS_SbSSSgALSayAD08OUDSToolfQ0VGycANSgAOyctF::SYNTHESIZED::s:14OUDSComponents7OUDSTagV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toolBarTop"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hasLargeTitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subtitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"exter