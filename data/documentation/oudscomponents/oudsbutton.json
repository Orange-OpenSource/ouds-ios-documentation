{"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/oudscomponents\/oudsbutton"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSButton"}],"languages":["swift"]}]},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Appearances","anchor":"Appearances","type":"heading"},{"inlineContent":[{"type":"text","text":"Five appearances are proposed for all layouts:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default (by default)","type":"text"}]},{"type":"text","text":": Default buttons are used for actions which are not mandatory or essential for the user."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"strong","type":"text"}]},{"text":": Should be singular and prominent, limited to one per view.","type":"text"},{"text":" ","type":"text"},{"text":"It should be reserved for the most critical action, such as “Next,” “Save,” “Submit,” etc. It is a “call for action”.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"brand","type":"text"}],"type":"strong"},{"text":": A brand primary color alternative to the ","type":"text"},{"inlineContent":[{"text":"strong","type":"text"}],"type":"emphasis"},{"text":" button.","type":"text"},{"text":" ","type":"text"},{"text":"To be used sparingly for high-value specific actions or to visually anchor a brand moment. Do not use it as the default primary button in your interfaces.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"code":"OUDSButton.Appearance.Brand","type":"codeVoice"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"minimal","type":"text"}],"type":"strong"},{"text":": Minimal buttons are commonly used for actions that are considered less crucial. They can be used independently or together with a strong button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"negative","type":"text"}]},{"text":": Negative buttons should be used sparingly to warn of a destructive action,","type":"text"},{"text":" ","type":"text"},{"text":"for example, delete or remove, typically resulting in the opening of a confirmation dialog.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"code":"OUDSButton.Appearance.Negative","type":"codeVoice"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\") { \/* the action to process *\/ }","    \/\/ With an image to keep raw without tint","    OUDSButton(image: OUDSImage(asset: Image(\"il_someImage\")), accessibilityLabel: \"Like\", renderingMode: .original) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative,  style: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    OUDSButton(text: \"Delete\", appearance: .negative) { \/* the action to process *\/ }","","    \/\/ A small loading button with indeterminate progress","    OUDSButton(text: \"Delete\", style: .loading(), size: .small) { \/* the action to process *\/ }","","    \/\/ A small loading button with a progress (i.e. percent of progress)","    OUDSButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance","    OUDSButton(text: \"Validate\", image: OUDSImage(asset: Image(\"ic_heart\")), appearance: .strong) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance and button taking full width","    OUDSButton(text: \"Validate\", image: OUDSImage(asset: Image(\"ic_heart\")), appearance: .strong, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ Localizable from bundle can also be used","    OUDSButton(LocalizedStringKey(\"validate_button\"), bundle: Bundle.module, appearance: .strong) { }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you need to flip your icon depending to the layout direction or not (e.g. if RTL mode lose semantics  \/ meanings):"}],"type":"paragraph"},{"syntax":"swift","code":["    @Environment(\\.layoutDirection) var layoutDirection","","    OUDSButton(text: \"Button\",","               image: OUDSImage(asset: Image(systemName: \"figure.handball\"), flipped: layoutDirection == .rightToLeft))"],"type":"codeListing"},{"level":2,"text":"Sizes","anchor":"Sizes","type":"heading"},{"inlineContent":[{"text":"Two sizes of button are proposed for all layouts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Default","type":"text"}]},{"type":"text","text":": This is the default size of the component. This size is used for the vast majority of applications."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":": This size can be particularly useful in an information-dense interface or in the construction of"},{"type":"text","text":" "},{"type":"text","text":"a template or component requiring the use of small elements (in an “List item” component, for example)."}]}]}],"type":"unorderedList"},{"anchor":"Styles","text":"Styles","level":2,"type":"heading"},{"inlineContent":[{"text":"Two style are available:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default (by default)","type":"text"}]},{"type":"text","text":": used in the normal usage of button. The aspect of the button changes for  states "},{"type":"emphasis","inlineContent":[{"text":"disabled","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"pressed","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"hovered","type":"text"}]},{"type":"text","text":" or normal (i.e. "},{"type":"emphasis","inlineContent":[{"text":"enabled","type":"text"}]},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"loading","type":"text"}]},{"text":": used after button was clicked (and probably data are requested before navigate to a next screen or get updated data, etc.).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Rounded layout","anchor":"Rounded-layout","type":"heading","level":2},{"inlineContent":[{"text":"Buttons can have rounded layouts to be favored in more emotional, immersive contexts or those tied to specific visual identities.","type":"text"},{"text":" ","type":"text"},{"text":"For standard or business-oriented journeys, keep the default corners.","type":"text"},{"text":" ","type":"text"},{"text":"This evolution addresses the need for flexibility in adapting the design to some brand contexts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To activate the rounded button behavior, set to true the ","type":"text"},{"code":"hasRoundedButtons","type":"codeVoice"},{"text":" values of the ","type":"text"},{"code":"Tuning","type":"codeVoice"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration (if the theme exposes this property at init).","type":"text"},{"text":" ","type":"text"},{"text":"Some themes do not have this flexibility like ","type":"text"},{"code":"SoshTheme","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WireframeTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Colored-surface","text":"Colored surface","type":"heading","level":2},{"inlineContent":[{"text":"If button is placed on colored surface using ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrome mode.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Remark: Today it is not allowed to place a Negative nor a Brand button on a colored surface."}],"type":"strong"}],"type":"paragraph"},{"anchor":"Specific-behavior","text":"Specific behavior","type":"heading","level":2},{"inlineContent":[{"text":"For accessibility reasons, if the system settings for reducing motion is enabled, the loading indicator does not move.","type":"text"},{"text":" ","type":"text"},{"text":"For ecodesign reasons, if the device is in low power mode, the loading indicator does not move.","type":"text"}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","type":"heading","level":2},{"inlineContent":[{"iden