{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSButton"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Layouts","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Actions"]},{"content":[{"anchor":"Appearances","text":"Appearances","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Five appearances are proposed for all layouts:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"default (by default)"}],"type":"strong"},{"text":": Default buttons are used for actions which are not mandatory or essential for the user.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"strong","type":"text"}]},{"text":": Should be singular and prominent, limited to one per view.","type":"text"},{"type":"text","text":" "},{"text":"It should be reserved for the most critical action, such as “Next,” “Save,” “Submit,” etc. It is a “call for action”.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"brand"}]},{"type":"text","text":": A brand primary color alternative to the "},{"type":"emphasis","inlineContent":[{"text":"strong","type":"text"}]},{"text":" button.","type":"text"},{"type":"text","text":" "},{"text":"To be used sparingly for high-value specific actions or to visually anchor a brand moment. Do not use it as the default primary button in your interfaces.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"code":"OUDSButton.Appearance.Brand","type":"codeVoice"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"minimal"}],"type":"strong"},{"text":": Minimal buttons are commonly used for actions that are considered less crucial. They can be used independently or together with a strong button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"negative"}],"type":"strong"},{"text":": Negative buttons should be used sparingly to warn of a destructive action,","type":"text"},{"text":" ","type":"text"},{"text":"for example, delete or remove, typically resulting in the opening of a confirmation dialog.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"code":"OUDSButton.Appearance.Negative","type":"codeVoice"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"code":["    \/\/ Icon only with default appearance","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    OUDSButton(image: OUDSImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\") { \/* the action to process *\/ }","    \/\/ With an image to keep raw without tint","    OUDSButton(image: OUDSImage(asset: Image(\"il_someImage\")), accessibilityLabel: \"Like\", renderingMode: .original) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    OUDSButton(text: \"Delete\", appearance: .negative,  style: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    OUDSButton(text: \"Delete\", appearance: .negative) { \/* the action to process *\/ }","","    \/\/ A small loading button","    OUDSButton(text: \"Delete\", style: .loading, size: .small) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance","    OUDSButton(text: \"Validate\", image: OUDSImage(asset: Image(\"ic_heart\")), appearance: .strong) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance and button taking full width","    OUDSButton(text: \"Validate\", image: OUDSImage(asset: Image(\"ic_heart\")), appearance: .strong, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ Localizable from bundle can also be used","    OUDSButton(LocalizedStringKey(\"validate_button\"), bundle: Bundle.module, appearance: .strong) { }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you need to flip your icon depending to the layout direction or not (e.g. if RTL mode lose semantics  \/ meanings):","type":"text"}],"type":"paragraph"},{"code":["    @Environment(\\.layoutDirection) var layoutDirection","","    OUDSButton(text: \"Button\",","               image: OUDSImage(asset: Image(systemName: \"figure.handball\"), flipped: layoutDirection == .rightToLeft))"],"syntax":"swift","type":"codeListing"},{"anchor":"Sizes","text":"Sizes","level":2,"type":"heading"},{"inlineContent":[{"text":"Two sizes of button are proposed for all layouts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Default"}],"type":"strong"},{"text":": This is the default size of the component. This size is used for the vast majority of applications.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"small"}],"type":"strong"},{"text":": This size can be particularly useful in an information-dense interface or in the construction of","type":"text"},{"text":" ","type":"text"},{"text":"a template or component requiring the use of small elements (in an “List item” component, for example).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Styles","text":"Styles","level":2,"type":"heading"},{"inlineContent":[{"text":"Two style are available:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"default (by default)"}],"type":"strong"},{"text":": used in the normal usage of button. The aspect of the button changes for  states ","type":"text"},{"inlineContent":[{"type":"text","text":"disabled"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"pressed"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"hovered"}],"type":"emphasis"},{"text":" or normal (i.e. ","type":"text"},{"inlineContent":[{"type":"text","text":"enabled"}],"type":"emphasis"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"loading"}],"type":"strong"},{"text":": used after button was clicked and probably data are requested before navigate to a next screen or get updated data.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Rounded-layout","text":"Rounded layout","level":2,"type":"heading"},{"inlineContent":[{"text":"Buttons can have rounded layouts to be favored in more emotional, immersive contexts or those tied to specific visual identities.","type":"text"},{"text":" ","type":"text"},{"text":"For standard or business-oriented journeys, keep the default corners.","type":"text"},{"text":" ","type":"text"},{"text":"This evolution addresses the need for flexibility in adapting the design to some brand contexts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To activate the rounded button behavior, set to true the ","type":"text"},{"code":"hasRoundedButtons","type":"codeVoice"},{"text":" values of the ","type":"text"},{"code":"Tuning","type":"codeVoice"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration (if the theme exposes this property at init).","type":"text"},{"text":" ","type":"text"},{"text":"Some themes do not have this flexibility like ","type":"text"},{"code":"SoshTheme","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WireframeTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Colored-surface","text":"Colored surface","level":2,"type":"heading"},{"inlineContent":[{"text":"If button is placed on colored surface using ","type":"text"},{"code":"OUDSColoredSurface","type":"codeVoice"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrome mode.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Remark: Today it is not allowed to place a Negative nor a Brand button on a colored surface."}],"type":"strong"}],"type":"paragraph"},{"anchor":"Specific-behavior","text":"Specific behavior","level":2,"type":"heading"},{"inlineContent":[{"text":"For accessibility reasons, if the system settings for reducing motion is enabled, the loading indicator does not move.","type":"text"},{"text":" ","type":"text"},{"text":"For ecodesign reasons, if the device is in low power mode, the loading indicator does not move.","type":"text"}],"type":"paragraph"},{"anchor":"Design-documentation","text":"Design documentation","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-button","type":"reference"}],"type":"paragraph"},{"anchor":"Themes-rendering","text":"Themes rendering","level":2,"type":"heading"},{"anchor":"Orange","text":"Orange","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_button_Orange","type":"image"}],"type":"paragraph"},{"anchor":"Orange-Compact","text":"Orange Compact","level":3,"type":"heading"},{"inlineContent":[{"identifier":"component_button_OrangeCompact