atforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolbar title. Prefer a non-empty string."}]}],"name":"title"},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"text":" must be displayed in large mode or not, ","type":"text"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"text":" by default. If large mode, the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" is not displayed for iOS < 26.","type":"text"}],"type":"paragraph"}],"name":"hasLargeTitle"},{"name":"subtitle","content":[{"inlineContent":[{"text":"Optional ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"text":" displayed below the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"text":" if iOS 26+, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"nil"}]},{"text":" by default. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Never displayed if ","type":"text"},{"type":"codeVoice","code":"principalItem"},{"text":" is not ","type":"text"},{"inlineContent":[{"type":"text","text":"nil"}],"type":"emphasis"},{"text":".","type":"text"}]}],"type":"paragraph"}]},{"name":"accessibilityLabel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional label vocalized by VoiceOver instead of the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" and the "},{"inlineContent":[{"text":"subtitle","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"nil","type":"text"}],"type":"emphasis"},{"text":" by default, used if no large title nor principal item.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The items displayed on the leading side, ",