{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","modules":[{"name":"Components"}],"platforms":[{"beta":false,"introducedAt":"15.0","unavailable":false,"deprecated":false,"name":"iOS"},{"beta":false,"introducedAt":"13.0","unavailable":false,"deprecated":false,"name":"macOS"},{"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false,"deprecated":false}],"role":"symbol","externalID":"s:14OUDSComponents15OUDSRadioPickerV","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSRadioPicker"}],"title":"OUDSRadioPicker","navigatorTitle":[{"kind":"identifier","text":"OUDSRadioPicker"}]},"abstract":[{"text":"A picker allowing to expose several radio buttons and choose only one within the others.","type":"text"},{"text":" ","type":"text"},{"text":"Each radio button contains a “tag”, i.e. a supposed to be unique value.","type":"text"},{"text":" ","type":"text"},{"text":"The picker will expose the choosen value through this “tag”.","type":"text"},{"text":" ","type":"text"},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioItem","isActive":true},{"text":" (divider, read only and error mode, layout and outlined)","type":"text"}],"identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioPicker","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioPicker\/init(selection:radios:placement:isOutlined:isReversed:isError:isReadOnly:hasDivider:itemsSpacing:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/