","text":" to your own theme implementation:"}]},{"type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(accordion: CustomAccordionComponentTokensProvider())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}]},{"type":"codeListing","code":["    OrangeTheme(accordion: CustomAccordionComponentTokensProvider())"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}]},{"type":"codeListing","code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeSizeSemanticTokensProvider for sizes","    \/\/ - OrangeThemeSpaceSemanticTokensProvider for spaces","    let accordionComponentTokensProvider = OrangeThemeAccordionComponentTokensProvider()","","    \/\/ Or use your own semantic tokens providers","    let accordionComponentTokensProvider = OrangeThemeAccordionComponentTokensProvider(","                    sizes: CustomSizeSemanticTokensProvider(),","                    spaces: CustomSpaceSemanticTokensProvider())"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}],"name":"Since"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange"]]},"references":{"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeAccordionComponentTokensProvider/spaces":{"fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"spaces","kind":"identifier"},{"text":": any ","kind":"text"},{"text":"AllSpaceSemanticTokensProvider","preciseIdentifier":"s:18OUDSThemesContract30AllSpaceSemanticTokensProviderP","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider\/spaces","url