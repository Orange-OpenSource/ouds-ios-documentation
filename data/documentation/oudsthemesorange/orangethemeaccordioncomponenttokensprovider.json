entation to use.","type":"text"},{"text":" ","type":"text"},{"text":"Custom themes can use subclass of ","type":"text"},{"type":"reference","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider","isActive":true},{"text":" and apply the provider they need.","type":"text"},{"text":" ","type":"text"},{"text":"It implements also the protocol ","type":"text"},{"type":"codeVoice","code":"AccordionComponentTokens"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AccordionFaqComponentTokens"},{"text":" ","type":"text"},{"text":"so as to expose the component tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"accordions"}],"type":"emphasis"},{"text":" through any ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":".","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Accordions"}],"type":"emphasis"},{"text":" components tokens are defined with semantic tokens spaces (from ","type":"text"},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and sizes (from ","type":"text"},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"text":").","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeAccordionComponentTokensProvider"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"code":["    \/\/ Define your own provider for accordion component tokens","    \/\/ by inheriting from existing provider","    class CustomAccordionComponentTokensProvider: OrangeThemeAccordionComponentTokensProvider {","","        \/\/ Then override the accordion component tokens you want.","","        override var spacePaddingBlockBottomExpandContainerDefault: SpaceSemanticToken