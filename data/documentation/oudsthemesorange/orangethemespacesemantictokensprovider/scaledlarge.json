UDSThemesOrange/documentation/OUDSThemesOrange":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","images":[{"type":"icon","identifier":"ic_theme_orange.png"}],"type":"topic","abstract":[{"type":"text","text":"The Orange theme overrides some tokens from the basic "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example."}],"role":"collection","kind":"symbol","title":"Theme Orange","url":"\/documentation\/oudsthemesorange"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleSpaceSemanticToken":{"navigatorTitle":[{"kind":"identifier","text":"MultipleSpaceSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSpaceSemanticToken","type":"topic","abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"DimensionRawToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from Figma inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a space token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSpaceSemanticToken","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleSpaceSemanticToken"}],"role":"symbol","kind":"symbol","title":"MultipleSpaceSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplespacesemantictoken"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSpaceSemanticTokensProvider/scaledLarge":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider\/scaledLarge","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaledLarge"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleSpaceSemanticToken","kind":"typeIdentifier","text":"MultipleSpaceSemanticToken"}],"role":"symbol","kind":"symbol","title":"scaledLarge","url":"\/documentation\/oudsthemesorange\/orangethemespacesemantictokensprovider\/scaledlarge"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSpaceSemanticTokensProvider":{"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeSpaceSemanticTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider","type":"topic","abstract":[{"text":"A class which wraps all ","type":"text"},{"inlineContent":[{"type":"text","text":"space semantic tokens"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"multiple"}],"type":"emphasis"},{"text":" or not, and expose them.","type":"text"},{"text":" ","type":"text"},{"text":"This provider should be integrated as a ","type":"text"},{"code":"AllSpaceSemanticTokens","type":"codeVoice"},{"text":" implementation inside ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" so as to provide","type":"text"},{"text":" ","type":"text"},{"text":"all tokens to the users. It helps users to override some of the tokens and assign them to an ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" implementation to use.","type":"text"},{"text":" ","type":"text"},{"text":"Closed tokens of dimensions (","type":"text"},{"code":"AllDimensionSemanticTokensProvider","type":"codeVoice"},{"text":") are used so as to keep consistancy beweetn Figma specifications and library for