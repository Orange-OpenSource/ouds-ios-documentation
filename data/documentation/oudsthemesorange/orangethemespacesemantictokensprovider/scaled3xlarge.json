mantic\/MultipleSpaceSemanticToken","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSpaceSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplespacesemantictoken","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSpaceSemanticTokensProvider":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeSpaceSemanticTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeSpaceSemanticTokensProvider"}],"kind":"symbol","url":"\/documentation\/oudsthemesorange\/orangethemespacesemantictokensprovider","title":"OrangeThemeSpaceSemanticTokensProvider","abstract":[{"text":"A class which wraps all ","type":"text"},{"type":"strong","inlineContent":[{"text":"space semantic tokens","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"text":" or not, and expose them.","type":"text"},{"text":" ","type":"text"},{"text":"This provider should be integrated as a ","type":"text"},{"type":"codeVoice","code":"AllSpaceSemanticTokens"},{"text":" implementation inside ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" so as to provide","type":"text"},{"text":" ","type":"text"},{"text":"all tokens to the users. It helps users to override some of the tokens and assign them to an ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" implementation to use.","type":"text"},{"text":" ","type":"text"},{"text":"Closed tokens of dimensions (","type":"text"},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"text":") are used so as to keep consistancy beweetn Figma specifications and library for developers.","type":"text"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider","type":"topic","role":"symbol"},"doc://OUDSThemesOrange/docu