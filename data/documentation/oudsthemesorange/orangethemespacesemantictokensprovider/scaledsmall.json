UDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleSpaceSemanticToken":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleSpaceSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"MultipleSpaceSemanticToken","kind":"identifier"}],"title":"MultipleSpaceSemanticToken","abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"DimensionRawToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from Figma inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a space token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSpaceSemanticToken","isActive":true},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/oudstokenssemantic\/multiplespacesemantictoken","kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSpaceSemanticToken"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSpaceSemanticTokensProvider":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeSpaceSemanticTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"OrangeThemeSpaceSemanticTokensProvider","kind":"identifier"}],"title":"OrangeThemeSpaceSemanticTokensProvider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"text":"space semantic tokens","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllSpaceSemanticTokens"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Closed tokens of dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") are used so as to keep consistancy beweetn Figma specifications and library for developers."}],"type":"topic","url":"\/documentation\/oudsthemesorange\/orangethemespacesemantictokensprovider","kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSpaceSemanticTokensProvider/scaledSmall":{"title":"scaledSmall","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider\/scaledSmall","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaledSmall"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleSpaceSemanticToken","text":"MultipleSpaceSemanticToken"}],"role":"symbol","abstract":[],"url":"\/documentation\/oudsthemesorange\/orangethemespacesemantictokensprovider\/scaledsmall"},"ic_theme_orange.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png"}],"identifier":"ic_theme_orange.png","alt":null,"type":"image"},"doc://OUDSThemesOrange/documentation/OUDSThemesOran