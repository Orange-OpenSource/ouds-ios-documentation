{"abstract":[{"type":"text","text":"Semantic token used for extremely large adaptive spacings that vary according to the breakpoint."},{"type":"text","text":" "},{"type":"text","text":"To be used as auto-layout variables to delineate areas or build different elements (cards, push, carousel)."},{"type":"text","text":" "},{"type":"text","text":"This value is for tablet, it is strictly prohibited to change size references between different breakpoints."},{"type":"text","text":" "},{"type":"text","text":"Has for value token dimensions._3xlarge (= 56)"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"extendedModule":"OUDSThemesOrange","title":"scaled3xlargeTablet","modules":[{"name":"Theme Orange"}],"externalID":"s:16OUDSThemesOrange0B32ThemeSpaceSemanticTokensProviderC19scaled3xlargeTabletSdvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaled3xlargeTablet","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSTokensSemantic05SpaceB5Tokena","text":"SpaceSemanticToken","kind":"typeIdentifier"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider"]]},"sections":[],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSpaceSemanticTokensProvider\/scaled3xlargeTablet","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaled3xlargeTablet"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/SpaceSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic05SpaceB5Tokena","text":"SpaceS