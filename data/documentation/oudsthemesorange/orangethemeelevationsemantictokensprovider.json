ntic tokens you want, using the elevation raw tokens available","","        override var stickyEmphasized: ElevationCompositeSemanticToken {","            ElevationCompositeSemanticToken(ElevationRawTokens.bottom_4_600)","        }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then, you can give this ","type":"text"},{"code":"CustomElevationTokensProvider","type":"codeVoice"},{"text":" to your own theme implementation:","type":"text"}]},{"type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(elevations: CustomElevationTokensProvider())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"or to an already existing theme for example:","type":"text"}]},{"type":"codeListing","code":["    OrangeTheme(elevations: CustomElevationTokensProvider())"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"0.8.0","type":"text"}]}],"name":"Since","style":"note"}],"kind":"content"}],"references":{"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"navigatorTitle":[{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens","title":"ElevationCompositeSemanticTokens","abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"text":", but only ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"composite tokens"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"There are splitted and not declared in ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","type":"reference","isActive":true},{"text":" as the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"text":" tool parsing ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"text":" JSON to Swift code is not able to manage them.","type":"text"},{"text":" ","type":"text"},{"text":"Thus we need to declare them in another file to prevent them to be erased.","type":"text"},{"text":" ","type":"text"},{"text":"It declares in fact box shadows effects.","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","type":"topic","role":"symbol"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeElevationSemanticTokensProvider/ElevationCompositeSemanticTokens-Implementations":{"role":"collectionGroup","kind":"article","url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider\/elevationcompositesemantictokens-implementations","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider\/ElevationCompositeSemanticTokens-Implementations","title":"ElevationCompositeSemanticTokens Implementations","abstract":[],"type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationMultipleSemanticTokens":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationMultipleSemanticTokens"}],"navigatorTitle":[{"kind":"identifier","text":"ElevationMultipleSemanticTokens"}],"kind":"symbol","url":"\/documentation\/oudstokenssemantic\/elevationmultiplesemantictokens","title":"ElevationMultipleSemanticTokens","abstract":[{"text":"This is a group of semantic tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"elevations"}],"type":"strong"},{"text":" but multiple so as to pack light and dark variants","type":"text"},{"text":" ","type":"text"},{"text":"It wraps elevation colors as tokens.