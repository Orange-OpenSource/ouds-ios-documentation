"text"},{"inlineContent":[{"text":"tokenator","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted.","type":"text"},{"text":" ","type":"text"},{"text":"Any elevation semantic token must be declared there (except ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","type":"reference","isActive":true},{"text":")","type":"text"}],"navigatorTitle":[{"text":"ElevationSemanticTokens","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/elevationsemantictokens","title":"ElevationSemanticTokens","kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationColorSemanticToken":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationColorSemanticToken","role":"symbol","navigatorTitle":[{"text":"ElevationColorSemanticToken","kind":"identifier"}],"title":"ElevationColorSemanticToken","abstract":[{"text":"Basically an elevation color semantic token, used mainly for shadow colors, is a color semantic token.","type":"text"}],"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationColorSemanticToken","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/elevationcolorsemantictoken","type":"topic"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/TokensProvider":{"url":"\/documentation\/oudsthemescontract\/tokensprovider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokensProvider"}],"title":"TokensProvider","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/TokensProvider","role":"symbol","abstract":[{"text":"Protocol to add to any