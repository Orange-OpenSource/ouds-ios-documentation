{"metadata":{"role":"collectionGroup","title":"TypographyComponentTokens Implementations","roleHeading":"API Collection","modules":[{"name":"Theme Orange"}]},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/colorContentMarker","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/headingLargeMarker","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/spacePaddingBlockBottomHeadingLargeMarker","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/spacePaddingBlockTopHeadingLargeMarker"],"anchor":"Instance-Properties","generated":true}],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/TypographyComponentTokens-Implementations","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/oudsthemesorange\/orangethemetypographycomponenttokensprovider\/typographycomponenttokens-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeTypographyComponentTokensProvider":{"title":"OrangeThemeTypographyComponentTokensProvider","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeTypographyComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/oudsthemesorange\/orangethemetypographycomponenttokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"