 any "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Typography","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeTypographyComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeTypographyComponentTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemetypographycomponenttokensprovider","role":"symbol","kind":"symbol","title":"OrangeThemeTypographyComponentTokensProvider","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","role":"collection","navigatorTitle":[{"text":"Theme Orange","kind":"text"}],"abstract":[{"text":"The Orange theme overrides some tokens from the basic ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example.","type":"text"}],"kind":"symbol","title":"Theme Orange","images":[{"identifier":"ic_theme_orange.png","type":"icon"}],"url":"\/documentation\/oudsthemesorange","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeTypographyComponentTokensProvider/spacePaddingBlockBottomHeadingLargeMarker":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeTypographyComponentTokensProvider\/spacePaddingBlockBottomHeadingLargeMarker","role":"symbol","abstract":[{"text":"Has for value token spaces.paddingBlock4xsmall (= 2)","type":"text"}],"kind":"symbol","title":"spacePaddingBlockB