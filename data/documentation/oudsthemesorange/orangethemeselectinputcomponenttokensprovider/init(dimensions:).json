ut"}]},{"type":"text","text":" components tokens are defined with semantic tokens of dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeSelectInputComponentTokensProvider"}],"role":"symbol","kind":"symbol","title":"OrangeThemeSelectInputComponentTokensProvider","url":"\/documentation\/oudsthemesorange\/orangethemeselectinputcomponenttokensprovider"}}}