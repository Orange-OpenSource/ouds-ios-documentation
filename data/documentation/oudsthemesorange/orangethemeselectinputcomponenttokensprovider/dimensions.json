","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Select input","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of dimensions (from "},{"code":"AllDimensionSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")"}],"role":"symbol","type":"topic","title":"OrangeThemeSelectInputComponentTokensProvider","kind":"symbol"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/AllDimensionSemanticTokensProvider":{"title":"AllDimensionSemanticTokensProvider","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/oudsthemescontract\/alldimensionsemantictokensprovider","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/AllDimensionSemanticTokensProvider","navigatorTitle":[{"kind":"identifier","text":"AllDimensionSemanticTokensProvider"}],"abstract":[{"text":"Something which provides all semantic tokens of _","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllDimensionSemanticTokensProvider"}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"title":"Theme Orange","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/oudsthemesorange","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","images":[{"identifier":"ic_theme_orange.png","type":"icon"}],"abstract":[{"text":"The Orange theme overrides some tokens from the basic ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example.","type":"text"}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSelectInputComponentTokensProvider/dimensions":{"url":"\/documentation\/oudsthemesorange\/orangethemeselectinputcomponenttokensprovider\/dimensions","kind":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentatio