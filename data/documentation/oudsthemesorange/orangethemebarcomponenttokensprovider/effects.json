ensProvider","type":"codeVoice"},{"type":"text","text":")."}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeBarComponentTokensProvider","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeBarComponentTokensProvider"}],"kind":"symbol","title":"OrangeThemeBarComponentTokensProvider","navigatorTitle":[{"kind":"identifier","text":"OrangeThemeBarComponentTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemebarcomponenttokensprovider"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/AllEffectSemanticTokensProvider":{"kind":"symbol","navigatorTitle":[{"text":"AllEffectSemanticTokensProvider","kind":"identifier"}],"url":"\/documentation\/oudsthemescontract\/alleffectsemantictokensprovider","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/AllEffectSemanticTokensProvider","abstract":[{"type":"text","text":"Something which provides all semantic tokens of effects"}],"type":"topic","role":"symbol","title":"AllEffectSemanticTokensProvider","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllEffectSemanticTokensProvider","kind":"identifier"}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeBarComponentTokensProvider/effects":{"url":"\/documentation\/oudsthemesorange\/orangethemebarcomponenttokensprovider\/effects","kind":"symbol","type":"topic","title":"effects","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effects"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:18OUDSThemesContract31AllEffectSemanticTokensProviderP","kind":"typeIdentifier","text":"AllEffectSemanticTokensProvider"}],"abstract":[{"type":"text","text":"Provider of effects semantic tokens to use for bar effects"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeB