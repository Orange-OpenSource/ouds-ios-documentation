ge","kind":"text"}],"abstract":[{"text":"The Orange theme overrides some tokens from the basic ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example.","type":"text"}],"kind":"symbol","title":"Theme Orange","images":[{"identifier":"ic_theme_orange.png","type":"icon"}],"url":"\/documentation\/oudsthemesorange","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSkeletonComponentTokensProvider/colorGradientStartEnd":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSkeletonComponentTokensProvider\/colorGradientStartEnd","url":"\/documentation\/oudsthemesorange\/orangethemeskeletoncomponenttokensprovider\/colorgradientstartend","type":"topic","abstract":[{"type":"text","text":"Has for value token colors.opacityTransparent (= light: “#00000000” \/ dark: “#FFFFFF00”)"}],"title":"colorGradientStartEnd","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorGradientStartEnd","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"typeIdentifier","preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleColorSemanticToken"}]}}}