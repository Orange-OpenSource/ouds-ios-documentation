es:accordion:alert:badge:bar:bulletList:button:checkbox:chip:divider:icon:link:listItem:pinCodeInput:progressIndicator:quantityInput:radioButton:selectInput:skeleton:switch:tag:inputTag:textArea:textInput:typography:resourcesBundle:name:fontFamily:tuning:)","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeTheme\/init(borders:colors:colorModes:colorsCharts:colorsDecorative:effects:elevations:fonts:grids:opacities:dimensions:sizes:spaces:accordion:alert:badge:bar:bulletList:button:checkbox:chip:divider:icon:link:listItem:pinCodeInput:progressIndicator:quantityInput:radioButton:selectInput:skeleton:switch:tag:inputTag:textArea:textInput:typography:resourcesBundle:name:fontFamily:tuning:)","abstract":[{"text":"Constructor of the Orange theme.","type":"text"},{"text":" ","type":"text"},{"text":"It needs several tokens providers for semantic tokens and component tokens.","type":"text"},{"text":" ","type":"text"},{"text":"If a nil token provider is given, the default version associated fo the theme is used.","type":"text"}],"url":"\/documentation\/oudsthemesorange\/orangetheme\/init(borders:colors:colormodes:colorscharts:colorsdecorative:effects:elevations:fonts:grids:opacities:dimensions:sizes:spaces:accordion:alert:badge:bar:bulletlist:button:checkbox:chip:divider:icon:link:listitem:pincodeinput:progressindicato-7vwms","kind":"symbol","type":"topic","role":"symbol"},"doc://OUDSThemesOrange/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/OUDSThemesOrange\/s16SendableMetatypeP"},"doc://OUDSThemesOrange/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/OUDSThemesOrange\/SQ"},"ic_theme_orange.png":{"alt":null,"variants":[{"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png","traits":["1x","light"]}],"type":"image","identifier":"ic_theme_orange.png"},"https://brand.orange.com/en/brand-basics/typography":{"titleInlineContent":[{"text":"Orange Brand website (authenticat