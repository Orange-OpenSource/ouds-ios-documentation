fier"},{"text":", ","kind":"text"},{"text":"fontFamily","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSTokensSemantic010FontFamilyB5Tokena","text":"FontFamilySemanticToken","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tuning","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSThemesContract6Tuninga","text":"Tuning","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(borders:colors:colorModes:colorsCharts:colorsDecorative:effects:elevations:fonts:grids:opacities:dimensions:sizes:spaces:accordion:alert:badge:bar:bulletList:button:checkbox:chip:divider:icon:link:listItem:pinCodeInput:progressIndicator:quantityInput:radioButton:selectInput:skeleton:switch:tag:inputTag:textArea:textInput:typography:resourcesBundle:name:fontFamily:tuning:)","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeTheme\/init(borders:colors:colorModes:colorsCharts:colorsDecorative:effects:elevations:fonts:grids:opacities:dimensions:sizes:spaces:accordion:alert:badge:bar:bulletList:button:checkbox:chip:divider:icon:link:listItem:pinCodeInput:progressIndicator:quantityInput:radioButton:selectInput:skeleton:switch:tag:inputTag:textArea:textInput:typography:resourcesBundle:name:fontFamily:tuning:)","url":"\/documentation\/oudsthemesorange\/orangetheme\/init(borders:colors:colormodes:colorscharts:colorsdecorative:effects:elevations:fonts:grids:opacities:dimensions:sizes:spaces:accordion:alert:badge:bar:bulletlist:button:checkbox:chip:divider:icon:link:listitem:pincodeinput:progressindicato-7vwms","kind":"symbol","abstract":[{"text":"Constructor of the Orange theme.","type":"text"},{"text":" ","type":"text"},{"text":"It needs several tokens providers for semantic tokens and component tokens.","type":"text"},{"text":" ","type":"text"},{"text":"If a nil token provider is given, the default version associated fo the theme is used.","type":"text"}]},"doc://OUDSThem