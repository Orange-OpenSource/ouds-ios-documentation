:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(icon: CustomIconComponentTokensProvider())","    }","}"]},{"inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    OrangeTheme(icon: CustomIconComponentTokensProvider())"]},{"inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeColorSemanticTokensProvider for colors","    let iconComponentTokensProvider = OrangeThemeIconComponentTokensProvider()","","    \/\/ Or use your color semantic tokens providers (or only some)","    let iconComponentTokensProvider = OrangeThemeIconComponentTokensProvider(","                                                colors: CustomColorSemanticTokensProvider())"]},{"content":[{"inlineContent":[{"type":"text","text":"0.20.0"}],"type":"paragraph"}],"name":"Since","style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/oudsthemesorange\/orangethemeiconcomponenttokensprovider"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OUDSThemesOrange/s9EscapableP":{"identifier":"doc:\/\/OUDSThemesOrange\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeIconComponentTokensProvider":{"role":"symbol","navigatorTitle":[{"text":"OrangeThemeIconComponentTokensProvider","kind":"identifier"}],"title":"OrangeThemeIconComponentTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeIconComponentTokensProvider","kind":"identifier"}],"abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"text":"component  tokens 