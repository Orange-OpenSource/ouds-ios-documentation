 want.","","        override var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSmall }","","        \/\/ ...","    }","","    \/\/ Or define your own provider from scratch","    class CustomBulletListComponentTokensProvider: BulletListComponentTokens {","","        \/\/ And implement hunders of tokens.","        \/\/ You are allowed to give semantic tokens providers if you want to define values.","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, you can give this "},{"type":"codeVoice","code":"CustomBulletListComponentTokensProvider"},{"type":"text","text":" to your own theme implementation:"}]},{"type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(bulletList: CustomBulletListComponentTokensProvider())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}]},{"type":"codeListing","code":["    OrangeTheme(bulletList: CustomBulletListComponentTokensProvider())"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}]},{"type":"codeListing","code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeSpaceSemanticTokensProvider for spaces","    let bulletListComponentTokensProvider = OrangeThemeBulletListComponentTokensProvider()","","    \/\/ Or use your own size, color and space semantic tokens providers (or only some)","    let bulletListComponentTokensProvider = OrangeThemeBulletListComponentTokensProvider(","                                                spaces: CustomSpaceSemanticTokensProvider())"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"0.10.0"}],"type":"paragraph"}],"type":"aside","name":"Since","style":"note"}]}],"kind":"symbol","metadata":{"externalID":"s:16OUDSThemesOrange0B38ThemeBulletListComponentTokensP