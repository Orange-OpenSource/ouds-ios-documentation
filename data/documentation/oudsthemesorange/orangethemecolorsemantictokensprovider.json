unctionalScarlet600)","        }","}"]},{"inlineContent":[{"type":"text","text":"Then, you can give this "},{"type":"codeVoice","code":"CustomColorTokensProvider"},{"type":"text","text":" to your own theme implementation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(colors: CustomColorTokensProvider())","    }","}"]},{"inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    OrangeTheme(colors: CustomColorTokensProvider())"]},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"0.8.0","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://OUDSThemesContract/documentation/OUDSThemesContract/TokensProvider":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokensProvider","kind":"identifier"}],"title":"TokensProvider","role":"symbol","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/TokensProvider","type":"topic","url":"\/documentation\/oudsthemescontract\/tokensprovider","navigatorTitle":[{"text":"TokensProvider","kind":"identifier"}],"abstract":[{"type":"text","text":"Protocol to add to any semantic or component tokens provider so as to be gather with all providers and given to the theme for initialization"}],"kind":"symbol"},"doc://OUDSThemesOrange/s9EscapableP":{"identifier":"doc:\/\/OUDSThemesOrange\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeColorSemanticTokensProvider/ColorMultipleSemanticTokens-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeColorSemanticTokensProvider\/ColorMultipleSemanticTokens-Implementations","title":"ColorMultipleSemanticTokens Implementations","kind":"ar