.init(colors: CustomColorTokensProvider())","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}],"type":"paragraph"},{"syntax":"swift","code":["    OrangeTheme(colors: CustomColorTokensProvider())"],"type":"codeListing"},{"style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"0.8.0","type":"text"}]}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudsthemesorange\/orangethemecolorsemantictokensprovider"]}],"abstract":[{"text":"A class which wraps all ","type":"text"},{"inlineContent":[{"type":"text","text":"color semantic tokens"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"multiple"}],"type":"emphasis"},{"text":" or not, and expose them.","type":"text"},{"text":" ","type":"text"},{"text":"This provider should be integrated as a ","type":"text"},{"code":"AllColorSemanticTokensProvider","type":"codeVoice"},{"text":" implementation inside ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" so as to provide","type":"text"},{"text":" ","type":"text"},{"text":"all tokens to the users. It helps users to override some of the tokens and assign them to an ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" implementation to use.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeColorSemanticTokensProvider","kind":"identifier"}],"role":"symbol","externalID":"s:16OUDSThemesOrange0B32ThemeColorSemanticTokensProviderC","navigatorTitle":[{"kind":"identifier","text":"OrangeThemeColorSemanticTokensProvider"}],"roleHeading":"Class","title":"OrangeThemeColorSemanticTokensProvider","modules":[{"name":"Theme Orange"}],"symbolKind":"class"},"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeColorSemantic