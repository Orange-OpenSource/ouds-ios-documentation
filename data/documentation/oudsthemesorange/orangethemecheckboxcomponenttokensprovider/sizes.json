oxComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeCheckboxComponentTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeCheckboxComponentTokensProvider","role":"symbol","kind":"symbol","title":"OrangeThemeCheckboxComponentTokensProvider"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeCheckboxComponentTokensProvider/sizes":{"url":"\/documentation\/oudsthemesorange\/orangethemecheckboxcomponenttokensprovider\/sizes","abstract":[{"type":"text","text":"Provider of size semantic tokens to use for checkbox sizes"}],"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sizes"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSThemesContract29AllSizeSemanticTokensProviderP","text":"AllSizeSemanticTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeCheckboxComponentTokensProvider\/sizes","role":"symbol","kind":"symbol","title":"sizes"}}}