DimensionSemanticTokensProvider","type":"codeVoice"},{"text":").","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeListItemComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeListItemComponentTokensProvider"}],"title":"OrangeThemeListItemComponentTokensProvider"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/SizeSemanticToken":{"navigatorTitle":[{"kind":"identifier","text":"SizeSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/SizeSemanticToken","type":"topic","abstract":[{"type":"text","text":"Basically a size semantic token, used for width and height values, is a _ raw token,"},{"type":"text","text":" "},{"type":"text","text":"it has the same final type, to keep grammar clean and clear with design system grammar."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"SizeSemanticToken"}],"role":"symbol","url":"\/documentation\/oudstokenssemantic\/sizesemantictoken","kind":"symbol","title":"SizeSemanticToken"},"ic_theme_orange.png":{"identifier":"ic_theme_orange.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png"}],"type":"image","alt":null}}}