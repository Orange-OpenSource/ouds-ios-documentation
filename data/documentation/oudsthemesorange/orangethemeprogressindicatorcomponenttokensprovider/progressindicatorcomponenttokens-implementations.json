ong","inlineContent":[{"text":"component  tokens of progress indicators","type":"text"}]},{"text":" for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"circular progress","type":"text"}]},{"text":"  and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"linear progress","type":"text"}]},{"text":"components.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"code":"AllProgressIndicatorComponentTokensProvider","type":"codeVoice"},{"type":"text","text":" implementation inside "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Custom themes can use subclass of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider"},{"type":"text","text":" and apply the provider they need."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"code":"ProgressIndicatorComponentTokens","type":"codeVoice"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"text":"progress indicators","type":"text"}]},{"text":" through any ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Progress indicators","type":"text"}]},{"text":" components tokens are defined with semantic tokens spaces (from ","type":"text"},{"code":"AllSpaceSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"), sizes (from "},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"borders (from "},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"), colors (from "},{"code":"AllColorSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":") and dimensions"},{"type":"text","text":" "},{"type":"text","text":"(from "},{"code":"AllDimensionSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")."}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"kind":"symbol","title":"OrangeThemeProgressIndicatorComponentTokensProvider","navigatorTitle":[{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemeprogressindicatorcomponenttokensprovider"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeProgressIndicatorComponentTokensProvider/spacePaddingBlock":{"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spacePaddingBlock","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic05SpaceB5Tokena"}],"role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider\/spacePaddingBlock","abstract":[{"text":"Has for value token spaces.paddingBlockXsmall (= 8)","type":"text"}],"type":"topic","url":"\/documentation\/oudsthemesorange\/orangethemeprogressindicatorcomponenttokensprovider\/spacepaddingblock","title":"spacePaddingBlock"},"ic_theme