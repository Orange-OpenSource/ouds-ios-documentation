ion/OUDSThemesOrange/OrangeThemeProgressIndicatorComponentTokensProvider":{"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider","type":"topic","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"type":"text","text":"component  tokens of progress indicators"}],"type":"strong"},{"type":"text","text":" for "},{"inlineContent":[{"type":"text","text":"circular progress"}],"type":"emphasis"},{"type":"text","text":"  and "},{"inlineContent":[{"type":"text","text":"linear progress"}],"type":"emphasis"},{"type":"text","text":"components."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllProgressIndicatorComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Custom themes can use subclass of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider"},{"type":"text","text":" and apply the provider they need."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"ProgressIndicatorComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"type":"text","text":"progress indicators"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Progress indicators"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"), sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":"), colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":") and dimensions"},{"type":"text","text":" "},{"type":"text","text":"(from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"role":"symbol","kind":"symbol","title":"OrangeThemeProgressIndicatorComponentTokensProvider","url":"\/documentation\/oudsthemesorange\/orangethemeprogressindicatorcomponenttokensprovider"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/BorderRadiusSemanticToken":{"navigatorTitle":[{"kind":"identifier","text":"BorderRadiusSemanticToken"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/BorderRadiusSemanticToken","type":"topic","abstract":[{"type":"text","text":"Type alias precising "},{"type":"codeVoice","code":"BorderRadiusRawToken"},{"type":"text","text":" is used as a value of this "},{"inlineContent":[{"type":"text","text":"border raw semantic token"}],"type":"strong"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"BorderRadiusSemanticToken"}],"role":"symbol","kind":"symbol","title":"BorderRadiusSemanticToken","url":"\/documentation\/oudstokenssemantic\/borderradiussemantictoken"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeProgressIndicatorComponentTokensProvider/borderRadiusRounded":{"title":"borderRadiusRounded","url":"\/documentation\/oudsthemesorange\/orangethemeprogressindicatorcomponenttokensprovider\/borderradiusrounded","abstract":[{"text":"Has for value token borders.radiusPill (= 2000)","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeProgressIndicatorComponentTokensProvider\/borderRadiusRounded","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"borderRadiusRounded","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BorderRadiusSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic012BorderRadiusB5Tokena","kind":"typeIdentifier"}],"type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","images":[{"type":"icon","identifier":"ic_theme_orange.png"}],"type":"topic","abstract":[{"type":"text","text":"The Orange theme overrides some tokens from the basic "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example."}],"role":"collection","kind":"symbol","title":"Theme Orange","url":"\/documentation\/oudsthemesorange"},"ic_theme_orange.png":{"alt":null,"type":"image","identifier":"ic_theme_orange.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png"}]}}}