mponentTokensProvider","type":"reference","isActive":true},{"type":"text","text":" and apply the provider they need."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"AccordionComponentTokens"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AccordionFaqComponentTokens"},{"type":"text","text":" "},{"type":"text","text":"so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"accordions"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Accordions"}]},{"type":"text","text":" components tokens are defined with semantic tokens spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"text":").","type":"text"}],"kind":"symbol","role":"symbol","title":"OrangeThemeAccordionComponentTokensProvider","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeAccordionComponentTokensProvider/spaceColumnGapMobile":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spaceColumnGapMobile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic05SpaceB5Tokena"}],"url":"\/documentation\/oudsthemesorange\/orangethemeaccordioncomponenttokensprovider\/spacecolumngapmobile","kind":"symbol","abstract":[{"text":"Has for value token spaces.columnGapMedium (= 12)","type":"text"}],"role":"symbol","title":"spaceColumnGapMobile","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange