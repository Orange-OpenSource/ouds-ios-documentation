":"text"},{"code":"AccordionComponentTokens","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AccordionFaqComponentTokens","type":"codeVoice"},{"text":" ","type":"text"},{"text":"so as to expose the component tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"accordions"}],"type":"emphasis"},{"text":" through any ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Accordions"}],"type":"emphasis"},{"text":" components tokens are defined with semantic tokens spaces (from ","type":"text"},{"code":"AllSpaceSemanticTokensProvider","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and sizes (from ","type":"text"},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"text":").","type":"text"}],"kind":"symbol","url":"\/documentation\/oudsthemesorange\/orangethemeaccordioncomponenttokensprovider","title":"OrangeThemeAccordionComponentTokensProvider","navigatorTitle":[{"kind":"identifier","text":"OrangeThemeAccordionComponentTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeAccordionComponentTokensProvider"}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeAccordionComponentTokensProvider/sizeIconMobile":{"abstract":[{"type":"text","text":"Has for value token sizes.iconWithLabelLargeSizeMedium (= 28)"}],"title":"sizeIconMobile","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeIconMobile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic04SizeB5Tokena","text":"SizeSemanticToken"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentati