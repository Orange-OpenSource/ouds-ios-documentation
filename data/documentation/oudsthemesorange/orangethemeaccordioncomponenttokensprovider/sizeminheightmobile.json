{"kind":"symbol","abstract":[{"type":"text","text":"Has for value token DimensionRawTokens._750 (= 60)"}],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider\/sizeMinHeightMobile","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/oudsthemesorange\/orangethemeaccordioncomponenttokensprovider\/sizeminheightmobile"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeMinHeightMobile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic04SizeB5Tokena","text":"SizeSemanticToken"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider"]]},"metadata":{"extendedModule":"OUDSThemesOrange","role":"symbol","title":"sizeMinHeightMobile","externalID":"s:16OUDSThemesOrange0B37ThemeAccordionComponentTokensProviderC19sizeMinHeightMobileSdvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMinHeightMobile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic04SizeB5Tokena"}],"symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"Theme Orange"}]},"sections":[],"references":{"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeAccordionComponentTokensProvider/sizeMinHeightMobile":{"url":"\/documentation\/oudsthemesorange\/orangethemeaccordioncomponenttokensprovider\/sizeminheightmobile","abstract":[{"text":"Has for value token DimensionRawTokens._750 (= 60)","type":"text"}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMinHeightMobile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic04SizeB5Tokena"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider\/sizeMinHeightMobile","role":"symbol","kind":"symbol","title":"sizeMinHeightMobile"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeAccordionComponentTokensProvider":{"url":"\/documentation\/oudsthemesorange\/orangethemeaccordioncomponenttokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"text":"component  tokens of accordions","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"accordions","type":"text"}]},{"type":"text","text":" components."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"code":"AllAccordionComponentTokensProvider","type":"codeVoice"},{"type":"text","text":" implementation inside "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Custom themes can use subclass of "},{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider","isActive":true,"type":"reference"},{"type":"text","text":" and apply the provider they need."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"code":"AccordionComponentTokens","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AccordionFaqComponentTokens","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"text":"accordions","type":"text"}]},{"type":"text","text":" through any "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Accordions","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens spaces (from "},{"code":"AllSpaceSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and sizes (from "},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")."}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeAccordionComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeAccordionComponentTokensProvider"}],"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeAccordionComponentTokensProvider","role":"symbol","kind":"symbol","title":"OrangeThemeAccordionComponentTokensProvider"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"url":"\/documentation\/oudsthemesorange","abstract":[{"type":"text","text":"The Orange theme overrides some tokens from the basic "},{"code":"OUDSTheme","type":"codeVoice"},{"type":"text","text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example."}],"type":"topic","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","role":"collection","kind":"symbol","images":[{"identifier":"ic_theme_orange.png","type":"icon"}],"title":"Theme Orange"},"ic_theme_orange.png":{"variants":[{"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_theme_orange.png","type":"image"}}}