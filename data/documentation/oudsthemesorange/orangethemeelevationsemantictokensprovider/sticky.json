{"metadata":{"extendedModule":"OUDSThemesOrange","symbolKind":"property","roleHeading":"Instance Property","title":"sticky","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sticky","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSTokensSemantic018ElevationCompositeB5Tokena","text":"ElevationCompositeSemanticToken","kind":"typeIdentifier"}],"modules":[{"name":"Theme Orange"}],"externalID":"s:16OUDSThemesOrange0B36ThemeElevationSemanticTokensProviderC6sticky010OUDSTokensE008MultipleD17CompositeRawTokenCvp","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"ElevationCompositeSemanticTokens.sticky"},{"type":"text","text":"."}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sticky","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken","text":"ElevationCompositeSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic018ElevationCompositeB5Tokena","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider"]]},"variants":[{"paths":["\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider\/sticky"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider\/sticky","interfaceLanguage":"swift"},"references":{"ic_theme_orange.png":{"type":"image","alt":null,"identifier":"ic_theme_orange.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png"}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeElevationSemanticTokensProvider/sticky":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sticky","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationCompositeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic018ElevationCompositeB5Tokena"}],"title":"sticky","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider\/sticky","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider\/sticky"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"navigatorTitle":[{"text":"Theme Orange","kind":"text"}],"images":[{"type":"icon","identifier":"ic_theme_orange.png"}],"title":"Theme Orange","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","role":"collection","abstract":[{"type":"text","text":"The Orange theme overrides some tokens from the basic "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example."}],"url":"\/documentation\/oudsthemesorange"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"title":"MultipleElevationCompositeRawToken","abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeElevationSemanticTokensProvider":{"abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"elevation semantic tokens"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"multiple"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllElevationSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."}],"url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider","title":"OrangeThemeElevationSemanticTokensProvider","type":"topic","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeElevationSemanticTokensProvider","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"OrangeThemeElevationSemanticTokensProvider","kind":"identifier"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticToken":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"title":"ElevationCompositeSemanticToken","abstract":[{"type":"text","text":"Basically an elevationcomposite  semantic token, used mainly for box shadow, is a pair of elevation composite raw tokens used depending to the color scheme."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","isActive":true},{"type":"text","text":" contains "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" objects for light and dark modes, which contains "},{"type":"codeVoice","code":"ElevationRawToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":" values."}],"kind":"symbol","type":"topic","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictoken","role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken"}}}