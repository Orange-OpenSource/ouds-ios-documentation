SThemesOrange/documentation/OUDSThemesOrange/OrangeThemeElevationSemanticTokensProvider":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider","role":"symbol","navigatorTitle":[{"text":"OrangeThemeElevationSemanticTokensProvider","kind":"identifier"}],"title":"OrangeThemeElevationSemanticTokensProvider","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"text":"elevation semantic tokens","type":"text"}],"type":"strong"},{"type":"text","text":", "},{"inlineContent":[{"text":"multiple","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"composite"}],"type":"emphasis"},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllElevationSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeElevationSemanticTokensProvider","kind":"identifier"}],"url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider","type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"kind":"symbol","title":"MultipleElevationCompositeRawToken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","type":"topic"},"ic_theme_orange.png":{"alt":null,"identifier":"ic_theme_orange.png","type":"image","variants":[{"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png","traits":["1x","light"]}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticToken":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeSemanticToken"}],"abstract":[{"text":"Basically an elevationcomposite  semantic token, used mainly for box shadow, is a pair of elevation composite raw tokens used depending to the color scheme.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken"},{"text":" contains ","type":"text"},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"text":" objects for light and dark modes, which contains ","type":"text"},{"type":"codeVoice","code":"ElevationRawToken"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ColorRawToken"},{"text":" values.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeSemanticToken"}],"url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictoken","kind":"symbol","title":"ElevationCompositeSemanticToken","role":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticToken","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","role":"collection","navigatorTitle":[{"text":"Theme Orange","kind":"text"}],"abstract":[{"text":"The Orange theme overrides some tokens from the basic ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" and should be seen as the default theme for the OUDS library with the Orange brand colors for example.","type":"text"}],"kind":"symbol","title":"Theme Orange","images":[{"identifier":"ic_theme_orange.png","type":"icon"}],"url":"\/documentation\/oudsthemesorange","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeElevationSemanticTokensProvider/sticky":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sticky"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ElevationCompositeSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic018ElevationCompositeB5Tokena"}],"abstract":[],"url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider\/sticky","title":"sticky","kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider\/sticky","type":"topic"}}}