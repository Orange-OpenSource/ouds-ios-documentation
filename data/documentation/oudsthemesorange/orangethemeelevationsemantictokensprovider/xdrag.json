{"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider\/xDrag","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Semantic token defining the horizontal offset of an element while it is being dragged, creating a sense of movement and depth."},{"type":"text","text":" "},{"type":"text","text":"Each elevation effect must be built using tokens from the same elevation level (x, y, blur and color)."},{"type":"text","text":" "},{"type":"text","text":"Do not mix tokens from different elevation levels or omit any of the four tokens."},{"type":"text","text":" "},{"type":"text","text":"Has for value token ElevationRawTokens.x0 (= 0)"}],"metadata":{"title":"xDrag","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"xDrag"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic23ElevationXSemanticTokena","text":"ElevationXSemanticToken"}],"externalID":"s:16OUDSThemesOrange0B36ThemeElevationSemanticTokensProviderC5xDrag14CoreFoundation7CGFloatVvp","roleHeading":"Instance Property","role":"symbol","modules":[{"name":"Theme Orange"}],"extendedModule":"OUDSThemesOrange"},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeElevationSemanticTokensProvider"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"xDrag"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ElevationXSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic23ElevationXSemanticTokena","identifier":"doc:\/\/OUDSTokensSemantic\/document