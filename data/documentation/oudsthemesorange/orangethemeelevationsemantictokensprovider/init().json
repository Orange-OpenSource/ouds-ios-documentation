ated as a "},{"type":"codeVoice","code":"AllElevationSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeElevationSemanticTokensProvider","kind":"identifier"}],"url":"\/documentation\/oudsthemesorange\/orangethemeelevationsemantictokensprovider","type":"topic"}}}