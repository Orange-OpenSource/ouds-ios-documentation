ma inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a size token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSizeSemanticToken","isActive":true},{"type":"text","text":"."}],"kind":"symbol"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeSizeSemanticTokensProvider":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeSizeSemanticTokensProvider","title":"OrangeThemeSizeSemanticTokensProvider","kind":"symbol","abstract":[{"text":"A class which wraps all ","type":"text"},{"inlineContent":[{"type":"text","text":"size semantic tokens"}],"type":"strong"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"multiple"}],"type":"emphasis"},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"text":"This provider should be integrated as a ","type":"text"},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Closed tokens of dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") are used so as to keep consistancy beweetn Figma specifications and library for developers."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OrangeThemeSizeSemanticTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemesizesemantictokensprovider","type":"topic","navigatorTitle":[{"kind":"identifi