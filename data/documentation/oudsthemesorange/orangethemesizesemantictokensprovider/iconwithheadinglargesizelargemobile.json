aps all "},{"type":"strong","inlineContent":[{"type":"text","text":"size semantic tokens"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Closed tokens of dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") are used so as to keep consistancy beweetn Figma specifications and library for developers."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeSizeSemanticTokensProvider","kind":"identifier"}]}}}