ntation to use."},{"type":"text","text":" "},{"type":"text","text":"Closed tokens of dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") are used so as to keep consistancy beweetn Figma specifications and library for developers."}],"title":"OrangeThemeSizeSemanticTokensProvider","navigatorTitle":[{"text":"OrangeThemeSizeSemanticTokensProvider","kind":"identifier"}],"url":"\/documentation\/oudsthemesorange\/orangethemesizesemantictokensprovider","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeSizeSemanticTokensProvider","kind":"identifier"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleSizeSemanticToken":{"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleSizeSemanticToken"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleSizeSemanticToken"}],"title":"MultipleSizeSemanticToken","abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/SizeSemanticToken","type":"reference","isActive":true},{"text":" depending to viewports \/ size classes.","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from Figma inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a size token exists with its value depending to the size class, it must be packed in such ","type":"text"},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleSizeSemanticToken","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUD