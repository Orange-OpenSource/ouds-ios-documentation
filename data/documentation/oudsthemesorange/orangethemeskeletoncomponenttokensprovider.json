okens","    \/\/ by inheriting from existing provider","    class CustomSkeletonComponentTokensProvider: OrangeThemeSkeletonComponentTokensProvider {","","        \/\/ Then override the skeleton component tokens you want.","","        override var colorGradientMiddle:  MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","","        \/\/ ...","    }","","    \/\/ Or define your own provider from scratch","    class CustomSkeletonComponentTokensProvider: SkeletonComponentTokens {","","        \/\/ And implement maybe hundreds of tokens.","        \/\/ You are allowed to use semantic tokens providers if you want to define values.","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, you can give this "},{"type":"codeVoice","code":"CustomSkeletonComponentTokensProvider"},{"type":"text","text":" to your own theme implementation:"}]},{"type":"codeListing","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(skeleton: CustomSkeletonComponentTokensProvider())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}]},{"type":"codeListing","code":["    OrangeTheme(skeleton: CustomSkeletonComponentTokensProvider())"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}]},{"type":"codeListing","code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeColorSemanticTokensProvider for colors","    let skeletonComponentTokensProvider = OrangeThemeSkeletonComponentTokensProvider()","","    \/\/ Or use your own color semantic tokens providers (or only some)","    let skeletonComponentTokensProvider = OrangeThemeSkeletonComponentTokensProvider(","                                                colors: CustomColorSemanticTokensProvider())"],"syntax":"swift"},{"type":"aside","name":"Si