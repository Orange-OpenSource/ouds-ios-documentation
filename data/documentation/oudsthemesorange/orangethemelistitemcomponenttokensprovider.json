icTokensProvider(),","                                              colors: CustomColorSemanticTokensProvider(),","                                              spaces: CustomSpaceSemanticTokensProvider())"],"type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"text":"3.0.0","type":"text"}],"type":"paragraph"}],"style":"note","name":"Since"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudsthemesorange\/orangethemelistitemcomponenttokensprovider"]}],"references":{"doc://OUDSThemesContract/documentation/OUDSThemesContract/TokensProvider":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokensProvider","kind":"identifier"}],"abstract":[{"type":"text","text":"Protocol to add to any semantic or component tokens provider so as to be gather with all providers and given to the theme for initialization"}],"url":"\/documentation\/oudsthemescontract\/tokensprovider","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/TokensProvider","title":"TokensProvider","type":"topic","navigatorTitle":[{"text":"TokensProvider","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://OUDSThemesOrange/s8CopyableP":{"identifier":"doc:\/\/OUDSThemesOrange\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/AllListItemComponentTokensProvider":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllListItemComponentTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/AllListItemComponentTokensProvider","title":"AllListItemComponentTokensProvider","type":"topic","url":"\/documentation\/oudsthemescontract\/alllistitemcomponenttokensprovider","navigato