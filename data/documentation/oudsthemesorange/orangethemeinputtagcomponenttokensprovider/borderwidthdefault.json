n":{"abstract":[{"text":"Type alias precising ","type":"text"},{"code":"BorderWidthRawToken","type":"codeVoice"},{"text":" is used as a value of this ","type":"text"},{"inlineContent":[{"type":"text","text":"border width semantic token"}],"type":"strong"},{"text":", to keep grammar clean and clear with design system grammar.","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BorderWidthSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"BorderWidthSemanticToken","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/borderwidthsemantictoken","role":"symbol","kind":"symbol","title":"BorderWidthSemanticToken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/BorderWidthSemanticToken","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeInputTagComponentTokensProvider/borderWidthDefault":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"borderWidthDefault","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BorderWidthSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic011BorderWidthB5Tokena","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Has for value token borders.widthDefault (= 1)"}],"url":"\/documentation\/oudsthemesorange\/orangethemeinputtagcomponenttokensprovider\/borderwidthdefault","title":"borderWidthDefault","kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeInputTagComponentTokensProvider\/borderWidthDefault","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","role":"collection","navigatorTitle":[{"text":"Theme Orange","kind":"text"}],"abstract":[{"text":"The Orange theme overrides some tokens from the basic ","type":"text"},{"type":"codeVoice","code":"OUDSTheme"},{"text":" and should be seen as the default theme