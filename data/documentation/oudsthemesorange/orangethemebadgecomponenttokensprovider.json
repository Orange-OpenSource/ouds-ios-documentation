geComponentTokensProvider = OrangeThemeBadgeComponentTokensProvider()","","    \/\/ Or use your own dimension and space semantic tokens provider","    let badgeComponentTokensProvider = OrangeThemeBadgeComponentTokensProvider(","                    spaces: CustomSpaceSemanticTokensProvider(),","                    dimensions: CustomDimensionSemanticTokensProvider())"],"type":"codeListing"},{"style":"note","name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"0.10.0","type":"text"}]}]}]}],"sections":[],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeBadgeComponentTokensProvider","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"OrangeThemeBadgeComponentTokensProvider","externalID":"s:16OUDSThemesOrange0B33ThemeBadgeComponentTokensProviderC","symbolKind":"class","role":"symbol","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"OrangeThemeBadgeComponentTokensProvider"}],"modules":[{"name":"Theme Orange"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeBadgeComponentTokensProvider"}]},"references":{"doc://OUDSThemesOrange/19OUDSTokensComponent05BadgeB6TokensP":{"identifier":"doc:\/\/OUDSThemesOrange\/19OUDSTokensComponent05BadgeB6TokensP","type":"unresolvable","title":"OUDSTokensComponent.BadgeComponentTokens"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeBadgeComponentTokensProvider/dimensions":{"title":"dimensions","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/oudsthemesorange\/orangethemebadgecomponenttokensprovider\/dimensions","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeBadgeComponentTokensProvider\/dimensions","abstract":[{"type":"text","text":"Provider of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dimensions"}]},{"type":"text","text":" semantic tokens to