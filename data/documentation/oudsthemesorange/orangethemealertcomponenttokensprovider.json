ragraph"},{"syntax":"swift","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(alert: CustomAlertComponentTokensProvider())","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}],"type":"paragraph"},{"syntax":"swift","code":["    OrangeTheme(alert: CustomAlertComponentTokensProvider())"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeSizeSemanticTokensProvider for sizes","    \/\/ - OrangeThemeSpaceSemanticTokensProvider for sizes","    \/\/ - OrangeThemeBorderSemanticTokensProvider for sizes","    let alertComponentTokensProvider = OrangeThemeAlertComponentTokensProvider()","","    \/\/ Or use your own semantic tokens providers","    let alertComponentTokensProvider = OrangeThemeAlertComponentTokensProvider(","                    sizes: CustomSizeSemanticTokensProvider(),","                    borders: CustomBorderSemanticTokensProvider(),","                    spaces: CustomSpaceSemanticTokensProvider())"],"type":"codeListing"},{"name":"Since","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0","type":"text"}]}]}],"kind":"content"}],"references":{"doc://OUDSThemesContract/documentation/OUDSThemesContract/TokensProvider":{"url":"\/documentation\/oudsthemescontract\/tokensprovider","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TokensProvider"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokensProvider"}],"title":"TokensProvider","role":"symbol","abstract":[{"type":"text","text":"Protocol to add to any semantic or component tokens provider so as to be gather with all providers and given to the theme for initial