{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeAlertComponentTokensProvider"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Define your own provider for alert component tokens","    \/\/ by inheriting from existing provider","    class CustomAlertComponentTokensProvider: OrangeThemeAlertComponentTokensProvider {","","        \/\/ Then override the alert component tokens you want.","","        override var sizeIcon: SizeSemanticToken { DimensionRawTokens._100 }","","        override var spacePaddingBlock: SpaceSemanticToken { DimensionRawTokens.outOfSystem75 }","","        \/\/ ...","    }","","    \/\/ Or define your own provider from scratch","    class CustomAlertComponentTokensProvider: AlertComponentTokens {","","        \/\/ And implement hundreds of tokens.","        \/\/ You are allowed to give semantic tokens providers if you want to define values.","    }"]},{"inlineContent":[{"type":"text","text":"Then, you can give this "},{"type":"codeVoice","code":"CustomAlertComponentTokensProvider"},{"type":"text","text":" to your own theme implementation:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(alert: CustomAlertComponentTokensProvider())","    }","}"]},{"inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    OrangeTheme(alert: CustomAlertComponentTokensProvider())"]},{"inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Uses by 