text":" "},{"type":"text","text":"dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"title":"OrangeThemeToastComponentTokensProvider","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeToastComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeToastComponentTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeToastComponentTokensProvider/sizes":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/sizes","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizes","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OUDSThemesContract29AllSizeSemanticTokensProviderP","text":"AllSizeSemanticTokensProvider","kind":"typeIdentifier"}],"title":"sizes","type":"topic","url":"\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider\/sizes","abstract":[{"text":"Provider of sizes semantic tokens to use for toast sizes","type":"text"}],"role":"symbol"}}}