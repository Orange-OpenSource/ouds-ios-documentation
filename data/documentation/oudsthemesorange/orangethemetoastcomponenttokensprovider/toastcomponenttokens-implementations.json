{"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","variants":[{"paths":["\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider\/toastcomponenttokens-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/ToastComponentTokens-Implementations","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/borderRadiusMedia","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/borderRadiusMediaRounded","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/sizeAssetLarge","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/sizeAssetMedium","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/sizeAssetSmall"],"generated":true}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"Theme Orange"}],"title":"ToastComponentTokens Implementations","role":"collectionGroup"},"sections":[],"references":{"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeToastComponentTokensProvider":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"text":"component  tokens of toast","type":"text"}],"type":"strong"},{"type":"text","text":" for "},{"inlineContent":[{"text":"toast","type":"text"}],"type":"emphasis"},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"OUDSToast"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllToastComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"Custom themes can use subclass of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider"},{"type":"text","text":" and apply the provider they need."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"ToastComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"text":"toast","type":"text"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"text":"Toast","type":"text"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens of borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"title":"OrangeThemeToastComponentTokensProvider","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeToastComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeToastComponentTokensProvider"}],"url":"\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider","type":"topic"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeToastComponentTokensProvider/borderRadiusMedia":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"borderRadiusMedia"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic012BorderRadiusB5Tokena","text":"BorderRadiusSemanticToken"}],"title":"borderRadiusMedia","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/borderRadiusMedia","url":"\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider\/borderradiusmedia","kind":"symbol","abstract":[{"type":"text","text":"Has for value token borders.radiusDefault (= 0)"}],"role":"symbol"},"ic_theme_orange.png":{"identifier":"ic_theme_orange.png","alt":null,"type":"image","variants":[{"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png","traits":["1x","light"]}]},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeToastComponentTokensProvider/borderRadiusMediaRounded":{"url":"\/documentation\/oudsthemesorange\/orangethemetoastcomponenttokensprovider\/borderradiusmediarounded","abstract":[{"type":"text","text":"Has for value token borders.radiusSmall (= 4)"}],"title":"borderRadiusMediaRounded","type":"topic","role":"symbol","identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeToastComponentTokensProvider\/borderRadiusMediaRounded","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bo