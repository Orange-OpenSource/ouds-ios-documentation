d disabled states."},{"type":"text","text":" "},{"type":"text","text":"This token is used in the dark mode."},{"type":"text","text":" "},{"type":"text","text":"Has for value token repositoryOpacityWhiteMediumLow (= “#FFFFFF33”)"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticToken":{"role":"symbol","type":"topic","abstract":[{"text":"Basically a color semantic  token is a ","type":"text"},{"type":"codeVoice","code":"ColorRawToken"},{"text":", to keep grammar clean and clear with design system grammar.","type":"text"}],"url":"\/documentation\/oudstokenssemantic\/colorsemantictoken","title":"ColorSemanticToken","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColorSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"ColorSemanticToken","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken"},"ic_theme_orange.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesOrange\/ic_theme_orange.png"}],"alt":null,"identifier":"ic_theme_orange.png"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeColorSemanticTokensProvider":{"role":"symbol","type":"topic","url":"\/documentation\/oudsthemesorange\/orangethemecolorsemantictokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"color semantic tokens"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"text":"all tokens to the users. It helps us