{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"title":"actionReadOnlySecondaryDark","symbolKind":"property","modules":[{"name":"Theme Orange"}],"roleHeading":"Instance Property","extendedModule":"OUDSThemesOrange","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"actionReadOnlySecondaryDark"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OUDSTokensSemantic05ColorB5Tokena","text":"ColorSemanticToken"}],"role":"symbol","externalID":"s:16OUDSThemesOrange0B32ThemeColorSemanticTokensProviderC27actionReadOnlySecondaryDarkSSvp"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"actionReadOnlySecondaryDark"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","preciseIdentifier":"s:18OUDSTokensSemantic05ColorB5Tokena","text":"ColorSemanticToken"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeColorSemanticTokensProvider\/actionReadOnlySecondaryDark","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange","doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeColorSemanticTokensProvider"]]},"abstract":[{"type":"text","text":"Semantic token for action interactions, applied to the colour of secondary visual elements that establish the read-only appearance of a component."},{"type":"text","text":" "},{"type":"text","text":"Its contrast may be intentionally reduced to match the visual treatment of a disabled state and is therefore not