 CustomProgressIndicatorComponentTokensProvider())","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"or to an already existing theme for example:","type":"text"}]},{"code":["    OrangeTheme(progressIndicator: CustomProgressIndicatorComponentTokensProvider())"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"It is also possible to use your own semantic tokens providers for this component tokens providers:","type":"text"}]},{"code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeSizeSemanticTokensProvider for sizes","    \/\/ - OrangeThemeBorderSemanticTokensProvider for borders","    \/\/ - OrangeThemeColorSemanticTokensProvider for colors","    \/\/ - OrangeThemeSpaceSemanticTokensProvider for spaces","    \/\/ - OrangeThemeDimensionSemanticTokensProvider for dimensions","    let progressIndicatorComponentTokensProvider = OrangeThemeProgressIndicatorComponentTokensProvider()","","    \/\/ Or use your own semantic tokens providers","    let progressIndicatorComponentTokensProvider = OrangeThemeProgressIndicatorComponentTokensProvider(","                    sizes: CustomSizeSemanticTokensProvider(),","                    spaces: CustomSpaceSemanticTokensProvider())"],"type":"codeListing","syntax":"swift"},{"name":"Since","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"3.0.0"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"externalID":"s:16OUDSThemesOrange0B45ThemeProgressIndicatorComponentTokensProviderC","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"OrangeThemeProgressIndicatorComponentTokensProvider"}],"modules":[{"name":"Theme Orange"}],"role":"symbol","title":"OrangeThemeProgressIndicatorComponentTokensProvider","roleHeading":"Class"},"kind":"symbol","