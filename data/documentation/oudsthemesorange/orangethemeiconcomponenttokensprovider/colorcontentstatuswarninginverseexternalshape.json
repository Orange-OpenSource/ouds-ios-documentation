,"text":" depending to "},{"inlineContent":[{"text":"color scheme","type":"text"}],"type":"emphasis"},{"type":"text","text":" (i.e. ligh mode or dark mode)."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"inlineContent":[{"text":"Figma","type":"text"}],"type":"emphasis"},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}],"role":"symbol","url":"\/documentation\/oudstokenssemantic\/multiplecolorsemantictoken","title":"MultipleColorSemanticToken","kind":"symbol"},"doc://OUDSThemesOrange/documentation/OUDSThemesOrange/OrangeThemeIconComponentTokensProvider/colorContentStatusWarningInverseExternalShape":{"identifier":"doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange\/OrangeThemeIconComponentTokensProvider\/colorContentStatusWarningInverseExternalShape","type":"topic","abstract":[{"type":"text","text":"Has for value token MultipleColorSemanticToken(light: colors.repositoryWarningLow, dark: colors.repositoryWarningMedium) (= light: “#FFE270FF” \/ dark: “#FFD000FF”)"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorContentStatusWarningInverseExternalShape","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MultipleColorSemanticToken","preciseIdentifier":"c:@M@OUDSTokensSemantic@objc(cs)MultipleColorSemanticToken","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","title":"colorContentStatusWarningInverseExternalShape","url":"\/documentation\/oudsthemesorange\/orangethemeiconcompon