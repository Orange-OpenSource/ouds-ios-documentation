xt":"or to an already existing theme for example:","type":"text"}]},{"code":["    OrangeTheme(tag: CustomTagComponentTokensProvider())"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"It is also possible to use your own semantic tokens providers for this component tokens providers:"}],"type":"paragraph"},{"code":["    \/\/ Uses by default here:","    \/\/ - OrangeThemeSizeSemanticTokensProvider for sizes","    \/\/ - OrangeThemeBorderSemanticTokensProvider for borders","    \/\/ - OrangeThemeDimensionSemanticTokensProvider for dimensions","    \/\/ - OrangeThemeSpaceSemanticTokensProvider for spaces","    let tagComponentTokensProvider = OrangeThemeTagComponentTokensProvider()","","    \/\/ Or use your own size, space, _ and border semantic tokens providers (or only some)","    let tagComponentTokensProvider = OrangeThemeTagComponentTokensProvider(","                                            sizes: CustomSizeSemanticTokensProvider(),","                                            borders: CustomBorderSemanticTokensProvider(),","                                            spaces: CustomSpaceSemanticTokensProvider,","                                            dimensions: CustomDimensionSemanticTokensProvider())"],"syntax":"swift","type":"codeListing"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"0.9.0"}]}],"style":"note","type":"aside"}]}],"sections":[],"metadata":{"externalID":"s:16OUDSThemesOrange0B31ThemeTagComponentTokensProviderC","title":"OrangeThemeTagComponentTokensProvider","role":"symbol","symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrangeThemeTagComponentTokensProvider","kind":"identifier"}],"modules":[{"name":"Theme Orange"}],"roleHeading":"Class","navigatorTitle":[{"text":"OrangeThemeTagComponentTokensProvider","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudsthem