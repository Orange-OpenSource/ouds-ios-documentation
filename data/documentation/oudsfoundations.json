":"collection","kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/Swift"},"doc://OUDSFoundations/documentation/OUDSFoundations/registerFont(postScript:forCombination:)":{"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/registerFont(postScript:forCombination:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registerFont","kind":"identifier"},{"text":"(","kind":"text"},{"text":"postScript","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"forCombination","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PostScriptFontNamesMapKey","kind":"typeIdentifier","preciseIdentifier":"s:15OUDSFoundations25PostScriptFontNamesMapKeyV"},{"text":")","kind":"text"}],"title":"registerFont(postScript:forCombination:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Because some local themes can use their own fonts, OUDS is not always able to make the conversion between the PostScript identifier"},{"type":"text","text":" "},{"type":"text","text":"of the TTF file for a given font and in the end tokens of fonts with weights."},{"type":"text","text":" "},{"type":"text","text":"Registers a PostScript identifier to use for a given combination of font name and weight."}],"url":"\/documentation\/oudsfoundations\/registerfont(postscript:forcombination:)"},"doc://OUDSFoundations/documentation/OUDSFoundations/WCAG21Requirements":{"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/WCAG21Requirements","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WCAG21Requirements","kind":"identifier"}],"title":"WCAG21Requirements","navigatorTitle":[{"text":"WCAG21Requirements","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components"}],"url":"\/documentation\/oudsfoundations\/wcag21requirements"},"doc://OUDSFoundations/documentation/OUDSFoundations/PostScriptFontNamesMapKey":{"title":"PostScriptFontNamesMapKey","role":"symbol","kind":"symbol","abstract":[{"text":"Key of the map containing PostScript name to use for a font depending to its family name and weight.","type":"text"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PostScriptFontNamesMapKey","url":"\/documentation\/oudsfoundations\/postscriptfontnamesmapkey","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostScriptFontNamesMapKey"}],"navigatorTitle":[{"kind":"identifier","text":"PostScriptFontNamesMapKey"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"title":"OUDSWCAG21Ratio","url":"\/documentation\/oudsfoundations\/oudswcag21ratio","abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio"},"ic_layers.png":{"alt":null,"identifier":"ic_layers.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSFoundations\/ic_layers.png"}],"type":"image"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSUtils":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSUtils","kind":"identifier"}],"title":"OUDSUtils","url":"\/documentation\/oudsfoundations\/oudsutils","abstract":[{"text":"A set of utilities from OUDS library shared with love ⸜(｡˃ ᵕ ˂)⸝♡♡♡","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OUDSUtils"}],"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSUtils"},"doc://OUDSFoundations/documentation/OUDSFoundations/PostScriptFontNamesMap":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostScriptFontNamesMap","kind":"identifier"}],"title":"PostScriptFontNamesMap","url":"\/documentation\/oudsfoundations\/postscriptfontnamesmap","abstract":[{"type":"text","text":"Some font family cannot be used as they are because their “marketing” names are unknown to the OS"},{"type":"text","text":" "},{"type":"text","text":"except their PostScript names."},{"type":"text","text":" "},{"type":"text","text":"This dictionnary defines the expected PostScript names of font families known in iOS."},{"type":"text","text":" "},{"type":"text","text":"Depending to the font family, several rules are applied, with for example removal of whitespaces"},{"type":"text","text":" "},{"type":"text","text":"and adding of prefixes of suffixes after the font family name or the weight."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"PostScriptFontNamesMap","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PostScriptFontNamesMap"},"doc://OUDSFoundations/documentation/OUDSFoundations":{"title":"Foundations","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations","images":[{"type":"icon","identifier":"ic_layers.png"}],"url":"\/documentation\/oudsfoundations","type":"topic"},"doc://OUDSFoundations/documentation/OUDSFoundations/PSFNMK":{"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PSFNMK","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PSFNMK","kind":"identifier"}],"title":"PSFNMK","navigatorTitle":[{"text":"PSFNMK","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"PostScriptFontNamesMapKey in shorter"}],"url":"\/documentation\/oudsfoundations\/psfnmk"}}}