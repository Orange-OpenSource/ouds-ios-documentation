cumentation/OUDSFoundations/OUDSLowPowerModeObserver":{"type":"topic","abstract":[{"type":"text","text":"An "},{"code":"ObservableObject","type":"codeVoice"},{"type":"text","text":" providing through a published state a flag saying if the device  is in low pover mode or not."},{"type":"text","text":" "},{"type":"text","text":"This object is exposed as "},{"inlineContent":[{"text":"environment object","type":"text"}],"type":"emphasis"},{"type":"text","text":" through the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":", and can be used in any view"},{"type":"text","text":" "},{"type":"text","text":"inside it to apply a specific behavior when the device is in low power mode."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLowPowerModeObserver","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudsfoundations\/oudslowpowermodeobserver","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSLowPowerModeObserver","navigatorTitle":[{"text":"OUDSLowPowerModeObserver","kind":"identifier"}],"title":"OUDSLowPowerModeObserver"},"doc://OUDSFoundations/documentation/OUDSFoundations/WCAG21Requirements":{"type":"topic","abstract":[{"type":"text","text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WCAG21Requirements","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudsfoundations\/wcag21requirements","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/WCAG21Requirements","navigatorTitle":[{"text":"WCAG21Requirements","kind":"identifier"}],"title":"WCAG21Requirements"},"doc://OUDSFoundations/documentation/OUDSFoundations/kApplePostScriptFontNames":{"type":"topic","abstract":[{"type":"text","text":"Contains the Apple PostScript name of a font given a font family name and a font weight."},{"type":"text","text":" "},{"type":"text","text":"Such values have been picked from the Apple Font Book."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kApplePostScriptFontNames","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15OUDSFoundations22PostScriptFontNamesMapa","text":"PostScriptFontNamesMap","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oudsfoundations\/kapplepostscriptfontnames","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/kApplePostScriptFontNames","title":"kApplePostScriptFontNames"},"doc://OUDSFoundations/documentation/OUDSFoundations/iPhoneDevice":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"iPhoneDevice"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/iPhoneDevice","abstract":[{"text":"List some iPhone devices which can use OUDS, i.e. supposed to support at least iOS 15.","type":"text"},{"text":" ","type":"text"},{"text":"Helps to define some metrics like tab bar heights.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"iPhoneDevice"}],"title":"iPhoneDevice","url":"\/documentation\/oudsfoundations\/iphonedevice"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"type":"topic","abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"isActive":true,"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudsfoundations\/oudswcag21ratio","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"title":"OUDSWCAG21Ratio"},"doc://OUDSFoundations/documentation/OUDSFoundations/Swift":{"type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/oudsfoundations\/swift","role":"collection","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/Swift","title":"Swift"}}}