"},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSUtils":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSUtils"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSUtils","type":"topic","url":"\/documentation\/oudsfoundations\/oudsutils","navigatorTitle":[{"kind":"identifier","text":"OUDSUtils"}],"title":"OUDSUtils","abstract":[{"type":"text","text":"A set of utilities from OUDS library shared with love ⸜(｡˃ ᵕ ˂)⸝♡♡♡"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/WCAG21Requirements":{"url":"\/documentation\/oudsfoundations\/wcag21requirements","navigatorTitle":[{"text":"WCAG21Requirements","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/WCAG21Requirements","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WCAG21Requirements","kind":"identifier"}],"title":"WCAG21Requirements","abstract":[{"type":"text","text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components"}],"role":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/kMinimalTouchAreaWidth":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kMinimalTouchAreaWidth"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/kMinimalTouchAreaWidth","type":"topic","url":"\/documentation\/oudsfoundations\/kminimaltouchareawidth","title":"kMinimalTouchAreaWidth","abstract":[{"type":"text","text":"A touch area with a wi