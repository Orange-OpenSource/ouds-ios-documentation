 as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"also named “RGAA”.","type":"text"},{"type":"text","text":" "},{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"isActive":true,"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"title":"OUDSWCAG21Ratio","type":"topic","kind":"symbol","role":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSLogger":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"OUDSLogger"}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" wrapper used in the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDS iOS"}]},{"type":"text","text":" library so as to logs things in standard output or elsewhere."}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSLogger","title":"OUDSLogger","url":"\/documentation\/oudsfoundations\/oudslogger","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSLogger","kind":"identifier"}],"role":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations":{"title":"Foundations","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations","role":"collection","type":"topic","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"url":"\/documentation\/oudsfoundations","images":[{"type":"icon","identifier":"ic_layers.png"}],"kind":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/SwiftUICore":{"kind":"symbol","type":"topic","abstract":[],"title":"SwiftUICore","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/SwiftUICore","url":"\/documentation\/oudsfoundations\/swiftuicore","role":"collection"},"doc://OUDSFoundations/documentation/OUDSFoundations/PSFNMK":{"url":"\/documentation\/oudsfoundations\/psfnmk","abstract":[{"type":"text","text":"PostScriptFontNamesMapKey in shorter"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PSFNMK","navigatorTitle":[{"text":"PSFNMK","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PSFNMK","kind":"identifier"}],"title":"PSFNMK","type":"topic","kind":"symbol","role":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSUserInterfaceSizeClass":{"url":"\/documentation\/oudsfoundations\/oudsuserinterfacesizeclass","abstract":[{"type":"text","text":"Enumerates the size classes defined by the design system."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"extraCompact"}]},{"type":"text","text":" size class if for screens with width < 389."},{"type":"text","text":" "},{"type":"t