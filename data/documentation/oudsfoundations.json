p","kind":"identifier"}],"title":"PostScriptFontNamesMap","abstract":[{"type":"text","text":"Some font family cannot be used as they are because their “marketing” names are unknown to the OS"},{"type":"text","text":" "},{"type":"text","text":"except their PostScript names."},{"type":"text","text":" "},{"type":"text","text":"This dictionnary defines the expected PostScript names of font families known in iOS."},{"type":"text","text":" "},{"type":"text","text":"Depending to the font family, several rules are applied, with for example removal of whitespaces"},{"type":"text","text":" "},{"type":"text","text":"and adding of prefixes of suffixes after the font family name or the weight."}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PostScriptFontNamesMap","url":"\/documentation\/oudsfoundations\/postscriptfontnamesmap","type":"topic","kind":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"url":"\/documentation\/oudsfoundations\/oudswcag21ratio","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSWCAG21Ratio","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","title":"OUDSWCAG21Ratio","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","navigatorTitle":[{"text":"OUDSWCAG21Ratio","kind":"identifier"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSLogger":{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" wrapper used in the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDS iOS"}]},{"type":"text","text":" library so as to logs things in standard output or elsewhere."}],"url":"\/documentation\/oudsfoundations\/oudslogger","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLogger"}],"role":"symbol","kind":"symbol","type":"topic","title":"OUDSLogger","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSLogger","navigatorTitle":[{"kind":"identifier","text":"OUDSLogger"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/Swift":{"abstract":[],"url":"\/documentation\/oudsfoundations\/swift","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/Swift","title":"Swift"},"doc://OUDSFoundations/documentation/OUDSFoundations/WCAG21Requirements":{"abstract":[{"text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components","type":"text"}],"url":"\/documentation\/oudsfoundations\/wcag21requirements","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text