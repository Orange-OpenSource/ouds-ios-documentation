t","text":"This theme embeds and registers the fonts for the Sosh theme, you just need to use the theme object as is."}]}],"type":"aside"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme does not embed colors for charts yet and is read only: it cannot be subclassed or derivated"}]}],"type":"aside"},{"anchor":"How-to-use-the-theme","level":2,"text":"How to use the theme","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","type":"reference"},{"text":" directly. To use the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":" without further modifications, you will have to use the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" for your root view and give it an instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":". Keep in mind the themes are "},{"type":"emphasis","inlineContent":[{"text":"Swift class objects","type":"text"}]},{"type":"text","text":" and can be heavy, so you may use only as instance as singleton and not store any properties."}]},{"syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: SoshTheme()) {","                \/\/ Your root view","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:","type":"text"}]},{"syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"],"type":"codeListing"},{"anchor":"How-to-tune-the-theme","level":2,"type":"heading","text":"How to tune the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"anchor":"Typography","level":2,"type":"heading","text":"Typography"},{"type":"paragraph","inlineContent":[{"text":"The Sosh theme uses its Sosh font and must not use others.","type":"text"}]},{"anchor":"How-to-enrich-the-theme","level":2,"type":"heading","text":"How to enrich the theme"},{"type":"paragraph","inlineContent":[{"text":"You cannot derivate the Sosh theme.","type":"text"}]},{"anchor":"How-it-looks-like","level":2,"type":"heading","text":"How it looks like"},{"anchor":"Actions","level":3,"type":"heading","text":"Actions"},{"anchor":"Button","level":4,"type":"heading","text":"Button"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_Sosh.png","type":"image"}]},{"anchor":"Content-display","level":3,"type":"heading","text":"Content display"},{"anchor":"Bullet-list","level":4,"type":"heading","text":"Bullet list"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_bullet_list_Sosh.png","type":"image"}]},{"anchor":"Controls","level":3,"type":"heading","text":"Controls"},{"anchor":"Checkboxes","level":4,"type":"heading","text":"Checkboxes"},{"tabs":[{"content":[{"inlineContent":[{"identifier":