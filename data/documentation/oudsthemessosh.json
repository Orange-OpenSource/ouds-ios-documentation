{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"code":["🧬 Theme version: 2.7.0"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"This is the Sosh theme any Sosh product must use, and cannot be subclassed.","type":"text"},{"text":" ","type":"text"},{"text":"It embeds also in its target the Sosh brand colors which are not shared nor exposed in lower level targets or outside any module not depending to it.","type":"text"},{"text":" ","type":"text"},{"text":"In other words, this ","type":"text"},{"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true,"type":"reference"},{"text":" is based on the abstract ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":", uses all the ","type":"text"},{"inlineContent":[{"type":"text","text":"Orange Unified Design System"}],"type":"emphasis"},{"text":" kit and brings the Sosh brand colors and assets.","type":"text"}],"type":"paragraph"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"This theme embeds and registers the fonts for the Sosh theme, you just need to use the theme object as is.","type":"text"}]}],"type":"aside"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"The Sosh theme does not embed colors for charts yet and is read only: it cannot be subclassed or derivated","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"How to use the theme","level":2,"anchor":"How-to-use-the-theme","type":"heading"},{"inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true},{"type":"text","text":" directly. To use the "},{"type":"reference","identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true},{"type":"text","text":" without further modifications, you will have to use the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" for your root view and give it an instance of "},{"type":"reference","identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true},{"type":"text","text":". Keep in mind the themes are "},{"inlineContent":[{"text":"Swift class objects","type":"text"}],"type":"emphasis"},{"text":" and can be heavy, so you may use only as instance as singleton and not store any properties.","type":"text"}],"type":"paragraph"},{"code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: SoshTheme()) {","                \/\/ Your root view","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:","type":"text"}]},{"code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"How-to-tune-the-theme","text":"How to tune the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"level":2,"type":"heading","anchor":"Typography","text":"Typography"},{"type":"paragraph","inlineContent":[{"text":"The Sosh theme uses its Sosh font and must not use others.","type":"text"}]},{"level":2,"type":"heading","anchor":"How-to-enrich-the-theme","text":"How to enrich the theme"},{"type":"paragraph","inlineContent":[{"text":"You cannot derivate the Sosh theme.","type":"text"}]},{"level":2,"type":"heading","anchor":"How-it-looks-like","text":"How it looks like"},{"level":3,"type":"heading","anchor":"Actions","text":"Actions"},{"level":4,"type":"heading","anchor":"Button","text":"Button"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_Sosh.png"}]},{"level":3,"type":"heading","anchor":"Content-display","text":"Content display"},{"level":4,"type":"heading","anchor":"Bullet-list","text":"Bullet list"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_bullet_list_Sosh.png","type":"image"}]},{"level":3,"type":"heading","anchor":"Controls","text":"Controls"},{"level":4,"type":"heading","anchor":"Checkboxes","text":"Checkboxes"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkbox_Sosh.png","type":"image"}]}],"title":"Checkbox"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkboxItem_Sosh.png"}]}],"title":"Checkbox item"}]},{"level":4,"type":"heading","anchor":"Radios","text":"Radios"},{"type":"tabNavigator","tabs":[{"title":"Radio","content":[{"inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_radio_Sosh.png"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_radioItem_Sosh.png"}]}],"title":"Ra