configuration: theme.link","        \/\/ Etc.","    }","}"]},{"level":2,"type":"heading","text":"How to tune the theme","anchor":"How-to-tune-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"level":2,"type":"heading","text":"Typography","anchor":"Typography"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme uses its Sosh font and must not use others."}]},{"level":2,"type":"heading","text":"How to enrich the theme","anchor":"How-to-enrich-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot derivate the Sosh theme."}]},{"level":2,"type":"heading","text":"How it looks like","anchor":"How-it-looks-like"},{"level":3,"type":"heading","text":"Actions","anchor":"Actions"},{"level":4,"type":"heading","text":"Button","anchor":"Button"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_Sosh.png","type":"image"}]},{"level":3,"type":"heading","text":"Content display","anchor":"Content-display"},{"level":4,"type":"heading","text":"Bullet list","anchor":"Bullet-list"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_bullet_list_Sosh.png","type":"image"}]},{"level":3,"type":"heading","text":"Controls","anchor":"Controls"},{"level":4,"type":"heading","text":"Checkboxes","anchor":"Checkboxes"},{"type":"tabNavigator","tabs":[{"title":"Checkbox","content":[{"inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkbox_Sosh.png"}],"type":"paragraph"}]},{"title":"Checkbox item","content":[{"inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkboxItem_Sosh.png","type":"image"}],"type":"paragraph"}]}]},{"level":4,"type":"heading","text":"Chips","anchor":"Chips"},