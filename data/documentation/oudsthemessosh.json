operties."}]},{"type":"codeListing","syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: SoshTheme()) {","                \/\/ Your root view","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:"}]},{"type":"codeListing","syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"]},{"type":"heading","anchor":"How-to-tune-the-theme","level":2,"text":"How to tune the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"type":"heading","anchor":"Typography","level":2,"text":"Typography"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme uses its Sosh font and must not use others."}]},{"type":"heading","anchor":"How-to-enrich-the-theme","level":2,"text":"How to enrich the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot derivate the Sosh theme."}]},{"type":"heading","anchor":"How-it-looks-like","level":2,"text":"How it looks like"},{"type":"heading","anchor":"Actions","level":3,"text":"Actions"},{"type":"heading","anchor":"Button","level":4,"text":"Button"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-