ve":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":" is based on the abstract "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":", uses all the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Unified Design System"}]},{"type":"text","text":" kit and brings the Sosh brand colors and assets."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This theme embeds and registers the fonts for the Sosh theme, you just need to use the theme object as is."}]}],"name":"Tip","type":"aside","style":"tip"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme does not embed colors for charts yet and is read only: it cannot be subclassed or derivated"}]}],"name":"Important","type":"aside","style":"important"},{"type":"heading","level":2,"text":"How to use the theme","anchor":"How-to-use-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":" directly. To use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":" without further modifications, you will have to use the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" for your root view and give it an instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme"},{"type":"text","text":". Keep in mind the themes are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift class objects"}]},{"type":"text","text":" and can be heavy, so you may use only as instance as singleton and not store any properties."}]},{"syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: SoshTheme()) {","                \/\/ Your root view","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:"}]},{"syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"How to tune the theme","anchor":"How-to-tune-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"type":"heading","level":2,"text":"Typography","anchor":"Typography"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme uses its Sosh font and must not use others."}]},{"type":"heading","level":2,"text":"How to enrich the theme","anchor":"How-to-enrich-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot derivate the Sosh theme."}]},{"type":"heading","level":2,"text":"How it looks like","anchor":"How-it-looks-like"},{"type":"heading","level":3,"text":"Actions","anchor":"Actions"},{"type":"heading","level":4,"text":"Button","anchor":"Button"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_Sosh.png"}]},{"type":"heading","level":3,"text":"Con