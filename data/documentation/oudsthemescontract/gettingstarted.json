{"text":" ","type":"text"},{"text":"inside the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Apply Orange theme","#Preview {","    SampleView()","        .orangePreview()","}","","\/\/ Apply Orange Compact theme","#Preview {","    SampleView()","        .orangeCompactPreview()","}","","\/\/ Apply Sosh theme","#Preview {","    SampleView()","        .soshPreview()","}","","\/\/ Apply Wireframe theme","#Preview {","    SampleView()","        .wireframePreview()","}"],"type":"codeListing"}]}],"references":{"doc://OUDSThemesContract/documentation/OUDSThemesContract":{"title":"Welcome to Orange Unified Design System","url":"\/documentation\/oudsthemescontract","abstract":[{"text":"Orange Unified Design System: Build Sharper. Ship faster. Perform better.","type":"text"}],"type":"topic","images":[{"type":"icon","identifier":"ic_unified_ds.png"}],"kind":"symbol","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract","role":"collection"},"https://ios.unified-design-system.orange.com/documentation/ouds/themes":{"title":"This page may help","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","type":"link","titleInlineContent":[{"type":"text","text":"This page may help"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes"},"ic_component_intro.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"type":"image","identifier":"ic_component_intro.png","alt":null},"ic_theme_intro.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}],"identifier":"ic_theme_intro.png","type":"image","alt":null},"https://github.com/Orange-OpenSource/ouds-ios/wiki/50-%E2%80%90-About-versions,-releases-