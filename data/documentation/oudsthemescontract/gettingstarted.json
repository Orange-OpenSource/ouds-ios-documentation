{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started with OUDS","images":[{"identifier":"ic_unified_ds.png","type":"icon"},{"identifier":"ic_unified_ds.png","type":"card"}],"modules":[{"name":"Welcome to Orange Unified Design System"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Themes","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Modules"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"sections":[],"abstract":[{"text":"How to add the package as dependency, import libraries and use theme and components for your apps.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract"]]},"kind":"article","identifier":{"url":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Integrate OUDS","anchor":"Integrate-OUDS","level":2},{"type":"heading","text":"Use Swift Package Manager","anchor":"Use-Swift-Package-Manager","level":3},{"inlineContent":[{"type":"text","text":"If you want to add the iOS library of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Unified Design System"}]},{"text":", you need to add our ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package"}]},{"text":" into your project.","type":"text"},{"text":" ","type":"text"},{"text":"To do that, add a new ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"package dependency"}]},{"text":" to your ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Xcode"}]},{"text":" project by refering to it by ","type":"text"},{"code":"github.com\/Orange-OpenSource\/ouds-ios","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You are free to choose whether or not you want a branch or a specific tag, pick the solution you want.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds"},{"type":"text","text":" for more details about versions, releases and tags. You can find release tags (e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"1.0.0"}]},{"type":"text","text":") and release candidates tags (e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"1.0.0-rc3"}]},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Import the libraries you need","anchor":"Import-the-libraries-you-need","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You should use one (or several) of the following imports for your needs, which are basically "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package"}]},{"type":"text","text":" products."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets."}]}],"name":"Tip","type":"aside","style":"tip"},{"syntax":"swift","type":"codeListing","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeCompact \/\/ To use the Orange Compact theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"]},{"text":"Or more simple, import umbrella library","anchor":"Or-more-simple-import-umbrella-library","type":"heading","level":3},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements."},{"type":"text","text":" "},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}]}],"name":"Note","type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"Import the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package"}]},{"type":"text","text":" product which suits your needs:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Umbrella"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSSwiftUI"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above and all themes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above but with only Orange and Orange Compact themes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSSwiftUIWireframe"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above but with only Wireframe theme"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above but with only Orange and Sosh themes"}]}]]],"header":"row","type":"table"},{"text":"Special case of XCFramework","anchor":"Special-case-of-XCFramework","type":"heading","level":3},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The prefered solution to use OUDS is to use Swift Package Manager and pull sources from the repository to compile the project."},{"type":"text","text":" "},{"type":"text","text":"XCFramework can be used by picked assets from GitHub Releases artifacts."}]}],"name":"Note","type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"Two XCFrameworks are available: one containing "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":" ("},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and another with "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":" ("},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}]},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an XCFramework is used:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"add all the atomical XCFrameworks in the project (~10)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"import "},{"type":"codeVoice","code":"OUDSSwiftUIOrangeSosh"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OUDSSwiftUIOrange"}]}]}],"type":"unorderedList"},{"text":"Chose your theme","anchor":"Chose-your-theme","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Unified Design System"}]},{"type":"text","text":" framework provides today four themes:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Orange"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default one for Orange products and can be enriched \/ derivated"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Orange Compact"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For some Orange products with heavy \/ rich UI and dimensions constraints"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sosh"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For Sosh products"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wireframe"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles"}]}]]],"header":"row","type":"table"},{"text":"Apply a theme","anchor":"Apply-a-theme","type":"heading","level":3},{"numberOfColumns":2,"type":"row","columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/"},{"type":"text","text":"."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes"},{"type":"text","text":" also."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}],"size":1},{"content":[{"type":"codeListing","syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"]}],"size":1}]},{"numberOfColumns":2,"type":"row","columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"type":"text","text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want."}]}],"size":1},{"content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"]}],"size":1}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"."}]}],"name":"Tip","type":"aside","style":"tip"},{"text":"Trick for Xcode Preview","anchor":"Trick-for-Xcode-Preview","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"If you use Xcode "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Apply Orange theme","#Preview {","    SampleView()","        .orangePreview()","}","","\/\/ Apply Orange Compact theme","#Preview {","    SampleView()","        .orangeCompactPreview()","}","","\/\/ Apply Sosh theme","#Preview {","    SampleView()","        .soshPreview()","}","","\/\/ Apply Wireframe theme","#Preview {","    SampleView()","        .wireframePreview()","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudsthemescontract\/gettingstarted"]}],"references":{"https://ios.unified-design-system.orange.com/documentation/ouds/oudsthemeableview/":{"titleInlineContent":[{"code":"OUDSThemeableView","type":"codeVoice"}],"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","title":"OUDSThemeableView"},"https://github.com/Orange-OpenSource/ouds-ios/wiki/50-%E2%80%90-About-versions,-releases-and-builds":{"titleInlineContent":[{"text":"refer to the wiki","type":"text"}],"type":"link","url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","title":"refer to the wiki"},"ic_component_intro.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_component_intro.png"}],"alt":null,"identifier":"ic_component_intro.png"},"https://ios.unified-design-system.orange.com/documentation/ouds/themes":{"titleInlineContent":[{"text":"This page may help","type":"text"}],"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","title":"This page may help"},"ic_module_intro.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_module_intro.png"}],"alt":null,"identifier":"ic_module_intro.png"},"ic_unified_ds.png":{"type":"image","variants":[{"tra