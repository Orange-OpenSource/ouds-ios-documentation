release tags (e.g. ","type":"text"},{"inlineContent":[{"text":"1.0.0","type":"text"}],"type":"emphasis"},{"text":") and release candidates tags (e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"1.0.0-rc3"}],"type":"emphasis"},{"text":").","type":"text"}]},{"text":"Import the libraries you need","type":"heading","anchor":"Import-the-libraries-you-need","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should use one (or several) of the following imports for your needs, which are basically "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" products."}]},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets."}]}]},{"syntax":"swift","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeCompact \/\/ To use the Orange Compact theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"],"type":"codeListing"},{"text":"Or more simple, import umbrella library","type":"heading","anchor":"Or-more-simple-import-umbrella-library","level":3},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements.","type":"text"},{"text":" ","type":"text"},{"text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)","type":"text"},{"text":" ","type":"text"},{"text":"and useless constants.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Import the ","type":"text"},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"text":" product which suits your needs:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Umbrella"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"OUDSSwiftUI","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above and all themes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above but with only Orange and Orange Compact themes"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"OUDSSwiftUIWireframe","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above but with only Wireframe theme"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above but with only Orange and Sosh themes","type":"text"}],"type":"paragraph"}]]]},{"level":3,"text":"Special case of XCFramework","anchor":"Special-case-of-XCFramework","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The prefered solution to use OUDS is to use Swift Package Manager and pull sources from the repository to compile the project.","type":"text"},{"text":" ","type":"text"},{"text":"XCFramework can be used by picked assets from GitHub Releases artifacts.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two XCFrameworks are available: one containing "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":" ("},{"inlineContent":[{"text":"OUDSSwiftUIOrangeSosh","type":"text"}],"type":"emphasis"},{"type":"text","text":")"},{"text":" ","type":"text"},{"text":"and another with ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OrangeCompactTheme","type":"codeVoice"},{"type":"text","text":" ("},{"type":"emphasis","inlineContent":[{"text":"OUDSSwiftUIOrange","type":"text"}]},{"type":"text","text":")."}]},{"inlineContent":[{"text":"If an XCFramework is used:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"add all the atomical XCFrameworks in the project (~10)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"import "},{"code":"OUDSSwiftUIOrangeSosh","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSSwiftUIOrange","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Chose your theme","anchor":"Chose-your-theme","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Unified Design System"}]},{"type":"text","text":" framework provides today four themes:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Orange"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default one for Orange products and can be enriched \/ derivated"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Orange Compact","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For some Orange products with heavy \/ rich UI and dimensions constraints"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sosh"}]}],[{"type":"paragraph","inlineContent":[{"text":"For Sosh products","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wireframe"}]}],[{"type":"paragraph","inlineContent":[{"text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles","type":"text"}]}]]],"type":"table"},{"level":3,"type":"heading","text":"Apply a theme","anchor":"Apply-a-theme"},{"numberOfColumns":2,"columns":[{"size":1,"content":[{"inlineContent":[{"text":"You will need to use for your application root view the ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","isActive":true,"type":"reference"},{"text":" also.","type":"text"},{"text":" ","type":"text"},{"text":"This special view is here to define some elements as environment variables and injects the choosen theme.","type":"text"}],"type":"paragraph"}]},{"size":1,"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"type":"row"},{"numberOfColumns":2,"columns":[{"content":[{"inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"type":"text","text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want."}],"type":"paragraph"}],"size":1},{"content":[{"code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing","syntax":"swift"}],"size":1}],"type":"row"},{"content":[{"inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","name":"Tip","type":"aside"},{"type":"heading","anchor":"Trick-for-Xcode-Preview","text":"Trick for Xcode Preview","level":3},{"type":"paragraph","inlineContent":[{"text":"If you use Xcode ","type":"text"},{"type":"codeVoice","code":"#Preview"},{"text":" blocks, you will have to be sure the theme is instanciated and injected through the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because it is not possible today to override the legit ","type":"text"},{"type":"codeVoice","code":"#Preview"},{"text":" block, you can instead use some of our utilities to wrap your content","type":"text"},{"text":" ","type":"text"},{"text":"inside the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme.","type":"text"}]},{"type":"codeListing","code":["\/\/ Apply Orange theme","#Preview {","    SampleView()","        .orangePreview()","}","","\/\/ Apply Orange Compact theme","#Preview {","    SampleView()","        .orangeCompactPreview()","}","","\/\/ Apply Sosh theme","#Preview {","    SampleView()","        .soshPreview()","}","","\/\/ Apply Wireframe theme","#Preview {","    SampleView()","        .wireframePreview()","}"],"syntax":"swift"}],"kind":"content"}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Themes","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components