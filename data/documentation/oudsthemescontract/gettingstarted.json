","type":"text"}]}],"size":1},{"content":[{"syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing"}],"size":1}],"type":"row"},{"numberOfColumns":2,"type":"row","columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"Then get the current applied theme in your views and use the tokens you want.","type":"text"},{"type":"text","text":" "},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}]}]},{"content":[{"syntax":"swift","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing"}],"size":1}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"."}]}],"style":"tip","type":"aside","name":"Tip"},{"anchor":"Trick-for-Xcode-Preview","level":3,"type":"heading","text":"Trick for Xcode Preview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use Xcode "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}]},{"s