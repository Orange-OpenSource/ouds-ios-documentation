tags (e.g. "},{"inlineContent":[{"type":"text","text":"1.0.0-rc3"}],"type":"emphasis"},{"type":"text","text":")."}]},{"anchor":"Import-the-libraries-you-need","type":"heading","text":"Import the libraries you need","level":3},{"type":"paragraph","inlineContent":[{"text":"You should use one (or several) of the following imports for your needs, which are basically ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"text":" products.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"type":"codeListing","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeCompact \/\/ To use the Orange Compact theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"],"syntax":"swift"},{"anchor":"Or-more-simple-import-umbrella-library","type":"heading","text":"Or more simple, import umbrella library","level":3},{"content":[{"type":"paragraph","inlineContent":[{"text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}]}],"type":"aside","style":"note","name":"Note"},{"inlineContent":[{"text":"Import the ","type":"text"},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"text":" product which suits your needs:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Umbrella","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above and all themes"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"OUDSSwiftUIOrange","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above but with only Orange and Orange Compact themes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIWireframe"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above but with only Wireframe theme"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"OUDSSwiftUIOrangeSosh","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above but with only Orange and Sosh themes","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Special-case-of-XCFramework","level":3,"text":"Special case of XCFramework","type":"heading"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The prefered solution to use OUDS is to use Swift Package Manager and pull sources from the repository to compile the project."},{"type":"text","text":" "},{"type":"text","text":"XCFramework can be used by picked assets from GitHub Releases artifacts."}],"type":"paragraph"}],"style":"note","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Two XCFrameworks are available: one containing ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SoshTheme"},{"text":" (","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}]},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and another with ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OrangeCompactTheme"},{"text":" (","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}]},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If an XCFramework is used:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"add all the atomical XCFrameworks in the project (~10)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"import "},{"code":"OUDSSwiftUIOrangeSosh","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSSwiftUIOrange","type":"codeVoice"}]}]}]},{"type":"heading","text":"Chose your theme","anchor":"Chose-your-theme","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"Orange Unified Design System"}],"type":"emphasis"},{"text":" framework provides today four themes:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Orange","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The default one for Orange products and can be enriched \/ derivated"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Orange Compact","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For some Orange products with heavy \/ rich UI and dimensions constraints","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Sosh"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For Sosh products"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Wireframe","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles","type":"text"}],"type":"paragraph"}]]]},{"type":"heading","anchor":"Apply-a-theme","text":"Apply a theme","level":3},{"type":"row","columns":[{"size":1,"content":[{"inlineContent":[{"text":"You will need to use for your application root view the ","type":"text"},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","type":"reference"},{"text":" also.","type":"text"},{"text":" ","type":"text"},{"text":"This special view is here to define some elements as environment variables and injects the choosen theme.","type":"text"}],"type":"paragraph"}]},{"size":1,"content":[{"type":"codeListing","syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"]}]}],"numberOfColumns":2},{"type":"row","columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"Then get the current applied theme in your views and use the tokens you want.","type":"text"},{"text":" ","type":"text"},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}]}]},{"size":1,"content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"]}]}],"numberOfColumns":2},{"name":"Tip","type":"aside","content":[{"type":"paragraph","inlin