,"type":"text"}]},{"text":") and release candidates tags (e.g. ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"1.0.0-rc3","type":"text"}]},{"text":").","type":"text"}]},{"text":"Import the libraries you need","type":"heading","level":3,"anchor":"Import-the-libraries-you-need"},{"type":"paragraph","inlineContent":[{"text":"You should use one (or several) of the following imports for your needs, which are basically ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"text":" products.","type":"text"}]},{"type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets.","type":"text"}]}],"style":"tip"},{"type":"codeListing","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeCompact \/\/ To use the Orange Compact theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"],"syntax":"swift"},{"text":"Or more simple, import umbrella library","type":"heading","level":3,"anchor":"Or-more-simple-import-umbrella-library"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements.","type":"text"},{"text":" ","type":"text"},{"text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)","type":"text"},{"text":" ","type":"text"},{"text":"and useless constants.","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"Import the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"text":" product which suits your needs:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Umbrella","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUI","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above and all themes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIOrange","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above but with only Orange and Orange Compact themes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIWireframe","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above but with only Wireframe theme","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIOrangeSosh","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above but with only Orange and Sosh themes","type":"text"}]}]]]},{"text":"Special case of XCFramework","type":"heading","level":3,"anchor":"Special-case-of-XCFramework"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The prefered solution to use OUDS is to use Swift Package Manager and pull sources from the repository to compile the project.","type":"text"},{"text":" ","type":"text"},{"text":"XCFramework can be used by picked assets from GitHub Releases artifacts.","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"Two XCFrameworks are available: one containing ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SoshTheme","type":"codeVoice"},{"text":" (","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSSwiftUIOrangeSosh","type":"text"}]},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and another with ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OrangeCompactTheme","type":"codeVoice"},{"text":" (","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSSwiftUIOrange","type":"text"}]},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If an XCFramework is used:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"add all the atomical XCFrameworks in the project (~10)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"import ","type":"text"},{"code":"OUDSSwiftUIOrangeSosh","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"OUDSSwiftUIOrange","type":"codeVoice"}],"type":"paragraph"}]}]},{"level":3,"text":"Chose your theme","anchor":"Chose-your-theme","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"text":"Orange Unified Design System","type":"text"}],"type":"emphasis"},{"text":" framework provides today four themes:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Orange"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The default one for Orange products and can be enriched \/ derivated","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Orange Compact","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For some Orange products with heavy \/ rich UI and dimensions constraints","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Sosh","type":"text"}]}],[{"inlineContent":[{"text":"For Sosh products","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Wireframe","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"text":"Apply a theme","anchor":"Apply-a-theme","type":"heading"},{"columns":[{"content":[{"inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","isActive":true},{"type":"text","text":" also."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}],"type":"paragraph"}],"size":1},{"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"syntax":"swift","type":"codeListing"}],"size":1}],"numberOfColumns":2,"type":"row"},{"numberOfColumns":2,"columns":[{"content":[{"inlineContent":[{"text":"Then get the current applied theme in your views and use the tokens you want.","type":"text"},{"text":" ","type":"text"},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"syntax":"swift","type":"codeListing"}],"size":1}],"type":"row"},