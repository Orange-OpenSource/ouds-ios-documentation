{"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Themes","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Modules"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract"]]},"variants":[{"paths":["\/documentation\/oudsthemescontract\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"How to add the package as dependency, import libraries and use theme and components for your apps."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Integrate-OUDS","text":"Integrate OUDS"},{"type":"heading","level":3,"anchor":"Use-Swift-Package-Manager","text":"Use Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to add the iOS library of "},{"type":"emphasis","inlineContent":[{"text":"Orange Unified Design System","type":"text"}]},{"type":"text","text":", you need to add our "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" into your project."},{"type":"text","text":" "},{"type":"text","text":"To do that, add a new "},{"type":"emphasis","inlineContent":[{"text":"package dependency","type":"text"}]},{"type":"text","text":" to your "},{"type":"emphasis","inlineContent":[{"text":"Xcode","type":"text"}]},{"type":"text","text":" project by refering to it by "},{"code":"github.com\/Orange-OpenSource\/ouds-ios","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You are free to choose whether or not you want a branch or a specific tag, pick the solution you want."}]},{"type":"paragraph","inlineContent":[{"text":"You can ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","isActive":true,"type":"reference"},{"text":" for more details about versions, releases and tags. You can find release tags (e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"1.0.0"}],"type":"emphasis"},{"type":"text","text":") and release candidates tags (e.g. "},{"type":"emphasis","inlineContent":[{"text":"1.0.0-rc3","type":"text"}]},{"text":").","type":"text"}]},{"level":3,"anchor":"Import-the-libraries-you-need","type":"heading","text":"Import the libraries you need"},{"type":"paragraph","inlineContent":[{"text":"You should use one (or several) of the following imports for your needs, which are basically ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"type":"text","text":" products."}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets.","type":"text"}]}]},{"code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeCompact \/\/ To use the Orange Compact theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Or-more-simple-import-umbrella-library","type":"heading","text":"Or more simple, import umbrella library"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements."},{"type":"text","text":" "},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" product which suits your needs:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Umbrella"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUI"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above and all themes","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"All libraries listed above but with only Orange and Orange Compact themes","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIWireframe"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above but with only Wireframe theme"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All libraries listed above but with only Orange and Sosh themes"}]}]]],"header":"row"},{"anchor":"Special-case-of-XCFramework","type":"heading","level":3,"text":"Special case of XCFramework"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The prefered solution to use OUDS is to use Swift Package Manager and pull sources from the repository to compile the project."},{"type":"text","text":" "},{"type":"text","text":"XCFramework can be used by picked assets from GitHub Releases artifacts."}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two XCFrameworks are available: one containing "},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SoshTheme","type":"codeVoice"},{"type":"text","text":" ("},{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and another with "},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OrangeCompactTheme","type":"codeVoice"},{"type":"text","text":" ("},{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}],"type":"emphasis"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an XCFramework is used:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"add all the atomical XCFrameworks in the project (~10)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"import "},{"code":"OUDSSwiftUIOrangeSosh","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OUDSSwiftUIOrange","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Chose-your-theme","type":"heading","text":"Chose your theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Unified Design System"}]},{"type":"text","text":" framework provides today four themes:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Orange"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default one for Orange products and can be enriched \/ derivated"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Orange Compact"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For some Orange products with heavy \/ rich UI and dimensions constraints"}]}]],[[{"inlineContent":[{"type":"text","text":"Sosh"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For Sosh products"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Wireframe"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles"}],"type":"paragraph"}]]]},{"text":"Apply a theme","anchor":"Apply-a-theme","level":3,"type":"heading"},{"numberOfColumns":2,"columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes"},{"type":"text","text":" also."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}],"size":1},{"content":[{"syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing"}],"size":1}],"type":"row"},{"type":"row","columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"type":"text","text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want."}]}]},{"content":[{"syntax":"swift","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing"}],"size":1}],"numberOfColumns":2},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"text":"Trick for Xcode Preview","anchor":"Trick-for-Xcode-Preview","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you use Xcode "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}],"type":"paragraph"},{"code":["\/\/ Apply Orange theme","#Preview {","    SampleView()","        .orangePreview()","}","","\/\/ Apply Orange Compact theme","#Preview {","    SampleView()","        .orangeCompactPreview()","}","","\/\/ Apply Sosh theme","#Preview {","    SampleView()","        .soshPreview()","}","","\/\/ Apply Wireframe theme","#Preview {","    SampleView()","        .wireframePreview()","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","metadata":{"modules":[{"name":"Welcome to Orange Unified Design System"}],"title":"Getting Started with OUDS","roleHeading":"Article","images":[{"type":"icon","identifier":"ic_unified_ds.png"},{"type":"card","identifier":"ic_unified_ds.png"}],"role":"article"},"references":{"doc://OUDSThemesContract/documentation/OUDSThemesContract/Components":{"title":"Components","abstract":[{"type":"emphasis","inlineContent":[{"text":"Components","type":"text"}]},{"text":" are the ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" objects you can add in the views of your apps, like buttons, links, cards etc.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components","images":[{"type":"icon","identifier":"ic_component_intro.png"},{"type":"card","identifier":"ic_component_intro.png"}],"role":"article","url":"\/documentation\/oudsthemescontract\/components","kind":"article","type":"topic"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/Tokens":{"title":"Tokens","abstract":[{"text":"Design tokens represent the small, repeated design decisions that make up a design system’s visual style. Tokens wrap hard-coded static values, such as hexadecimal codes for color, with self-explanatory names. They are used to define the look and feel and the style of everything. They are exposed through the themes and can be used as they are.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","images":[{"identifier":"ic_design_token_intro.png","type":"icon"},{"identifier":"ic_design_token_intro.png","type":"card"}],"role":"article","url":"\/documentation\/oudsthemescontract\/tokens","kind":"article","type":"topic"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}],"alt":null,"type":"image"},"http