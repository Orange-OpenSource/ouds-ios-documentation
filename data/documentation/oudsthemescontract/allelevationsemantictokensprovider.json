vationCompositeSemanticTokens","isActive":true},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any elevation semantic token must be declared there (except "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true},{"type":"text","text":")"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationSemanticTokens","kind":"identifier"}],"kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationMultipleSemanticTokens":{"navigatorTitle":[{"text":"ElevationMultipleSemanticTokens","kind":"identifier"}],"role":"symbol","title":"ElevationMultipleSemanticTokens","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationMultipleSemanticTokens","url":"\/documentation\/oudstokenssemantic\/elevationmultiplesemantictokens","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":" but multiple so as to pack light and dark variants"},{"type":"text","text":" "},{"type":"text","text":"It wraps elevation colors as tokens."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationMultipleSemanticTokens","kind":"identifier"}],"kind":"symbol"},"doc://OUDSThemesContract/documentation/OUDSThemesContract":{"abstract":[{"text":"Orange Unified Design System: Build Sharper. Ship faster. Perform better.","type":"text"}],"role":"collection","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract","images":[{"type":"icon","identifier":"ic_unified_ds.png"}],"url":"\/documentation\/oudsthemescontract","kind":"symbol","title":"Welcome to Orange Unified Design System","type":"topic"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ElevationCompositeSemanticTokens":{"navigatorTitle":[{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"role":"symbol","title":"ElevationCompositeSemanticTokens","type":"topic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationCompositeSemanticTokens","url":"\/documentation\/oudstokenssemantic\/elevationcompositesemantictokens","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":", but only "},{"type":"strong","inlineContent":[{"type":"text","text":"composite tokens"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ElevationSemanticTokens","isActive":true},{"type":"text","text":" as the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" tool parsing "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."},{"type":"text","text":" "},{"type":"text","text":"It declares in fact box shadows effects."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"kind":"symbol"}}}