erence","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"navigatorTitle":[{"kind":"identifier","text":"OUDSTheme"}],"role":"symbol","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","url":"\/documentation\/oudsthemescontract\/oudstheme","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSTheme"}],"kind":"symbol","title":"OUDSTheme","type":"topic"},"doc://OUDSThemesContract/documentation/OUDSThemesContract":{"abstract":[{"text":"Orange Unified Design System: Build Sharper. Ship faster. Perform better.","type":"text"}],"role":"collection","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract","images":[{"type":"icon","identifier":"ic_unified_ds.png"}],"url":"\/documentation\/oudsthemescontract","kind":"symbol","title":"Welcome to Orange Unified Design System","type":"topic"},"ic_unified_ds.png":{"identifier":"ic_unified_ds.png","type":"image","alt":null,"variants":[{"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/documentation/OUDSThemesContract/OUDSThemeableView/init(theme:content:)":{"abstract":[],"role":"symbol","identifier":"doc:\/\/OUDSThemesContract\/documentation