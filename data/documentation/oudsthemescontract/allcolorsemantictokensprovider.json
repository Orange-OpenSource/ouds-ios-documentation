l providers and given to the theme for initialization","type":"text"}],"navigatorTitle":[{"text":"TokensProvider","kind":"identifier"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TokensProvider"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/TokensProvider","kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticTokens":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorSemanticTokens"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticTokens","navigatorTitle":[{"kind":"identifier","text":"ColorSemanticTokens"}],"title":"ColorSemanticTokens","url":"\/documentation\/oudstokenssemantic\/colorsemantictokens","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"colors","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorSemanticToken","type":"reference","isActive":true},{"type":"text","text":"  a theme must have."},{"type":"text","text":" "},{"type":"text","text":"These tokens are then gathered inside "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleColorSemanticToken","type":"reference","isActive":true},{"type":"text","text":" objects defined in "},{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/ColorMultipleSemanticTokens","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If it possible a theme won’t have such semantic tokens of colors defined as not specified nor used in Figma."},{"type":"text","text":" "},{"type":"text","text":"Thus the value for these tokens will be “ouds-forbidden-color-value” as returned by the tokenator."},{"text":" ","type":"text"},{"text":"Thus if the token is still used, even if explained in the documentation it should not,","type":"text"},{"text":" ","type":"text"},{"text":"this special value won’t be successfully parsed as color and the app will crash like expected.","type":"text"}],"kind":"symbol"},"doc://OUDSThemesContract/documentation/OUDSThemesContract/AllColorSemanticTokensProvider":{"title":"AllColorSemanticTokensProvider","url":"\/documentation\/oudsthemescontract\/allcolorsemantictokensprovider","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllColorSemanticTokensProvider","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"text":"Something which provides all semantic tokens of colors","type":"text"}],"navigatorTitle":[{"text":"AllColorSemanticTokensProvider","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/AllColorSemanticTokensProvider"},"doc://OUDSThemesContract/documentation/OUDSThemesContract":{"role":"collection","type":"topic","navigatorTitle":[{"kind":"text","text":"Welcome to Orange Unified Design System"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract","title":"Welcome to Orange Unified Design System","abstract":[{"text":"Orange Unified Design System: Build Sharper. Ship faster. Perform better.","type":"text"}],"url":"\/documentation\/oudsthemescontract","kind":"symbol","images":[{"identifier":"ic_unified_ds.png","type":"icon"}]},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/ColorSemanticToken":{"title":"ColorSemanticToken","role":"symbol","abstract":[{"type":"text","text":"Basically a color semantic  token is a "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSeman