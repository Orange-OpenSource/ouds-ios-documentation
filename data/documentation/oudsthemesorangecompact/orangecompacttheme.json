{"inlineContent":[{"text":"theme contract","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" is not a ","type":"text"},{"inlineContent":[{"text":"final","type":"text"}],"type":"emphasis"},{"text":" class, its type cannot be seen as ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", that is the reason why this conformity is unchecked.","type":"text"}],"type":"topic","url":"\/documentation\/oudsthemescontract\/oudstheme","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTheme","kind":"identifier"}],"identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/OUDSTheme","title":"OUDSTheme","navigatorTitle":[{"text":"OUDSTheme","kind":"identifier"}]},"doc://OUDSThemesOrangeCompact/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/OUDSThemesOrangeCompact\/s8SendableP","type":"unresolvable"},"doc://OUDSThemesOrangeCompact/documentation/OUDSThemesOrangeCompact":{"role":"collection","abstract":[{"text":"The Orange Compact theme is dedicated to applications with strong dimensions constraints.","type":"text"}],"type":"topic","url":"\/documentation\/oudsthemesorangecompact","kind":"symbol","images":[{"type":"icon","identifier":"ic_theme_orangecompact.png"}],"identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact","title":"Theme Orange Compact","navigatorTitle":[{"kind":"text","text":"Theme Orange Compact"}]}}}