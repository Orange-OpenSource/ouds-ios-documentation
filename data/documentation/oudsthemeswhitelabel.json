{"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Theme White Label","roleHeading":"Library","role":"collection","modules":[{"name":"Theme White Label"}],"symbolKind":"module","navigatorTitle":[{"kind":"text","text":"Theme White Label"}],"images":[{"identifier":"ic_theme_whitelabel.png","type":"icon"}],"externalID":"OUDSThemesWhiteLabel"},"variants":[{"paths":["\/documentation\/oudsthemeswhitelabel"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Group","identifiers":["doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme"],"anchor":"Group"},{"title":"Classes","identifiers":["doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelThemeBorderSemanticTokensProvider","doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelThemeColorSemanticTokensProvider"],"generated":true,"anchor":"Classes"},{"title":"Extended Modules","identifiers":["doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/SwiftUICore"],"generated":true,"anchor":"Extended-Modules"}],"identifier":{"url":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"This White Label theme is a specific theme. It has been designed to let users have their own theme to update like a grey label theme, or to keep as is like a white label theme."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The White Label theme is based on the Wireframe theme (which is dedicated to mockups and prototypes).","type":"text"},{"text":" ","type":"text"},{"text":"However it is possible to override the semantic tokens of colors, change the default border radius and choose the font family to apply.","type":"text"}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"The White Label theme, as a child of Wireframe theme does not embed by default charts colors nor decorative colors yet, but they can be defined.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"How to use the theme","level":2,"anchor":"How-to-use-the-theme"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme","type":"reference","isActive":true},{"text":" directly. To use the ","type":"text"},{"identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme","type":"reference","isActive":true},{"text":" without further modifications, you will have to use the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" for your root view and give it an instance of ","type":"text"},{"identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme","type":"reference","isActive":true},{"text":". Keep in mind the themes are ","type":"text"},{"inlineContent":[{"text":"Swift class objects","type":"text"}],"type":"emphasis"},{"text":" and can be heavy, so you may use only as instance as singleton and not store any properties.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: WhiteLabelTheme()) {","                \/\/ Your root view","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"]},{"type":"heading","text":"Typography","level":2,"anchor":"Typography"},{"type":"paragraph","inlineContent":[{"text":"The White Label theme uses the native system font family by default, but it can be defined otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"You will need to add to define the font family parameter of the theme.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Font family name fo which resources should be loaded and used then","let fontFamily = \"Winky Rough\" ","","let theme = WhiteLabelTheme(fontFamily: fontFamily)    "]},{"type":"paragraph","inlineContent":[{"text":"And register the fonts resources only one time:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["static var fontsAlreadyRegistered = false","","private func registerFonts() {","    if !Self.fontsAlreadyRegistered {","        registerFont(postScript: \"WinkyRough-Regular_Light\", forCombination: PSFNMK(fontFamily, Font.Weight.light))","        registerFont(postScript: \"WinkyRough-Regular\", forCombination: PSFNMK(fontFamily, Font.Weight.regular))","        registerFont(postScript: \"WinkyRough-Regular_Medium\", forCombination: PSFNMK(fontFamily, Font.Weight.medium))","        registerFont(postScript: \"WinkyRough-Regular_SemiBold\", forCombination: PSFNMK(fontFamily, Font.Weight.semibold))","        registerFont(postScript: \"WinkyRough-Regular_Bold\", forCombination: PSFNMK(fontFamily, Font.Weight.bold))","        registerFont(postScript: \"WinkyRough-Regular_Black\", forCombination: PSFNMK(fontFamily, Font.Weight.black))","        ","        let fonts = yourAppBundle.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach {","            CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil)","        }","        Self.fontsAlreadyRegistered = true","    }    ","}"]},{"type":"paragraph","inlineContent":[{"text":"The helper ","type":"text"},{"code":"registerFont(postScript:forCombination:)","type":"codeVoice"},{"text":" is an OUDS helper which will define the relationship between the font fmaily you use with a weight in one side, and the PostScript identifier of the font defined in the TTF in the other side.","type":"text"}]},{"type":"heading","text":"How to enrich the theme","level":2,"anchor":"How-to-enrich-the-theme"},{"type":"paragraph","inlineContent":[{"text":"Today for White Label theme only the colors, the font family and the tunning can be changed.","type":"text"},{"text":" ","type":"text"},{"text":"By default nor the Wireframe theme nor the White Label theme have colors decorative and color charts tokens.","type":"text"},{"text":" ","type":"text"},{"text":"If you want to define them you will have to define your own tokens providers.","type":"text"},{"text":" ","type":"text"},{"text":"The White Label theme uses the other tokens of colors of Wireframe theme; you can subclass it for your needs in you want.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class MyColorTokensProvider: WhiteLabelThemeColorSemanticTokensProvider {","","    \/\/ Give the values you want to the tokens you want","    \/\/ Some tokens have only one value...","    @objc override var repositoryInfoLow: ColorSemanticToken { ColorRawTokens.functionalSun200 }","    @objc override var repositoryInfoHighest: ColorSemanticToken { ColorRawTokens.functionalSun800 }","    ","    \/\/ ...and other tokens can have a pair of values, for light and dark modes","    @objc override var surfaceBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(light: repositoryInfoLow, dark: repositoryInfoHighest) }","}    "]},{"type":"heading","text":"How it looks like","level":2,"anchor":"How-it-looks-like"},{"type":"paragraph","inlineContent":[{"text":"To test your own White Label theme implementation, you can use for example the ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Add you own implementation for the tokens of ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox\/blob\/develop\/DesignToolbox\/DesignToolbox\/White%20Label%20Example\/White%20Label%20Theme%20Example.swift","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Then build and run the app and enjoy!","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["","\/\/ MARK: - Borders","","class DesignToolboxBorderSemanticTokensProvider: WhiteLabelThemeBorderSemanticTokensProvider {","    ","    override open var radiusDefault: BorderRadiusSemanticToken { BorderRawTokens.radius300 }","}","","let kDesignToolboxWhiteLabelBorders = DesignToolboxBorderSemanticTokensProvider()","    ","\/\/ MARK: - Fonts","","let kDesignToolboxWhiteLabelFontFamily = \"Winky Rough\"","","\/\/ To prevent to register each time the fonts and get warnings","var designToolboxWhiteLabelFontAlreadyRegistered = false","","func registerDesignToolboxWhiteLabelFonts() {","    if !designToolboxWhiteLabelFontAlreadyRegistered {","        registerFont(postScript: \"WinkyRough-Regular_Light\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.light))","        registerFont(postScript: \"WinkyRough-Regular\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.regular))","        registerFont(postScript: \"WinkyRough-Regular_Medium\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.medium))","        registerFont(postScript: \"WinkyRough-Regular_SemiBold\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.semibold))","        registerFont(postScript: \"WinkyRough-Regular_Bold\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.bold))","        registerFont(postScript: \"WinkyRough-Regular_Black\", forCombination: PSFNMK(kDesignToolboxWhiteLabelFontFamily, Font.Weight.black))","        ","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach {","            CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil)","        }","        ","        designToolboxWhiteLabelFontAlreadyRegistered = true","    }","}","","\/\/ MARK: - Colors (raw)","","enum DesignToolboxWhiteLabelRawColors {","","    static let bloodRed = \"#C0392BFF\"","    static let vividRed = \"#FF6B6BFF\"","    static let concreteGrey = \"#F0F0F0FF\"","    static let nearBlack = \"#1C1C1EFF\"","    static let softGrey = \"#E0E0E0FF\"","    static let deepGrey = \"#2C2C2EFF\"","    static let mutedLight = \"#6E6E73FF\"","    static let mutedDark = \"#8E8E93FF\"","    static let borderLight = \"#D0D0D0FF\"","}","","\/\/ MARK: - Colors (semantic)","","\/\/ Override the tokens you want","class DesignToolboxColorSemanticTokensProvider: WhiteLabelThemeColorSemanticTokensProvider {","","       override open var bgPrimary: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.concreteGrey, dark: DesignToolboxWhiteLabelRawColors.nearBlack)","       }","","       override open var bgSecondary: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.softGrey, dark: DesignToolboxWhiteLabelRawColors.deepGrey)","       }","","       override open var contentDefault: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.nearBlack, dark: DesignToolboxWhiteLabelRawColors.concreteGrey)","       }","","       override open var contentMuted: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.mutedLight, dark: DesignToolboxWhiteLabelRawColors.mutedDark)","       }","","       override open var contentBrandPrimary: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.bloodRed, dark: DesignToolboxWhiteLabelRawColors.vividRed)","       }","","       override open var actionEnabled: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.bloodRed, dark: DesignToolboxWhiteLabelRawColors.vividRed)","       }","","       override open var borderBrandPrimary: MultipleColorSemanticToken {","           MultipleColorSemanticToken(light: DesignToolboxWhiteLabelRawColors.bloodRed, dark: DesignToolboxWhiteLabelRawColors.vividRed)","       }","}","","let kDesignToolboxWhiteLabelColors = DesignToolboxColorSemanticTokensProvider()","","\/\/ MARK: - Theme instanciation","","let myDesignToolboxWhiteLabelTheme = WhiteLabelTheme(borders: kDesignToolboxWhiteLabelBorders,","                                                     colors: kDesignToolboxWhiteLabelColors,","                                                     name: kDesignToolboxWhiteLabelName,","                                                     fontFamily: kDesignToolboxWhiteLabelFontFamily)","","\/\/ MARK: - Inject the theme","","var body: some View {","    OUDSThemeableView(theme: myDesignToolboxWhiteLabelTheme) {","        YourAppContent()","    }","}"]}]}],"sections":[],"references":{"doc://OUDSThemesWhiteLabel/documentation/OUDSThemesWhiteLabel/SwiftUICore":{"kind":"symbol","url":"\/documentation\/oudsthemeswhitelabel\/swiftuicore","title":"SwiftUICore","identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/SwiftUICore","role":"collection","type":"topic","abstract":[]},"doc://OUDSThemesWhiteLabel/documentation/OUDSThemesWhiteLabel":{"kind":"symbol","url":"\/documentation\/oudsthemeswhitelabel","title":"Theme White Label","identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel","role":"collection","navigatorTitle":[{"text":"Theme White Label","kind":"text"}],"images":[{"identifier":"ic_theme_whitelabel.png","type":"icon"}],"type":"topic","abstract":[{"type":"text","text":"This White Label theme is a specific theme. It has been designed to let users have their own theme to update like a grey label theme, or to keep as is like a white label theme."}]},"ic_theme_whitelabel.png":{"identifier":"ic_theme_whitelabel.png","type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesWhiteLabel\/ic_theme_whitelabel.png"}]},"doc://OUDSThemesWhiteLabel/documentation/OUDSThemesWhiteLabel/WhiteLabelTheme":{"url":"\/documentation\/oudsthemeswhitelabel\/whitelabeltheme","abstract":[{"type":"text","text":"This White Label theme is a specific theme. It has been designed to let users have their own theme to update like a grey label theme, or to keep as is like a white label theme."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WhiteLabelTheme","kind":"identifier"}],"identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelTheme","title":"WhiteLabelTheme","type":"topic","navigatorTitle":[{"text":"WhiteLabelTheme","kind":"identifier"}],"kind":"symbol"},"doc://OUDSThemesWhiteLabel/documentation/OUDSThemesWhiteLabel/WhiteLabelThemeBorderSemanticTokensProvider":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WhiteLabelThemeBorderSemanticTokensProvider","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudsthemeswhitelabel\/whitelabelthemebordersemantictokensprovider","title":"WhiteLabelThemeBorderSemanticTokensProvider","identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelThemeBorderSemanticTokensProvider","role":"symbol","navigatorTitle":[{"text":"WhiteLabelThemeBorderSemanticTokensProvider","kind":"identifier"}],"type":"topic","abstract":[{"text":"A class which wraps all ","type":"text"},{"inlineContent":[{"text":"border semantic tokens","type":"text"}],"type":"strong"},{"text":" and expose them.","type":"text"},{"text":" ","type":"text"},{"text":"This provider should be integrated as a ","type":"text"},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"text":" implementation inside ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" so as to provide","type":"text"},{"text":" ","type":"text"},{"text":"all tokens to the users.","type":"text"}]},"https://github.com/Orange-OpenSource/ouds-ios-design-system-toolbox/blob/develop/DesignToolbox/DesignToolbox/White%20Label%20Example/White%20Label%20Theme%20Example.swift":{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox\/blob\/develop\/DesignToolbox\/DesignToolbox\/White%20Label%20Example\/White%20Label%20Theme%20Example.swift","type":"link","title":"White Label Theme Example","titleInlineContent":[{"type":"text","text":"White Label Theme Example"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox\/blob\/develop\/DesignToolbox\/DesignToolbox\/White%20Label%20Example\/White%20Label%20Theme%20Example.swift"},"doc://OUDSThemesWhiteLabel/documentation/OUDSThemesWhiteLabel/WhiteLabelThemeColorSemanticTokensProvider":{"url":"\/documentation\/oudsthemeswhitelabel\/whitelabelthemecolorsemantictokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"text":"color semantic tokens","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"multiple","type":"text"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WhiteLabelThemeColorSemanticTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/OUDSThemesWhiteLabel\/documentation\/OUDSThemesWhiteLabel\/WhiteLabelThemeColorSemanticTokensProvider","title":"WhiteLabelThemeColorSemanticTokensProvider","type":"topic","navigatorTitle":[{"text":"WhiteLabelThemeColorSemanticTokensProvider","kind":"identifier"}],"kind":"symbol"},"https://github.com/Orange-OpenSource/ouds-ios-design-system-toolbox":{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"link","title":"Design System Toolbox application","titleInlineContent":[{"type":"text","text":"Design System Toolbox application"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox"}}}