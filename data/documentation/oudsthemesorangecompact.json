{"topicSections":[{"anchor":"Group","identifiers":["doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"],"title":"Group"},{"anchor":"Classes","identifiers":["doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactThemeColorChartSemanticTokensProvider","doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactThemeColorDecorativeSemanticTokensProvider"],"title":"Classes","generated":true},{"generated":true,"identifiers":["doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/Foundation","doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/SwiftUICore"],"title":"Extended Modules","anchor":"Extended-Modules"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The Orange Compact theme is dedicated to applications with strong dimensions constraints.","type":"text"}],"metadata":{"role":"collection","images":[{"identifier":"ic_theme_orangecompact.png","type":"icon"}],"modules":[{"name":"Theme Orange Compact"}],"externalID":"OUDSThemesOrangeCompact","symbolKind":"module","roleHeading":"Library","title":"Theme Orange Compact"},"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"syntax":null,"code":["🧬 Theme version: 2.6.0"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Some products may have heavy and very rich user interfaces with a lot of components and elements to display and"},{"type":"text","text":" "},{"type":"text","text":"with which users can interact. Thus for such products there are specific constraints of dimensions, spaces and sizes."},{"type":"text","text":" "},{"type":"text","text":"That is the reason why this theme exists."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"This theme is related to Orange theme module to use some raw tokens of colors."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"It contains also colors dedicated to charts."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"The Orange Compact theme is read only: it cannot be suclassed or derivated."}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"anchor":"How-to-use-the-theme","level":2,"type":"heading","text":"How to use the theme"},{"inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme","isActive":true},{"type":"text","text":" directly. To use the "},{"type":"reference","identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme","isActive":true},{"type":"text","text":" without further modifications, you will have to use the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" for your root view and give it an instance of "},{"type":"reference","identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme","isActive":true},{"type":"text","text":". Keep in mind the themes are "},{"inlineContent":[{"type":"text","text":"Swift class objects"}],"type":"emphasis"},{"type":"text","text":" and can be heavy, so you may use only as instance as singleton and not store any properties."}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: OrangeCompactTheme()) {","                \/\/ Your root view","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This theme embeds and registers the fonts for the "},{"code":"Orange Compact","type":"codeVoice"},{"type":"text","text":" theme, you just need to use the theme object as is."}],"type":"paragraph"},{"anchor":"Tunable-theme","level":2,"type":"heading","text":"Tunable theme"},{"inlineContent":[{"type":"text","text":"The theme can be tuned with "},{"code":"Tuning","type":"codeVoice"},{"type":"text","text":" object to give at init."},{"type":"text","text":" "},{"type":"text","text":"Some tuning object exists."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Define your theme tuning","let tuning = Tuning(hasRoundedButtons: true, ","                    hasRoundedTextInputs: true, ","                    hasRoundedAlertMessages: true, ","                    hasRoundedProgressIndicators: true,","                    hasRoundedListItems: true)","","\/\/ Apply it to your theme","let theme = OrangeCompactTheme(tuning: tuning)","","\/\/ Or apply predefined tunings","let orangeFranceTheme = OrangeCompactTheme(tuning: Tuning.OrangeFrance)","let orangeBusinessTheme = OrangeCompactTheme(tuning: Tuning.OrangeBusiness)","let maxitTheme = OrangeCompactTheme(tuning: Tuning.MaxIt)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A default tuning is applied for this theme:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Tunable elements"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default values"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"rounded corners buttons"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ false"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"rounded corners text inputs"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ false"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"rounded corners alert messages"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ false"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"rounded corners progress indicators"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ false"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"rounded corners list items"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ false"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Typography","level":2,"type":"heading","text":"Typography"},{"anchor":"Helvetica-Neue","level":3,"type":"heading","text":"Helvetica Neue"},{"inlineContent":[{"type":"text","text":"The Orange theme uses "},{"inlineContent":[{"type":"text","text":"Helvetica Neue"}],"type":"emphasis"},{"type":"text","text":" typography. This font is already available through iOS."},{"type":"text","text":" "},{"type":"text","text":"It is possible to use another typography, by the ones recommended are the ones defined in tokens."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ The three following instanciations are the same","let theme = OrangeCompactTheme()","let theme = OrangeCompactTheme(fontFamily: OrangeBrandFontRawTokens.familyBrandDefault)","let theme = OrangeCompactTheme(fontFamily: \"HelveticaNeue\") \/\/ Which is PostScript name of the font","","\/\/ This instanciation won't work as the font family is not recognised","let theme = OrangeCompactTheme(fontFamily: \"Helvetica Neue\")"],"type":"codeListing"},{"anchor":"Other-fonts","level":3,"type":"heading","text":"Other fonts"},{"inlineContent":[{"type":"text","text":"However if, in very particular cases, you need to use another font family, you can try using it by changing the value in the theme init."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Supposing you want to use another font:","\/\/ - like the Luciole font (https:\/\/luciole-vision.com\/) (very good for accessibility)","\/\/ - or the Roboto font (https:\/\/fonts.google.com\/specimen\/Roboto) (to support cyrillic alphabet)","\/\/ - or hevletica Neue Arabic (for arabic alphabet Helvetica flavoured)","\/\/ 1. Add the TTF files in your project","    ","\/\/ 2. Register the fonts with, for example, the function below","private func registerFonts() {","    let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","    fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","}","","\/\/ 3. At theme init, given the font family name, add it to the theme.","\/\/ Keep in mind that it might not work because PostScript name is used combining","\/\/ font family name and font weight.","\/\/ For Luciole font, use \"Luciole\", for Roboto font, use \"Roboto\", etc.","let theme = OrangeCompactTheme(family: theFontFamilyNameInPostScript)"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"Specific rules to compute PostScript value are defined in "},{"type":"codeVoice","code":"PostScriptFontNamesMap.swift"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"If your font family is not well managed, you can "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true}],"type":"paragraph"}],"style":"tip","name":"Tip","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"For production products and official tools, "},{"type":"emphasis","inlineContent":[{"text":"Helvetica Neue","type":"text"}]},{"type":"text","text":" is preferred and should be used"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"If for your needs Helvetica Neue is not relevant (because does not support cyrilic, or not enough accessible, or not aligned with your needs), "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true}],"type":"paragraph"}],"style":"tip","name":"Tip","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"For ecodesign principles you should challenge the use of fonts because they can increase the needed storage of your apps"}],"type":"paragraph"}],"style":"note","name":"Caution","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"Always check the license and terms of uses of the font your are using (distribution, hsoting, usage for comemrcial things, etc.)"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"anchor":"How-to-enrich-the-theme","level":2,"type":"heading","text":"How to enrich the theme"},{"inlineContent":[{"type":"text","text":"You cannot derivate the "},{"inlineContent":[{"type":"text","text":"Orange Compact"}],"type":"emphasis"},{"type":"text","text":" theme."}],"type":"paragraph"},{"anchor":"How-it-looks-like","level":2,"type":"heading","text":"How it looks like"},{"anchor":"Actions","level":3,"type":"heading","text":"Actions"},{"inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_OrangeCompact.png"}],"type":"paragraph"},{"anchor":"Content-display","level":3,"type":"heading","text":"Content display"},{