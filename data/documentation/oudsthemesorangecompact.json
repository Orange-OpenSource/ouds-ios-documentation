{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"code":["🧬 Theme version: 2.8.0"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some products may have heavy and very rich user interfaces with a lot of components and elements to display and"},{"type":"text","text":" "},{"type":"text","text":"with which users can interact. Thus for such products there are specific constraints of dimensions, spaces and sizes."},{"type":"text","text":" "},{"type":"text","text":"That is the reason why this theme exists."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"This theme is related to Orange theme module to use some raw tokens of colors.","type":"text"}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It contains also colors dedicated to charts."}]}],"name":"Note","type":"aside"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"The Orange Compact theme is read only: it cannot be suclassed or derivated."}],"type":"paragraph"}],"name":"Important","type":"aside"},{"anchor":"How-to-use-the-theme","level":2,"type":"heading","text":"How to use the theme"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme","type":"reference"},{"text":" directly. To use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"},{"text":" without further modifications, you will have to use the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" for your root view and give it an instance of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"},{"text":". Keep in mind the themes are ","type":"text"},{"inlineContent":[{"text":"Swift class objects","type":"text"}],"type":"emphasis"},{"text":" and can be heavy, so you may use only as instance as singleton and not store any properties.","type":"text"}]},{"code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: OrangeCompactTheme()) {","                \/\/ Your root view","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:"}],"type":"paragraph"},{"code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This theme embeds and registers the fonts for the ","type":"text"},{"type":"codeVoice","code":"Orange Compact"},{"text":" theme, you just need to use the theme object as is.","type":"text"}],"type":"paragraph"},{"text":"Tunable theme","anchor":"Tunable-theme","level":2,"type":"heading"},{"inlineContent":[{"text":"The theme can be tuned with ","type":"text"},{"type":"codeVoice","code":"Tuning"},{"text":" object to give at init.","type":"text"},{"text":" ","type":"text"},{"text":"Some tuning object exists.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Define your theme tuning","let tuning = Tuning(hasRoundedButtons: true, ","                    hasRoundedTextInputs: true, ","                    hasRoundedAlertMessages: true, ","                    hasRoundedProgressIndicators: true,","                    hasRoundedListItems: true)","","\/\/ Apply it to your theme","let theme = OrangeCompactTheme(tuning: tuning)","","\/\/ Or apply predefined tunings","let orangeFranceTheme = OrangeCompactTheme(tuning: Tuning.OrangeFrance)","let orangeBusinessTheme = OrangeCompactTheme(tuning: Tuning.OrangeBusiness)","let maxitTheme = OrangeCompactTheme(tuning: Tuning.MaxIt)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A default tuning is applied for this theme:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Tunable elements","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default values"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners buttons"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners text inputs"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners alert messages"}]}],[{"type":"paragraph","inlineContent":[{"text":"❌ false","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners progress indicators"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"rounded corners list items","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]]],"header":"row","type":"table"},{"anchor":"Typography","text":"Typography","type":"heading","level":2},{"anchor":"Helvetica-Neue","text":"Helvetica Neue","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Orange theme uses "},{"type":"emphasis","inlineContent":[{"text":"Helvetica Neue","type":"text"}]},{"type":"text","text":" typography. This font is already available through iOS."},{"type":"text","text":" "},{"type":"text","text":"It is possible to use another typography, by the ones recommended are the ones defined in tokens."}]},{"code":["\/\/ The three following instanciations are the same","let theme = OrangeCompactTheme()","let theme = OrangeCompactTheme(fontFamily: OrangeBrandFontRawTokens.familyBrandDefault)","let theme = OrangeCompactTheme(fontFamily: \"HelveticaNeue\") \/\/ Which is PostScript name of the font","","\/\/ This instanciation won't work as the font family is not recognised","let theme = OrangeCompactTheme(fontFamily: \"Helvetica Neue\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Other-fonts","text":"Other fonts","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"However if, in very particular cases, you need to use another font family, you can try using it by changing the value in the theme init.","type":"text"}]},{"code":["\/\/ Supposing you want to use another font:","\/\/ - like the Luciole font (https:\/\/luciole-vision.com\/) (very good for accessibility)","\/\/ - or the Roboto font (https:\/\/fonts.google.com\/specimen\/Roboto) (to support cyrillic alphabet)","\/\/ - or Helvetica Neue Arabic (for the Arabic alphabet, in a Helvetica style)","\/\/ 1. Add the TTF files in your project","    ","\/\/ 2. Register the fonts with, for example, the function below","private func registerFonts() {","    let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","    fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","}","","\/\/ 3. At theme init, given the font family name, add it to the theme.","\/\/ Keep in mind that it might not work because PostScript name is used combining","\/\/ font family name and font weight.","\/\/ For Luciole font, use \"Luciole\", for Roboto font, use \"Roboto\", etc.","let theme = OrangeCompactTheme(family: theFontFamilyNameInPostScript)"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"Specific rules to compute PostScript value are defined in "},{"type":"codeVoice","code":"PostScriptFontNamesMap.swift"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your font family is not well managed, you can ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true,"type":"reference"}]}],"style":"tip","type":"aside","name":"Tip"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"For production products and official tools, ","type":"text"},{"inlineContent":[{"text":"Helvetica Neue","type":"text"}],"type":"emphasis"},{"text":" is preferred and should be used","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"If for your needs Helvetica Neue is not relevant (because does not support cyrilic, or not enough accessible, or not aligned with your needs), "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Caution","content":[{"type":"paragraph","inlineContent":[{"text":"For ecodesign principles you should challenge the use of fonts because they can increase the needed storage of your apps","type":"text"}]}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the license and terms of uses of the font your are using (distribution, hsoting, usage for comemrcial things, etc.)"}]}]},{"type":"heading","level":2,"anchor":"How-to-enrich-the-theme","text":"How to enrich the theme"},{"type":"paragraph","inlineContent":[{"text":"You cannot derivate the ","type":"text"},{"inlineContent":[{"type":"text","text":"Orange Compact"}],"type":"emphasis"},{"text":" theme.","type":"text"}]},{"type":"heading","level":2,"anchor":"How-it-looks-like","text":"How it looks like"},{"type":"heading","level":3,"anchor":"Actions","text":"Actions"},{"type":"heading","level":4,"anchor":"Buttons","text":"Buttons"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_OrangeCompact.png"}]},{"type":"heading","level":3,"anchor":"Content-display","text":"Content display"},{"type":"heading","level":4,"anchor":"Bullet-list","text":"Bullet list"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_bullet_list_OrangeCompact.png"}]},{"type":"heading","level":3,"anchor":"Controls","text":"Controls"},{"type":"heading","level":4,"anchor":"Checkboxes","text":"Checkboxes"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkbox_OrangeCompact.png"}]}],"title":"Checkbox"},{"content":[{"inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkboxItem_OrangeCompact.png","type":"image"}],"type":"paragraph"}],"title":"Checkbox item"}],"type":"tabNavigator"},{"level":4,"anchor":"Chips","text":"Chips","type":"heading"},{"tabs":[{"title":"Filter chip","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_filterChip_OrangeCompact.png"}]}]},{"title":"Suggestion chip","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-de