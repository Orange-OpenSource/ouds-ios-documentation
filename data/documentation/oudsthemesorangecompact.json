{"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/oudsthemesorangecompact"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The Orange Compact theme is dedicated to applications with strong dimensions constraints."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Library","externalID":"OUDSThemesOrangeCompact","modules":[{"name":"Theme Orange Compact"}],"symbolKind":"module","role":"collection","title":"Theme Orange Compact","images":[{"identifier":"ic_theme_orangecompact.png","type":"icon"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"code":["🧬 Theme version: 2.5.0"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"Some products may have heavy and very rich user interfaces with a lot of components and elements to display and","type":"text"},{"text":" ","type":"text"},{"text":"with which users can interact. Thus for such products there are specific constraints of dimensions, spaces and sizes.","type":"text"},{"text":" ","type":"text"},{"text":"That is the reason why this theme exists.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"This theme is related to Orange theme module to use some raw tokens of colors."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"It contains also colors dedicated to charts.","type":"text"}]}],"type":"aside","name":"Note"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Orange Compact theme is read only: it cannot be suclassed or derivated."}]}],"name":"Important"},{"level":2,"type":"heading","anchor":"How-to-use-the-theme","text":"How to use the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"},{"type":"text","text":" directly. To use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"},{"type":"text","text":" without further modifications, you will have to use the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" for your root view and give it an instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSThemesOrangeCompact\/documentation\/OUDSThemesOrangeCompact\/OrangeCompactTheme"},{"type":"text","text":". Keep in mind the themes are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift class objects"}]},{"type":"text","text":" and can be heavy, so you may use only as instance as singleton and not store any properties."}]},{"type":"codeListing","syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: OrangeCompactTheme()) {","                \/\/ Your root view","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:"}]},{"type":"codeListing","syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This theme embeds and registers the fonts for the "},{"code":"Orange Compact","type":"codeVoice"},{"type":"text","text":" theme, you just need to use the theme object as is."}]},{"level":2,"type":"heading","anchor":"Tunable-theme","text":"Tunable theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The theme can be tuned with "},{"code":"Tuning","type":"codeVoice"},{"type":"text","text":" object to give at init."},{"type":"text","text":" "},{"type":"text","text":"Some tuning object exists."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Define your theme tuning","let tuning = Tuning(hasRoundedButtons: true, hasRoundedTextInputs: true, hasRoundedAlertMessages: true)","","\/\/ Apply it to your theme","let theme = OrangeCompactTheme(tuning: tuning)","\/\/ Or in one line","let theme = OrangeCompactTheme(tuning: Tuning(hasRoundedButtons: true, hasRoundedTextInputs: true, hasRoundedAlertMessages: true))","","\/\/ Or apply predefined tunings","let orangeFranceTheme = OrangeCompactTheme(tuning: Tuning.OrangeFrance)","let orangeBusinessTheme = OrangeCompactTheme(tuning: Tuning.OrangeBusiness)","let maxitTheme = OrangeCompactTheme(tuning: Tuning.MaxIt)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default tuning is applied for this theme:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tunable elements"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default values"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners buttons"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners text inputs"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ true"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"rounded corners alert messages"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ false"}]}]]]},{"level":2,"type":"heading","anchor":"Typography","text":"Typography"},{"level":3,"type":"heading","anchor":"Helvetica-Neue","text":"Helvetica Neue"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Orange theme uses "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Helvetica Neue"}]},{"type":"text","text":" typography. This font is already available through iOS."},{"type":"text","text":" "},{"type":"text","text":"It is possible to use another typography, by the ones recommended are the ones defined in tokens."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ The three following instanciations are the same","let theme = OrangeCompactTheme()","let theme = OrangeCompactTheme(fontFamily: OrangeBrandFontRawTokens.familyBrandDefault)","let theme = OrangeCompactTheme(fontFamily: \"HelveticaNeue\") \/\/ Which is PostScript name of the font","","\/\/ This instanciation won't work as the font family is not recognised","let theme = OrangeCompactTheme(fontFamily: \"Helvetica Neue\")"]},{"level":3,"type":"heading","anchor":"Other-fonts","text":"Other fonts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"However if, in very particular cases, you need to use another font family, you can try using it by changing the value in the theme init."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Supposing you want to use another font:","\/\/ - like the Luciole font (https:\/\/luciole-vision.com\/) (very good for accessibility)","\/\/ - or the Roboto font (https:\/\/fonts.google.com\/specimen\/Roboto) (to support cyrillic alphabet)","\/\/ - or hevletica Neue Arabic (for arabic alphabet Helvetica flavoured)","\/\/ 1. Add the TTF files in your project","    ","\/\/ 2. Register the fonts with, for example, the function below","private func registerFonts() {","    let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","    fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","}","","\/\/ 3. At theme init, given the font family name, add it to the theme.","\/\/ Keep in mind that it might not work because PostScript name is used combining","\/\/ font family name and font weight.","\/\/ For Luciole font, use \"Luciole\", for Roboto font, use \"Roboto\", etc.","let theme = OrangeCompactTheme(family: theFontFamilyNameInPostScript)"]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specific rules to compute PostScript value are defined in "},{"type":"codeVoice","code":"PostScriptFontNamesMap.swift"}]}],"name":"Note"},{"style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If your font family is not well managed, you can "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues"}]}],"name":"Tip"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For production products and official tools, "},{"type":"emphasis","inlineContent":[{"text":"Helvetica Neue","type":"text"}]},{"type":"text","text":" is preferred and should be used"}]}],"name":"Important"},{"style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If for your needs Helvetica Neue is not relevant (because does not support cyrilic, or not enough accessible, or not aligned with your needs), "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions"}]}],"name":"Tip"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For ecodesign principles you should challenge the use of fonts because they can increase the needed storage of your apps"}]}],"name":"Caution"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the license and terms of uses of the font your are using (distribution, hsoting, usage for comemrcial things, etc.)"}]}],"name":"Important"},{"level":2,"type":"heading","anchor":"How-to-enrich-the-theme","text":"How to enrich the theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot derivate the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Orange Compact"}]},{"type":"text","text":" theme."}]},{"level":2,"type":"heading","anchor":"How-it-looks-like","text":"How it looks like"},{"level":3,"type":"heading","anchor":"Actions","text":"Actions"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_OrangeCompact.png"}]},{"level":3,"type":"heading","anchor":"Content-display","text":"Content display"},{"level":4,"type":"heading","anchor":"Bullet-list","text":"Bullet list"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_bullet_list_OrangeCompact.png"}]},{"level":3,"type":"heading","anchor":"Controls","text":"Controls"},{"level":4,"type":"heading","anchor":"Checkboxes","text":"Checkboxes"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkbox_OrangeCompact.png","type":"image"}]}],"title":"Checkbox"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_checkboxItem_OrangeCompact.png","type":"image"}]}],"title":"Checkbox item"}]},{"level":4,"type":"heading","anchor":"Radios","text":"Radios"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_radio_OrangeCom