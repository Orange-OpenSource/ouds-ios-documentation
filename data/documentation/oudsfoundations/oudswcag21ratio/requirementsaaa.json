ended for mobile devices because of screen size and luminosity issues; this means a 7:1 ratio for text.","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"text":" ","type":"text"},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true,"type":"reference"}]},"ic_layers.png":{"alt":null,"identifier":"ic_layers.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSFoundations\/ic_layers.png"}],"type":"image"},"doc://OUDSFoundations/documentation/OUDSFoundations":{"type":"topic","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations","title":"Foundations","url":"\/documentation\/oudsfoundations","kind":"symbol","images":[{"identifier":"ic_layers.png","type":"icon"}],"role":"collection","abstract":[{"text":"Contains a set of helpers and extensions shared for higher level targets.","type":"text"}]}}}