ues, i.e. 7:1 for textual","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"text":" ","type":"text"},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true,"type":"reference"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/WCAG21Requirements":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"WCAG21Requirements"}],"title":"WCAG21Requirements","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/oudsfoundations\/wcag21requirements","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/WCAG21Requirements","navigatorTitle":[{"kind":"identifier","text":"WCAG21Requirements"}],"abstract":[{"text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components","type":"text"}]},"doc://OUDSFoundations/documentation/OUDSFoundations":{"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations","images":[{"identifier":"ic_layers.png","type":"icon"}],"type":"topic","kind":"symbol","url":"\/documentation\/oudsfoundations","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"title":"Foundations","role":"collection"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio/requirementsAAA":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requirementsAAA","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WCAG21Requirements","kind":"typeIdentifier","preciseIdentifier":"s:15OUDSFoundations18WCAG21Requirementsa"}],"title":"requirementsAAA","role":"symbol","type":"topic","url":"\/documentation\/oudsfoundations\/oudswcag21ratio\/requirementsaaa","kind":"sym