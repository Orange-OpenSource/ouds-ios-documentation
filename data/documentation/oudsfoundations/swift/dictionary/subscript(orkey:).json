y does not exist, the only the key is returned","    let keyDoesNotExist = myDict[PSFNMK(\"Luciole\", Font.Weight.bold)] \/\/ Luciole"],"type":"codeListing"}]}],"references":{"doc://OUDSFoundations/documentation/OUDSFoundations/Swift":{"title":"Swift","abstract":[],"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/Swift","url":"\/documentation\/oudsfoundations\/swift"},"doc://OUDSFoundations/documentation/OUDSFoundations":{"title":"Foundations","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"role":"collection","navigatorTitle":[{"text":"Foundations","kind":"text"}],"type":"topic","images":[{"type":"icon","identifier":"ic_layers.png"}],"kind":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations","url":"\/documentation\/oudsfoundations"},"doc://OUDSFoundations/documentation/OUDSFoundations/Swift/Dictionary/subscript(orKey:)":{"title":"subscript(orKey:)","abstract":[{"type":"text","text":"If there is no value for the given "},{"type":"codeVoice","code":"key"},{"type":"text","text":", returns the description of this key,"},{"type":"text","text":" "},{"type":"text","text":"i.e.font family name without the font weight in the end and without whitespaces."}],"role":"symbol","type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" is "},{"type":"codeVoice","code":"PostScriptFontNamesMapKey"},{"type":"text","text":" and "},{"code":"Value","type":"codeVoice"},{"type":"text","text":" is "},{"code":"String","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/Swift\/Dictionary\/subscript(orKey:)","kind":"symbol","fragments":[{"kind":"keyword","text":"subscript"},{"text":"(","kind":"text