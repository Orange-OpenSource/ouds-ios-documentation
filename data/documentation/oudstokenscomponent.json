tch components like "},{"type":"codeVoice","code":"OUDSSwitch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OUDSSwitchItem"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"tag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For tag components like "},{"type":"codeVoice","code":"OUDSTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"inputTag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For input tag components like "},{"type":"codeVoice","code":"OUDSInputTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"textArea"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For text area components like "},{"type":"codeVoice","code":"OUDSTextArea"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"textInput"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For text field input components like "},{"type":"codeVoice","code":"OUDSTextInput"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"typography"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For textual components like "},{"type":"codeVoice","code":"OUDSText"}],"type":"paragraph"}]]],"header":"row","type":"table"}]}],"kind":"symbol","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"type":"text","text":" are defined for components and refer to semantic tokens or raw tokens."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as a kind of bridge between components and in the end primitive values of the design kit."}],"variants":[{"paths":["\/documentation\/oudstokenscomponent"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://OUDSTokensComponent/documentation/OUDS