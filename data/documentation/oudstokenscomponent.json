{"abstract":[{"text":"These ","type":"text"},{"inlineContent":[{"text":"tokens","type":"text"}],"type":"emphasis"},{"text":" are defined for components and refer to semantic tokens or raw tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as a kind of bridge between components and in the end primitive values of the design kit.","type":"text"}],"topicSections":[{"title":"Group","identifiers":["doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/AccordionComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/AccordionFaqComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/AlertComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/BarComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/BadgeComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/BulletListComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ButtonComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ButtonMonoComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/CheckboxComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ChipComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/DividerComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/IconComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/LinkComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/LinkMonoComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ListItemComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/PinCodeInputComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ProgressIndicatorComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/QuantityInputComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/RadioButtonComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/SelectInputComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/SkeletonComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/SwitchComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/TagComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/InputTagComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/TextAreaComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/TextInputComponentTokens","doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/TypographyComponentTokens"],"anchor":"Group"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Library","role":"collection","externalID":"OUDSTokensComponent","images":[{"identifier":"ic_design_token_figma_component.png","type":"icon"}],"symbolKind":"module","modules":[{"name":"Tokens for components"}],"title":"Tokens for components"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"syntax":null,"code":["🧬 Core version: 1.10.0"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Thus if a component need to change for example its ","type":"text"},{"inlineContent":[{"text":"background color","type":"text"}],"type":"emphasis"},{"text":", and if a ","type":"text"},{"inlineContent":[{"text":"component token","type":"text"}],"type":"emphasis"},{"text":" is used for it, then only the value of this ","type":"text"},{"inlineContent":[{"text":"token","type":"text"}],"type":"emphasis"},{"text":" should be changed without any modification on the ","type":"text"},{"inlineContent":[{"text":"component","type":"text"}],"type":"emphasis"},{"text":" definition.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Components","type":"text"}],"type":"emphasis"},{"text":" use ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"text":" exposed through the ","type":"text"},{"inlineContent":[{"text":"theme","type":"text"}],"type":"emphasis"},{"text":" thanks to token providers to get their style values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Components tokens are defined and gathered inside ","type":"text"},{"inlineContent":[{"text":"Swift protocol","type":"text"}],"type":"emphasis"},{"text":" so as to be exposed then through implementation of ","type":"text"},{"code":"OUDSTheme","type":"codeVoice"},{"text":" thanks to dedicated tokens providers.","type":"text"},{"text":" ","type":"text"},{"text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in ","type":"text"},{"inlineContent":[{"text":"protocols","type":"text"}],"type":"emphasis"},{"text":" and defined in ","type":"text"},{"inlineContent":[{"text":"extensions","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That is the reason why tokens are exposed as ","type":"text"},{"code":"@objc open","type":"codeVoice"},{"text":" to be available and overridable anywhere.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent\/ButtonComponentTokens","type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class OrangeThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension OrangeThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through OUDSTheme as an AllButtonComponentTokensProvider"],"type":"codeListing"},{"level":2,"anchor":"How-to-use-component-tokens","type":"heading","text":"How to use component tokens"},{"type":"paragraph","inlineContent":[{"text":"In fact, the component tokens are declared and gathered in ","type":"text"},{"inlineContent":[{"text":"Swift protocol","type":"text"}],"type":"emphasis"},{"text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers.","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"text":" have for values ","type":"text"},{"inlineContent":[{"text":"raw tokens","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"semantic tokens","type":"text"}],"type":"emphasis"},{"text":", and in the end for values primitive types, and all these tokens are declared with ","type":"text"},{"inlineContent":[{"text":"type aliases","type":"text"}],"type":"emphasis"},{"text":" refering all together, you can handle a ","type":"text"},{"inlineContent":[{"text":"component token","type":"text"}],"type":"emphasis"},{"text":" directly in your view because the final value will be used.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, get the theme and call the needed property with some helpers.","type":"text"}]},{"syntax":"swift","code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `OUDSThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `OUDSThemeableView` for your theme, e.g. `OrangeTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The components tokens are wrapped in tokens provider accessible through the themes:","type":"text"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Components tokens provider","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Target component","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"accordion \/ accordionFaq","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For accordions components","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"alert","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For alert mesdsages and inline alert components like ","type":"text"},{"type":"codeVoice","code":"OUDSAlertMessage"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSInlineAlert"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"bar","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For bars components like bottom and navigation bars","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"badge","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For badges like ","type":"text"},{"type":"codeVoice","code":"OUDSBadgeStandard"},{"text":", ","type":"text"},{"type":"codeVoice","code":"OUDSBadgeIcon"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSBadgeCount"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"button","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For buttons like ","type":"text"},{"type":"codeVoice","code":"OUDSButton"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"bulletList","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For list of elements with bullets like ","type":"text"},{"type":"codeVoice","code":"OUDSBulletList"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"checkbox","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For checkboxes like ","type":"text"},{"type":"codeVoice","code":"OUDSCheckbox"},{"text":", ","type":"text"},{"type":"codeVoice","code":"OUDSCheckboxItem"},{"text":" and their indeterminate variants","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"chip","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For chips like ","type":"text"},{"type":"codeVoice","code":"OUDSSuggestionChip"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSFilterChip"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"divider","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For dividers like ","type":"text"},{"type":"codeVoice","code":"OUDSHorizontalDivider"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSVerticalDivider"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"icon","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For components containing icons like ","type":"text"},{"type":"codeVoice","code":"OUDSTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"link","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For links like ","type":"text"},{"type":"codeVoice","code":"OUDSLink"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"listItem","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared and used for switch, checkbox, radio items and list items layouts","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"pinCodeInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"quantityInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"radioButton","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For radio components like ","type":"text"},{"type":"codeVoice","code":"OUDSRadio"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSRadioItem"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"selectInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"skeleton","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"switch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For switch components like ","type":"text"},{"type":"codeVoice","code":"OUDSSwitch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OUDSSwitchItem"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"tag","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For tag components like ","type":"text"},{"type":"codeVoice","code":"OUDSTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"inputTag","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For input tag components like ","type":"text"},{"type":"codeVoice","code":"OUDSInputTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"textArea","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For text area components like ","type":"text"},{"type":"codeVoice","code":"OUDSTextArea"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"textInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For text field input components like ","type":"text"},{"type":"codeVoice","code":"OUDSTextInput"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"typography","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For textual components like ","type":"text"},{"type":"codeVoice","code":"OUDSText"}],"type":"paragraph"}]]],"type":"table"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/oudstokenscomponent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"url":"doc:\/\/OUDSTokensComponent\/documentation\/OUDSTokensComponent","interfaceLanguage":"swift"},"references":{"doc://OUDSTokensComponent/documentation/OUDS