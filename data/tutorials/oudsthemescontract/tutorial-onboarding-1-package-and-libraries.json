oarding-3-components-showcase#Merge-components-in-a-richer-view","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources"}]}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)"},"kind":"project","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[{"estimatedTimeInMinutes":10,"title":"Swift Package integration","kind":"hero","xcodeRequirement":"Xcode 26.5","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}]}],"projectFiles":"OUDS-Onboarding-Tutorial.zip","backgroundImage":"ic_unified_ds.png","chapter":"Import of the Swift Package and choose its libraries","image":"ic_unified_ds.png"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"OUDS for iOS is an open source Swift Package available on GitHub under MIT license."},{"type":"text","text":" "},{"type":"text","text":"The package and the libraries must be added through Xcode."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Import the Swift Package and the libraries","stepsSection":[{"content":[{"inlineContent":[{"text":"Using Xcode, in your ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"project package dependencies"}]},{"text":", add a new ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"dependency"}]},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Search with the GitHub repository URL (https:\/\/github.com\/Orange-OpenSource\/ouds-ios), and select the "},{"type":"emphasis","inlineContent":[{"text":"ouds-ios","type":"text"}]},{"type":"text","text":" dependency."},{"type":"text","text":" "},{"type":"text","text":"You can then choose the "},{"type":"strong","inlineContent":[{"text":"dependency rule","type":"text"}]},{"type":"text","text":" you want."},{"type":"text","text":" "},{"type":"text","text":"To know which version you need, you can have a look on the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/01-%E2%80%90-Available-API","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and also the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/releases","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"code":null,"runtimePreview":null,"media":"tutorial-onboarding-1-ouds-swift-package.png","type":"step","caption":[{"inlineContent":[{"text":"Let’s say you will use the some beta version, here 3.0.0-beta.8","type":"text"}],"type":"paragraph"}]},{"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Once you downloaded the package, you will see several libraries are available.","type":"text"},{"text":" ","type":"text"},{"text":"They can be embedded inside your ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"target"}]},{"text":" libraries.","type":"text"},{"text":" ","type":"text"},{"text":"Things are separated to let users integrate only what they need and embed the bare minimum of content.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSThemesContract","type":"text"}]},{"text":" library provides the main elements like the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":". The theme contract is defined inside it.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSThemesOrange"}],"type":"emphasis"},{"text":" provides the theme implementation for the Orange products, and contains also assets and all tokens for this theme.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSThemesSosh"}],"type":"emphasis"},{"text":" provides the theme implementation for the Sosh products, and contains also assets and all tokens for this theme.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"OUDSThemesWireframe","type":"text"}],"type":"emphasis"},{"text":" provides the theme implementation for the Wireframe theme, which is a theme dedicated to mockups and prototypes.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"OUDSThemesOrangeCompact","type":"text"}],"type":"emphasis"},{"text":" provides the theme implementation for the Orange products but with constraints of sizes and spaces.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSComponents"}],"type":"emphasis"},{"text":" contains the SwiftUI OUDS components defined with the Figma specifications, and also useful view modifers.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"OUDSTokensRaw","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"OUDSTokensSemantic","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSTokensComponents"}],"type":"emphasis"},{"text":" are libraries defining and providing the tokens for low level (raw),","type":"text"},{"text":" ","type":"text"},{"text":"middle level (semantic) or component levels (high level).","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSModules"}],"type":"emphasis"},{"text":" is for modules or rich components with extra logic.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"OUDSFoundations","type":"text"}],"type":"emphasis"},{"text":" is dedicated to some utilities and shared logic.","type":"text"}],"type":"paragraph"}],"media":"tutorial-onboarding-1-ouds-libraries.png","code":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Add for example only the umbrella product merging all products mentioned above: ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSSwiftUI"}],"type":"emphasis"}]}]}],"anchor":"Import-the-Swift-Package-and-the-libraries"}]},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Which of these choices is correct?"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"justification":[{"inlineContent":[{"text":"OUDS is open source, under MIT license, and hosted on GitHub. Of course you can contribute!","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"I can contribute to OUDS using pull request"}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"The main supported targets are iOS \/ iPadOS. However we do our best to support macOS, visionOS, tvOS and watchOS."},{"type":"text","text":" "},{"type":"text","text":"CarPlay specific cases are not scoped yet."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"OUDS supports officialy all Apple OS like visionOS, tvOS, watchOS, iPadOS, iOS and also CarPlay."}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"OUDS supports only SwiftUI."}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"OUDS provides UIKit components","type":"text"}],"type":"paragraph"}]}],"type":"multiple-choice"},{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Which imports of the OUDS Swift Package products can I choose?"}],"type":"paragraph"}],"choices":[{"justification":[{"inlineContent":[{"text":"You can import all products provided by the Swift Package, and tailor your choice to keep only the ones needed.","type":"text"},{"text":" ","type":"text"},{"text":"Even if we recommend to choose only the atomic products you need, the ","type":"text"},{"code":"OUDSSwiftUI","type":"codeVoice"},{"text":" product wraps all of them.","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some of the available products depending to my needs, or only "},{"type":"codeVoice","code":"OUDSSwiftUI"},{"text":" if I am very lazy and don’t care about my app size.","type":"text"}]}],"isCorrect":true},{"justification":[{"type":"paragraph","inlineContent":[{"text":"You need to chose the products the Swift package provides.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"None, only the Swift package dependency matter.","type":"text"}]}],"isCorrect":false}],"type":"multiple-choice"}]},{"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view","isActive":true},"featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"type":"text","text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images."},{"type":"text","text":" "},{"type":"text","text":"How can we do that?"}],"title":"Define information cards"}],"metadata":{"title":"Swift Package integration","role":"project","categoryPathComponent":"Table-Of-Contents-(onboarding)","category":"Orange Unified Design System"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries"]}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"role":"project","title":"Swift Package integration","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","type":"topic","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min"},"ic_unified_ds.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png","traits":["1x","light"]}],"identifier":"ic_unified_ds.png","type":"image","alt":"Logo of OUDS"},"https://github.com/Orange-OpenSource/ouds-ios/releases":{"type":"link","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/releases","title":"GitHub releases","titleInlineContent":[{"type":"text","text":"GitHub releases"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/releases"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further#More-resources":{"kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further#More-re