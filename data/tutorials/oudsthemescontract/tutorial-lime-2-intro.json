{"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(lime)","title":"Introduction"},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","interfaceLanguage":"swift"},"sections":[{"estimatedTimeInMinutes":10,"chapter":"Introduction","backgroundImage":"ic_unified_ds.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Lime theme is a fake theme with its own values for colors, borders, shadows and fonts for example."}]}],"projectFiles":"OUDS-Lime-Tutorial.zip","title":"Introduction","image":"ic_unified_ds.png","xcodeRequirement":"Xcode 26.5","kind":"hero"},{"kind":"tasks","tasks":[{"stepsSection":[{"type":"step","code":"tutorial-lime-2-1.swift","runtimePreview":"tutorial-lime-2.png","caption":[],"content":[{"inlineContent":[{"type":"text","text":"Let’s start by seeing the app with the default Orange theme."}],"type":"paragraph"}],"media":null},{"type":"step","code":"tutorial-lime-2-2.swift","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Now let’s create the LimeTheme class by subclassing OrangeTheme."}],"type":"paragraph"}],"media":null}],"title":"Starting point","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"We start with a complete app using the default Orange theme. This app contains various OUDS components that we will customize throughout the tutorial:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"OUDSTag","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSRadioPicker"}]}]},{"content":[{"type":"paragraph","inlineConten