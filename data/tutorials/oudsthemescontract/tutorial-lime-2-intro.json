{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","interfaceLanguage":"swift"},"kind":"project","sections":[{"kind":"hero","title":"Introduction","backgroundImage":"ic_unified_ds.png","image":"ic_unified_ds.png","xcodeRequirement":"Xcode 27.1","chapter":"Introduction","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Lime theme is a fake theme with its own values for colors, borders, shadows and fonts for example."}]}],"projectFiles":"OUDS-Lime-Tutorial.zip","estimatedTimeInMinutes":10},{"kind":"tasks","tasks":[{"anchor":"Starting-point","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"We start with a complete app using the default Orange theme. This app contains various OUDS components that we will customize throughout the tutorial:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSTag"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSRadioPicker"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSTextInput"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSChipPicker"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSHorizontalDivider"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSCheckboxItem"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSColoredSurface"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSLink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSButton"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSSwitchItem"}],"type":"paragraph"}]}],"type":"unorderedList"}],"mediaPosition":"trailing"}],"stepsSection":[{"caption":[],"runtimePreview":"tutorial-lime-2.png","media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Let’s start by seeing the app with the default Orange theme."}],"type":"paragraph"}],"code":"tutorial-lime-2-1.swift"},{"media":null,"caption":[],"runtimePreview":null,"code":"tutorial-lime-2-2.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Now let’s create the LimeTheme class by subclassing OrangeTheme."}],"type":"paragraph"}]}],"title":"Starting point"}]},{"assessments":[{"choices":[{"isCorrect":true,"justification":[{"inlineContent":[{"text":"Maybe the most simple solution.","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"text":"Subclass OrangeTheme","type":"text"}]}]},{"justification":[{"inlineContent":[{"type":"text","text":"Not the better choice as it can imply more work."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Create a theme from scratch on OUDSTheme"}],"type":"paragraph"}],"isCorrect":false}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What is the recommended strategy to create a custom OUDS theme?"}]}],"type":"multiple-choice","content":[]}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","isActive":true,"type":"reference","overridingTitle":"Get started"},"kind":"callToAction","title":"Colors","featuredEyebrow":"Tutorial","abstract":[{"text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme.","type":"text"}]}],"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"modules":[{"projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries"},{"projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Overriding-color-tokens"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colors"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Borders","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Overriding-border-tokens"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borde