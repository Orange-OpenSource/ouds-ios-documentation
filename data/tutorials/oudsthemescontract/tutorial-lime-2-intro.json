."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","role":"pseudoSymbol","title":"Defining tuning for local theme","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning":{"abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning","role":"project","title":"Tunings","estimatedTime":"15min","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Check-Your-Understanding","title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding"},"tutorial-lime-2-1.swift":{"highlights":[],"content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","\/\/ The umbrella imports to have all OUDS products","\/\/ Get more details about imports here: https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/gettingstarted","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - App","","\/\/ The iOS app entry","@main","struct OUDS_Lime_TutorialApp: App {","","    \/\/ The Orange theme for start, to instanciate once for all","    let myTheme = OrangeTheme()","","    var body: some Scene {","        WindowGroup {","            \/\/ The theme must be injected in the app environment with OUDSThemeableView","            OUDSThemeableView(theme: myTheme) {","                ContentView()","            }","        }","    }","}","","\/\/ MARK: - Content View","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var identity: String = \"\"","    @State var email: String = \"\"","    @State var termsAccepted: Bool = false","    @State var selectedTopics: [Topics] = []","    @State var creatingProfile: Bool = false","    @State var switchToDarkMode: Bool = false","","    \/\/ The theme injected through OUDSThemeableView","    @Environment(\\.theme) var theme","    @Environment(\\.openURL) var openUrl","","    \/\/ OUDS public components are prefixed by \"OUDS\"","    \/\/ Tokens are exposed through the theme environment object","    \/\/ OUDS provides also view modifiers","    var body: some View {","        ScrollView {","            Group {","                VStack(alignment: .leading, spacing: theme.spaces.fixedMedium) {","                    Text(\"Create your own theme\")","                        .headingXLarge(theme)","                        .foregroundColor(theme.colors.contentBrandPrimary)","","                    OUDSHeading(text: \"Let's customize the Lime theme together!\", size: .small)","","                    HStack {","                        OUDSTag(label: \"Welcome\")","                        OUDSTag(label: \"Lime\")","                        OUDSTag(label: \"Tutorial\")","                    }","                }.padding(.bottom, theme.spaces.fixedLarge)","","                Group {","                    VStack(alignment: .leading, spacing: theme.spaces.fixedMedium) {","                        OUDSRadioPicker(selection: $selectedGender,","                                        radios: genderRadioValues(),","                                        placement: .horizontal(false))","","                        let identityDeleteAction = OUDSTextInput.TrailingAction(image: .init(asset: Image(systemName: \"trash\")), actionHint: \"Delete\") { identity = \"\" }","                        OUDSTextInput(label: \"Identity\", text: $identity, placeholder: \"Firstname and lastname\", trailingAction: identityDeleteAction)","","                        OUDSTextInput(label: \"Email\", text: $email,","                                      placeholder: \"Email address\",","                                      suffix: \".com\",","                                      leadingImage: .init(asset: Image(systemName: \"envelope\")),","                                      helperText: \"The email will be automatically completed with @orange.com\")","","                        OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","                        OUDSLabel(text: \"\\(selectedTopics.count) topic(s) selected\", size: .small)","                            .foregroundColor(Color(hexadecimalCode: ColorRawTokens.functionalDodgerBlue800)!)","","                        OUDSHorizontalDivider(color: .brandPrimary)","","                        OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","                    }","                    .padding(.horizontal, theme.spaces.fixedSmall)","                }","                .background(theme.colors.bgTertiary)","                .border(style: theme.borders.styleDefault,","                        width: theme.borders.widthThin,","                        radius: theme.borders.radiusMedium,","                        color: theme.colors.actionEnabled)","                .shadow(theme.elevations.emphasized)","                .padding(.bottom, theme.spaces.fixedLarge)","","            }.padding(.horizontal, theme.spaces.fixedSmall)","","            OUDSColoredSurface(color: theme.colorModes.onStatusInfoEmphasized) {","                VStack(alignment: .center, spacing: theme.spaces.fixedXsmall) {","                    OUDSLink(text: \"Go to the website\", indicator: .next) {","                        openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","                    }","","                    OUDSButton(text: \"Create my profile\",","                               appearance: .strong,","                               style: creatingProfile ? .loading(progress: nil) : .default)","                    {","                        creatingProfile = true","                        DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                            creatingProfile = false","                        }","                    }.disabled(!termsAccepted)","","                    OUDSSwitchItem(\"Switch to dark mode\",","                                   isOn: $switchToDarkMode)","                        .padding(.horizontal, theme.spaces.fixed3xlarge)","                }","                .frame(maxWidth: .infinity)","                .padding(.bottom, theme.spaces.fixedLarge)","            }","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileName":"Tutorial.swift","type":"file","syntax":"swift","identifier":"tutorial-lime-2-1.swift","fileType":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts#Overriding-font-tokens":{"title":"Overriding font tokens","type":"section","abstract":[{"type":"text","text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components."}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Overriding-font-tokens","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts#Overriding-font-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","type":"section","role":"pseudoSymbol","title":"Import the Swift Package and the libraries","kind":"section"},"tutorial-lime-2.png":{"type":"image","identifier":"tutorial-lime-2.png","alt":"App with default Orange theme","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-lime-2.png","traits":["1x","light"]}]},"Xcode 27.1":{"type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/","title":"Xcode 27.1","identifier":"Xcode 27.1"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Check-Your-Understanding","title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","role":"project","title":"Colors","estimatedTime":"15min","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","title":"Check Your Understanding","type":"link","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further#More-resources":{"title":"More resources","type":"section","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further#More-resources","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further#More-resources"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries":{"abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries","role":"project","title":"Swift Package integration","estimatedTime":"10min","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings":{"abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings","role":"project","title":"Spacings","estimatedTime":"10min","kind":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Import-of-the-Swift-Package-and-choose-its-libraries":{"abstract":[],"url":"\/tutorials\/table-of-contents-(lime)\/import-of-the-swift-package-and-choose-its-libraries","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries","type":"topic","role":"article","title":"Import of the Swift Package and choose its libraries","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","title":"Check Your Understanding","type":"link","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","title":"Check Your Understanding","type":"link","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens":{"abstract":[{"type":"text","text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","type":"section","role":"pseudoSymbol","title":"Overriding color mode tokens","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Overriding-elevation-tokens":{"abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","type":"section","role":"pseudoSymbol","title":"Overriding elevation tokens","kind":"section"}}}