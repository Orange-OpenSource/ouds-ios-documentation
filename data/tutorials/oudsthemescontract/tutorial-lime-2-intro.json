{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro"]}],"hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colors","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Overriding-color-tokens"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Borders","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Overriding-border-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Spacings","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Overriding-spacing-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Elevations","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colored-Surface","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Fonts","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Overriding-font-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Tuning","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning"}]},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further#More-resources"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Go-further-with-more-ressources"}],"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction"]]},"kind":"project","metadata":{"category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(lime)","role":"project","title":"Introduction"},"sections":[{"image":"ic_unified_ds.png","xcodeRequirement":"Xcode 27.1","chapter":"Introduction","kind":"hero","estimatedTimeInMinutes":10,"title":"Introduction","backgroundImage":"ic_unified_ds.png","projectFiles":"OUDS-Lime-Tutorial.zip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Lime theme is a fake theme with its own values for colors, borders, shadows and fonts for example."}]}]},{"kind":"tasks","tasks":[{"title":"Starting point","stepsSection":[{"type":"step","code":"tutorial-lime-2-1.swift","caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Let’s start by seeing the app with the default Orange theme.","type":"text"}]}],"runtimePreview":"tutorial-lime-2.png","media":null},{"type":"step","code":"tutorial-lime-2-2.swift","caption":[],"content":[{"inlineContent":[{"type":"text","text":"Now let’s create the LimeTheme class by subclassing OrangeTheme."}],"type":"paragraph"}],"runtimePreview":null,"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"We start with a complete app using the default Orange theme. This app contains various OUDS components that we will customize throughout the tutorial:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDSTag","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"OUDSRadioPicker","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSTextInput"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSChipPicker"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSHorizontalDivider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDSCheckboxItem","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDSColoredSurface"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSLink"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSButton"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDSSwitchItem"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Starting-point"}]},{"kind":"assessments","assessments":[{"type":"multiple-choice","content":[],"title":[{"inlineContent":[{"type":"text","text":"What is the recommended strategy to create a custom OUDS theme?"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maybe the most simple solution."}]}],"content":[{"inlineContent":[{"type":"text","text":"Subclass OrangeTheme"}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"text":"Not the better choice as it can imply more work.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Create a theme from scratch on OUDSTheme","type":"text"}]}]}]}],"anchor":"Check-Your-Understanding"},{"abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"featuredEyebrow":"Tutorial","action":{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"title":"Colors","kind":"callToAction"}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders":{"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders","type":"topic","abstract":[{"text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components.","type":"text