ial-lime-3-colors":{"title":"Colors","role":"project","estimatedTime":"15min","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"kind":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Go-further-with-more-ressources":{"title":"Go further with more ressources","role":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Go-further-with-more-ressources","url":"\/tutorials\/table-of-contents-(lime)\/go-further-with-more-ressources","abstract":[],"kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro":{"kind":"project","type":"topic","title":"Introduction","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Import-of-the-Swift-Package-and-choose-its-libraries":{"title":"Import of the Swift Package and choose its libraries","role":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries","url":"\/tutorials\/table-of-contents-(lime)\/import-of-the-swift-package-and-choose-its-libraries","kind":"article","abstract":[]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings":{"title":"Spacings","role":"project","estimatedTime":"10min","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings","kind":"project","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Fonts":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Fonts","abstract":[],"role":"article","type":"topic","url":"\/tutorials\/table-of-contents-(lime)\/fonts","title":"Fonts","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning":{"title":"Tunings","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning","abstract":[{"text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand.","type":"text"},{"text":" ","type":"text"},{"text":"It permits to define whether or not some components family can have rounded corners for example.","type":"text"}],"estimatedTime":"15min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning#Defining-tuning-for-local-theme":{"title":"Defining tuning for local theme","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"text":" ","type":"text"},{"text":"It permits to define whether or not some components family can have rounded corners for example.","type":"text"}],"kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Overriding-spacing-tokens":{"title":"Overriding spacing tokens","kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Overriding-spacing-tokens","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Overriding-spacing-tokens","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Borders":{"type":"topic","title":"Borders","kind":"article","url":"\/tutorials\/table-of-contents-(lime)\/borders","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Borders","abstract":[]},"tutorial-lime-2-1.swift":{"content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","\/\/ The umbrella imports to have all OUDS products","\/\/ Get more details about imports here: https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/gettingstarted","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - App","","\/\/ The iOS app entry","@main","struct OUDS_Lime_TutorialApp: App {","","    \/\/ The Orange theme for start, to instanciate once for all","    let myTheme = OrangeTheme()","","    var body: some Scene {","        WindowGroup {","            \/\/ The theme must be injected in the app environment with OUDSThemeableView","            OUDSThemeableView(theme: myTheme) {","                ContentView()","            }","        }","    }","}","","\/\/ MARK: - Content View","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var identity: String = \"\"","    @State var email: String = \"\"","    @State var termsAccepted: Bool = false","    @State var selectedTopics: [Topics] = []","    @State var creatingProfile: Bool = false","    @State var switchToDarkMode: Bool = false","","    \/\/ The theme injected through OUDSThemeableView","    @Environment(\\.theme) var theme","    @Environment(\\.openURL) var openUrl","","    \/\/ OUDS public components are prefixed by \"OUDS\"","    \/\/ Tokens are exposed through the theme environment object","    \/\/ OUDS provides also view modifiers","    var body: some View {","        ScrollView {","            Group {","                VStack(alignment: .leading, spacing: theme.spaces.fixedMedium) {","                    Text(\"Create your own theme\")","                        .headingXLarge(theme)","                        .foregroundColor(theme.colors.contentBrandPrimary)","","                    OUDSHeading(text: \"Let's customize the Lime theme together!\", size: .small)","","                    HStack {","                        OUDSTag(label: \"Welcome\")","                        OUDSTag(label: \"Lime\")","                        OUDSTag(label: \"Tutorial\")","                    }","                }.padding(.bottom, theme.spaces.fixedLarge)","","                Group {","                    VStack(alignment: .leading, spacing: theme.spaces.fixedMedium) {","                        OUDSRadioPicker(selection: $selectedGender,","                                        radios: genderRadioValues(),","                                        placement: .horizontal(false))","","                        let identityDeleteAction = OUDSTextInput.TrailingAction(image: .init(asset: Image(systemName: \"trash\")), actionHint: \"Delete\") { identity = \"\" }","                        OUDSTextInput(label: \"Identity\", text: $identity, placeholder: \"Firstname and lastname\", trailingAction: identityDeleteAction)","","                        OUDSTextInput(label: \"Email\", text: $email,","                                      placeholder: \"Email address\",","                                      suffix: \".com\",","                                      leadingImage: .init(asset: Image(systemName: \"envelope\")),","                                      helperText: \"The email will be automatically completed with @orange.com\")","","                        OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","                        OUDSLabel(text: \"\\(selectedTopics.count) topic(s) selected\", size: .small)","                            .foregroundColor(Color(hexadecimalCode: ColorRawTokens.functionalDodgerBlue800)!)","","                        OUDSHorizontalDivider(color: .brandPrimary)","","                        OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","                    }","                    .padding(.horizontal, theme.spaces.fixedSmall)","                }","                .background(theme.colors.bgTertiary)","                .border(style: theme.borders.styleDefault,","                        width: theme.borders.widthThin,","                        radius: theme.borders.radiusMedium,","                        color: theme.colors.actionEnabled)","                .shadow(theme.elevations.emphasized)","                .padding(.bottom, theme.spaces.fixedLarge)","","            }.padding(.horizontal, theme.spaces.fixedSmall)","","            OUDSColoredSurface(color: theme.colorModes.onStatusInfoEmphasized) {","                VStack(alignment: .center, spacing: theme.spaces.fixedXsmall) {","                    OUDSLink(text: \"Go to the website\", indicator: .next) {","                        openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","                    }","","                    OUDSButton(text: \"Create my profile\",","                               appearance: .strong,","                               style: creatingProfile ? .loading(progress: nil) : .default)","                    {","                        creatingProfile = true","                        DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                            creatingProfile = false","                        }","                    }.disabled(!termsAccepted)","","                    OUDSSwitchItem(\"Switch to dark mode\",","                                   isOn: $switchToDarkMode)","                        .padding(.horizontal, theme.spaces.fixed3xlarge)","                }","                .frame(maxWidth: .infinity)","                .padding(.bottom, theme.spaces.fixedLarge)","            }","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileName":"Tutorial.swift","highlights":[],"identifier":"tutorial-lime-2-1.swift","type":"file","fileType":"swift","syntax":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface":{"title":"Colored Surface","role":"project","estimatedTime":"10min","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface","kind":"project","abstract":[{"text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component.","type":"text"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Tuning":{"role":"article","title":"Tuning","abstract":[],"url":"\/tutorials\/table-of-contents-(lime)\/tuning","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Tuning","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Overriding-border-tokens":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Overriding-border-tokens","abstract":[{"text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components.","type":"text"}],"role":"pseudoSymbol","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Overriding-border-tokens","title":"Overriding border tokens","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Overriding-elevation-tokens":{"title":"Overriding elevation tokens","type":"section","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutoria