{"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries","interfaceLanguage":"swift"},"kind":"project","sections":[{"chapter":"Import of the Swift Package and choose its libraries","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}]}],"title":"Swift Package integration","projectFiles":"OUDS-Lime-Tutorial.zip","image":"ic_unified_ds.png","xcodeRequirement":"Xcode 26.5","backgroundImage":"ic_unified_ds.png","estimatedTimeInMinutes":10,"kind":"hero"},{"tasks":[{"stepsSection":[{"type":"step","caption":[],"media":"tutorial-lime-1-ouds-swift-package.png","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Using Xcode, in your ","type":"text"},{"inlineContent":[{"text":"project package dependencies","type":"text"}],"type":"strong"},{"type":"text","text":", add a new "},{"type":"strong","inlineContent":[{"type":"text","text":"dependency"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Search with the GitHub repository URL (https:\/\/github.com\/Orange-OpenSource\/ouds-ios), and select the ","type":"text"},{"inlineContent":[{"type":"text","text":"ouds-ios"}],"type":"emphasis"},{"text":" dependency.","type":"text"},{"text":" ","type":"text"},{"text":"You can then choose the ","type":"text"},{"inlineContent":[{"text":"dependency rule","type":"text"}],"type":"strong"},{"text":" you want.","type":"text"},{"text":" ","type":"text"},{"text":"To know which version you need, you can have a look on the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/01-%E2%80%90-Available-API","type":"reference"},{"text":" ","type":"text"},{"text":"and also the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/releases","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Let’s say you will use some release candidate version today, e.g. the version 3.0.0-rc.1","type":"text"}]}],"code":null},{"code":null,"caption":[{"inlineContent":[{"type":"text","text":"Add for example only the umbrella product merging all products mentioned above: "},{"type":"emphasis","inlineContent":[{"text":"OUDSSwiftUI","type":"text"}]}],"type":"paragraph"}],"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Once you downloaded the package, you will see several libraries are available."},{"type":"text","text":" "},{"type":"text","text":"They can be embedded inside your "},{"inlineContent":[{"type":"text","text":"target"}],"type":"strong"},{"text":" libraries.","type":"text"},{"text":" ","type":"text"},{"text":"Things are separated to let users integrate only what they need and embed the bare minimum of content.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSThemesContract","type":"text"}]},{"text":" library provides the main elements like the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":". The theme contract is defined inside it.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSThemesOrange"}]},{"text":" provides the theme implementation for the Orange products, and contains also assets and all tokens for this theme.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSThemesSosh"}]},{"text":" provides the theme implementation for the Sosh products, and contains also assets and all tokens for this theme.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSThemesWireframe","type":"text"}]},{"text":" provides the theme implementation for the Wireframe theme, which is a theme dedicated to mockups and prototypes.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSThemesOrangeCompact","type":"text"}]},{"text":" provides the theme implementation for the Orange products but with constraints of sizes and spaces.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSComponents"}]},{"text":" contains the SwiftUI OUDS components defined with the Figma specifications, and also useful view modifers.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSTokensRaw","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSTokensSemantic","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSTokensComponents","type":"text"}]},{"text":" are libraries defining and providing the tokens for low level (raw),","type":"text"},{"text":" ","type":"text"},{"text":"middle level (semantic) or component levels (high level).","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"OUDSModules"}],"type":"emphasis"},{"text":" is for modules or rich components with extra logic.","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"OUDSFoundations"}],"type":"emphasis"},{"type":"text","text":" is dedicated to some utilities and shared logic."}],"type":"paragraph"}],"type":"step","media":"tutorial-lime-1-ouds-libraries.png"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS for iOS is an open source Swift Package available on GitHub under MIT license."},{"text":" ","type":"text"},{"type":"text","text":"The package and the libraries must be added through Xcode."}]}]}],"anchor":"Import-the-Swift-Package-and-the-libraries","title":"Import the Swift Package and the libraries"}],"kind":"tasks"},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"I can contribute to OUDS using pull request"}]}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"OUDS is open source, under MIT license, and hosted on GitHub. Of course you can contribute!"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDS supports officialy all Apple OS like visionOS, tvOS, watchOS, iPadOS, iOS and also CarPlay."}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"The main supported targets are iOS \/ iPadOS. However we do our best to support macOS, visionOS, tvOS and watchOS."},{"type":"text","text":" "},{"type":"text","text":"CarPlay specific cases are not scoped yet."}],"type":"paragraph"}],"isCorrect":false},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides UIKit components","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS supports only SwiftUI."}]}],"isCorrect":false}],"title":[{"inlineContent":[{"text":"Which of these choices is correct?","type":"text"}],"type":"paragraph"}],"content":[],"type":"multiple-choice"},{"type":"multiple-choice","content":[],"title":[{"inlineContent":[{"type":"text","text":"Which imports of the OUDS Swift Package products can I choose?"}],"type":"paragraph"}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Some of the available products depending to my needs, or only ","type":"text"},{"type":"codeVoice","code":"OUDSSwiftUI"},{"text":" if I am very lazy and don’t care about my app size.","type":"text"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can import all products provided by the Swift Package, and tailor your choice to keep only the ones needed."},{"text":" ","type":"text"},{"text":"Even if we recommend to choose only the atomic products you need, the ","type":"text"},{"code":"OUDSSwiftUI","type":"codeVoice"},{"text":" product wraps all of them.","type":"text"}]}]},{"isCorrect":false,"content":[{"inlineContent":[{"text":"None, only the Swift package dependency matter.","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"You need to chose the products the Swift package provides."}],"type":"paragraph"}]}]}]},{"kind":"callToAction","action":{"isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference"},"abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}],"featuredEyebrow":"Tutorial","title":"Introduction"}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries"]],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding"}],"reference":"doc:\/