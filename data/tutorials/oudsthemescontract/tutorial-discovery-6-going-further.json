caption":[{"type":"paragraph","inlineContent":[{"text":"You can get it at ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/","isActive":true,"type":"reference"}]}],"media":"tutorial-discovery-6-1.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"icon finder"}],"type":"emphasis"},{"text":" is also available there to get icons for your projects.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"type":"reference","identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true}]}],"media":"tutorial-discovery-6-2.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Have a look "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki","type":"reference","isActive":true},{"type":"text","text":" to discover how OUDS works."}]}],"media":"tutorial-discovery-6-3.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For technical reasons the "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true,"type":"reference"},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"inlineContent":[{"text":"design system toolbox","type":"text"}],"type":"emphasis"},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"reference","isActive":true}]}],"media":"tutorial-discovery-6-4.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true,"type":"reference"},{"text":" GitHub repository.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Do not hesitate to ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true,"type":"reference"},{"text":"!","type":"text"}]}],"media":"tutorial-discovery-6-5.png","code":null}]}]}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"estimatedTime":"30min","kind":"project","type":"topic","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"type":"text","text":" "},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"role":"project","title":"Use your first OUDS components","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"},"doc://OUDSThemesContract/tutorials/OUDSThemesCont