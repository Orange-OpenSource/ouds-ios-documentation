[{"text":"You can get it at ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/","type":"reference","isActive":true}],"type":"paragraph"}],"runtimePreview":null,"code":null,"media":"tutorial-discovery-6-1.png"},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"type":"text","text":" is also available there to get icons for your projects."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"type":"reference","isActive":true,"identifier":"https:\/\/unified-design-system.orange.com\/"}]}],"media":"tutorial-discovery-6-2.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technical architecture, tips about processes, tests, conventions and toolings."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Have a look "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"type":"text","text":" to discover how OUDS works."}]}],"media":"tutorial-discovery-6-3.png","code":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For technical reasons the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"design system toolbox"}]},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"reference","isActive":true}]}],"media":"tutorial-discovery-6-4.png","code":null},{"content":[{"inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"type":"text","text":" GitHub repository."}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not hesitate to "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","type":"reference","isActive":true},{"type":"text","text":"!"}]}],"type":"step","runtimePreview":null,"media":"tutorial-discovery-6-5.png","code":null}]}]}],"references":{"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Go-further-with-more-ressources":{"abstract":[],"title":"Go further with more ressources","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)\/go-further-with-more-ressources","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources","role":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"title":"Add more OUDS components