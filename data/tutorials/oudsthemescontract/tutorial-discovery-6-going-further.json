:"paragraph","inlineContent":[{"text":"For technical reasons the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"design system toolbox"}]},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}]}]},{"media":"tutorial-discovery-6-5.png","code":null,"type":"step","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not hesitate to "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions"},{"type":"text","text":"!"}]}],"content":[{"inlineContent":[{"text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"text":" GitHub repository.","type":"text"}],"type":"paragraph"}]}]}]}],"references":{"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"type":"topic","title":"Swift Package Discovery Tutorial","role":"overview","abstract":[{"type":"text","text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package."},{"type":"text","text":" "},{"type":"text","text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework."},{"type":"text","text":" "},{"type":"text","text":"Theme, components, tokens… everything will be introduced!"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","kind":"overview","url":"\/tutorials\/table-of-c