ift Package."},{"type":"text","text":" "},{"type":"text","text":"You will find several catalogs (as many as librairies) with details about everyhting: components, tokens, themes, providers, etc."}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"isActive":true,"identifier":"https:\/\/unified-design-system.orange.com\/","type":"reference"}],"type":"paragraph"}],"media":"tutorial-discovery-6-2.png","type":"step","runtimePreview":null,"code":null,"content":[{"inlineContent":[{"type":"text","text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"icon finder","type":"text"}]},{"type":"text","text":" is also available there to get icons for your projects."}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"text":"Have a look ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"text":" to discover how OUDS works.","type":"text"}],"type":"paragraph"}],"media":"tutorial-discovery-6-3.png","type":"step","runtimePreview":null,"code":null,"content":[{"inlineContent":[{"type":"text","text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings."}],"type":"paragraph"}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox"}]}],"media":"tutorial-discovery-6-4.png","type":"step","runtimePreview":null,"code":null,"content":[{"inlineContent":[{"text":