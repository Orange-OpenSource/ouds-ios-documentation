tion":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"type":"reference","isActive":true,"identifier":"https:\/\/unified-design-system.orange.com\/"}]}],"code":null,"runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technical architecture, tips about processes, tests, conventions and toolings."}]}],"media":"tutorial-discovery-6-3.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Have a look "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"type":"text","text":" to discover how OUDS works."}]}],"code":null,"runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For technical reasons the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"design system toolbox"}]},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}]}],"media":"tutorial-discovery-6-4.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox"}]}],"code":null,"runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository."}]}],"media":"tutorial-discovery-6-5.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not hesitate to "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions"},{"type":"text","text":"!"}]}],"code":null,"runtimePreview":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"But there are also other resources which can be useful for you."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"More-resources"}]}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","interfaceLanguage":"swift"},"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(discovery)","title":"Going further with more resources"},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-libraries#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-libraries#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Typography,-view-modifiers-and-tokens":{"kind":"article","title":"Typography, view modifiers and tokens","type":"topic","url":"\/tutorials\/table-of