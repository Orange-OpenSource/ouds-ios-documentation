r projects.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"type":"reference","identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-2.png"},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technical architecture, tips about processes, tests, conventions and toolings.","type":"text"}]}],"code":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Have a look ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"text":" to discover how OUDS works.","type":"text"}]}],"media":"tutorial-discovery-6-3.png"},{"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","isActive":true}]}],"runtimePreview":null,"code":null,"content":[{"inlineContent":[{"type":"text","text":"For technical reasons the "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"inlineContent":[{"type":"text","text":"design system toolbox"}],"type":"emphasis"},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}],"type":"paragraph"}],"media":"tutorial-discovery-6-4.png"},{"media":"tutorial-discovery-6-5.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forg