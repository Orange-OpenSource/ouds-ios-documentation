{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"},"hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Import-of-the-Swift-Package-and-choose-its-libraries","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Preparation-of-the-theme","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme#Basic-structure-for-the-app","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Use-of-first-components-provided-by-OUDS","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components#Add-basic-components"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Richer-and-more-original-components-of-OUDS","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Add-basic-components"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Typography,-view-modifiers-and-tokens","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-tokens","kind":"task"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Final-result","kind":"task"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Want-to-be-an-artist"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Check-Your-Understanding","kind":"assessment"}]}]},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further#More-resources","kind":"task"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources"}],"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Use-of-first-components-provided-by-OUDS"]]},"sections":[{"title":"Use your first OUDS components","backgroundImage":"ic_component_intro.png","kind":"hero","image":"ic_component_intro.png","xcodeRequirement":"Xcode 27.1","chapter":"Use of first components provided by OUDS","content":[{"inlineContent":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"type":"paragraph"}],"projectFiles":"OUDS-Discovery-Tutorial.zip","estimatedTimeInMinutes":30},{"tasks":[{"anchor":"Add-basic-components","title":"Add basic components","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"We will work on a kind of form using main OUDS components.","type":"text"},{"text":" ","type":"text"},{"text":"Feel free to style and design things as you want.","type":"text"}]}]}],"stepsSection":[{"caption":[],"media":null,"runtimePreview":null,"type":"step","code":"tutorial-discovery-3-1.swift","content":[{"type":"paragraph","inlineContent":[{"text":"First, prepare the ","type":"text"},{"code":"ContentView","type":"codeVoice"},{"text":" by adding inside it a ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":".","type":"text"}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"text":"Add such picker with three items inside.","type":"text"}]}],"media":null,"runtimePreview":"tutorial-discovery-3-2.png","type":"step","code":"tutorial-discovery-3-2.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Now, let’s add radio buttons to let the user choose its gender.","type":"text"},{"text":" ","type":"text"},{"text":"The official components are ","type":"text"},{"code":"OUDSRadio","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OUDSRadioItem","type":"codeVoice"},{"text":", but the package has also a ","type":"text"},{"code":"OUDSRadioPicker","type":"codeVoice"},{"text":" to implement quicky a group of radios.","type":"text"},{"text":" ","type":"text"},{"text":"This component can be replaced by your own.","type":"text"},{"text":" ","type":"text"},{"text":"The radio picker is defined by an array of values to display radio items associated to a tag, i.e. an ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" thing shared through a ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Inside a picker the user can select only one value, not zero.","type":"text"}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a checkbox item with only two states."}]}],"media":null,"runtimePreview":"tutorial-discovery-3-3.png","type":"step","code":"tutorial-discovery-3-3.swift","content":[{"type":"paragraph","inlineContent":[{"text":"The radio picker is alone, it is the time to add below a checkbox. OUDS provides two components: ","type":"text"},{"code":"OUDSCheckbox","type":"codeVoice"},{"text":" which is a simple checkbox, and ","type":"text"},{"code":"OUDSCheckboxItem","type":"codeVoice"},{"text":" which is a checkbox (duh!) with additional texts and icons.","type":"text"},{"text":" ","type":"text"},{"text":"The state of the checkbox is shared through a boolean ","type":"text"},{"code":"State","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In some cases you may need to use ","type":"text"},{"code":"OUDSCheckboxIndeterminate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OUDSCheckboxItemIndeterminate","type":"codeVoice"},{"text":" if you want a three-states checkbox.","type":"text"}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose to add an instance of "},{"code":"OUDSHorizontalDivider","type":"codeVoice"},{"type":"text","text":"."}]}],"media":null,"runtimePreview":"tutorial-discovery-3-4.png","type":"step","code":"tutorial-discovery-3-4.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are also components who do not have any behaviors and are here only for visual rendering, for example dividers which can be horizontal or vertical."},{"type":"text","text":" "},{"type":"text","text":"A divider is, in the end, a stroke with a color. You will see later, colors in OUDS have two values: a light mode value, and a dark mode value. Here the divider can have a color which can change, or not."}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a switch item, it will be used as a trick to force the change of the color scheme for the view for our future operations."},{"type":"text","text":" "},{"type":"text","text":"You will then be able to see the automatic changes of colors when you switch the color scheme."}]}],"media":null,"runtimePreview":"tutorial-discovery-3-5.png","type":"step","code":"tutorial-discovery-3-5.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With radio and checkbox, OUDS provides also switch elements (toggles). They can be alone ("},{"code":"OUDSSwitch","type":"codeVoice"},{"type":"text","text":") or with texts ("},{"code":"OUDSSwitchItem","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Just like the checkbox, the switch exposes its state through a "},{"code":"Binding","type":"codeVoice"},{"type":"text","text":"."}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add an "},{"code":"OUDSLink","type":"codeVoice"},{"type":"text","text":" in the app and make it open the iOS documentation OUDS website."}]}],"media":null,"runtimePreview":"tutorial-discovery-3-6.png","type":"step","code":"tutorial-discovery-3-6.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Users may need to navigate outside the app, like, for example, opening a website. Thus the "},{"code":"OUDSLink","type":"codeVoice"},{"type":"text","text":" component can be integrated. It can be only with a text or also a chevron indicator."}]}]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s add a button with some rules: if checkbox is not checked it is disabled. When tapped, change the style of the button during 5 seconds."}]}],"media":null,"runtimePreview":"tutorial-discovery-3-7.png","type":"step","code":"tutorial-discovery-3-7.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, we can also add a button. Button are one of the most used components in an app and bring a lof of the power and the style of the brand."},{"type":"text","text":" "},{"type":"text","text":"You can find it with the "},{"code":"OUDSButton","type":"codeVoice"},{"type":"text","text":". Such button has an appearance changing its colors, and also a style (loading or not)."},{"type":"text","text":" "},{"type":"text","text":"Thanks to the theme, the enabled, disabled, hover, focus or pressed states are managed."}]}]}]}],"kind":"tasks"},{"assessments":[{"choices":[{"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No! The components use the design specifications, i.e. tokens, thanks to the theme, to define the style they must have in all cases."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]},{"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That is the reason why the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" is so important: it injects the theme as environment variable so that any component can get it to define its style."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]}],"type":"multiple-choice","title":[{"inlineContent":[{"text":"Does the developer using OUDS component need to manage the look and feel of the components?","type":"text"}],"type":"paragraph"}],"content":[]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"title":"Add more OUDS components","action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","type":"reference","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true},"kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs.","type":"text"}]}],"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(discovery)","title":"Use your first OUDS components"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"project","references":{"tutorial-discovery-3-2.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","","    var body: some View {","        OUDSRadioPicker(selection: $selectedGender,","                        radios: genderRadioValues(),","                        placement: .horizontal(false))","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"type":"file","fileType":"swift","syntax":"swift","highlights":[],"fileName":"Content.swift","identifier":"tutorial-discovery-3-2.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Typography,-view-modifiers-and-tokens":{"kind":"article","title":"Typography, view modifiers and tokens","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)\/typography,-view-modifiers-and-tokens","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Typography,-view-modifiers-and-tokens","abstract":[]},"tutorial-discovery-3-5.swift":{"identifier":"tutorial-discovery-3-5.swift","type":"file","fileName":"Content.swift","syntax":"swift","highlights":[{"line":8},{"line":19},{"line":20},{"line":21}],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","","    var body: some View {","        VStack {","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-6-going-further":{"kind":"project","title":"Going further with more resources","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-6-going-further#More-resources":{"kind":"section","title":"More resources","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further#More-resources","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further#More-resources","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}]},"OUDS-Discovery-Tutorial.zip":{"checksum":"0450208209b4275d979b29b87d962e6d04972441084ab1d924c931b7bc73f3e286d0caead48bf24c77e0506d52b524e36bd868dbc322802138713020f03711d7","identifier":"OUDS-Discovery-Tutorial.zip","type":"download","url":"\/downloads\/OUDSThemesContract\/OUDS-Discovery-Tutorial.zip"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding"},"tutorial-discovery-3-6.swift":{"identifier":"tutorial-discovery-3-6.swift","type":"file","fileName":"Content.swift","syntax":"swift","highlights":[{"line":10},{"line":11},{"line":23},{"line":24},{"line":25},{"line":26}],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Import-of-the-Swift-Package-and-choose-its-libraries":{"kind":"article","title":"Import of the Swift Package and choose its libraries","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)\/import-of-the-swift-package-and-choose-its-libraries","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Import-of-the-Swift-Package-and-choose-its-libraries","abstract":[]},"tutorial-discovery-3-7.png":{"identifier":"tutorial-discovery-3-7.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-3-7.png","traits":["1x","light"]}],"alt":"A radio picker, an horizontal divider, a checkbox item, a switch item, a link and a button"},"tutorial-discovery-3-4.png":{"identifier":"tutorial-discovery-3-4.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-3-4.png","traits":["1x","light"]}],"alt":"A radio picker, an horizontal divider and a checkbox item"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"kind":"project","title":"Styling things","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-libraries":{"kind":"project","title":"Swift Package integration","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-libraries","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Richer-and-more-original-components-of-OUDS":{"kind":"article","title":"Richer and more original components of OUDS","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)\/richer-and-more-original-components-of-ouds","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Richer-and-more-original-components-of-OUDS","abstract":[]},"Xcode 27.1":{"identifier":"Xcode 27.1","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/","title":"Xcode 27.1"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"kind":"overview","title":"Swift Package Discovery Tutorial","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)","role":"overview","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}]},"tutorial-discovery-3-3.png":{"identifier":"tutorial-discovery-3-3.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-3-3.png","traits":["1x","light"]}],"alt":"A radio picker and a checkbox item"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Use-of-tokens":{"kind":"section","title":"Use of tokens","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Use-of-tokens","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-tokens","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}]},"tutorial-discovery-3-3.swift":{"identifier":"tutorial-discovery-3-3.swift","type":"file","fileName":"Content.swift","syntax":"swift","highlights":[{"line":7},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","","    var body: some View {","        VStack {","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","        }","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"tutorial-discovery-3-4.swift":{"identifier":"tutorial-discovery-3-4.swift","type":"file","fileName":"Content.swift","syntax":"swift","highlights":[{"line":15},{"line":16}],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","","    var body: some View {","        VStack {","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","        }","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Use-of-view-modifiers":{"kind":"section","title":"Use of view modifiers","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}]},"ic_component_intro.png":{"identifier":"ic_component_intro.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"alt":"OUDS components logo"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components#Add-basic-components":{"kind":"section","title":"Add basic components","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components#Add-basic-components","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components#Add-basic-components","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"text":"They are rendered thanks to the theme in use.","type":"text"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"role":"project","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","estimatedTime":"30min","title":"Use your first OUDS components","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"type":"text","text":"They are rendered thanks to the theme in use."}],"kind":"project"},"tutorial-discovery-3-7.swift":{"identifier":"tutorial-discovery-3-7.swift","type":"file","fileName":"Content.swift","syntax":"swift","highlights":[{"line":9},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37}],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","","            OUDSButton(text: \"Create my profile\",","                       appearance: .strong,","                       style: creatingProfile ? .loading(progress: nil) : .default)","            {","                creatingProfile = true","                DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                    creatingProfile = false","                }","            }.disabled(!termsAccepted)","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Go-further-with-more-ressources":{"role":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources","title":"Go further with more ressources","url":"\/tutorials\/table-of-contents-(discovery)\/go-further-with-more-ressources","abstract":[],"kind":"article"},"tutorial-discovery-3-5.png":{"identifier":"tutorial-discovery-3-5.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-3-5.png","traits":["1x","light"]}],"alt":"A radio picker, an horizontal divider, a checkbox item and a switch item"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Preparation-of-the-theme":{"role":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Preparation-of-the-theme","title":"Preparation of the theme","abstract":[],"url":"\/tutorials\/table-of-contents-(discovery)\/preparation-of-the-theme","kind":"article"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Use-of-first-components-provided-by-OUDS":{"kind":"article","title":"Use of first components provided by OUDS","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)\/use-of-first-components-provided-by-ouds","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Use-of-first-components-provided-by-OUDS","abstract":[]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"kind":"project","title":"Add more OUDS components","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"role":"pseudoSymbol","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","title":"Import the Swift Package and the libraries","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components#Add-basic-components":{"kind":"section","title":"Add basic components","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components#Add-basic-components","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Add-basic-components","abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Want-to-be-an-artist":{"kind":"section","ti