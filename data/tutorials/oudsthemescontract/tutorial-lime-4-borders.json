okens to customize the layout spacing.","type":"text"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"abstract":[{"text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme.","type":"text"}],"type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","estimatedTime":"15min","kind":"project","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","title":"Colors"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Borders":{"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Borders","type":"topic","title":"Borders","abstract":[],"kind":"article","url":"\/tutorials\/table-of-contents-(lime)\/borders"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","type":"section","title":"Starting point","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point","abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"kind":"section"},"tutorial-lime-4.swift":{"fileType":"swift","syntax":"swift","highlights":[{"line":25},{"line":30},{"line":32},{"line":33},{"line":35},{"line":37},{"line":38},{"line":39}],"identifier":"tutorial-lime-4.swift","type":"file","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: LimeThemeColorProvider())","    }","}","","\/\/ MARK: - Border Provider","","\/\/ By subclassing OrangeThemeBorderSemanticTokensProvider, you get all existing tokens","\/\/ of borders of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeBorderProvider: OrangeThemeBorderSemanticTokensProvider {","","    override var styleDefault: BorderStyleSemanticToken { BorderRawTokens.styleDashed }","    override var widthThin: BorderWidthSemanticToken { BorderRawTokens.width100 }","    override var radiusMedium: BorderRadiusSemanticToken { BorderRawTokens.radius800 }","}"],"fileName":"Tokens.swift"},"tutorial-lime-4.png":{"alt":"App with new styles for borders","identifier":"tutorial-lime-4.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-lime-4.png"}],"type":"image"}}}