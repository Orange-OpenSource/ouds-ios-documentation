}],"isCorrect":false}],"content":[],"title":[{"type":"paragraph","inlineContent":[{"text":"Are border semantic tokens isolated?","type":"text"}]}]}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"action":{"overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true,"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings"},"featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"kind":"callToAction","title":"Spacings"}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"title":"Starting point","type":"section","abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further":{"title":"Going further with more resources","type":"topic","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"kind":"project","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further","estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens":{"abstract":[{"type":"text","tex