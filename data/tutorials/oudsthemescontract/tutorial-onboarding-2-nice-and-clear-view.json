text"}]},{"type":"text","text":" and apply a "},{"type":"emphasis","inlineContent":[{"text":"color token","type":"text"}]},{"text":" as background which will vary depending to this scheme.","type":"text"}]}],"runtimePreview":"tutorial-onboarding-2-8.png"}],"anchor":"Define-the-view-basics","title":"Define the view basics"}],"kind":"tasks"},{"kind":"assessments","assessments":[{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where can I find tokens?"}]}],"type":"multiple-choice","content":[],"choices":[{"justification":[{"inlineContent":[{"text":"Yes! Get the theme through environment variable and use its providers","type":"text"}],"type":"paragraph"}],"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"Inside tokens providers exposed by the theme"}],"type":"paragraph"}]},{"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! All tokens are defined and provided through OUDS library"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"Nowhere, I must define my own","type":"text"}]}]}]},{"title":[{"inlineContent":[{"type":"text","text":"How can I get the theme to apply?"}],"type":"paragraph"}],"type":"multiple-choice","content":[],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"I must instanciate it every time I need"}],"type":"paragraph"}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The theme is provided through an environment object, instanciated thanks to a preview view modifier or specific view."}]}],"isCorrect":false},{"content":[{"inlineContent":[{"type":"text","text":"Using an environment value"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Theme is exposed as environment object, available within views for example."}],"type":"paragraph"}]}]}],"anchor":"Check-Your-Understanding"},{"action":{"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get start