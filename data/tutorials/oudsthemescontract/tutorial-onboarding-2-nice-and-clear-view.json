n access to "},{"type":"reference","identifier":"https:\/\/www.figma.com\/design\/zJl6GhY2gMSMAibBJXoNPy\/Reveal-and-Onboarding?node-id=2259-4970&m=dev","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Define the view basics","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a basic "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", it must have an asset name to load as image, a title, a subtitle, a description and a label for the button."},{"type":"text","text":" "},{"type":"text","text":"Add also the Xcode "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" macro to display the view, here of course it will be empty."}]}],"media":null,"code":"tutorial-onboarding-2-1.swift","runtimePreview":"tutorial-onboarding-2-1.png","type":"step","caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS library provides view modifiers to be used in Xcode previews macros."},{"type":"text","text":" "},{"type":"text","text":"It allows to apply the theme you want in the view"}]}],"media":null,"code":"tutorial-onboarding-2-2.swift","runtimePreview":"tutorial-onboarding-2-1.png","type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supposing we will work with Orange theme here, apply the "},{"type":"codeVoice","code":"orangePreview()"},{"type":"text","text":" view modifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, use the properties you defined in the Xcode preview, and display them in your "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]}],"media":null,"code":"tutorial-onboarding-2-3.swift","runtimePreview":"tutorial-onboarding-2-3.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You may want to apply typography on texts. These effects will show most important content and bring meanings."},{"type":"text","text":" "},{"type":"text","text":"You can have a look on the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/swiftuicore\/view","isActive":true},{"type":"text","text":", which can be applied on "},{"type":"codeVoice","code":"View"},{"type":"text","text":" object."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-2-4.swift","runtimePreview":"tutorial-onboarding-2-4.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"For the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":" with want a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"medium heading"}]},{"type":"text","text":", an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"XL heading"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"large default body"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"description"}]},{"type":"text","text":". You will need to get the "},{"type":"emphasis","inlineContent":[{"text":"theme","type":"text"}]},{"type":"text","text":" object throw the dedicated environment variable to give it to the view modifiers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Now, it’s time to apply colors on texts. "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/colorsemantictokens"},{"type":"text","text":", i.e. small atomic elements defined in the design Figma kit. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" object contains tokens and provides them thanks to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"providers"}]},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-2-5.swift","runtimePreview":"tutorial-onboarding-2-5.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"For all texts, change the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"foreground color"}]},{"type":"text","text":": apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentBrandPrimary"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" for the subtitle and also the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"description"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Now, it’s time to add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbutton"},{"type":"text","text":". OUDS provides plenty of components with properties related to notions defined in Figma kit and DSM. For example a button can have "},{"type":"emphasis","inlineContent":[{"type":"text","text":"appearance"}]},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-2-6.swift","runtimePreview":"tutorial-onboarding-2-6.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"Add a button with a "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbutton#Appearances"},{"type":"text","text":", using the previously defined label, and no action."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You agree things are stucked and spacings are missing. "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/spacesemantictokens"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Some of these tokens have unique value like "},{"type":"codeVoice","code":"theme.spaces.fixedMedium"},{"type":"text","text":", but "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/spacemultiplesemantictokens"},{"type":"text","text":" depending to the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"size class"}]},{"type":"text","text":" of the view like "},{"type":"codeVoice","code":"theme.spaces.scaled2xsmall"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In addition, OUDS provides view modifiers to define "},{"type":"emphasis","inlineContent":[{"type":"text","text":"grid margins"}]},{"type":"text","text":" on a view depending to a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"size class"}]},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-2-7.swift","runtimePreview":"tutorial-onboarding-2-7.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"Try to apply some spacings: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fixedNone"}]},{"type":"text","text":" in the "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fixedMedium"}]},{"type":"text","text":" as a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" minimum length below the button, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top grid margin"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"grid margin"}]},{"type":"text","text":" for all the "},{"type":"codeVoice","code":"View"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaled2xsmall"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical padding"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledLarge"}]},{"type":"text","text":" as minimum length for a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" above the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"button"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It is possible to force the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color scheme"}]},{"type":"text","text":" of your view with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiftUI"}]},{"type":"text","text":" and apply a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color token"}]},{"type":"text","text":" as background which will vary depending to this scheme."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-2-8.swift","runtimePreview":"tutorial-onboarding-2-8.png","type":"step","caption":[{"inlineContent":[{"type":"text","text":"Define an "},{"type":"codeVoice","code":"HomeView"},{"type":"text","text":" with two "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" objects. For the second view, for to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dark color scheme"}]},{"type":"text","text":" and apply "},{"type":"codeVoice","code":"theme.colors.bgInverseLow"},{"text":" background color.","type":"text"}],"type":"paragraph"}]}],"anchor":"Define-the-view-basics"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"content":[],"type":"multiple-choice","title":[{"inlineContent":[{"text":"Where can I find tokens?","type":"text"}],"type":"paragraph"}],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Inside tokens providers exposed by the theme"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"Yes! Get the theme through environment variable and use its providers","type":"text"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"text":"Nowhere, I must define my own","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"Nope! All tokens are defined and provided through OUDS library","type":"text"}],"type":"paragraph"}],"isCorrect":false}]},{"content":[],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"How can I get the theme to apply?"}],"type":"paragraph"}],"choices":[{"content":[{"inlineContent":[{"text":"I must instanciate it every time I need","type":"text"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"The theme is provided through an environment object, instanciated thanks to a preview view modifier or specific view."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Using an environment value"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Theme is exposed as environment object, available within views for example."}],"type":"paragraph"}],"isCorrect":true}]}]},{"kind":"callToAction","title":"Components showcase","action":{"overridingTitle":"Get started","type":"reference","overridingTitleInlineConte