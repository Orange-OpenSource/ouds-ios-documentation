r the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"description"}]},{"text":". You will need to get the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"text":" object throw the dedicated environment variable to give it to the view modifiers.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You may want to apply typography on texts. These effects will show most important content and bring meanings."},{"type":"text","text":" "},{"type":"text","text":"You can have a look on the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/swiftuicore\/view","isActive":true},{"type":"text","text":", which can be applied on "},{"type":"codeVoice","code":"View"},{"type":"text","text":" object."}]}],"code":"tutorial-onboarding-2-4.swift","runtimePreview":"tutorial-onboarding-2-4.png"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For all texts, change the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"foreground color"}]},{"type":"text","text":": apply "},{"type":"emphasis","inlineContent":[{"text":"contentBrandPrimary","type":"text"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" for the subtitle and also the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"description"}]},{"type":"text","text":"."}]}],"media":null,"code":"tutorial-onboarding-2-5.swift","runtimePreview":"tutorial-onboarding-2-5.png","content":[{"inlineContent":[{"type":"text","text":"Now, it’s time to apply colors on texts. "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/co