n GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"kind":"section"},"https://www.figma.com/design/zJl6GhY2gMSMAibBJXoNPy/Reveal-and-Onboarding?node-id=2259-4970&m=dev":{"type":"link","titleInlineContent":[{"type":"text","text":"the Figma specifications"}],"url":"https:\/\/www.figma.com\/design\/zJl6GhY2gMSMAibBJXoNPy\/Reveal-and-Onboarding?node-id=2259-4970&m=dev","identifier":"https:\/\/www.figma.com\/design\/zJl6GhY2gMSMAibBJXoNPy\/Reveal-and-Onboarding?node-id=2259-4970&m=dev","title":"the Figma specifications"},"tutorial-onboarding-2-4.swift":{"syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct InfoCard: View {","","    let assetName: String","    let title: String","    let subtitle: String","    let description: String","    let buttonLabel: String","","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(alignment: .leading) {","            Image(assetName, bundle: .main)","                .resizable()","                .aspectRatio(contentMode: .fit)","","            Text(title)","                .frame(maxWidth: .infinity, alignment: .leading)","                .headingMedium(theme)","","            Text(subtitle)","                .headingXLarge(theme)","","            Text(description)","                .bodyDefaultLarge(theme)","        }","    }","}","","#Preview {","    InfoCard(","        assetName: \"Picture2\",","        title: \"Orange for the sector\",","        subtitle: \"A complete offer for Institutions\",","        description: \"Our experience as a partner in the digital transformation of companies and institutions guarantees the high efficiency of the services provided.\",","        buttonLabel: \"Transmission\")","        .orangePreview()","}"],"type":"file","identifier":"tutorial-onboarding-2-4.swift","fileType":"swift","highlights":[{"line":12},{"line":13},{"line":21},{"line":22},{"line":25},{"line":28}],"fileName":"InfoCard.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"role":"article","title":"Components showcases","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","abstract":[],"kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies":{"role":"project","title":"Swift Package integration","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min","kind":"project"},"tutorial-onboarding-2-7.swift":{"syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct InfoCard: View {","","    let assetName: String","    let title: String","    let subtitle: String","    let description: String","    let buttonLabel: String","","    @Environment(\\.theme) private var theme","    @Environment(\\.horizontalSizeClass) private var horizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        VStack(alignment: .leading, spacing: theme.spaces.fixedNone) {","            Image(assetName, bundle: .main)","                .resizable()","                .aspectRatio(contentMode: .fit)","","            Text(title)","                .frame(maxWidth: .infinity, alignment: .leading)","                .headingMedium(theme)","                .foregroundColor(theme.colors.contentBrandPrimary)","                .padding(.top, theme.gridMargin(for: oudsHorizontalSizeClass))","","            Text(subtitle)","                .headingXLarge(theme)","                .foregroundColor(theme.colors.contentDefault)","                .padding(.vertical, theme.spaces.scaled2xsmall.dimension(for: horizontalSizeClass ?? .regular))","","            Text(description)","                .bodyDefaultLarge(theme)","                .foregroundColor(theme.colors.contentDefault)","","            Spacer(minLength: theme.spaces.scaledLarge.dimension(for: verticalSizeClass ?? .regular))","","            OUDSButton(text: buttonLabel, appearance: .strong) {}","","            Spacer(minLength: theme.spaces.fixedMedium)","        }","        .gridMargin(.horizontal)","    }","}","","#Preview {","    InfoCard(","        assetName: \"Picture2\",","        title: \"Orange for the sector\",","        subtitle: \"A complete offer for Institutions\",","        description: \"Our experience as a partner in the digital transformation of companies and institutions guarantees the high efficiency of the services provided.\",","        buttonLabel: \"Transmission\")","        .orangePreview()","}"],"type":"file","identifier":"tutorial-onboarding-2-7.swift","fileType":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":18},{"line":27},{"line":32},{"line":38},{"line":39},{"line":41},{"line":42},{"line":44}],"fileName":"InfoCard.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"role":"overview","title":"Swift Package Onboar