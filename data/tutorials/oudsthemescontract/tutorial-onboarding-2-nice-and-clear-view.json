,"content":[{"inlineContent":[{"type":"text","text":"You may want to apply typography on texts. These effects will show most important content and bring meanings."},{"type":"text","text":" "},{"type":"text","text":"You can have a look on the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/swiftuicore\/view","isActive":true,"type":"reference"},{"type":"text","text":", which can be applied on "},{"code":"View","type":"codeVoice"},{"type":"text","text":" object."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"For the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":" with want a "},{"inlineContent":[{"type":"text","text":"medium heading"}],"type":"emphasis"},{"type":"text","text":", an "},{"inlineContent":[{"type":"text","text":"XL heading"}],"type":"emphasis"},{"type":"text","text":" for the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" and a "},{"inlineContent":[{"type":"text","text":"large default body"}],"type":"emphasis"},{"type":"text","text":" for the "},{"inlineContent":[{"type":"text","text":"description"}],"type":"emphasis"},{"type":"text","text":". You will need to get the "},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"type":"text","text":" object throw the dedicated environment variable to give it to the view modifiers."}],"type":"paragraph"}],"media":null,"type":"step","code":"tutorial-onboarding-2-4.swift"},{"runtimePreview":"tutorial-onboarding-2-5.png","content":[{"inlineContent":[{"type":"text","text":"Now, it’s time to apply colors on texts. "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/colorsemantictokens","isActive":true,"type":"reference"},{"type":"text","text":", i.e. small atomic elements defined in the design Figma kit. The "},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"type":"text","text":" object contains tokens and provides them thanks to "},{"inlineContent":[{"type":"text","text":"providers"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"For all texts, change the "},{"inlineContent":[{"type":"text","text":"foreground color"}],"type":"emphasis"},{"type":"text","text":": apply "},{"inlineContent":[{"type":"text","text":"contentBrandPrimary"}],"type":"emphasis"},{"type":"text","text":" for the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"contentDefault"}],"type":"emphasis"},{"type":"text","text":" for the subtitle and also the "},{"inlineContent":[{"type":"text","text":"description"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"type":"step","code":"tutorial-onboarding-2-5.swift"},{"runtimePreview":"tutorial-onboarding-2-6.png","content":[{"inlineContent":[{"type":"text","text":"Now, it’s time to add the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbutton","isActive":true,"type":"reference"},{"type":"text","text":". OUDS provides plenty of components with properties related to notions defined in Figma kit and DSM. For example a button can have "},{"inlineContent":[{"type":"text","text":"appearance"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Add a button with a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbutton#Appearances","isActive":true,"type":"reference"},{"type":"text","text":", using the previously defined label, and no action."}],"type":"paragraph"}],"media":null,"type":"step","code":"tutorial-onboarding-2-6.swift"},{"runtimePreview":"tutorial-onboarding-2-7.png","content":[{"inlineContent":[{"type":"text","text":"You agree things are stucked and spacings are missing. "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/spacesemantictokens","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Some of these tokens have unique value like "},{"code":"theme.spaces.fixedMedium","type":"codeVoice"},{"type":"text","text":", but "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/spacemultiplesemantictokens","isActive":true,"type":"reference"},{"type":"text","text":" depending to the "},{"inlineContent":[{"type":"text","text":"size class"}],"type":"emphasis"},{"type":"text","text":" of the view like "},{"code":"theme.spaces.scaled2xsmall","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In addition, OUDS provides view modifiers to define "},{"inlineContent":[{"type":"text","text":"grid margins"}],"type":"emphasis"},{"type":"text","text":" on a view depending to a "},{"inlineContent":[{"text":"size class","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Try to apply some spacings: ","type":"text"},{"inlineContent":[{"type":"text","text":"fixedNone"}],"type":"emphasis"},{"text":" in the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"fixedMedium","type":"text"}]},{"type":"text","text":" as a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" minimum length below the button, "},{"inlineContent":[{"text":"top grid margin","type":"text"}],"type":"emphasis"},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"text":"title","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"grid margin","type":"text"}]},{"type":"text","text":" for all the "},{"code":"View","type":"codeVoice"},{"type":"text","text":", "},{"inlineContent":[{"text":"scaled2xsmall","type":"text"}],"type":"emphasis"},{"type":"text","text":" as "},{"inlineContent":[{"text":"vertical padding","type":"text"}],"type":"emphasis"},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"text":"subtitle","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledLarge"}]},{"type":"text","text":" as minimum length for a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" above the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"button"}]},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"type":"step","code":"tutorial-onboarding-2-7.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to force the "},{"inlineContent":[{"type":"text","text":"color scheme"}],"type":"emphasis"},{"type":"text","text":" of your view with "},{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"emphasis"},{"type":"text","text":" and apply a "},{"inlineContent":[{"text":"color token","type":"text"}],"type":"emphasis"},{"type":"text","text":" as background which will vary depending to this scheme."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define an "},{"type":"codeVoice","code":"HomeView"},{"type":"text","text":" with two "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects. For the second view, for to "},{"type":"emphasis","inlineContent":[{"text":"dark color scheme","type":"text"}]},{"type":"text","text":" and apply "},{"type":"codeVoice","code":"theme.colors.bgInverseLow"},{"type":"text","text":" background color."}]}],"code":"tutorial-onboarding-2-8.swift","runtimePreview":"tutorial-onboarding-2-8.png","type":"step","media":null}],"title":"Define the view basics","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Before de