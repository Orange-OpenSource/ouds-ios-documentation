efine "},{"inlineContent":[{"type":"text","text":"grid margins"}],"type":"emphasis"},{"type":"text","text":" on a view depending to a "},{"inlineContent":[{"type":"text","text":"size class"}],"type":"emphasis"},{"type":"text","text":"."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to apply some spacings: "},{"inlineContent":[{"type":"text","text":"fixedNone"}],"type":"emphasis"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"fixedMedium"}],"type":"emphasis"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" minimum length below the button, "},{"inlineContent":[{"type":"text","text":"top grid margin"}],"type":"emphasis"},{"type":"text","text":" for the "},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"grid margin"}],"type":"emphasis"},{"type":"text","text":" for all the "},{"type":"codeVoice","code":"View"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"scaled2xsmall"}],"type":"emphasis"},{"type":"text","text":" as "},{"inlineContent":[{"type":"text","text":"vertical padding"}],"type":"emphasis"},{"type":"text","text":" for the "},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"scaledLarge"}],"type":"emphasis"},{"type":"text","text":" as minimum length for a "},{"type":"codeVoice","code":"Spacer"},{"type":"text","text":" above the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"button"}]},{"type":"text","text":"."}]}],"type":"step","media":null,"runtimePreview":"tutorial-onboarding-2-7.png"},{"code":"tutorial-onboarding-2-8.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to force the "},{"inlineContent":[{"type":"text","text":"color sche