","type":"text"},{"text":" ","type":"text"},{"text":"In addition, OUDS provides view modifiers to define ","type":"text"},{"inlineContent":[{"type":"text","text":"grid margins"}],"type":"emphasis"},{"type":"text","text":" on a view depending to a "},{"type":"emphasis","inlineContent":[{"text":"size class","type":"text"}]},{"text":".","type":"text"}]}],"media":null,"code":"tutorial-onboarding-2-7.swift","runtimePreview":"tutorial-onboarding-2-7.png","caption":[{"inlineContent":[{"type":"text","text":"Try to apply some spacings: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fixedNone"}]},{"type":"text","text":" in the "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fixedMedium"}]},{"type":"text","text":" as a "},{"code":"Spacer","type":"codeVoice"},{"type":"text","text":" minimum length below the button, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"top grid margin"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"grid margin"}]},{"type":"text","text":" for all the "},{"code":"View","type":"codeVoice"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaled2xsmall"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical padding"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subtitle"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledLarge"}]},{"type":"text","text":" as minimum length for a "},{"code":"Spacer","type":"codeVoice"},{"type":"text","text":" above the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"button"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"step","content":[{"type":"paragraph","inlineCo