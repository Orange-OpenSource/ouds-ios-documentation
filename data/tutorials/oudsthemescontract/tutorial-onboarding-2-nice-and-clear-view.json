xt"},{"inlineContent":[{"type":"text","text":"medium heading"}],"type":"emphasis"},{"type":"text","text":", an "},{"type":"emphasis","inlineContent":[{"text":"XL heading","type":"text"}]},{"text":" for the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"type":"text","text":" and a "},{"type":"emphasis","inlineContent":[{"text":"large default body","type":"text"}]},{"text":" for the ","type":"text"},{"inlineContent":[{"type":"text","text":"description"}],"type":"emphasis"},{"type":"text","text":". You will need to get the "},{"type":"emphasis","inlineContent":[{"text":"theme","type":"text"}]},{"text":" object throw the dedicated environment variable to give it to the view modifiers.","type":"text"}]}]},{"code":"tutorial-onboarding-2-5.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, it’s time to apply colors on texts. "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudstokenssemantic\/colorsemantictokens"},{"type":"text","text":", i.e. small atomic elements defined in the design Figma kit. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" object contains tokens and provides them thanks to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"providers"}]},{"type":"text","text":"."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For all texts, change the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"foreground color"}]},{"type":"text","text":": apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentBrandPrimary"}]},{"type":"text","text":" for the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"title"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" for the subtitle and also the "},{"type":"emphasis","inlineCont