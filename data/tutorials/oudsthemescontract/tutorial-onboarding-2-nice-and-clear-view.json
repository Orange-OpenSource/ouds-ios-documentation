:"You should have an access to ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.figma.com\/design\/zJl6GhY2gMSMAibBJXoNPy\/Reveal-and-Onboarding?node-id=2259-4970&m=dev","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a basic "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", it must have an asset name to load as image, a title, a subtitle, a description and a label for the button."},{"type":"text","text":" "},{"type":"text","text":"Add also the Xcode "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" macro to display the view, here of course it will be empty."}]}],"media":null,"code":"tutorial-onboarding-2-1.swift","runtimePreview":"tutorial-onboarding-2-1.png","caption":[]},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS library provides view modifiers to be used in Xcode previews macros."},{"type":"text","text":" "},{"type":"text","text":"It allows to apply the theme you want in the view"}]}],"media":null,"code":"tutorial-onboarding-2-2.swift","runtimePreview":"tutorial-onboarding-2-1.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supposing we will work with Orange theme here, apply the "},{"type":"codeVoice","code":"orangePreview()"},{"type":"text","text":" view modifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, use the properties you defined in the Xcode preview, and display them in your "},{"type":"codeVoice","code":"InfoCard"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}]}],"media":null,"code":"tutorial-onboarding-2-3.swift","type":"step","runtimePreview":"tutorial-onboarding-2-3.png"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You may want to apply typography on texts. These effects will show most important content and bring meanings."},{"type":"text","text":" "},{"type":"text","text":"You can have a look on the "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/swiftuicore\/view"},{"type":"text","text":", which can be applied on "},{"type":"codeVoice","code":"View"},{"type":"text","text":" object."}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"For the ","type":"text"},{"inlineContent":[{"type":"text","text":"title"}],"type":"emphasis"},{"text":" with want a ","type":"text"},{"inlineContent":[{"text":"medium heading","type":"text"}],"type":"emphasis"},{"text":", an ","type":"text"},{"inlineContent":[{"type":"text","text":"XL heading"}],"type":"emphasis"},{"text":" for the ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"emphasis"},{"text":" and a ","type":"text"},{"inlineContent":[{"type":"text","text":"large default body"}],"type":"emphasis"},{"text":" for the ","type":"text"},{"inlineContent":[{"text":"description","type":"text"}],"type":"emphasis"},{"type":"text","text":". You will need to get the "},{"type":"emphasis","inlineContent":[{"text":"theme","type":"text"}]},{"type":"text","text":" object throw the dedicated environment variable to give it to the view modifiers."}]}],"media":null,"code":"tutorial-onboarding-2-4.swift","type":"step","runtimePreview":"tutorial-onboarding-2-4.png"},{"code":"tutorial-onboarding-2-5.swift","caption":[{"type":"paragraph","inlineContent":[