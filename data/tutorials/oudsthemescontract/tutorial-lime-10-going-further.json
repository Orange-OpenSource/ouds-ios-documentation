{"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}]}],"backgroundImage":"ic_theme_intro.png","kind":"hero","chapter":"Go further with more ressources","estimatedTimeInMinutes":10,"image":"ic_theme_intro.png","title":"Going further with more resources"},{"tasks":[{"stepsSection":[{"media":"tutorial-lime-10-1.png","code":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"The iOS technical documentation is available online. It has been generated from all the Swift DocC documentation written in the Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"You will find several catalogs (as many as libraries) with details about everything: components, tokens, themes, providers, etc.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"You can get it at ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/","type":"reference","isActive":true}]}]},{"media":"tutorial-lime-10-2.png","code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"text":" is also available there to get icons for your projects.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true,"type":"reference"}],"type":"pa