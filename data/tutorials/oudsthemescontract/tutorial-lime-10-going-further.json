ype":"paragraph","inlineContent":[{"type":"text","text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"But there are also other resources which can be useful for you."}]}],"kind":"contentAndMedia"}],"anchor":"More-resources","stepsSection":[{"type":"step","media":"tutorial-lime-10-1.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The iOS technical documentation is available online. It has been generated from all the Swift DocC documentation written in the Swift Package."},{"type":"text","text":" "},{"type":"text","text":"You will find several catalogs (as many as libraries) with details about everything: components, tokens, themes, providers, etc."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get it at "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/"}]}],"code":null,"runtimePreview":null},{"type":"step","media":"tutorial-lime-10-2.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"type":"text","text":" is also available there to get icons for your projects."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"type":"reference","isActive":true,"identifier":"https:\/\/unified-design-system.orange.com\/"}]}],"code":null,"runtimePreview":null},{"runtimePreview":null,"code":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technical architecture, tips about processes, tests, conventions and toolings."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Have a look "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki","isActive":true},{"type":"text","text":" to discover how OUDS works."}],"type":"paragraph"}],"media":"tutorial-lime-10-3.png"},{"runtimePreview":null,"code":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"For technical reasons the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"inlineContent":[{"text":"design system toolbox","type":"text"}],"type":"emphasis"},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","isActive":true}],"type":"paragraph"}],"media":"tutorial-lime-10-4.png"},{"runtimePreview":null,"code":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"type":"text","text":" GitHub repository."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Do not hesitate to "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true},{"type":"text","text":