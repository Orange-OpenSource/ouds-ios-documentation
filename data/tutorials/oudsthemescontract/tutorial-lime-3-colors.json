semantic color tokens like ","type":"text"},{"code":"contentBrandPrimary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"actionEnabled","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"bgTertiary","type":"codeVoice"},{"text":", as well as component-specific color tokens for Tags.","type":"text"}],"type":"paragraph"}],"chapter":"Colors","backgroundImage":"ic_component_intro.png","title":"Colors"},{"kind":"tasks","tasks":[{"stepsSection":[{"runtimePreview":"tutorial-lime-3.png","code":"tutorial-lime-3.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create the color providers. We’ll override "},{"type":"codeVoice","code":"LimeThemeColorProvider"},{"type":"text","text":" for semantic colors (using Malachite green)"}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Lime theme uses gray and green colors. We can refer to existing raw tokens, i.e. colors defined in Orange Unified Design System. You can define your own of course."}]}],"type":"step","media":null}],"anchor":"Overriding-color-tokens","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides semantic color tokens that can be overridden. We will create a custom color provider by subclassing "},{"type":"codeVoice","code":"OrangeThemeColorSemanticTokensProvider"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Key tokens to override:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"contentBrandPrimary"},{"type":"text","text":": Primary brand color for text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"actionEnabled"},{"type":"text","text":": Color for enabled actions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"bgTertiary"},{"type":"text","text":": Background color for containers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"borderBrandPrimary"},{"type":"text","text":": Can be used for dividers in some case"}],"type":"paragraph"}]}]}]}],"title":"Overriding color tokens"}]},{"assessments":[{"content":[],"choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OrangeThemeColorSemanticTokensProvider"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Color semantic tokens are declared in "},{"type":"codeVoice","code":"ColorSemanticTokens"},{"type":"text","text":" protocol and defined in "},{"type":"codeVoice","code":"OrangeThemeColorSemanticTokensProvider"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OrangeThemeCategoricalTagComponentTokensProvider"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Be aware about the tokens provider: some are for components, other for semantic tokens."}]}]}],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Which provider do you need to override to change the brand primary color?"}],"type":"paragraph"}]}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"abstract":[{"text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","action":{"isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders"},"title":"Borders"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"tutorial-lime-3.swift":{"type":"file","syntax":"swift","fileType":"swift","fileName":"Tokens.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        super.init(","            \/\/ Register all colors","            colors: LimeThemeColorProvider())","    }","}","","\/\/ MARK: - Color Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    \/\/ ColorSemanticToken: only one value is contained","    \/\/ MultipleColorSemanticToken: two values are defined for light and dark modes","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}"],"highlights":[{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51}],"identifier":"tutorial-lime-3.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"type":"topic","role":"project","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"title":"Colors","estimatedTime":"15min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"title":"Import the Swift Package and the libraries","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-librarie