ide semantic color tokens like "},{"code":"contentBrandPrimary","type":"codeVoice"},{"type":"text","text":", "},{"code":"actionEnabled","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"bgTertiary"},{"text":", as well as component-specific color tokens for Tags.","type":"text"}]}],"xcodeRequirement":"Xcode 27.1","title":"Colors","estimatedTimeInMinutes":15,"kind":"hero"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides semantic color tokens that can be overridden. We will create a custom color provider by subclassing ","type":"text"},{"type":"codeVoice","code":"OrangeThemeColorSemanticTokensProvider"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Key tokens to override:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"contentBrandPrimary","type":"codeVoice"},{"text":": Primary brand color for text","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"actionEnabled","type":"codeVoice"},{"text":": Color for enabled actions","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"bgTertiary","type":"codeVoice"},{"text":": Background color for containers","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"borderBrandPrimary","type":"codeVoice"},{"text":": Can be used for dividers in some case","type":"text"}]}]}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Overriding color tokens","anchor":"Overriding-color-tokens","stepsSection":[{"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"The Lime theme uses gray and green colors. We can refer to existing raw tokens, i.e. colors defined in Orange Unified Design System. You can define your own of course.","type":"text"}]}],"media":null,"code":"tutorial-lime-3.swift","content":[{"inlineContent":[{"text":"Let’s create the color providers. We’ll override ","type":"text"},{"type":"codeVoice","code":"LimeThemeColorProvider"},{"type":"text","text":" for semantic colors (using Malachite green)"}],"type":"paragraph"}],"runtimePreview":"tutorial-lime-3.png"}]}]},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"choices":[{"content":[{"inlineContent":[{"type":"text","text":"OrangeThemeColorSemanticTokensProvider"}],"type":"paragraph"}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Color semantic tokens are declared in ","type":"text"},{"type":"codeVoice","code":"ColorSemanticTokens"},{"text":" protocol and defined in ","type":"text"},{"type":"codeVoice","code":"OrangeThemeColorSemanticTokensProvider"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"text":"OrangeThemeCategoricalTagComponentTokensProvider","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Be aware about the tokens provider: some are for components, other for semantic tokens.","type":"text"}]}],"isCorrect":false}],"title":[{"inlineContent":[{"text":"Which provider do you need to override to change the brand primary color?","type":"text"}],"type":"paragraph"}],"type":"multiple-choice","content":[]}]},{"title":"Borders","kind":"callToAction","abstract":[{"type":"text","text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components."}],"featuredEyebrow":"Tutorial","action":{"isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders","overridingTitle":"Get started"}}],"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"project","references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further":{"title":"Going further with more resources","type":"topic","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"kind":"project","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further","estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"title":"Starting point","type":"section","abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Introduction":{"title":"Introduction","type":"topic","abstract":[],"kind":"article","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction","url":"\/tutorials\/table-of-contents-(lime)\/introduction"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Check-Your-Understanding"},"tutorial-lime-3.swift":{"type":"file","fileType":"swift","highlights":[{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51}],"identifier":"tutorial-lime-3.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        super.init(","            \/\/ Register all colors","            colors: LimeThemeColorProvider())","    }","}","","\/\/ MARK: - Color Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    \/\/ ColorSemanticToken: only one value is contained","    \/\/ MultipleColorSemanticToken: two values are defined for light and dark modes","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}"],"fileName":"Tokens.swift","syntax":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders":{"title":"Borders","type":"topic","abstract":[{"text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components.","type":"text"}],"kind":"project","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders","estimatedTime":"10min"},"tutorial-lime-3.png":{"type":"image","identifier":"tutorial-lime-3.png","alt":"App with Lime theme and green colors","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-lime-3.png"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)":{"title":"Swift Package Lime Tutorial","type":"topic","abstract":[{"text":"Learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"},{"text":" ","type":"text"},{"text":"In this tutorial, you will build the Lime fake theme with its own proper