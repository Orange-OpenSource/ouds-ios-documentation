e-Of-Contents-(discovery)\/Richer-and-more-original-components-of-OUDS","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Add-basic-components"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Typography,-view-modifiers-and-tokens","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-tokens"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Final-result"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Want-to-be-an-artist"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Check-Your-Understanding"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further#More-resources","kind":"task"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Richer-and-more-original-components-of-OUDS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"},"sections":[{"backgroundImage":"ic_component_intro.png","title":"Add more OUDS components","image":"ic_component_intro.png","estimatedTimeInMinutes":30,"xcodeRequirement":"Xcode 26.5","projectFiles":"OUDS-Discovery-Tutorial.zip","kind":"hero","chapter":"Richer and more original components of OUDS","content":[{"inlineContent":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some components like tags are original, and others like text input are richer. Let’s play with them!"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"inlineContent":[{"text":"The tags are small labels bringing pieces of information so as to give more context to the users. They are very simple to use.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"code":"tutorial-discovery-4-1.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"Add three tags thanks to ","type":"text"},{"code":"OUDSTag","type":"codeVoice"},{"text":" object.","type":"text"}]}],"runtimePreview":"tutorial-discovery-4-1.png"},{"code":"tutorial-discovery-4-2.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a group of chips for some topics the user must select. The picker is populated by an array of data, and the one we use as a "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" of array."},{"type":"text","text":" "},{"type":"text","text":"The user can select all of the items."}]}],"runtimePreview":"tutorial-discovery-4-2.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chips can be considered as interactive tags. OUDS provides "},{"type":"codeVoice","code":"OUDSSuggestionChip"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OUDSFilterChip"},{"type":"text","text":" depending to the needs of the users."},{"type":"text","text":" "},{"type":"text","text":"Just like the radio buttons and the checkboxes, OUDS package provides a "},{"type":"codeVoice","code":"OUDSChipPicker"},{"type":"text","text":" to add quickly a group of chips and select some of them using specific rule."},{"text":" ","type":"text"},{"type":"text","text":"This component is not official but can be helpful."}]}],"media":null,"type":"step"},{"code":"tutorial-discovery-4-3.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add two text inputs: one to get the user name with a delete action, and one for an email address."},{"type":"text","text":" "},{"type":"text","text":"Their values are exposed through "},{"code":"Binding","type":"codeVoice"},{"type":"text","text":" of "},{"code":"String","type":"codeVoice"},{"type":"text","text":"."}]}],"runtimePreview":"tutorial-discovery-4-3.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Formulars without input text are not formulars. OUDS provide an "},{"code":"OUDSTextInput","type":"codeVoice"},{"type":"text","text":" to let use write some text."},{"type":"text","text":" "},{"type":"text","text":"This component is very rich: preffix and suffix can be defined, and also helper text and links. An icon can be added and a trailing action."}]}],"media":null,"type":"step"},{"code":"tutorial-discovery-4-4.swift","caption":[{"inlineContent":[{"type":"text","text":"Add a "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":" gathering the link, the button and the switch item. You will need to get the theme object for your first time so as to choose the color of the surface! The import of "},{"type":"emphasis","inlineContent":[{"text":"OUDSTokensSemantic","type":"text"}]},{"type":"text","text":" is also necessary. Once your code is updated, compare the difference for the switch, the link and the button. Their style has changed!"}],"type":"paragraph"}],"runtimePreview":"tutorial-discovery-4-4.png","content":[{"inlineContent":[{"type":"text","text":"In some conditions, components need to be placed on colored surface. Indeed such colored surfaces make their components strongs and increase the efficiency and the onboarding of the users."},{"type":"text","text":" "},{"type":"text","text":"However some components like text, button and link must act differently if they are in such surfaces. For example they must use the monochrome colors."},{"type":"text","text":" "},{"type":"text","text":"In addition the colored surface brings a small set of colors so as to be sure contrasts and rendering of components are acceptable and all combinations tested."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless some components with particular appearances must not be added in such surface, it is forbidden by design. Developers must check the documentation of the component and also apply the specifications of their designers who know these rules thanks to the Figma OUDS assets."}],"type":"paragraph"}],"media":null,"type":"step"}],"anchor":"Add-basic-components","title":"Add basic components"}]},{"anchor":"Check-Your-Understanding","assessments":[{"type":"multiple-choice","choices":[{"justification":[{"inlineContent":[{"text":"Even if you apply the color you want on the background, it will not be enough because some components can have accessibility issues with bad WCAG ratios. Colored surface provides small set of colors for which components are ready.","type":"text"}],"type":"paragraph"}],"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"Never, I can just change the background"}],"type":"paragraph"}]},{"justification":[{"inlineContent":[{"text":"No, you should see with your designer so as to know when a colored surface must be used.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Or if you do not have designers, be an artist and test what is pleasant for you!"}],"type":"paragraph"}],"isCorrect":false,"content":[{"inlineContent":[{"text":"Always, thus my components feel good","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Sometimes, it depends to the context","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In most of cases components should not be in monochrome mode and colored surface used. See with your designers the cases when you will have to use the "},{"code":"OUDSColoredSurface","type":"codeVoice"},{"type":"text","text":". Or be an artist and test what is pleasant for you!"}]}],"isCorrect":true}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In which case should I use the colored surface?"}]}],"content":[]}],"kind":"assessments"},{"featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"action":{"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"title":"Styling things","kind":"callToAction"}],"metadata":{"role":"project","categoryPathComponent":"Table-Of-Contents-(discovery)","title":"Add more OUDS components","category":"Orange Unified Design System"},"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-librairies#Check-Your-Understanding":{"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-librairies#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-librairies#Check-Your-Understanding","title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components#Check-Your-Understanding":{"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding","title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-6-going-further#More-resources":{"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further#More-resources","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further#More-resources","title":"More resources","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Final-result":{"abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Final-result","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Final-result","title":"Final result","role":"pseudoSymbol"},"tutorial-discovery-4-2.png":{"type":"image","alt":"Chips are now integrated inside a picker","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-discovery-4-2.png"}],"identifier":"tutorial-discovery-4-2.png"},"tutorial-discovery-4-2.swift":{"fileName":"Content.swift","highlights":[{"line":10},{"line":25},{"line":26},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67}],"fileType":"swift","syntax":"swift","type":"file","identifier":"tutorial-discovery-4-2.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","    @State var selectedTopics: [Topics] = []","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            HStack {","                OUDSTag(label: \"Welcome\")","                OUDSTag(label: \"OUDS\")","                OUDSTag(label: \"Tutorial\")","            }","","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","","            OUDSButton(text: \"Create my profile\",","                       appearance: .strong,","                       style: creatingProfile ? .loading : .default)","            {","                creatingProfile = true","                DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                    creatingProfile = false","                }","            }.disabled(!termsAccepted)","","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Import-of-the-Swift-Package-and-choose-its-librairies":{"abstract":[],"url":"\/tutorials\/table-of-contents-(discovery)\/import-of-the-swift-package-and-choose-its-librairies","type":"topic","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Import-of-the-Swift-Package-and-choose-its-librairies","title":"Import of the Swift Package and choose its librairies","role":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme":{"abstract":[{"type":"text","text":"The theme is exposed as one object which will be injected inside your SwiftUI view."},{"type":"text","text":" "},{"type":"text","text":"The theme provides all tokens which defines in the end the rendering of everything."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme","type":"topic","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme","estimatedTime":"15min","title":"Instanciate and inject a theme","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding":{"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things","type":"topic","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","estimatedTime":"30min","title":"Styling things","role":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Go-further-with-more-ressources":{"abstract":[],"url":"\/tutorials\/table-of-contents-(discovery)\/go-further-with-more-ressources","type":"topi