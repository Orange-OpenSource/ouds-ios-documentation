OUDSThemesContract\/tutorial-discovery-4-use-other-components#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Typography,-view-modifiers-and-tokens","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Final-result","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Want-to-be-an-artist","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further#More-resources","kind":"task"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"}]}],"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Richer-and-more-original-components-of-OUDS"]],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)"},"references":{"OUDS-Discovery-Tutorial.zip":{"url":"\/downloads\/OUDSThemesContract\/OUDS-Discovery-Tutorial.zip","checksum":"7a613e81ab6dd04c404f00cbb3b418858ffb3ed0cc659e0f975821f4508a7da1d54bfc8e83334bbc32b4d48f26a37e00151dc28e96fb59d947ccae13bce34678","type":"download","identifier":"OUDS-Discovery-Tutorial.zip"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme":{"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme","abstract":[{"text":"The theme is exposed as one object which will be injected inside your SwiftUI view.","type":"text"},{"text":" ","type":"text"},{"text":"The theme provides all tokens which defines in the end the rendering of everything.","type":"text"}],"role":"project","kind":"project","estimatedTime":"15min","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme","title":"Instanciate and inject a theme"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Typography,-view-modifiers-and-tokens":{"url":"\/tutorials\/table-of-contents-(discovery)\/typography,-view-modifiers-and-tokens","abstract":[],"role":"article","kind":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Typography,-view-modifiers-and-tokens","title":"Typography, view modifiers and tokens"},"tutorial-discovery-4-3.swift":{"syntax":"swift","fileType":"swift","highlights":[{"line":11},{"line":12},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35}],"type":"file","identifier":"tutorial-discovery-4-3.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","    @State var selectedTopics: [Topics] = []","    @State var identity: String = \"\"","    @State var email: String = \"\"","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            HStack {","                OUDSTag(label: \"Welcome\")","                OUDSTag(label: \"OUDS\")","                OUDSTag(label: \"Tutorial\")","            }","","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            let identityDeleteAction = OUDSTextInput.TrailingAction(image: .init(asset: Image(systemName: \"trash\")), actionHint: \"Delete\") { identity = \"\" }","            OUDSTextInput(label: \"Identity\", text: $identity, placeholder: \"Firstname and lastname\", trailingAction: identityDeleteAction)","","            OUDSTextInput(label: \"Email\", text: $email,","                          placeholder: \"Email address\",","                          suffix: \".com\",","                          leadingImage: .init(asset: Image(systemName: \"envelope\")),","                          helperText: \"The email will be automatically completed with @orange.com\")","","            OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(\"I accept the terms of use\", isOn: $termsAccepted)","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","","            OUDSButton(text: \"Create my profile\",","                       appearance: .strong,","                       style: creatingProfile ? .loading(progress: nil) : .default)","            {","                creatingProfile = true","                DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                    creatingProfile = false","                }","            }.disabled(!termsAccepted)","","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileName":"Content.swift"},"ic_component_intro.png":{"identifier":"ic_component_intro.png","alt":"OUDS components logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"estimatedTime":"30min","type":"topic","title":"Use your first OUDS components","role":"project","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components","abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"role":"project","kind":"project","estimatedTime":"30min","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","title":"Add more OUDS components"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"type":"topic","title":"Swift Package Discovery Tutorial","role":"overview","abstract":[{"type":"text","text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package."},{"type":"text","text":" "},{"type":"text","text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework."},{"type":"text","text":" "},{"type":"text","text":"Theme, components, tokens… everything will be introduced!"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","kind":"overview","url":"\/tutorials\/table-of-contents-(discovery)"},"tutorial-discovery-4-1.png":{"type":"image","identifier":"tutorial-discovery-4-1.png","alt":"Tags in top of form","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-4-1.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Use-of-view-modifiers":{"url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Use-of-view-modifiers","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Use-of-view-m