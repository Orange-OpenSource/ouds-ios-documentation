runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get it at "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/","isActive":true}]}],"media":"tutorial-discovery-6-1.png","type":"step"},{"type":"step","runtimePreview":null,"content":[{"inlineContent":[{"text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"text":" is also available there to get icons for your projects.","type":"text"}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true,"type":"reference"}]}],"media":"tutorial-discovery-6-2.png","code":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings.","type":"text"}]}],"code":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Have a look "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki","isActive":true},{"type":"text","text":" to discover how OUDS works."}]}],"media":"tutorial-discovery-6-3.png","type":"step"},{"type":"step","runtimePreview":null,"content":[{"inlineContent":[{"text":"For technical reasons the ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"text":" GitHub repository does not embed the source code of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"design system toolbox"}]},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"To get the source code of this showcase app, go to its dedicated GitHub repository at ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"reference","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-4.png","code":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"type":"text","text":" GitHub repository."}]}],"code":null,"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"Do not hesitate to "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true},{"type":"text","text":"!"}],"type":"paragraph"}],"media":"tutorial-discovery-6-5.png","type":"step"}],"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"But there are also other resources which can be useful for you.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"More-resources"}],"kind":"tasks"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"},"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(onboard