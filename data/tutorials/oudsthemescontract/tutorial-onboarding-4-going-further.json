a":"tutorial-discovery-6-1.png","code":null,"type":"step"},{"caption":[{"inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/unified-design-system.orange.com\/"}],"type":"paragraph"}],"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"text":" is also available there to get icons for your projects.","type":"text"}]}],"media":"tutorial-discovery-6-2.png","code":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"Have a look ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"text":" to discover how OUDS works.","type":"text"}]}],"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings."}],"type":"paragraph"}],"media":"tutorial-discovery-6-3.png"},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"For technical reasons the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"text":" GitHub repository does not embed the source code of the ","type":"text"},{"inlineContent":[{"type":"text","text":"design system toolbox"}],"type":"emphasis"},{"text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox"}]}],"media":"tutorial-discovery-6-4.png"},{"content":[{"inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository."}],"type":"paragraph"}],"code":null,"type":"step","caption":[{"inlineContent":[{"text":"Do not hesitate to ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions"},{"text":"!","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"media":"tutorial-discovery-6-5.png"}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"But there are also other resources which can be useful for you.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"More-resources","title":"More resources"}],"kind":"tasks"}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","interfaceLanguage":"swift"},"metadata":{"category":"Orange Unified Design System","role":"project","categoryPathComponent":"Table-Of-Contents-(onboarding)","title":"Going further with more resources"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-fu