{"kind":"project","sections":[{"kind":"hero","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}]}],"title":"Going further with more resources","image":"ic_theme_intro.png","chapter":"Go further with more ressources","estimatedTimeInMinutes":10,"backgroundImage":"ic_theme_intro.png"},{"tasks":[{"anchor":"More-resources","title":"More resources","contentSection":[{"content":[{"inlineContent":[{"text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"But there are also other resources which can be useful for you."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"runtimePreview":null,"content":[{"inlineContent":[{"text":"The iOS technical documentation is available online. It has been generated from all the Swift DocC documentation written in the Swift Package.","type":"text"},{"type":"text","text":" "},{"text":"You will find several catalogs (as many as librairies) with details about everyhting: components, tokens, themes, providers, etc.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"You can get it at ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/"}],"type":"paragraph"}],"media":"tutorial-discovery-6-1.png","code":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"icon finder"}]},{"type":"text","text":" is also available there to get icons for your projects."}]}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Go to the website and learn things at "},{"type":"reference","identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-2.png","code":null},{"caption":[{"inlineContent":[{"type":"text","text":"Have a look "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki"},{"type":"text","text":" to discover how OUDS works."}],"type":"paragraph"}],"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings.","type":"text"}],"type":"paragraph"}],"media":"tutorial-discovery-6-3.png","code":null},{"caption":[{"inlineContent":[{"text":"To get the source code of this showcase app, go to its dedicated GitHub repository at ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","type":"reference","isActive":true}],"type":"paragraph"}],"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"For technical reasons the "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"type":"text","text":" GitHub repository does not embed the source code of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"design system toolbox"}]},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}],"type":"paragraph"}],"media":"tutorial-discovery-6-4.png","code":null},{"caption":[{"type":"paragraph","inlineContent":[{"text":"Do not hesitate to ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues"},{"text":" or ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true,"type":"reference"},{"type":"text","text":"!"}]}],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":" GitHub repository."}]}],"media":"tutorial-discovery-6-5.png","code":null}]}],"kind":"tasks"}],"hierarchy":{"modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-librairies","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies","sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Check-Your-Understanding"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","projects