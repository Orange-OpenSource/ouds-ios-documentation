{"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}]}],"image":"ic_theme_intro.png","chapter":"Go further with more ressources","kind":"hero","estimatedTimeInMinutes":10,"backgroundImage":"ic_theme_intro.png","title":"Going further with more resources"},{"kind":"tasks","tasks":[{"title":"More resources","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"But there are also other resources which can be useful for you.","type":"text"}]}]}],"anchor":"More-resources","stepsSection":[{"media":"tutorial-discovery-6-1.png","runtimePreview":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get it at "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/"}]}],"code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The iOS technical documentation is available online. It has been generated from all the Swift DocC documentation written in the Swift Package."},{"type":"text","text":" "},{"type":"text","text":"You will find several catalogs (as many as librairies) with details about everyhting: components, tokens, themes, providers, etc."}]}]},{"media":"tutorial-discovery-6-2.png","runtimePreview":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"isActive"