{"kind":"project","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further"]}],"sections":[{"image":"ic_theme_intro.png","backgroundImage":"ic_theme_intro.png","title":"Going further with more resources","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}]}],"chapter":"Go further with more ressources","estimatedTimeInMinutes":10,"kind":"hero"},{"kind":"tasks","tasks":[{"stepsSection":[{"type":"step","caption":[{"inlineContent":[{"text":"You can get it at ","type":"text"},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-1.png","content":[{"inlineContent":[{"text":"The iOS technical documentation is available online. It has been generated from all the Swift DocC documentation written in the Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"You will find several catalogs (as many as librairies) with details about everyhting: components, tokens, themes, providers, etc.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"type":"step","caption":[{"inlineContent":[{"text":"Go to the website and learn things at ","type":"text"},{"type":"reference","identifier":"https:\/\/unified-design-system.orange.com\/","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-2.png","content":[{"inlineContent":[{"text":"The whole design system is documented and available online. You can find everything about components, tokens, guidelines and principles of OUDS.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"icon finder"}],"type":"emphasis"},{"text":" is also available there to get icons for your projects.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"type":"step","caption":[{"inlineContent":[{"text":"Have a look ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki","isActive":true},{"text":" to discover how OUDS works.","type":"text"}],"type":"paragraph"}],"media":"tutorial-discovery-6-3.png","content":[{"inlineContent":[{"text":"OUDS iOS provides also a wiki attached to its GitHub repository. The wiki is a public base of knowledge with plenty of things: available API, technicala architecture, tips about processes, tests, conventions and toolings.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"type":"step","caption":[{"inlineContent":[{"text":"To get the source code of this showcase app, go to its dedicated GitHub repository at ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","isActive":true}],"type":"paragraph"}],"media":"tutorial-discovery-6-4.png","content":[{"inlineContent":[{"text":"For technical reasons the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"text":" GitHub repository does not embed the source code of the ","type":"text"},{"inlineContent":[{"type":"text","text":"design system toolbox"}],"type":"emphasis"},{"text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"type":"step","caption":[{"inlineContent":[{"text":"Do not hesitate to ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true},{"text":"!","type":"text"}],"type":"paragraph"}],"media":"tutorial-discovery-6-5.png","content":[{"inlineContent":[{"text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true},{"text":" GitHub repository.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null}],"title":"More resources","anchor":"More-resources","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Xcode can use the Swift DocC documentation of OUDS, and this documentation is used to build a static web site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"But there are also other resources which can be useful for you.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}]}]}],"metadata":{"category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(onboarding)","role":"project","title":"Going further with more resources"},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","interfaceLanguage":"swift"},"hierarchy":{"modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-librairies","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutor