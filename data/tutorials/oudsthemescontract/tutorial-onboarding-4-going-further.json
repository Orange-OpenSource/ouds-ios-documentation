fier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki","type":"reference","isActive":true},{"text":" to discover how OUDS works.","type":"text"}],"type":"paragraph"}],"media":"tutorial-discovery-6-3.png","code":null},{"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"For technical reasons the ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"text":" GitHub repository does not embed the source code of the ","type":"text"},{"inlineContent":[{"type":"text","text":"design system toolbox"}],"type":"emphasis"},{"type":"text","text":" app. In fact this app and all its snapshots for tests increases a lot the size of the repository."}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the source code of this showcase app, go to its dedicated GitHub repository at "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios-design-system-toolbox","isActive":true,"type":"reference"}]}],"media":"tutorial-discovery-6-4.png","code":null},{"content":[{"inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true,"type":"reference"},{"type":"text","text":" GitHub repository."}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"Do not hesitate to ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions"},{"text":"!","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null,"media":"tutorial-discovery-6-5.png"}]}],"kind":"tasks"}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboar