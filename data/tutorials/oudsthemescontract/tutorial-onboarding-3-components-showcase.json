ding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries"},"OUDS-Onboarding-Tutorial.zip":{"url":"\/downloads\/OUDSThemesContract\/OUDS-Onboarding-Tutorial.zip","identifier":"OUDS-Onboarding-Tutorial.zip","type":"download","checksum":"2f576d52c5a4d1d3be6c46490a441f13908203cc2337f65c43d8d27f831e8285118cc788cb0d3f72789df1ea6d51e80ea3a04fef41c1698b4a37b2258ab8ddfe"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","type":"topic","abstract":[{"type":"text","text":"Discovering a new framework can be exciting and scary."},{"type":"text","text":" "},{"type":"text","text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand."},{"type":"text","text":" "},{"type":"text","text":"It has beend esigned for local events and meetups."},{"type":"text","text":" "},{"type":"text","text":"Let’s play!"}],"url":"\/tutorials\/table-of-contents-(onboarding)","kind":"overview","title":"Swift Package Onboarding Tutorial","role":"overview"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","title":"badges","titleInlineContent":[{"type":"text","text":"badges"}],"type":"link"},"tutorial-onboarding-3-6.swift":{"type":"file","fileName":"ComponentShowcase.swift","identifier":"tutorial-onboarding-3-6.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"syntax":"swift","fileType":"swift","highlights":[]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"abstract":[],"kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","title":"Define information cards","role":"article","type":"topic"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"link","titleInlineContent":[{"inlineContent":[{"type":"text","text":"password input"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","title":"password input"}}}