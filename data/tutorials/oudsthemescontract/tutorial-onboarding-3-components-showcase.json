{"kind":"project","identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase","interfaceLanguage":"swift"},"sections":[{"xcodeRequirement":"Xcode 27.1","title":"Components showcase","image":"ic_theme_intro.png","estimatedTimeInMinutes":60,"chapter":"Components showcases","backgroundImage":"ic_theme_intro.png","projectFiles":"OUDS-Onboarding-Tutorial.zip","content":[{"type":"paragraph","inlineContent":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}]}],"kind":"hero"},{"tasks":[{"stepsSection":[{"type":"step","media":null,"code":"tutorial-onboarding-3-1.swift","content":[{"inlineContent":[{"type":"text","text":"Define a basic "},{"type":"codeVoice","code":"Control"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its "},{"inlineContent":[{"text":"body","type":"text"}],"type":"emphasis"},{"type":"text","text":" a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside the components you want, for example "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Do not forget the Xcode preview."}],"type":"paragraph"}],"caption":[],"runtimePreview":"tutorial-onboarding-3-1.png"},{"type":"step","media":null,"code":"tutorial-onboarding-3-2.swift","content":[{"inlineContent":[{"type":"text","text":"OUDS provides also components as "},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"emphasis"},{"type":"text","text":" like "},{"inlineContent":[{"text":"badges","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"tags","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define an "},{"type":"codeVoice","code":"Indicator"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", with a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" applying "},{"inlineContent":[{"text":"theme.spaces.scaledMedium","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing token for a "},{"inlineContent":[{"text":"vertical size class","type":"text"}],"type":"emphasis"},{"type":"text","text":", and containing an "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" with a "},{"inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},{"type":"text","text":": do not hesitate to change their "},{"inlineContent":[{"text":"status","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"size","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}],"type":"paragraph"}],"caption":[],"runtimePreview":"tutorial-onboarding-3-2.png"},{"type":"step","media":null,"code":"tutorial-onboarding-3-3.swift","content":[{"inlineContent":[{"type":"text","text":"There are also "},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"type":"text","text":" components in OUDS like "},{"inlineContent":[{"text":"links","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"tab bars","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing and three "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"type":"text","text":": a "},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"type":"text","text":" link, a "},{"inlineContent":[{"text":"back","type":"text"}],"type":"emphasis"},{"type":"text","text":" link and an "},{"inlineContent":[{"text":"informational","type":"text"}],"type":"emphasis"},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-3.png"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Components are gathered by group or families. You can find all of theme in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For example, in "},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"type":"text","text":" family you will find "},{"inlineContent":[{"text":"checkboxes","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"radio buttons","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"switch items","type":"text"}],"type":"emphasis"},{"type":"text","text":" and some "},{"inlineContent":[{"text":"inputs","type":"text"}],"type":"emphasis"},{"type":"text","text":" fields."},{"type":"text","text":" "},{"inlineContent":[{"text":"Layouts","type":"text"}],"type":"emphasis"},{"type":"text","text":" provides "},{"inlineContent":[{"text":"dividers","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"buttons","type":"text"}],"type":"emphasis"},{"type":"text","text":" are in "},{"inlineContent":[{"text":"actions","type":"text"}],"type":"emphasis"},{"type":"text","text":" group, "},{"inlineContent":[{"text":"bullet lists","type":"text"}],"type":"emphasis"},{"type":"text","text":" in "},{"inlineContent":[{"text":"display","type":"text"}],"type":"emphasis"},{"type":"text","text":" family."}],"type":"paragraph"}]}],"anchor":"Discover-main-components","title":"Discover main components"},{"stepsSection":[{"type":"step","media":null,"code":"tutorial-onboarding-3-4.swift","content":[{"inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"type":"text","text":" components, "},{"inlineContent":[{"text":"indicator","type":"text"}],"type":"emphasis"},{"type":"text","text":" components and "},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"type":"text","text":" components. The "},{"inlineContent":[{"text":"enum","type":"text"}],"type":"emphasis"},{"type":"text","text":" to define must conform to "},{"inlineContent":[{"text":"CaseIterable","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"CustomStringConvertible","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],"caption":[],"runtimePreview":null},{"type":"step","media":null,"code":"tutorial-onboarding-3-5.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Then define a ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"text":"ComponentGroup","type":"text"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" as "},{"inlineContent":[{"type":"text","text":"Binding"}],"type":"emphasis"},{"text":". Use the ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}],"type":"emphasis"},{"text":" token for horizontal spacing between the chips.","type":"text"}]}],"caption":[],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"code":"ComponentShowcase","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledMedium"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}]}],"media":null,"caption":[],"code":"tutorial-onboarding-3-6.swift","type":"step","runtimePreview":null}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}],"type":"paragraph"}]}],"anchor":"Merge-components-in-a-richer-view","title":"Merge components in a richer view"},{"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview"},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":", and add inside your previously defined "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]}],"runtimePreview":"tutorial-onboarding-3-7.png","type":"step","caption":[],"code":"tutorial-onboarding-3-7.swift","media":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components like a "},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":". The "},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"media":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}]}],"code":"tutorial-onboarding-3-8.swift","type":"step","runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png"}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further"}],"kind":"tasks"},{"assessments":[{"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"OUDSThemeableView","type":"codeVoice"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"text":"Any other view","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}]}],"isCorrect":false}],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}]},{"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, of course!","type":"text"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, not possible","type":"text"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}]}]}],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}]},{"title":[{"type":"paragraph","inlineContent":[{"text":"Components have all the same rendering whatever is the OS version","type":"text"}]}],"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}]}],"isCorrect":false},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Liquid Glass is applied on navigation elements like tab bar","type":"text"}]}],"isCorrect":true}],"type":"multiple-choice"}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"featuredEyebrow":"Tutorial","action":{"isActive":true,"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"kind":"callToAction","title":"Going further with more resources"}],"hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","modules":[{"p