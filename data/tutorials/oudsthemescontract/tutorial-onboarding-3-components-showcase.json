ontract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"kind":"overview","url":"\/tutorials\/table-of-contents-(onboarding)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","title":"Swift Package Onboarding Tutorial","type":"topic","abstract":[{"type":"text","text":"Discovering a new framework can be exciting and scary."},{"type":"text","text":" "},{"type":"text","text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand."},{"type":"text","text":" "},{"type":"text","text":"It has beend esigned for local events and meetups."},{"type":"text","text":" "},{"type":"text","text":"Let’s play!"}],"role":"overview"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further#More-resources":{"type":"section","title":"More resources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources","kind":"section","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further#More-resources","role":"pseudoSymbol"},"tutorial-onboarding-3-3.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"highlights":[],"fileType":"swift","syntax":"swift","fileName":"Navigation.swift","identifier":"tutorial-onboarding-3-3.swift","type":"file"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","type":"link","titleInlineContent":[{"type":"emphasis","inlineContent":[{"text":"text input","type":"text"}]}],"title":"text input","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput"},"tutorial-onboarding-3-4.swift":{"type":"file","identifier":"tutorial-onboarding-3-4.swift","fileName":"ComponentGroup.swift","fileType":"swift","syntax":"swift","highlights":[],"content":["import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view":{"kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","type":"section","title":"Merge components in a richer view","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"type":"section","title":"Import the Swift Package and the libraries","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","role":"pseudoSymbol"},"tutorial-onboarding-3-1.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png"}],"type":"image","identifier":"tutorial-onboarding-3-1.png","alt":"A simple view with some component inside"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"kind":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","title":"Components showcases","type":"topic","abstract":[],"role":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"type":"topic","title":"Swift Package integration","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","kind":"project","estimatedTime":"10min","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","role":"project"},"tutorial-onboarding-3-1.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"highlights":[],"fileType":"swift","syntax":"swift","fileName":"Control.swift","identifier":"tutorial-onboarding-3-1.swift","type":"file"},"Xcode 26.5":{"type":"xcodeRequirement","identifier":"Xcode 26.5","title":"Xcode 26.5","url":"https:\/\/developer.apple.com\/download\/"}}}