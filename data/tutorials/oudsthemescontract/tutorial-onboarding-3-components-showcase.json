ice-and-clear-view#Check-Your-Understanding","type":"link","title":"Check Your Understanding"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsfilterchip/":{"titleInlineContent":[{"inlineContent":[{"text":"filter chip","type":"text"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"link","title":"filter chip"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","type":"topic","role":"article","title":"Components showcases","kind":"article"},"tutorial-onboarding-3-4.swift":{"highlights":[],"content":["import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"],"fileName":"ComponentGroup.swift","syntax":"swift","identifier":"tutorial-onboarding-3-4.swift","type":"file","fileType":"swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","type":"topic","role":"article","title":"Define information cards","kind":"article"},"tutorial-onboarding-3-3.swift":{"highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"fileName":"Navigation.swift","syntax":"swift","identifier":"tutorial-onboarding-3-3.swift","type":"file","fileType":"swift"},"tutorial-onboarding-3-2.swift":{"highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"fileName":"Indicator.swift","syntax":"swift","identifier":"tutorial-onboarding-3-2.swift","type":"file","fileType":"swift"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsradioitem/":{"titleInlineContent":[{"inlineContent":[{"text":"radio item","type":"text"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","type":"link","title":"radio item"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"titleInlineContent":[{"inlineContent":[{"text":"text input","type":"text"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","type":"link","title":"text input"},"tutorial-onboarding-3-1.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png","traits":["1x","light"]}],"identifier":"tutorial-onboarding-3-1.png","type":"image","alt":"A simple view with some component inside"},"tutorial-onboarding-3-6.swift":{"highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"fileName":"ComponentShowcase.swift","syntax":"swift","identifier":"tutorial-onboarding-3-6.swift","type":"file","fileType":"swift"},"Xcode 27.1":{"url":"https:\/\/developer.apple.com\/download\/","identifier":"Xcode 27.1","type":"xcodeRequirement","title":"Xcode 27.1"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","type":"section","role":"pseudoSymbol","title":"Discover main components","kind":"section"},"https://ios.unified-design-system.orange.com/documentation/oudsthemescontract/oudsthemeableview":{"titleInlineContent":[{"type":"codeVoice","code":"OUDSThemeableView"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","type":"link","title":"OUDSThemeableView"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstabbar/":{"titleInlineContent":[{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"link","title":"tab bar"},"tutorial-onboarding-3-1.swift":{"highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", i