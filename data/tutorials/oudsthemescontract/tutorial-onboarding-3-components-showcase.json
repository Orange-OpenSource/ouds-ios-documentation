ode":"tutorial-onboarding-3-4.swift","caption":[],"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"text":" components, ","type":"text"},{"inlineContent":[{"type":"text","text":"indicator"}],"type":"emphasis"},{"type":"text","text":" components and "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components. The "},{"inlineContent":[{"text":"enum","type":"text"}],"type":"emphasis"},{"type":"text","text":" to define must conform to "},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"CustomStringConvertible"}],"type":"emphasis"}],"type":"paragraph"}],"media":null},{"type":"step","media":null,"code":"tutorial-onboarding-3-5.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","isActive":true},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"text":"ComponentGroup","type":"text"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}],"type":"paragraph"}],"caption":[]},{"type":"step","media":null,"code":"tutorial-onboarding-3-6.swift","runtimePreview":null,"content":[{"inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"code":"ComponentShowcase","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":". In the top of it, display a welcoming text with ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"text":" typography and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"text":" foreground color. Just below add the ","type":"text"},{"code":"CategorySelector","type":"codeVoice"},{"text":" and pack them in a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" using a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"text":" spacing for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"text":". Apply ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"text":" background color to this ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"code":"ZStack","type":"codeVoice"},{"text":" and use the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"text":" to apply opacity on the suitable view.","type":"text"}],"type":"paragraph"}],"caption":[]}],"title":"Merge components in a richer view","anchor":"Merge-components-in-a-richer-view"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}]}],"stepsSection":[{"runtimePreview":"tutorial-onboarding-3-7.png","caption":[],"content":[{"inlineContent":[{"text":"If you want to apply a theme everywhere in your app, or on specific view, one special ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" is for you: the ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true,"type":"reference"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"code":"ContentView","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":", add in its ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":" the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" with an instance of ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":", and add inside your previously defined ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-3-7.swift","type":"step"},{"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","caption":[{"type":"paragraph","inlineContent":[{"text":"You can see how it looks like with other themes like ","type":"text"},{"code":"SoshTheme","type":"codeVoice"},{"text":", ","type":"text"},{"code":"WireframeTheme","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"OrangeCompactTheme","type":"codeVoice"},{"text":".","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components like a ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"media":null,"code":"tutorial-onboarding-3-8.swift","type":"step"}],"title":"Navigations and themeable view, a step further","anchor":"Navigations-and-themeable-view-a-step-further"}]},{"kind":"assessments","assessments":[{"title":[{"type":"paragraph","inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}]}],"type":"multiple-choice","choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}]}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"justification":[{"inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"content":[]},{"type":"multiple-choice","title":[{"inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}],"type":"paragraph"}],"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"