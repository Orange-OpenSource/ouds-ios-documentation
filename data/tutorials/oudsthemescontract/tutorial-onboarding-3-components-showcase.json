"},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"text":" as ","type":"text"},{"inlineContent":[{"text":"Binding","type":"text"}],"type":"emphasis"},{"text":". Use the ","type":"text"},{"inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}],"type":"emphasis"},{"text":" token for horizontal spacing between the chips.","type":"text"}]}]},{"type":"step","caption":[],"media":null,"code":"tutorial-onboarding-3-6.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"type":"codeVoice","code":"ComponentShowcase"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". In the top of it, display a welcoming text with ","type":"text"},{"inlineContent":[{"text":"heading large","type":"text"}],"type":"emphasis"},{"text":" typography and ","type":"text"},{"inlineContent":[{"text":"contentDefault","type":"text"}],"type":"emphasis"},{"text":" foreground color. Just below add the ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"text":" and pack them in a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" using a ","type":"text"},{"inlineContent":[{"text":"scaledMedium","type":"text"}],"type":"emphasis"},{"text":" spacing for ","type":"text"},{"inlineContent":[{"text":"vertical size class","type":"text"}],"type":"emphasis"},{"text":". Apply ","type":"text"},{"inlineContent":[{"text":"bgSecondary","type":"text"}],"type":"emphasis"},{"text":" background color to this ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"type":"codeVoice","code":"ZStack"},{"text":" and use the ","type":"text"},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"text":" to apply opacity on the suitable view.","type":"text"}]}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}]}]}],"anchor":"Merge-components-in-a-richer-view","title":"Merge components in a richer view"},{"stepsSection":[{"type":"step","caption":[],"media":null,"code":"tutorial-onboarding-3-7.swift","runtimePreview":"tutorial-onboarding-3-7.png","content":[{"type":"paragraph","inlineContent":[{"text":"If you want to apply a theme everywhere in your app, or on specific view, one special ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" is for you: the ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true,"type":"reference"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":", add in its ","type":"text"},{"inlineContent":[{"text":"body","type":"text"}],"type":"emphasis"},{"text":" the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" with an instance of ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":", and add inside your previously defined ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}]}]},{"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"You can see how it looks like with other themes like ","type":"text"},{"type":"codeVoice","code":"SoshTheme"},{"text":", ","type":"text"},{"type":"codeVoice","code":"WireframeTheme"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"OrangeCompactTheme"},{"text":".","type":"text"}]}],"media":null,"code":"tutorial-onboarding-3-8.swift","runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components like a ","type":"text"},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"text":". The ","type":"text"},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18).","type":"text"},{"text":" ","type":"text"},{"text":"Add a ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true,"type":"reference"},{"text":", with 3 items inside it: the ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" and two fake views.","type":"text"}]}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Now you master the components and the tokens, you can use ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}]}]}],"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further"}]},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}]}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"}]}]},{"justification":[{"type":"paragraph","inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"Any other view","type":"text"}]}]}],"content":[],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}]},{"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"text":"Of course you can mix views from SwiftUI and OUDS","type":"text"}]}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, of course!","type":"text"}]}]},{"justification":[{"type":"paragraph","inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"No, not possible","type":"text"}]}]}],"content":[],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}]},{"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}]},{"justification":[{"type":"paragraph","inlineContent":[{"text":"Liquid Glass is applied on navigation elements like tab bar","type":"text"}]}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}]}]}],"content":[],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}]}]},{"action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","title":"Going further with more resources","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"featuredEyebrow":"Tutorial"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(onboarding)","title":"Components showcase","role":"project"},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"]}],"references":{"tutorial-onboarding-3-6.swift":{"syntax":"swift","fileName":"ComponentShowcase.swift","type":"file","highlights":[],"identifier":"tutorial-onboarding-3-6.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"fileType":"swift"},"tutorial-onboarding-3-2.swift":{"syntax":"swift","fileName":"Indicator.swift","type":"file","highlights":[],"identifier":"tutorial-onboarding-3-2.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"fileType":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase":{"kind":"project","title":"Components showcase","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"role":"project","estimatedTime":"1hr 0min"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsswitchitem":{"type":"link","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsc