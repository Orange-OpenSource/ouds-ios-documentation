ials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","role":"project"},"Xcode 27.1":{"title":"Xcode 27.1","identifier":"Xcode 27.1","url":"https:\/\/developer.apple.com\/download\/","type":"xcodeRequirement"},"OUDS-Onboarding-Tutorial.zip":{"checksum":"93d2b475db826d39616208d2f471ec1a6e54d9621b935eec73e251ad5eeab95018a572c7e89e7b071668e5d63817c6fe4abd812901dc8affdfaf112a89ec7032","url":"\/downloads\/OUDSThemesContract\/OUDS-Onboarding-Tutorial.zip","identifier":"OUDS-Onboarding-Tutorial.zip","type":"download"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"title":"password input","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"password input"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding":{"title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view":{"title":"Merge components in a richer view","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","type":"section","kind":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view"},"tutorial-onboarding-3-6.swift":{"syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"type":"file","fileName":"ComponentShowcase.swift","fileType":"swift","highlights":[],"identifier":"tutorial-onboarding-3-6.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"abstract":[{"text":"Discovering a new framework can be exciting and scary.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand.","type":"text"},{"text":" ","type":"text"},{"text":"It has beend esigned for local events and meetups.","type":"text"},{"text":" ","type":"text"},{"text":"Let’s play!","type":"text"}],"url":"\/tutorials\/table-of-contents-(onboarding)","kind":"overview","type":"topic","title":"Swift Package Onboarding Tutorial","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","role":"overview"},"https://i