on elements like tab bar","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}],"isCorrect":true}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}]}],"kind":"assessments"},{"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"kind":"callToAction","title":"Going further with more resources","featuredEyebrow":"Tutorial","action":{"overridingTitle":"Get started","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"}}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"]}],"kind":"project","references":{"https://ios.unified-design-system.orange.com/documentation/oudscomponents":{"titleInlineContent":[{"type":"text","text":"online documentation"}],"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","title":"online documentation"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudslink":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"link","title":"links","titleInlineContent":[{"type":"text","text":"links"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase":{"kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase","type":"topic","title":"Components showcase","estimatedTime":"1hr 0min","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"role":"project"},"tutorial-onboarding-3-8.swift":{"type":"file","identifier":"tutorial-onboarding-3-8.swift","fileType":"swift","fileName":"ContentView.swift","syntax":"swift","highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"title":"password input","titleInlineContent":[{"inlineContent":[{"type":"text","text":"password input"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics":{"kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","type":"section","title":"Define the view basics","abstract":[{"type":"text","text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images."},{"type":"text","text":" "},{"type":"text","text":"How can we do that?"}],"role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Import-of-the-Swift-Package-and-choose-its-libraries":{"type":"topic","title":"Import of the Swift Package and choose its libraries","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-libraries","abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/import-of-the-swift-package-and-choose-its-libraries","role":"article"},"tutorial-onboarding-3-2.png":{"alt":"Colored badges displayed in white blank view","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png","traits":["1x","light"]}],"identifier":"tutorial-onboarding-3-2.png","type":"image"},"OUDS-Onboarding-Tutorial.zip":{"checksum":"2f576d52c5a4d1d3be6c46490a441f13908203cc2337f65c43d8d27f831e8285118cc788cb0d3f72789df1ea6d51e80ea3a04fef41c1698b4a37b2258ab8ddfe","url":"\/downloads\/OUDSThemesContract\/OUDS-Onboarding-Tutorial.zip","identifier":"OUDS-Onboarding-Tutorial.zip","type":"download"},"tutorial-onboarding-3-6.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"highlights":[],"fileType":"swift","syntax":"swift","fileName":"ComponentShowcase.swift","identifier":"tutorial-onboarding-3-6.swift","type":"file"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"type":"section","title":"Discover main components","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Go-further-with-more-ressources":{"kind":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/go-further-with-more-ressources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","title":"Go further with more ressources","type":"topic","abstract":[],"role":"article"},"https://ios.unified-design-system.orange.com/docume