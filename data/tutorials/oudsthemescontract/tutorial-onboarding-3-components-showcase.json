      ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}"],"fileType":"swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"title":"Swift Package Onboarding Tutorial","abstract":[{"text":"Discovering a new framework can be exciting and scary.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand.","type":"text"},{"text":" ","type":"text"},{"text":"It has beend esigned for local events and meetups.","type":"text"},{"text":" ","type":"text"},{"text":"Let’s play!","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","url":"\/tutorials\/table-of-contents-(onboarding)","kind":"overview","role":"overview","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"role":"pseudoSymbol","title":"Discover main components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","type":"section","kind":"section","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},"tutorial-onboarding-3-2.png":{"type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png","traits":["1x","light"]}],"identifier":"tutorial-onboarding-3-2.png","alt":"Colored badges displayed in white blank view"},"doc://OUDSThemesContract/tutorials/Table-Of-C