: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"],"fileType":"swift","type":"file","syntax":"swift"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudscheckboxitem":{"title":"checkbox item","type":"link","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"checkbox item"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics":{"title":"Define the view basics","abstract":[{"type":"text","text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images."},{"type":"text","text":" "},{"type":"text","text":"How can we do that?"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","kind":"section","role":"pseudoSymbol","type":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase":{"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase","kind":"project","title":"Components showcase","role":"project","estimatedTime":"1hr 0min","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"tutorial-onboarding-3-1.png":{"identifier":"tutorial-onboarding-3-1.png","type":"image","alt":"A simple view with some component inside","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Go-further-with-more-ressources":{"role":"article","title":"Go further with more ressources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","type":"topic","kind":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/go-further-with-more-ressources","abstract":[]},"tutorial-onboarding-3-1.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"fileName":"Control.swift","fileType":"swift","highlights":[],"type":"file","syntax":"swift","identifier":"tutorial-onboarding-3-1.swift"},"https://ios.unified-design-system.orange.com/documentation/oudsthemescontract/oudsthemeableview":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","type":"link","title":"OUDSThemeableView","titleInlineContent":[{"type":"codeVoice","code":"OUDSThemeableView"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsradioitem/":{"type":"link","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"radio item"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","title":"radio item","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/"},"tutorial-onboarding-3-7.swift":{"syntax":"swift","highlights":[],"fileName":"ContentView.swift","type":"file","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            HomeScreen()","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"identifier":"tutorial-onboarding-3-7.swift","fileType":"swift"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","type":"image","alt":"OUDS themes logo","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","type":"link","title":"badges","titleInlineContent":[{"text":"badges","type":"text"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},"tutorial-onboarding-3-3.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"fileName":"Navigation.swift","fileType":"swift","highlights":[],"type":"file","syntax":"swift","identifier":"tutorial-onboarding-3-3.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further":{"title":"Navigations and themeable view, a step further","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","kind":"section","role":"pseudoSymbol","type":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies#Check-Your-Understanding":{"title":"Check Your Understanding","type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies#Check-Your-Understanding"},"OUDS-Onboarding-Tutorial.zip":{"identifier":"OUDS-Onboarding-Tutorial.zip","checksum":"d6fe324e8d3daf925e4b59ac1fe1a773584ff5329b6bcf8162ee26f01ebdde0ba86799763bcc02fb44da2c4d8d8a783d7438610a7a5342388e52d91c704a3118","type":"download","url":"\/downloads\/OUDSThemesContract\/OUDS-Onboarding-Tutorial.zip"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"title":"Components showcases","type":"topic","abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","role":"article"},"tutorial-onboarding-3-6.swift":{"identifier":"tutorial-onboarding-3-6.swift","fileName":"ComponentShowcase.swift","highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"type":"file","syntax":"swift","fileType":"swift"},"tutorial-onboarding-3-7.png":{"identifier":"tutorial-onboarding-3-7.png","type":"image","alt":"A view with images and texts","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png"}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","titleInlineContent":[{"text":"online documentation","type":"text"}],"type":"link","title":"online documentation","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},"tutorial-onboarding-3-2.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"fileName":"Indicator.swift","fileType":"swift","highlights":[],"type":"file","syntax":"swift","identifier":"tutorial-onboarding-3-2.swift"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"title":"password input","type":"link","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"password input"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","type":"link","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding"}}}