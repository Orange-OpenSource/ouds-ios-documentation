,"type":"text"},{"inlineContent":[{"type":"text","text":"links"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bars"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"type":"text","text":": a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"back"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"informational"}]},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}],"type":"step","media":null,"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","caption":[{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}],"type":"paragraph"}]}],"anchor":"Discover-main-components"},{"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Merge components in a richer view","stepsSection":[{"caption":[],"type":"step","code":"tutorial-onboarding-3-4.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"type":"text","text":" components, "},{"inlineContent":[{"text":"indicator","type":"text"}],"type":"emphasis"},{"type":"text","text":" components and "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"type":"text","text":" to define must conform to "},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"CustomStringConvertible"}],"type":"emphasis"}]}],"runtimePreview":null,"media":null},{"caption":[],"type":"step","code":"tutorial-onboarding-3-5.swift","content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","isActive":true},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}],"type":"paragraph"}],"runtimePreview":null,"media":null},{"caption":[],"type":"step","code":"tutorial-onboarding-3-6.swift","content":[{"inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"text":" typography and ","type":"text"},{"inlineContent":[{"type":"text","text":"contentDefault"}],"type":"emphasis"},{"text":" foreground color. Just below add the ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledMedium"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}],"type":"paragraph"}],"runtimePreview":null,"media":null}],"anchor":"Merge-components-in-a-richer-view"},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Navigations and themeable view, a step further","stepsSection":[{"caption":[],"type":"step","code":"tutorial-onboarding-3-7.swift","content":[{"inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":", and add inside your previously defined "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-7.png","media":null},{"caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","code":"tutorial-onboarding-3-8.swift","content":[{"inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","media":null}],"anchor":"Navigations-and-themeable-view-a-step-further"}]},{"kind":"assessments","assessments":[{"content":[],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}],"type":"paragraph"}]}],"type":"multiple-choice","title":[{"inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}],"type":"paragraph"}]},{"content":[],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"Yes, of course!"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}]}],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}],"type":"paragraph"}]},{"content":[],"choices":[{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}]}],"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}]},{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}]}],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}]}],"anchor":"Check-Your-Understanding"},{"kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"action":{"overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","isActive":true},"title":"Going further with more resources"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Con