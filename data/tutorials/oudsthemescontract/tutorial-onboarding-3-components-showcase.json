{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-libraries"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources","kind":"task"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources"}],"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"]],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)"},"kind":"project","identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"]}],"sections":[{"image":"ic_theme_intro.png","xcodeRequirement":"Xcode 26.5","chapter":"Components showcases","estimatedTimeInMinutes":60,"title":"Components showcase","backgroundImage":"ic_theme_intro.png","kind":"hero","projectFiles":"OUDS-Onboarding-Tutorial.zip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}]}]},{"kind":"tasks","tasks":[{"title":"Discover main components","stepsSection":[{"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Define a basic ","type":"text"},{"code":"Control","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" with in its ","type":"text"},{"inlineContent":[{"text":"body","type":"text"}],"type":"emphasis"},{"text":" a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}],"type":"emphasis"},{"text":" spacing.","type":"text"},{"text":" ","type":"text"},{"text":"Add inside the components you want, for example ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Do not forget the Xcode preview.","type":"text"}]}],"code":"tutorial-onboarding-3-1.swift","runtimePreview":"tutorial-onboarding-3-1.png","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"OUDS provides also components as "},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"emphasis"},{"type":"text","text":" like "},{"inlineContent":[{"type":"text","text":"badges"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"tags"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define an ","type":"text"},{"code":"Indicator","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":", with a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" applying ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.scaledMedium"}],"type":"emphasis"},{"text":" spacing token for a ","type":"text"},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"text":", and containing an ","type":"text"},{"code":"HStack","type":"codeVoice"},{"text":" with a ","type":"text"},{"inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}],"type":"emphasis"},{"text":" spacing.","type":"text"},{"text":" ","type":"text"},{"text":"Add inside ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},{"text":": do not hesitate to change their ","type":"text"},{"inlineContent":[{"text":"status","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"size","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Make your tests with the Xcode preview.","type":"text"}],"type":"paragraph"}],"code":"tutorial-onboarding-3-2.swift","runtimePreview":"tutorial-onboarding-3-2.png","type":"step","media":null,"caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"text":"links","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bars"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"type":"text","text":": a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"text":"back","type":"text"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"text":"informational","type":"text"}]},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}],"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","type":"step","media":null,"caption":[{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"code":"Image","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" objects.","type":"text"}],"type":"paragraph"}]}],"anchor":"Discover-main-components","contentSection":[{"content":[{"inlineContent":[{"text":"Components are gathered by group or families. You can find all of theme in the ","type":"text"},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For example, in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"text":" family you will find ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"checkboxes"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"radio buttons","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"switch items"}]},{"text":" and some ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"inputs","type":"text"}]},{"type":"text","text":" fields."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Layouts","type":"text"}]},{"type":"text","text":" provides "},{"type":"emphasis","inlineContent":[{"text":"dividers","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"buttons"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bullet lists"}]},{"type":"text","text":" in "},{"type":"emphasis","inlineContent":[{"text":"display","type":"text"}]},{"type":"text","text":" family."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"type":"text","text":" components, "},{"type":"emphasis","inlineContent":[{"text":"indicator","type":"text"}]},{"type":"text","text":" components and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"text":"CaseIterable","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CustomStringConvertible"}]}],"type":"paragraph"}],"type":"step","runtimePreview":null,"caption":[],"code":"tutorial-onboarding-3-4.swift","media":null},{"content":[{"inlineContent":[{"text":"Then define a ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"caption":[],"code":"tutorial-onboarding-3-5.swift","media":null},{"media":null,"caption":[],"code":"tutorial-onboarding-3-6.swift","content":[{"inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}],"type":"paragraph"}],"runtimePreview":null,"type":"step"}],"anchor":"Merge-components-in-a-richer-view","contentSection":[{"content":[{"inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Merge components in a richer view"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Now you master the components and the tokens, you can use ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further","stepsSection":[{"caption":[],"runtimePreview":"tutorial-onboarding-3-7.png","content":[{"type":"paragraph","inlineContent":[{"text":"If you want to apply a theme everywhere in your app, or on specific view, one special ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" is for you: the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":", add in its ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"body"}]},{"text":" the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" with an instance of ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":", and add inside your previously defined ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}]}],"media":null,"type":"step","code":"tutorial-onboarding-3-7.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"text":" or ","type":"text"},{"code":"OrangeCompactTheme","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"step","media":null,"code":"tutorial-onboarding-3-8.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"type":"text","text":" components like a "},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":". The "},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true,"type":"reference"},{"type":"text","text":", with 3 items inside it: the "},{"code":"HomeScreen","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" and two fake views."}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png"}]}]},{"anchor":"Check-Your-Understanding","assessments":[{"type":"multiple-choice","choices":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}]},{"type":"multiple-choice","choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No, not possible"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}]}]}],"content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}]},{"type":"multiple-choice","choices":[{"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}]},{"justification":[{"type":"paragraph","inlineContent":[{"text":"Liquid Glass is applied on navigation elements like tab bar","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}]}],"isCorrect":true}],"content":[],"title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}]}],"kind":"assessments"},{"title":"Going further with more resources","featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"overridingTitle":"Get started","type":"reference","isActive":true}}],"metadata":{"title":"Components showcase","category":"Orange Unified Design System","role":"project","categoryPathComponent":"Table-Of-Contents-(onboarding)"},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"role":"project","title":"Swift Package integration","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","type":"topic","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min"},"tutorial-onboarding-3-6.swift":{"type":"file","fileName":"ComponentShowcase.swift","identifier":"tutorial-onboarding-3-6.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"fileType":"swift","highlights":[],"syntax":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further#More-resources":{"kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further#More-resources","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources","title":"More resources","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"role":"pseudoSymbol"},"tutorial-onboarding-3-2.swift":{"fileName":"Indicator.swift","fileType":"swift","syntax":"swift","highlights":[],"identifier":"tutorial-onboarding-3-2.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"type":"file"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further":{"role":"pseudoSymbol","title":"Navigations and themeable view, a step further","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","type":"section","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}]},"tutorial-onboarding-3-8-LiquidGlass.png":{"type":"image","identifier":"tutorial-onboarding-3-8-LiquidGlass.png","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-8-LiquidGlass.png","traits":["1x","light"]}],"alt":"A view with a tab bar in the bottom"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"role":"article","title":"Define information cards","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","type":"topic","url":"\/tutorials\/table-of-contents-(onboar