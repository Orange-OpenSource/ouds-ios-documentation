-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"}]}],"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"]],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(onboarding)","title":"Components showcase"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"]}],"sections":[{"title":"Components showcase","backgroundImage":"ic_theme_intro.png","image":"ic_theme_intro.png","estimatedTimeInMinutes":60,"content":[{"type":"paragraph","inlineContent":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}]}],"xcodeRequirement":"Xcode 26.5","chapter":"Components showcases","projectFiles":"OUDS-Onboarding-Tutorial.zip","kind":"hero"},{"kind":"tasks","tasks":[{"title":"Discover main components","stepsSection":[{"media":null,"code":"tutorial-onboarding-3-1.swift","runtimePreview":"tutorial-onboarding-3-1.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a basic "},{"type":"codeVoice","code":"Control"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside the components you want, for exemple "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Do not forget the Xcode preview."}]}],"type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-2.swift","runtimePreview":"tutorial-onboarding-3-2.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides also components as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"indicators"}]},{"type":"text","text":" like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"badges"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tags"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define an "},{"type":"codeVoice","code":"Indicator"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", with a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" applying "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.scaledMedium"}]},{"type":"text","text":" spacing token for a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":", and containing an "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","type":"reference","isActive":true},{"type":"text","text":": do not hesitate to change their "},{"type":"emphasis","inlineContent":[{"type":"text","text":"status"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"size"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}]}],"type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"links"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bars"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"code":"Navigation","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" with in its body a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"reference","isActive":true},{"type":"text","text":": a "},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"back"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"informational"}]},{"type":"text","text":" link opening a URL."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" containing "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" objects."}]}]}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are gathered by group or families. You can find all of theme in the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For exemple, in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"type":"text","text":" family you will find "},{"type":"emphasis","inlineContent":[{"type":"text","text":"checkboxes"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radio buttons"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"switch items"}]},{"type":"text","text":" and some "},{"type":"emphasis","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":" fields."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Layouts"}]},{"type":"text","text":" provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dividers"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"buttons"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bullet lists"}]},{"type":"text","text":" in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"display"}]},{"type":"text","text":" family."}]}],"mediaPosition":"trailing"}],"anchor":"Discover-main-components"},{"title":"Merge components in a richer view","stepsSection":[{"media":null,"code":"tutorial-onboarding-3-4.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"inlineContent":[{"type":"text","text":"control"}],"type":"emphasis"},{"type":"text","text":" components, "},{"inlineContent":[{"type":"text","text":"indicator"}],"type":"emphasis"},{"type":"text","text":" components and "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CaseIterable"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CustomStringConvertible"}]}]}],"type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-5.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference","isActive":true},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}],"type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-6.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"code":"ComponentShowcase","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"inlineContent":[{"type":"text","text":"heading large"}],"type":"emphasis"},{"type":"text","text":" typography and "},{"inlineContent":[{"type":"text","text":"contentDefault"}],"type":"emphasis"},{"type":"text","text":" foreground color. Just below add the "},{"code":"CategorySelector","type":"codeVoice"},{"type":"text","text":" and pack them in a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" using a "},{"inlineContent":[{"type":"text","text":"scaledMedium"}],"type":"emphasis"},{"type":"text","text":" spacing for "},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"type":"text","text":". Apply "},{"inlineContent":[{"type":"text","text":"bgSecondary"}],"type":"emphasis"},{"type":"text","text":" background color to this "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"code":"ZStack","type":"codeVoice"},{"type":"text","text":" and use the "},{"inlineContent":[{"type":"text","text":"selected component group"}],"type":"emphasis"},{"type":"text","text":" to apply opacity on the suitable view."}]}],"type":"step","caption":[]}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}]}],"mediaPosition":"trailing"}],"anchor":"Merge-components-in-a-richer-view"},{"title":"Navigations and themeable view, a step further","stepsSection":[{"media":null,"code":"tutorial-onboarding-3-7.swift","runtimePreview":"tutorial-onboarding-3-7.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"code":"View","type":"codeVoice"},{"type":"text","text":" is for you: the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true,"type":"reference"},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"code":"ContentView","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":", add in its "},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"type":"text","text":" the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" with an instance of "},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":", and add inside your previously defined "},{"code":"HomeScreen","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-8.swift","runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components like a "},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":". The "},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true,"type":"reference"},{"type":"text","text":", with 3 items inside it: the "},{"code":"HomeScreen","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" and two fake views."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"code":"SoshTheme","type":"codeVoice"},{"type":"text","text":", "},{"code":"WireframeTheme","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OrangeCompactTheme","type":"codeVoice"},{"type":"text","text":"."}]}]}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}],"mediaPosition":"trailing"}],"anchor":"Navigations-and-themeable-view-a-step-further"}]},{"kind":"assessments","assessments":[{"title":[{"inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}],"type":"paragraph"}],"content":[],"choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"OUDSThemeableView","type":"codeVoice"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}]}]}],"type":"multiple-choice"},{"title":[{"inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}],"type":"paragraph"}],"content":[],"choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}]}]}],"type":"multiple-choice"},{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}],"content":[],"choices":[{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}]},{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}]}],"type":"multiple-choice"}],"anchor":"Check-Your-Understanding"},{"title":"Going further with more resources","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"action":{"overridingTitle":"Get started","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true},"featuredEyebrow":"Tutorial","kind":"callToAction"}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","type":"section","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"title":"Discover main components","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies":{"abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies","role":"project","kind":"project","type":"topic","title":"Swift Package integration","estimatedTime":"10min"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsfilterchip/":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","titleInlineContent":[{"inlineContent":[{"type":"text","text":"filter chip"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"link","title":"filter chip"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","type":"section","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"title":"Navigations and themeable view, a step further","role":"pseudoSymbol"},"tutorial-onboarding-3-6.swift":{"fileName":"ComponentShowcase.swift","identifier":"tutorial-onboarding-3-6.swift","type":"file","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"highlights":[],"fileType":"swift","syntax":"swift"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudslink":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","title":"links","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"link","titleInlineContent":[{"type":"text","text":"links"}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"password input"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"link","title":"password input"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"abstract":[{"text":"Discovering a new framework can be exciting and scary.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand.","type":"text"},{"text":" ","type":"text"},{"text":"It has beend esigned for local events and meetups.","type":"text"},{"text":" ","type":"text"},{"text":"Let’s play!","type":"text"}],"url":"\/tutorials\/table-of-contents-(onboarding)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","role":"overview","kind":"overview","type":"topic","title":"Swift Package Onboarding Tutorial"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}],"type":"image","alt":"OUDS themes logo"},"tutorial-onboarding-3-3.png":{"identifier":"tutorial-onboarding-3-3.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png"}],"type":"image","alt":"Three links with chevrons or underlined text"},"tutorial-onboarding-3-8-LiquidGlass.png":{"identifier":"tutorial-onboarding-3-8-LiquidGlass.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-8-LiquidGlass.png"}],"type":"image","alt":"A view with a tab bar in the bottom"},"tutorial-onboarding-3-1.swift":{"highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"identifier":"tutorial-onboarding-3-1.swift","fileType":"swift","type":"file","fileName":"Control.swift","syntax":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tu