t":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[],"type":"step","media":null,"code":"tutorial-onboarding-3-7.swift","runtimePreview":"tutorial-onboarding-3-7.png"},{"content":[{"inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"text":". The ","type":"text"},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18).","type":"text"},{"text":" ","type":"text"},{"text":"Add a ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true,"type":"reference"},{"text":", with 3 items inside it: the ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" and two fake views.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"code":"SoshTheme","type":"codeVoice"},{"type":"text","text":", "},{"code":"WireframeTheme","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OrangeCompactTheme","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","media":null,"code":"tutorial-onboarding-3-8.swift","runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png"}],"title":"Navigations and themeable view, a step further","contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Now you master the components and the tokens, you can use ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"text":" components and a specific 