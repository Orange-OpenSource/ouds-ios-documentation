Class) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"type":"file"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies":{"role":"project","title":"Swift Package integration","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min","kind":"project"},"tutorial-onboarding-3-2.png":{"identifier":"tutorial-onboarding-3-2.png","alt":"Colored badges displayed in white blank view","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"role":"overview","title":"Swift Package Onboarding Tutorial","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)