:"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"type":"text","text":": a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"back"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"informational"}]},{"type":"text","text":" link opening a URL."}]}]}]},{"title":"Merge components in a richer view","anchor":"Merge-components-in-a-richer-view","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}]}]}],"stepsSection":[{"media":null,"caption":[],"runtimePreview":null,"code":"tutorial-onboarding-3-4.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"type":"text","text":" components, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"indicator"}]},{"type":"text","text":" components and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CaseIterable"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CustomStringConvertible"}]}]}]},{"media":null,"caption":[],"runtimePreview":null,"code":"tutorial-onboarding-3-5.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then define a "},{"code":"CategorySelector","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":": it must display a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference","isActive":true},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}]},{"media":null,"caption":[],"runtimePreview":null,"code":"tutorial-onboarding-3-6.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"text":"heading large","type":"text"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"text":"bgSecondary","type":"text"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" to apply opacity on the suitable view."}]}]}]},{"title":"Navigations and themeable view, a step further","anchor":"Navigations-and-themeable-view-a-step-further","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}]}],"stepsSection":[{"media":null,"caption":[],"runtimePreview":"tutorial-onboarding-3-7.png","code":"tutorial-onboarding-3-7.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview"},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":", and add inside your previously defined "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]}]},{"media":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"You can see how it looks like with other themes like ","type":"text"},{"type":"codeVoice","code":"SoshTheme"},{"text":", ","type":"text"},{"type":"codeVoice","code":"WireframeTheme"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"OrangeCompactTheme"},{"text":".","type":"text"}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","code":"tutorial-onboarding-3-8.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}]}]}]},{"assessments":[{"title":[{"inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}]}]}],"type":"multiple-choice","content":[]},{"content":[],"title":[{"inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}],"type":"paragraph"}],"type":"multiple-choice","choices":[{"content":[{"inlineContent":[{"text":"Yes, of course!","type":"text"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}]}]},{"content":[],"title":[{"inlineContent":[{"text":"Components have all the same rendering whatever is the OS version","type":"text"}],"type":"paragraph"}],"type":"multiple-choice","choices":[{"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}],"type":"paragraph"}],"isCorrect":false},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}]}],"justification":[{"inlineContent":[{"text":"Liquid Glass is applied on navigation elements like tab bar","type":"text"}],"type":"paragraph"}],"isCorrect":true}]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"title":"Going further with more resources","featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true}}],"metadata":{"categoryPathComponent":"Table-Of-Contents-(onboarding)","role":"project","category":"Orange Unified Design System","title":"Components showcase"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"title":"Discover main components","role":"pseudoSymbol","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nic