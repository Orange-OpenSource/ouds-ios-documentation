"}","","#Preview {","    ContentView()","        .orangePreview()","}"],"fileName":"ContentView.swift","highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"type":"file","fileType":"swift","syntax":"swift","identifier":"tutorial-onboarding-3-8.swift"},"tutorial-onboarding-3-4.swift":{"fileType":"swift","identifier":"tutorial-onboarding-3-4.swift","type":"file","syntax":"swift","content":["import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"],"fileName":"ComponentGroup.swift","highlights":[]},"tutorial-onboarding-3-3.swift":{"fileName":"Navigation.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"highlights":[],"type":"file","fileType":"swift","syntax":"swift","identifier":"tutorial-onboarding-3-3.swift"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents