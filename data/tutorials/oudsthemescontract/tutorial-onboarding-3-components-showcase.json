s display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"code":"tutorial-onboarding-3-4.swift","caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"text":" components, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"indicator"}]},{"text":" components and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"text":" components. The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"text":" to define must conform to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"CaseIterable"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"CustomStringConvertible"}]}],"type":"paragraph"}],"type":"step","media":null},{"code":"tutorial-onboarding-3-5.swift","caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"text":"Then define a ","type":"text"},{"code":"CategorySelector","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":": it must display a ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference","isActive":true},{"text":" for all ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"text":" cases and keep a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"text":" as ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"text":". Use the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"text":" token for horizontal spacing between the chips.","type":"text"}],"type":"paragraph"}],"type":"step","media":null},{"code":"tutorial-onboarding-3-6.swift","caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledMedium"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}],"type":"paragraph"}],"type":"step","media":null}],"anchor":"Merge-components-in-a-richer-view"},{"title":"Navigations and themeable view, a step further","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"code":"tutorial-onboarding-3-7.swift","caption":[],"runtimePreview":"tutorial-onboarding-3-7.png","content":[{"inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":", and add inside your previously defined "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","media":null},{"code":"tutorial-onboarding-3-8.swift","caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","content":[{"inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}],"type":"paragraph"}],"type":"step","media":null}],"anchor":"Navigations-and-themeable-view-a-step-further"}],"kind":"tasks"},{"assessments":[{"title":[{"type":"paragraph","inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}]}],"content":[],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}],"type":"paragraph"}]}],"type":"multiple-choice"},{"title":[{"type":"paragraph","inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}]}],"content":[],"choices":[{"