 ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For exemple, in ","type":"text"},{"inlineContent":[{"type":"text","text":"control"}],"type":"emphasis"},{"text":" family you will find ","type":"text"},{"inlineContent":[{"type":"text","text":"checkboxes"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"radio buttons"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"switch items"}],"type":"emphasis"},{"text":" and some ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"emphasis"},{"text":" fields.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Layouts"}],"type":"emphasis"},{"text":" provides ","type":"text"},{"inlineContent":[{"type":"text","text":"dividers"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"buttons"}],"type":"emphasis"},{"text":" are in ","type":"text"},{"inlineContent":[{"type":"text","text":"actions"}],"type":"emphasis"},{"text":" group, ","type":"text"},{"inlineContent":[{"type":"text","text":"bullet lists"}],"type":"emphasis"},{"text":" in ","type":"text"},{"inlineContent":[{"type":"text","text":"display"}],"type":"emphasis"},{"text":" family.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"code":"tutorial-onboarding-3-1.swift","type":"step","content":[{"inlineContent":[{"text":"Define a basic ","type":"text"},{"type":"codeVoice","code":"Control"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" with in its ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":" a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}],"type":"emphasis"},{"text":" spacing.","type":"text"},{"text":" ","type":"text"},{"text":"Add inside the components you want, for exemple ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Do not forget the Xcode preview.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":"tutorial-onboarding-3-1.png","media":null},{"code":"tutorial-onboarding-3-2.swift","type":"step","content":[{"inlineContent":[{"text":"OUDS provides also components as ","type":"text"},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"emphasis"},{"text":" like ","type":"text"},{"inlineContent":[{"type":"text","text":"badges"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"tags"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define an ","type":"text"},{"type":"codeVoice","code":"Indicator"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":", with a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" applying ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.scaledMedium"}],"type":"emphasis"},{"text":" spacing token for a ","type":"text"},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"text":", and containing an ","type":"text"},{"type":"codeVoice","code":"HStack"},{"text":" with a ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}],"type":"emphasis"},{"text":" spacing.","type":"text"},{"text":" ","type":"text"},{"text":"Add inside ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},{"text":": do not hesitate to change their ","type":"text"},{"inlineContent":[{"type":"text","text":"status"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"size"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Make your tests with the Xcode preview.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":"tutorial-onboarding-3-2.png","media":null},{"code":"tutorial-onboarding-3-3.swift","type":"step","content":[{"inlineContent":[{"text":"There are also ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components in OUDS like ","type":"text"},{"inlineContent":[{"type":"text","text":"links"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bars"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"Navigation"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" with in its body a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}],"type":"emphasis"},{"text":" spacing and three ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"text":": a ","type":"text"},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"text":" link, a ","type":"text"},{"inlineContent":[{"type":"text","text":"back"}],"type":"emphasis"},{"text":" link and an ","type":"text"},{"inlineContent":[{"type":"text","text":"informational"}],"type":"emphasis"},{"text":" link opening a URL.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" containing ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" objects.","type":"text"}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-3.png","media":null}]},{"anchor":"Merge-components-in-a-richer-view","title":"Merge components in a richer view","contentSection":[{"content":[{"inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"code":"tutorial-onboarding-3-4.swift","type":"step","content":[{"inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"inlineContent":[{"type":"text","text":"control"}],"type":"emphasis"},{"text":" components, ","type":"text"},{"inlineContent":[{"type":"text","text":"indicator"}],"type":"emphasis"},{"text":" components and ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components. The ","type":"text"},{"inlineContent":[{"type":"text","text":"enum"}],"type":"emphasis"},{"text":" to define must conform to ","type":"text"},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"CustomStringConvertible"}],"type":"emphasis"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"media":null},{"code":"tutorial-onboarding-3-5.swift","type":"step","content":[{"inlineContent":[{"text":"Then define a ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":": it must display a ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/"},{"text":" for all ","type":"text"},{"inlineContent":[{"type":"text","text":"ComponentGroup"}],"type":"emphasis"},{"text":" cases and keep a ","type":"text"},{"inlineContent":[{"type":"text","text":"selected component group"}],"type":"emphasis"},{"text":" as ","type":"text"},{"inlineContent":[{"type":"text","text":"Binding"}],"type":"emphasis"},{"text":". Use the ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}],"type":"emphasis"},{"text":" token for horizontal spacing between the chips.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"media":null},{"code":"tutorial-onboarding-3-6.swift","type":"step","content":[{"inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"type":"codeVoice","code":"ComponentShowcase"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". In the top of it, display a welcoming text with ","type":"text"},{"inlineContent":[{"type":"text","text":"heading large"}],"type":"emphasis"},{"text":" typography and ","type":"text"},{"inlineContent":[{"type":"text","text":"contentDefault"}],"type":"emphasis"},{"text":" foreground color. Just below add the ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"text":" and pack them in a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" using a ","type":"text"},{"inlineContent":[{"type":"text","text":"scaledMedium"}],"type":"emphasis"},{"text":" spacing for ","type":"text"},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"text":". Apply ","type":"text"},{"inlineContent":[{"type":"text","text":"bgSecondary"}],"type":"emphasis"},{"text":" background color to this ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"type":"codeVoice","code":"ZStack"},{"text":" and use the ","type":"text"},{"inlineContent":[{"type":"text","text":"selected component group"}],"type":"emphasis"},{"text":" to apply opacity on the suitable view.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"media":null}]},{"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further","contentSection":[{"content":[{"inlineContent":[{"text":"Now you master the components and the tokens, you can use ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"code":"tutorial-onboarding-3-7.swift","type":"step","content":[{"inlineContent":[{"text":"If you want to apply a theme everywhere in your app, or on specific view, one special ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" is for you: the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":", add in its ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":" the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" with an instance of ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":", and add inside your previously defined ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":"tutorial-onboarding-3-7.png","media":null},{"code":"tutorial-onboarding-3-8.swift","type":"step","content":[{"inlineContent":[{"text":"OUDS provides ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components like a ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"text":". The ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18).","type":"text"},{"text":" ","type":"text"},{"text":"Add a ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},{"text":", with 3 items inside it: the ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" and two fake views.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"You can see how it looks like with other themes like ","type":"text"},{"type":"codeVoice","code":"SoshTheme"},{"text":", ","type":"text"},{"type":"codeVoice","code":"WireframeTheme"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"OrangeCompactTheme"},{"text":".","type":"text"}],"type":"paragraph"}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","media":null}]}],"kind":"tasks"},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}],"choices":[{"justification":[{"inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"isCorrect":true},{"justification":[{"inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Any other view","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice","content":[]},{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}],"choices":[{"justification":[{"inlineContent":[{"text":"Of course you can mix views from SwiftUI and OUDS","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes, of course!","type":"text"}],"type":"paragraph"}],"isCorrect":true},{"justification":[{"inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"No, not possible","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice","content":[]},{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}],"choices":[{"justification":[{"inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}],"type":"paragraph"}],"isCorrect":false},{"justification":[{"inlineContent":[{"text":"Liquid Glass is applied on navigation elements like tab bar","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}],"type":"paragraph"}],"isCorrect":true}],"type":"multiple-choice","content":[]}]},{"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","type":"reference","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"kind":"callToAction","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"title":"Going further with more resources","featuredEyebrow":"Tutorial"}],"kind":"project","references":{"tutorial-onboarding-3-7.swift":{"type":"file","syntax":"swift","highlights":[],"fileName":"ContentView.swift","identifier":"tutorial-onboarding-3-7.swift","fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            HomeScreen()","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents":{"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","title":"online documentation","titleInlineContent":[{"type":"text","text":"online documentation"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},"doc:/