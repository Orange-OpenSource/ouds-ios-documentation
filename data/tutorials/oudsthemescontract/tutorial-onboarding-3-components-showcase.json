","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","media":null,"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png"}]}],"kind":"tasks"},{"kind":"assessments","assessments":[{"choices":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}]}]},{"justification":[{"inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice","content":[],"title":[{"inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}],"type":"paragraph"}]},{"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}],"type":"paragraph"}],"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}]}]},{"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}],"content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}]}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}],"type":"paragraph"}],"isCorrect":true}]}],"anchor":"Check-Your-Understanding"},{"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","type":"reference","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"featuredEyebrow":"Tutorial","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"kind":"callToAction","title":"Going further with more resources"}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboard