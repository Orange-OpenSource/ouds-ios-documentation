,"content":[{"type":"paragraph","inlineContent":[{"text":"Then define a ","type":"text"},{"code":"CategorySelector","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"type":"text","text":": it must display a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference","isActive":true},{"type":"text","text":" for all "},{"inlineContent":[{"type":"text","text":"ComponentGroup"}],"type":"emphasis"},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"text":"Binding","type":"text"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}]},{"type":"step","runtimePreview":null,"caption":[],"code":"tutorial-onboarding-3-6.swift","media":null,"content":[{"inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"type":"codeVoice","code":"ComponentShowcase"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":". In the top of it, display a welcoming text with ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"heading large","type":"text"}]},{"text":" typography and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"text":" foreground color. Just below add the ","type":"text"},{"type":"codeVoice","code":"CategorySelector"},{"text":" and pack them in a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" using a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"text":" spacing for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"text":". Apply ","type":"text"},{"type":"emphasis","in