"caption":[],"code":"tutorial-onboarding-3-2.swift"},{"runtimePreview":"tutorial-onboarding-3-3.png","media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"links"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bars"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}]},{"type":"text","text":" spacing and three "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"reference","isActive":true},{"text":": a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"next","type":"text"}]},{"text":" link, a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"back","type":"text"}]},{"type":"text","text":" link and an "},{"inlineContent":[{"text":"informational","type":"text"}],"type":"emphasis"},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" containing ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" and ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" objects.","type":"text"}]}],"code":"tutorial-onboarding-3-3.swift"}],"anchor":"Discover-main-components"},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Merge components in a richer view","stepsSection":[{"code":"tutorial-onboarding-3-4.swift","type":"step","caption":[],"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"inlineContent":[{"type":"text","text":"control"}],"type":"emphasis"},{"type":"text","text":" components, "},{"inlineContent":[{"type":"text","text":"indicator"}],"type":"emphasis"},{"type":"text","text":" components and "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components. The "},{"inlineContent":[{"type":"text","text":"enum"}],"type":"emphasis"},{"type":"text","text":" to define must conform to "},{"inlineContent":[{"text":"CaseIterable","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"CustomStringConvertible","type":"text"}],"type":"emphasis"}]}],"runtimePreview":null},{"code":"tutorial-onboarding-3-5.swift","type":"step","caption":[],"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}],"runtimePreview":null},{"code":"tutorial-onboarding-3-6.swift","type":"step","caption":[],"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"code":"ZStack","type":"codeVoice"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}]}],"runtimePreview":null}],"anchor":"Merge-components-in-a-richer-view"},{"contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"title":"Navigations and themeable view, a step further","stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"text":" the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" with an instance of ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":", and add inside your previously defined ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}]}],"media":null,"runtimePreview":"tutorial-onboarding-3-7.png","caption":[],"code":"tutorial-onboarding-3-7.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","code":"tutorial-onboarding-3-8.swift","media":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}]}],"type":"step"}],"anchor":"Navigations-and-themeable-view-a-step-further"}]},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}],"type":"paragraph"}],"content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}]}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Any other view","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}]}],"isCorrect":false}]},{"title":[{"type":"paragraph","inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}]}],"content":[],"type":"multiple-choice","choices":[{"content":[{"inlineContent":[{"type":"text","text":"Yes, of course!"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}],"isCorrect":false}]},{"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"text":"Components have all the same rendering whatever is the OS version","type":"text"}]}],"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}]}],"isCorrect":false},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}]}],"isCorrect":true}]}]},{"action":{"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true},"title":"Going further with more resources","featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, 