d provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}],"type":"paragraph"}]}],"stepsSection":[{"type":"step","runtimePreview":null,"code":"tutorial-onboarding-3-4.swift","caption":[],"content":[{"inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"type":"text","text":" components, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"indicator"}]},{"type":"text","text":" components and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enum"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CaseIterable"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"CustomStringConvertible"}]}],"type":"paragraph"}],"media":null},{"type":"step","runtimePreview":null,"code":"tutorial-onboarding-3-5.swift","caption":[],"content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"code":"CategorySelector","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":": it must display a "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}],"type":"paragraph"}],"media":null},{"type":"step","runtimePreview":null,"code":"tutorial-onboarding-3-6.swift","caption":[],"content":[{"inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"code":"ComponentShowcase","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"contentDefault"}]},{"type":"text","text":" foreground color. Just below add the "},{"code":"CategorySelector","type":"codeVoice"},{"type":"text","text":" and pack them in a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" using a "},{"inlineContent":[{"type":"text","text":"scaledMedium"}],"type":"emphasis"},{"text":" spacing for ","type":"text"},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"text":". Apply ","type":"text"},{"inlineContent":[{"text":"bgSecondary","type":"text"}],"type":"emphasis"},{"text":" background color to this ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"code":"ZStack","type":"codeVoice"},{"text":" and use the ","type":"text"},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"text":" to apply opacity on the suitable view.","type":"text"}],"type":"paragraph"}],"media":null}]},{"title":"Navigations and themeable view, a step further","anchor":"Navigations-and-themeable-view-a-step-further","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","conte