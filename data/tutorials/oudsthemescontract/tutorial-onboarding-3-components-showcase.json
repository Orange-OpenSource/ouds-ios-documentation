{"text":" ","type":"text"},{"text":"Let’s play!","type":"text"}],"url":"\/tutorials\/table-of-contents-(onboarding)"},"tutorial-onboarding-3-2.swift":{"fileType":"swift","identifier":"tutorial-onboarding-3-2.swift","type":"file","syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"fileName":"Indicator.swift","highlights":[]},"tutorial-onboarding-3-3.png":{"identifier":"tutorial-onboarding-3-3.png","type":"image","alt":"Three links with chevrons or underlined text","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png"}]},"tutorial-onboarding-3-8-LiquidGlass.png":{"type":"image","identifier":"tutorial-onboarding-3-8-LiquidGlass.png","alt":"A view with a tab bar in the bottom","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-8-LiquidGlass.png","traits":["1x","light"]}]},"tutorial-onboarding-3-2.png":{"identifier":"tutorial-onboarding-3-2.png","alt":"Colored badges displayed in white blank view","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"title":"Components showcases","role":"article","type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","role":"pseudoSymbol","title":"Discover main components","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Import-of-the-Swift-Package-and-choose-its-libraries":{"kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-libraries","role":"article","title":"Import of the Swift Package and choose its libraries","abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents-(onboarding)\/import-of-the-swift-package-and-choose-its-libraries"},"tutorial-onboarding-3-6.swift":{"fileName":"ComponentShowcase.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"highlights":[],"type":"file","fileType":"swift","syntax":"swift","identifier":"tutorial-onboarding-3-6.swift"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","type":"image","alt":"OUDS themes logo","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstabbar/":{"type":"link","title":"tab bar","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudslink":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","title":"links","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"link","titleInlineContent":[{"type":"text","text":"links"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","title":"Check Your Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://OUDSThemesContract/