{"kind":"project","sections":[{"xcodeRequirement":"Xcode 27.1","chapter":"Components showcases","estimatedTimeInMinutes":60,"title":"Components showcase","projectFiles":"OUDS-Onboarding-Tutorial.zip","kind":"hero","content":[{"inlineContent":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"type":"paragraph"}],"backgroundImage":"ic_theme_intro.png","image":"ic_theme_intro.png"},{"tasks":[{"anchor":"Discover-main-components","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Define a basic "},{"type":"codeVoice","code":"Control"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}]},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside the components you want, for example "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Do not forget the Xcode preview."}],"type":"paragraph"}],"media":null,"runtimePreview":"tutorial-onboarding-3-1.png","type":"step","code":"tutorial-onboarding-3-1.swift","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"OUDS provides also components as "},{"type":"emphasis","inlineContent":[{"text":"indicators","type":"text"}]},{"type":"text","text":" like "},{"type":"emphasis","inlineContent":[{"text":"badges","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"tags","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define an "},{"type":"codeVoice","code":"Indicator"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", with a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" applying "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.scaledMedium","type":"text"}]},{"type":"text","text":" spacing token for a "},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"type":"text","text":", and containing an "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" with a "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}]},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","type":"reference","isActive":true},{"type":"text","text":": do not hesitate to change their "},{"type":"emphasis","inlineContent":[{"text":"status","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"size","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}],"type":"paragraph"}],"media":null,"runtimePreview":"tutorial-onboarding-3-2.png","type":"step","code":"tutorial-onboarding-3-2.swift","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"text":"links","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"tab bars","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}]},{"type":"text","text":" spacing and three "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","type":"reference","isActive":true},{"type":"text","text":": a "},{"type":"emphasis","inlineContent":[{"text":"next","type":"text"}]},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"text":"back","type":"text"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"text":"informational","type":"text"}]},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}],"media":null,"runtimePreview":"tutorial-onboarding-3-3.png","type":"step","code":"tutorial-onboarding-3-3.swift","caption":[{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}],"type":"paragraph"}]}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Components are gathered by group or families. You can find all of theme in the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For example, in "},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"type":"text","text":" family you will find "},{"type":"emphasis","inlineContent":[{"text":"checkboxes","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"radio buttons","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"switch items","type":"text"}]},{"type":"text","text":" and some "},{"type":"emphasis","inlineContent":[{"text":"inputs","type":"text"}]},{"type":"text","text":" fields."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Layouts","type":"text"}]},{"type":"text","text":" provides "},{"type":"emphasis","inlineContent":[{"text":"dividers","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"buttons","type":"text"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"text":"actions","type":"text"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"text":"bullet lists","type":"text"}]},{"type":"text","text":" in "},{"type":"emphasis","inlineContent":[{"text":"display","type":"text"}]},{"type":"text","text":" family."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Discover main components"},{"anchor":"Merge-components-in-a-richer-view","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"type":"text","text":" components, "},{"type":"emphasis","inlineContent":[{"text":"indicator","type":"text"}]},{"type":"text","text":" components and "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"text":"enum","type":"text"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"text":"CaseIterable","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"CustomStringConvertible","type":"text"}]}],"type":"paragraph"}],"media":null,"runtimePreview":null,"type":"step","code":"tutorial-onboarding-3-4.swift","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference","isActive":true},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"text":"ComponentGroup","type":"text"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"text":"Binding","type":"text"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}]},{"type":"text","text":" token for horizontal spacing between the chips."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"type":"step","code":"tutorial-onboarding-3-5.swift","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"text":"heading large","type":"text"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"type":"text","text":" spacing for "},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"type":"text","text":". Apply "},{"type":"emphasis","inlineContent":[{"text":"bgSecondary","type":"text"}]},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" to apply opacity on the suitable view."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"type":"step","code":"tutorial-onboarding-3-6.swift","caption":[]}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Merge components in a richer view"},{"anchor":"Navigations-and-themeable-view-a-step-further","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","type":"reference","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"type":"text","text":", and add inside your previously defined "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"runtimePreview":"tutorial-onboarding-3-7.png","type":"step","code":"tutorial-onboarding-3-7.swift","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"reference","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}],"type":"paragraph"}],"media":null,"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","type":"step","code":"tutorial-onboarding-3-8.swift","caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}],"type":"paragraph"}]}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Navigations and themeable view, a step further"}],"kind":"tasks"},{"assessments":[{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}],"type":"paragraph"}],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice"},{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}],"type":"paragraph"}],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Yes, of course!"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice"},{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}],"isCorrect":false},{"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"isCorrect":true}],"type":"multiple-choice"}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitle":"Get started","type":"reference","isActive":true},"featuredEyebrow":"Tutorial","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"kind":"callToAction","title":"Going further with more resources"}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"]],"modules":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-libraries","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries"}]},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","projects":[{"sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view"}]},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view"},{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further"},{"kind":"assessment","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Components showcase","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(onboarding)","role":"project"},"references":{"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"title":"badges","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","titleInlineContent":[{"type":"text","text":"badges"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","type":"link"},"tutorial-onboarding-3-3.swift":{"syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"type":"file","fileName":"Navigation.swift","fileType":"swift","highlights":[],"identifier":"tutorial-onboarding-3-3.swift"},"tutorial-onboarding-3-8.swift":{"syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"type":"file","fileName":"ContentView.swift","fileType":"swift","highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"identifier":"tutorial-onboarding-3-8.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Import-of-the-Swift-Package-and-choose-its-libraries":{"title":"Import of the Swift Package and choose its libraries","url":"\/tutorials\/table-of-contents-(onboarding)\/import-of-the-swift-package-and-choose-its-libraries","type":"topic","kind":"article","role":"article",