,"        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}"],"type":"file"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further":{"role":"pseudoSymbol","title":"Navigations and themeable view, a step further","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"kind":"section"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Import-of-the-Swift-Package-and-choose-its-librairies":{"role":"article","title":"Import of the Swift Package and choose its librairies","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-librairies","url":"\/tutorials\/table-of-contents-(onboarding)\/import-of-the-swift-package-and-choose-its-librairies","abstract":[],"kind":"article"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"role":"article","title":"Define information cards","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view":{"role":"pseudoSymbol","title":"Merge components in a richer view","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","kind":"section"},"tutorial-onboarding-3-8.swift":{"identifier":"tutorial-onboarding-3-8.swift","fileName":"ContentView.swift","highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"fileType":"swift","syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"type":"file"},"tutorial-onboarding-3-6.swift":{"identifier":"tutorial-onboarding-3-6.swift","fileName":"ComponentShowcase.swift","highlights":[],"fileType":"swift","syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"type":"file"},"tutorial-onboarding-3-3.png":{"identifier":"tutorial-onboarding-3-3.png","alt":"Three links with chevrons or underlined text","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png","traits":["1x","light"]}],"type":"image"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","alt":"OUDS themes logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}],"type":"image"},"tutorial-onboarding-3-1.png":{"identifier":"tutorial-onboarding-3-1.png","alt":"A simple view with some component inside","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png","traits":["1x","light"]}],"type":"image"},"Xcode 26.5":{"identifier":"Xcode 26.5","title":"Xcode 26.5","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding"},"tutorial-onboarding-3-1.swift":{"identifier":"tutorial-onboarding-3-1.swift","fileName":"Control.swift","highlights":[],"fileType":"swift","syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"type":"file"},"tutorial-onboarding-3-7.png":{"identifier":"tutorial-onboarding-3-7.png","alt":"A view with images and texts","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further":{"role":"project","title":"Going further with more resources","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"estimatedTime":"10min","kind":"project"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsswitchitem":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","title":"switch item","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"switch item"}]}],"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries":{"role":"pseudoSymbol","title":"Import the Swift Package and the libraries","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"kind":"section"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsfilterchip/":{"identifie