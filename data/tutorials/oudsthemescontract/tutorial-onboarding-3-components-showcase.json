ext","text":", with a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" applying "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.scaledMedium"}]},{"type":"text","text":" spacing token for a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"type":"text","text":", and containing an "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},{"type":"text","text":": do not hesitate to change their "},{"type":"emphasis","inlineContent":[{"text":"status","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"size","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}]}],"type":"step","code":"tutorial-onboarding-3-2.swift","runtimePreview":"tutorial-onboarding-3-2.png"},{"caption":[{"inlineContent":[{"text":"Use a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" containing ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" objects.","type":"text"}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","content":[{"inlineContent":[{"text":"There are also ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components in OUDS like ","type":"text"},{"inlineContent":[{"type":"text","text":"links"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bars"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"code":"Navigation","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" with in its body a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}]},{"text":" spacing and three ","type":"text"},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","isActive":true},{"text":": a ","type":"text"},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"text":" link, a ","type":"text"},{"inlineContent":[{"type":"text","text":"back"}],"type":"emphasis"},{"text":" link and an ","type":"text"},{"inlineContent":[{"type":"text","text":"informational"}],"type":"emphasis"},{"text":" link opening a URL.","type":"text"}],"type":"paragraph"}],"type":"step"}],"title":"Discover main components","anchor":"Discover-main-components","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are gathered by group or families. You can find all of theme in the "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For example, in "},{"inlineContent":[{"type":"text","text":"control"}],"type":"emphasis"},{"type":"text","text":" family you will find "},{"inlineContent":[{"text":"checkboxes","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"radio buttons","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"switch items","type":"text"}],"type":"emphasis"},{"text":" and some ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":" fields."},{"text":" ","type":"text"},{"inlineContent":[{"text":"Layouts","type":"text"}],"type":"emphasis"},{"type":"text","text":" provides "},{"inlineContent":[{"text":"dividers","type":"text"}],"type":"emphasis"},{"type":"text","text":", "},{"inlineContent":[{"text":"buttons","type":"text"}],"type":"emphasis"},{"type":"text","text":" are in "},{"inlineContent":[{"text":"actions","type":"text"}],"type":"emphasis"},{"type":"text","text":" group, "},{"inlineContent":[{"text":"bullet lists","type":"text"}],"type":"emphasis"},{"type":"text","text":" in "},{"inlineContent":[{"text":"display","type":"text"}],"type":"emphasis"},{"type":"text","text":" family."}]}]}]},{"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}]}],"mediaPosition":"trailing"}],"stepsSection":[{"caption":[],"content":[{"inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"text":" components, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"indicator","type":"text"}]},{"text":" components and ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components. The ","type":"text"},{"inlineContent":[{"type":"text","text":"enum"}],"type":"emphasis"},{"text":" to define must conform to ","type":"text"},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"CustomStringConvertible","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"code":"tutorial-onboarding-3-4.swift"},{"content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"text":"Binding","type":"text"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"text":" token for horizontal spacing between the chips.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"media":null,"code":"tutorial-onboarding-3-5.swift","runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"inlineContent":[{"type":"text","text":"heading large"}],"type":"emphasis"},{"type":"text","text":" typography and "},{"inlineContent":[{"text":"contentDefault","type":"text"}],"type":"emphasis"},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"inlineContent":[{"text":"scaledMedium","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing for "},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"type":"text","text":". Apply "},{"inlineContent":[{"text":"bgSecondary","type":"text"}],"type":"emphasis"},{"type":"text","text":" background color to this "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"type":"codeVoice","code":"ZStack"},{"type":"text","text":" and use the "},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"type":"text","text":" to apply opacity on the suitable view."}]}],"type":"step","caption":[],"media":null,"code":"tutorial-onboarding-3-6.swift","runtimePreview":null}],"title":"Merge components in a richer view","anchor":"Merge-components-in-a-richer-view"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Now you master the components and the tokens, you can use ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"If you want to apply a theme everywhere in your app, or on specific view, one special ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" is for you: the ","type":"text"},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","type":"reference"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":", add in its ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":" the ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":" with an instance of ","type":"text"},{"type":"codeVoice","code":"OrangeTheme"},{"text":", and add inside your previously defined ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}]}],"media":null,"runtimePreview":"tutorial-onboarding-3-7.png","caption":[],"code":"tutorial-onboarding-3-7.swift"},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"media":null,"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}]}],"code":"tutorial-onboarding-3-8.swift"}],"title":"Navigations and themeable view, a step further","anchor":"Navigations-and-themeable-view-a-step-further"}],"kind":"tasks"},{"assessments":[{"title":[{"type":"paragraph","inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}]}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}]}],"isCorrect":false}],"type":"multiple-choice","content":[]},{"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, not possible","type":"text"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}]}]}],"type":"multiple-choice","content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}]},{"choices":[{"justification":[{"inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}],"type":"paragraph"}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}],"isCorrect":true}],"type":"multiple-choice","content":[],"title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"featuredEyebrow":"Tutorial","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"action":{"isActive":true,"type":"reference","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"},"title":"Going further with more resources","kind":"callToAction"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase"]}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Check-Your-Understanding":{"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","abstract":[{"text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and image