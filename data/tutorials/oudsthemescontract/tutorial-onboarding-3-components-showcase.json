   @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}"]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudscheckboxitem":{"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","title":"checkbox item","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"checkbox item"}]}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","title":"text input","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"text input"}]}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Go-further-with-more-ressources":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","url":"\/tutorials\/table-of-contents-(onboarding)\/go-further-with-more-ressources","abstract":[],"title":"Go further with more ressources"},"tutorial-onboarding-3-6.swift":{"identifier":"tutorial-onboarding-3-6.swift","syntax":"swift","highlights":[],"type":"file","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"fileType":"swift","fileName":"ComponentShowcase.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","abstract":[],"title":"Define information cards"},"tutorial-onboarding-3-7.png":{"type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png","traits":["1x","light"]}],"alt":"A view with images and texts","identifier":"tutorial-onboarding-3-7.png"},"Xcode 26.5":{"type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/","title":"Xcode 26.5","identifier":"Xcode 26.5"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view