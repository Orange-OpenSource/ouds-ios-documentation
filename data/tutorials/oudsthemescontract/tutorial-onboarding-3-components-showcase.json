ng","type":"text"}],"title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"title":"Swift Package Onboarding Tutorial","abstract":[{"type":"text","text":"Discovering a new framework can be exciting and scary."},{"type":"text","text":" "},{"type":"text","text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand."},{"type":"text","text":" "},{"type":"text","text":"It has beend esigned for local events and meetups."},{"type":"text","text":" "},{"type":"text","text":"Let’s play!"}],"url":"\/tutorials\/table-of-contents-(onboarding)","type":"topic","role":"overview","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","kind":"overview"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstabbar/":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"link","title":"tab bar","titleInlineContent":[{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","kind":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","title":"Define information cards","abstract":[],"role":"article","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","type":"link"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsswitchitem":{"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"switch item"}]}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","title":"switch item","type":"link"},"tutorial-onboarding-3-6.swift":{"identifier":"tutorial-onboarding-3-6.swift","fileName":"ComponentShowcase.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"type":"file","syntax":"swift","fileType":"swift","highlights":[]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further":{"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further","role":"project","type":"topic","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"estimatedTime":"10min","title":"Going further with more resources"},"tutorial-onboarding-3-7.swift":{"identifier":"tutorial-onboarding-3-7.swift","type":"file","fileType":"swift","fileName":"ContentView.swift","highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            HomeScreen()","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"syntax":"swift"},"tutorial-onboarding-3-2.swift":{"identifier":"tutorial-onboarding-3-2.swift","type":"file","fileType":"swift","fileName":"Indicator.swift","highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"syntax":"swift"},"tutorial-onboarding-3-1.png":{"alt":"A simple view with some component inside","identifier":"tutorial-onboarding-3-1.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png"}],"type":"image"},"tutorial-onboarding-3-3.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"type":"file","identifier":"tutorial-onboarding-3-3.swift","fileType":"swift","fileName":"Navigation.swift","highlights":[],"syntax":"swift"},"tutorial-onboarding-3-1.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"type":"file","identifier":"tutorial-onboarding-3-1.swift","fileType":"swift","fileName":"Control.swift","highlights":[],"syntax":"swift"},"OUDS-Onboarding-Tutorial.zip":{"url":"\/downloads\/OUDSThemesContract\/OUDS-Onboarding-Tutorial.zip","identifier":"OUDS-Onboarding-Tutorial.zip","type":"download","checksum":"d6fe324e8d3daf925e4b59ac1fe1a773584ff5329b6bcf8162ee26f01ebdde0ba86799763bcc02fb44da2c4d8d8a783d7438610a7a5342388e52d91c704a3118"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further#More-resources":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further#More-resources","title":"More resources","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"role":"pseudoSymbol","type":"section"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudscheckboxitem":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","titleInlineContent":[{"inlineContent":[{"type":"text","text":"checkbox item"}],"type":"emphasis"}],"title":"checkbox item"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-mai