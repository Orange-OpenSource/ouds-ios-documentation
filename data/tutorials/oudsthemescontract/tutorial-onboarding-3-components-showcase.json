   VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"fileName":"Indicator.swift","syntax":"swift","identifier":"tutorial-onboarding-3-2.swift","fileType":"swift","highlights":[],"type":"file"},"tutorial-onboarding-3-1.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"fileType":"swift","syntax":"swift","identifier":"tutorial-onboarding-3-1.swift","fileName":"Control.swift","highlights":[],"type":"file"},"https://ios.unified-design-system.orange.com/documentation/oudsthemescontract/oudsthemeableview":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","titleInlineContent":[{"type":"codeVoice","code":"OUDSThemeableView"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","