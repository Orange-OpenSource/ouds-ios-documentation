pe":"text"},{"inlineContent":[{"type":"text","text":"tags"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Define an ","type":"text"},{"code":"Indicator","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"type":"text","text":", with a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" applying "},{"inlineContent":[{"type":"text","text":"theme.spaces.scaledMedium"}],"type":"emphasis"},{"text":" spacing token for a ","type":"text"},{"inlineContent":[{"type":"text","text":"vertical size class"}],"type":"emphasis"},{"text":", and containing an ","type":"text"},{"code":"HStack","type":"codeVoice"},{"text":" with a ","type":"text"},{"inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"type":"text","text":"Add inside "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","type":"reference"},{"type":"text","text":": do not hesitate to change their "},{"inlineContent":[{"type":"text","text":"status"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"size"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Make your tests with the Xcode preview.","type":"text"}],"type":"paragraph"}],"caption":[]},{"caption":[{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" containing ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Text"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" objects.","type":"text"}]}],"media":null,"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","type":"step","content":[{"inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"text":"links","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bars"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"code":"Navigation","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" with in its body a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" with "},{"inlineContent":[{"text":"theme.spaces.fixedNone","type":"text"}],"type":"emphasis"},{"type":"text","text":" spacing and three "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","isActive":true,"type":"reference"},{"type":"text","text":": a "},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"type":"text","text":" link, a "},{"inlineContent":[{"type":"text","text":"back"}],"type":"emphasis"},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"text":"informational","type":"text"}]},{"type":"text","text":" link opening a URL."}],"type":"paragraph"}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Components are gathered by group or families. You can find all of theme in the ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For example, in ","type":"text"},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"text":" family you will find ","type":"text"},{"inlineContent":[{"type":"text","text":"checkboxes"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"radio buttons"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"switch items","type":"text"}],"type":"emphasis"},{"text":" and some ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"emphasis"},{"text":" fields.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Layouts","type":"text"}],"type":"emphasis"},{"type":"text","text":" provides "},{"type":"emphasis","inlineContent":[{"text":"dividers","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"buttons","type":"text"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"text":"bullet lists","type":"text"}]},{"type":"text","text":" in "},{"type":"emphasis","inlineContent":[{"text":"display","type":"text"}]},{"type":"text","text":" family."}],"type":"paragraph"}]}]},{"stepsSection":[{"runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"control","type":"text"}]},{"text":" components, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"indicator","type":"text"}]},{"text":" components and ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components. The ","type":"text"},{"inlineContent":[{"text":"enum","type":"text"}],"type":"emphasis"},{"text":" to define must conform to ","type":"text"},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"CustomStringConvertible","type":"text"}],"type":"emphasis"}]}],"type":"step","caption":[],"code":"tutorial-onboarding-3-4.swift"},{"type":"step","caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Then define a "},{"code":"CategorySelector","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":": it must display a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","isActive":true,"type":"reference"},{"type":"text","text":" for all "},{"inlineContent":[{"text":"ComponentGroup","type":"text"}],"type":"emphasis"},{"type":"text","text":" cases and keep a "},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"text":" as ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Binding","type":"text"}]},{"text":". Use the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}]},{"text":" token for horizontal spacing between the chips.","type":"text"}],"type":"paragraph"}],"code":"tutorial-onboarding-3-5.swift","media":null},{"caption":[],"code":"tutorial-onboarding-3-6.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, define the main view, the "},{"type":"codeVoice","code":"ComponentShowcase"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"inlineContent":[{"type":"text","text":"heading large"}],"type":"emphasis"},{"text":" typography and ","type":"text"},{"inlineContent":[{"type":"text","text":"contentDefault"}],"type":"emphasis"},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"text":" and pack them in a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"text":" spacing for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"text":". Apply ","type":"text"},{"inlineContent":[{"text":"bgSecondary","type":"text"}],"type":"emphasis"},{"text":" background color to this ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"code":"ZStack","type":"codeVoice"},{"text":" and use the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"selected component group","type":"text"}]},{"type":"text","text":" to apply opacity on the suitable view."}]}],"media":null,"runtimePreview":null,"type":"step"}],"title":"Merge components in a richer view","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}]}]}],"anchor":"Merge-components-in-a-richer-view"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"text":" components and a specific view to inject your theme everywhere. Time to complete your first app!","type":"text"}]}]}],"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further","stepsSection":[{"media":null,"caption":[],"code":"tutorial-onboarding-3-7.swift","runtimePreview":"tutorial-onboarding-3-7.png","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"text":"body","type":"text"}]},{"type":"text","text":" the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" with an instance of "},{"type":"codeVoice","code":"OrangeTheme"},{"text":", and add inside your previously defined ","type":"text"},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components like a ","type":"text"},{"inlineContent":[{"type":"text","text":"tab bar"}],"type":"emphasis"},{"text":". The ","type":"text"},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18).","type":"text"},{"text":" ","type":"text"},{"text":"Add a ","type":"text"},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"reference"},{"text":", with 3 items inside it: the ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" and two fake views.","type":"text"}]}],"code":"tutorial-onboarding-3-8.swift","type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"text":", ","type":"text"},{"code":"WireframeTheme","type":"codeVoice"},{"type":"text","text":" or "},{"code":"OrangeCompactTheme","type":"codeVoice"},{"type":"text","text":"."}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","media":null}]}],"kind":"tasks"},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"content":[],"title":[{"inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}],"type":"paragraph"}],"choices":[{"justification":[{"inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"isCorrect":true},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}]}],"type":"multiple-choice"},{"type":"multiple-choice","choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, of course!","type":"text"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No, not possible"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}],"type":"paragraph"}]}],"title":[{"type":"paragraph","inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}]}],"content":[]},{"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}],"content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}]},{"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}]}]}]},{"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Going further with more resources","action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","isActive":true,"type":"reference"},"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}]}],"references":{"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsswitchitem":{"title":"switch item","titleInlineContent":[{"inlineContent":[{"text":"switch item","type":"text"}],"type":"emphasis"}],"type":"link","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"type":"link","title":"text input","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","titleInlineContent":[{"inlineContent":[{"type":"text","text":"text input"}],"type":"emphasis"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"title":"Discover main components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Go-further-with-more-ressources":{"role":"article","type":"topic","abstract":[],"title":"Go further with more ressources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","kind":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/go-further-with-more-ressources"},"tutorial-onboarding-3-1.png":{"alt":"A simple view with some component inside","type":"image","identifier":"tutorial-onboarding-3-1.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png"}]},"tutorial-onboarding-3-3.swift":{"identifier":"tutorial-onboarding-3-3.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"type":"file","fileType":"swift","highlights":[],"fileName":"Navigation.swift","syntax":"swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"kind":"article","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","title":"Components showcases","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","abstract":[],"type":"topic"},"tutorial-onboarding-3-5.swift":{"syntax":"swift","type":"file","fileType":"swift","fileName":"CategorySelector.swift","highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}"],"identifier":"tutorial-onboarding-3-5.swift"},"tutorial-onboarding-3-2.swift":{"identifier":"tutorial-onboarding-3-2.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"type":"file","fileType":"swift","highlights":[],"fileName":"Indicator.swift","syntax":"swift"},"tutorial-onboarding-3-2.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png","traits":["1x","light"]}],"type":"image","identifier":"tutorial-onboarding-3-2.png","alt":"Colored badges displayed in white blank view"},"tutorial-onboarding-3-3.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png"}],"alt":"Three links with chevrons or underlined text","type":"image","identifier":"tutorial-onboarding-3-3.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"estimatedTime":"10min","url":"\/tutorials\/oudsthemescontrac