nd themeable view, a step further","stepsSection":[{"code":"tutorial-onboarding-3-7.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":", add in its ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":" the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" with an instance of ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":", and add inside your previously defined ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}]}],"runtimePreview":"tutorial-onboarding-3-7.png","caption":[],"type":"step"},{"code":"tutorial-onboarding-3-8.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"reference","isActive":true},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","caption":[{"type":"paragraph","inlineContent":[{"text":"You can see how it looks like with other themes like ","type":"text"},{"code":"SoshTheme","type":"codeVoice"},{"text":", ","type":"text"},{"code":"WireframeTheme","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"OrangeCompactTheme","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"step"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}]}],"anchor":"Navigations-and-themeable-view-a-step-further"}],"kind":"tasks"},{"assessments":[{"choices":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"text":"Yes! One view to rule them all!","type":"text"}],"type":"paragraph"}]},{"justification":[{"inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Any other view"}],"type":"paragraph"}],"isCorrect":false}],"title":[{"type":"paragraph","inlineContent":[{"text":"Which thing defines the theme to use everywhere?","type":"text"}]}],"type":"multiple-choice","content":[]},{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you mix SwiftUI and OUDS components?"}]}],"content":[],"choices":[{"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes, of course!","type":"text"}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"No, not possible","type":"text"}],"type":"paragraph"}]}],"type":"multiple-choice"},{"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}]}],"content":[],"choices":[{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}],"type":"paragraph"}]},{"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}],"type":"paragraph"}]}],"type":"multiple-choice"}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"kind":"callToAction","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"title":"Going further with more resources","action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Ge