tract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view","role":"project","title":"Define information cards","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further":{"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"type":"topic","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","role":"project","title":"Going further with more resources","kind":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)":{"title":"Swift Package Onboarding Tutorial","type":"topic","url":"\/tutorials\/table-of-contents-(onboarding)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)","role":"overview","kind":"overview","abstract":[{"text":"Discovering a new framework can be exciting and scary.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial, you will learn how to embed OUDS Swift Package and define views tailored for your brand.","type":"text"},{"text":" ","type":"text"},{"text":"It has beend esigned for local events and meetups.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Let’s play!"}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents":{"titleInlineContent":[{"type":"text","text":"online documentation"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","title":"online documentation","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"type":"section","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","role":"pseudoSymbol","title":"Discover main components","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries":{"title":"Import the Swift Package and the libraries","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs."},{"type":"text","text":" "},{"type":"text","text":"These librairies help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"role":"pseudoSymbol","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries"},"tutorial-onboarding-3-8.swift":{"type":"file","fileName":"ContentView.swift","fileType":"swift","syntax":"swift","identifier":"tutorial-onboarding-3-8.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsswitchitem":{"type":"link","title":"switch item","titleInlineContent":[{"inlineContent":[{"text":"switch item","type":"text"}],"type":"emphasis"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},"tutorial-onboarding-3-2.swift":{"highlights":[],"fileName":"Indicator.swift","type":"file","syntax":"swift","fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"identifier":"tutorial-onboarding-3-2.swift"},"ic_theme_intro.png":{"alt":"OUDS themes logo","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}],"identifier":"ic_theme_intro.png","type":"image"},"Xcode 26.5":{"url":"https:\/\/developer.apple.com\/download\/","title":"Xcode 26.5","identifier":"Xcode 26.5","type":"xcodeRequirement"},"tutorial-onboarding-3-2.png":{"type":"image","alt":"Colored badges displayed in white blank view","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png"}],"identifier":"tutorial-onboarding-3-2.png"},"tutorial-onboarding-3-6.swift":{"type":"file","fileName":"ComponentShowcase.swift","fileType":"swift","identifier":"tutorial-onboarding-3-6.swift","syntax":"swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"highlights":[]},"tutorial-onboarding-3-4.swift":{"highlights":[],"fileName":"ComponentGroup.swift","content":["import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"],"fileType":"swift","syntax":"swift","type":"file","identifier":"tutorial-onboarding-3-4.swift"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","role":"article","title":"Define information cards","kind":"article"},"tutorial-onboarding-3-8-LiquidGlass.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-8-LiquidGlass.png"}],"identifier":"tutorial-onboarding-3-8-LiquidGlass.png","alt":"A view with a tab bar in the bottom","type":"image"},"tutorial-onboarding-3-3.png":{"alt":"Three links with chevrons or underlined text","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png","traits":["1x","light"]}],"identifier":"tutorial-onboarding-3-3.png","type":"image"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"type":"link","titleInlineContent":[{"text":"badges","type":"text"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","title":"badges","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-librairies":{"estimatedTime":"10min","title":"Swift Package integration","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-librairies","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and 