ified-design-system.orange.com\/documentation\/oudscomponents","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For example, in ","type":"text"},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"text":" family you will find ","type":"text"},{"inlineContent":[{"type":"text","text":"checkboxes"}],"type":"emphasis"},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"radio buttons"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"switch items"}]},{"type":"text","text":" and some "},{"type":"emphasis","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":" fields."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Layouts","type":"text"}]},{"type":"text","text":" provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dividers"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"buttons","type":"text"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bullet lists"}]},{"type":"text","text":" in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"display"}]},{"type":"text","text":" family."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Discover main components","anchor":"Discover-main-components"},{"anchor":"Merge-components-in-a-richer-view","title":"Merge components in a richer view","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"type":"text","text":" components, "},{"type":"emphasis","inlineContent":[{"text":"indicator","type":"text"}]},{"type":"text","text":" components and "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components. The "},{"type":"emphasis","inlineContent":[{"text":"enum","type":"text"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"text":"CaseIterable","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"CustomStringConvertible","type":"text"}]}]}],"runtimePreview":null,"media":null,"code":"tutorial-onboarding-3-4.swift","caption":[],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Then define a ","type":"text"},{"code":"CategorySelector","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":": it must display a ","type":"text"},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"text":"ComponentGroup","type":"text"}]},{"text":" cases and keep a ","type":"text"},{"inlineContent":[{"text":"selected component group","type":"text"}],"type":"emphasis"},{"text":" as ","type":"text"},{"inlineContent":[{"type":"text","text":"Binding"}],"type":"emphasis"},{"text":". Use the ","type":"text"},{"inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}],"type":"emphasis"},{"text":" token for horizontal spacing between the chips.","type":"text"}]}],"runtimePreview":null,"media":null,"code":"tutorial-onboarding-3-5.swift","caption":[],"type":"step"},{"code":"tutorial-onboarding-3-6.swift","caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"code":"ComponentShowcase","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":". In the top of it, display a welcoming text with ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"heading large","type":"text"}]},{"text":" typography and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"text":" foreground color. Just below add the ","type":"text"},{"code":"CategorySelector","type":"codeVoice"},{"text":" and pack them in a ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" using a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"scaledMedium","type":"text"}]},{"text":" spacing for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"vertical size class"}]},{"text":". Apply ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"bgSecondary"}]},{"type":"text","text":" background color to this "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Then add the views for components inside a "},{"code":"ZStack","type":"codeVoice"},{"type":"text","text":" and use the "},{"inlineContent":[{"type":"text","text":"selected component group"}],"type":"emphasis"},{"type":"text","text":" to apply opacity on the suitable view."}]}],"type":"step","media":null,"runtimePreview":null}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing.","type":"text"},{"text":" ","type":"text"},{"text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier.","type":"text"}]}],"mediaPosition":"trailing"}]},{"stepsSection":[{"type":"step","caption":[],"media":null,"runtimePreview":"tutorial-onboarding-3-7.png","code":"tutorial-onboarding-3-7.swift","content":[{"inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true},{"type":"text","text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":", add in its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body"}]},{"text":" the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" with an instance of ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":", and add inside your previously defined "},{"code":"HomeScreen","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"step","media":null,"code":"tutorial-onboarding-3-8.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"tab bar","type":"text"}]},{"type":"text","text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18)."},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" and two fake views."}]}],"runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"type":"text","text":", "},{"type":"codeVoice","code":"WireframeTheme"},{"type":"text","text":" or "},{"type":"codeVoice","code":"OrangeCompactTheme"},{"type":"text","text":"."}]}]}],"title":"Navigations and themeable view, a step further","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}]}]}],"anchor":"Navigations-and-themeable-view-a-step-further"}],"kind":"tasks"},{"assessments":[{"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"OUDSThemeableView"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme"}]}]}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}],"type":"multiple-choice","content":[]},{"type":"multiple-choice","content":[],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, of course!"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"text":"Of course you can mix views from SwiftUI and OUDS","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"No, not possible","type":"text"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️"}],"type":"paragraph"}]}],"title":[{"inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}],"type":"paragraph"}]},{"type":"multiple-choice","content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, because OUDS is cohesive","type":"text"}]}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"text":"No, Liquid Glass can be applied","type":"text"}]}],"isCorrect":true}],"title":[{"inlineContent":[{"type":"text","text":"Components have all the same rendering whatever is the OS version"}],"type":"paragraph"}]}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"title":"Going further with more resources","kind":"callToAction","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further"},"featuredEyebrow":"Tutorial"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"metadata":{"role":"project","title":"Components showcase","category":"Orange Unified Design System","categoryPathComponent":"Ta