 can we do that?","type":"text"}],"estimatedTime":"45min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"kind":"project","title":"Swift Package integration","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"kind":"article","title":"Components showcases","type":"topic","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases","abstract":[]},"tutorial-onboarding-3-8-LiquidGlass.png":{"alt":"A view with a tab bar in the bottom","type":"image","identifier":"tutorial-onboarding-3-8-LiquidGlass.png","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-8-LiquidGlass.png","traits":["1x","light"]}]},"tutorial-onboarding-3-7.png":{"alt":"A view with images and texts","type":"image","identifier":"tutorial-onboarding-3-7.png","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png","traits":["1x","light"]}]},"tutorial-onboarding-3-8.swift":{"highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":1