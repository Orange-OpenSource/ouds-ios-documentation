None"}],"type":"emphasis"},{"type":"text","text":" spacing."},{"type":"text","text":" "},{"text":"Add inside the components you want, for exemple ","type":"text"},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","isActive":true},{"text":", ","type":"text"},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsswitchitem"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Do not forget the Xcode preview.","type":"text"}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-3-1.swift","runtimePreview":"tutorial-onboarding-3-1.png","type":"step","caption":[]},{"media":null,"code":"tutorial-onboarding-3-2.swift","runtimePreview":"tutorial-onboarding-3-2.png","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS provides also components as "},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"emphasis"},{"type":"text","text":" like "},{"inlineContent":[{"text":"badges","type":"text"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"tags","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Define an ","type":"text"},{"type":"codeVoice","code":"Indicator"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":", with a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" applying "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.scaledMedium","type":"text"}]},{"type":"text","text":" spacing token for a "},{"type":"emphasis","inlineContent":[{"text":"vertical size class","type":"text"}]},{"type":"text","text":", and containing an "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" with a "},{"type":"emphasis","inlineContent":[{"text":"theme.spaces.fixedSmall","type":"text"}]},{"text":" spacing.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Add inside "},{"type":"reference","isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},{"type":"text","text":": do not hesitate to change their "},{"type":"emphasis","inlineContent":[{"type":"text","text":"status"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"size"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}]}],"caption":[]},{"code":"tutorial-onboarding-3-3.swift","runtimePreview":"tutorial-onboarding-3-3.png","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are also "},{"type":"emphasis","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":" components in OUDS like "},{"type":"emphasis","inlineContent":[{"type":"text","text":"links"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bars"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","isActive":true},{"type":"text","text":": a "},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"text":" link, a ","type":"text"},{"inlineContent":[{"type":"text","text":"back"}],"type":"emphasis"},{"text":" link and an ","type":"text"},{"inlineContent":[{"type":"text","text":"informational"}],"type":"emphasis"},{"text":" link opening a URL.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" containing ","type":"text"},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}]}],"media":null}]},{"title":"Merge components in a richer view","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some components can be used to define richer views. Let’s try to merge all the ones we have and provide a more interesting thing."},{"type":"text","text":" "},{"type":"text","text":"The aim here is display a big title, a pack of filter chips, and according to the selected chip one of the view we defined earlier."}]}],"mediaPosition":"trailing"}],"anchor":"Merge-components-in-a-richer-view","stepsSection":[{"code":"tutorial-onboarding-3-4.swift","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First, define the components groups we need as an enumeration. We will provide views for ","type":"text"},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"text":" components, ","type":"text"},{"inlineContent":[{"text":"indicator","type":"text"}],"type":"emphasis"},{"text":" components and ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components. The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"enum","type":"text"}]},{"type":"text","text":" to define must conform to "},{"type":"emphasis","inlineContent":[{"text":"CaseIterable","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"CustomStringConvertible","type":"text"}]}]}],"caption":[],"type":"step"},{"code":"tutorial-onboarding-3-5.swift","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"text":" for all ","type":"text"},{"inlineContent":[{"type":"text","text":"ComponentGroup"}],"type":"emphasis"},{"text":" cases and keep a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"text":"Binding","type":"text"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}],"caption":[],"type":"step"},{"caption":[],"code":"tutorial-onboarding-3-6.swift","type":"step","content":[{"inlineContent":[{"text":"In the end, define the main view, the ","type":"text"},{"code":"ComponentShowcase","type":"codeVoice"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":". In the top of it, display a welcoming text with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"heading large"}]},{"type":"text","text":" typography and "},{"type":"emphasis","inlineContent":[{"text":"contentDefault","type":"text"}]},{"type":"text","text":" foreground color. Just below add the "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" and pack them in a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" using a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"scaledMedium"}]},{"text":" spacing for ","type":"text"},{"inlineContent":[{"text":"vertical size class","type":"text"}],"type":"emphasis"},{"text":". Apply ","type":"text"},{"inlineContent":[{"type":"text","text":"bgSecondary"}],"type":"emphasis"},{"text":" background color to this ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Then add the views for components inside a ","type":"text"},{"type":"codeVoice","code":"ZStack"},{"text":" and use the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" to apply opacity on the suitable view."}],"type":"paragraph"}],"media":null,"runtimePreview":null}]},{"stepsSection":[{"code":"tutorial-onboarding-3-7.swift","runtimePreview":"tutorial-onboarding-3-7.png","type":"step","caption":[],"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to apply a theme everywhere in your app, or on specific view, one special "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is for you: the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudsthemescontract\/oudsthemeableview","isActive":true,"type":"reference"},{"text":". This object will get a theme you instanciated and apply it as environment value. It will also instanciates some environment objects the components may need.","type":"text"},{"text":" ","type":"text"},{"text":"Define a ","type":"text"},{"code":"ContentView","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":", add in its ","type":"text"},{"inlineContent":[{"text":"body","type":"text"}],"type":"emphasis"},{"text":" the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" with an instance of ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":", and add inside your previously defined ","type":"text"},{"code":"HomeScreen","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}]}]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS provides ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"text":" components like a ","type":"text"},{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"},{"text":". The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]},{"text":" is quite particular: its rendering will change depending if Liquid Glass is applied (i.e. iOS 26+) or not (i.e. until iOS 18).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Add a "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","isActive":true,"type":"reference"},{"type":"text","text":", with 3 items inside it: the "},{"type":"codeVoice","code":"HomeScreen"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" and two fake views."}]}],"caption":[{"inlineContent":[{"type":"text","text":"You can see how it looks like with other themes like "},{"type":"codeVoice","code":"SoshTheme"},{"text":", ","type":"text"},{"type":"codeVoice","code":"WireframeTheme"},{"text":" or ","type":"text"},{"code":"OrangeCompactTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"step","code":"tutorial-onboarding-3-8.swift","runtimePreview":"tutorial-onboarding-3-8-LiquidGlass.png"}],"anchor":"Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Now you master the components and the tokens, you can use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation"}]},{"type":"text","text":" components and a specific view to inject your theme everywhere. Time to complete your first app!"}],"type":"paragraph"}]}]}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"content":[],"choices":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Yes! One view to rule them all!"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other view"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Nope! You must ust the dedicated OUDS view to inject in subviews the theme","type":"text"}]}],"isCorrect":false}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which thing defines the theme to use everywhere?"}]}],"type":"multiple-choice"},{"title":[{"type":"paragraph","inlineContent":[{"text":"Can you mix SwiftUI and OUDS components?","type":"text"}]}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes, of course!","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course you can mix views from SwiftUI and OUDS"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, not possible","type":"text"}]}],"justification":[{"inlineContent":[{"text":"Feel free to mix components! If you have some bugs, submit us issues on GitHub ❤️","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice","content":[]},{"title":[{"type":"paragraph","inlineContent":[{"text":"Components have all the same rendering whatever is the OS version","type":"text"}]}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, because OUDS is cohesive"}]}],"justification":[{"inlineContent":[{"text":"OUDS iOS Swift Package provide some components with rendering depending to the OS (e.g. tab bars)","type":"text"}],"type":"paragraph"}],"isCorrect":false},{"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Liquid Glass is applied on navigation elements like tab bar"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No, Liquid Glass can be applied"}]}],"isCorrect":true}],"type":"multiple-choice","content":[]}]},{"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","overridingTitle":"Get started","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference"},"kind":"callToAction","featuredEyebrow":"Tutorial","title":"Going further with more resources","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}]}],"references":{"tutorial-onboarding-3-6.swift":{"identifier":"tutorial-onboarding-3-6.swift","syntax":"swift","fileName":"ComponentShowcase.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"type":"file","highlights":[],"fileType":"swift"},"tutorial-onboarding-3-3.png":{"type":"image","alt":"Three links with chevrons or underlined text","identifier":"tutorial-onboarding-3-3.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Define-information-cards":{"kind":"article","role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Define-information-cards","abstract":[],"url":"\/tutorials\/table-of-contents-(onboarding)\/define-information-cards","title":"Define information cards","type":"topic"},"tutorial-onboarding-3-3.swift":{"highlights":[],"fileType":"swift","identifier":"tutorial-onboarding-3-3.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"fileName":"Navigation.swift","type":"file","syntax":"swift"},"tutorial-onboarding-3-1.png":{"identifier":"tutorial-onboarding-3-1.png","alt":"A simple view with some component inside","type":"image","variants":[{"traits":["1x","light"],"url":"\/image