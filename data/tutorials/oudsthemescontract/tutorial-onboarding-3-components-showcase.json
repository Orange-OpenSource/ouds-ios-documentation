le-Of-Contents-(onboarding)/Go-further-with-more-ressources":{"type":"topic","abstract":[],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Go-further-with-more-ressources","role":"article","url":"\/tutorials\/table-of-contents-(onboarding)\/go-further-with-more-ressources","title":"Go further with more ressources","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"role":"project","kind":"project","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","title":"Swift Package integration","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}]},"tutorial-onboarding-3-7.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png"}],"alt":"A view with images and texts","identifier":"tutorial-onboarding-3-7.png","type":"image"},"tutorial-onboarding-3-3.swift":{"content":["import OUDSSwiftUI","import SwiftUI","","struct Navigation: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"syntax":"swift","fileName":"Navigation.swift","identifier":"tutorial-onboarding-3-3.swift","highlights":[],"fileType":"swift","type":"file"},"Xcode 26.5":{"title":"Xcode 26.5","type":"xcodeRequirement","identifier":"Xcode 26.5","url":"https:\/\/developer.apple.com\/download\/"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"role":"pseudoSymbol","kind":"section","type":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","abstract":[{"type":"text","text":"Now you are ready to use more components than a simple button!"}],"title":"Discover main components"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsradioitem/":{"titleInlineContent":[{"inlineContent":[{"text":"radio item","type":"text"}],"type":"emphasis"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","title":"radio item","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsradioitem\/","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding":{"title":"Check Your Understanding","type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Check-Your-Understanding"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstabbar/":{"titleInlineContent":[{"inlineContent":[{"text":"tab bar","type":"text"}],"type":"emphasis"}],"title":"tab bar","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","type":"link"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsbadgestandard/":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/","title":"badges","type":"link","titleInlineContent":[{"text":"badges","type":"text"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsbadgestandard\/"},"tutorial-onboarding-3-2.swift":{"syntax":"swift","fileType":"swift","identifier":"tutorial-onboarding-3-2.swift","type":"file","fileName":"Indicator.swift","highlights":[],"content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudsfilterchip/":{"title":"filter chip","type":"link","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","titleInlineContent":[{"inlineContent":[{"type":"text","text":"filter chip"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudscheckboxitem":{"titleInlineContent":[{"inlineContent":[{"text":"checkbox item","type":"text"}],"type":"emphasis"}],"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","title":"checkbox item","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudscheckboxitem","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further":{"type":"section","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","role":"pseudoSymbol","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Navigations-and-themeable-view-a-step-further","title":"Navigations and themeable view, a step further","kind":"section"},"tutorial-onboarding-3-6.swift":{"type":"file","identifier":"tutorial-onboarding-3-6.swift","syntax":"swift","fileName":"ComponentShowcase.swift","highlights":[],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"]},"tutorial-onboarding-3-8.swift":{"syntax":"swift","fileType":"swift","identifier":"tutorial-onboarding-3-8.swift","type":"file","fileName":"ContentView.swift","highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"]},"tutorial-onboarding-3-1.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-1.png","traits":["1x","light"]}],"alt":"A simple view with some component inside","identifier":"tutorial-onboarding-3-1.png","type":"image"},"tutorial-onboarding-3-7.swift":{"type":"file","syntax":"swift","identifier":"tutorial-onboarding-3-7.swift","fileName":"ContentView.swift","highlights":[],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            HomeScreen()","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further":{"role":"project","kind":"project","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"title":"Going further with more resources"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view":{"role":"project","type":"topic","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view","estimatedTime":"45min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view","title":"Define information cards","abstract":[{"text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images.","type":"text"},{"text":" ","type":"text"},{"text":"How can we do that?","type":"text"}]},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","alt":"OUDS themes logo","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}],"type":"image"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents":{"title":"online documentation","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","titleInlineContent":[{"text":"online documentation","type":"text"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents","type":"link"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"titleInlineContent":[{"inlineContent":[{"text":"text input","type":"text"}],"type":"emphasis"}],"title":"text input","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","type":"link"},"tutorial-onboarding-3-4.swift":{"syntax":"swift","fileType":"swift","identifier":"tutorial-onboarding-3-4.swift","type":"file","fileName":"ComponentGroup.swift","highlights":[],"content":["import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-4-going-further#More-resources":{"role":"pseudoSymbol","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-4-going-further#More-resources","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-4-going-further#More-resources","title":"More resources","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view":{"role":"pseudoSymbol","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Merge-components-in-a-richer-view","title":"Merge components in a richer view","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}]},"tutorial-onboarding-3-1.swift":{"type":"file","syntax":"swift","identifier":"tutorial-onboarding-3-1.swift","fileName":"Control.swift","highlights":[],"fileType":"swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"]},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudslink":{"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink","titleInlineContent":[{"text":"links","type":"text"}],"title":"links","type":"link"}}}