ype":"emphasis"},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"size","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Make your tests with the Xcode preview."}],"type":"paragraph"}],"media":null,"code":"tutorial-onboarding-3-2.swift","runtimePreview":"tutorial-onboarding-3-2.png","caption":[]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" containing "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are also "},{"inlineContent":[{"type":"text","text":"navigation"}],"type":"emphasis"},{"type":"text","text":" components in OUDS like "},{"inlineContent":[{"type":"text","text":"links"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"tab bars"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Define a "},{"type":"codeVoice","code":"Navigation"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":" with in its body a "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedNone"}]},{"type":"text","text":" spacing and three "},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudslink"},{"type":"text","text":": a "},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"type":"text","text":" link, a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"back"}]},{"type":"text","text":" link and an "},{"type":"emphasis","inlineContent":[{"text":"informational","type":"text"}]},{"type":"text","text":" link opening a URL."}]}],"media":null,"type":"step","runtimePreview":"tutorial-onboarding-3-3.png","code":"tutorial-onboarding-3-3.swift"}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Components are gathered by group or families. You can find all of theme in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For exemple, in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"control"}]},{"text":" family you will find ","type":"text"},{"inlineContent":[{"type":"text","text":"checkboxes"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"radio buttons"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"switch items"}],"type":"emphasis"},{"text":" and some ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"emphasis"},{"text":" fields.","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Layouts"}]},{"text":" provides ","type":"text"},{"inlineContent":[{"type":"text","text":"dividers"}],"type":"emphasis"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"buttons"}]},{"type":"text","text":" are in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actions"}]},{"type":"text","text":" group, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bullet lists"}]},{"type":"text","text":" in "},{"inlineContent":[{"type":"text","text":"display"}],"type":"emphasis"},{"type":"text","text":" family."}],"type":"paragraph"}]}],"anchor":"Discover-main-components"},{"title":"Merge components in a richer view","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, define the components groups we need as an enumeration. We will provide views for "},{"inlineContent":[{"text":"control","type":"text"}],"type":"emphasis"},{"type":"text","text":" components, "},{"inlineContent":[{"text":"indicator","type":"text"}],"type":"emphasis"},{"text":" components and ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"emphasis"},{"text":" components. The ","type":"text"},{"inlineContent":[{"text":"enum","type":"text"}],"type":"emphasis"},{"type":"text","text":" to define must conform to "},{"inlineContent":[{"type":"text","text":"CaseIterable"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"CustomStringConvertible"}],"type":"emphasis"}]}],"runtimePreview":null,"type":"step","caption":[],"code":"tutorial-onboarding-3-4.swift","media":null},{"code":"tutorial-onboarding-3-5.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then define a "},{"type":"codeVoice","code":"CategorySelector"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":": it must display a "},{"isActive":true,"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudsfilterchip\/","type":"reference"},{"type":"text","text":" for all "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ComponentGroup"}]},{"type":"text","text":" cases and keep a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"selected component group"}]},{"type":"text","text":" as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Binding"}]},{"type":"text","text":". Use the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme.spaces.fixedSmall"}]},{"type":"text","text":" token for horizontal spacing between the chips."}]}],"runtimePreview":null,"caption":[],"type":"step"},{"code":"tutorial-onboarding-3-6.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"t