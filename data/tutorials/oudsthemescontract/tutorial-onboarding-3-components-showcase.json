rticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSLink(text: \"Link\", indicator: .next) {}","            OUDSLink(text: \"Link\", indicator: .previous) {}","            OUDSLink(text: \"Read OUDS Documentation\") {","                UIApplication.shared.open(URL(string: \"https:\/\/unified-design-system.orange.com\")!)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Navigation().orangePreview()","    }","}"],"highlights":[],"identifier":"tutorial-onboarding-3-3.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Discover-main-components":{"type":"section","role":"pseudoSymbol","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"title":"Discover main components","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Discover-main-components","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Discover-main-components"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstextinput":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstextinput","title":"text input","titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"text input"}]}],"type":"link"},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png"}],"type":"image","alt":"OUDS themes logo"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudstabbar/":{"titleInlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"tab bar"}]}],"type":"link","title":"tab bar","url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudstabbar\/"},"tutorial-onboarding-3-1.swift":{"type":"file","syntax":"swift","fileType":"swift","fileName":"Control.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Control: View {","","    @State private var text: String = \"\"","    @State private var isOn: Bool = true","    @Environment(\\.theme) private var theme","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            OUDSCheckboxItem(\"Checkbox item\", isOn: $isOn)","            OUDSRadioItem(\"Radio button item\", isOn: $isOn)","            OUDSSwitchItem(\"Switch item\", isOn: $isOn)","            OUDSTextInput(label: \"Text input\", text: $text)","            OUDSPasswordInput(label: \"Password input\", password: $text)","        }","    }","}","","#Preview {","    Control().orangePreview()","}"],"highlights":[],"identifier":"tutorial-onboarding-3-1.swift"},"tutorial-onboarding-3-3.png":{"identifier":"tutorial-onboarding-3-3.png","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-3.png","traits":["1x","light"]}],"type":"image","alt":"Three links with chevrons or underlined text"},"https://ios.unified-design-system.orange.com/documentation/oudscomponents/oudspasswordinput":{"type":"link","titleInlineContent":[{"inlineContent":[{"type":"text","text":"password input"}],"type":"emphasis"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput","title":"password input","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/oudscomponents\/oudspasswordinput"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase#Check-Your-Understanding":{"type":"link","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding","title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view":{"type":"topic","role":"project","abstract":[{"text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images.","type":"text"},{"text":" ","type":"text"},{"text":"How can we do that?","type":"text"}],"title":"Define information cards","estimatedTime":"45min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view"},"tutorial-onboarding-3-6.swift":{"type":"file","identifier":"tutorial-onboarding-3-6.swift","highlights":[],"fileName":"ComponentShowcase.swift","content":["import OUDSSwiftUI","import SwiftUI","","enum ComponentGroup: CaseIterable, CustomStringConvertible {","    case control, indicator, navigation","","    var description: String {","        switch self {","        case .control: \"Control\"","        case .indicator: \"Indicator\"","        case .navigation: \"Navigation\"","        }","    }","}","","struct CategorySelector: View {","","    @Binding var selectedComponentGroup: ComponentGroup","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","","    var body: some View {","        ScrollView(.horizontal, showsIndicators: false) {","            HStack(spacing: theme.spaces.fixedSmall) {","                ForEach(ComponentGroup.allCases, id: \\.self) { group in","                    OUDSFilterChip(text: group.description, selected: group == selectedComponentGroup) {","                        selectedComponentGroup = group","                    }","                }","            }","            .padding(.horizontal, theme.gridMargin(for: oudsHorizontalSizeClass))","        }","    }","}","","struct ComponentShowcase: View {","","    @State private var selectedComponentGroup: ComponentGroup = .control","    @Environment(\\.theme) private var theme","    @Environment(\\.oudsHorizontalSizeClass) private var oudsHorizontalSizeClass","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.fixedNone) {","            VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","                Text(\"Explore some OUDS components\")","                    .frame(maxWidth: .infinity, alignment: .leading)","                    .headingLarge(theme)","                    .foregroundColor(theme.colors.contentDefault)","                    .padding(.horizontal, gridMargin)","","                CategorySelector(selectedComponentGroup: $selectedComponentGroup)","            }","            .padding(.vertical, gridMargin)","            .background(theme.colors.bgSecondary)","","            \/\/ Use opacity to reserve space vertically, otherwise height change when changing group","            ZStack {","                let controlOpacity = selectedComponentGroup == .control ? 1.0 : 0.0","                let indicatorOpacity = selectedComponentGroup == .indicator ? 1.0 : 0.0","                let navigationOpacity = selectedComponentGroup == .navigation ? 1.0 : 0.0","","                Control().opacity(controlOpacity)","                Indicator().opacity(indicatorOpacity)","                Navigation().opacity(navigationOpacity)","            }","            .padding(.all, gridMargin)","        }","    }","","    private var gridMargin: Double {","        theme.gridMargin(for: oudsHorizontalSizeClass)","    }","}","","#Preview {","    ScrollView {","        ComponentShowcase().orangePreview()","    }","}"],"fileType":"swift","syntax":"swift"},"tutorial-onboarding-3-8.swift":{"type":"file","syntax":"swift","fileType":"swift","fileName":"ContentView.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    private let theme = OrangeTheme()","    @State private var selectedTab = 0","","    var body: some View {","        OUDSThemeableView(theme: theme) {","            OUDSTabBar(selectedTab: $selectedTab, count: 3) {","                HomeScreen().tabItem {","                    Label(\"Home\", image: \"Home\")","                }","                .tag(0)","","                Text(\"E shop Screen\").tabItem {","                    Label(\"E-Shop\", image: \"E-Shop\")","                }","                .tag(1)","","                Text(\"Contact Screen\").tabItem {","                    Label(\"Contact\", image: \"Contact\")","                }","                .tag(2)","            }","        }","    }","}","","#Preview {","    ContentView()","        .orangePreview()","}"],"highlights":[{"line":7},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"identifier":"tutorial-onboarding-3-8.swift"},"tutorial-onboarding-3-2.png":{"identifier":"tutorial-onboarding-3-2.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-2.png"}],"type":"image","alt":"Colored badges displayed in white blank view"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-3-components-showcase":{"type":"topic","role":"project","abstract":[{"text":"Now you are ready to use more components than a simple button!","type":"text"}],"title":"Components showcase","estimatedTime":"1hr 0min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-3-components-showcase","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-3-components-showcase"},"tutorial-onboarding-3-2.swift":{"fileType":"swift","type":"file","highlights":[],"fileName":"Indicator.swift","content":["import OUDSSwiftUI","import SwiftUI","","struct Indicator: View {","","    @Environment(\\.theme) private var theme","    @Environment(\\.verticalSizeClass) private var verticalSizeClass","","    var body: some View {","        VStack(spacing: theme.spaces.scaledMedium.dimension(for: verticalSizeClass ?? .regular)) {","            HStack(spacing: theme.spaces.fixedSmall) {","                OUDSBadgeStandard(accessibilityLabel: \"Badge positive\", status: .positive, size: .large)","                OUDSBadgeCount(1, accessibilityLabel: \"Badge count\", status: .negative, size: .large)","                OUDSBadgeIcon(status: .info, accessibilityLabel: \"Badge info\", size: .large)","            }","        }","    }","}","","#Preview {","    ScrollView {","        Indicator().orangePreview()","    }","}"],"syntax":"swift","identifier":"tutorial-onboarding-3-2.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-1-package-and-libraries":{"type":"topic","role":"project","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"title":"Swift Package integration","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-1-package-and-libraries","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-1-package-and-libraries"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Import-of-the-Swift-Package-and-choose-its-libraries":{"type":"topic","role":"article","abstract":[],"title":"Import of the Swift Package and choose its libraries","url":"\/tutorials\/table-of-contents-(onboarding)\/import-of-the-swift-package-and-choose-its-libraries","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Import-of-the-Swift-Package-and-choose-its-libraries"},"tutorial-onboarding-3-7.png":{"identifier":"tutorial-onboarding-3-7.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/tutorial-onboarding-3-7.png"}],"type":"image","alt":"A view with images and texts"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(onboarding)/Components-showcases":{"type":"topic","role":"article","abstract":[],"title":"Components showcases","url":"\/tutorials\/table-of-contents-(onboarding)\/components-showcases","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(onboarding)\/Components-showcases"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics":{"type":"section","role":"pseudoSymbol","abstract":[{"text":"Let’s suppose we want to define a view for corporate apps with headings, texts, buttons and images.","type":"text"},{"text":" ","type":"text"},{"text":"How can we do that?","type":"text"}],"title":"Define the view basics","url":"\/tutorials\/oudsthemescontract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-onboarding-2-nice-and-clear-view#Define-the-view-basics"}}}