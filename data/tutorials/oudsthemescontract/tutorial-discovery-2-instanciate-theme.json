,"text":". Add inside a simple text"}]}],"caption":[],"media":null,"runtimePreview":"tutorial-discovery-2-1.png","type":"step","code":"tutorial-discovery-2-1.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the needed librairies in your file (we suppose here "},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSSwiftUI"}]},{"type":"text","text":" during all the tutorial)."},{"type":"text","text":" "},{"type":"text","text":"Instanciate a new object of type "},{"code":"OrangeTheme","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In your app root view, add the "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" and give it the new theme object."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Project must compile then. This is until today (API 0.20.0) the only way to instanciated and inject a theme."}]}],"media":null,"runtimePreview":"tutorial-discovery-2-2.png","type":"step","code":"tutorial-discovery-2-2.swift"}],"anchor":"Basic-structure-for-the-app","title":"Basic structure for the app"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"content":[],"title":[{"inlineContent":[{"type":"text","text":"Is it mandatory to use today the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"?"}],"type":"paragraph"}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is! Otherwise the theme won’t be defined and available as environment variable."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" is mandatory to inject as environment variable the theme and expose it in every view inside."}]}]}],"type":"multiple-choice"}]},{"kind":"callToAction","title":"Use your first OUDS components","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"featuredEyebrow":"Tutorial","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","type":"reference"}}],"metadata":{"category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(discovery)","title":"Instanciate and inject a theme","role":"project"},"kind":"project","references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things#Check-Your-Understanding","type":"link","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"title":"Swift Package Discovery Tutorial","role":"overview","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"tex