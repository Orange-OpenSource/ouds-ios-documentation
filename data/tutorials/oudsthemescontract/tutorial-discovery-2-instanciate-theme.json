,"caption":[],"code":"tutorial-discovery-2-1.swift"},{"type":"step","media":null,"caption":[{"inlineContent":[{"type":"text","text":"Project must compile then. This is until today (API 0.20.0) the only way to instanciated and inject a theme."}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Import the needed librairies in your file (we suppose here ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"OUDSSwiftUI","type":"text"}]},{"text":" during all the tutorial).","type":"text"},{"text":" ","type":"text"},{"text":"Instanciate a new object of type ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In your app root view, add the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" and give it the new theme object.","type":"text"}],"type":"paragraph"}],"code":"tutorial-discovery-2-2.swift","runtimePreview":"tutorial-discovery-2-2.png"}],"anchor":"Basic-structure-for-the-app"}]},{"assessments":[{"content":[],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"text":"Is it mandatory to use today the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":"?","type":"text"}]}],"choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"It is! Otherwise the theme won’t be defined and available as environment variable.","type":"text"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],"justification":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" is mandatory to inject as environment variable the theme and expose it in every view inside.","type":"text"}],"type":"paragraph"}],"isCorrect":false}]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"featuredEyebrow":"Tutorial","abstract":[{"text":"OUDS provides comp