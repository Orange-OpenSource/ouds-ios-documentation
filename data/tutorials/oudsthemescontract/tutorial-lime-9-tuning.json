-lime-9.swift":{"type":"file","syntax":"swift","fileType":"swift","fileName":"Tokens.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","nonisolated class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider(),","            tuning: Self.tuning)","","        registerFonts()","    }","","    \/\/ MARK: - Tuning","","    private static let tuning: Tuning = .init(hasRoundedButtons: true,","                                              hasRoundedTextInputs: true,","                                              hasRoundedAlertMessages: true,","                                              hasRoundedProgressIndicators: true,","                                              hasRoundedListItems: true)","","    \/\/ MARK: - Fonts","","    private static var fontsAlreadyRegistered = false","","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}"],"highlights":[{"line":19},{"line":31},{"line":32},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"identifier":"tutorial-lime-9.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link"},"ic_design_token_intro.png":{"identifier":"ic_design_token_intro.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}],"type":"image","alt":"OUDS tokens logo"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings":{"type":"topic","role":"project","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"title":"Spacings","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutor