type":"file","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","nonisolated class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider(),","            tuning: Self.tuning)","","        registerFonts()","    }","","    \/\/ MARK: - Tuning","","    private static let tuning: Tuning = .init(hasRoundedButtons: true,","                                              hasRoundedTextInputs: true,","                                              hasRoundedAlertMessages: true,","                                              hasRoundedProgressIndicators: true,","                                              hasRoundedListItems: true)","","    \/\/ MARK: - Fonts","","    private static var fontsAlreadyRegistered = false","","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}"],"identifier":"tutorial-lime-9.swift","syntax":"swift","highlights":[{"line":19},{"line":31},{"line":32},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileName":"Tokens.swift","fileType":"swift"},"tutorial-lime-9.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-lime-9.png","traits":["1x","light"]}],"alt":"App with Lime theme and its own tuning","type":"image","identifier":"tutorial-lime-9.png"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)":{"role":"overview","abstract":[{"type":"text","text":"Learn how to create a custom OUDS theme by overriding tokens from the Orange theme."},{"type":"text","text":" "},{"type":"text","text":"In this tutorial, you will build the Lime fake theme with its own properties"},{"type":"text","text":" "},{"type":"text","text":"You’ll discover how to customize colors, spacings, borders, elevations, colored surfaces, fonts and tuning."}],"kind":"overview","url":"\/tutorials\/table-of-contents-(lime)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","title":"Swift Package Lime Tutorial","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further#More-resources":{"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further#More-resources","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further#More-resources","type":"section","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"title":"More resources","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning":{"role":"project","abstract