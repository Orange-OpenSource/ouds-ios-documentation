           elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider(),","            tuning: Self.tuning)","","        registerFonts()","    }","","    \/\/ MARK: - Tuning","","    private static let tuning: Tuning = .init(hasRoundedButtons: true,","                                              hasRoundedTextInputs: true,","                                              hasRoundedAlertMessages: true,","                                              hasRoundedProgressIndicators: true,","                                              hasRoundedListItems: true)","","    \/\/ MARK: - Fonts","","    private static var fontsAlreadyRegistered = false","","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Check-Your-Understanding","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Check-Your-Understanding":{"title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts":{"role":"project","estimatedTime":"15min","type":"topic","abstract":[{"type":"text","text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components."}],"title":"Fonts","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts"},"ic_design_token_intro.png":{"alt":"OUDS tokens logo","identifier":"ic_design_token_intro.png","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png"}],"type":"image"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning#Defining-tuning-for-local-theme":{"type":"section","role":"pseudoSymbol","kind":"section","title":"Defining tuning for local theme","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tuto