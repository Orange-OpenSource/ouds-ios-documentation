:"section","title":"Add basic components","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components#Add-basic-components","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components#Add-basic-components","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"text":"They are rendered thanks to the theme in use.","type":"text"}]},"tutorial-discovery-1-ouds-swift-package.png":{"identifier":"tutorial-discovery-1-ouds-swift-package.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-discovery-1-ouds-swift-package.png","traits":["1x","light"]}],"alt":"Description by Xcode of the OUDS Swift Package with its README preview"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"role":"project","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","estimatedTime":"30min","title":"Use your first OUDS components","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"type":"text","text":"They are rendered thanks to the theme in use."}],"kind":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)/Go-further-with-more-ressources":{"role":"article","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)\/Go-further-with-more-ressources","title":"Go further with more ressources","url":"\/tutorials\/table-of-contents-(discovery)\/go-further-with-more-ressources","abstract":[],"kind":"article"},"https://github.com/Orange-OpenSource/ouds-ios/