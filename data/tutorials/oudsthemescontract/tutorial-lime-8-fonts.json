{"sections":[{"chapter":"Fonts","title":"Fonts","backgroundImage":"ic_component_intro.png","estimatedTimeInMinutes":15,"projectFiles":"OUDS-Lime-Tutorial.zip","content":[{"inlineContent":[{"text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components.","type":"text"}],"type":"paragraph"}],"xcodeRequirement":"Xcode 27.1","kind":"hero","image":"ic_component_intro.png"},{"tasks":[{"title":"Overriding font tokens","anchor":"Overriding-font-tokens","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Font tokens are defined in "},{"type":"codeVoice","code":"OrangeThemeFontSemanticTokensProvider"},{"type":"text","text":". We will override heading and label fonts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tunings allow us to customize component-specific properties like border radius."}]}]}],"stepsSection":[{"caption":[],"code":"tutorial-lime-8.swift","type":"step","runtimePreview":"tutorial-lime-8.png","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with the theme from the colored surface chapter."},{"type":"text","text":" "},{"type":"text","text":"Now let’s add the font provider with typography overrides."}]}]}]}],"kind":"tasks"},{"assessments":[{"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Can you use your own local fonts with OUDS."}],"type":"paragraph"}],"content":[],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Some fonts are already supported in OUDS. And you can register your own ones."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No, it’s forbidden"}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"OUDS is flexible enough to allow