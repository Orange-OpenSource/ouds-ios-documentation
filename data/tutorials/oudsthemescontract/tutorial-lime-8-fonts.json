{"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[{"backgroundImage":"ic_component_intro.png","chapter":"Fonts","xcodeRequirement":"Xcode 26.5","estimatedTimeInMinutes":15,"image":"ic_component_intro.png","kind":"hero","title":"Fonts","projectFiles":"OUDS-Lime-Tutorial.zip","content":[{"inlineContent":[{"type":"text","text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"title":"Overriding font tokens","contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Font tokens are defined in "},{"type":"codeVoice","code":"OrangeThemeFontSemanticTokensProvider"},{"type":"text","text":". We will override heading and label fonts."}]},{"type":"paragraph","inlineContent":[{"text":"Tunings allow us to customize component-specific properties like border radius.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"media":null,"caption":[],"code":"tutorial-lime-8.swift","type":"step","runtimePreview":"tutorial-lime-8.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with the theme from the colored surface chapter."},{"type":"text","text":" "},{"type":"text","text":"Now let’s add the font provider with typography overrides."}]}]}],"anchor":"Overriding-font-tokens"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"choices":[{"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"Some fonts are already supported in OUDS. And you can register your own ones."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"OUDS is flexible enough to allow local themes and their fonts."}],"type":"paragraph"}],"content":[{"inl