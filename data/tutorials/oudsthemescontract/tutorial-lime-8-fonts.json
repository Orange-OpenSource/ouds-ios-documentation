of OUDS","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"type":"image"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)":{"title":"Swift Package Lime Tutorial","role":"overview","abstract":[{"type":"text","text":"Learn how to create a custom OUDS theme by overriding tokens from the Orange theme."},{"type":"text","text":" "},{"type":"text","text":"In this tutorial, you will build the Lime fake theme with its own properties"},{"type":"text","text":" "},{"type":"text","text":"You’ll discover how to customize colors, spacings, borders, elevations, colored surfaces, fonts and tuning."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","kind":"overview","url":"\/tutorials\/table-of-contents-(lime)","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","role":"pseudoSymbol","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point","title":"Starting point","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Overriding-color-tokens":{"title":"Overriding color tokens","kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Overriding-color-tokens","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Overriding-color-tokens","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}]},"Xcode 27.1":{"identifier":"Xcode 27.1","title":"Xcode 27.1","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/"},"tutorial-lime-8.swift":{"identifier":"tutorial-lime-8.swift","type":"file","fileName":"Tokens.swift","syntax":"swift","highlights":[{"line":19},{"line":30},{"line":33},{"line":36},{"line":37},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":47},{"line":48},{"line":50},{"line":51},{"line":54},{"line":56},{"line":57},{"line":59},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68}],"fileType":"swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider())","","        registerFonts()","    }","","    \/\/ Register fonts only one time","    private static var fontsAlreadyRegistered = false","","    \/\/ Register local fonts using TTF","    \/\/ In the example we use Shantell Sans which is already known in the OUDS Core.","    \/\/ If the font is not managed by OUDS you will need to save inside OUDS the","    \/\/ combinations between PostScript font identifiers and weights","    \/\/ with registerFont(postScript: String, forCombination: PostScriptFontNamesMapKey) API.","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}","","\/\/ MARK: - Fonts Provider","","\/\/ By subclassing OrangeThemeFontSemanticTokensProvider, you get all existing tokens","\/\/ of font of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeFontProvider: OrangeThemeFontSemanticTokensProvider {","","    private static let myFont = \"Shantell Sans\"","","    override var familyBody: FontFamilySemanticToken { Self.myFont }","    override var familyCode: FontFamilySemanticToken { Self.myFont }","    override var familyDisplay: FontFamilySemanticToken { Self.myFont }","    override var familyHeading: FontFamilySemanticToken { Self.myFont }","    override var familyLabel: FontFamilySemanticToken { Self.myFont }","    override var familySystem: FontFamilySemanticToken { Self.myFont }","}"]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Colors":{"title":"Colors","role":"article","url":"\/tutorials\/table-of-contents-(lime)\/colors","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colors","abstract":[],"kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding"},"OUDS-Lime-Tutorial.zip":{"url":"\/downloads\/OUDSThemesContract\/OUDS-Lime-Tutorial.zip","identifier":"OUDS-Lime-Tutorial.zip","type":"download","checksum":"72f26514b2b3bdfddd60f3528e1a7da1b2094be3b1416da516247448c1404f999b7430dcd5bef0aeca5d195d9075946fab90a54651854c2b1a1e43a74912a061"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"title":"Import the Swift Package and the libraries","role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/