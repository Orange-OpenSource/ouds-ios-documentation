eme from the colored surface chapter.","type":"text"},{"text":" ","type":"text"},{"text":"Now let’s add the font provider with typography overrides.","type":"text"}],"type":"paragraph"}],"code":"tutorial-lime-8.swift","runtimePreview":"tutorial-lime-8.png","media":null,"type":"step"}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Font tokens are defined in ","type":"text"},{"type":"codeVoice","code":"OrangeThemeFontSemanticTokensProvider"},{"text":". We will override heading and label fonts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tunings allow us to customize component-specific properties like border radius."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Overriding-font-tokens","title":"Overriding font tokens"}]},{"kind":"assessments","assessments":[{"type":"multiple-choice","content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Can you use your own local fonts with OUDS."}]}],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Some fonts are already supported in OUDS. And you can register your own ones."}],"type":"paragraph"}],"isCorrect":true},{"isCorrect":false,"justification":[{"inlineContent":[{"text":"OUDS is flexible enough to allow local themes and their fonts.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"No, it’s forbidden","type":"text"}],"type":"paragraph"}]}]}],"anchor":"Check-Your-Understanding"},{"featuredEyebrow":"Tutorial","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","title":"Tunings","abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}]}],"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"project","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(lime)","title":"Fonts"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations":{"abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"role":"project","type":"topic","title":"Elevations","kind":"project","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further#More-resources":{"abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"role":"pseudoSymbol","type":"section","title":"More resources","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further#More-resources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further#More-resources"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Overriding-elevation-tokens":{"title":"Overriding elevation tokens","type":"section","abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Overriding-elevation-tokens"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Elevations":{"title":"Elevations","type":"topic","abstract":[],"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Elevations","kind":"article","url":"\/tutorials\/table-of-contents-(lime)\/elevations"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"role":"pseudoSymbol","type":"section","title":"Starting point","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Overriding-color-tokens":{"abstract":[{"text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme.","type":"text"}],"role":"pseudoSymbol","type":"section","title":"Overriding color tokens","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Overriding-color-tokens","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Overriding-color-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"title":"Colors","type":"topic","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","estimatedTime":"15min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders":{"title":"Borders","type":"topic","abstract":[{"text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components.","type":"text"}],"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders","kind":"project","estimatedTime":"10min"},"tutorial-lime-8.swift":{"highlights":[{"line":19},{"line":30},{"line":33},{"line":36},{"line":37},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":47},{"line":48},{"line":50},{"line":51},{"line":54},{"line":56},{"line":57},{"line":59},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68}],"fileType":"swift","syntax":"swift","type":"file","fileName":"Tokens.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider())","","        registerFonts()","    }","","    \/\/ Register fonts only one time","    private static var fontsAlreadyRegistered = false","","    \/\/ Register local fonts using TTF","    \/\/ In the example we use Shantell Sans which is already known in the OUDS Core.","    \/\/ If the font is not managed by OUDS you will need to save inside OUDS the","    \/\/ combinations between PostScript font identifiers and weights","    \/\/ with registerFont(postScript: String, forCombination: PostScriptFontNamesMapKey) API.","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}","","\/\/ MARK: - Fonts Provider","","\/\/ By subclassing OrangeThemeFontSemanticTokensProvider, you get all existing tokens","\/\/ of font of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeFontProvider: OrangeThemeFontSemanticTokensProvider {","","    private static let myFont = \"Shantell Sans\"","","    override var familyBody: FontFamilySemanticToken { Self.myFont }","    override var familyCode: FontFamilySemanticToken { Self.myFont }","    override var familyDisplay: FontFamilySemanticToken { Self.myFont }","    override var familyHeading: FontFamilySemanticToken { Self.myFont }","    override var familyLabel: FontFamilySemanticToken { Self.myFont }","    override var familySystem: FontFamilySemanticToken { Self.myFont }","}"],"identifier":"tutorial-lime-8.swift"},"doc://OUDSThemesContract/tutorials/Ta