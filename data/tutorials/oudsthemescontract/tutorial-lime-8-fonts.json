acings#Overriding-spacing-tokens","title":"Overriding spacing tokens","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Overriding-spacing-tokens","kind":"section","type":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries":{"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries","type":"topic","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These libraries help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"title":"Swift Package integration","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors","estimatedTime":"15min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","type":"topic","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"title":"Colors","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens":{"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","type":"section","abstract":[{"text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component.","type":"text"}],"title":"Overriding color mode tokens","kind":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point","title":"Starting point","abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point","kind":"section","type":"section"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries":{"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Import-the-Swift-Package-and-the-libraries","type":"section","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"title":"Import the Swift Package and the libraries","kind":"section"},"tutorial-lime-8.swift":{"type":"file","fileName":"Tokens.swift","syntax":"swift","identifier":"tutorial-lime-8.swift","fileType":"swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider())","","        registerFonts()","    }","","    \/\/ Register fonts only one time","    private static var fontsAlreadyRegistered = false","","    \/\/ Register local fonts using TTF","    \/\/ In the example we use Shantell Sans which is already known in the OUDS Core.","    \/\/ If the font is not managed by OUDS you will need to save inside OUDS the","    \/\/ combinations between PostScript font identifiers and weights","    \/\/ with registerFont(postScript: String, forCombination: PostScriptFontNamesMapKey) API.","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}","","\/\/ MARK: - Fonts Provider","","\/\/ By subclassing OrangeThemeFontSemanticTokensProvider, you get all existing tokens","\/\/ of font of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeFontProvider: OrangeThemeFontSemanticTokensProvider {","","    private static let myFont = \"Shantell Sans\"","","    override var familyBody: FontFamilySemanticToken { Self.myFont }","    override var familyCode: FontFamilySemanticToken { Self.myFont }","    override var familyDisplay: FontFamilySemanticToken { Self.myFont }","    override var familyHeading: FontFamilySemanticToken { Self.myFont }","    override var familyLabel: FontFamilySemanticToken { Self.myFont }","    override var familySystem: FontFamilySemanticToken { Self.myFont }","}"],"highlights":[{"line":19},{"line":30},{"line":33},{"line":36},{"line":37},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":47},{"line":48},{"line":50},{"line":51},{"line":54},{"line":56},{"line":57},{"line":59},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Fonts":{"kind":"article","title":"Fonts","abstract":[],"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Fonts","url":"\/tutorials\/table-of-contents-(lime)\/fonts","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding","title":"Check Your Understanding"},"ic_component_intro.png":{"alt":"Logo of OUDS","identifier":"ic_component_intro.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"type":"image"},"Xcode 27.1":{"identifier":"Xcode 27.1","url":"https:\/\/developer.apple.com\/download\/","title":"Xcode 27.1","type":"xcodeRequirement"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Colored-Surface":{"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colored-Surface","url":"\/tutorials\/table-of-contents-(lime)\/colored-surface","type":"topic","abstract":[],"title":"Colored Surface","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro":{"role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","estimatedTime":"10min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro","type":"topic","abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"title":"Introduct