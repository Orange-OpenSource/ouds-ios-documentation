ding color mode tokens","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Spacings":{"type":"topic","role":"article","abstract":[],"title":"Spacings","url":"\/tutorials\/table-of-contents-(lime)\/spacings","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Spacings"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Starting-point":{"type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"title":"Starting point","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Starting-point","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Starting-point"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Overriding-spacing-tokens":{"type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"title":"Overriding spacing tokens","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Overriding-spacing-tokens","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Overriding-spacing-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"type":"topic","role":"project","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"title":"Colors","estimatedTime":"15min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors"},"tutorial-lime-8.swift":{"highlights":[{"line":19},{"line":30},{"line":33},{"line":36},{"line":37},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":47},{"line":48},{"line":50},{"line":51},{"line":54},{"line":56},{"line":57},{"line":59},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68}],"identifier":"tutorial-lime-8.swift","fileName":"Tokens.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider())","","        registerFonts()","    }","","    \/\/ Register fonts only one time","    private static var fontsAlreadyRegistered = false","","    \/\/ Register local fonts using TTF","    \/\/ In the example we use Shantell Sans which is already known in the OUDS Core.","    \/\/ If the font is not managed by OUDS you will need to save inside OUDS the","    \/\/ combinations between PostScript font identifiers and weights","    \/\/ with registerFont(postScript: String, forCombination: PostScriptFontNamesMapKey) API.","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}","","\/\/ MARK: - Fonts Provider","","\/\/ By subclassing OrangeThemeFontSemanticTokensProvider, you get all existing tokens","\/\/ of font of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeFontProvider: OrangeThemeFontSemanticTokensProvider {","","    private static let myFont = \"Shantell Sans\"","","    override var familyBody: FontFamilySemanticToken { Self.myFont }","    override var familyCode: FontFamilySemanticToken { Self.myFont }","    override var familyDisplay: FontFamilySemanticToken { Self.myFont }","    override var familyHeading: FontFamilySemanticToken { Self.myFont }","    override var familyLabel: FontFamilySemanticToken { Self.myFont }","    override var familySystem: FontFamilySemanticToken { Self.myFont }","}"],"fileType":"swift","type":"file","syntax":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning#Defining-tuning-for-local-theme":{"type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}],"title":"Defining tuning for local theme","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Go-further-with-more-ressources":{"type":"topic","role":"article","abstract":[],"title":"Go further with more ressources","url":"\/tutorials\/table-of-contents-(lime)\/go-further-with-more-ressources","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Go-further-with-more-ressources"},"doc://OUDSTheme