intro.png","image":"ic_component_intro.png","kind":"hero"},{"tasks":[{"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Font tokens are defined in ","type":"text"},{"code":"OrangeThemeFontSemanticTokensProvider","type":"codeVoice"},{"text":". We will override heading and label fonts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tunings allow us to customize component-specific properties like border radius.","type":"text"}]}],"mediaPosition":"trailing"}],"title":"Overriding font tokens","stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Start with the theme from the colored surface chapter.","type":"text"},{"text":" ","type":"text"},{"text":"Now let’s add the font provider with typography overrides.","type":"text"}]}],"caption":[],"runtimePreview":"tutorial-lime-8.png","code":"tutorial-lime-8.swift","media":null}],"anchor":"Overriding-font-tokens"}],"kind":"tasks"},{"anchor":"Check-Your-Understanding","assessments":[{"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Some fonts are already supported in OUDS. And you can register your own ones.","type":"text"}]}],"isCorrect":true},{"content":[{"type":"paragraph","inlineContent":[{"text":"No, it’s forbidden","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"OUDS is flexible enough to allow local themes and their fonts.","type":"text"}]}],"isCorrect":false}],"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"text":"Can you use your own local fonts with OUDS.","type":"text"}]}],"content":[]}],"kind":"assessments"},{"abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}],"action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true,"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning"},"featuredEyebrow":"Tutorial","title":"Tunings","kind":"callToAction"}],"variants":[{"paths":["\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"project","references":{"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Go-further-with-more-ressources":{"url":"\/tutorials\/table-of-contents-(lime)\/go-further-with-more-ressources","role":"article","abstract":[],"type":"topic","title":"Go further with more ressources","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Go-further-with-more-ressources"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts#Check-Your-Understanding":{"type":"link","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro","role":"project","abstract":[{"type":"text","text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme."}],"type":"topic","title":"Introduction","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Colors":{"url":"\/tutorials\/table-of-contents-(lime)\/colors","role":"article","abstract":[],"type":"topic","title":"Colors","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colors"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Colored-Surface":{"url":"\/tutorials\/table-of-contents-(lime)\/colored-surface","role":"article","abstract":[],"type":"topic","title":"Colored Surface","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Colored-Surface"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)":{"url":"\/tutorials\/table-of-contents-(lime)","role":"overview","abstract":[{"type":"text","text":"Learn how to create a custom OUDS theme by overriding tokens from the Orange theme."},{"type":"text","text":" "},{"type":"text","text":"In this tutorial, you will build the Lime fake theme with its own properties"},{"type":"text","text":" "},{"type":"text","text":"You’ll discover how to customize colors, spacings, borders, elevations, colored surfaces, fonts and tuning."}],"type":"topic","title":"Swift Package Lime Tutorial","kind":"overview","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Overriding-color-tokens":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Overriding-color-tokens","role":"pseudoSymbol","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"type":"section","title":"Overriding color tokens","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Overriding-color-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Check-Your-Understanding":{"type":"link","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","role":"project","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"type":"topic","title":"Colors","estimatedTime":"15min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface","role":"project","abstract":[{"type":"text","text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component."}],"type":"topic","title":"Colored Surface","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Introduction":{"url":"\/tutorials\/table-of-contents-(lime)\/introduction","role":"article","abstract":[],"type":"topic","title":"Introduction","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further","role":"project","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"type":"topic","title":"Going further with more resources","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings","role":"project","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"type":"topic","title":"Spacings","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations","role":"project","abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"type":"topic","title":"Elevations","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations"},"tutorial-lime-8.swift":{"fileName":"Tokens.swift","identifier":"tutorial-lime-8.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme, @unchecked Sendable {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            fonts: LimeThemeFontProvider(),","            spaces: LimeThemeSpaceProvider())","","        registerFonts()","    }","","    \/\/ Register fonts only one time","    private static var fontsAlreadyRegistered = false","","    \/\/ Register local fonts using TTF","    \/\/ In the example we use Shantell Sans which is already known in the OUDS Core.","    \/\/ If the font is not managed by OUDS you will need to save inside OUDS the","    \/\/ combinations between PostScript font identifiers and weights","    \/\/ with registerFont(postScript: String, forCombination: PostScriptFontNamesMapKey) API.","    private func registerFonts() {","        guard !LimeTheme.fontsAlreadyRegistered else { return }","","        let fonts = Bundle.main.urls(forResourcesWithExtension: \"ttf\", subdirectory: nil)","        fonts?.forEach { CTFontManagerRegisterFontsForURL($0 as CFURL, .process, nil) }","","        LimeTheme.fontsAlreadyRegistered = true","    }","}","","\/\/ MARK: - Fonts Provider","","\/\/ By subclassing OrangeThemeFontSemanticTokensProvider, you get all existing tokens","\/\/ of font of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeFontProvider: OrangeThemeFontSemanticTokensProvider {","","    private static let myFont = \"Shantell Sans\"","","    override var familyBody: FontFamilySemanticToken { Self.myFont }","    override var familyCode: FontFamilySemanticToken { Self.myFont }","    override var familyDisplay: FontFamilySemanticToken { Self.myFont }","    override var familyHeading: FontFamilySemanticToken { Self.myFont }","    override var familyLabel: FontFamilySemanticToken { Self.myFont }","    override var familySystem: FontFamilySemanticToken { Self.myFont }","}"],"highlights":[{"line":19},{"line":30},{"line":33},{"line":36},{"line":37},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":47},{"line":48},{"line":50},{"line":51},{"line":54},{"line":56},{"line":57},{"line":59},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68}],"fileType":"swift","syntax":"swift","type":"file"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","role":"pseudoSymbol","abstract":[{"type":"text","text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component."}],"type":"section","title":"Overriding color mode tokens","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts","role":"project","abstract":[{"text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components.","type":"text"}],"type":"topic","title":"Fonts","estimatedTime":"15min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Check-Your-Understanding":{"type":"link","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"type":"link","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders","role":"project","abstract":[{"type":"text","text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components."}],"type":"topic","title":"Borders","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries","role":"project","abstract":[{"type":"text","text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several libraries for your needs."},{"type":"text","text":" "},{"type":"text","text":"These libraries help to split products and make users able to select only what they need."},{"type":"text","text":" "},{"type":"text","text":"SwiftUI is the only official supported framework for Apple platforms."}],"type":"topic","title":"Swift Package integration","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries"},"ic_component_intro.png":{"type":"image","alt":"Logo of OUDS","variants":[{"url":"\/images\/OUDSThemesCont