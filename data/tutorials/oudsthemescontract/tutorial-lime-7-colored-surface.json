oc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Spacings":{"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Spacings","type":"topic","title":"Spacings","abstract":[],"url":"\/tutorials\/table-of-contents-(lime)\/spacings","kind":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro":{"role":"project","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro","estimatedTime":"10min","kind":"project","title":"Introduction","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro","abstract":[{"text":"Welcome to the Lime theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.","type":"text"}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Overriding-elevation-tokens":{"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Overriding-elevation-tokens","title":"Overriding elevation tokens","type":"section","abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Overriding-elevation-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Overriding-border-tokens":{"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Overriding-border-tokens","title":"Overriding border tokens","type":"section","abstract":[{"type":"text","text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Overriding-border-tokens"},"tutorial-lime-7.swift":{"identifier":"tutorial-lime-7.swift","syntax":"swift","type":"file","fileName":"Tokens.swift","fileType":"swift","highlights":[{"line":24},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":34},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65}],"content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            spaces: LimeThemeSpaceProvider())","    }","}","","\/\/ MARK: - Color Mode Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","","    override var surfaceStatusInfoEmphasized: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}","","\/\/ MARK: - ColorMode Provider","","\/\/ By subclassing OrangeThemeColorModesSemanticTokensProvider, you get all existing tokens","\/\/ of color mode of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorModeProvider: OrangeThemeColorModeSemanticTokensProvider {","","    override init(colors: AllColorSemanticTokensProvider? = nil) {","        super.init(colors: colors)","    }","}"]},"ic_design_token_intro.png":{"identifier":"ic_design_token_intro.png","alt":"OUDS tokens logo","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png"}],"type":"image"},"Xcode 26.5":{"title":"Xcode 26.5","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/","identifier":"Xcode 26.5"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding"},"doc://OUDSThemesContract/t