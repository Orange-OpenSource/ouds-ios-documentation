lors#Overriding-color-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors","role":"project","abstract":[{"type":"text","text":"Colors are the foundation of any theme. In this chapter, we’ll override color tokens to create the Lime green theme."}],"type":"topic","title":"Colors","estimatedTime":"15min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings","role":"project","abstract":[{"type":"text","text":"Spacing tokens control margins and paddings throughout the app. In this chapter, we will override spacing tokens to customize the layout spacing."}],"type":"topic","title":"Spacings","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Introduction":{"url":"\/tutorials\/table-of-contents-(lime)\/introduction","role":"article","abstract":[],"type":"topic","title":"Introduction","kind":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-10-going-further":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-10-going-further","role":"project","abstract":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"type":"topic","title":"Going further with more resources","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-10-going-further"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface","role":"project","abstract":[{"type":"text","text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component."}],"type":"topic","title":"Colored Surface","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations","role":"project","abstract":[{"type":"text","text":"Elevation tokens control shadows and depth. In this chapter, we will override elevation tokens to customize the shadow appearance."}],"type":"topic","title":"Elevations","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations"},"tutorial-lime-7.swift":{"type":"file","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            spaces: LimeThemeSpaceProvider())","    }","}","","\/\/ MARK: - Color Mode Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","","    override var surfaceStatusInfoEmphasized: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}","","\/\/ MARK: - ColorMode Provider","","\/\/ By subclassing OrangeThemeColorModesSemanticTokensProvider, you get all existing tokens","\/\/ of color mode of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorModeProvider: OrangeThemeColorModeSemanticTokensProvider {","","    override init(colors: AllColorSemanticTokensProvider? = nil) {","        super.init(colors: colors)","    }","}"],"fileName":"Tokens.swift","highlights":[{"line":24},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":34},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65}],"syntax":"swift","identifier":"tutorial-lime-7.swift","fileType":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens","role":"pseudoSymbol","abstract":[{"type":"text","text":"Color mode tokens control the colors used in colored surface components. In this chapter, we will override color mode tokens to customize the OUDSColoredSurface component."}],"type":"section","title":"Overriding color mode tokens","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Overriding-color-mode-tokens"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts","role":"project","abstract":[{"text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components.","type":"text"}],"type":"topic","title":"Fonts","estimatedTime":"15min","kind":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/oudsthemesco