s own properties"},{"type":"text","text":" "},{"type":"text","text":"You’ll discover how to customize colors, spacings, borders, elevations, colored surfaces, fonts and tuning."}],"role":"overview","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","url":"\/tutorials\/table-of-contents-(lime)","kind":"overview"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Import-of-the-Swift-Package-and-choose-its-libraries":{"title":"Import of the Swift Package and choose its libraries","type":"topic","abstract":[],"role":"article","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Import-of-the-Swift-Package-and-choose-its-libraries","url":"\/tutorials\/table-of-contents-(lime)\/import-of-the-swift-package-and-choose-its-libraries","kind":"article"},"Xcode 26.5":{"title":"Xcode 26.5","url":"https:\/\/developer.apple.com\/download\/","type":"xcodeRequirement","identifier":"Xcode 26.5"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts":{"abstract":[{"type":"text","text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components."}],"role":"project","type":"topic","title":"Fonts","kind":"project","estimatedTime":"15min","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts"},"tutorial-lime-7.swift":{"highlights":[{"line":24},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":34},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65}],"syntax":"swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","\/\/ MARK: - Lime Theme","","class LimeTheme: OrangeTheme {","","    init() {","        \/\/ Define the tokens providers you need","        \/\/ Because you override the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            spaces: LimeThemeSpaceProvider())","    }","}","","\/\/ MARK: - Color Mode Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","","    override var surfaceStatusInfoEmphasized: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}","","\/\/ MARK: - ColorMode Provider","","\/\/ By subclassing OrangeThemeColorModesSemanticTokensProvider, you get all existing tokens","\/\/ of color mode of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorModeProvider: OrangeThemeColorModeSemanticTokensProvider {","","    override init(colors: AllColorSemanticTokensProvider? = nil) {","        super.init(colors: colors)","    }","}"],"fileName":"Tokens.swift","fileType":"swift","identifier":"tutorial-lime-7.swift","type":"file"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)/Introduction":{"abstract":[],"role":"article","type":"topic","title":"Introduction","kind":"article","url":"\/tutorials\/table-of-contents-(lime)\/introduction","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)\/Introduction"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-7-colored-surface#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-7-colored-surface#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"title":"Check Your Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-7-colored-surface#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-4-borders#Overriding-border-tokens":{"title":"Overriding border tokens","type":"section","abstract":[{"type":"text","text":"Borders can be defined with line width, style, and corner radius. In this chapter, we will override some border semantic tokens to customize components."}],"role":"pseudoSymbol","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-4-borders#Overriding-border-tokens","kind":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-4-borders#Overriding-border-tokens"},"doc://OUDSThemes