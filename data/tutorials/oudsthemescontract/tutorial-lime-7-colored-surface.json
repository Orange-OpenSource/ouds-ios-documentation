rride the OrangeTheme, some tokens providers will be silently defined","        let colors = LimeThemeColorProvider()","        super.init(","            borders: LimeThemeBorderProvider(),","            colors: colors,","            colorModes: LimeThemeColorModeProvider(colors: colors),","            elevations: LimeThemeElevationProvider(),","            spaces: LimeThemeSpaceProvider())","    }","}","","\/\/ MARK: - Color Mode Provider","","\/\/ By subclassing OrangeThemeColorSemanticTokensProvider, you get all existing tokens","\/\/ of colors of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorProvider: OrangeThemeColorSemanticTokensProvider {","","    override var bgTertiary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.functionalGrayLight80, dark: ColorRawTokens.functionalGrayDark960)","    }","","    override var contentBrandPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var contentBrandPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var actionEnabledLight: ColorSemanticToken { ColorRawTokens.functionalMalachite600 }","    override var actionEnabledDark: ColorSemanticToken { ColorRawTokens.functionalMalachite400 }","","    override var borderBrandPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","","    override var surfaceStatusInfoEmphasized: MultipleColorSemanticToken { MultipleColorSemanticToken(ColorRawTokens.functionalMalachite600) }","}","","\/\/ MARK: - ColorMode Provider","","\/\/ By subclassing OrangeThemeColorModesSemanticTokensProvider, you get all existing tokens","\/\/ of color mode of Orange theme.","\/\/ Then you can override some tokens with your own values.","class LimeThemeColorModeProvider: OrangeThemeColorModeSemanticTokensProvider {","","    override init(colors: AllColorSemanticTokensProvider? = nil) {","        super.init(colors: colors)","    }","}"],"fileType":"swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-5-spacings#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-5-spacings#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-5-spacings#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-3-colors#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-3-colors#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-3-colors#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-6-elevations#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-6-elevations#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-6-elevations#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts":{"role":"project","estimatedTime":"15min","type":"topic","abstract":[{"type":"text","text":"Font tokens control typography throughout the app. In this chapter, we will override font tokens for components."}],"title":"Fonts","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts"},"ic_design_token_intro.png":{"alt":"OUDS tokens logo","identifier":"ic_design_token_intro.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-9-tuning#Defining-tuning-for-local-theme":{"type":"section","role":"pseudoSymbol","kind":"section","title":"Defining tuning for local theme","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme","abstract":[{"type":"text","text":"Tuning allows to define the values for the flexibility points allowed by the Orange Group brand."},{"type":"text","text":" "},{"type":"text","text":"It permits to define whether or not some components family can have rounded corners for example."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-9-tuning#Defining-tuning-for-local-theme"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-1-package-and-libraries#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-1-package-and-libraries#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"title":"Check Your Understanding","type":"link"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-2-intro#Check-Your-Understanding":{"type":"link","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-2-intro#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-2-intro#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(lime)":{"type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(lime)","abstract":[{"type":"text","text":"Learn how to create a custom OUDS theme by overriding tokens from the Orange theme."},{"type":"text","text":" "},{"type":"text","text":"In this tutorial, you will build the Lime fake theme with its own properties"},{"type":"text","text":" "},{"type":"text","text":"You’ll discover how to customize colors, spacings, borders, elevations, colored surfaces, fonts and tuning."}],"url":"\/tutorials\/table-of-contents-(lime)","kind":"overview","title":"Swift Package Lime Tutorial","role":"overview"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-lime-8-fonts#Check-Your-Understanding":{"title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-lime-8-fonts#Check-Your-Understanding","type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-lime-8-fonts#Check-Your-Understanding"}}}