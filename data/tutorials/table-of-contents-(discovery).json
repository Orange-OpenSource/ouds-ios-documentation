UDSThemesContract\/tutorial-discovery-2-instanciate-theme"]},{"image":"ic_component_intro.png","name":"Use of first components provided by OUDS","content":[{"type":"paragraph","inlineContent":[{"text":"In this chapter you will see how you can use your first components provided by OUDS Swift Package","type":"text"}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will use original components of OUDS and richer ones"}]}],"name":"Richer and more original components of OUDS","image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how."}]}],"name":"Typography, view modifiers and tokens","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things"],"image":"ic_design_token_intro.png"},{"content":[{"type":"paragraph","inlineContent":[{"text":"You can have questions and issues, and there are resources online. Let’s see that together.","type":"text"}]}],"name":"Go further with more ressources","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"],"image":"ic_unified_ds.png"}],"name":null}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)"},"variants":[{"paths":["\/tutorials\/table-of-contents-(discovery)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"overview","references":{"ic_component_intro.png":{"alt":"Logo of OUDS","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_component_intro.png"}],"identifier":"ic_component_intro.png"},"ic_theme_intro.png":{"type":"image","identifier":"ic_theme_intro.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}],"alt":"OUDS themes logo"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"title":"Styling things","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"kind":"project","estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme":{"title":"Instanciate and inject a theme","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme","abstract":[{"text":"The theme is exposed as one object which will be injected inside your SwiftUI view.","type":"text"},{"text":" ","type":"text"},{"text":"The theme provides all tokens which defines in the end the rendering of everything.","type":"text"}],"kind":"project","estimatedTime":"15min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-librairies":{"title":"Swift Package integration","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-librairies","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-librairies","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"kind":"project","estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"title":"Add more OUDS components","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","abstract":[{"text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs.","type":"text"}],"kind":"project","estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-6-going-further":{"title":"Going further with more resources","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"kind":"project","estimatedTime":"10min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"title":"Use your first OUDS components","role":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"kind":"project","estimatedTime":"30min"},"ic_unified_ds.png":{"type":"image","identifier":"ic_unified_ds.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png","traits":["1x","light"]}],"alt":"Logo of OUDS"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"title":"Swift Package Discovery Tutorial","role":"overview","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}],"kind":"overview"},"ic_design_token_intro.png":{"type":"image","identifier":"ic_design_token_intro.png","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}],"alt":"OUDS tokens logo"}}}