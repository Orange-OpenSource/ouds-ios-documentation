"content":[{"type":"paragraph","inlineContent":[{"text":"In this chapter you will see how you can use your first components provided by OUDS Swift Package","type":"text"}]}],"name":"Use of first components provided by OUDS","image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In this chapter you will use original components of OUDS and richer ones","type":"text"}]}],"name":"Richer and more original components of OUDS","image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how.","type":"text"}]}],"name":"Typography, view modifiers and tokens","image":"ic_design_token_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You can have questions and issues, and there are resources online. Let’s see that together.","type":"text"}]}],"name":"Go further with more ressources","image":"ic_unified_ds.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"]}]}],"metadata":{"category":"Orange Unified Design System","estimatedTime":"2hr 5min","categoryPathComponent":"Table-Of-Contents-(discovery)","title":"Swift Package Discovery Tutorial","role":"overview"},"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","type":"image","alt":"OUDS themes logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}]},"ic_component_intro.png":{"identifier":"ic_component_intro.png","type":"image","alt":"Logo of OUDS","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"kind":"project","title":"Add more OUDS components","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"kind":"project","title":"Styling things","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-6-going-further":{"kind":"project","title":"Going further with more resources","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further","role":"project","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","abstract":[{"text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources.","type":"text"}],"estimatedTime":"10min"},"doc://OUDSThemesCont