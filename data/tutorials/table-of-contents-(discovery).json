]}],"name":"Use of first components provided by OUDS","image":"ic_component_intro.png"},{"image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"],"name":"Richer and more original components of OUDS","content":[{"type":"paragraph","inlineContent":[{"text":"In this chapter you will use original components of OUDS and richer ones","type":"text"}]}]},{"image":"ic_design_token_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things"],"name":"Typography, view modifiers and tokens","content":[{"inlineContent":[{"type":"text","text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can have questions and issues, and there are resources online. Let’s see that together."}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"],"image":"ic_unified_ds.png","name":"Go further with more ressources"}],"name":null,"kind":"volume","image":null,"content":[]}],"metadata":{"role":"overview","title":"Swift Package Discovery Tutorial","category":"Orange Unified Design System","categoryPathComponent":"Table-Of-Contents-(discovery)","estimatedTime":"2hr 5min"},"kind":"overview","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)"},"hierarchy":{"paths":[],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/tutorials\/table-of-contents-(discovery)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"ic_theme_intro.png":{"type":"image","identifier":"ic_theme_intro.png","alt":"OUDS themes logo","variants":[{"url":"\/images\