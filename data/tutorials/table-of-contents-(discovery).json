":[{"type":"text","text":"Since you have learned how OUDS works with theme, themeable view, components, tuning and view modifiers, it is time now to discover some online resources."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-6-going-further","role":"project","kind":"project","type":"topic","title":"Going further with more resources"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"estimatedTime":"30min","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"type":"text","text":"They are rendered thanks to the theme in use."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","role":"project","kind":"project","title":"Use your first OUDS components","type":"topic"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"estimatedTime":"30min","abstract":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-4-use-other-components","role":"project","type":"topic","title":"Add more OUDS components","kind":"project"},"ic_component_intro.png":{"type":"image","identifier":"ic_component_intro.png","alt":"Logo of OUDS","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"kind":"overview","url":"\/tutorials\/table-of-contents-(discovery)","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","role":"overview","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework."},{"type":"text","text":" "},{"type":"text","text":"Theme, components, tokens… everything will be introduced!"}],"type":"topic","title":"Swift Package Discovery Tutorial"},"ic_design_token_intro.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png"}],"type":"image","identifier":"ic_design_token_intro.png","alt":"OUDS tokens logo"},"ic_unified_ds.png":{"type":"image","identifier":"ic_unified_ds.png","alt":"Logo of OUDS","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png"}]},"ic_theme_intro.png":{"identifier":"ic_theme_intro.png","type":"image","alt":"OUDS themes logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-2-instanciate-theme":{"title":"Instanciate and inject a theme","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-2-instanciate-theme","role":"project","estimatedTime":"15min","abstract":[{"type":"text","text":"The theme is exposed as one object which will be injected inside your SwiftUI view."},{"type":"text","text":" "},{"type":"text","text":"The theme provides all tokens which defines in the end the rendering of everything."}],"type":"topic","kind":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"role":"project","title":"Styling things","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things","kind":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-5-styling-things","abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"estimatedTime":"30min"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-1-package-and-librairies":{"estimatedTime":"10min","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework for Apple platforms.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-librairies","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-1-package-and-librairies","role":"project","type":"topic","title":"Swift Package integration","kind":"project"}}}