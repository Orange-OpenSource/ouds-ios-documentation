ro.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will see how you can use your first components provided by OUDS Swift Package"}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"],"name":"Use of first components provided by OUDS"},{"image":"ic_component_intro.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will use original components of OUDS and richer ones"}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"],"name":"Richer and more original components of OUDS"},{"image":"ic_design_token_intro.png","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how.","type":"text"}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things"],"name":"Typography, view modifiers and tokens"},{"image":"ic_unified_ds.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can have questions and issues, and there are resources online. Let’s see that together."}]}],"tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"],"name":"Go further with more ressources"}],"name":null,"image":null,"kind":"volume"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","paths":[]},"metadata":{"title":"Swift Package Discovery Tutorial","categoryPathComponent":"Table-Of-Contents-(discovery)","estimatedTime":"2hr 5min","category":"Orange Unified Design System","role":"overview"},"references":{"ic_unified_ds.png":{"type":"image","identifier":"ic_unified_ds.png","alt":"Logo of OUDS","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png"}]},"doc://OUDSThemesContract/tutorials/Table-Of-Contents-(discovery)":{"title":"Swift Package Discovery Tutorial","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}],"role":"overview","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","kind":"overview","type":"topic","url":"\/tutorials\/table-of-contents-(discovery)"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-3-use-first-components":{"estimatedTime":"30min","abstract":[{"type":"text","text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens."},{"type":"text","text":" "},{"type":"text","text":"They are rendered thanks to the theme in use."}],"kind":"project","role":"project","url":"\/tutorials\/oudsthemescontract\/tutorial-discovery-3-use-first-components","title":"Use your first OUDS components","type":"topic","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"},"ic_design_token_intro.png":{"alt":"OUDS tokens logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}],"type":"image","identifier":"ic_design_token_intro.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-5-styling-things":{"title":"Styling things","abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"role":"project","estimatedTime":"30min","identif