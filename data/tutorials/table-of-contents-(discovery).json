{"variants":[{"paths":["\/tutorials\/table-of-contents-(discovery)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[{"title":"Swift Package Discovery Tutorial","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries"},"content":[{"inlineContent":[{"type":"text","text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package."},{"type":"text","text":" "},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"type":"text","text":" "},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}],"type":"paragraph"}],"backgroundImage":"ic_unified_ds.png","kind":"hero","image":"ic_unified_ds.png"},{"name":null,"content":[],"kind":"volume","image":null,"chapters":[{"content":[{"inlineContent":[{"type":"text","text":"In this chapter you will learn how to import the OUDS iOS Swift Package and which libraries it provides"},{"type":"text","text":" "},{"type":"text","text":"you should choose for your needs."}],"type":"paragraph"}],"image":"ic_unified_ds.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-1-package-and-libraries"],"name":"Import of the Swift Package and choose its libraries"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will see how to instanciate a theme and inject it inside your app"}]}],"image":"ic_theme_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-2-instanciate-theme"],"name":"Preparation of the theme"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will see how you can use your first components provided by OUDS Swift Package"}]}],"image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-3-use-first-components"],"name":"Use of first components provided by OUDS"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this chapter you will use original components of OUDS and richer ones"}]}],"image":"ic_component_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-4-use-other-components"],"name":"Richer and more original components of OUDS"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how."}]}],"image":"ic_design_token_intro.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-5-styling-things"],"name":"Typography, view modifiers and tokens"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can have questions and issues, and there are resources online. Let’s see that together."}]}],"image":"ic_unified_ds.png","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-discovery-6-going-further"],"name":"Go further with more ressources"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","paths":[]},"metadata":{"categoryPathComponent":"Table-Of-Contents-(discovery)","role":"overview","category":"Orange Unified Design System","estimatedTime":"2hr 5min","title":"Swift Package Discovery Tutorial"},"kind":"overview","identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents-(discovery)","interfaceLanguage":"swift"},"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-discovery-4-use-other-components":{"type":"topic","role":"project